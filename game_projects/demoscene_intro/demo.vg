' ============================================================================
' NARCEAN TECHNOLOGIES PRESENTS
' Visual GAsic Demoscene Intro — 2026
' "Coding for the masses, not the classes"
'
' Effects (in order):
'   0-8s    Intro      — title card fade-in
'   6-32s   Rotozoom   — Second Reality style rotating colour sectors
'  30-58s   Starfield  — perspective starfield with wide camera steering
'  56-88s   Bounce     — flat-shaded icosahedron, squash/stretch physics
'  86-114s  Copper     — horizontal sine-wave colour bars
' 112-150s  Torus      — BPM-driven rotating wireframe torus
' 148-180s  Tunnel     — colour-cycling perspective tunnel
' 178-210s  Fire       — Doom-style cellular automata fire
' 208-240s  Plasma     — flowing HSV colour-wave grid
' 238-288s  Credits    — scrolling text: Narcean Technologies, code, music
' 284-315s  Card       — final title card
'
' Music: UNREALPM.S3M by Purple Motion (Future Crew, 1993)
' Code:  Visual GAsic GDExtension
' ============================================================================

' ===========================================================================
' Constants
' ===========================================================================
Const SW  As Single = 1280.0
Const SH  As Single = 720.0
Const CX  As Single = 640.0
Const CY  As Single = 360.0
Const Pi  As Single = 3.14159265358979
Const Tau As Single = 6.28318530717959

' Scene time windows — each constant marks the START of that effect in seconds.
' Consecutive scenes overlap by T_OVERLAP (3s) so cross-fades look smooth.
' See _Process for the dispatch logic.
Const T_INTRO_START   As Single = 0.0
Const T_INTRO_END     As Single = 8.0
Const T_ROTO_START    As Single = 6.0
Const T_ROTO_END      As Single = 32.0
Const T_STARS_START   As Single = 30.0
Const T_STARS_END     As Single = 58.0
Const T_BOUNCE_START  As Single = 56.0
Const T_BOUNCE_END    As Single = 88.0
Const T_COPPER_START  As Single = 88.0
Const T_COPPER_END    As Single = 106.0
Const T_TORUS_START   As Single = 106.0
Const T_TORUS_END     As Single = 150.0
Const T_TUNNEL_START  As Single = 148.0
Const T_TUNNEL_END    As Single = 180.0
Const T_FIRE_START    As Single = 178.0
Const T_FIRE_END      As Single = 210.0
Const T_PLASMA_START  As Single = 208.0
Const T_PLASMA_END    As Single = 240.0
Const T_CREDITS_START As Single = 238.0
Const T_CREDITS_END   As Single = 290.0
Const T_CARD_START    As Single = 286.0
Const T_CARD_END      As Single = 318.0

' Effect-specific sizing constants
Const StarCount As Integer = 300  ' number of perspective stars

' Torus resolution — major × minor ring subdivisions. Kept low for wireframe clarity.
Const TorusU As Integer = 16
Const TorusV As Integer = 10

' Plasma grid resolution — 28×16 cells at 1280×720 gives ~46×45px cells.
Const PlasmaW As Integer = 28
Const PlasmaH As Integer = 16

' Fire grid resolution — 32×18 cells (classic Doom-fire ratio scaled to 16:9).
Const FireW As Integer = 32
Const FireH As Integer = 18

' ===========================================================================
' Globals
' ===========================================================================
Dim canvas      As Object
Dim t           As Single
Dim is_headless As Boolean
Dim movie_mode  As Boolean

' Starfield — each star stored in normalised [0,1] space; z is depth (1=far, 0=near).
' Perspective projection: screen_x = (star_x - 0.5) / star_z * 900 + viewpoint_x
Dim star_x(299) As Single
Dim star_y(299) As Single
Dim star_z(299) As Single

' Credits scroll
Dim scroll_x        As Single
Dim scroller_x      As Single
Dim credits_started As Boolean

' Rotozoomer: all working arrays are local to _DrawRotozoom to keep scope tight.
' Tunnel: one ring buffer, reused each frame. 20 dots per ring × 2 Vector2
' (position + size) = 40 entries, passed to DrawRectsUniform in a single C++ call.
Dim tunnel_ring(39) As Vector2

' Torus / heartbeat
Dim torus_hue_offset As Single
Dim torus_rot_x      As Single
Dim torus_rot_y      As Single
Dim heart_phase      As Single
Dim heart_bpm        As Single
Dim heart_pulse      As Single
Dim kick_on          As Boolean
Dim kick_t_state     As Single

' Scene tracking
Dim prev_scene       As Integer
Dim scene_bar_offset As Integer
Dim flash_alpha      As Single
Dim fire_acc         As Single
Dim copper_music_paused As Boolean

' Audio state
' tracker_handle is the Tracker.Open() handle — same object ID used by Sound.Pause/Resume.
' AudioSR is the sample rate; AudioSRInv = 1/AudioSR (precomputed to avoid divisions).
Dim tracker_handle As Long
Const AudioSR      As Single = 22050.0
Const AudioSRInv   As Single = 0.0000453514
Dim bpm_current    As Single
Const BeatsPerBar  As Integer = 16
Dim beat_phase     As Single
Dim beat_idx       As Integer
Dim bar_count      As Integer
Dim prev_beat_idx  As Integer
Dim note_age       As Single
Dim lead_phase     As Single
Dim bass_phase     As Single
Dim arp_phase      As Single
Dim hihat_t        As Single
Dim hihat_active   As Boolean

' Note tables: 80 steps = 5 bars × 16 steps per bar (semiquaver resolution).
' Frequencies in Hz (A4=440 standard tuning). 0.0 = rest.
Dim lead_notes(79) As Single
Dim bass_notes(79) As Single
Dim arp_notes(79)  As Single

' Icosahedron geometry — a regular icosahedron has 12 vertices and 20 faces.
' Vertices are built from three perpendicular golden rectangles.
' IcoPhi = golden ratio (1+√5)/2 ; IcoNorm = 1/√(1+IcoPhi²) normalises to unit sphere.
Const IcoPhi  As Single = 1.6180339887
Const IcoNorm As Single = 0.5257311121
Dim ivx(11) As Single
Dim ivy(11) As Single
Dim ivz(11) As Single
Dim ifa(19) As Integer
Dim ifb(19) As Integer
Dim ifc(19) As Integer
Dim ifcr(19) As Single
Dim ifcg(19) As Single
Dim ifcb(19) As Single
Dim irx(11) As Single
Dim iry(11) As Single
Dim irz(11) As Single
Dim ifd(19) As Single
Dim ifo(19) As Integer

' Fire grid — heat values [0,1] for each cell.
' FireW*FireH = 32*18 = 576 cells (array is 0-based so size 575).
Dim fire_grid(575) As Single

' ===========================================================================
' _Ready
' ===========================================================================
Sub _Ready()
	' is_headless lets effects skip sound/input that fail under Godot --headless.
	is_headless = DisplayServer.get_name() = "headless"
	' canvas is our VGVectorCanvas2D draw surface. All drawing goes through it.
	Set canvas = CreateNode("VGVectorCanvas2D")
	AddChild(canvas)
	Randomize()  ' seed the RNG so stars look different each run

	Dim i As Integer
	For i = 0 To StarCount - 1
		star_x(i) = Rnd()
		star_y(i) = Rnd()
		star_z(i) = Rnd() * 0.98 + 0.02
	Next
	Dim fy As Integer
	Dim fx As Integer
	' Zero the whole grid — fire propagates up from the bottom row each frame
	For fy = 0 To FireH - 1
		For fx = 0 To FireW - 1
			fire_grid(fy*FireW+fx) = 0.0
		Next
	Next

	scroll_x        = SW + 200
	credits_started = False
	torus_hue_offset = 0.0
	torus_rot_x     = 0.0 : torus_rot_y = 0.0
	heart_phase     = 0.0 : heart_bpm = 50.0 : heart_pulse = 0.0
	kick_on         = False : kick_t_state = 0.0
	prev_scene      = 0 : scene_bar_offset = 0 : flash_alpha = 0.0

	Call _InitIcosahedron()

	' Synthesised chiptune: three voices (lead / bass / arpeggio) over 5 bars.
	' The melody is inspired by Grieg — "In the Hall of the Mountain King", E minor.
	' Bar 1
	lead_notes(0)=493.9:lead_notes(1)=493.9:lead_notes(2)=554.4:lead_notes(3)=554.4
	lead_notes(4)=622.3:lead_notes(5)=622.3:lead_notes(6)=659.3:lead_notes(7)=659.3
	lead_notes(8)=740.0:lead_notes(9)=740.0:lead_notes(10)=622.3:lead_notes(11)=622.3
	lead_notes(12)=740.0:lead_notes(13)=740.0:lead_notes(14)=740.0:lead_notes(15)=740.0
	bass_notes(0)=246.9:bass_notes(1)=0.0:bass_notes(2)=277.2:bass_notes(3)=0.0
	bass_notes(4)=311.1:bass_notes(5)=0.0:bass_notes(6)=329.6:bass_notes(7)=0.0
	bass_notes(8)=370.0:bass_notes(9)=0.0:bass_notes(10)=311.1:bass_notes(11)=0.0
	bass_notes(12)=370.0:bass_notes(13)=0.0:bass_notes(14)=370.0:bass_notes(15)=0.0
	arp_notes(0)=659.3:arp_notes(1)=0.0:arp_notes(2)=784.0:arp_notes(3)=0.0
	arp_notes(4)=987.8:arp_notes(5)=0.0:arp_notes(6)=784.0:arp_notes(7)=0.0
	arp_notes(8)=659.3:arp_notes(9)=0.0:arp_notes(10)=784.0:arp_notes(11)=0.0
	arp_notes(12)=987.8:arp_notes(13)=0.0:arp_notes(14)=784.0:arp_notes(15)=0.0
	' Bar 2
	lead_notes(16)=784.0:lead_notes(17)=784.0:lead_notes(18)=622.3:lead_notes(19)=622.3
	lead_notes(20)=784.0:lead_notes(21)=784.0:lead_notes(22)=784.0:lead_notes(23)=784.0
	lead_notes(24)=740.0:lead_notes(25)=740.0:lead_notes(26)=622.3:lead_notes(27)=622.3
	lead_notes(28)=740.0:lead_notes(29)=740.0:lead_notes(30)=740.0:lead_notes(31)=740.0
	bass_notes(16)=392.0:bass_notes(17)=0.0:bass_notes(18)=311.1:bass_notes(19)=0.0
	bass_notes(20)=392.0:bass_notes(21)=0.0:bass_notes(22)=392.0:bass_notes(23)=0.0
	bass_notes(24)=370.0:bass_notes(25)=0.0:bass_notes(26)=311.1:bass_notes(27)=0.0
	bass_notes(28)=370.0:bass_notes(29)=0.0:bass_notes(30)=370.0:bass_notes(31)=0.0
	arp_notes(16)=987.8:arp_notes(17)=784.0:arp_notes(18)=659.3:arp_notes(19)=987.8
	arp_notes(20)=784.0:arp_notes(21)=659.3:arp_notes(22)=987.8:arp_notes(23)=784.0
	arp_notes(24)=987.8:arp_notes(25)=784.0:arp_notes(26)=659.3:arp_notes(27)=987.8
	arp_notes(28)=784.0:arp_notes(29)=659.3:arp_notes(30)=987.8:arp_notes(31)=784.0
	' Scenes 2-4: repeat bars
	Dim ai As Integer
	For ai = 32 To 79
		lead_notes(ai)=lead_notes(ai-32)
		bass_notes(ai)=bass_notes(ai-32)
		arp_notes(ai)=arp_notes(ai-32)
	Next

	' movie_mode = True when Godot is launched with --write-movie.
	' In that mode timing is driven by fixed-fps delta, ensuring frame-perfect recordings.
	movie_mode = OS.has_feature("movie")
	beat_idx = 0 : prev_beat_idx = -1 : note_age = 0.0 : beat_phase = 0.0
	bar_count = 0 : bpm_current = 120.0
	lead_phase = 0.0 : bass_phase = 0.0 : arp_phase = 0.0
	hihat_active = False : hihat_t = 0.0

	' Load and play the S3M tracker module. Tracker.Open() returns an ObjectID
	' which is reused by Sound.Pause/Resume to sync the music to scene transitions.
	tracker_handle = Tracker.Open(44100, 2.0)
	If tracker_handle <> 0 Then
		Tracker.Load(tracker_handle, "res://music/UNREALPM.S3M")
		Tracker.Play(tracker_handle)
	End If

	Set_Process(True)
End Sub

' ===========================================================================
' _InitIcosahedron
' ===========================================================================
Sub _InitIcosahedron()
	Dim ica As Single = IcoNorm
	Dim icb As Single = IcoNorm * IcoPhi
	ivx(0)=0
	ivy(0)=ica
	ivz(0)=icb
	ivx(1)=0
	ivy(1)=-ica
	ivz(1)=icb
	ivx(2)=0
	ivy(2)=ica
	ivz(2)=-icb
	ivx(3)=0
	ivy(3)=-ica
	ivz(3)=-icb
	ivx(4)=ica
	ivy(4)=icb
	ivz(4)=0
	ivx(5)=-ica
	ivy(5)=icb
	ivz(5)=0
	ivx(6)=ica
	ivy(6)=-icb
	ivz(6)=0
	ivx(7)=-ica
	ivy(7)=-icb
	ivz(7)=0
	ivx(8)=icb
	ivy(8)=0
