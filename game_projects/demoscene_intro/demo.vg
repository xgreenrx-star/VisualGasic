' VG Demoscene Intro
' Pure procedural vector effects + chiptune. No external assets.
'
' Effect timeline (loops at 165s):
'   0-30s   : Starfield — perspective starfield with camera drift
'  30-60s   : Torus    — rotating wireframe torus (2D perspective math)
'  60-90s   : Plasma   — flowing HSV colour-wave grid  [TWEAK: PlasmaA, PlasmaB]
'  90-135s  : Credits  — vector text scroll + logo
' 135-165s  : Card     — final title card with fade-in
'
' Tweak Overlay groups exposed for the recording:
'   "PlasmaA"  — inner colour of the plasma wave
'   "PlasmaB"  — outer colour of the plasma wave
'   "TorusColor" — torus wireframe colour
'   "StarsColor" — star streak tint
'   "LogoColor"  — credits logo tint

' ===========================================================================
' Constants
' ===========================================================================
Const SW As Single = 1280.0
Const SH As Single = 720.0
Const CX As Single = 640.0
Const CY As Single = 360.0
Const Pi As Single = 3.14159265358979
Const Tau As Single = 6.28318530717959

' Effect time windows
Const T_STARS_START As Single = 0.0
Const T_STARS_END As Single = 30.0
Const T_TORUS_START As Single = 30.0
Const T_TORUS_END As Single = 60.0
Const T_PLASMA_START As Single = 60.0
Const T_PLASMA_END As Single = 90.0
Const T_CREDITS_START As Single = 90.0
Const T_CREDITS_END As Single = 135.0
Const T_CARD_START As Single = 135.0
Const T_CARD_END As Single = 165.0

' Starfield
Const StarCount As Integer = 600

' Torus
Const TorusU As Integer = 20
Const TorusV As Integer = 14

' Plasma grid
Const PlasmaW As Integer = 40
Const PlasmaH As Integer = 23

' ===========================================================================
' Globals
' ===========================================================================
Dim canvas As Object
Dim t As Single
Dim is_headless As Boolean

' Starfield pools
Dim star_x(599) As Single
Dim star_y(599) As Single
Dim star_z(599) As Single

' Credits scroll
Dim scroll_x As Single
Dim credits_started As Boolean

' Tweak-overlay colour parameters (changed live via overlay)
Dim torus_hue_offset As Single
Dim plasma_speed As Single

' Torus: BPM-driven accumulated rotation + heartbeat pulse
Dim torus_rot_x As Single
Dim torus_rot_y As Single
Dim heart_phase As Single
Dim heart_bpm As Single
Dim heart_pulse As Single
Dim kick_on As Boolean
Dim kick_t_state As Single

' Scene-change tracking (for per-scene bar_count offset)
Dim prev_scene As Integer
Dim scene_bar_offset As Integer

' Torus arrival/explosion flash
Dim flash_alpha As Single

' ===========================================================================
' Audio globals
' ===========================================================================
Dim sg_handle As Long
Const AudioSR As Single = 22050.0
Const AudioSRInv As Single = 0.0000453514
Dim bpm_current As Single
Const BeatsPerBar As Integer = 16

Dim beat_phase As Single
Dim beat_idx As Integer
Dim bar_count As Integer

Dim lead_phase As Single
Dim bass_phase As Single
Dim arp_phase As Single
Dim hihat_t As Single
Dim hihat_active As Boolean

' 5 scenes × 16 steps  (0=stars 1=torus 2=plasma 3=credits 4=card)
Dim lead_notes(79) As Single
Dim bass_notes(79) As Single
Dim arp_notes(79) As Single

' ===========================================================================
' _Ready
' ===========================================================================
Sub _Ready()
	is_headless = DisplayServer.get_name() = "headless"

	' Create VectorCanvas2D and add it to the scene tree
	Set canvas = CreateNode("VGVectorCanvas2D")
	AddChild(canvas)

	Randomize()

	' Seed starfield — random positions with staggered depth
	Dim i As Integer
	For i = 0 To StarCount - 1
		star_x(i) = Rnd()
		star_y(i) = Rnd()
		star_z(i) = Rnd() * 0.98 + 0.02
	Next

	scroll_x = SW
	credits_started = False
	torus_hue_offset = 0.0
	plasma_speed = 1.0
	torus_rot_x = 0.0
	torus_rot_y = 0.0
	heart_phase = 0.0
	heart_bpm = 50.0
	heart_pulse = 0.0
	kick_on = False
	kick_t_state = 0.0
	prev_scene = 0
	scene_bar_offset = 0
	flash_alpha = 0.0

	' -----------------------------------------------------------------------
	' Audio note tables  (5 scenes × 16 sixteenth-note steps)
	' Scene 0 — Starfield  (slow Mountain King intro, E minor, ~80 BPM)
	' Lead: E4 _ F#4 _ G4 _ A4 _  (half-time feel, sparse)
	lead_notes(0) = 329.6 : lead_notes(1) = 0.0
	lead_notes(2) = 370.0 : lead_notes(3) = 0.0
	lead_notes(4) = 392.0 : lead_notes(5) = 0.0
	lead_notes(6) = 440.0 : lead_notes(7) = 0.0
	lead_notes(8) = 329.6 : lead_notes(9) = 0.0
	lead_notes(10) = 370.0 : lead_notes(11) = 0.0
	lead_notes(12) = 392.0 : lead_notes(13) = 0.0
	lead_notes(14) = 440.0 : lead_notes(15) = 0.0
	' Bass scene 0: E2/B2 drone
	bass_notes(0) = 82.4 : bass_notes(1) = 0.0
	bass_notes(2) = 82.4 : bass_notes(3) = 0.0
	bass_notes(4) = 123.5 : bass_notes(5) = 0.0
	bass_notes(6) = 123.5 : bass_notes(7) = 0.0
	bass_notes(8) = 82.4 : bass_notes(9) = 0.0
	bass_notes(10) = 82.4 : bass_notes(11) = 0.0
	bass_notes(12) = 123.5 : bass_notes(13) = 0.0
	bass_notes(14) = 123.5 : bass_notes(15) = 0.0
	' Arp scene 0: very quiet E minor chord, slow
	arp_notes(0) = 659.3 : arp_notes(1) = 0.0
	arp_notes(2) = 784.0 : arp_notes(3) = 0.0
	arp_notes(4) = 987.8 : arp_notes(5) = 0.0
	arp_notes(6) = 784.0 : arp_notes(7) = 0.0
	arp_notes(8) = 659.3 : arp_notes(9) = 0.0
	arp_notes(10) = 784.0 : arp_notes(11) = 0.0
	arp_notes(12) = 987.8 : arp_notes(13) = 0.0
	arp_notes(14) = 784.0 : arp_notes(15) = 0.0

	' Scene 1 — Torus  (Mountain King main run, accelerating 100→180 BPM)
	' Lead: E4 F#4 G4 A4 B4 G4 B4 _ (the classic ascending phrase)
	lead_notes(16) = 329.6 : lead_notes(17) = 370.0
	lead_notes(18) = 392.0 : lead_notes(19) = 440.0
	lead_notes(20) = 493.9 : lead_notes(21) = 392.0
	lead_notes(22) = 493.9 : lead_notes(23) = 0.0
	lead_notes(24) = 329.6 : lead_notes(25) = 370.0
	lead_notes(26) = 392.0 : lead_notes(27) = 440.0
	lead_notes(28) = 493.9 : lead_notes(29) = 392.0
	lead_notes(30) = 493.9 : lead_notes(31) = 0.0
	' Bass scene 1: octave below
	bass_notes(16) = 164.8 : bass_notes(17) = 185.0
	bass_notes(18) = 196.0 : bass_notes(19) = 220.0
	bass_notes(20) = 246.9 : bass_notes(21) = 196.0
	bass_notes(22) = 246.9 : bass_notes(23) = 0.0
	bass_notes(24) = 164.8 : bass_notes(25) = 185.0
	bass_notes(26) = 196.0 : bass_notes(27) = 220.0
	bass_notes(28) = 246.9 : bass_notes(29) = 196.0
	bass_notes(30) = 246.9 : bass_notes(31) = 0.0
	' Arp scene 1: E minor chord tones every step
	arp_notes(16) = 659.3 : arp_notes(17) = 784.0
	arp_notes(18) = 987.8 : arp_notes(19) = 784.0
	arp_notes(20) = 659.3 : arp_notes(21) = 987.8
	arp_notes(22) = 784.0 : arp_notes(23) = 659.3
	arp_notes(24) = 659.3 : arp_notes(25) = 784.0
	arp_notes(26) = 987.8 : arp_notes(27) = 784.0
	arp_notes(28) = 659.3 : arp_notes(29) = 987.8
	arp_notes(30) = 784.0 : arp_notes(31) = 659.3

	' Scene 2 — Plasma  (frantic, locked at 200 BPM, Mountain King high variant)
	' Lead: B4 A4 G4 F#4 E4 F#4 G4 A4  (descending answer phrase)
	lead_notes(32) = 493.9 : lead_notes(33) = 440.0
	lead_notes(34) = 392.0 : lead_notes(35) = 370.0
	lead_notes(36) = 329.6 : lead_notes(37) = 370.0
	lead_notes(38) = 392.0 : lead_notes(39) = 440.0
	lead_notes(40) = 493.9 : lead_notes(41) = 440.0
	lead_notes(42) = 392.0 : lead_notes(43) = 370.0
	lead_notes(44) = 329.6 : lead_notes(45) = 370.0
	lead_notes(46) = 392.0 : lead_notes(47) = 440.0
	' Bass scene 2: driving root E2 every beat
	bass_notes(32) = 164.8 : bass_notes(33) = 164.8
	bass_notes(34) = 246.9 : bass_notes(35) = 246.9
	bass_notes(36) = 164.8 : bass_notes(37) = 164.8
	bass_notes(38) = 246.9 : bass_notes(39) = 246.9
	bass_notes(40) = 164.8 : bass_notes(41) = 164.8
	bass_notes(42) = 246.9 : bass_notes(43) = 246.9
	bass_notes(44) = 164.8 : bass_notes(45) = 164.8
	bass_notes(46) = 246.9 : bass_notes(47) = 246.9
	' Arp scene 2: rapid E minor chord stabs every step
	arp_notes(32) = 987.8 : arp_notes(33) = 784.0
	arp_notes(34) = 659.3 : arp_notes(35) = 784.0
	arp_notes(36) = 987.8 : arp_notes(37) = 784.0
	arp_notes(38) = 659.3 : arp_notes(39) = 784.0
	arp_notes(40) = 987.8 : arp_notes(41) = 784.0
	arp_notes(42) = 659.3 : arp_notes(43) = 784.0
	arp_notes(44) = 987.8 : arp_notes(45) = 784.0
	arp_notes(46) = 659.3 : arp_notes(47) = 784.0

	' Scene 3 — Credits  (slow, melodic — A minor, single-voice feel, 90 BPM)
	' Lead: A4 _ G4 _ E4 _ C5 _ A4 _ B4 _ C5 _ _ _
	lead_notes(48) = 440.0 : lead_notes(49) = 0.0
	lead_notes(50) = 392.0 : lead_notes(51) = 0.0
	lead_notes(52) = 329.6 : lead_notes(53) = 0.0
	lead_notes(54) = 523.2 : lead_notes(55) = 0.0
	lead_notes(56) = 440.0 : lead_notes(57) = 0.0
	lead_notes(58) = 493.9 : lead_notes(59) = 0.0
	lead_notes(60) = 523.2 : lead_notes(61) = 0.0
	lead_notes(62) = 0.0 : lead_notes(63) = 0.0
	' Bass scene 3: A2/E2 sparse
	bass_notes(48) = 110.0 : bass_notes(49) = 0.0
	bass_notes(50) = 0.0 : bass_notes(51) = 0.0
	bass_notes(52) = 164.8 : bass_notes(53) = 0.0
	bass_notes(54) = 0.0 : bass_notes(55) = 0.0
	bass_notes(56) = 110.0 : bass_notes(57) = 0.0
	bass_notes(58) = 0.0 : bass_notes(59) = 0.0
	bass_notes(60) = 164.8 : bass_notes(61) = 0.0
	bass_notes(62) = 0.0 : bass_notes(63) = 0.0
	' Arp scene 3: silent (let melody breathe)
	Dim ai As Integer
	For ai = 48 To 63
		arp_notes(ai) = 0.0
	Next

	' Scene 4 — Card  (E minor sustained chord, very slow 60 BPM, fade to silence)
	lead_notes(64) = 329.6 : lead_notes(65) = 0.0
	lead_notes(66) = 0.0 : lead_notes(67) = 0.0
	lead_notes(68) = 329.6 : lead_notes(69) = 0.0
	lead_notes(70) = 0.0 : lead_notes(71) = 0.0
	lead_notes(72) = 392.0 : lead_notes(73) = 0.0
	lead_notes(74) = 0.0 : lead_notes(75) = 0.0
	lead_notes(76) = 493.9 : lead_notes(77) = 0.0
	lead_notes(78) = 0.0 : lead_notes(79) = 0.0
	bass_notes(64) = 82.4 : bass_notes(65) = 0.0
	bass_notes(66) = 0.0 : bass_notes(67) = 0.0
	bass_notes(68) = 123.5 : bass_notes(69) = 0.0
	bass_notes(70) = 0.0 : bass_notes(71) = 0.0
	bass_notes(72) = 82.4 : bass_notes(73) = 0.0
	bass_notes(74) = 0.0 : bass_notes(75) = 0.0
	bass_notes(76) = 123.5 : bass_notes(77) = 0.0
	bass_notes(78) = 0.0 : bass_notes(79) = 0.0
	For ai = 64 To 79
		arp_notes(ai) = 0.0
	Next

	beat_idx = 0
	beat_phase = 0.0
	bar_count = 0
	bpm_current = 80.0
	lead_phase = 0.0
	bass_phase = 0.0
	arp_phase = 0.0
	hihat_active = False
	hihat_t = 0.0

	sg_handle = SoundGen.Open(22050, 0.5)

	Set_Process(True)
End Sub

' ===========================================================================
' _UnhandledInput — any keypress / mouse click skips to next section
' VG auto-enables unhandled input processing when this sub is present.
' ===========================================================================
Sub _UnhandledInput(ByVal Event As Object)
	Dim is_key As Boolean = Event Is InputEventKey
	Dim is_click As Boolean = Event Is InputEventMouseButton
	If Not is_key And Not is_click Then Exit Sub
	If Not Event.Pressed Then Exit Sub

	' Skip to next section boundary
	If t < T_STARS_END Then
		t = T_STARS_END
	ElseIf t < T_TORUS_END Then
		t = T_TORUS_END
	ElseIf t < T_PLASMA_END Then
		t = T_PLASMA_END
	ElseIf t < T_CREDITS_END Then
		t = T_CREDITS_END
	Else
		t = 0.0
		scroll_x = SW
		credits_started = False
	End If
End Sub

' ===========================================================================
' _Process
' ===========================================================================
Sub _Process(ByVal delta As Single)
	t = t + delta

	' Loop at end of card section
	If t > = T_CARD_END Then
		t = t - T_CARD_END
		scroll_x = SW
		credits_started = False
	End If

	Call _UpdateAudio(delta)

	' Draw current effect onto canvas
	Call canvas.Clear()
	Call canvas.BeginGroup("Background")
	Call canvas.DrawRect(Rect2(0, 0, SW, SH), 1.0, Color(0, 0, 0, 1), True, Color(0, 0, 0, 1))
	Call canvas.EndGroup()

	' 3-second cross-fade overlap between every adjacent scene pair.
	' Each incoming scene gets tt = (t - scene_start) which is negative during
	' the overlap window; the per-scene fade formula clamps negatives to 0
	' until the last 1.5s where it ramps up naturally.
	Const T_OVERLAP As Single = 3.0
	If t > = T_STARS_START And t < T_STARS_END Then
		Call _DrawStars(delta)
		' Torus appears as tiny dot 3s before starfield ends; grows to full size.
		If t > T_STARS_END - T_OVERLAP Then
			Call _DrawTorus(t - T_STARS_END)
		End If
	ElseIf t > = T_TORUS_START And t < T_TORUS_END Then
		Call _DrawStarsAlpha(delta, 0.2)
		Call _DrawTorus(t - T_TORUS_START)
		If t > T_TORUS_END - T_OVERLAP Then
			Call _DrawPlasma(t - T_TORUS_END)
		End If
	ElseIf t > = T_PLASMA_START And t < T_PLASMA_END Then
		Call _DrawPlasma(t - T_PLASMA_START)
		If t > T_PLASMA_END - T_OVERLAP Then
			Call _DrawCredits(delta)
		End If
	ElseIf t > = T_CREDITS_START And t < T_CREDITS_END Then
		Call _DrawStarsAlpha(delta, 0.25)
		Call _DrawCredits(delta)
	ElseIf t > = T_CARD_START Then
		Call _DrawStarsAlpha(delta, 0.35)
		Call _DrawCard(t - T_CARD_START)
	End If

	' Flash overlay — drawn last so it sits above everything.
	' Set by _DrawTorus explosion phase; decays automatically each frame.
	If flash_alpha > 0.001 Then
		Call canvas.DrawRect(Rect2(0, 0, SW, SH), 0.0, Color(1.0, 0.6, 0.2, flash_alpha), True, Color(1.0, 0.6, 0.2, flash_alpha))
		flash_alpha = flash_alpha - delta * 3.5
		If flash_alpha < 0.0 Then flash_alpha = 0.0
	End If

	Call canvas.Render()
End Sub

' ===========================================================================
' Effect 1: Starfield
' Perspective-projected stars streaking toward camera. 600 stars, 2D only.
' ===========================================================================
Sub _DrawStars(ByVal delta As Single)
	Dim fade As Single = 1.0
	If t < 1.5 Then fade = t / 1.5
	If t > 28.5 Then fade = (T_STARS_END - t) / 1.5
	If fade < 0.0 Then fade = 0.0
	If fade > 1.0 Then fade = 1.0

	' Pre-allocate three brightness-bucket segment arrays (worst-case all stars in one)
	Dim segs_dim(1199) As Vector2
	Dim segs_mid(1199) As Vector2
	Dim segs_bri(1199) As Vector2
	Dim n_dim As Integer = 0
	Dim n_mid As Integer = 0
	Dim n_bri As Integer = 0

	' Speed ramps from 0 to full over the first 3s, then tracks BPM.
	' In the final 3s of the starfield, boost speed 1×→2.8× — warp rush toward torus.
	Dim spd_ramp As Single = t / 3.0
	If spd_ramp > 1.0 Then spd_ramp = 1.0
	Dim warp_boost As Single = 1.0
	If t > T_STARS_END - 3.0 Then
		warp_boost = 1.0 + 1.8 * ((t - (T_STARS_END - 3.0)) / 3.0)
	End If
	Dim star_spd As Single = delta * (bpm_current / 80.0) * 0.38 * spd_ramp * warp_boost

	' Vanishing point: drift normally, then lock to screen centre in final 3s
	' so all stars converge on the torus position during the approach.
	Dim vp_drift As Single = 1.0
	If t > T_STARS_END - 3.0 Then
		vp_drift = 1.0 - (t - (T_STARS_END - 3.0)) / 3.0
		If vp_drift < 0.0 Then vp_drift = 0.0
	End If
	Dim vp_x As Single = CX + Sin(t * 0.17) * 110.0 * spd_ramp * vp_drift
	Dim vp_y As Single = CY + Sin(t * 0.11) * 65.0 * spd_ramp * vp_drift

	Dim i As Integer
	For i = 0 To StarCount - 1
		Dim old_z As Single = star_z(i)
		star_z(i) = star_z(i) - star_spd

		If star_z(i) < 0.006 Then
			star_x(i) = Rnd() * 0.28 + 0.36
			star_y(i) = Rnd() * 0.28 + 0.36
			star_z(i) = 1.0
			old_z = 1.0
		End If

		Dim sx As Single = (star_x(i) - 0.5) / star_z(i) * 900.0 + vp_x
		Dim sy As Single = (star_y(i) - 0.5) / star_z(i) * 900.0 + vp_y
		Dim ox As Single = (star_x(i) - 0.5) / old_z * 900.0 + vp_x
		Dim oy As Single = (star_y(i) - 0.5) / old_z * 900.0 + vp_y

		If sx < - 20 Or sx > SW + 20 Or sy < - 20 Or sy > SH + 20 Then GoTo _next_star

		Dim bright As Single = (1.0 - star_z(i)) * fade

		If bright > 0.65 Then
			segs_bri(n_bri) = Vector2(ox, oy)
			segs_bri(n_bri + 1) = Vector2(sx, sy)
			n_bri = n_bri + 2
		ElseIf bright > 0.3 Then
			segs_mid(n_mid) = Vector2(ox, oy)
			segs_mid(n_mid + 1) = Vector2(sx, sy)
			n_mid = n_mid + 2
		Else
			segs_dim(n_dim) = Vector2(ox, oy)
			segs_dim(n_dim + 1) = Vector2(sx, sy)
			n_dim = n_dim + 2
		End If
		_next_star:
	Next

	' Three batch calls instead of 600 individual DrawLine calls
	Call canvas.BeginGroup("StarsColor")
	If n_dim > 0 Then
		ReDim Preserve segs_dim(n_dim - 1) As Vector2
		Call canvas.DrawLines(segs_dim, 0.7, Color(0.35 * fade, 0.35 * fade, 0.38 * fade, fade))
	End If
	If n_mid > 0 Then
		ReDim Preserve segs_mid(n_mid - 1) As Vector2
		Call canvas.DrawLines(segs_mid, 1.1, Color(0.6 * fade, 0.6 * fade, 0.65 * fade, fade))
	End If
	If n_bri > 0 Then
		ReDim Preserve segs_bri(n_bri - 1) As Vector2
		Call canvas.DrawLines(segs_bri, 1.6, Color(fade, fade, fade * 0.95 + 0.05, fade))
	End If
	Call canvas.EndGroup()
End Sub

' Draws starfield at reduced opacity AND updates star positions.
' Used during the title card scene so stars stay alive and track BPM.
Sub _DrawStarsAlpha(ByVal delta As Single, ByVal alpha_scale As Single)
	Dim fade As Single = alpha_scale

	' Same BPM-driven speed as _DrawStars (no slow-start ramp here — card
	' stars should already be moving at tempo when the scene begins)
	Dim star_spd As Single = delta * (bpm_current / 80.0) * 0.38

	Dim segs_dim(1199) As Vector2
	Dim segs_mid(1199) As Vector2
	Dim segs_bri(1199) As Vector2
	Dim n_dim As Integer = 0
	Dim n_mid As Integer = 0
	Dim n_bri As Integer = 0

	' Same drifting VP formula as _DrawStars, computed from global t
	Dim vp_x As Single = CX + Sin(t * 0.17) * 110.0
	Dim vp_y As Single = CY + Sin(t * 0.11) * 65.0

	Dim i As Integer
	For i = 0 To StarCount - 1
		Dim old_z As Single = star_z(i)
		star_z(i) = star_z(i) - star_spd
		If star_z(i) < 0.006 Then
			star_x(i) = Rnd() * 0.28 + 0.36
			star_y(i) = Rnd() * 0.28 + 0.36
			star_z(i) = 1.0
			old_z = 1.0
		End If
		Dim sx As Single = (star_x(i) - 0.5) / star_z(i) * 900.0 + vp_x
		Dim sy As Single = (star_y(i) - 0.5) / star_z(i) * 900.0 + vp_y
		Dim ox As Single = (star_x(i) - 0.5) / old_z * 900.0 + vp_x
		Dim oy As Single = (star_y(i) - 0.5) / old_z * 900.0 + vp_y
		If sx < - 20 Or sx > SW + 20 Or sy < - 20 Or sy > SH + 20 Then GoTo _next_star_a
		Dim bright As Single = (1.0 - star_z(i)) * fade
		If bright > 0.65 * alpha_scale Then
			segs_bri(n_bri) = Vector2(ox, oy)
			segs_bri(n_bri + 1) = Vector2(sx, sy)
			n_bri = n_bri + 2
		ElseIf bright > 0.3 * alpha_scale Then
			segs_mid(n_mid) = Vector2(ox, oy)
			segs_mid(n_mid + 1) = Vector2(sx, sy)
			n_mid = n_mid + 2
		Else
			segs_dim(n_dim) = Vector2(ox, oy)
			segs_dim(n_dim + 1) = Vector2(sx, sy)
			n_dim = n_dim + 2
		End If
		_next_star_a:
	Next

	Call canvas.BeginGroup("StarsColor")
	If n_dim > 0 Then
		ReDim Preserve segs_dim(n_dim - 1) As Vector2
		Call canvas.DrawLines(segs_dim, 0.7, Color(0.35 * fade, 0.35 * fade, 0.38 * fade, fade))
	End If
	If n_mid > 0 Then
		ReDim Preserve segs_mid(n_mid - 1) As Vector2
		Call canvas.DrawLines(segs_mid, 1.1, Color(0.6 * fade, 0.6 * fade, 0.65 * fade, fade))
	End If
	If n_bri > 0 Then
		ReDim Preserve segs_bri(n_bri - 1) As Vector2
		Call canvas.DrawLines(segs_bri, 1.6, Color(fade, fade, fade, fade))
	End If
	Call canvas.EndGroup()
End Sub  (2D perspective projection, no 3D API needed)
' Torus parameterised by (u, v) angles. Rotated on two axes per frame.
' ===========================================================================
Sub _DrawTorus(ByVal tt As Single)
	' --- Arrival phase (tt = -3 → 0): torus grows from a distant dot ---
	' --- Full phase  (tt = 0 → 28.5): normal heartbeat + rotation     ---
	' --- Explosion   (tt = 27 → 30): scale rockets outward, screen flashes ---

	' Arrival: scale 0.04 → 1.0 over the 3s approach window
	Dim arrival_scale As Single = 1.0
	Dim arrival_fade As Single = 1.0
	If tt < 0.0 Then
		Dim approach As Single = (tt + 3.0) / 3.0
		If approach < 0.0 Then approach = 0.0
		arrival_scale = 0.04 + 0.96 * approach
		' Fade in during last 1.5s of approach
		arrival_fade = (tt + 1.5) / 1.5
		If arrival_fade < 0.0 Then arrival_fade = 0.0
		If arrival_fade > 1.0 Then arrival_fade = 1.0
	End If

	' Scene fade (normal in/out)
	Dim fade As Single = 1.0
	If tt > = 0.0 And tt < 1.5 Then fade = tt / 1.5
	If tt > 28.5 Then fade = (30.0 - tt) / 1.5
	If fade < 0.0 Then fade = 0.0
	If fade > 1.0 Then fade = 1.0
	If tt < 0.0 Then fade = arrival_fade

	' Explosion phase (tt = 27 → 30): scale rockets to 4x, trigger flash
	Dim explode_scale As Single = 1.0
	If tt > 27.0 Then
		Dim explode_t As Single = (tt - 27.0) / 3.0
		explode_scale = 1.0 + 3.0 * explode_t * explode_t
		' Peak flash at tt=29, then it fades with the fade-out
		flash_alpha = explode_t * explode_t * fade
		' Turbo hue cycle during explosion
		torus_hue_offset = torus_hue_offset + 0.08
		If torus_hue_offset > 1.0 Then torus_hue_offset = torus_hue_offset - 1.0
	End If

	' Combine all scale factors
	Dim torus_scale As Single = arrival_scale * explode_scale * (1.0 + 0.35 * heart_pulse)

	Call canvas.BeginGroup("TorusColor")
	Call canvas.DrawTorusWireframe(torus_rot_y, torus_rot_x, torus_hue_offset, tt, fade, CX, CY, torus_scale)
	Call canvas.EndGroup()
End Sub

' ===========================================================================
' Effect 3: Plasma  (HSV colour-wave over a cell grid)
' Three sine waves superposed. Two named groups for Tweak Overlay demo.
' ===========================================================================
Sub _DrawPlasma(ByVal tt As Single)
	Dim fade As Single = 1.0
	If tt < 1.5 Then fade = tt / 1.5
	If tt > 28.5 Then fade = (30.0 - tt) / 1.5
	If fade < 0.0 Then fade = 0.0
	If fade > 1.0 Then fade = 1.0

	Dim pw As Single = SW / PlasmaW
	Dim ph As Single = SH / PlasmaH
	Dim spd As Single = tt * plasma_speed

	Call canvas.BeginGroup("PlasmaA")
	Call canvas.DrawPlasmaCells(PlasmaW, PlasmaH, spd, fade, pw, ph, 0)
	Call canvas.EndGroup()

	Call canvas.BeginGroup("PlasmaB")
	Call canvas.DrawPlasmaCells(PlasmaW, PlasmaH, spd, fade, pw, ph, 1)
	Call canvas.EndGroup()
End Sub

' ===========================================================================
' Effect 4: Credits scroll  (horizontal vector text + logo)
' ===========================================================================
' ===========================================================================
' Effect 4: Credits  — helix text orbit + sine scroller
' ===========================================================================
Sub _DrawCredits(ByVal delta As Single)
	Dim tt As Single = t - T_CREDITS_START
	Dim fade As Single = 1.0
	If tt < 0.0 Then
		' Cross-fade overlap from plasma: ramp in over final 1.5s of approach
		fade = (tt + 1.5) / 1.5
	ElseIf tt < 1.5 Then
		fade = tt / 1.5
	End If
	If tt > 43.5 Then fade = (45.0 - tt) / 1.5
	If fade < 0.0 Then fade = 0.0
	If fade > 1.0 Then fade = 1.0

	If Not credits_started Then
		scroll_x = SW
		credits_started = True
	End If

	' --- Helix: "VISUAL GASIC" orbiting the screen centre ---
	Call canvas.BeginGroup("LogoColor")
	Call canvas.DrawVectorTextHelix("VISUAL GASIC", CX, CY, tt, Color(0.2, 0.7, 1.0, fade), 2.6, 2.2, 180.0, 0.55, 0.0, 0.9, 0.22, "")
	Call canvas.EndGroup()

	' --- Sine wave scroller below the helix ---
	' Speed oscillates between 20 px/s (readable pause) and 70 px/s (cruise)
	Dim scroll_speed As Single = 20.0 + 50.0 * Abs(Sin(tt * 0.3))
	scroll_x = scroll_x - delta * scroll_speed
	Dim credits_text As String = "VISUAL GASIC  *  WRITTEN IN VB-STYLE BASIC  *  100% PROCEDURAL  *  NO ASSETS HARMED  *  VECTOR STORM  *  FIVE EFFECTS ONE FILE  *  "
	Dim text_width As Single = Len(credits_text) * 28.0
	If scroll_x < - text_width Then scroll_x = SW
	' spacing=8.0 spreads letters out; amplitude=14 keeps wave gentle; wave_freq=0.07 stretches the wave long
	Call canvas.DrawVectorTextWave(credits_text, scroll_x, 560.0, tt, Color(1.0, 0.85, 0.2, fade), 1.2, 1.4, 14.0, 0.07, 1.5, 8.0, True, "")

	' --- "PRESS ANY KEY" blinking hint ---
	Dim blink As Single = Sin(t * 5.0)
	If blink > 0.0 Then
		Call canvas.DrawVectorTextCentered(Vector2(CX, 640.0), "PRESS ANY KEY TO CONTINUE", Color(0.7, 0.7, 1.0, fade * 0.6), 0.75, 1.0, 2.0, "")
	End If
End Sub

' ===========================================================================
' Effect 5: Final title card  — wave title + border
' ===========================================================================
Sub _DrawCard(ByVal tt As Single)
	Dim fade As Single = 1.0
	If tt < 2.0 Then fade = tt / 2.0
	If tt > 28.0 Then fade = (30.0 - tt) / 2.0
	If fade < 0.0 Then fade = 0.0
	If fade > 1.0 Then fade = 1.0

	' Border frame
	Dim m As Single = 36.0
	Call canvas.DrawRect(Rect2(m, m, SW - m * 2, SH - m * 2), 1.5, Color(0.25, 0.45, 0.75, fade * 0.55), False, Color(0, 0, 0, 0))

	' Corner accents
	Dim a As Single = 48.0
	Call canvas.DrawLine(Vector2(m, m), Vector2(m + a, m), 2.0, Color(0.3, 0.6, 1.0, fade))
	Call canvas.DrawLine(Vector2(m, m), Vector2(m, m + a), 2.0, Color(0.3, 0.6, 1.0, fade))
	Call canvas.DrawLine(Vector2(SW - m, m), Vector2(SW - m - a, m), 2.0, Color(0.3, 0.6, 1.0, fade))
	Call canvas.DrawLine(Vector2(SW - m, m), Vector2(SW - m, m + a), 2.0, Color(0.3, 0.6, 1.0, fade))
	Call canvas.DrawLine(Vector2(m, SH - m), Vector2(m + a, SH - m), 2.0, Color(0.3, 0.6, 1.0, fade))
	Call canvas.DrawLine(Vector2(m, SH - m), Vector2(m, SH - m - a), 2.0, Color(0.3, 0.6, 1.0, fade))
	Call canvas.DrawLine(Vector2(SW - m, SH - m), Vector2(SW - m - a, SH - m), 2.0, Color(0.3, 0.6, 1.0, fade))
	Call canvas.DrawLine(Vector2(SW - m, SH - m), Vector2(SW - m, SH - m - a), 2.0, Color(0.3, 0.6, 1.0, fade))

	' Wave title "VISUAL GASIC" centered — 12 chars * (8*2.8 + 2.0 spacing) ≈ 293px total
	Dim wave_x As Single = CX - 147.0
	Call canvas.DrawVectorTextWave("VISUAL GASIC", wave_x, 270.0, tt, Color(0.2, 0.7, 1.0, fade), 2.8, 2.5, 7.0, 0.18, 2.8, 2.0, False, "")

	' Tagline
	Call canvas.DrawVectorTextCentered(Vector2(CX, 380.0), "A VB6-STYLE LANGUAGE FOR GODOT 4", Color(1.0, 1.0, 1.0, fade * 0.85), 1.1, 1.2, 2.2, "")

	' URL
	Call canvas.DrawVectorTextCentered(Vector2(CX, 450.0), "VISUALGASIC.IO", Color(1.0, 0.85, 0.2, fade), 1.5, 1.5, 2.5, "")
End Sub

' ===========================================================================
' Audio: In the Hall of the Mountain King (Grieg 1876)
' Per-scene tempo + notes.  Triangle lead, sine bass, sawtooth arp, noise hat.
' ===========================================================================
Sub _UpdateAudio(ByVal delta As Single)
	If sg_handle = 0 Then Exit Sub

	' --- Select scene (0-4) and configure tempo ---
	Dim scene As Integer = 0
	Dim target_bpm As Single = 80.0
	' Pre-ramp starfield to 95 BPM in the last 3s so the torus cross-fade
	' doesn't cause an abrupt tempo jump when scene 1 takes over at 100 BPM
	If t > T_STARS_END - 3.0 And t < T_STARS_END Then
		target_bpm = 95.0
	End If
	If t > = T_TORUS_START And t < T_TORUS_END Then
		scene = 1
		' Use bars-within-scene so BPM always starts at 60 regardless of bar_count
		Dim torus_bars As Integer = bar_count - scene_bar_offset
		target_bpm = 60.0 + torus_bars * 5.0
		If target_bpm > 120.0 Then target_bpm = 120.0
	ElseIf t > = T_PLASMA_START And t < T_PLASMA_END Then
		scene = 2
		target_bpm = 200.0
	ElseIf t > = T_CREDITS_START And t < T_CREDITS_END Then
		scene = 3
		target_bpm = 90.0
	ElseIf t > = T_CARD_START Then
		scene = 4
		target_bpm = 60.0
	End If
	' Smooth tempo glide (10 BPM/s)
	Dim bpm_diff As Single = target_bpm - bpm_current
	If bpm_diff > 10.0 * delta Then bpm_diff = 10.0 * delta
	If bpm_diff < - 10.0 * delta Then bpm_diff = - 10.0 * delta
	bpm_current = bpm_current + bpm_diff
	Dim note_offset As Integer = scene * 16

	' Detect scene change — snapshot bar_count so per-scene ramp starts from 0
	If scene <> prev_scene Then
		scene_bar_offset = bar_count
		prev_scene = scene
	End If

	' --- Advance beat clock ---
	Dim step_dur As Single = 60.0 / (bpm_current * 4.0)
	beat_phase = beat_phase + delta / step_dur
	Do While beat_phase > = 1.0
		beat_phase = beat_phase - 1.0
		beat_idx = beat_idx + 1
		If beat_idx > = BeatsPerBar Then
			beat_idx = 0
			bar_count = bar_count + 1
		End If
		' Hi-hat: every step in plasma (frantic), every 2nd elsewhere
		Dim hat_div As Integer = 2
		If scene = 2 Then hat_div = 1
		If scene > = 3 Then hat_div = 4
		If beat_idx Mod hat_div = 0 Then
			hihat_active = True
			hihat_t = 0.0
		End If
	Loop

	' --- BPM-driven torus rotation + hue cycle (all scenes, keeps spinning) ---
	torus_rot_x = torus_rot_x + delta * (bpm_current / 100.0) * 0.45
	torus_rot_y = torus_rot_y + delta * (bpm_current / 100.0) * 0.28
	torus_hue_offset = torus_hue_offset + delta * (bpm_current / 100.0) * 0.06

	' --- Heartbeat oscillator (active during torus scene) ---
	' BPM oscillates 32-68 over ~48s giving a slow living pulse
	If t > = T_TORUS_START And t < T_TORUS_END Then
		Dim tt_h As Single = t - T_TORUS_START
		heart_bpm = 50.0 + 18.0 * Sin(tt_h * 0.13)
		heart_phase = heart_phase + delta * heart_bpm / 60.0
		If heart_phase > = 1.0 Then
			heart_phase = heart_phase - 1.0
			heart_pulse = 1.0
			kick_on = True
			kick_t_state = 0.0
		End If
	End If
	' Decay pulse — slower decay so swell is visible for ~0.25s
	heart_pulse = heart_pulse * (1.0 - delta * 4.0)
	If heart_pulse < 0.0 Then heart_pulse = 0.0

	If SoundGen.Available(sg_handle) < = 0 Then Exit Sub

	Dim lead_f As Single = lead_notes(note_offset + beat_idx)
	Dim bass_f As Single = bass_notes(note_offset + beat_idx)
	Dim arp_f As Single = arp_notes(note_offset + beat_idx)

	Dim state As Variant = SoundGen.FillVoices4(sg_handle, AudioSR, lead_f, lead_phase, bass_f, bass_phase, arp_f, arp_phase, hihat_active, hihat_t, AudioSRInv, kick_on, kick_t_state, 0.3)
	lead_phase = state(0)
	bass_phase = state(1)
	arp_phase = state(2)
	hihat_t = state(3)
	' Advance kick timer in VG with delta — no need to read state(4)
	If kick_on Then
		kick_t_state = kick_t_state + delta
		If kick_t_state > = 0.3 Then kick_on = False
	End If
End Sub
