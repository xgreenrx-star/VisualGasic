' Visual Gasic Form Script
' ==========================================================
' ZORK I: THE GREAT UNDERGROUND EMPIRE
' A VisualGasic Text Adventure
' ==========================================================
' Based on the original Infocom classic by Marc Blank, Dave
' Lebling, Bruce Daniels, and Tim Anderson.
' Room/object data from historicalsource/zork1 (MIT License).
' ==========================================================

Option Explicit

' --- Constants ---
Const MAX_SCORE As Integer = 350
Const LAMP_TURNS_MAX As Integer = 200
Const CANDLE_TURNS_MAX As Integer = 40
Const STRENGTH_MIN As Integer = 2
Const STRENGTH_MAX As Integer = 7

' --- UI Node References ---
Dim GameOutput As Object
Dim CmdInput As Object
Dim StatusBar As Object

' --- Core Game State ---
Dim CurrentRoom As String
Dim Score As Integer
Dim Moves As Integer
Dim Verbose As Boolean
Dim GameRunning As Boolean
Dim TtsEnabled As Boolean

' --- Player State ---
Dim Deaths As Integer
Dim LampTurns As Integer
Dim CandleTurns As Integer
Dim MaxCarry As Integer
Dim PlayerWounds As Integer
Dim CureTimer As Integer

' --- World Data ---
Dim Rooms As Dictionary
Dim Objects As Dictionary
Dim VerbMap As Dictionary
Dim DirMap As Dictionary

' --- Game Flags ---
Dim TrapDoorOpen As Boolean
Dim GratingOpen As Boolean
Dim WindowOpen As Boolean
Dim DamGatesOpen As Boolean
Dim LowTide As Boolean
Dim TrollDead As Boolean
Dim ThiefDead As Boolean
Dim CyclopsFled As Boolean
Dim MagicFlag As Boolean
Dim RainbowSolid As Boolean
Dim DomeRoped As Boolean
Dim BoatInflated As Boolean
Dim WonGame As Boolean
Dim LldFlag As Boolean
Dim CoalInMachine As Boolean
Dim SpiritsBanished As Boolean
Dim RugMoved As Boolean
Dim LampOn As Boolean
Dim CandlesLit As Boolean
Dim LampDead As Boolean
Dim CandleDead As Boolean

' --- NPC State ---
Dim ThiefRoom As String
Dim TrollUnconscious As Integer

' --- Parse Results ---
Dim ParsedVerb As String
Dim ParsedNoun1 As String
Dim ParsedNoun2 As String
Dim ParsedPrep As String
Dim RawInput As String

' ==========================================================
' INITIALIZATION
' ==========================================================

Sub _Ready()
	GameOutput = GetNode("Output")
	CmdInput = GetNode("CmdInput")
	StatusBar = GetNode("StatusBar")

	Set Rooms = New Dictionary
	Set Objects = New Dictionary
	Set VerbMap = New Dictionary
	Set DirMap = New Dictionary

	BuildDirMap
	BuildVerbMap
	BuildRooms
	BuildObjects

	CurrentRoom = "WEST-OF-HOUSE"
	Score = 0
	Moves = 0
	Deaths = 0
	Verbose = True
	GameRunning = True
	TtsEnabled = False
	LampTurns = LAMP_TURNS_MAX
	CandleTurns = CANDLE_TURNS_MAX
	MaxCarry = 100
	PlayerWounds = 0
	CureTimer = 0
	TrapDoorOpen = False
	GratingOpen = False
	WindowOpen = False
	DamGatesOpen = False
	LowTide = False
	TrollDead = False
	ThiefDead = False
	CyclopsFled = False
	MagicFlag = False
	RainbowSolid = False
	DomeRoped = False
	BoatInflated = False
	WonGame = False
	LldFlag = False
	CoalInMachine = False
	SpiritsBanished = False
	RugMoved = False
	LampOn = False
	CandlesLit = False
	LampDead = False
	CandleDead = False
	ThiefRoom = "TREASURE-ROOM"
	TrollUnconscious = 0

	StartGame
	CmdInput.SetFocus
End Sub

Sub CmdInput_KeyPress(inputText As String)
	Dim cmd As String
	cmd = inputText
	CmdInput.text = ""
	If Len(Trim(cmd)) > 0 And GameRunning Then
		GamePrint ""
		GamePrint "[color=cyan]> " & cmd & "[/color]"
		ProcessCommand Trim(cmd)
	End If
	CmdInput.SetFocus
End Sub

' ==========================================================
' WORLD BUILDING HELPERS
' ==========================================================

Sub R(id As String, nm As String, desc As String, fl As String, sv As Integer, ex As String)
	Dim room As Object
	Dim exitDict As Object
	Dim pairs As Array
	Dim i As Integer
	Dim kv As Array

	Set room = New Dictionary
	Set exitDict = New Dictionary

	room("name") = nm
	room("desc") = desc
	room("flags") = fl
	room("score") = sv
	room("visited") = False
	room("exits") = exitDict

	If Len(ex) > 0 Then
		pairs = Split(ex, ",")
		Dim pairCount As Integer
		pairCount = UBound(pairs)
		For i = 0 To pairCount
			Dim pairStr As String
			pairStr = Trim(CStr(pairs(i)))
			If Len(pairStr) > 0 And InStr(pairStr, ":") > 0 Then
				kv = Split(pairStr, ":")
				If UBound(kv) > = 1 Then
					exitDict(Trim(kv(0))) = Trim(kv(1))
				End If
			End If
		Next i
	End If

	Rooms(id) = room
End Sub

Sub O(id As String, nm As String, loc As String, fl As String, v As Integer, tv As Integer, sz As Integer, syns As String)
	Dim obj As Object
	Set obj = New Dictionary
	obj("name") = nm
	obj("location") = loc
	obj("flags") = fl
	obj("value") = v
	obj("tvalue") = tv
	obj("size") = sz
	obj("fdesc") = ""
	obj("ldesc") = ""
	obj("text") = ""
	obj("synonyms") = syns
	obj("strength") = 0
	Objects(id) = obj
End Sub

Sub OD(id As String, fd As String, ld As String)
	Dim obj As Object
	Set obj = Objects(id)
	obj("fdesc") = fd
	obj("ldesc") = ld
End Sub

Sub OT(id As String, txt As String)
	Dim obj As Object
	Set obj = Objects(id)
	obj("text") = txt
End Sub

' ==========================================================
' DICTIONARY ACCESS HELPERS
' ==========================================================

Function ObjProp(id As String, prop As String) As Variant
	Dim o As Dictionary
	Set o = Objects(id)
	ObjProp = o(prop)
End Function

' ==========================================================
' BUILD ALL ROOMS
' ==========================================================

Sub BuildRooms()
	' --- Overworld / Forest ---
	R "WEST-OF-HOUSE", "West of House", "You are standing in an open field west of a white house, with a boarded front door.", "RLANDBIT", 0, "N:NORTH-OF-HOUSE,S:SOUTH-OF-HOUSE,NE:NORTH-OF-HOUSE,SE:SOUTH-OF-HOUSE,W:FOREST-1"
	R "NORTH-OF-HOUSE", "North of House", "You are facing the north side of a white house. There is no door here, and all the windows are boarded up. To the north a narrow path winds through the trees.", "RLANDBIT", 0, "SW:WEST-OF-HOUSE,SE:EAST-OF-HOUSE,W:WEST-OF-HOUSE,E:EAST-OF-HOUSE,N:PATH"
	R "SOUTH-OF-HOUSE", "South of House", "You are facing the south side of a white house. There is no door here, and all the windows are boarded.", "RLANDBIT", 0, "W:WEST-OF-HOUSE,E:EAST-OF-HOUSE,NE:EAST-OF-HOUSE,NW:WEST-OF-HOUSE,S:FOREST-3"
	R "EAST-OF-HOUSE", "Behind House", "You are behind the white house. A path leads into the forest to the east. In one corner of the house there is a small window which is slightly ajar.", "RLANDBIT", 0, "N:NORTH-OF-HOUSE,S:SOUTH-OF-HOUSE,SW:SOUTH-OF-HOUSE,NW:NORTH-OF-HOUSE,E:CLEARING,W:KITCHEN"
	R "FOREST-1", "Forest", "This is a forest, with trees in all directions. To the east, there appears to be sunlight.", "RLANDBIT", 0, "N:GRATING-CLEARING,E:PATH,S:FOREST-3,W:FOREST-1"
	R "FOREST-2", "Forest", "This is a dimly lit forest, with large trees all around.", "RLANDBIT", 0, "E:MOUNTAINS,S:CLEARING,W:PATH"
	R "FOREST-3", "Forest", "This is a large forest, with trees obstructing all views.", "RLANDBIT", 0, "N:CLEARING,W:FOREST-1,NW:SOUTH-OF-HOUSE"
	R "MOUNTAINS", "Forest", "The forest thins out, revealing impassable mountains.", "RLANDBIT", 0, "N:FOREST-2,S:FOREST-2,W:FOREST-2"
	R "PATH", "Forest Path", "This is a path winding through a dimly lit forest. The path heads north-south here. One particularly large tree with some low branches stands at the edge of the path.", "RLANDBIT", 0, "U:UP-A-TREE,N:GRATING-CLEARING,E:FOREST-2,S:NORTH-OF-HOUSE,W:FOREST-1"
	R "UP-A-TREE", "Up a Tree", "You are about 10 feet above the ground nestled among some large branches. The nearest branch above you is beyond your reach. Beside you on the branch is a small bird's nest.", "RLANDBIT", 0, "D:PATH"
	R "GRATING-CLEARING", "Clearing", "You are in a small clearing in a well-marked forest path that extends to the east and west. There is an iron grating set into the ground.", "RLANDBIT", 0, "E:FOREST-2,W:FOREST-1,S:PATH,D:GRATING-ROOM"
	R "CLEARING", "Clearing", "You are in a clearing, with a forest surrounding you on all sides. A path leads south. To the east is an impressive canyon view.", "RLANDBIT", 0, "E:CANYON-VIEW,N:FOREST-2,S:FOREST-3,W:EAST-OF-HOUSE"
	R "CANYON-VIEW", "Canyon View", "You are at the top of the Great Canyon, on its west wall. From here there is a marvelous view of the canyon and parts of the Frigid River below.", "RLANDBIT", 0, "NW:CLEARING,W:FOREST-3,E:CLIFF-MIDDLE,D:CLIFF-MIDDLE"
	R "CLIFF-MIDDLE", "Rocky Ledge", "You are on a ledge about halfway up the wall of the river canyon. You can see from here that the weights can be seen at the bottom of the canyon.", "RLANDBIT", 0, "U:CANYON-VIEW,D:CANYON-BOTTOM"
	R "CANYON-BOTTOM", "Canyon Bottom", "You are beneath the walls of the river canyon which may be climbable here. The bottom of the canyon contains a gravel streambed.", "RLANDBIT", 0, "U:CLIFF-MIDDLE,N:END-OF-RAINBOW"
	R "END-OF-RAINBOW", "End of Rainbow", "You are on a small, rocky beach on the continuation of the Frigid River past the falls. The beach is narrow due to the presence of the White Cliffs. The river canyon opens here and sunlight shines in from above. A rainbow crosses over the falls to the east.", "RLANDBIT", 0, "SW:CANYON-BOTTOM,E:ON-RAINBOW"
	R "ON-RAINBOW", "On the Rainbow", "You are on top of a rainbow spanning the falls, which cascades to a rocky beach far below.", "RLANDBIT", 0, "W:END-OF-RAINBOW,E:ARAGAIN-FALLS"
	R "ARAGAIN-FALLS", "Aragain Falls", "You are at the top of Aragain Falls, an enormous waterfall with a drop of about 450 feet. The falls roar loudly. On the east shore far below is a sandy beach. A rainbow appears over the falls.", "RLANDBIT", 0, "N:SHORE,W:ON-RAINBOW"
	R "SHORE", "Shore", "You are on a rocky shore at the edge of a large, underground river. The Frigid River flows by here.", "RLANDBIT", 0, "N:SANDY-BEACH,S:ARAGAIN-FALLS"
	R "SANDY-BEACH", "Sandy Beach", "You are on a large sandy beach at the south end of a large underground cavern. A path runs to the northeast.", "RLANDBIT", 0, "NE:SANDY-CAVE,S:SHORE"
	R "SANDY-CAVE", "Sandy Cave", "This is a sand-filled cave whose exit is to the southwest.", "RLANDBIT", 0, "SW:SANDY-BEACH"
	R "STONE-BARROW", "Stone Barrow", "You are standing inside a stone barrow. Exits lead northeast.", "RLANDBIT", 0, "NE:WEST-OF-HOUSE"

	' --- House Interior ---
	R "KITCHEN", "Kitchen", "You are in the kitchen of the white house. A table seems to have been used recently for the preparation of food. A passage leads to the west and a dark staircase can be seen leading upward. A dark chimney leads down and to the east is a small window.", "RLANDBIT", 10, "W:LIVING-ROOM,U:ATTIC,E:EAST-OF-HOUSE"
	R "ATTIC", "Attic", "This is the attic. The only exit is a stairway leading down. A large coil of rope is lying in the corner. On a table is a nasty-looking knife.", "RLANDBIT", 0, "D:KITCHEN"
	R "LIVING-ROOM", "Living Room", "You are in the living room. There is a doorway to the east, a wooden door with strange gothic lettering to the west, which appears to be nailed shut, and a large oriental rug in the center of the room. Above the trophy case hangs an elvish sword of great antiquity.", "RLANDBIT", 0, "E:KITCHEN"

	' --- Cellar & Troll ---
	R "CELLAR", "Cellar", "You are in a dark and damp cellar with a narrow passageway leading north, and a crawlway to the south. On the west is the bottom of a steep metal ramp which is unclimbable.", "RLANDBIT", 25, "N:TROLL-ROOM,S:EAST-OF-CHASM,U:LIVING-ROOM"
	R "TROLL-ROOM", "Troll Room", "This is a small room with passages to the east and south and a forbidding hole leading west. Bloodstains and deep scratches (perhaps made by strng claws) mar the walls.", "RLANDBIT", 0, "S:CELLAR,E:EW-PASSAGE,W:MAZE-1"
	R "EAST-OF-CHASM", "East of Chasm", "You are on the east edge of a chasm, the bottom of which cannot be seen. A narrow passage leads north, and the path you are on continues to the east.", "RLANDBIT", 0, "N:CELLAR,E:GALLERY"
	R "GALLERY", "Gallery", "This is an art gallery. Most of the paintings have been stolen by vandals with exceptional taste. A doorway leads south and a hallway leads west.", "RLANDBIT", 0, "W:EAST-OF-CHASM,N:STUDIO"
	R "STUDIO", "Studio", "This appears to have been an artist's studio. The walls and floors are covered with paintings. A chimney leads up from a fireplace; other exits are to the south.", "RLANDBIT", 0, "S:GALLERY,U:KITCHEN"

	' --- Round Room & Vicinity ---
	R "EW-PASSAGE", "East-West Passage", "This is a narrow east-west passageway. There is a narrow stairway leading down at the north end of the room.", "RLANDBIT", 5, "E:ROUND-ROOM,W:TROLL-ROOM,D:CHASM-ROOM,N:CHASM-ROOM"
	R "ROUND-ROOM", "Round Room", "This is a circular room with passages in all directions. Several have been blocked by cave-ins.", "RLANDBIT", 0, "E:LOUD-ROOM,W:EW-PASSAGE,N:NS-PASSAGE,S:NARROW-PASSAGE,SE:ENGRAVINGS-CAVE"
	R "LOUD-ROOM", "Loud Room", "This is a large room with a ceiling which cannot be detected from the ground. There is a narrow passage from east to west and a stone stairway leading upward. The room is deafeningly loud with an� unidentifiable roaring noise.", "RLANDBIT", 0, "E:DAMP-CAVE,W:ROUND-ROOM,U:DEEP-CANYON"
	R "DAMP-CAVE", "Damp Cave", "This cave has a faint light coming from the east and passages going west and east.", "RLANDBIT", 0, "W:LOUD-ROOM,E:WHITE-CLIFFS-NORTH"
	R "WHITE-CLIFFS-NORTH", "White Cliffs Beach", "You are on a narrow strip of beach between the Cliffs and the river. A steep path leads up.", "RLANDBIT", 0, "W:DAMP-CAVE"
	R "NS-PASSAGE", "North-South Passage", "This is a high north-south passage which meets the east-west passage here.", "RLANDBIT", 0, "N:CHASM-ROOM,NE:DEEP-CANYON,S:ROUND-ROOM"
	R "CHASM-ROOM", "Chasm", "A chasm runs southwest to northeast and the path follows it. You are on the east side of the chasm, which continues down into darkness.", "RLANDBIT", 0, "NE:RESERVOIR-SOUTH,SW:EW-PASSAGE,U:EW-PASSAGE,S:NS-PASSAGE"
	R "DEEP-CANYON", "Deep Canyon", "You are on the south side of a deep canyon. Passages lead to the northwest, east, and up a steep incline to the southwest.", "RLANDBIT", 0, "NW:RESERVOIR-SOUTH,E:DAM-ROOM,SW:NS-PASSAGE,D:LOUD-ROOM"

	' --- Reservoir & Dam ---
	R "RESERVOIR-SOUTH", "Reservoir South", "You are in a long room on the south shore of a large lake, far underground.", "RLANDBIT", 0, "SE:DEEP-CANYON,SW:CHASM-ROOM,E:DAM-ROOM,W:STREAM-VIEW,N:RESERVOIR"
	R "RESERVOIR", "Reservoir", "You are on what used to be a large reservoir, but it appears all the water has drained away.", "NONLANDBIT", 0, "N:RESERVOIR-NORTH,S:RESERVOIR-SOUTH"
	R "RESERVOIR-NORTH", "Reservoir North", "You are in a large cavernous room, the north end of which was formerly a reservoir.", "RLANDBIT", 0, "N:ATLANTIS-ROOM,S:RESERVOIR"
	R "STREAM-VIEW", "Stream View", "You are in a small room near the south end of the reservoir. A stream flows out of the room to the south.", "RLANDBIT", 0, "E:RESERVOIR-SOUTH"
	R "DAM-ROOM", "Dam", "You are standing on the top of Flood Control Dam #3, which was quite a feat of engineering. To the north is the administration building, and to the south is the deep canyon.", "RLANDBIT", 0, "S:DEEP-CANYON,D:DAM-BASE,E:DAM-BASE,N:DAM-LOBBY,W:RESERVOIR-SOUTH"
	R "DAM-LOBBY", "Dam Lobby", "This room appears to have been the waiting room for Flood Control Dam #3. There are doors to the north and east, and a corridor to the south.", "RLANDBIT", 0, "S:DAM-ROOM,N:MAINTENANCE-ROOM,E:MAINTENANCE-ROOM"
	R "MAINTENANCE-ROOM", "Maintenance Room", "This is what appears to have been the maintenance room for Flood Control Dam #3. Faded posters on the walls depict the day-to-day operation of the dam. An open doorway leads south.", "RLANDBIT", 0, "S:DAM-LOBBY,W:DAM-LOBBY"
	R "DAM-BASE", "Dam Base", "You are at the base of Flood Control Dam #3. A pile of plastic is here.", "RLANDBIT", 0, "N:DAM-ROOM,U:DAM-ROOM"

	' --- Mirror Rooms & Hades ---
	R "MIRROR-ROOM-1", "Mirror Room", "You are in a large square room with tall ceilings. On the south wall is an enormous mirror which fills the entire wall. Exits lead north, east, and west.", "RLANDBIT", 0, "N:COLD-PASSAGE,W:TWISTING-PASSAGE,E:SMALL-CAVE"
	R "MIRROR-ROOM-2", "Mirror Room", "You are in a large square room with tall ceilings. On the south wall is an enormous mirror. Exits lead north, east, and west.", "RLANDBIT", 0, "W:WINDING-PASSAGE,N:NARROW-PASSAGE,E:TINY-CAVE"
	R "SMALL-CAVE", "Small Cave", "This is a small cave with an exit to the north and a staircase going down.", "RLANDBIT", 0, "N:MIRROR-ROOM-1,D:ATLANTIS-ROOM,S:ATLANTIS-ROOM,W:TWISTING-PASSAGE"
	R "TINY-CAVE", "Tiny Cave", "This is a tiny cave with entrances west and north, and a dark, forbidding staircase leading down.", "RLANDBIT", 0, "N:MIRROR-ROOM-2,W:WINDING-PASSAGE,D:ENTRANCE-TO-HADES"
	R "COLD-PASSAGE", "Cold Passage", "This is a cold and damp corridor where a chilling wind blows.", "RLANDBIT", 0, "S:MIRROR-ROOM-1,W:SLIDE-ROOM"
	R "NARROW-PASSAGE", "Narrow Passage", "This is a narrow passage. The walls here are formed by ancient brick and mortar.", "RLANDBIT", 0, "N:ROUND-ROOM,S:MIRROR-ROOM-2"
	R "WINDING-PASSAGE", "Winding Passage", "This is a winding passage. It seems like you've been here before.", "RLANDBIT", 0, "N:MIRROR-ROOM-2,E:TINY-CAVE"
	R "TWISTING-PASSAGE", "Twisting Passage", "This is a twisting passage through oddly shaped rock.", "RLANDBIT", 0, "N:MIRROR-ROOM-1,E:SMALL-CAVE"
	R "ATLANTIS-ROOM", "Atlantis Room", "This is an ancient room, long ago combrolled with debris. One wall has a mural depicting a ancient kingdom, perhaps the legendary Atlantis.", "RLANDBIT", 0, "U:SMALL-CAVE,S:RESERVOIR-NORTH"
	R "ENTRANCE-TO-HADES", "Entrance to Hades", "You are outside a large gateway, on which is inscribed 'Abandon every hope all ye who enter here.' The gate is made of thick iron. Below the inscription is a small, ancient keyhole.", "RLANDBIT", 0, "U:TINY-CAVE,S:LAND-OF-LIVING-DEAD"
	R "LAND-OF-LIVING-DEAD", "Land of the Dead", "You have entered the Land of the Living Dead. Eerie lights and selphic voices fill the room.", "RLANDBIT", 0, "N:ENTRANCE-TO-HADES"

	' --- Dome, Temple, Egypt ---
	R "ENGRAVINGS-CAVE", "Engravings Cave", "You have entered a cave with writings on all the walls. The writings are a mixture of Flathead lore and meaningless graffiti. The games of the Flatheads are depicted on the walls.", "RLANDBIT", 0, "NW:ROUND-ROOM,E:DOME-ROOM"
	R "DOME-ROOM", "Dome Room", "You are at the periphery of a large dome, which forms the ceiling of another room below. Protecting you from a precipitous drop is a wooden railing.", "RLANDBIT", 0, "W:ENGRAVINGS-CAVE,D:TORCH-ROOM"
	R "TORCH-ROOM", "Torch Room", "This is a large room with a prominent doorway leading south. Above you is a large dome. In the center of the room there is a small white pedestal.", "RLANDBIT", 0, "S:NORTH-TEMPLE,D:NORTH-TEMPLE"
	R "NORTH-TEMPLE", "Temple", "This is the north end of a large temple. On the east wall is an ancient inscription. On the floor near the southeast corner is a small hole, through which you can feel a draft.", "RLANDBIT", 0, "D:EGYPT-ROOM,E:EGYPT-ROOM,N:TORCH-ROOM,U:TORCH-ROOM,S:SOUTH-TEMPLE"
	R "SOUTH-TEMPLE", "Altar", "This is the south end of a large temple. In the center of the room sits a white marble altar.", "RLANDBIT", 0, "N:NORTH-TEMPLE,D:TINY-CAVE"
	R "EGYPT-ROOM", "Egyptian Room", "This is a room which looks like an Egyptian tomb. There is an ascending staircase to the west.", "RLANDBIT", 0, "W:NORTH-TEMPLE,U:NORTH-TEMPLE"

	' --- Cyclops & Treasure ---
	R "CYCLOPS-ROOM", "Cyclops Room", "This room has an exit to the south and a staircase leading up.", "RLANDBIT", 0, "NW:MAZE-15,E:STRANGE-PASSAGE,U:TREASURE-ROOM"
	R "STRANGE-PASSAGE", "Strange Passage", "This is a long, dimly lit corridor with an ornate doorway at each end.", "RLANDBIT", 0, "W:CYCLOPS-ROOM,E:LIVING-ROOM"
	R "TREASURE-ROOM", "Treasure Room", "This is a large room, bare on all sides. A narrow stairway leads down.", "RLANDBIT", 25, "D:CYCLOPS-ROOM"

	' --- Coal Mine ---
	R "SLIDE-ROOM", "Slide Room", "This is a small chamber at the top of a smooth slide which descends to the cellar. A passage leads north.", "RLANDBIT", 0, "E:COLD-PASSAGE,N:MINE-ENTRANCE,D:CELLAR"
	R "MINE-ENTRANCE", "Mine Entrance", "You are standing at the entrance to what appears to be an old coal mine. Passages lead north and south.", "RLANDBIT", 0, "S:SLIDE-ROOM,W:SQUEEKY-ROOM"
	R "SQUEEKY-ROOM", "Squeaky Room", "You are in a small room. Strange squeaky sounds can be heard coming from the north.", "RLANDBIT", 0, "N:BAT-ROOM,E:MINE-ENTRANCE"
	R "BAT-ROOM", "Bat Room", "You are in a large room, with passages to the south and east. The room has an exit to the east and a forbidding passage leading west. High above is a wooden door.", "RLANDBIT", 0, "S:SQUEEKY-ROOM,E:SHAFT-ROOM"
	R "SHAFT-ROOM", "Shaft Room", "This is a large room, in the middle of which is a small shaft descending through the floor into darkness below. To the north is a small passage.", "RLANDBIT", 0, "W:BAT-ROOM,N:SMELLY-ROOM"
	R "SMELLY-ROOM", "Smelly Room", "This is a small room from which an awful smell emanates. The room is otherwise featureless except for passages to the south and down.", "RLANDBIT", 0, "D:GAS-ROOM,S:SHAFT-ROOM"
	R "GAS-ROOM", "Gas Room", "This is a small room which smells strongly of coal gas. A passage leads up and to the east.", "RLANDBIT", 0, "U:SMELLY-ROOM,E:MINE-1"
	R "MINE-1", "Coal Mine", "You are in a nondescript part of a coal mine.", "RLANDBIT", 0, "W:GAS-ROOM,NW:MINE-2,SE:MINE-3"
	R "MINE-2", "Coal Mine", "You are in a nondescript part of a coal mine.", "RLANDBIT", 0, "SE:MINE-1,N:MINE-4"
	R "MINE-3", "Coal Mine", "You are in a nondescript part of a coal mine.", "RLANDBIT", 0, "NW:MINE-1"
	R "MINE-4", "Coal Mine", "You are in a nondescript part of a coal mine.", "RLANDBIT", 0, "S:MINE-2,W:LADDER-TOP"
	R "LADDER-TOP", "Ladder Top", "This is a very small room. In the floor there is a small square opening with a ladder leading down.", "RLANDBIT", 0, "D:LADDER-BOTTOM,U:MINE-4"
	R "LADDER-BOTTOM", "Ladder Bottom", "This is the bottom of a ladder. Exits lead south and west.", "RLANDBIT", 0, "S:DEAD-END-5,W:TIMBER-ROOM,U:LADDER-TOP"
	R "DEAD-END-5", "Dead End", "Dead end.", "RLANDBIT", 0, "N:LADDER-BOTTOM"
	R "TIMBER-ROOM", "Timber Room", "This is a long and narrow passage, which is cluttered with broken timbers from a ceiling collapse. From the east comes a breeze.", "RLANDBIT", 0, "E:LADDER-BOTTOM,W:LOWER-SHAFT"
	R "LOWER-SHAFT", "Lower Shaft", "This is the bottom of a long shaft. To the south is a passage and to the east a tunnel.", "RLANDBIT", 0, "S:MACHINE-ROOM,E:TIMBER-ROOM"
