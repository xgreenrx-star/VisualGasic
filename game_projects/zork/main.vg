' ==========================================================
' START GAME
' ==========================================================

Sub StartGame()
	GamePrint "[b][color=yellow]ZORK I: The Great Underground Empire[/color][/b]"
	GamePrint "[color=yellow]Copyright (c) 1980 by Infocom, Inc.[/color]"
	GamePrint "[color=yellow]VG reimplementation by VisualGasic.[/color]"
	GamePrint ""
	ShowRoom True
End Sub

' ==========================================================
' OUTPUT HELPERS
' ==========================================================

Sub GamePrint(text As String)
	GameOutput.append_text(text & Chr(10))
	Speak text
End Sub

Sub Speak(text As String)
	If Not TtsEnabled Then Return
	Dim clean As String
	clean = text
	' Strip BBCode tags
	Do While InStr(clean, "[") > 0
		Dim s As Integer
		Dim e As Integer
		s = InStr(clean, "[")
		e = InStr(s, clean, "]")
		If e > 0 Then
			clean = Left(clean, s - 1) & Mid(clean, e + 1)
		Else
			Exit Do
		End If
	Loop
	If Len(Trim(clean)) > 0 Then
		DisplayServer.tts_speak(clean, "", 50, 1.0, 1.0)
	End If
End Sub

Sub UpdateStatus()
	Dim room As Object
	Set room = Rooms(CurrentRoom)
	StatusBar.text = room("name") & " Score: " & CStr(Score) & " Moves: " & CStr(Moves)
End Sub

' ==========================================================
' SHOW ROOM
' ==========================================================

Sub ShowRoom(forceLong As Boolean)
	If Not IsLit() Then
		GamePrint "[b]Darkness[/b]"
		GamePrint "It is pitch black. You are likely to be eaten by a grue."
		UpdateStatus
		Return
	End If

	Dim room As Object
	Set room = Rooms(CurrentRoom)

	GamePrint "[b][color=white]" & room("name") & "[/color][/b]"

	If forceLong Or Verbose Or Not room("visited") Then
		GamePrint room("desc")
		room("visited") = True
	End If

	' Show objects in room
	Dim objKeys As Array
	Dim k As Variant
	objKeys = Objects.Keys()
	For Each k In objKeys
		Dim obj As Object
		Set obj = Objects(CStr(k))
		If obj("location") = CurrentRoom Then
			If HasFlag(CStr(k), "ACTORBIT") Then
				' NPC
				If CStr(k) = "TROLL" And TrollDead Then
					GamePrint obj("ldesc")
				ElseIf CStr(k) = "CYCLOPS" And CyclopsFled Then
					' Cyclops fled, don't show
				ElseIf CStr(k) = "GHOSTS" And SpiritsBanished Then
					' Ghosts banished
				ElseIf Len(obj("fdesc")) > 0 Then
					GamePrint obj("fdesc")
				End If
			ElseIf Len(obj("fdesc")) > 0 Then
				GamePrint obj("fdesc")
			ElseIf Len(obj("ldesc")) > 0 Then
				GamePrint obj("ldesc")
			Else
				If HasFlag(CStr(k), "TAKEBIT") Then
					GamePrint "There is a " & obj("name") & " here."
				End If
			End If

			' Show contents of open containers
			If HasFlag(CStr(k), "CONTBIT") And (HasFlag(CStr(k), "OPENBIT") Or HasFlag(CStr(k), "TRANSBIT")) Then
				ShowContents CStr(k), " "
			End If
		End If
	Next

	' Award room score
	If room("score") > 0 Then
		Dim oldScore As Integer
		oldScore = Score
		Score = Score + room("score")
		room("score") = 0
		If Score > oldScore Then
			GamePrint "[color=yellow](Your score just went up.)[/color]"
		End If
	End If

	UpdateStatus
End Sub

Sub ShowContents(containerId As String, indent As String)
	Dim objKeys As Array
	Dim k As Variant
	objKeys = Objects.Keys()
	For Each k In objKeys
		Dim obj As Object
		Set obj = Objects(CStr(k))
		If obj("location") = containerId Then
			GamePrint indent & " " & UCase(Left(obj("name"), 1)) & Mid(obj("name"), 2)
		End If
	Next
End Sub

' ==========================================================
' PARSER
' ==========================================================

Sub ParseCommand(cmd As String)
	Dim words As Array
	Dim cleaned As String
	Dim i As Integer
	Dim w As String

	ParsedVerb = ""
	ParsedNoun1 = ""
	ParsedNoun2 = ""
	ParsedPrep = ""

	cleaned = LCase(Trim(cmd))
	RawInput = cleaned
	words = Split(cleaned, " ")

	' Remove articles
	Dim filtered() As String
	Dim fc As Integer
	fc = 0
	ReDim filtered(UBound(words))
	For i = 0 To UBound(words)
		w = Trim(words(i))
		If w < > "the" And w < > "a" And w < > "an" And w < > "my" And Len(w) > 0 Then
			filtered(fc) = w
			fc = fc + 1
		End If
	Next i

	If fc = 0 Then Return

	' First word is the verb (or direction)
	Dim verb As String
	verb = filtered(0)

	' Check if it's a direction
	If DirMap.Exists(verb) Then
		ParsedVerb = "GO"
		ParsedNoun1 = DirMap(verb)
		Return
	End If

	' Handle "turn on/off"
	If verb = "turn" And fc > = 2 Then
		If filtered(1) = "on" Then
			ParsedVerb = "TURNON"
			If fc > = 3 Then ParsedNoun1 = filtered(2)
			Return
		ElseIf filtered(1) = "off" Then
			ParsedVerb = "TURNOFF"
			If fc > = 3 Then ParsedNoun1 = filtered(2)
			Return
		End If
	End If

	' Handle "pick up"
	If verb = "pick" And fc > = 2 Then
		If filtered(1) = "up" Then
			ParsedVerb = "TAKE"
			If fc > = 3 Then ParsedNoun1 = filtered(2)
			Return
		End If
	End If

	' Handle "look at" / "look in"
	If verb = "look" And fc > = 2 Then
		If filtered(1) = "at" Or filtered(1) = "in" Or filtered(1) = "inside" Then
			ParsedVerb = "EXAMINE"
			If fc > = 3 Then ParsedNoun1 = filtered(2)
			Return
		End If
	End If

	' Map verb
	If VerbMap.Exists(verb) Then
		ParsedVerb = VerbMap(verb)
	Else
		ParsedVerb = UCase(verb)
	End If

	' Find preposition and split nouns
	Dim prepIdx As Integer
	prepIdx = - 1
	For i = 1 To fc - 1
		w = filtered(i)
		If w = "in" Or w = "on" Or w = "with" Or w = "to" Or w = "from" Or w = "at" Or w = "into" Or w = "onto" Or w = "about" Or w = "under" Then
			prepIdx = i
			ParsedPrep = w
			Exit For
		End If
	Next i

	If prepIdx > 0 Then
		' Noun1 is between verb and prep
		If prepIdx > 1 Then
			ParsedNoun1 = filtered(1)
			' Handle multi-word noun1
			For i = 2 To prepIdx - 1
				ParsedNoun1 = ParsedNoun1 & " " & filtered(i)
			Next i
		End If
		' Noun2 is after prep
		If prepIdx < fc - 1 Then
			ParsedNoun2 = filtered(prepIdx + 1)
			For i = prepIdx + 2 To fc - 1
				ParsedNoun2 = ParsedNoun2 & " " & filtered(i)
			Next i
		End If
	Else
		' No preposition - everything after verb is noun1
		If fc > = 2 Then
			ParsedNoun1 = filtered(1)
			For i = 2 To fc - 1
				ParsedNoun1 = ParsedNoun1 & " " & filtered(i)
			Next i
		End If
	End If
End Sub

Function FindObject(noun As String) As String
	If Len(noun) = 0 Then
		FindObject = ""
		Return ""
	End If

	Dim nounLower As String
	nounLower = LCase(Trim(noun))
	Dim nounWords As Array
	nounWords = Split(nounLower, " ")
	Dim firstWord As String
	firstWord = nounWords(0)

	' Check each visible object
	Dim objKeys As Array
	Dim k As Variant
	Dim bestMatch As String
	bestMatch = ""

	objKeys = Objects.Keys()
	For Each k In objKeys
		Dim obj As Object
		Set obj = Objects(CStr(k))
		Dim loc As String
		loc = obj("location")

		' Is this object visible?
		Dim visible As Boolean
		visible = False
		If loc = CurrentRoom Then visible = True
		If loc = "PLAYER" Then visible = True
		' Check if in an open container in room or inventory
		If Objects.Exists(loc) Then
			Dim parent As Object
			Set parent = Objects(loc)
			If parent("location") = CurrentRoom Or parent("location") = "PLAYER" Then
				If HasFlag(loc, "CONTBIT") Then
					visible = True
				End If
			End If
		End If

		If Not visible Then GoTo NextObj

		' Check synonyms
		Dim syns As String
		syns = obj("synonyms")
		Dim synArr As Array
		synArr = Split(syns, ",")
		Dim s As Variant
		For Each s In synArr
			If Trim(LCase(CStr(s))) = firstWord Then
				bestMatch = CStr(k)
				FindObject = bestMatch
				Return bestMatch
			End If
		Next

		' Check object name contains the noun
		If InStr(LCase(obj("name")), firstWord) > 0 Then
			bestMatch = CStr(k)
		End If

	NextObj:
Next

FindObject = bestMatch
Return bestMatch
End Function

' ==========================================================
' COMMAND PROCESSOR
' ==========================================================

Sub ProcessCommand(cmd As String)
	If Not GameRunning Then
		GamePrint "The game is over. Type QUIT to exit."
		Return
	End If

	ParseCommand cmd

	If Len(ParsedVerb) = 0 Then
		GamePrint "I don't understand that."
		Return
	End If

	Select Case ParsedVerb
	Case "GO"
		DoGo ParsedNoun1
	Case "LOOK"
		DoLook
	Case "EXAMINE"
		DoExamine ParsedNoun1
	Case "TAKE"
		DoTake ParsedNoun1
	Case "DROP"
		DoDrop ParsedNoun1
	Case "OPEN"
		DoOpen ParsedNoun1
	Case "CLOSE"
		DoClose ParsedNoun1
	Case "INVENTORY"
		DoInventory
	Case "TURNON"
		DoTurnOn ParsedNoun1
	Case "TURNOFF"
		DoTurnOff ParsedNoun1
	Case "READ"
		DoRead ParsedNoun1
	Case "EAT"
		DoEat ParsedNoun1
	Case "DRINK"
		DoDrink ParsedNoun1
	Case "ATTACK"
		DoAttack ParsedNoun1, ParsedNoun2
	Case "PUT"
		DoPut ParsedNoun1, ParsedNoun2
	Case "THROW"
		DoThrow ParsedNoun1
	Case "SAY"
		DoSay ParsedNoun1
	Case "WAVE"
		DoWave ParsedNoun1
	Case "DIG"
		DoDig
	Case "TIE"
		DoTie ParsedNoun1, ParsedNoun2
	Case "PRAY"
		DoPray
	Case "UNLOCK"
		DoUnlock ParsedNoun1, ParsedNoun2
	Case "LOCK"
		GamePrint "You can't lock that."
	Case "INFLATE"
		DoInflate ParsedNoun1, ParsedNoun2
	Case "CLIMB"
		DoClimb ParsedNoun1
	Case "RING"
		DoRing ParsedNoun1
	Case "SCORE"
		DoScore
	Case "DIAGNOSE"
		DoDiagnose
	Case "QUIT"
		DoQuit
	Case "VERBOSE"
		Verbose = True
		GamePrint "Maximum verbosity."
	Case "BRIEF"
		Verbose = False
		GamePrint "Brief descriptions."
	Case "TTS"
		TtsEnabled = Not TtsEnabled
		If TtsEnabled Then
			GamePrint "[color=yellow]Text-to-speech enabled.[/color]"
		Else
			GamePrint "Text-to-speech disabled."
		End If
	Case "HELP"
		DoHelp
	Case "WAIT"
		GamePrint "Time passes..."
		AdvanceTurn
	Case "SWIM"
		GamePrint "You'd need a boat for that."
	Case "SAVE"
		GamePrint "Sorry, save is not yet implemented in this version."
	Case "RESTORE"
		GamePrint "Sorry, restore is not yet implemented in this version."
	Case "ODYSSEUS"
		DoSay "odysseus"
	Case "ECHO"
		DoSay "echo"
	Case "MOVE"
		DoMove ParsedNoun1
	Case "GIVE"
		DoGive ParsedNoun1, ParsedNoun2
	Case "TURN"
		GamePrint "Turn what?"
	Case Else
		GamePrint "I don't know how to do that."
	End Select
End Sub

' ==========================================================
' MOVEMENT
' ==========================================================

Sub DoGo(direction As String)
	If Len(direction) = 0 Then
		GamePrint "Which direction?"
		Return
	End If

	Dim dir As String
	dir = UCase(direction)
	If DirMap.Exists(LCase(direction)) Then
		dir = DirMap(LCase(direction))
	End If

	' Check conditional exits
	Dim blocked As String
	blocked = CheckConditionalExit(dir)
	If Len(blocked) > 0 Then
		GamePrint blocked
		Return
	End If

	' Check normal exits
	Dim room As Object
	Set room = Rooms(CurrentRoom)
	Dim exits As Object
	Set exits = room("exits")

	If Not exits.Exists(dir) Then
		GamePrint "You can't go that way."
		Return
	End If

	Dim target As String
	target = exits(dir)

	' Check if target room exists
	If Not Rooms.Exists(target) Then
		GamePrint "You can't go that way."
		Return
	End If

	' Special: moving in dark
	If Not IsLit() Then
		' 80% chance of grue death in dark
		Dim roll As Integer
		roll = Int(Rnd() * 5)
		If roll < 4 Then
			GamePrint "Oh no! You have walked into the slavering fangs of a lurking grue!"
			DoJigsUp "grue"
			Return
		End If
	End If

	' Move
	CurrentRoom = target

	' Advance turn
	AdvanceTurn
	ShowRoom False
End Sub

Function CheckConditionalExit(dir As String) As String
	CheckConditionalExit = ""

	Select Case CurrentRoom
	Case "EAST-OF-HOUSE"
		If dir = "W" Then
			If Not WindowOpen Then
				CheckConditionalExit = "The window is closed."
				Return CheckConditionalExit
			End If
		End If
	Case "KITCHEN"
		If dir = "E" Then
			If Not WindowOpen Then
				CheckConditionalExit = "The window is closed."
				Return CheckConditionalExit
			End If
		End If
	Case "LIVING-ROOM"
		If dir = "D" Then
			If Not TrapDoorOpen Then
				CheckConditionalExit = "You can't go that way."
				Return CheckConditionalExit
			End If
		End If
		If dir = "W" Then
			If Not MagicFlag Then
				CheckConditionalExit = "The door is nailed shut."
				Return CheckConditionalExit
			End If
		End If
	Case "CELLAR"
		If dir = "U" Then
			If Not TrapDoorOpen Then
				CheckConditionalExit = "The trap door above you is closed."
				Return CheckConditionalExit
			End If
		End If
	Case "TROLL-ROOM"
		If dir = "E" Or dir = "W" Then
			If Not TrollDead And TrollUnconscious < = 0 Then
				GamePrint "The troll fends you off with a menacing gesture."
				CheckConditionalExit = " "
				Return CheckConditionalExit
			End If
		End If
	Case "GRATING-CLEARING"
		If dir = "D" Then
			If Not GratingOpen Then
				CheckConditionalExit = "The grating is locked."
				Return CheckConditionalExit
			End If
		End If
	Case "GRATING-ROOM"
		If dir = "U" Then
			If Not GratingOpen Then
				CheckConditionalExit = "The grating is locked."
				Return CheckConditionalExit
			End If
		End If
	Case "DOME-ROOM"
		If dir = "D" Then
			If Not DomeRoped Then
				CheckConditionalExit = "You cannot go down without a rope tied to the railing."
				Return CheckConditionalExit
			End If
		End If
	Case "ENTRANCE-TO-HADES"
		If dir = "S" Or dir = "IN" Then
			If Not SpiritsBanished Then
				CheckConditionalExit = "The spirits block your way with an unearthly shriek!"
				Return CheckConditionalExit
			End If
		End If
	Case "CYCLOPS-ROOM"
		If dir = "E" Then
			If Not MagicFlag Then
				CheckConditionalExit = "The east wall is solid rock."
				Return CheckConditionalExit
			End If
		End If
		If dir = "U" Then
			If Not CyclopsFled Then
				CheckConditionalExit = "The cyclops doesn't look like he'd let you up there."
				Return CheckConditionalExit
			End If
		End If
	Case "RESERVOIR-SOUTH"
		If dir = "N" Then
			If Not LowTide Then
				CheckConditionalExit = "You would drown."
				Return CheckConditionalExit
			End If
		End If
	Case "RESERVOIR-NORTH"
		If dir = "S" Then
			If Not LowTide Then
				CheckConditionalExit = "You would drown."
				Return CheckConditionalExit
			End If
		End If
	Case "RESERVOIR"
		If Not LowTide Then
			CheckConditionalExit = "You are in the water and likely to drown!"
			Return CheckConditionalExit
		End If
	Case "END-OF-RAINBOW"
		If dir = "E" Then
			If Not RainbowSolid Then
				CheckConditionalExit = "You can't walk on a rainbow!"
				Return CheckConditionalExit
			End If
		End If
	Case "ARAGAIN-FALLS"
		If dir = "W" Then
			If Not RainbowSolid Then
				CheckConditionalExit = "You can't walk on a rainbow!"
				Return CheckConditionalExit
			End If
		End If
	Case "WEST-OF-HOUSE"
		If dir = "E" Then
			CheckConditionalExit = "The door is boarded and you can't remove the boards."
			Return CheckConditionalExit
		End If
		If dir = "SW" Then
			If Not WonGame Then
				CheckConditionalExit = "You can't go that way."
				Return CheckConditionalExit
			End If
		End If
	End Select

	Return ""
End Function

' ==========================================================
' LOOK & EXAMINE
' ==========================================================

Sub DoLook()
	ShowRoom True
End Sub

Sub DoExamine(noun As String)
	If Len(noun) = 0 Then
		ShowRoom True
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You can't see any " & noun & " here."
		Return
	End If

	Dim obj As Object
	Set obj = Objects(objId)

	' Show readable text if any
	If Len(obj("text")) > 0 Then
		GamePrint obj("text")
		Return
	End If

	' Show description
	If Len(obj("fdesc")) > 0 Then
		GamePrint obj("fdesc")
	ElseIf Len(obj("ldesc")) > 0 Then
		GamePrint obj("ldesc")
	Else
		GamePrint "You see nothing special about the " & obj("name") & "."
	End If

	' Show contents of containers
	If HasFlag(objId, "CONTBIT") Then
		If HasFlag(objId, "OPENBIT") Or HasFlag(objId, "TRANSBIT") Then
			Dim hasContents As Boolean
			hasContents = False
			Dim objKeys As Array
			Dim k As Variant
			objKeys = Objects.Keys()
			For Each k In objKeys
				Dim child As Object
				Set child = Objects(CStr(k))
				If child("location") = objId Then
					If Not hasContents Then
						GamePrint "The " & obj("name") & " contains:"
						hasContents = True
					End If
					GamePrint " " & child("name")
				End If
			Next
			If Not hasContents Then
				GamePrint "The " & obj("name") & " is empty."
			End If
		Else
			GamePrint "The " & obj("name") & " is closed."
		End If
	End If
End Sub

' ==========================================================
' TAKE & DROP
' ==========================================================

Sub DoTake(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Take what?"
		Return
	End If

	' Handle "take all"
	If noun = "all" Or noun = "everything" Then
		Dim tookSomething As Boolean
		tookSomething = False
		Dim allKeys As Array
		Dim ak As Variant
		allKeys = Objects.Keys()
		For Each ak In allKeys
			Dim aObj As Object
			Set aObj = Objects(CStr(ak))
			If aObj("location") = CurrentRoom And HasFlag(CStr(ak), "TAKEBIT") Then
				aObj("location") = "PLAYER"
				GamePrint aObj("name") & ": Taken."
				AwardPickupScore CStr(ak)
				tookSomething = True
			End If
		Next
		If Not tookSomething Then
			GamePrint "There is nothing here to take."
		End If
		AdvanceTurn
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You can't see any " & noun & " here."
		Return
	End If

	Dim obj As Object
	Set obj = Objects(objId)

	If obj("location") = "PLAYER" Then
		GamePrint "You already have that."
		Return
	End If

	If Not HasFlag(objId, "TAKEBIT") Then
		' Special responses for non-takeable items
		Select Case objId
		Case "TROPHY-CASE"
			GamePrint "The trophy case is securely fastened to the wall."
		Case "MACHINE"
			GamePrint "It is far too heavy to lift."
		Case "TROLL"
			GamePrint "The troll is not amused."
		Case "CYCLOPS"
			GamePrint "The cyclops does not take kindly to that."
		Case "GRATING"
			GamePrint "It is securely fastened."
		Case Else
			GamePrint "You can't take the " & obj("name") & "."
		End Select
		Return
	End If

	' Check weight
	If CarriedWeight() + obj("size") > MaxCarry Then
		GamePrint "Your load is too heavy."
		Return
	End If

	' Remove from container if inside one
	obj("location") = "PLAYER"
	GamePrint "Taken."
	AwardPickupScore objId
	AdvanceTurn
End Sub

Sub DoDrop(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Drop what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You don't have any " & noun & "."
		Return
	End If

	Dim obj As Object
	Set obj = Objects(objId)

	If obj("location") < > "PLAYER" Then
		GamePrint "You're not carrying that."
		Return
	End If

	obj("location") = CurrentRoom
	GamePrint "Dropped."

	' Special: drop bar in loud room
	If objId = "BAR" And CurrentRoom = "LOUD-ROOM" Then
		GamePrint "The sound of the platinum bar landing on the ground is deafening."
	End If

	AdvanceTurn
End Sub

' ==========================================================
' OPEN & CLOSE
' ==========================================================

Sub DoOpen(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Open what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	' Special: trap door
	If noun = "trapdoor" Or noun = "door" Or noun = "trap" Then
		If CurrentRoom = "LIVING-ROOM" Then
			objId = "TRAP-DOOR"
		End If
	End If

	' Special: window
	If noun = "window" Then
		If CurrentRoom = "EAST-OF-HOUSE" Or CurrentRoom = "KITCHEN" Then
			WindowOpen = True
			GamePrint "With great effort, you open the window far enough to allow entry."
			AdvanceTurn
			Return
		End If
	End If

	' Special: grating
	If noun = "grating" Or noun = "grate" Then
		If CurrentRoom = "GRATING-CLEARING" Or CurrentRoom = "GRATING-ROOM" Then
			If IsCarrying("KEYS") Then
				GratingOpen = True
				GamePrint "The grating opens to reveal a dark passage below."
			Else
				GamePrint "The grating is locked."
			End If
			AdvanceTurn
			Return
		End If
	End If

	If Len(objId) = 0 Then
		GamePrint "You can't see any " & noun & " here."
		Return
	End If

	' Special: trap door
	If objId = "TRAP-DOOR" Then
		If Not RugMoved Then
			GamePrint "You don't see a trap door here."
			Return
		End If
		TrapDoorOpen = True
		GamePrint "The trap door opens to reveal a dark passage below."
		AdvanceTurn
		Return
	End If

	' Special: egg
	If objId = "EGG" Then
		If IsCarrying("EGG") Then
			GamePrint "You have neither the tools nor the expertise to open the egg without damaging it."
		Else
			GamePrint "You can't open the egg."
		End If
		Return
	End If

	' Special: coffin
	If objId = "COFFIN" Then
		SetFlag objId, "OPENBIT"
		GamePrint "The gold coffin opens."
		' Reveal sceptre
		Dim scObj As Object
		Set scObj = Objects("SCEPTRE")
		If scObj("location") = "COFFIN" Then
			GamePrint "A sceptre falls out of the coffin!"
			scObj("location") = CurrentRoom
		End If
		AdvanceTurn
		Return
	End If

	' Generic container
	If HasFlag(objId, "CONTBIT") Then
		If HasFlag(objId, "OPENBIT") Then
			GamePrint "It's already open."
		Else
			SetFlag objId, "OPENBIT"
			Dim oobj As Object
			Set oobj = Objects(objId)
			GamePrint "Opened."
			' Show contents
			ShowContents objId, ""
		End If
		AdvanceTurn
		Return
	End If

	GamePrint "You can't open that."
End Sub

Sub DoClose(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Close what?"
		Return
	End If

	' Special: window
	If noun = "window" Then
		If CurrentRoom = "EAST-OF-HOUSE" Or CurrentRoom = "KITCHEN" Then
			WindowOpen = False
			GamePrint "The window is now closed."
			AdvanceTurn
			Return
		End If
	End If

	' Special: trap door
	If noun = "trapdoor" Or noun = "door" Or noun = "trap" Then
		If CurrentRoom = "LIVING-ROOM" Then
			TrapDoorOpen = False
			GamePrint "The trap door is now closed."
			AdvanceTurn
			Return
		End If
	End If

	' Special: grating
	If noun = "grating" Or noun = "grate" Then
		GratingOpen = False
		GamePrint "The grating is now closed."
		AdvanceTurn
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You can't see any " & noun & " here."
		Return
	End If

	If HasFlag(objId, "CONTBIT") Then
		If Not HasFlag(objId, "OPENBIT") Then
			GamePrint "It's already closed."
		Else
			ClearFlag objId, "OPENBIT"
			GamePrint "Closed."
		End If
		AdvanceTurn
		Return
	End If

	GamePrint "You can't close that."
End Sub

' ==========================================================
' TURN ON / TURN OFF
' ==========================================================

Sub DoTurnOn(noun As String)
	If Len(noun) = 0 Then
		' Default: lamp
		If IsCarrying("LAMP") Then
			noun = "lamp"
		Else
			GamePrint "Turn on what?"
			Return
		End If
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You can't see any " & noun & " here."
		Return
	End If

	If objId = "LAMP" Then
		If Not IsCarrying("LAMP") And ObjProp("LAMP", "location") < > CurrentRoom Then
			GamePrint "You don't have the lamp."
			Return
		End If
		If LampDead Then
			GamePrint "The lamp has run out of power."
			Return
		End If
		LampOn = True
		SetFlag "LAMP", "ONBIT"
		GamePrint "The brass lantern is now on."
		If Not IsLit() Then
			GamePrint "The room is now lit."
		End If
		ShowRoom False
		AdvanceTurn
		Return
	End If

	If objId = "CANDLES" Then
		If Not IsCarrying("CANDLES") And ObjProp("CANDLES", "location") < > CurrentRoom Then
			GamePrint "You don't have the candles."
			Return
		End If
		If CandleDead Then
			GamePrint "The candles have burned out."
			Return
		End If
		If Not IsCarrying("MATCHES") Then
			GamePrint "You have no source of fire."
			Return
		End If
		CandlesLit = True
		SetFlag "CANDLES", "ONBIT"
		GamePrint "The candles are now lit."
		AdvanceTurn
		Return
	End If

	GamePrint "You can't turn that on."
End Sub

Sub DoTurnOff(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Turn off what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You can't see any " & noun & " here."
		Return
	End If

	If objId = "LAMP" Then
		LampOn = False
		ClearFlag "LAMP", "ONBIT"
		GamePrint "The brass lantern is now off."
		If Not IsLit() Then
			GamePrint "It is now pitch dark."
		End If
		AdvanceTurn
		Return
	End If

	If objId = "CANDLES" Then
		CandlesLit = False
		ClearFlag "CANDLES", "ONBIT"
		GamePrint "The candles are extinguished."
		AdvanceTurn
		Return
	End If

	GamePrint "You can't turn that off."
End Sub

' ==========================================================
' READ & EAT & DRINK
' ==========================================================

Sub DoRead(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Read what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You can't see any " & noun & " here."
		Return
	End If

	Dim obj As Object
	Set obj = Objects(objId)

	If Len(obj("text")) > 0 Then
		GamePrint obj("text")
	Else
		GamePrint "There's nothing written on the " & obj("name") & "."
	End If
	AdvanceTurn
End Sub

Sub DoEat(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Eat what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You don't have any " & noun & "."
		Return
	End If

	If Not IsCarrying(objId) Then
		GamePrint "You're not carrying that."
		Return
	End If

	If HasFlag(objId, "FOODBIT") Then
		Dim obj As Object
		Set obj = Objects(objId)
		obj("location") = "LIMBO"
		If objId = "GARLIC" Then
			GamePrint "What a waste of a perfectly good garlic clove!"
		ElseIf objId = "LUNCH" Then
			GamePrint "Thank you very much. It really hit the spot."
		Else
			GamePrint "That tasted terrible."
		End If
		AdvanceTurn
		Return
	End If

	GamePrint "I don't think the " & ObjProp(objId, "name") & " would agree with you."
End Sub

Sub DoDrink(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Drink what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If objId = "WATER" Then
		If IsCarrying("WATER") Or IsCarrying("BOTTLE") Then
			Objects("WATER")("location") = "LIMBO"
			GamePrint "Thank you very much. I was very thirsty (probably from all this strenuousness)."
			AdvanceTurn
			Return
		End If
	End If

	GamePrint "You can't drink that."
End Sub

' ==========================================================
' INVENTORY
' ==========================================================

Sub DoInventory()
	Dim hasItems As Boolean
	hasItems = False
	Dim objKeys As Array
	Dim k As Variant

	GamePrint "You are carrying:"
	objKeys = Objects.Keys()
	For Each k In objKeys
		Dim obj As Object
		Set obj = Objects(CStr(k))
		If obj("location") = "PLAYER" Then
			Dim extra As String
			extra = ""
			If CStr(k) = "LAMP" Then
				If LampOn Then
					extra = " (providing light)"
				End If
			End If
			GamePrint " " & obj("name") & extra
			hasItems = True
			' Show contents
			If HasFlag(CStr(k), "CONTBIT") Then
				ShowContents CStr(k), " "
			End If
		End If
	Next

	If Not hasItems Then
		GamePrint " nothing"
	End If
End Sub

' ==========================================================
' PUT
' ==========================================================

Sub DoPut(noun1 As String, noun2 As String)
	If Len(noun1) = 0 Then
		GamePrint "Put what?"
		Return
	End If

	If Len(noun2) = 0 Then
		GamePrint "Put it where?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun1)

	If Len(objId) = 0 Then
		GamePrint "You don't have any " & noun1 & "."
		Return
	End If

	If Not IsCarrying(objId) Then
		GamePrint "You're not carrying the " & ObjProp(objId, "name") & "."
		Return
	End If

	Dim targetId As String
	targetId = FindObject(noun2)

	If Len(targetId) = 0 Then
		GamePrint "You can't see any " & noun2 & " here."
		Return
	End If

	' Special: put in trophy case
	If targetId = "TROPHY-CASE" Then
		Dim obj As Object
		Set obj = Objects(objId)
		obj("location") = "TROPHY-CASE"
		GamePrint "Done."
		' Score for placing treasure
		AwardTrophyScore objId
		AdvanceTurn
		Return
	End If

	' Special: put coal in machine
	If targetId = "MACHINE" And objId = "COAL" Then
		Objects("COAL")("location") = "MACHINE"
		CoalInMachine = True
		GamePrint "Done."
		AdvanceTurn
		Return
	End If

	If HasFlag(targetId, "CONTBIT") Then
		If Not HasFlag(targetId, "OPENBIT") Then
			GamePrint "The " & ObjProp(targetId, "name") & " is closed."
			Return
		End If
		Objects(objId)("location") = targetId
		GamePrint "Done."
		AdvanceTurn
		Return
	End If

	GamePrint "You can't put anything in the " & ObjProp(targetId, "name") & "."
End Sub

' ==========================================================
' ATTACK / COMBAT
' ==========================================================

Sub DoAttack(noun1 As String, noun2 As String)
	If Len(noun1) = 0 Then
		GamePrint "Attack what?"
		Return
	End If

	Dim targetId As String
	targetId = FindObject(noun1)

	If Len(targetId) = 0 Then
		GamePrint "You can't see any " & noun1 & " here."
		Return
	End If

	If Not HasFlag(targetId, "ACTORBIT") Then
		GamePrint "I've known strange people, but fighting a " & ObjProp(targetId, "name") & " is beyond my comprehension."
		Return
	End If

	' Find weapon
	Dim weaponId As String
	weaponId = ""
	If Len(noun2) > 0 Then
		weaponId = FindObject(noun2)
		If Len(weaponId) > 0 And Not IsCarrying(weaponId) Then
			GamePrint "You're not holding the " & ObjProp(weaponId, "name") & "."
			Return
		End If
	Else
		' Auto-select weapon
		If IsCarrying("SWORD") Then
			weaponId = "SWORD"
		ElseIf IsCarrying("KNIFE") Then
			weaponId = "KNIFE"
		ElseIf IsCarrying("AXE") Then
			weaponId = "AXE"
		End If
	End If

	If Len(weaponId) = 0 Or Not HasFlag(weaponId, "WEAPONBIT") Then
		GamePrint "Strstrnggling with the " & ObjProp(targetId, "name") & " bare-handed is suicidal."
		Return
	End If

	' Combat!
	Select Case targetId
	Case "TROLL"
		CombatTroll weaponId
	Case "THIEF"
		CombatThief weaponId
	Case "CYCLOPS"
		GamePrint "The cyclops laughs at your puny weapon and knocks you across the room."
		PlayerWounds = PlayerWounds + 1
	Case Else
		GamePrint "Attacking the " & ObjProp(targetId, "name") & " is pointless."
	End Select

	AdvanceTurn
End Sub

Sub CombatTroll(weaponId As String)
	If TrollDead Then
		GamePrint "The troll is already dead."
		Return
	End If

	Dim playerStr As Integer
	playerStr = GetPlayerStrength()
	Dim roll As Integer
	roll = Int(Rnd() * 10)

	If roll < playerStr Then
		' Hit!
		Dim damage As Integer
		damage = Int(Rnd() * 3) + 1
		If damage > = 2 Then
			TrollDead = True
			GamePrint "It's a decisive blow! The troll staggers, tumbles to the ground, and dies."
			GamePrint "Almost immediately, a passageway opens to the east and west."
			Objects("AXE")("location") = CurrentRoom
		Else
			TrollUnconscious = 3
			GamePrint "A good stroke! The troll staggers and falls unconscious."
		End If
	Else
		' Troll attacks back
		GamePrint "The troll parries your blow and swings his axe!"
		Dim trollRoll As Integer
		trollRoll = Int(Rnd() * 10)
		If trollRoll < 4 Then
			PlayerWounds = PlayerWounds + 1
			CureTimer = 30
			GamePrint "The axe cuts your arm! You are wounded."
		Else
			GamePrint "The axe narrowly misses you."
		End If
	End If
End Sub

Sub CombatThief(weaponId As String)
	If ThiefDead Then
		GamePrint "The thief is already dead."
		Return
	End If

	Dim playerStr As Integer
	playerStr = GetPlayerStrength()
	Dim roll As Integer
	roll = Int(Rnd() * 10)

	If roll < playerStr Then
		Dim damage As Integer
		damage = Int(Rnd() * 4) + 1
		If damage > = 3 Then
			ThiefDead = True
			GamePrint "A fatal blow! The thief crumples to the floor."
			' Drop thief's inventory
			Dim objKeys As Array
			Dim k As Variant
			objKeys = Objects.Keys()
			For Each k In objKeys
				If ObjProp(CStr(k), "location") = "THIEF" Then
					Objects(CStr(k))("location") = CurrentRoom
				End If
			Next
		Else
			GamePrint "The thief reels from a good blow, but recovers."
		End If
	Else
		GamePrint "The thief easily dodges your attack and lunges!"
		Dim thiefRoll As Integer
		thiefRoll = Int(Rnd() * 10)
		If thiefRoll < 5 Then
			PlayerWounds = PlayerWounds + 1
			CureTimer = 30
			GamePrint "The stiletto slices you! You are wounded."
		Else
			GamePrint "The thief's stiletto misses."
		End If
	End If
End Sub

' ==========================================================
' SAY
' ==========================================================

Sub DoSay(word As String)
	If Len(word) = 0 Then
		GamePrint "Say what?"
		Return
	End If

	Dim said As String
	said = LCase(Trim(word))

	GamePrint "You say " & Chr(34) & word & Chr(34) & "."

	' Odysseus puzzle
	If (said = "odysseus" Or said = "ulysses") And CurrentRoom = "CYCLOPS-ROOM" Then
		If Not CyclopsFled Then
			GamePrint "The cyclops, hearing the name of his bane, flees the room in terror!"
			GamePrint "As he leaves, the wall to the east crumbles, revealing a passage."
			CyclopsFled = True
			MagicFlag = True
			Objects("CYCLOPS")("location") = "LIMBO"
			AdvanceTurn
			Return
		End If
	End If

	' Echo in loud room
	If said = "echo" And CurrentRoom = "LOUD-ROOM" Then
		GamePrint "The acoustics of the room change subtly. The roaring noise is silenced."
		AdvanceTurn
		Return
	End If

	AdvanceTurn
End Sub

' ==========================================================
' WAVE
' ==========================================================

Sub DoWave(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Wave what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You don't have any " & noun & "."
		Return
	End If

	If Not IsCarrying(objId) Then
		GamePrint "You aren't holding the " & ObjProp(objId, "name") & "."
		Return
	End If

	' Wave sceptre at rainbow
	If objId = "SCEPTRE" Then
		If CurrentRoom = "ON-RAINBOW" Or CurrentRoom = "ARAGAIN-FALLS" Or CurrentRoom = "END-OF-RAINBOW" Then
			If Not RainbowSolid Then
				RainbowSolid = True
				GamePrint "Suddenly, the rainbow appears to become solid and is now climbable!"
			Else
				RainbowSolid = False
				GamePrint "The rainbow seems to dim and becomes unclimbable."
				If CurrentRoom = "ON-RAINBOW" Then
					GamePrint "You fall off the rainbow!"
					CurrentRoom = "CANYON-BOTTOM"
					ShowRoom False
				End If
			End If
			AdvanceTurn
			Return
		End If
	End If

	GamePrint "You wave the " & ObjProp(objId, "name") & ". Nothing happens."
	AdvanceTurn
End Sub

' ==========================================================
' DIG
' ==========================================================

Sub DoDig()
	If Not IsCarrying("SHOVEL") Then
		GamePrint "You have nothing to dig with."
		Return
	End If

	If CurrentRoom = "SANDY-BEACH" Or CurrentRoom = "SANDY-CAVE" Then
		If ObjProp("SCARAB", "location") = "SANDY-CAVE" Then
			GamePrint "You uncover a beautiful jeweled scarab!"
			Objects("SCARAB")("location") = CurrentRoom
		Else
			GamePrint "You dig, but find nothing."
		End If
	Else
		GamePrint "The ground is too hard to dig here."
	End If
	AdvanceTurn
End Sub

' ==========================================================
' TIE
' ==========================================================

Sub DoTie(noun1 As String, noun2 As String)
	If Len(noun1) = 0 Then
		GamePrint "Tie what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun1)

	If objId = "ROPE" And CurrentRoom = "DOME-ROOM" Then
		If IsCarrying("ROPE") Then
			DomeRoped = True
			Objects("ROPE")("location") = "DOME-ROOM"
			GamePrint "The rope is now tied to the railing. You can climb down."
		Else
			GamePrint "You don't have the rope."
		End If
		AdvanceTurn
		Return
	End If

	GamePrint "You can't tie that to anything useful here."
	AdvanceTurn
End Sub

' ==========================================================
' PRAY
' ==========================================================

Sub DoPray()
	If CurrentRoom = "SOUTH-TEMPLE" Then
		GamePrint "From the gather of your prayer, there is a flash of light. You feel revitalized."
		PlayerWounds = 0
		CureTimer = 0
	Else
		GamePrint "If you pray hard enough, something might happen."
	End If
	AdvanceTurn
End Sub

' ==========================================================
' UNLOCK
' ==========================================================

Sub DoUnlock(noun1 As String, noun2 As String)
	If Len(noun1) = 0 Then
		GamePrint "Unlock what?"
		Return
	End If

	' Grating
	If noun1 = "grating" Or noun1 = "grate" Then
		If CurrentRoom = "GRATING-CLEARING" Or CurrentRoom = "GRATING-ROOM" Then
			If IsCarrying("KEYS") Then
				GratingOpen = True
				GamePrint "The grating is now unlocked and open."
			Else
				GamePrint "You don't have the key."
			End If
			AdvanceTurn
			Return
		End If
	End If

	GamePrint "You can't unlock that."
	AdvanceTurn
End Sub

' ==========================================================
' INFLATE
' ==========================================================

Sub DoInflate(noun1 As String, noun2 As String)
	If Len(noun1) = 0 Then
		GamePrint "Inflate what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun1)

	If objId = "BOAT" Then
		If IsCarrying("PUMP") Then
			BoatInflated = True
			Objects("BOAT")("flags") = "VEHBIT"
			Dim bObj As Object
			Set bObj = Objects("BOAT")
			bObj("name") = "inflated boat"
			bObj("fdesc") = "There is an inflated boat here."
			bObj("ldesc") = "There is an inflated boat here."
			GamePrint "The boat inflates and appears seaworthy."
		Else
			GamePrint "You don't have anything to inflate it with."
		End If
		AdvanceTurn
		Return
	End If

	GamePrint "You can't inflate that."
	AdvanceTurn
End Sub

' ==========================================================
' CLIMB
' ==========================================================

Sub DoClimb(noun As String)
	If CurrentRoom = "UP-A-TREE" Then
		GamePrint "You cannot climb any higher."
		Return
	End If

	If CurrentRoom = "PATH" Then
		DoGo "U"
		Return
	End If

	If CurrentRoom = "DOME-ROOM" Then
		If DomeRoped Then
			DoGo "D"
		Else
			GamePrint "There's no way down without a rope."
		End If
		Return
	End If

	GamePrint "There's nothing here to climb."
End Sub

' ==========================================================
' RING
' ==========================================================

Sub DoRing(noun As String)
	Dim objId As String
	objId = FindObject(noun)

	If objId = "BELL" Then
		If IsCarrying("BELL") Then
			GamePrint "Ding, dong."
			' Exorcism step 1
			If CurrentRoom = "ENTRANCE-TO-HADES" And Not SpiritsBanished Then
				GamePrint "The bell makes a terrible clanging sound, and the spirits cower!"
				' Bell becomes hot
				AdvanceTurn
				Return
			End If
		Else
			GamePrint "You don't have the bell."
		End If
		AdvanceTurn
		Return
	End If

	GamePrint "You can't ring that."
	AdvanceTurn
End Sub

' ==========================================================
' THROW
' ==========================================================

Sub DoThrow(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Throw what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun)

	If Len(objId) = 0 Then
		GamePrint "You don't have any " & noun & "."
		Return
	End If

	If Not IsCarrying(objId) Then
		GamePrint "You're not carrying that."
		Return
	End If

	Objects(objId)("location") = CurrentRoom
	GamePrint "Thrown."
	AdvanceTurn
End Sub

' ==========================================================
' MOVE
' ==========================================================

Sub DoMove(noun As String)
	If Len(noun) = 0 Then
		GamePrint "Move what?"
		Return
	End If

	' Move rug
	If noun = "rug" Or noun = "carpet" Then
		If CurrentRoom = "LIVING-ROOM" Then
			If Not RugMoved Then
				RugMoved = True
				GamePrint "With a great effort, you move the rug to one side of the room. With the rug moved, the dusty cover of a closed trap door appears."
			Else
				GamePrint "The rug is already moved."
			End If
			AdvanceTurn
			Return
		End If
	End If

	GamePrint "You can't move that."
End Sub

' ==========================================================
' GIVE
' ==========================================================

Sub DoGive(noun1 As String, noun2 As String)
	If Len(noun1) = 0 Then
		GamePrint "Give what?"
		Return
	End If

	Dim objId As String
	objId = FindObject(noun1)

	If Len(objId) = 0 Then
		GamePrint "You don't have any " & noun1 & "."
		Return
	End If

	If Not IsCarrying(objId) Then
		GamePrint "You're not carrying that."
		Return
	End If

	' Give to troll
	If CurrentRoom = "TROLL-ROOM" And Not TrollDead Then
		Objects(objId)("location") = "LIMBO"
		GamePrint "The troll, with a look of satisfaction, takes the " & ObjProp(objId, "name") & " and devours it."
		AdvanceTurn
		Return
	End If

	' Give to cyclops
	If CurrentRoom = "CYCLOPS-ROOM" And Not CyclopsFled Then
		If objId = "LUNCH" Then
			Objects(objId)("location") = "LIMBO"
			GamePrint "The cyclops takes the food and wolfs it down. He then falls asleep."
			GamePrint "The cyclops's loud snoring echoes through the room."
			CyclopsFled = True
			MagicFlag = True
			Objects("CYCLOPS")("location") = "LIMBO"
		Else
			GamePrint "The cyclops is not interested in that."
		End If
		AdvanceTurn
		Return
	End If

	GamePrint "There's no one here to give it to."
	AdvanceTurn
End Sub

' ==========================================================
' SCORE & STATUS
' ==========================================================

Sub DoScore()
	CalculateScore
	GamePrint "Your score is " & CStr(Score) & " (total of " & CStr(MAX_SCORE) & " points), in " & CStr(Moves) & " moves."
	GamePrint "This gives you the rank of " & GetRank() & "."
End Sub

Sub CalculateScore()
	Dim total As Integer
	total = 0

	' Room scores are already added in ShowRoom
	total = Score

	' Check trophy case contents
	Dim objKeys As Array
	Dim k As Variant
	objKeys = Objects.Keys()
	For Each k In objKeys
		Dim obj As Object
		Set obj = Objects(CStr(k))
		' Score for placing in trophy case
		If obj("location") = "TROPHY-CASE" And obj("tvalue") > 0 Then
			' tvalue score is tracked when placed
		End If
	Next

	Score = total
End Sub

Function GetRank() As String
	If Score > = 350 Then
		GetRank = "Master Adventurer"
	ElseIf Score > = 330 Then
		GetRank = "Wizard"
	ElseIf Score > = 300 Then
		GetRank = "Master"
	ElseIf Score > = 200 Then
		GetRank = "Adventurer"
	ElseIf Score > = 100 Then
		GetRank = "Junior Adventurer"
	ElseIf Score > = 50 Then
		GetRank = "Novice Adventurer"
	ElseIf Score > = 25 Then
		GetRank = "Amateur Adventurer"
	Else
		GetRank = "Beginner"
	End If
	Return GetRank
End Function

Sub AwardPickupScore(objId As String)
	Dim obj As Object
	Set obj = Objects(objId)
	If obj("value") > 0 Then
		Score = Score + obj("value")
		obj("value") = 0
		GamePrint "[color=yellow](Your score just went up.)[/color]"
		UpdateStatus
	End If
End Sub

Sub AwardTrophyScore(objId As String)
	Dim obj As Object
	Set obj = Objects(objId)
	If obj("tvalue") > 0 Then
		Score = Score + obj("tvalue")
		obj("tvalue") = 0
		GamePrint "[color=yellow](Your score just went up.)[/color]"
		UpdateStatus
		' Check for win
		If Score > = MAX_SCORE Then
			WonGame = True
			GamePrint ""
			GamePrint "[b][color=yellow]*** CONGRATULATIONS! ***[/color][/b]"
			GamePrint "[color=yellow]You have achieved the maximum score! You are now a Master Adventurer![/color]"
			GamePrint "[color=yellow]A secret path has opened to the southwest of the house...[/color]"
		End If
	End If
End Sub

Sub DoDiagnose()
	If PlayerWounds = 0 Then
		GamePrint "You are in perfect health."
	ElseIf PlayerWounds = 1 Then
		GamePrint "You have a light wound."
	ElseIf PlayerWounds = 2 Then
		GamePrint "You have serious wounds."
	Else
		GamePrint "You are badly wounded and near death."
	End If
	GamePrint "You are carrying " & CStr(CarriedWeight()) & " units of weight."
End Sub

' ==========================================================
' ADVANCE TURN / TIMERS
' ==========================================================

Sub AdvanceTurn()
	Moves = Moves + 1

	' Lamp timer
	If LampOn Then
		LampTurns = LampTurns - 1
		If LampTurns = 20 Then
			GamePrint "[color=yellow]The lamp is getting dim.[/color]"
		ElseIf LampTurns = 5 Then
			GamePrint "[color=yellow]The lamp is almost out of power![/color]"
		ElseIf LampTurns < = 0 Then
			LampOn = False
			LampDead = True
			ClearFlag "LAMP", "ONBIT"
			GamePrint "[color=red]The lamp has run out of power.[/color]"
			If Not IsLit() Then
				GamePrint "It is now pitch dark."
			End If
		End If
	End If

	' Candle timer
	If CandlesLit Then
		CandleTurns = CandleTurns - 1
		If CandleTurns = 10 Then
			GamePrint "[color=yellow]The candles are getting short.[/color]"
		ElseIf CandleTurns < = 0 Then
			CandlesLit = False
			CandleDead = True
			ClearFlag "CANDLES", "ONBIT"
			GamePrint "[color=red]The candles have burned out.[/color]"
		End If
	End If

	' Cure timer
	If PlayerWounds > 0 And CureTimer > 0 Then
		CureTimer = CureTimer - 1
		If CureTimer < = 0 Then
			PlayerWounds = PlayerWounds - 1
			If PlayerWounds > 0 Then
				CureTimer = 30
			End If
			GamePrint "Your wounds are slowly healing."
		End If
	End If

	' Troll unconsciousness
	If TrollUnconscious > 0 Then
		TrollUnconscious = TrollUnconscious - 1
		If TrollUnconscious < = 0 And Not TrollDead Then
			If CurrentRoom = "TROLL-ROOM" Then
				GamePrint "The troll stirs and regains consciousness."
			End If
		End If
	End If

	' Thief movement (simplified)
	HandleThief

	' Check for darkness death
	If Not IsLit() And CurrentRoom < > "LIVING-ROOM" And CurrentRoom < > "KITCHEN" Then
		' Small chance of grue in dark
		If Int(Rnd() * 10) < 2 Then
			GamePrint "[color=red]Oh no! A lurking grue has found you![/color]"
			DoJigsUp "grue"
		End If
	End If

	UpdateStatus
End Sub

' ==========================================================
' THIEF AI (SIMPLIFIED)
' ==========================================================

Sub HandleThief()
	If ThiefDead Then Return

	' Move thief occasionally
	If Int(Rnd() * 5) = 0 Then
		' Move to a random connected room
		Dim thiefRm As Object
		If Not Rooms.Exists(ThiefRoom) Then Return
		Set thiefRm = Rooms(ThiefRoom)
		Dim exits As Object
		Set exits = thiefRm("exits")
		Dim exitKeys As Array
		exitKeys = exits.Keys()
		If UBound(exitKeys) > = 0 Then
			Dim ri As Integer
			ri = Int(Rnd() * (UBound(exitKeys) + 1))
			Dim newRoom As String
			newRoom = exits(exitKeys(ri))
			If Rooms.Exists(newRoom) Then
				' Don't enter certain rooms
				If newRoom < > "LIMBO" Then
					ThiefRoom = newRoom
					Objects("THIEF")("location") = ThiefRoom
					Objects("STILETTO")("location") = "THIEF"
				End If
			End If
		End If
	End If

	' If thief is in same room as player
	If ThiefRoom = CurrentRoom Then
		' Chance to steal something
		If Int(Rnd() * 3) = 0 Then
			' Try to steal a treasure from the room
			Dim objKeys As Array
			Dim k As Variant
			objKeys = Objects.Keys()
			For Each k In objKeys
				Dim obj As Object
				Set obj = Objects(CStr(k))
				If obj("location") = CurrentRoom And obj("tvalue") > 0 And CStr(k) < > "THIEF" And CStr(k) < > "STILETTO" Then
					obj("location") = "THIEF"
					GamePrint "[color=yellow]A lean and hungry gentleman just snatched the " & obj("name") & "![/color]"
					Exit For
				End If
			Next
		End If
	End If
End Sub

' ==========================================================
' DEATH
' ==========================================================

Sub DoJigsUp(cause As String)
	Deaths = Deaths + 1
	Score = Score - 10

	If Deaths > = 3 Then
		GamePrint ""
		GamePrint "[b][color=red]*** You have died ***[/color][/b]"
		GamePrint "You have been killed " & CStr(Deaths) & " times. That's the limit."
		GamePrint "[color=red]*** Game Over ***[/color]"
		GamePrint "Your final score is " & CStr(Score) & " out of " & CStr(MAX_SCORE) & "."
		GameRunning = False
		Return
	End If

	GamePrint ""
	GamePrint "[b][color=red]*** You have died ***[/color][/b]"
	GamePrint ""
	GamePrint "You wake up in the forest clearing, dazed and confused."
	GamePrint "Your possessions have been scattered."

	' Move player to forest
	CurrentRoom = "FOREST-1"

	' Drop all items randomly
	Dim objKeys As Array
	Dim k As Variant
	objKeys = Objects.Keys()
	For Each k In objKeys
		Dim obj As Object
		Set obj = Objects(CStr(k))
		If obj("location") = "PLAYER" Then
			obj("location") = "FOREST-1"
		End If
	Next

	PlayerWounds = 0
	CureTimer = 0
	ShowRoom True
End Sub

' ==========================================================
' UTILITY FUNCTIONS
' ==========================================================

Function HasFlag(objId As String, flag As String) As Boolean
	If Not Objects.Exists(objId) Then
		HasFlag = False
		Return False
	End If
	Dim obj As Object
	Set obj = Objects(objId)
	Dim flags As String
	flags = "," & obj("flags") & ","
	HasFlag = (InStr(flags, "," & flag & ",") > 0)
	Return HasFlag
End Function

Sub SetFlag(objId As String, flag As String)
	If Not Objects.Exists(objId) Then Return
	Dim obj As Object
	Set obj = Objects(objId)
	If Not HasFlag(objId, flag) Then
		If Len(obj("flags")) > 0 Then
			obj("flags") = obj("flags") & "," & flag
		Else
			obj("flags") = flag
		End If
	End If
End Sub

Sub ClearFlag(objId As String, flag As String)
	If Not Objects.Exists(objId) Then Return
	Dim obj As Object
	Set obj = Objects(objId)
	Dim flags As String
	flags = obj("flags")
	flags = Replace(flags, flag, "")
	flags = Replace(flags, ",,", ",")
	If Left(flags, 1) = "," Then flags = Mid(flags, 2)
	If Right(flags, 1) = "," Then flags = Left(flags, Len(flags) - 1)
	obj("flags") = flags
End Sub

Function IsLit() As Boolean
	' Some rooms are always lit
	Dim room As Object
	Set room = Rooms(CurrentRoom)
	If InStr(room("flags"), "RLANDBIT") > 0 Then
		' Check if above ground (rooms before cellar are generally lit)
		Select Case CurrentRoom
		Case "WEST-OF-HOUSE", "NORTH-OF-HOUSE", "SOUTH-OF-HOUSE", "EAST-OF-HOUSE"
			IsLit = True
			Return True
		Case "FOREST-1", "FOREST-2", "FOREST-3", "MOUNTAINS", "PATH", "UP-A-TREE"
			IsLit = True
			Return True
		Case "GRATING-CLEARING", "CLEARING", "CANYON-VIEW", "CLIFF-MIDDLE", "CANYON-BOTTOM"
			IsLit = True
			Return True
		Case "END-OF-RAINBOW", "ON-RAINBOW", "ARAGAIN-FALLS", "SHORE", "SANDY-BEACH"
			IsLit = True
			Return True
		Case "STONE-BARROW"
			IsLit = True
			Return True
		End Select
	End If

	' Check if player has a lit light source
	If LampOn And (IsCarrying("LAMP") Or ObjProp("LAMP", "location") = CurrentRoom) Then
		IsLit = True
		Return True
	End If

	' Ivory torch (always lit)
	If IsCarrying("TORCH-TREASURE") Or ObjProp("TORCH-TREASURE", "location") = CurrentRoom Then
		IsLit = True
		Return True
	End If

	' Candles
	If CandlesLit And (IsCarrying("CANDLES") Or ObjProp("CANDLES", "location") = CurrentRoom) Then
		IsLit = True
		Return True
	End If

	' Matches (very briefly)
	If IsCarrying("MATCHES") And ObjProp("MATCHES", "location") = "PLAYER" Then
		' Matches provide light only when first lit, not persistent
	End If

	IsLit = False
	Return False
End Function

Function IsCarrying(objId As String) As Boolean
	If Not Objects.Exists(objId) Then
		IsCarrying = False
		Return False
	End If
	IsCarrying = (ObjProp(objId, "location") = "PLAYER")
	Return IsCarrying
End Function

Function CarriedWeight() As Integer
	Dim total As Integer
	total = 0
	Dim objKeys As Array
	Dim k As Variant
	objKeys = Objects.Keys()
	For Each k In objKeys
		If ObjProp(CStr(k), "location") = "PLAYER" Then
			total = total + ObjProp(CStr(k), "size")
		End If
	Next
	CarriedWeight = total
	Return total
End Function

Function GetPlayerStrength() As Integer
	Dim base As Integer
	base = STRENGTH_MIN
	If Score > 0 Then
		base = STRENGTH_MIN + (Score * (STRENGTH_MAX - STRENGTH_MIN)) / MAX_SCORE
	End If
	base = base - PlayerWounds
	If base < 1 Then base = 1
	GetPlayerStrength = base
	Return base
End Function

' ==========================================================
' META COMMANDS
' ==========================================================

Sub DoQuit()
	CalculateScore
	GamePrint ""
	GamePrint "Your final score is " & CStr(Score) & " out of " & CStr(MAX_SCORE) & ", in " & CStr(Moves) & " moves."
	GamePrint "This gives you the rank of " & GetRank() & "."
	GamePrint ""
	GamePrint "[color=yellow]Thank you for playing ZORK I![/color]"
	GameRunning = False
End Sub

