Attribute VB_Name = "fuzz_singletons"


Sub RunTest0()
    On Error Resume Next
    Dim desc As String = str(Engine)
    If desc <> "" And desc <> "Null" Then
        Print "PASS:singleton_Engine"
    Else
        Print "FAIL:singleton_Engine not accessible"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:singleton_Engine err=" & str(Err.Number)
    End If
End Sub


