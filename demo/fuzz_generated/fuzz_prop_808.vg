Attribute VB_Name = "fuzz_prop_808"


Sub RunTest0()
    On Error Resume Next
    Dim obj As GraphEdit = GraphEdit.new()
    If obj = Null Then
        Print "SKIP:prop_GraphEdit_snapping_distance (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.snapping_distance
    Print "PASS:prop_GraphEdit_snapping_distance"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_GraphEdit_snapping_distance err=" & str(Err.Number)
    End If
End Sub


