Attribute VB_Name = "fuzz_inst_640"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeIf = VisualShaderNodeIf.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeIf"
    Else
        Print "FAIL:inst_VisualShaderNodeIf returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeIf err=" & str(Err.Number)
    End If
End Sub


