Attribute VB_Name = "fuzz_inst_710"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeVectorRefract = VisualShaderNodeVectorRefract.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeVectorRefract"
    Else
        Print "FAIL:inst_VisualShaderNodeVectorRefract returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeVectorRefract err=" & str(Err.Number)
    End If
End Sub


