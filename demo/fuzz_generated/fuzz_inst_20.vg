Attribute VB_Name = "fuzz_inst_20"


Sub RunTest0()
    On Error Resume Next
    Dim obj As Animation = Animation.new()
    If obj <> Null Then
        Print "PASS:inst_Animation"
    Else
        Print "FAIL:inst_Animation returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_Animation err=" & str(Err.Number)
    End If
End Sub


