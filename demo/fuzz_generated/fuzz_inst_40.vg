Attribute VB_Name = "fuzz_inst_40"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AnimationNodeTimeSeek = AnimationNodeTimeSeek.new()
    If obj <> Null Then
        Print "PASS:inst_AnimationNodeTimeSeek"
    Else
        Print "FAIL:inst_AnimationNodeTimeSeek returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AnimationNodeTimeSeek err=" & str(Err.Number)
    End If
End Sub


