Attribute VB_Name = "fuzz_enum_1520"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_WRITE_MODE_TEXT As Integer = WebSocketPeer.WRITE_MODE_TEXT
    If v_WRITE_MODE_TEXT = 0 Then pass_count = pass_count + 1
    Dim v_WRITE_MODE_BINARY As Integer = WebSocketPeer.WRITE_MODE_BINARY
    If v_WRITE_MODE_BINARY = 1 Then pass_count = pass_count + 1
    If pass_count = 2 Then
        Print "PASS:enum_WebSocketPeer_WriteMode"
    Else
        Print "FAIL:enum_WebSocketPeer_WriteMode count=" & str(pass_count) & "/2"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_WebSocketPeer_WriteMode err=" & str(Err.Number)
    End If
End Sub


