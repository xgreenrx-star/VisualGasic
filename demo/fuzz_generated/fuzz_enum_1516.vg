Attribute VB_Name = "fuzz_enum_1516"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_OP_TYPE_SCALAR As Integer = VisualShaderNodeStep.OP_TYPE_SCALAR
    If v_OP_TYPE_SCALAR = 0 Then pass_count = pass_count + 1
    Dim v_OP_TYPE_VECTOR_2D As Integer = VisualShaderNodeStep.OP_TYPE_VECTOR_2D
    If v_OP_TYPE_VECTOR_2D = 1 Then pass_count = pass_count + 1
    Dim v_OP_TYPE_VECTOR_2D_SCALAR As Integer = VisualShaderNodeStep.OP_TYPE_VECTOR_2D_SCALAR
    If v_OP_TYPE_VECTOR_2D_SCALAR = 2 Then pass_count = pass_count + 1
    Dim v_OP_TYPE_VECTOR_3D As Integer = VisualShaderNodeStep.OP_TYPE_VECTOR_3D
    If v_OP_TYPE_VECTOR_3D = 3 Then pass_count = pass_count + 1
    Dim v_OP_TYPE_VECTOR_3D_SCALAR As Integer = VisualShaderNodeStep.OP_TYPE_VECTOR_3D_SCALAR
    If v_OP_TYPE_VECTOR_3D_SCALAR = 4 Then pass_count = pass_count + 1
    Dim v_OP_TYPE_VECTOR_4D As Integer = VisualShaderNodeStep.OP_TYPE_VECTOR_4D
    If v_OP_TYPE_VECTOR_4D = 5 Then pass_count = pass_count + 1
    Dim v_OP_TYPE_VECTOR_4D_SCALAR As Integer = VisualShaderNodeStep.OP_TYPE_VECTOR_4D_SCALAR
    If v_OP_TYPE_VECTOR_4D_SCALAR = 6 Then pass_count = pass_count + 1
    Dim v_OP_TYPE_MAX As Integer = VisualShaderNodeStep.OP_TYPE_MAX
    If v_OP_TYPE_MAX = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_VisualShaderNodeStep_OpType"
    Else
        Print "FAIL:enum_VisualShaderNodeStep_OpType count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_VisualShaderNodeStep_OpType err=" & str(Err.Number)
    End If
End Sub


