Attribute VB_Name = "fuzz_meth_1619"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CSGMesh3D = CSGMesh3D.new()
    If obj = Null Then
        Print "SKIP:meth_CSGMesh3D (null)"
        Exit Sub
    End If
    Dim r_get_mesh As Variant = obj.get_mesh()
    Print "PASS:meth_CSGMesh3D_get_mesh"
    Dim r_get_material As Variant = obj.get_material()
    Print "PASS:meth_CSGMesh3D_get_material"
    Dim r_get_flip_faces As Variant = obj.get_flip_faces()
    Print "PASS:meth_CSGMesh3D_get_flip_faces"
    Dim r_is_root_shape As Variant = obj.is_root_shape()
    Print "PASS:meth_CSGMesh3D_is_root_shape"
    Dim r_get_operation As Variant = obj.get_operation()
    Print "PASS:meth_CSGMesh3D_get_operation"
    Dim r_get_snap As Variant = obj.get_snap()
    Print "PASS:meth_CSGMesh3D_get_snap"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_CSGMesh3D err=" & str(Err.Number)
    End If
End Sub


