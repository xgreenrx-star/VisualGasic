Attribute VB_Name = "fuzz_prop_984"


Sub RunTest0()
    On Error Resume Next
    Dim obj As HFlowContainer = HFlowContainer.new()
    If obj = Null Then
        Print "SKIP:prop_HFlowContainer_alignment (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.alignment
    Print "PASS:prop_HFlowContainer_alignment"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_HFlowContainer_alignment err=" & str(Err.Number)
    End If
End Sub


