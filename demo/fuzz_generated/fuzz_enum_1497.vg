Attribute VB_Name = "fuzz_enum_1497"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_PARAM_LINEAR_LIMIT_UPPER As Integer = SliderJoint3D.PARAM_LINEAR_LIMIT_UPPER
    If v_PARAM_LINEAR_LIMIT_UPPER = 0 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_LIMIT_LOWER As Integer = SliderJoint3D.PARAM_LINEAR_LIMIT_LOWER
    If v_PARAM_LINEAR_LIMIT_LOWER = 1 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_LIMIT_SOFTNESS As Integer = SliderJoint3D.PARAM_LINEAR_LIMIT_SOFTNESS
    If v_PARAM_LINEAR_LIMIT_SOFTNESS = 2 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_LIMIT_RESTITUTION As Integer = SliderJoint3D.PARAM_LINEAR_LIMIT_RESTITUTION
    If v_PARAM_LINEAR_LIMIT_RESTITUTION = 3 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_LIMIT_DAMPING As Integer = SliderJoint3D.PARAM_LINEAR_LIMIT_DAMPING
    If v_PARAM_LINEAR_LIMIT_DAMPING = 4 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_MOTION_SOFTNESS As Integer = SliderJoint3D.PARAM_LINEAR_MOTION_SOFTNESS
    If v_PARAM_LINEAR_MOTION_SOFTNESS = 5 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_MOTION_RESTITUTION As Integer = SliderJoint3D.PARAM_LINEAR_MOTION_RESTITUTION
    If v_PARAM_LINEAR_MOTION_RESTITUTION = 6 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_MOTION_DAMPING As Integer = SliderJoint3D.PARAM_LINEAR_MOTION_DAMPING
    If v_PARAM_LINEAR_MOTION_DAMPING = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_SliderJoint3D_Param"
    Else
        Print "FAIL:enum_SliderJoint3D_Param count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_SliderJoint3D_Param err=" & str(Err.Number)
    End If
End Sub


