Attribute VB_Name = "fuzz_inst_510"


Sub RunTest0()
    On Error Resume Next
    Dim obj As SkeletonProfileHumanoid = SkeletonProfileHumanoid.new()
    If obj <> Null Then
        Print "PASS:inst_SkeletonProfileHumanoid"
    Else
        Print "FAIL:inst_SkeletonProfileHumanoid returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_SkeletonProfileHumanoid err=" & str(Err.Number)
    End If
End Sub


