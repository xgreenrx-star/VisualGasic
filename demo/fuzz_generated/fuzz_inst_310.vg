Attribute VB_Name = "fuzz_inst_310"


Sub RunTest0()
    On Error Resume Next
    Dim obj As MeshInstance2D = MeshInstance2D.new()
    If obj <> Null Then
        Print "PASS:inst_MeshInstance2D"
        obj.free()
    Else
        Print "FAIL:inst_MeshInstance2D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_MeshInstance2D err=" & str(Err.Number)
    End If
End Sub


