Attribute VB_Name = "fuzz_enum_1482"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_CONVEX_DECOMPOSITION_MODE_VOXEL As Integer = MeshConvexDecompositionSettings.CONVEX_DECOMPOSITION_MODE_VOXEL
    If v_CONVEX_DECOMPOSITION_MODE_VOXEL = 0 Then pass_count = pass_count + 1
    Dim v_CONVEX_DECOMPOSITION_MODE_TETRAHEDRON As Integer = MeshConvexDecompositionSettings.CONVEX_DECOMPOSITION_MODE_TETRAHEDRON
    If v_CONVEX_DECOMPOSITION_MODE_TETRAHEDRON = 1 Then pass_count = pass_count + 1
    If pass_count = 2 Then
        Print "PASS:enum_MeshConvexDecompositionSettings_Mode"
    Else
        Print "FAIL:enum_MeshConvexDecompositionSettings_Mode count=" & str(pass_count) & "/2"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_MeshConvexDecompositionSettings_Mode err=" & str(Err.Number)
    End If
End Sub


