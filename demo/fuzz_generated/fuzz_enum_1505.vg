Attribute VB_Name = "fuzz_enum_1505"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_STRETCH_SCALE As Integer = TextureRect.STRETCH_SCALE
    If v_STRETCH_SCALE = 0 Then pass_count = pass_count + 1
    Dim v_STRETCH_TILE As Integer = TextureRect.STRETCH_TILE
    If v_STRETCH_TILE = 1 Then pass_count = pass_count + 1
    Dim v_STRETCH_KEEP As Integer = TextureRect.STRETCH_KEEP
    If v_STRETCH_KEEP = 2 Then pass_count = pass_count + 1
    Dim v_STRETCH_KEEP_CENTERED As Integer = TextureRect.STRETCH_KEEP_CENTERED
    If v_STRETCH_KEEP_CENTERED = 3 Then pass_count = pass_count + 1
    Dim v_STRETCH_KEEP_ASPECT As Integer = TextureRect.STRETCH_KEEP_ASPECT
    If v_STRETCH_KEEP_ASPECT = 4 Then pass_count = pass_count + 1
    Dim v_STRETCH_KEEP_ASPECT_CENTERED As Integer = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
    If v_STRETCH_KEEP_ASPECT_CENTERED = 5 Then pass_count = pass_count + 1
    Dim v_STRETCH_KEEP_ASPECT_COVERED As Integer = TextureRect.STRETCH_KEEP_ASPECT_COVERED
    If v_STRETCH_KEEP_ASPECT_COVERED = 6 Then pass_count = pass_count + 1
    If pass_count = 7 Then
        Print "PASS:enum_TextureRect_StretchMode"
    Else
        Print "FAIL:enum_TextureRect_StretchMode count=" & str(pass_count) & "/7"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_TextureRect_StretchMode err=" & str(Err.Number)
    End If
End Sub


