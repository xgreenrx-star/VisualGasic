Attribute VB_Name = "fuzz_enum_1485"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_SAMPLE_PARTITION_CONVEX_PARTITION As Integer = NavigationPolygon.SAMPLE_PARTITION_CONVEX_PARTITION
    If v_SAMPLE_PARTITION_CONVEX_PARTITION = 0 Then pass_count = pass_count + 1
    Dim v_SAMPLE_PARTITION_TRIANGULATE As Integer = NavigationPolygon.SAMPLE_PARTITION_TRIANGULATE
    If v_SAMPLE_PARTITION_TRIANGULATE = 1 Then pass_count = pass_count + 1
    Dim v_SAMPLE_PARTITION_MAX As Integer = NavigationPolygon.SAMPLE_PARTITION_MAX
    If v_SAMPLE_PARTITION_MAX = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_NavigationPolygon_SamplePartitionType"
    Else
        Print "FAIL:enum_NavigationPolygon_SamplePartitionType count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_NavigationPolygon_SamplePartitionType err=" & str(Err.Number)
    End If
End Sub


