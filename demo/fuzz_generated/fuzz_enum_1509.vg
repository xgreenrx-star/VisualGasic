Attribute VB_Name = "fuzz_enum_1509"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_RENDER_INFO_TYPE_VISIBLE As Integer = Viewport.RENDER_INFO_TYPE_VISIBLE
    If v_RENDER_INFO_TYPE_VISIBLE = 0 Then pass_count = pass_count + 1
    Dim v_RENDER_INFO_TYPE_SHADOW As Integer = Viewport.RENDER_INFO_TYPE_SHADOW
    If v_RENDER_INFO_TYPE_SHADOW = 1 Then pass_count = pass_count + 1
    Dim v_RENDER_INFO_TYPE_CANVAS As Integer = Viewport.RENDER_INFO_TYPE_CANVAS
    If v_RENDER_INFO_TYPE_CANVAS = 2 Then pass_count = pass_count + 1
    Dim v_RENDER_INFO_TYPE_MAX As Integer = Viewport.RENDER_INFO_TYPE_MAX
    If v_RENDER_INFO_TYPE_MAX = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_Viewport_RenderInfoType"
    Else
        Print "FAIL:enum_Viewport_RenderInfoType count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Viewport_RenderInfoType err=" & str(Err.Number)
    End If
End Sub


