Attribute VB_Name = "fuzz_inst_110"


Sub RunTest0()
    On Error Resume Next
    Dim obj As BoxMesh = BoxMesh.new()
    If obj <> Null Then
        Print "PASS:inst_BoxMesh"
    Else
        Print "FAIL:inst_BoxMesh returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_BoxMesh err=" & str(Err.Number)
    End If
End Sub


