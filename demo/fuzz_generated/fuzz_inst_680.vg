Attribute VB_Name = "fuzz_inst_680"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeTextureParameterTriplanar = VisualShaderNodeTextureParameterTriplanar.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeTextureParameterTriplanar"
    Else
        Print "FAIL:inst_VisualShaderNodeTextureParameterTriplanar returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeTextureParameterTriplanar err=" & str(Err.Number)
    End If
End Sub


