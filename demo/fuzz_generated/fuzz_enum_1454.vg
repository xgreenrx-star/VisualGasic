Attribute VB_Name = "fuzz_enum_1454"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_DOPPLER_TRACKING_DISABLED As Integer = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
    If v_DOPPLER_TRACKING_DISABLED = 0 Then pass_count = pass_count + 1
    Dim v_DOPPLER_TRACKING_IDLE_STEP As Integer = AudioStreamPlayer3D.DOPPLER_TRACKING_IDLE_STEP
    If v_DOPPLER_TRACKING_IDLE_STEP = 1 Then pass_count = pass_count + 1
    Dim v_DOPPLER_TRACKING_PHYSICS_STEP As Integer = AudioStreamPlayer3D.DOPPLER_TRACKING_PHYSICS_STEP
    If v_DOPPLER_TRACKING_PHYSICS_STEP = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_AudioStreamPlayer3D_DopplerTracking"
    Else
        Print "FAIL:enum_AudioStreamPlayer3D_DopplerTracking count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_AudioStreamPlayer3D_DopplerTracking err=" & str(Err.Number)
    End If
End Sub


