Attribute VB_Name = "fuzz_enum_1452"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FILTER_6DB As Integer = AudioEffectFilter.FILTER_6DB
    If v_FILTER_6DB = 0 Then pass_count = pass_count + 1
    Dim v_FILTER_12DB As Integer = AudioEffectFilter.FILTER_12DB
    If v_FILTER_12DB = 1 Then pass_count = pass_count + 1
    Dim v_FILTER_18DB As Integer = AudioEffectFilter.FILTER_18DB
    If v_FILTER_18DB = 2 Then pass_count = pass_count + 1
    Dim v_FILTER_24DB As Integer = AudioEffectFilter.FILTER_24DB
    If v_FILTER_24DB = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_AudioEffectFilter_FilterDB"
    Else
        Print "FAIL:enum_AudioEffectFilter_FilterDB count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_AudioEffectFilter_FilterDB err=" & str(Err.Number)
    End If
End Sub


