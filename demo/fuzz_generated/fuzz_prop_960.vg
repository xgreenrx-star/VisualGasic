Attribute VB_Name = "fuzz_prop_960"


Sub RunTest0()
    On Error Resume Next
    Dim obj As GraphElement = GraphElement.new()
    If obj = Null Then
        Print "SKIP:prop_GraphElement_resizable (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.resizable
    Print "PASS:prop_GraphElement_resizable"
    obj.resizable = True
    Dim val2 As Variant = obj.resizable
    Print "PASS:propset_GraphElement_resizable"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_GraphElement_resizable err=" & str(Err.Number)
    End If
End Sub


