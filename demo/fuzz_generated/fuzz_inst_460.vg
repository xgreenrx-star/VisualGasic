Attribute VB_Name = "fuzz_inst_460"


Sub RunTest0()
    On Error Resume Next
    Dim obj As RemoteTransform2D = RemoteTransform2D.new()
    If obj <> Null Then
        Print "PASS:inst_RemoteTransform2D"
        obj.free()
    Else
        Print "FAIL:inst_RemoteTransform2D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_RemoteTransform2D err=" & str(Err.Number)
    End If
End Sub


