Attribute VB_Name = "fuzz_inst_210"


Sub RunTest0()
    On Error Resume Next
    Dim obj As GLTFAnimation = GLTFAnimation.new()
    If obj <> Null Then
        Print "PASS:inst_GLTFAnimation"
    Else
        Print "FAIL:inst_GLTFAnimation returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_GLTFAnimation err=" & str(Err.Number)
    End If
End Sub


