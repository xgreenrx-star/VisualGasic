Attribute VB_Name = "fuzz_meth_1599"


Sub RunTest0()
    On Error Resume Next
    Dim obj As HSeparator = HSeparator.new()
    If obj = Null Then
        Print "SKIP:meth_HSeparator (null)"
        Exit Sub
    End If
    Dim r_get_combined_minimum_size As Variant = obj.get_combined_minimum_size()
    Print "PASS:meth_HSeparator_get_combined_minimum_size"
    Dim r_get_begin As Variant = obj.get_begin()
    Print "PASS:meth_HSeparator_get_begin"
    Dim r_get_end As Variant = obj.get_end()
    Print "PASS:meth_HSeparator_get_end"
    Dim r_get_position As Variant = obj.get_position()
    Print "PASS:meth_HSeparator_get_position"
    Dim r_get_size As Variant = obj.get_size()
    Print "PASS:meth_HSeparator_get_size"
    Dim r_get_rotation As Variant = obj.get_rotation()
    Print "PASS:meth_HSeparator_get_rotation"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_HSeparator err=" & str(Err.Number)
    End If
End Sub


