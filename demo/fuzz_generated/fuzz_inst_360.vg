Attribute VB_Name = "fuzz_inst_360"


Sub RunTest0()
    On Error Resume Next
    Dim obj As OpenXRCompositionLayerEquirect = OpenXRCompositionLayerEquirect.new()
    If obj <> Null Then
        Print "PASS:inst_OpenXRCompositionLayerEquirect"
        obj.free()
    Else
        Print "FAIL:inst_OpenXRCompositionLayerEquirect returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_OpenXRCompositionLayerEquirect err=" & str(Err.Number)
    End If
End Sub


