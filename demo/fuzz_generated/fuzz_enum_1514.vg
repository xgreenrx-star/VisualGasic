Attribute VB_Name = "fuzz_enum_1514"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_OP_ADD As Integer = VisualShaderNodeIntOp.OP_ADD
    If v_OP_ADD = 0 Then pass_count = pass_count + 1
    Dim v_OP_SUB As Integer = VisualShaderNodeIntOp.OP_SUB
    If v_OP_SUB = 1 Then pass_count = pass_count + 1
    Dim v_OP_MUL As Integer = VisualShaderNodeIntOp.OP_MUL
    If v_OP_MUL = 2 Then pass_count = pass_count + 1
    Dim v_OP_DIV As Integer = VisualShaderNodeIntOp.OP_DIV
    If v_OP_DIV = 3 Then pass_count = pass_count + 1
    Dim v_OP_MOD As Integer = VisualShaderNodeIntOp.OP_MOD
    If v_OP_MOD = 4 Then pass_count = pass_count + 1
    Dim v_OP_MAX As Integer = VisualShaderNodeIntOp.OP_MAX
    If v_OP_MAX = 5 Then pass_count = pass_count + 1
    Dim v_OP_MIN As Integer = VisualShaderNodeIntOp.OP_MIN
    If v_OP_MIN = 6 Then pass_count = pass_count + 1
    Dim v_OP_BITWISE_AND As Integer = VisualShaderNodeIntOp.OP_BITWISE_AND
    If v_OP_BITWISE_AND = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_VisualShaderNodeIntOp_Operator"
    Else
        Print "FAIL:enum_VisualShaderNodeIntOp_Operator count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_VisualShaderNodeIntOp_Operator err=" & str(Err.Number)
    End If
End Sub


