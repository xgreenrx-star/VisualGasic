Attribute VB_Name = "fuzz_prop_848"


Sub RunTest0()
    On Error Resume Next
    Dim obj As SpinBox = SpinBox.new()
    If obj = Null Then
        Print "SKIP:prop_SpinBox_suffix (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.suffix
    Print "PASS:prop_SpinBox_suffix"
    obj.suffix = "test_string"
    Dim val2 As Variant = obj.suffix
    Print "PASS:propset_SpinBox_suffix"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_SpinBox_suffix err=" & str(Err.Number)
    End If
End Sub


