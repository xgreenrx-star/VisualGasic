Attribute VB_Name = "fuzz_prop_936"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VSplitContainer = VSplitContainer.new()
    If obj = Null Then
        Print "SKIP:prop_VSplitContainer_dragging_enabled (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.dragging_enabled
    Print "PASS:prop_VSplitContainer_dragging_enabled"
    obj.dragging_enabled = True
    Dim val2 As Variant = obj.dragging_enabled
    Print "PASS:propset_VSplitContainer_dragging_enabled"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_VSplitContainer_dragging_enabled err=" & str(Err.Number)
    End If
End Sub


