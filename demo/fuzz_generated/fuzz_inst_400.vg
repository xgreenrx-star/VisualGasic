Attribute VB_Name = "fuzz_inst_400"


Sub RunTest0()
    On Error Resume Next
    Dim obj As PhysicalSkyMaterial = PhysicalSkyMaterial.new()
    If obj <> Null Then
        Print "PASS:inst_PhysicalSkyMaterial"
    Else
        Print "FAIL:inst_PhysicalSkyMaterial returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_PhysicalSkyMaterial err=" & str(Err.Number)
    End If
End Sub


