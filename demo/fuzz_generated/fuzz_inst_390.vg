Attribute VB_Name = "fuzz_inst_390"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ParallaxBackground = ParallaxBackground.new()
    If obj <> Null Then
        Print "PASS:inst_ParallaxBackground"
        obj.free()
    Else
        Print "FAIL:inst_ParallaxBackground returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_ParallaxBackground err=" & str(Err.Number)
    End If
End Sub


