Attribute VB_Name = "fuzz_enum_1504"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_STRUCTURED_TEXT_DEFAULT As Integer = TextServer.STRUCTURED_TEXT_DEFAULT
    If v_STRUCTURED_TEXT_DEFAULT = 0 Then pass_count = pass_count + 1
    Dim v_STRUCTURED_TEXT_URI As Integer = TextServer.STRUCTURED_TEXT_URI
    If v_STRUCTURED_TEXT_URI = 1 Then pass_count = pass_count + 1
    Dim v_STRUCTURED_TEXT_FILE As Integer = TextServer.STRUCTURED_TEXT_FILE
    If v_STRUCTURED_TEXT_FILE = 2 Then pass_count = pass_count + 1
    Dim v_STRUCTURED_TEXT_EMAIL As Integer = TextServer.STRUCTURED_TEXT_EMAIL
    If v_STRUCTURED_TEXT_EMAIL = 3 Then pass_count = pass_count + 1
    Dim v_STRUCTURED_TEXT_LIST As Integer = TextServer.STRUCTURED_TEXT_LIST
    If v_STRUCTURED_TEXT_LIST = 4 Then pass_count = pass_count + 1
    Dim v_STRUCTURED_TEXT_GDSCRIPT As Integer = TextServer.STRUCTURED_TEXT_GDSCRIPT
    If v_STRUCTURED_TEXT_GDSCRIPT = 5 Then pass_count = pass_count + 1
    Dim v_STRUCTURED_TEXT_CUSTOM As Integer = TextServer.STRUCTURED_TEXT_CUSTOM
    If v_STRUCTURED_TEXT_CUSTOM = 6 Then pass_count = pass_count + 1
    If pass_count = 7 Then
        Print "PASS:enum_TextServer_StructuredTextParser"
    Else
        Print "FAIL:enum_TextServer_StructuredTextParser count=" & str(pass_count) & "/7"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_TextServer_StructuredTextParser err=" & str(Err.Number)
    End If
End Sub


