Attribute VB_Name = "fuzz_inst_220"


Sub RunTest0()
    On Error Resume Next
    Dim obj As GLTFPhysicsBody = GLTFPhysicsBody.new()
    If obj <> Null Then
        Print "PASS:inst_GLTFPhysicsBody"
    Else
        Print "FAIL:inst_GLTFPhysicsBody returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_GLTFPhysicsBody err=" & str(Err.Number)
    End If
End Sub


