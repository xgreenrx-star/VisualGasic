Attribute VB_Name = "fuzz_enum_1513"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FUNC_SUM As Integer = VisualShaderNodeDerivativeFunc.FUNC_SUM
    If v_FUNC_SUM = 0 Then pass_count = pass_count + 1
    Dim v_FUNC_X As Integer = VisualShaderNodeDerivativeFunc.FUNC_X
    If v_FUNC_X = 1 Then pass_count = pass_count + 1
    Dim v_FUNC_Y As Integer = VisualShaderNodeDerivativeFunc.FUNC_Y
    If v_FUNC_Y = 2 Then pass_count = pass_count + 1
    Dim v_FUNC_MAX As Integer = VisualShaderNodeDerivativeFunc.FUNC_MAX
    If v_FUNC_MAX = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_VisualShaderNodeDerivativeFunc_Function"
    Else
        Print "FAIL:enum_VisualShaderNodeDerivativeFunc_Function count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_VisualShaderNodeDerivativeFunc_Function err=" & str(Err.Number)
    End If
End Sub


