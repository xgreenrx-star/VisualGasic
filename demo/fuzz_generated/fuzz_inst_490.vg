Attribute VB_Name = "fuzz_inst_490"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ShaderInclude = ShaderInclude.new()
    If obj <> Null Then
        Print "PASS:inst_ShaderInclude"
    Else
        Print "FAIL:inst_ShaderInclude returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_ShaderInclude err=" & str(Err.Number)
    End If
End Sub


