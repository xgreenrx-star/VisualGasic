Attribute VB_Name = "fuzz_inst_420"


Sub RunTest0()
    On Error Resume Next
    Dim obj As PlaceholderTexture2DArray = PlaceholderTexture2DArray.new()
    If obj <> Null Then
        Print "PASS:inst_PlaceholderTexture2DArray"
    Else
        Print "FAIL:inst_PlaceholderTexture2DArray returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_PlaceholderTexture2DArray err=" & str(Err.Number)
    End If
End Sub


