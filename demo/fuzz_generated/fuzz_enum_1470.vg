Attribute VB_Name = "fuzz_enum_1470"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_COMPRESSION_FASTLZ As Integer = FileAccess.COMPRESSION_FASTLZ
    If v_COMPRESSION_FASTLZ = 0 Then pass_count = pass_count + 1
    Dim v_COMPRESSION_DEFLATE As Integer = FileAccess.COMPRESSION_DEFLATE
    If v_COMPRESSION_DEFLATE = 1 Then pass_count = pass_count + 1
    Dim v_COMPRESSION_ZSTD As Integer = FileAccess.COMPRESSION_ZSTD
    If v_COMPRESSION_ZSTD = 2 Then pass_count = pass_count + 1
    Dim v_COMPRESSION_GZIP As Integer = FileAccess.COMPRESSION_GZIP
    If v_COMPRESSION_GZIP = 3 Then pass_count = pass_count + 1
    Dim v_COMPRESSION_BROTLI As Integer = FileAccess.COMPRESSION_BROTLI
    If v_COMPRESSION_BROTLI = 4 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_FileAccess_CompressionMode"
    Else
        Print "FAIL:enum_FileAccess_CompressionMode count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_FileAccess_CompressionMode err=" & str(Err.Number)
    End If
End Sub


