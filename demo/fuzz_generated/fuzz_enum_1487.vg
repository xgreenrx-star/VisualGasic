Attribute VB_Name = "fuzz_enum_1487"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_RESULT_RUNNING As Integer = OpenXRFutureResult.RESULT_RUNNING
    If v_RESULT_RUNNING = 0 Then pass_count = pass_count + 1
    Dim v_RESULT_FINISHED As Integer = OpenXRFutureResult.RESULT_FINISHED
    If v_RESULT_FINISHED = 1 Then pass_count = pass_count + 1
    Dim v_RESULT_CANCELLED As Integer = OpenXRFutureResult.RESULT_CANCELLED
    If v_RESULT_CANCELLED = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_OpenXRFutureResult_ResultStatus"
    Else
        Print "FAIL:enum_OpenXRFutureResult_ResultStatus count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_OpenXRFutureResult_ResultStatus err=" & str(Err.Number)
    End If
End Sub


