Attribute VB_Name = "fuzz_enum_1468"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_REFLECTION_SOURCE_BG As Integer = Environment.REFLECTION_SOURCE_BG
    If v_REFLECTION_SOURCE_BG = 0 Then pass_count = pass_count + 1
    Dim v_REFLECTION_SOURCE_DISABLED As Integer = Environment.REFLECTION_SOURCE_DISABLED
    If v_REFLECTION_SOURCE_DISABLED = 1 Then pass_count = pass_count + 1
    Dim v_REFLECTION_SOURCE_SKY As Integer = Environment.REFLECTION_SOURCE_SKY
    If v_REFLECTION_SOURCE_SKY = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_Environment_ReflectionSource"
    Else
        Print "FAIL:enum_Environment_ReflectionSource count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Environment_ReflectionSource err=" & str(Err.Number)
    End If
End Sub


