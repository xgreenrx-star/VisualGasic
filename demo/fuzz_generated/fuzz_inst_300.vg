Attribute VB_Name = "fuzz_inst_300"


Sub RunTest0()
    On Error Resume Next
    Dim obj As LookAtModifier3D = LookAtModifier3D.new()
    If obj <> Null Then
        Print "PASS:inst_LookAtModifier3D"
        obj.free()
    Else
        Print "FAIL:inst_LookAtModifier3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_LookAtModifier3D err=" & str(Err.Number)
    End If
End Sub


