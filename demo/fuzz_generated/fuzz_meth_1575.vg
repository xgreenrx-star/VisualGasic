Attribute VB_Name = "fuzz_meth_1575"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ScrollContainer = ScrollContainer.new()
    If obj = Null Then
        Print "SKIP:meth_ScrollContainer (null)"
        Exit Sub
    End If
    Dim r_get_h_scroll As Variant = obj.get_h_scroll()
    Print "PASS:meth_ScrollContainer_get_h_scroll"
    Dim r_get_v_scroll As Variant = obj.get_v_scroll()
    Print "PASS:meth_ScrollContainer_get_v_scroll"
    Dim r_get_horizontal_custom_step As Variant = obj.get_horizontal_custom_step()
    Print "PASS:meth_ScrollContainer_get_horizontal_custom_step"
    Dim r_get_vertical_custom_step As Variant = obj.get_vertical_custom_step()
    Print "PASS:meth_ScrollContainer_get_vertical_custom_step"
    Dim r_get_horizontal_scroll_mode As Variant = obj.get_horizontal_scroll_mode()
    Print "PASS:meth_ScrollContainer_get_horizontal_scroll_mode"
    Dim r_get_vertical_scroll_mode As Variant = obj.get_vertical_scroll_mode()
    Print "PASS:meth_ScrollContainer_get_vertical_scroll_mode"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_ScrollContainer err=" & str(Err.Number)
    End If
End Sub


