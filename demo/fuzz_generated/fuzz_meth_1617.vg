Attribute VB_Name = "fuzz_meth_1617"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CSGSphere3D = CSGSphere3D.new()
    If obj = Null Then
        Print "SKIP:meth_CSGSphere3D (null)"
        Exit Sub
    End If
    Dim r_get_radius As Variant = obj.get_radius()
    Print "PASS:meth_CSGSphere3D_get_radius"
    Dim r_get_radial_segments As Variant = obj.get_radial_segments()
    Print "PASS:meth_CSGSphere3D_get_radial_segments"
    Dim r_get_rings As Variant = obj.get_rings()
    Print "PASS:meth_CSGSphere3D_get_rings"
    Dim r_get_smooth_faces As Variant = obj.get_smooth_faces()
    Print "PASS:meth_CSGSphere3D_get_smooth_faces"
    Dim r_get_material As Variant = obj.get_material()
    Print "PASS:meth_CSGSphere3D_get_material"
    Dim r_get_flip_faces As Variant = obj.get_flip_faces()
    Print "PASS:meth_CSGSphere3D_get_flip_faces"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_CSGSphere3D err=" & str(Err.Number)
    End If
End Sub


