Attribute VB_Name = "fuzz_inst_600"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VehicleWheel3D = VehicleWheel3D.new()
    If obj <> Null Then
        Print "PASS:inst_VehicleWheel3D"
        obj.free()
    Else
        Print "FAIL:inst_VehicleWheel3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VehicleWheel3D err=" & str(Err.Number)
    End If
End Sub


