Attribute VB_Name = "fuzz_enum_1467"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_EXPORT_ALL_RESOURCES As Integer = EditorExportPreset.EXPORT_ALL_RESOURCES
    If v_EXPORT_ALL_RESOURCES = 0 Then pass_count = pass_count + 1
    Dim v_EXPORT_SELECTED_SCENES As Integer = EditorExportPreset.EXPORT_SELECTED_SCENES
    If v_EXPORT_SELECTED_SCENES = 1 Then pass_count = pass_count + 1
    Dim v_EXPORT_SELECTED_RESOURCES As Integer = EditorExportPreset.EXPORT_SELECTED_RESOURCES
    If v_EXPORT_SELECTED_RESOURCES = 2 Then pass_count = pass_count + 1
    Dim v_EXCLUDE_SELECTED_RESOURCES As Integer = EditorExportPreset.EXCLUDE_SELECTED_RESOURCES
    If v_EXCLUDE_SELECTED_RESOURCES = 3 Then pass_count = pass_count + 1
    Dim v_EXPORT_CUSTOMIZED As Integer = EditorExportPreset.EXPORT_CUSTOMIZED
    If v_EXPORT_CUSTOMIZED = 4 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_EditorExportPreset_ExportFilter"
    Else
        Print "FAIL:enum_EditorExportPreset_ExportFilter count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_EditorExportPreset_ExportFilter err=" & str(Err.Number)
    End If
End Sub


