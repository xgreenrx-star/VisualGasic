Attribute VB_Name = "fuzz_enum_1463"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_KIND_CLASS As Integer = CodeEdit.KIND_CLASS
    If v_KIND_CLASS = 0 Then pass_count = pass_count + 1
    Dim v_KIND_FUNCTION As Integer = CodeEdit.KIND_FUNCTION
    If v_KIND_FUNCTION = 1 Then pass_count = pass_count + 1
    Dim v_KIND_SIGNAL As Integer = CodeEdit.KIND_SIGNAL
    If v_KIND_SIGNAL = 2 Then pass_count = pass_count + 1
    Dim v_KIND_VARIABLE As Integer = CodeEdit.KIND_VARIABLE
    If v_KIND_VARIABLE = 3 Then pass_count = pass_count + 1
    Dim v_KIND_MEMBER As Integer = CodeEdit.KIND_MEMBER
    If v_KIND_MEMBER = 4 Then pass_count = pass_count + 1
    Dim v_KIND_ENUM As Integer = CodeEdit.KIND_ENUM
    If v_KIND_ENUM = 5 Then pass_count = pass_count + 1
    Dim v_KIND_CONSTANT As Integer = CodeEdit.KIND_CONSTANT
    If v_KIND_CONSTANT = 6 Then pass_count = pass_count + 1
    Dim v_KIND_NODE_PATH As Integer = CodeEdit.KIND_NODE_PATH
    If v_KIND_NODE_PATH = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_CodeEdit_CodeCompletionKind"
    Else
        Print "FAIL:enum_CodeEdit_CodeCompletionKind count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_CodeEdit_CodeCompletionKind err=" & str(Err.Number)
    End If
End Sub


