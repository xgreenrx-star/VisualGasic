Attribute VB_Name = "fuzz_with_1700"


Sub RunTest0()
    On Error Resume Next
    Dim obj As SphereMesh = SphereMesh.new()
    If obj = Null Then
        Print "SKIP:with_SphereMesh (null)"
        Exit Sub
    End If
    With obj
        Dim v_radius As Variant = .radius
        Dim v_height As Variant = .height
        Dim v_radial_segments As Variant = .radial_segments
    End With
    Print "PASS:with_SphereMesh"
    If Err.Number <> 0 Then
        Print "ERROR:with_SphereMesh err=" & str(Err.Number)
    End If
End Sub


