Attribute VB_Name = "fuzz_enum_1506"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_TILE_OFFSET_AXIS_HORIZONTAL As Integer = TileSet.TILE_OFFSET_AXIS_HORIZONTAL
    If v_TILE_OFFSET_AXIS_HORIZONTAL = 0 Then pass_count = pass_count + 1
    Dim v_TILE_OFFSET_AXIS_VERTICAL As Integer = TileSet.TILE_OFFSET_AXIS_VERTICAL
    If v_TILE_OFFSET_AXIS_VERTICAL = 1 Then pass_count = pass_count + 1
    If pass_count = 2 Then
        Print "PASS:enum_TileSet_TileOffsetAxis"
    Else
        Print "FAIL:enum_TileSet_TileOffsetAxis count=" & str(pass_count) & "/2"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_TileSet_TileOffsetAxis err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_CELL_NEIGHBOR_RIGHT_SIDE As Integer = TileSet.CELL_NEIGHBOR_RIGHT_SIDE
    If v_CELL_NEIGHBOR_RIGHT_SIDE = 0 Then pass_count = pass_count + 1
    Dim v_CELL_NEIGHBOR_RIGHT_CORNER As Integer = TileSet.CELL_NEIGHBOR_RIGHT_CORNER
    If v_CELL_NEIGHBOR_RIGHT_CORNER = 1 Then pass_count = pass_count + 1
    Dim v_CELL_NEIGHBOR_BOTTOM_RIGHT_SIDE As Integer = TileSet.CELL_NEIGHBOR_BOTTOM_RIGHT_SIDE
    If v_CELL_NEIGHBOR_BOTTOM_RIGHT_SIDE = 2 Then pass_count = pass_count + 1
    Dim v_CELL_NEIGHBOR_BOTTOM_RIGHT_CORNER As Integer = TileSet.CELL_NEIGHBOR_BOTTOM_RIGHT_CORNER
    If v_CELL_NEIGHBOR_BOTTOM_RIGHT_CORNER = 3 Then pass_count = pass_count + 1
    Dim v_CELL_NEIGHBOR_BOTTOM_SIDE As Integer = TileSet.CELL_NEIGHBOR_BOTTOM_SIDE
    If v_CELL_NEIGHBOR_BOTTOM_SIDE = 4 Then pass_count = pass_count + 1
    Dim v_CELL_NEIGHBOR_BOTTOM_CORNER As Integer = TileSet.CELL_NEIGHBOR_BOTTOM_CORNER
    If v_CELL_NEIGHBOR_BOTTOM_CORNER = 5 Then pass_count = pass_count + 1
    Dim v_CELL_NEIGHBOR_BOTTOM_LEFT_SIDE As Integer = TileSet.CELL_NEIGHBOR_BOTTOM_LEFT_SIDE
    If v_CELL_NEIGHBOR_BOTTOM_LEFT_SIDE = 6 Then pass_count = pass_count + 1
    Dim v_CELL_NEIGHBOR_BOTTOM_LEFT_CORNER As Integer = TileSet.CELL_NEIGHBOR_BOTTOM_LEFT_CORNER
    If v_CELL_NEIGHBOR_BOTTOM_LEFT_CORNER = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_TileSet_CellNeighbor"
    Else
        Print "FAIL:enum_TileSet_CellNeighbor count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_TileSet_CellNeighbor err=" & str(Err.Number)
    End If
End Sub


