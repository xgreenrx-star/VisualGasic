Attribute VB_Name = "fuzz_enum_1500"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_MENU_CUT As Integer = TextEdit.MENU_CUT
    If v_MENU_CUT = 0 Then pass_count = pass_count + 1
    Dim v_MENU_COPY As Integer = TextEdit.MENU_COPY
    If v_MENU_COPY = 1 Then pass_count = pass_count + 1
    Dim v_MENU_PASTE As Integer = TextEdit.MENU_PASTE
    If v_MENU_PASTE = 2 Then pass_count = pass_count + 1
    Dim v_MENU_CLEAR As Integer = TextEdit.MENU_CLEAR
    If v_MENU_CLEAR = 3 Then pass_count = pass_count + 1
    Dim v_MENU_SELECT_ALL As Integer = TextEdit.MENU_SELECT_ALL
    If v_MENU_SELECT_ALL = 4 Then pass_count = pass_count + 1
    Dim v_MENU_UNDO As Integer = TextEdit.MENU_UNDO
    If v_MENU_UNDO = 5 Then pass_count = pass_count + 1
    Dim v_MENU_REDO As Integer = TextEdit.MENU_REDO
    If v_MENU_REDO = 6 Then pass_count = pass_count + 1
    Dim v_MENU_SUBMENU_TEXT_DIR As Integer = TextEdit.MENU_SUBMENU_TEXT_DIR
    If v_MENU_SUBMENU_TEXT_DIR = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_TextEdit_MenuItems"
    Else
        Print "FAIL:enum_TextEdit_MenuItems count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_TextEdit_MenuItems err=" & str(Err.Number)
    End If
End Sub


