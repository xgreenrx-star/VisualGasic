Attribute VB_Name = "fuzz_enum_1469"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FRACTAL_NONE As Integer = FastNoiseLite.FRACTAL_NONE
    If v_FRACTAL_NONE = 0 Then pass_count = pass_count + 1
    Dim v_FRACTAL_FBM As Integer = FastNoiseLite.FRACTAL_FBM
    If v_FRACTAL_FBM = 1 Then pass_count = pass_count + 1
    Dim v_FRACTAL_RIDGED As Integer = FastNoiseLite.FRACTAL_RIDGED
    If v_FRACTAL_RIDGED = 2 Then pass_count = pass_count + 1
    Dim v_FRACTAL_PING_PONG As Integer = FastNoiseLite.FRACTAL_PING_PONG
    If v_FRACTAL_PING_PONG = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_FastNoiseLite_FractalType"
    Else
        Print "FAIL:enum_FastNoiseLite_FractalType count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_FastNoiseLite_FractalType err=" & str(Err.Number)
    End If
End Sub


