Attribute VB_Name = "fuzz_meth_1551"


Sub RunTest0()
    On Error Resume Next
    Dim obj As MenuButton = MenuButton.new()
    If obj = Null Then
        Print "SKIP:meth_MenuButton (null)"
        Exit Sub
    End If
    Dim r_get_popup As Variant = obj.get_popup()
    Print "PASS:meth_MenuButton_get_popup"
    Dim r_is_switch_on_hover As Variant = obj.is_switch_on_hover()
    Print "PASS:meth_MenuButton_is_switch_on_hover"
    Dim r_get_item_count As Variant = obj.get_item_count()
    Print "PASS:meth_MenuButton_get_item_count"
    Dim r_get_text As Variant = obj.get_text()
    Print "PASS:meth_MenuButton_get_text"
    Dim r_get_text_overrun_behavior As Variant = obj.get_text_overrun_behavior()
    Print "PASS:meth_MenuButton_get_text_overrun_behavior"
    Dim r_get_autowrap_mode As Variant = obj.get_autowrap_mode()
    Print "PASS:meth_MenuButton_get_autowrap_mode"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_MenuButton err=" & str(Err.Number)
    End If
End Sub


