Attribute VB_Name = "fuzz_enum_1494"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_CCD_MODE_DISABLED As Integer = RigidBody2D.CCD_MODE_DISABLED
    If v_CCD_MODE_DISABLED = 0 Then pass_count = pass_count + 1
    Dim v_CCD_MODE_CAST_RAY As Integer = RigidBody2D.CCD_MODE_CAST_RAY
    If v_CCD_MODE_CAST_RAY = 1 Then pass_count = pass_count + 1
    Dim v_CCD_MODE_CAST_SHAPE As Integer = RigidBody2D.CCD_MODE_CAST_SHAPE
    If v_CCD_MODE_CAST_SHAPE = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_RigidBody2D_CCDMode"
    Else
        Print "FAIL:enum_RigidBody2D_CCDMode count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_RigidBody2D_CCDMode err=" & str(Err.Number)
    End If
End Sub


