Attribute VB_Name = "fuzz_inst_520"


Sub RunTest0()
    On Error Resume Next
    Dim obj As SpotLight3D = SpotLight3D.new()
    If obj <> Null Then
        Print "PASS:inst_SpotLight3D"
        obj.free()
    Else
        Print "FAIL:inst_SpotLight3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_SpotLight3D err=" & str(Err.Number)
    End If
End Sub


