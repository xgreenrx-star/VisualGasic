    Dim v_JUSTIFICATION_TRIM_EDGE_SPACES As Integer = TextServer.JUSTIFICATION_TRIM_EDGE_SPACES
    If v_JUSTIFICATION_TRIM_EDGE_SPACES = 4 Then pass_count = pass_count + 1
    Dim v_JUSTIFICATION_AFTER_LAST_TAB As Integer = TextServer.JUSTIFICATION_AFTER_LAST_TAB
    If v_JUSTIFICATION_AFTER_LAST_TAB = 8 Then pass_count = pass_count + 1
    Dim v_JUSTIFICATION_CONSTRAIN_ELLIPSIS As Integer = TextServer.JUSTIFICATION_CONSTRAIN_ELLIPSIS
    If v_JUSTIFICATION_CONSTRAIN_ELLIPSIS = 16 Then pass_count = pass_count + 1
