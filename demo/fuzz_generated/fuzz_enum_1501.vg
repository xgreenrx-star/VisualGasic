    If v_JUSTIFICATION_SKIP_LAST_LINE = 32 Then pass_count = pass_count + 1
    Dim v_JUSTIFICATION_SKIP_LAST_LINE_WITH_VISIBLE_CHARS As Integer = TextServer.JUSTIFICATION_SKIP_LAST_LINE_WITH_VISIBLE_CHARS
    If v_JUSTIFICATION_SKIP_LAST_LINE_WITH_VISIBLE_CHARS = 64 Then pass_count = pass_count + 1
    If pass_count = 8 Then
