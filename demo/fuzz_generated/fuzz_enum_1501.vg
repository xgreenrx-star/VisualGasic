Attribute VB_Name = "fuzz_enum_1501"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_GUTTER_TYPE_STRING As Integer = TextEdit.GUTTER_TYPE_STRING
    If v_GUTTER_TYPE_STRING = 0 Then pass_count = pass_count + 1
    Dim v_GUTTER_TYPE_ICON As Integer = TextEdit.GUTTER_TYPE_ICON
    If v_GUTTER_TYPE_ICON = 1 Then pass_count = pass_count + 1
    Dim v_GUTTER_TYPE_CUSTOM As Integer = TextEdit.GUTTER_TYPE_CUSTOM
    If v_GUTTER_TYPE_CUSTOM = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_TextEdit_GutterType"
    Else
        Print "FAIL:enum_TextEdit_GutterType count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_TextEdit_GutterType err=" & str(Err.Number)
    End If
End Sub


