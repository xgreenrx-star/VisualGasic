Sub RunTest7()
    On Error Resume Next
    Dim obj As CPUParticles3D = CPUParticles3D.new()
    If obj = Null Then
        Print "SKIP:prop_CPUParticles3D_emitting (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.emitting
    Print "PASS:prop_CPUParticles3D_emitting"
    obj.emitting = True
    Dim val2 As Variant = obj.emitting
    Print "PASS:propset_CPUParticles3D_emitting"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_CPUParticles3D_emitting err=" & str(Err.Number)
    End If
End Sub

Sub RunTest()
