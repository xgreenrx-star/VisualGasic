Attribute VB_Name = "fuzz_prop_752"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ORMMaterial3D = ORMMaterial3D.new()
    If obj = Null Then
        Print "SKIP:prop_ORMMaterial3D_alpha_antialiasing_mode (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.alpha_antialiasing_mode
    Print "PASS:prop_ORMMaterial3D_alpha_antialiasing_mode"
    If Err.Number <> 0 Then
        Print "ERROR:prop_ORMMaterial3D_alpha_antialiasing_mode err=" & str(Err.Number)
    End If
End Sub


