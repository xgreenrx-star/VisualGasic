Attribute VB_Name = "fuzz_enum_1453"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_TRANSITION_FROM_TIME_IMMEDIATE As Integer = AudioStreamInteractive.TRANSITION_FROM_TIME_IMMEDIATE
    If v_TRANSITION_FROM_TIME_IMMEDIATE = 0 Then pass_count = pass_count + 1
    Dim v_TRANSITION_FROM_TIME_NEXT_BEAT As Integer = AudioStreamInteractive.TRANSITION_FROM_TIME_NEXT_BEAT
    If v_TRANSITION_FROM_TIME_NEXT_BEAT = 1 Then pass_count = pass_count + 1
    Dim v_TRANSITION_FROM_TIME_NEXT_BAR As Integer = AudioStreamInteractive.TRANSITION_FROM_TIME_NEXT_BAR
    If v_TRANSITION_FROM_TIME_NEXT_BAR = 2 Then pass_count = pass_count + 1
    Dim v_TRANSITION_FROM_TIME_END As Integer = AudioStreamInteractive.TRANSITION_FROM_TIME_END
    If v_TRANSITION_FROM_TIME_END = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_AudioStreamInteractive_TransitionFromTime"
    Else
        Print "FAIL:enum_AudioStreamInteractive_TransitionFromTime count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_AudioStreamInteractive_TransitionFromTime err=" & str(Err.Number)
    End If
End Sub


