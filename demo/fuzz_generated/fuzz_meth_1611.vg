Attribute VB_Name = "fuzz_meth_1611"


Sub RunTest0()
    On Error Resume Next
    Dim obj As Sprite3D = Sprite3D.new()
    If obj = Null Then
        Print "SKIP:meth_Sprite3D (null)"
        Exit Sub
    End If
    Dim r_get_texture As Variant = obj.get_texture()
    Print "PASS:meth_Sprite3D_get_texture"
    Dim r_is_region_enabled As Variant = obj.is_region_enabled()
    Print "PASS:meth_Sprite3D_is_region_enabled"
    Dim r_get_region_rect As Variant = obj.get_region_rect()
    Print "PASS:meth_Sprite3D_get_region_rect"
    Dim r_get_frame As Variant = obj.get_frame()
    Print "PASS:meth_Sprite3D_get_frame"
    Dim r_get_frame_coords As Variant = obj.get_frame_coords()
    Print "PASS:meth_Sprite3D_get_frame_coords"
    Dim r_get_vframes As Variant = obj.get_vframes()
    Print "PASS:meth_Sprite3D_get_vframes"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_Sprite3D err=" & str(Err.Number)
    End If
End Sub


