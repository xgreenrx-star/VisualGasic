Attribute VB_Name = "fuzz_enum_1493"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_MENU_COPY As Integer = RichTextLabel.MENU_COPY
    If v_MENU_COPY = 0 Then pass_count = pass_count + 1
    Dim v_MENU_SELECT_ALL As Integer = RichTextLabel.MENU_SELECT_ALL
    If v_MENU_SELECT_ALL = 1 Then pass_count = pass_count + 1
    Dim v_MENU_MAX As Integer = RichTextLabel.MENU_MAX
    If v_MENU_MAX = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_RichTextLabel_MenuItems"
    Else
        Print "FAIL:enum_RichTextLabel_MenuItems count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_RichTextLabel_MenuItems err=" & str(Err.Number)
    End If
End Sub


