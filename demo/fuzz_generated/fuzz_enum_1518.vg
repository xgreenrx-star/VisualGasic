Attribute VB_Name = "fuzz_enum_1518"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FUNC_NEGATE As Integer = VisualShaderNodeUIntFunc.FUNC_NEGATE
    If v_FUNC_NEGATE = 0 Then pass_count = pass_count + 1
    Dim v_FUNC_BITWISE_NOT As Integer = VisualShaderNodeUIntFunc.FUNC_BITWISE_NOT
    If v_FUNC_BITWISE_NOT = 1 Then pass_count = pass_count + 1
    Dim v_FUNC_MAX As Integer = VisualShaderNodeUIntFunc.FUNC_MAX
    If v_FUNC_MAX = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_VisualShaderNodeUIntFunc_Function"
    Else
        Print "FAIL:enum_VisualShaderNodeUIntFunc_Function count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_VisualShaderNodeUIntFunc_Function err=" & str(Err.Number)
    End If
End Sub


