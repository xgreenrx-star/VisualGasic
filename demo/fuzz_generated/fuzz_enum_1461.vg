Attribute VB_Name = "fuzz_enum_1461"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_CAMERA2D_PROCESS_PHYSICS As Integer = Camera2D.CAMERA2D_PROCESS_PHYSICS
    If v_CAMERA2D_PROCESS_PHYSICS = 0 Then pass_count = pass_count + 1
    Dim v_CAMERA2D_PROCESS_IDLE As Integer = Camera2D.CAMERA2D_PROCESS_IDLE
    If v_CAMERA2D_PROCESS_IDLE = 1 Then pass_count = pass_count + 1
    If pass_count = 2 Then
        Print "PASS:enum_Camera2D_Camera2DProcessCallback"
    Else
        Print "FAIL:enum_Camera2D_Camera2DProcessCallback count=" & str(pass_count) & "/2"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Camera2D_Camera2DProcessCallback err=" & str(Err.Number)
    End If
End Sub


