Attribute VB_Name = "fuzz_enum_1478"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FLAG_SHADED As Integer = Label3D.FLAG_SHADED
    If v_FLAG_SHADED = 0 Then pass_count = pass_count + 1
    Dim v_FLAG_DOUBLE_SIDED As Integer = Label3D.FLAG_DOUBLE_SIDED
    If v_FLAG_DOUBLE_SIDED = 1 Then pass_count = pass_count + 1
    Dim v_FLAG_DISABLE_DEPTH_TEST As Integer = Label3D.FLAG_DISABLE_DEPTH_TEST
    If v_FLAG_DISABLE_DEPTH_TEST = 2 Then pass_count = pass_count + 1
    Dim v_FLAG_FIXED_SIZE As Integer = Label3D.FLAG_FIXED_SIZE
    If v_FLAG_FIXED_SIZE = 3 Then pass_count = pass_count + 1
    Dim v_FLAG_MAX As Integer = Label3D.FLAG_MAX
    If v_FLAG_MAX = 4 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_Label3D_DrawFlags"
    Else
        Print "FAIL:enum_Label3D_DrawFlags count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Label3D_DrawFlags err=" & str(Err.Number)
    End If
End Sub


