Attribute VB_Name = "fuzz_enum_1459"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_PARAM_INITIAL_LINEAR_VELOCITY As Integer = CPUParticles2D.PARAM_INITIAL_LINEAR_VELOCITY
    If v_PARAM_INITIAL_LINEAR_VELOCITY = 0 Then pass_count = pass_count + 1
    Dim v_PARAM_ANGULAR_VELOCITY As Integer = CPUParticles2D.PARAM_ANGULAR_VELOCITY
    If v_PARAM_ANGULAR_VELOCITY = 1 Then pass_count = pass_count + 1
    Dim v_PARAM_ORBIT_VELOCITY As Integer = CPUParticles2D.PARAM_ORBIT_VELOCITY
    If v_PARAM_ORBIT_VELOCITY = 2 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_ACCEL As Integer = CPUParticles2D.PARAM_LINEAR_ACCEL
    If v_PARAM_LINEAR_ACCEL = 3 Then pass_count = pass_count + 1
    Dim v_PARAM_RADIAL_ACCEL As Integer = CPUParticles2D.PARAM_RADIAL_ACCEL
    If v_PARAM_RADIAL_ACCEL = 4 Then pass_count = pass_count + 1
    Dim v_PARAM_TANGENTIAL_ACCEL As Integer = CPUParticles2D.PARAM_TANGENTIAL_ACCEL
    If v_PARAM_TANGENTIAL_ACCEL = 5 Then pass_count = pass_count + 1
    Dim v_PARAM_DAMPING As Integer = CPUParticles2D.PARAM_DAMPING
    If v_PARAM_DAMPING = 6 Then pass_count = pass_count + 1
    Dim v_PARAM_ANGLE As Integer = CPUParticles2D.PARAM_ANGLE
    If v_PARAM_ANGLE = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_CPUParticles2D_Parameter"
    Else
        Print "FAIL:enum_CPUParticles2D_Parameter count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_CPUParticles2D_Parameter err=" & str(Err.Number)
    End If
End Sub


