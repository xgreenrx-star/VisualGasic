    Dim v_FUNC_LESS_THAN_EQUAL As Integer = VisualShaderNodeCompare.FUNC_LESS_THAN_EQUAL
    If v_FUNC_LESS_THAN_EQUAL = 5 Then pass_count = pass_count + 1
    Dim v_FUNC_MAX As Integer = VisualShaderNodeCompare.FUNC_MAX
