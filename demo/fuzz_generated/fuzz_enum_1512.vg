Attribute VB_Name = "fuzz_enum_1512"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_CTYPE_SCALAR As Integer = VisualShaderNodeCompare.CTYPE_SCALAR
    If v_CTYPE_SCALAR = 0 Then pass_count = pass_count + 1
    Dim v_CTYPE_SCALAR_INT As Integer = VisualShaderNodeCompare.CTYPE_SCALAR_INT
    If v_CTYPE_SCALAR_INT = 1 Then pass_count = pass_count + 1
    Dim v_CTYPE_SCALAR_UINT As Integer = VisualShaderNodeCompare.CTYPE_SCALAR_UINT
    If v_CTYPE_SCALAR_UINT = 2 Then pass_count = pass_count + 1
    Dim v_CTYPE_VECTOR_2D As Integer = VisualShaderNodeCompare.CTYPE_VECTOR_2D
    If v_CTYPE_VECTOR_2D = 3 Then pass_count = pass_count + 1
    Dim v_CTYPE_VECTOR_3D As Integer = VisualShaderNodeCompare.CTYPE_VECTOR_3D
    If v_CTYPE_VECTOR_3D = 4 Then pass_count = pass_count + 1
    Dim v_CTYPE_VECTOR_4D As Integer = VisualShaderNodeCompare.CTYPE_VECTOR_4D
    If v_CTYPE_VECTOR_4D = 5 Then pass_count = pass_count + 1
    Dim v_CTYPE_BOOLEAN As Integer = VisualShaderNodeCompare.CTYPE_BOOLEAN
    If v_CTYPE_BOOLEAN = 6 Then pass_count = pass_count + 1
    Dim v_CTYPE_TRANSFORM As Integer = VisualShaderNodeCompare.CTYPE_TRANSFORM
    If v_CTYPE_TRANSFORM = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_VisualShaderNodeCompare_ComparisonType"
    Else
        Print "FAIL:enum_VisualShaderNodeCompare_ComparisonType count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_VisualShaderNodeCompare_ComparisonType err=" & str(Err.Number)
    End If
End Sub


