Attribute VB_Name = "fuzz_inst_540"


Sub RunTest0()
    On Error Resume Next
    Dim obj As StyleBoxEmpty = StyleBoxEmpty.new()
    If obj <> Null Then
        Print "PASS:inst_StyleBoxEmpty"
    Else
        Print "FAIL:inst_StyleBoxEmpty returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_StyleBoxEmpty err=" & str(Err.Number)
    End If
End Sub


