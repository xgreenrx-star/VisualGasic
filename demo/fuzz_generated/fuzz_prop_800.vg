Attribute VB_Name = "fuzz_prop_800"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ColorPickerButton = ColorPickerButton.new()
    If obj = Null Then
        Print "SKIP:prop_ColorPickerButton_edit_alpha (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.edit_alpha
    Print "PASS:prop_ColorPickerButton_edit_alpha"
    obj.edit_alpha = True
    Dim val2 As Variant = obj.edit_alpha
    Print "PASS:propset_ColorPickerButton_edit_alpha"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_ColorPickerButton_edit_alpha err=" & str(Err.Number)
    End If
End Sub


