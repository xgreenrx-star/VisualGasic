Attribute VB_Name = "fuzz_prop_944"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ScrollContainer = ScrollContainer.new()
    If obj = Null Then
        Print "SKIP:prop_ScrollContainer_follow_focus (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.follow_focus
    Print "PASS:prop_ScrollContainer_follow_focus"
    obj.follow_focus = True
    Dim val2 As Variant = obj.follow_focus
    Print "PASS:propset_ScrollContainer_follow_focus"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_ScrollContainer_follow_focus err=" & str(Err.Number)
    End If
End Sub


