Attribute VB_Name = "fuzz_enum_1521"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_BODY_FLAG_UPPER_BODY_SUPPORTED As Integer = XRBodyTracker.BODY_FLAG_UPPER_BODY_SUPPORTED
    If v_BODY_FLAG_UPPER_BODY_SUPPORTED = 1 Then pass_count = pass_count + 1
    Dim v_BODY_FLAG_LOWER_BODY_SUPPORTED As Integer = XRBodyTracker.BODY_FLAG_LOWER_BODY_SUPPORTED
    If v_BODY_FLAG_LOWER_BODY_SUPPORTED = 2 Then pass_count = pass_count + 1
    Dim v_BODY_FLAG_HANDS_SUPPORTED As Integer = XRBodyTracker.BODY_FLAG_HANDS_SUPPORTED
    If v_BODY_FLAG_HANDS_SUPPORTED = 4 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_XRBodyTracker_BodyFlags"
    Else
        Print "FAIL:enum_XRBodyTracker_BodyFlags count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_XRBodyTracker_BodyFlags err=" & str(Err.Number)
    End If
End Sub


