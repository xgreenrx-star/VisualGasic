Attribute VB_Name = "fuzz_prop_760"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CPUParticles3D = CPUParticles3D.new()
    If obj = Null Then
        Print "SKIP:prop_CPUParticles3D_amount (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.amount
    Print "PASS:prop_CPUParticles3D_amount"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_CPUParticles3D_amount err=" & str(Err.Number)
    End If
End Sub


