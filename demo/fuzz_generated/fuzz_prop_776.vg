Attribute VB_Name = "fuzz_prop_776"


Sub RunTest0()
    On Error Resume Next
    Dim obj As LineEdit = LineEdit.new()
    If obj = Null Then
        Print "SKIP:prop_LineEdit_alignment (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.alignment
    Print "PASS:prop_LineEdit_alignment"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_LineEdit_alignment err=" & str(Err.Number)
    End If
End Sub


