Attribute VB_Name = "fuzz_enum_1476"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FLAG_USE_LIMIT As Integer = HingeJoint3D.FLAG_USE_LIMIT
    If v_FLAG_USE_LIMIT = 0 Then pass_count = pass_count + 1
    Dim v_FLAG_ENABLE_MOTOR As Integer = HingeJoint3D.FLAG_ENABLE_MOTOR
    If v_FLAG_ENABLE_MOTOR = 1 Then pass_count = pass_count + 1
    Dim v_FLAG_MAX As Integer = HingeJoint3D.FLAG_MAX
    If v_FLAG_MAX = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_HingeJoint3D_Flag"
    Else
        Print "FAIL:enum_HingeJoint3D_Flag count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_HingeJoint3D_Flag err=" & str(Err.Number)
    End If
End Sub


