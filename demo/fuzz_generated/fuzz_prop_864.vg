Attribute VB_Name = "fuzz_prop_864"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VSlider = VSlider.new()
    If obj = Null Then
        Print "SKIP:prop_VSlider_editable (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.editable
    Print "PASS:prop_VSlider_editable"
    obj.editable = True
    Dim val2 As Variant = obj.editable
    Print "PASS:propset_VSlider_editable"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_VSlider_editable err=" & str(Err.Number)
    End If
End Sub


