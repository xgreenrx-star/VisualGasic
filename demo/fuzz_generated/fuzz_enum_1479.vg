Attribute VB_Name = "fuzz_enum_1479"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_BAKE_QUALITY_LOW As Integer = LightmapGI.BAKE_QUALITY_LOW
    If v_BAKE_QUALITY_LOW = 0 Then pass_count = pass_count + 1
    Dim v_BAKE_QUALITY_MEDIUM As Integer = LightmapGI.BAKE_QUALITY_MEDIUM
    If v_BAKE_QUALITY_MEDIUM = 1 Then pass_count = pass_count + 1
    Dim v_BAKE_QUALITY_HIGH As Integer = LightmapGI.BAKE_QUALITY_HIGH
    If v_BAKE_QUALITY_HIGH = 2 Then pass_count = pass_count + 1
    Dim v_BAKE_QUALITY_ULTRA As Integer = LightmapGI.BAKE_QUALITY_ULTRA
    If v_BAKE_QUALITY_ULTRA = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_LightmapGI_BakeQuality"
    Else
        Print "FAIL:enum_LightmapGI_BakeQuality count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_LightmapGI_BakeQuality err=" & str(Err.Number)
    End If
End Sub


