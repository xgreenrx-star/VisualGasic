Attribute VB_Name = "fuzz_enum_1448"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_UPDATE_CONTINUOUS As Integer = Animation.UPDATE_CONTINUOUS
    If v_UPDATE_CONTINUOUS = 0 Then pass_count = pass_count + 1
    Dim v_UPDATE_DISCRETE As Integer = Animation.UPDATE_DISCRETE
    If v_UPDATE_DISCRETE = 1 Then pass_count = pass_count + 1
    Dim v_UPDATE_CAPTURE As Integer = Animation.UPDATE_CAPTURE
    If v_UPDATE_CAPTURE = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_Animation_UpdateMode"
    Else
        Print "FAIL:enum_Animation_UpdateMode count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Animation_UpdateMode err=" & str(Err.Number)
    End If
End Sub


