Attribute VB_Name = "fuzz_prop_792"


Sub RunTest0()
    On Error Resume Next
    Dim obj As OptionButton = OptionButton.new()
    If obj = Null Then
        Print "SKIP:prop_OptionButton_item_count (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.item_count
    Print "PASS:prop_OptionButton_item_count"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_OptionButton_item_count err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
    On Error Resume Next
    Dim obj As OptionButton = OptionButton.new()
    If obj = Null Then
        Print "SKIP:prop_OptionButton_text (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.text
    Print "PASS:prop_OptionButton_text"
    obj.text = "test_string"
    Dim val2 As Variant = obj.text
    Print "PASS:propset_OptionButton_text"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_OptionButton_text err=" & str(Err.Number)
    End If
End Sub


