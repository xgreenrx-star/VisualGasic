Attribute VB_Name = "fuzz_enum_1472"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_DRAW_ORDER_INDEX As Integer = GPUParticles3D.DRAW_ORDER_INDEX
    If v_DRAW_ORDER_INDEX = 0 Then pass_count = pass_count + 1
    Dim v_DRAW_ORDER_LIFETIME As Integer = GPUParticles3D.DRAW_ORDER_LIFETIME
    If v_DRAW_ORDER_LIFETIME = 1 Then pass_count = pass_count + 1
    Dim v_DRAW_ORDER_REVERSE_LIFETIME As Integer = GPUParticles3D.DRAW_ORDER_REVERSE_LIFETIME
    If v_DRAW_ORDER_REVERSE_LIFETIME = 2 Then pass_count = pass_count + 1
    Dim v_DRAW_ORDER_VIEW_DEPTH As Integer = GPUParticles3D.DRAW_ORDER_VIEW_DEPTH
    If v_DRAW_ORDER_VIEW_DEPTH = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_GPUParticles3D_DrawOrder"
    Else
        Print "FAIL:enum_GPUParticles3D_DrawOrder count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_GPUParticles3D_DrawOrder err=" & str(Err.Number)
    End If
End Sub


