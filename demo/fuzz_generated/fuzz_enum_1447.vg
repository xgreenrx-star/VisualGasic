Attribute VB_Name = "fuzz_enum_1447"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_MODE_ECB_ENCRYPT As Integer = AESContext.MODE_ECB_ENCRYPT
    If v_MODE_ECB_ENCRYPT = 0 Then pass_count = pass_count + 1
    Dim v_MODE_ECB_DECRYPT As Integer = AESContext.MODE_ECB_DECRYPT
    If v_MODE_ECB_DECRYPT = 1 Then pass_count = pass_count + 1
    Dim v_MODE_CBC_ENCRYPT As Integer = AESContext.MODE_CBC_ENCRYPT
    If v_MODE_CBC_ENCRYPT = 2 Then pass_count = pass_count + 1
    Dim v_MODE_CBC_DECRYPT As Integer = AESContext.MODE_CBC_DECRYPT
    If v_MODE_CBC_DECRYPT = 3 Then pass_count = pass_count + 1
    Dim v_MODE_MAX As Integer = AESContext.MODE_MAX
    If v_MODE_MAX = 4 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_AESContext_Mode"
    Else
        Print "FAIL:enum_AESContext_Mode count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_AESContext_Mode err=" & str(Err.Number)
    End If
End Sub


