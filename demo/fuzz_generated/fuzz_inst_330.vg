Attribute VB_Name = "fuzz_inst_330"


Sub RunTest0()
    On Error Resume Next
    Dim obj As NavigationMesh = NavigationMesh.new()
    If obj <> Null Then
        Print "PASS:inst_NavigationMesh"
    Else
        Print "FAIL:inst_NavigationMesh returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_NavigationMesh err=" & str(Err.Number)
    End If
End Sub


