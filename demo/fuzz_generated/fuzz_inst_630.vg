Attribute VB_Name = "fuzz_inst_630"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeDotProduct = VisualShaderNodeDotProduct.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeDotProduct"
    Else
        Print "FAIL:inst_VisualShaderNodeDotProduct returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeDotProduct err=" & str(Err.Number)
    End If
End Sub


