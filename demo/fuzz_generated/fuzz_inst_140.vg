Attribute VB_Name = "fuzz_inst_140"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CharFXTransform = CharFXTransform.new()
    If obj <> Null Then
        Print "PASS:inst_CharFXTransform"
    Else
        Print "FAIL:inst_CharFXTransform returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_CharFXTransform err=" & str(Err.Number)
    End If
End Sub


