Attribute VB_Name = "fuzz_inst_320"


Sub RunTest0()
    On Error Resume Next
    Dim obj As MultiMeshInstance2D = MultiMeshInstance2D.new()
    If obj <> Null Then
        Print "PASS:inst_MultiMeshInstance2D"
        obj.free()
    Else
        Print "FAIL:inst_MultiMeshInstance2D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_MultiMeshInstance2D err=" & str(Err.Number)
    End If
End Sub


