Attribute VB_Name = "fuzz_inst_690"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeUIntConstant = VisualShaderNodeUIntConstant.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeUIntConstant"
    Else
        Print "FAIL:inst_VisualShaderNodeUIntConstant returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeUIntConstant err=" & str(Err.Number)
    End If
End Sub


