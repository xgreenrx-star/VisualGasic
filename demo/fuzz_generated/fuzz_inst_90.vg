Attribute VB_Name = "fuzz_inst_90"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AudioStreamOggVorbis = AudioStreamOggVorbis.new()
    If obj <> Null Then
        Print "PASS:inst_AudioStreamOggVorbis"
    Else
        Print "FAIL:inst_AudioStreamOggVorbis returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AudioStreamOggVorbis err=" & str(Err.Number)
    End If
End Sub


