Attribute VB_Name = "fuzz_inst_580"


Sub RunTest0()
    On Error Resume Next
    Dim obj As Timer = Timer.new()
    If obj <> Null Then
        Print "PASS:inst_Timer"
        obj.free()
    Else
        Print "FAIL:inst_Timer returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_Timer err=" & str(Err.Number)
    End If
End Sub


