Attribute VB_Name = "fuzz_enum_1458"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_DISTANCE_FADE_DISABLED As Integer = BaseMaterial3D.DISTANCE_FADE_DISABLED
    If v_DISTANCE_FADE_DISABLED = 0 Then pass_count = pass_count + 1
    Dim v_DISTANCE_FADE_PIXEL_ALPHA As Integer = BaseMaterial3D.DISTANCE_FADE_PIXEL_ALPHA
    If v_DISTANCE_FADE_PIXEL_ALPHA = 1 Then pass_count = pass_count + 1
    Dim v_DISTANCE_FADE_PIXEL_DITHER As Integer = BaseMaterial3D.DISTANCE_FADE_PIXEL_DITHER
    If v_DISTANCE_FADE_PIXEL_DITHER = 2 Then pass_count = pass_count + 1
    Dim v_DISTANCE_FADE_OBJECT_DITHER As Integer = BaseMaterial3D.DISTANCE_FADE_OBJECT_DITHER
    If v_DISTANCE_FADE_OBJECT_DITHER = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_BaseMaterial3D_DistanceFadeMode"
    Else
        Print "FAIL:enum_BaseMaterial3D_DistanceFadeMode count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_BaseMaterial3D_DistanceFadeMode err=" & str(Err.Number)
    End If
End Sub


