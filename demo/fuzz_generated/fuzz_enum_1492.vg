Attribute VB_Name = "fuzz_enum_1492"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_AMBIENT_DISABLED As Integer = ReflectionProbe.AMBIENT_DISABLED
    If v_AMBIENT_DISABLED = 0 Then pass_count = pass_count + 1
    Dim v_AMBIENT_ENVIRONMENT As Integer = ReflectionProbe.AMBIENT_ENVIRONMENT
    If v_AMBIENT_ENVIRONMENT = 1 Then pass_count = pass_count + 1
    Dim v_AMBIENT_COLOR As Integer = ReflectionProbe.AMBIENT_COLOR
    If v_AMBIENT_COLOR = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_ReflectionProbe_AmbientMode"
    Else
        Print "FAIL:enum_ReflectionProbe_AmbientMode count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_ReflectionProbe_AmbientMode err=" & str(Err.Number)
    End If
End Sub


