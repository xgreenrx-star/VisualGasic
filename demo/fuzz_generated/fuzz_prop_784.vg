Attribute VB_Name = "fuzz_prop_784"


Sub RunTest0()
    On Error Resume Next
    Dim obj As RichTextLabel = RichTextLabel.new()
    If obj = Null Then
        Print "SKIP:prop_RichTextLabel_bbcode_enabled (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.bbcode_enabled
    Print "PASS:prop_RichTextLabel_bbcode_enabled"
    obj.bbcode_enabled = True
    Dim val2 As Variant = obj.bbcode_enabled
    Print "PASS:propset_RichTextLabel_bbcode_enabled"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_RichTextLabel_bbcode_enabled err=" & str(Err.Number)
    End If
End Sub


