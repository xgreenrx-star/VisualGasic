Attribute VB_Name = "fuzz_prop_856"


Sub RunTest0()
    On Error Resume Next
    Dim obj As LinkButton = LinkButton.new()
    If obj = Null Then
        Print "SKIP:prop_LinkButton_uri (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.uri
    Print "PASS:prop_LinkButton_uri"
    obj.uri = "test_string"
    Dim val2 As Variant = obj.uri
    Print "PASS:propset_LinkButton_uri"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_LinkButton_uri err=" & str(Err.Number)
    End If
End Sub


