Sub RunTest0()
    On Error Resume Next
    Dim obj As Sprite2D = Sprite2D.new()
    If obj = Null Then
        Print "SKIP:inh_Sprite2D (null)"
        Exit Sub
    End If
    Dim v_Sprite2D As Variant = obj.get_texture()
    Print "PASS:inh_Sprite2D_from_Sprite2D_get_texture"
    Dim v_Node2D As Variant = obj.get_position()
    Print "PASS:inh_Sprite2D_from_Node2D_get_position"
    Dim v_CanvasItem As Variant = obj.get_canvas_item()
    Print "PASS:inh_Sprite2D_from_CanvasItem_get_canvas_item"
    Dim v_Node As Variant = obj.get_name()
    Print "PASS:inh_Sprite2D_from_Node_get_name"
    Dim v_Object As Variant = obj.get_class()
    Print "PASS:inh_Sprite2D_from_Object_get_class"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:inh_Sprite2D err=" & str(Err.Number)
    End If
End Sub


