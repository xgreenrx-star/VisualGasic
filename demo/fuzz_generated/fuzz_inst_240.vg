Attribute VB_Name = "fuzz_inst_240"


Sub RunTest0()
    On Error Resume Next
    Dim obj As GradientTexture1D = GradientTexture1D.new()
    If obj <> Null Then
        Print "PASS:inst_GradientTexture1D"
    Else
        Print "FAIL:inst_GradientTexture1D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_GradientTexture1D err=" & str(Err.Number)
    End If
End Sub


