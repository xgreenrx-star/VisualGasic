Attribute VB_Name = "fuzz_meth_1605"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CSGPolygon3D = CSGPolygon3D.new()
    If obj = Null Then
        Print "SKIP:meth_CSGPolygon3D (null)"
        Exit Sub
    End If
    Dim r_get_polygon As Variant = obj.get_polygon()
    Print "PASS:meth_CSGPolygon3D_get_polygon"
    Dim r_get_mode As Variant = obj.get_mode()
    Print "PASS:meth_CSGPolygon3D_get_mode"
    Dim r_get_depth As Variant = obj.get_depth()
    Print "PASS:meth_CSGPolygon3D_get_depth"
    Dim r_get_spin_degrees As Variant = obj.get_spin_degrees()
    Print "PASS:meth_CSGPolygon3D_get_spin_degrees"
    Dim r_get_spin_sides As Variant = obj.get_spin_sides()
    Print "PASS:meth_CSGPolygon3D_get_spin_sides"
    Dim r_get_path_node As Variant = obj.get_path_node()
    Print "PASS:meth_CSGPolygon3D_get_path_node"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_CSGPolygon3D err=" & str(Err.Number)
    End If
End Sub


