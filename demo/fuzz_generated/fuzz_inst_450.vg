Attribute VB_Name = "fuzz_inst_450"


Sub RunTest0()
    On Error Resume Next
    Dim obj As RDVertexAttribute = RDVertexAttribute.new()
    If obj <> Null Then
        Print "PASS:inst_RDVertexAttribute"
    Else
        Print "FAIL:inst_RDVertexAttribute returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_RDVertexAttribute err=" & str(Err.Number)
    End If
End Sub


