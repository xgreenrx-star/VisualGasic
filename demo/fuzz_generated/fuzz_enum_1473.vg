Attribute VB_Name = "fuzz_enum_1473"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_PARAM_LINEAR_LOWER_LIMIT As Integer = Generic6DOFJoint3D.PARAM_LINEAR_LOWER_LIMIT
    If v_PARAM_LINEAR_LOWER_LIMIT = 0 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_UPPER_LIMIT As Integer = Generic6DOFJoint3D.PARAM_LINEAR_UPPER_LIMIT
    If v_PARAM_LINEAR_UPPER_LIMIT = 1 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_LIMIT_SOFTNESS As Integer = Generic6DOFJoint3D.PARAM_LINEAR_LIMIT_SOFTNESS
    If v_PARAM_LINEAR_LIMIT_SOFTNESS = 2 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_RESTITUTION As Integer = Generic6DOFJoint3D.PARAM_LINEAR_RESTITUTION
    If v_PARAM_LINEAR_RESTITUTION = 3 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_DAMPING As Integer = Generic6DOFJoint3D.PARAM_LINEAR_DAMPING
    If v_PARAM_LINEAR_DAMPING = 4 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_MOTOR_TARGET_VELOCITY As Integer = Generic6DOFJoint3D.PARAM_LINEAR_MOTOR_TARGET_VELOCITY
    If v_PARAM_LINEAR_MOTOR_TARGET_VELOCITY = 5 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_MOTOR_FORCE_LIMIT As Integer = Generic6DOFJoint3D.PARAM_LINEAR_MOTOR_FORCE_LIMIT
    If v_PARAM_LINEAR_MOTOR_FORCE_LIMIT = 6 Then pass_count = pass_count + 1
    Dim v_PARAM_LINEAR_SPRING_STIFFNESS As Integer = Generic6DOFJoint3D.PARAM_LINEAR_SPRING_STIFFNESS
    If v_PARAM_LINEAR_SPRING_STIFFNESS = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_Generic6DOFJoint3D_Param"
    Else
        Print "FAIL:enum_Generic6DOFJoint3D_Param count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Generic6DOFJoint3D_Param err=" & str(Err.Number)
    End If
End Sub


