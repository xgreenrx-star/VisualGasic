Attribute VB_Name = "fuzz_prop_896"


Sub RunTest0()
    On Error Resume Next
    Dim obj As GraphFrame = GraphFrame.new()
    If obj = Null Then
        Print "SKIP:prop_GraphFrame_autoshrink_margin (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.autoshrink_margin
    Print "PASS:prop_GraphFrame_autoshrink_margin"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_GraphFrame_autoshrink_margin err=" & str(Err.Number)
    End If
End Sub


