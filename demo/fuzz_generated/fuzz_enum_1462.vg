Attribute VB_Name = "fuzz_enum_1462"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_BLEND_MODE_MIX As Integer = CanvasItemMaterial.BLEND_MODE_MIX
    If v_BLEND_MODE_MIX = 0 Then pass_count = pass_count + 1
    Dim v_BLEND_MODE_ADD As Integer = CanvasItemMaterial.BLEND_MODE_ADD
    If v_BLEND_MODE_ADD = 1 Then pass_count = pass_count + 1
    Dim v_BLEND_MODE_SUB As Integer = CanvasItemMaterial.BLEND_MODE_SUB
    If v_BLEND_MODE_SUB = 2 Then pass_count = pass_count + 1
    Dim v_BLEND_MODE_MUL As Integer = CanvasItemMaterial.BLEND_MODE_MUL
    If v_BLEND_MODE_MUL = 3 Then pass_count = pass_count + 1
    Dim v_BLEND_MODE_PREMULT_ALPHA As Integer = CanvasItemMaterial.BLEND_MODE_PREMULT_ALPHA
    If v_BLEND_MODE_PREMULT_ALPHA = 4 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_CanvasItemMaterial_BlendMode"
    Else
        Print "FAIL:enum_CanvasItemMaterial_BlendMode count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_CanvasItemMaterial_BlendMode err=" & str(Err.Number)
    End If
End Sub


