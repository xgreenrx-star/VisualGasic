Attribute VB_Name = "fuzz_typeof_1716"


Sub RunTest0()
    On Error Resume Next
    Dim obj As SphereMesh = SphereMesh.new()
    If obj = Null Then
        Print "SKIP:typeof_SphereMesh (null)"
        Exit Sub
    End If
    Dim tn As String = str(TypeOf(obj))
    Print "PASS:typeof_SphereMesh type=" & tn
    If Err.Number <> 0 Then
        Print "ERROR:typeof_SphereMesh err=" & str(Err.Number)
    End If
End Sub


