Attribute VB_Name = "fuzz_enum_1522"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_HAND_JOINT_PALM As Integer = XRHandTracker.HAND_JOINT_PALM
    If v_HAND_JOINT_PALM = 0 Then pass_count = pass_count + 1
    Dim v_HAND_JOINT_WRIST As Integer = XRHandTracker.HAND_JOINT_WRIST
    If v_HAND_JOINT_WRIST = 1 Then pass_count = pass_count + 1
    Dim v_HAND_JOINT_THUMB_METACARPAL As Integer = XRHandTracker.HAND_JOINT_THUMB_METACARPAL
    If v_HAND_JOINT_THUMB_METACARPAL = 2 Then pass_count = pass_count + 1
    Dim v_HAND_JOINT_THUMB_PHALANX_PROXIMAL As Integer = XRHandTracker.HAND_JOINT_THUMB_PHALANX_PROXIMAL
    If v_HAND_JOINT_THUMB_PHALANX_PROXIMAL = 3 Then pass_count = pass_count + 1
    Dim v_HAND_JOINT_THUMB_PHALANX_DISTAL As Integer = XRHandTracker.HAND_JOINT_THUMB_PHALANX_DISTAL
    If v_HAND_JOINT_THUMB_PHALANX_DISTAL = 4 Then pass_count = pass_count + 1
    Dim v_HAND_JOINT_THUMB_TIP As Integer = XRHandTracker.HAND_JOINT_THUMB_TIP
    If v_HAND_JOINT_THUMB_TIP = 5 Then pass_count = pass_count + 1
    Dim v_HAND_JOINT_INDEX_FINGER_METACARPAL As Integer = XRHandTracker.HAND_JOINT_INDEX_FINGER_METACARPAL
    If v_HAND_JOINT_INDEX_FINGER_METACARPAL = 6 Then pass_count = pass_count + 1
    Dim v_HAND_JOINT_INDEX_FINGER_PHALANX_PROXIMAL As Integer = XRHandTracker.HAND_JOINT_INDEX_FINGER_PHALANX_PROXIMAL
    If v_HAND_JOINT_INDEX_FINGER_PHALANX_PROXIMAL = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_XRHandTracker_HandJoint"
    Else
        Print "FAIL:enum_XRHandTracker_HandJoint count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_XRHandTracker_HandJoint err=" & str(Err.Number)
    End If
End Sub


