Attribute VB_Name = "fuzz_enum_1481"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_ORIGIN_FROM_SELF As Integer = LookAtModifier3D.ORIGIN_FROM_SELF
    If v_ORIGIN_FROM_SELF = 0 Then pass_count = pass_count + 1
    Dim v_ORIGIN_FROM_SPECIFIC_BONE As Integer = LookAtModifier3D.ORIGIN_FROM_SPECIFIC_BONE
    If v_ORIGIN_FROM_SPECIFIC_BONE = 1 Then pass_count = pass_count + 1
    Dim v_ORIGIN_FROM_EXTERNAL_NODE As Integer = LookAtModifier3D.ORIGIN_FROM_EXTERNAL_NODE
    If v_ORIGIN_FROM_EXTERNAL_NODE = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_LookAtModifier3D_OriginFrom"
    Else
        Print "FAIL:enum_LookAtModifier3D_OriginFrom count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_LookAtModifier3D_OriginFrom err=" & str(Err.Number)
    End If
End Sub


