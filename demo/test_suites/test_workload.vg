Option Explicit

' Reproduces the exact workload comparison from the Parallel Processing Demo

Const WORK_ITEMS As Integer = 100
Dim workResults(100) As Integer
Dim serialTime As Single
Dim parallelTime As Single
Dim completedTasks As Integer
Dim activeTasks As Integer
Dim workProgress As Integer
Dim totalTasks As Integer

Function SimulateHeavyWork(index As Integer) As Integer
	Dim result As Integer = 0
	Dim j As Integer
	For j = 1 To 3500
		result = result + (j * index) Mod 997
	Next
	Return result
End Function

Sub RunSerialWorkLoad()
	workProgress = 0
	totalTasks = WORK_ITEMS
	completedTasks = 0
	activeTasks = WORK_ITEMS

	Dim startTime As Single = Timer()

	Dim i As Integer
	For i = 0 To WORK_ITEMS - 1
		workResults(i) = SimulateHeavyWork(i)
		workProgress = i + 1
		completedTasks = completedTasks + 1
		activeTasks = activeTasks - 1
	Next

	serialTime = Timer() - startTime
	Print "Serial completed in " & Format(serialTime, "0.000") & " seconds"
End Sub

Sub RunParallelWorkLoad()
	workProgress = 0
	totalTasks = WORK_ITEMS
	completedTasks = 0
	activeTasks = WORK_ITEMS

	Dim startTime As Single = Timer()

	Parallel For i As Integer = 0 To WORK_ITEMS - 1
		workResults(i) = SimulateHeavyWork(i)
		Lock
			workProgress = workProgress + 1
			completedTasks = completedTasks + 1
			activeTasks = activeTasks - 1
		Unlock
	Next

	parallelTime = Timer() - startTime
	Print "Parallel completed in " & Format(parallelTime, "0.000") & " seconds"

	If parallelTime > 0 Then
		Dim speedup As Single = serialTime / parallelTime
		Print "Speedup: " & Format(speedup, "0.00") & "x"
	End If
End Sub

Sub Main()
	Print "=== Work Load Comparison Test ==="

	RunSerialWorkLoad

	' Verify serial
	Dim serialSum As Long = 0
	Dim i As Integer
	For i = 0 To WORK_ITEMS - 1
		serialSum = serialSum + workResults(i)
	Next
	Print "Serial checksum: " & serialSum

	' Clear
	For i = 0 To WORK_ITEMS - 1
		workResults(i) = 0
	Next

	RunParallelWorkLoad

	' Verify parallel
	Dim parallelSum As Long = 0
	For i = 0 To WORK_ITEMS - 1
		parallelSum = parallelSum + workResults(i)
	Next
	Print "Parallel checksum: " & parallelSum

	If serialSum = parallelSum Then
		Print "PASS: Checksums match (" & serialSum & ")"
	Else
		Print "FAIL: Serial=" & serialSum & " Parallel=" & parallelSum
	End If

	If parallelTime < 0 Then
		Print "FAIL: Negative parallel time! (" & Format(parallelTime, "0.000") & ")"
	ElseIf parallelTime < serialTime * 0.05 Then
		Print "FAIL: Parallel suspiciously fast (" & Format(parallelTime, "0.000") & "s vs " & Format(serialTime, "0.000") & "s)"
	Else
		Print "PASS: Timing reasonable"
	End If
End Sub
