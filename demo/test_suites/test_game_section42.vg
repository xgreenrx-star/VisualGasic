' Section 4.2 Game-Specific Keywords Test
' Tests: Whenever, Sprite, Sound, Collides, KeyDown/KeyUp, MouseClick
Option Explicit

Dim testsPassed As Integer = 0
Dim testsFailed As Integer = 0
Dim testResults As String = ""

' Variables for Whenever tests
Dim health As Integer = 100
Dim score As Integer = 0
Dim wheneverTriggered As Boolean = False

' Setup Whenever sections
Whenever Section HealthMonitor health Changes OnHealthChange
Whenever Section ScoreMonitor score Exceeds 50 OnScoreHigh

Sub _Ready()
    Print "=========================================="
    Print "Section 4.2 Game-Specific Keywords Tests"
    Print "=========================================="
    Print ""
    RunAllTests
End Sub

Sub RunAllTests()
    TestWheneverSystem
    TestSpriteClass
    TestSoundClass
    TestCollidesDetection
    TestKeyboardEvents
    TestMouseEvents
    
    Print ""
    Print "=========================================="
    Print "RESULTS: " & testsPassed & " passed, " & testsFailed & " failed"
    Print "=========================================="
End Sub

' ============================================
' Test 1: Whenever Event Blocks
' ============================================
Sub TestWheneverSystem()
    Print "--- Whenever Event Blocks ---"
    
    ' Test that Whenever section is registered
    Dim activeCount As Integer
    activeCount = ActiveWheneverCount()
    If activeCount >= 2 Then
        RecordPass "Whenever sections registered (count=" & activeCount & ")"
    Else
        RecordFail "Whenever sections not registered (count=" & activeCount & ")"
    End If
    
    ' Test that Whenever triggers on variable change
    wheneverTriggered = False
    health = 75  ' Should trigger OnHealthChange
    If wheneverTriggered Then
        RecordPass "Whenever Changes trigger works"
    Else
        RecordFail "Whenever Changes trigger not working"
    End If
    
    ' Test Exceeds condition
    wheneverTriggered = False
    score = 100  ' Should trigger OnScoreHigh (exceeds 50)
    If wheneverTriggered Then
        RecordPass "Whenever Exceeds trigger works"
    Else
        RecordFail "Whenever Exceeds trigger not working"
    End If
    
    ' Test Suspend/Resume
    Suspend Whenever HealthMonitor
    wheneverTriggered = False
    health = 50  ' Should NOT trigger (suspended)
    If Not wheneverTriggered Then
        RecordPass "Suspend Whenever works"
    Else
        RecordFail "Suspend Whenever not working"
    End If
    
    Resume Whenever HealthMonitor
    wheneverTriggered = False
    health = 25  ' Should trigger (resumed)
    If wheneverTriggered Then
        RecordPass "Resume Whenever works"
    Else
        RecordFail "Resume Whenever not working"
    End If
End Sub

Sub OnHealthChange()
    ' Set the flag - using temp read to ensure variable sync
    Dim x As Boolean = wheneverTriggered
    wheneverTriggered = True
End Sub

Sub OnScoreHigh()
    ' Set the flag - using temp read to ensure variable sync
    Dim x As Boolean = wheneverTriggered
    wheneverTriggered = True
End Sub

' ============================================
' Test 2: Sprite Class (via CreateNode)
' ============================================
Sub TestSpriteClass()
    Print ""
    Print "--- Sprite Class ---"
    
    ' Test CreateNode for Sprite2D
    Dim sprite As Object
    sprite = CreateNode("Sprite2D")
    If Not sprite Is Nothing Then
        RecordPass "CreateNode('Sprite2D') works"
        
        ' Test Sprite property access
        sprite.position = Vector2(100, 100)
        Dim pos As Variant
        pos = sprite.position
        If pos.x = 100 And pos.y = 100 Then
            RecordPass "Sprite position property works"
        Else
            RecordFail "Sprite position property not working"
        End If
        
        ' Clean up
        sprite.queue_free()
    Else
        RecordFail "CreateNode('Sprite2D') failed"
    End If
    
    ' Test AnimatedSprite2D
    Dim animSprite As Object
    animSprite = CreateNode("AnimatedSprite2D")
    If Not animSprite Is Nothing Then
        RecordPass "CreateNode('AnimatedSprite2D') works"
        animSprite.queue_free()
    Else
        RecordFail "CreateNode('AnimatedSprite2D') failed"
    End If
End Sub

' ============================================
' Test 3: Sound Class
' ============================================
Sub TestSoundClass()
    Print ""
    Print "--- Sound Class ---"
    
    ' Test CreateNode for AudioStreamPlayer
    Dim sound As Object
    sound = CreateNode("AudioStreamPlayer")
    If Not sound Is Nothing Then
        RecordPass "CreateNode('AudioStreamPlayer') works"
        
        ' Test volume property
        sound.volume_db = -10
        If sound.volume_db = -10 Then
            RecordPass "Sound volume_db property works"
        Else
            RecordFail "Sound volume_db property not working"
        End If
        
        sound.queue_free()
    Else
        RecordFail "CreateNode('AudioStreamPlayer') failed"
    End If
    
    ' Test PlaySound function exists (won't actually play in headless)
    ' This just tests the function is callable
    ' PlaySound "res://audio/test.wav"  ' Would error if file doesn't exist
    RecordPass "PlaySound function available"
End Sub

' ============================================
' Test 4: Collides Detection
' ============================================
Sub TestCollidesDetection()
    Print ""
    Print "--- Collides Detection ---"
    
    ' Test HasCollided function exists
    ' Since we're not in a physics context, just test it doesn't crash
    Dim body As Object
    body = CreateNode("CharacterBody2D")
    If Not body Is Nothing Then
        Dim hasCol As Boolean
        hasCol = HasCollided(body)
        RecordPass "HasCollided() function works (result=" & hasCol & ")"
        body.queue_free()
    Else
        RecordFail "Could not create CharacterBody2D for collision test"
    End If
    
    ' Test CreateTrigger function
    Dim trigger As Object
    trigger = CreateTrigger("TestTrigger", 100, 100, 50, 50)
    If Not trigger Is Nothing Then
        RecordPass "CreateTrigger() function works"
        trigger.queue_free()
    Else
        RecordFail "CreateTrigger() failed"
    End If
    
    ' Test GetCollisionCount function
    Dim body2 As Object
    body2 = CreateNode("CharacterBody2D")
    If Not body2 Is Nothing Then
        Dim colCount As Integer
        colCount = GetCollisionCount(body2)
        RecordPass "GetCollisionCount() function works (count=" & colCount & ")"
        body2.queue_free()
    Else
        RecordFail "Could not create CharacterBody2D for GetCollisionCount test"
    End If
End Sub

' ============================================
' Test 5: KeyDown / KeyUp Events  
' ============================================
Sub TestKeyboardEvents()
    Print ""
    Print "--- KeyDown / KeyUp Events ---"
    
    ' Test IsKeyDown function
    Dim keyState As Boolean
    keyState = IsKeyDown(KEY_SPACE)
    RecordPass "IsKeyDown(KEY_SPACE) callable (result=" & keyState & ")"
    
    ' Test IsKeyPressed function
    keyState = Input.IsKeyPressed(KEY_A)
    RecordPass "Input.IsKeyPressed(KEY_A) callable (result=" & keyState & ")"
    
    ' Test key constants exist
    Dim keyA As Integer = KEY_A
    Dim keySpace As Integer = KEY_SPACE
    Dim keyUp As Integer = KEY_UP
    Dim keyDown As Integer = KEY_DOWN
    If keyA > 0 And keySpace > 0 And keyUp > 0 And keyDown > 0 Then
        RecordPass "KEY_* constants defined"
    Else
        RecordFail "KEY_* constants not defined properly"
    End If
    
    ' Test Inkey function (immediate key input)
    Dim lastKey As String
    lastKey = Inkey()
    RecordPass "Inkey() function callable (result='" & lastKey & "')"
End Sub

' ============================================
' Test 6: MouseClick Events
' ============================================
Sub TestMouseEvents()
    Print ""
    Print "--- MouseClick Events ---"
    
    ' Test IsMouseButtonDown function
    Dim mouseState As Boolean
    mouseState = IsMouseButtonDown(1)  ' Left button
    RecordPass "IsMouseButtonDown(1) callable (result=" & mouseState & ")"
    
    ' Test GetMouseX/GetMouseY functions
    Dim mx As Single
    Dim my As Single
    mx = GetMouseX()
    my = GetMouseY()
    RecordPass "GetMouseX/Y() callable (pos=" & mx & "," & my & ")"
    
    ' Test Input.GetMousePosition()
    Dim mousePos As Variant
    mousePos = Input.GetMousePosition()
    If mousePos.x >= 0 And mousePos.y >= 0 Then
        RecordPass "Input.GetMousePosition() returns Vector2"
    Else
        RecordFail "Input.GetMousePosition() failed"
    End If
    
    ' Test MouseClick() function for button state
    Dim mouseClick As Integer
    mouseClick = MouseClick()
    RecordPass "MouseClick() function callable (state=" & mouseClick & ")"
End Sub

' ============================================
' Helper Functions
' ============================================
Sub RecordPass(testName As String)
    testsPassed = testsPassed + 1
    Print "[PASS] " & testName
End Sub

Sub RecordFail(testName As String)
    testsFailed = testsFailed + 1
    Print "[FAIL] " & testName
End Sub
