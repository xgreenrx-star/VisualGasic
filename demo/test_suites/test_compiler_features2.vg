' Test: With...End With, Continue, GoTo, Try/Catch/Finally
' All tests use Print with PASS/FAIL prefix for automated checking.

Sub TestWith()
    Print "--- With...End With ---"
    
    ' Test 1: With on a Dictionary
    Dim d As Dictionary
    Set d = New Dictionary
    d("name") = "Alice"
    d("age") = 30
    
    Dim result As String
    result = ""
    With d
        result = .name
    End With
    
    
    If result = "Alice" Then
        Print "PASS: With Dictionary .member access"
    Else
        Print "FAIL: With Dictionary .member, got: " & result
    End If
    
    ' Test 2: Nested With (not supported in simple impl, just test single level)
    Dim d2 As Dictionary
    Set d2 = New Dictionary
    d2("x") = 42
    
    Dim val As Integer
    val = 0
    With d2
        val = .x
    End With
    
    If val = 42 Then
        Print "PASS: With Dictionary numeric .member"
    Else
        Print "FAIL: With Dictionary numeric, got: " & CStr(val)
    End If
End Sub

Sub TestContinueFor()
    Print "--- Continue For ---"
    
    ' Test 1: Continue For skips even numbers, sum only odd
    Dim total As Integer
    total = 0
    Dim i As Integer
    For i = 1 To 10
        If i Mod 2 = 0 Then
            Continue For
        End If
        total = total + i
    Next i
    
    ' Odd numbers 1-10: 1+3+5+7+9 = 25
    If total = 25 Then
        Print "PASS: Continue For skip evens, sum=" & CStr(total)
    Else
        Print "FAIL: Continue For expected 25, got " & CStr(total)
    End If
    
    ' Test 2: Continue For in nested loop (inner)
    Dim count As Integer
    count = 0
    Dim j As Integer
    For i = 1 To 3
        For j = 1 To 3
            If j = 2 Then
                Continue For
            End If
            count = count + 1
        Next j
    Next i
    
    ' 3 outer * 2 inner (skipping j=2) = 6
    If count = 6 Then
        Print "PASS: Continue For nested, count=" & CStr(count)
    Else
        Print "FAIL: Continue For nested expected 6, got " & CStr(count)
    End If
End Sub

Sub TestContinueDo()
    Print "--- Continue Do ---"
    
    ' Test: Continue Do skips Print but still increments
    Dim n As Integer
    n = 0
    Dim skipped As Integer
    skipped = 0
    Do While n < 10
        n = n + 1
        If n Mod 3 = 0 Then
            skipped = skipped + 1
            Continue Do
        End If
    Loop
    
    ' n goes 1..10, multiples of 3: 3,6,9 = 3 skipped
    If skipped = 3 Then
        Print "PASS: Continue Do skipped=" & CStr(skipped)
    Else
        Print "FAIL: Continue Do expected 3, got " & CStr(skipped)
    End If
End Sub

Sub TestGoTo()
    Print "--- GoTo ---"
    
    ' Test 1: Forward GoTo
    Dim x As Integer
    x = 0
    GoTo SkipAssign
    x = 999
SkipAssign:
    
    If x = 0 Then
        Print "PASS: Forward GoTo skipped assignment"
    Else
        Print "FAIL: Forward GoTo, x=" & CStr(x)
    End If
    
    ' Test 2: Backward GoTo (simple loop)
    Dim counter As Integer
    counter = 0
LoopStart:
    counter = counter + 1
    If counter < 5 Then
        GoTo LoopStart
    End If
    
    If counter = 5 Then
        Print "PASS: Backward GoTo loop, counter=" & CStr(counter)
    Else
        Print "FAIL: Backward GoTo expected 5, got " & CStr(counter)
    End If
End Sub

Sub TestTryCatch()
    Print "--- Try/Catch/Finally ---"
    
    ' Test 1: Catch an error
    Dim caught As Integer
    caught = 0
    Dim finally_ran As Integer
    finally_ran = 0
    
    Try
        Raise 42, "Test error"
        caught = -1  ' Should not reach here
    Catch ex
        caught = ex("Number")
    Finally
        finally_ran = 1
    End Try
    
    If caught = 42 Then
        Print "PASS: Catch caught error code=" & CStr(caught)
    Else
        Print "FAIL: Catch expected 42, got " & CStr(caught)
    End If
    
    If finally_ran = 1 Then
        Print "PASS: Finally block ran"
    Else
        Print "FAIL: Finally block did not run"
    End If
    
    ' Test 2: No error — finally still runs
    Dim no_err As Integer
    no_err = 0
    Dim fin2 As Integer
    fin2 = 0
    
    Try
        no_err = 100
    Catch ex2
        no_err = -1  ' Should not reach
    Finally
        fin2 = 1
    End Try
    
    If no_err = 100 Then
        Print "PASS: Try no-error path, val=" & CStr(no_err)
    Else
        Print "FAIL: Try no-error expected 100, got " & CStr(no_err)
    End If
    
    If fin2 = 1 Then
        Print "PASS: Finally ran on no-error path"
    Else
        Print "FAIL: Finally did not run on no-error"
    End If
End Sub

Sub Main()
    Print "=== Testing Compiler Features (Batch 2) ==="
    Print ""
    
    Call TestWith()
    Print ""
    Call TestContinueFor()
    Print ""
    Call TestContinueDo()
    Print ""
    Call TestGoTo()
    Print ""
    Call TestTryCatch()
    Print ""
    Print "=== BATCH 2 TESTS COMPLETE ==="
End Sub
