Attribute VB_Name = "TestFA2"

Sub RunTest()
    Dim v1 As Variant = FileAccess.READ_WRITE
    Print "READ_WRITE = " & str(v1)
    Dim v2 As Variant = FileAccess.WRITE_READ
    Print "WRITE_READ = " & str(v2)
    Dim v3 As Variant = FileAccess.READ
    Print "READ = " & str(v3)
    Dim v4 As Variant = FileAccess.WRITE
    Print "WRITE = " & str(v4)
End Sub
