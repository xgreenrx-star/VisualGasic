' test_compiler_features.vg
' Tests Select Case, For Each, and object method calls in bytecode
' Run: ./Godot_v4.5.1-stable_linux.x86_64 --headless -s run_test_modern.gd -- test_compiler_features.vg

Sub Main()
    Print "=== Testing Bytecode Compiler Features ==="
    Print ""
    TestSelectCase
    TestForEach
    TestMethodCalls
    Print ""
    Print "=== ALL TESTS PASSED ==="
End Sub

' ── Test 1: Select Case ──────────────────────────────────
Sub TestSelectCase()
    Print "--- Select Case ---"
    
    ' Simple value matching
    Dim x As Integer
    x = 3
    Select Case x
        Case 1
            Print "FAIL: matched 1"
        Case 2
            Print "FAIL: matched 2"
        Case 3
            Print "PASS: Simple value match (x=3)"
        Case Else
            Print "FAIL: fell through to Else"
    End Select
    
    ' Multiple values in one case
    x = 5
    Select Case x
        Case 1, 3, 5
            Print "PASS: Multi-value match (x=5)"
        Case Else
            Print "FAIL: multi-value should have matched"
    End Select
    
    ' Range matching (Case 1 To 10)
    x = 7
    Select Case x
        Case 1 To 5
            Print "FAIL: matched 1-5"
        Case 6 To 10
            Print "PASS: Range match (x=7 in 6..10)"
        Case Else
            Print "FAIL: range should have matched"
    End Select
    
    ' Comparison operator (Case Is > value)
    x = 100
    Select Case x
        Case Is < 50
            Print "FAIL: matched < 50"
        Case Is >= 100
            Print "PASS: Comparison match (x=100, Is >= 100)"
        Case Else
            Print "FAIL: comparison should have matched"
    End Select
    
    ' String matching
    Dim s As String
    s = "hello"
    Select Case s
        Case "world"
            Print "FAIL: matched world"
        Case "hello"
            Print "PASS: String match (s=hello)"
        Case Else
            Print "FAIL: string should have matched"
    End Select
    
    ' Case Else
    x = 999
    Select Case x
        Case 1
            Print "FAIL: matched 1"
        Case 2
            Print "FAIL: matched 2"
        Case Else
            Print "PASS: Case Else (x=999)"
    End Select
    
    Print ""
End Sub

' ── Test 2: For Each ─────────────────────────────────────
Sub TestForEach()
    Print "--- For Each ---"
    
    ' For Each over Array
    Dim arr(4) As Integer
    arr(0) = 10
    arr(1) = 20
    arr(2) = 30
    arr(3) = 40
    arr(4) = 50
    
    Dim total As Integer
    total = 0
    Dim item As Variant
    For Each item In arr
        total = total + item
    Next
    
    If total = 150 Then
        Print "PASS: For Each Array sum = " & CStr(total)
    Else
        Print "FAIL: expected 150, got " & CStr(total)
    End If
    
    ' For Each over Dictionary keys
    Dim d As Dictionary
    Set d = New Dictionary
    d("a") = 1
    d("b") = 2
    d("c") = 3
    
    Dim keyCount As Integer
    keyCount = 0
    Dim k As Variant
    For Each k In d
        keyCount = keyCount + 1
    Next
    
    If keyCount = 3 Then
        Print "PASS: For Each Dict keys count = " & CStr(keyCount)
    Else
        Print "FAIL: expected 3 keys, got " & CStr(keyCount)
    End If
    
    ' For Each with Exit For
    Dim count As Integer
    count = 0
    For Each item In arr
        count = count + 1
        If item = 30 Then Exit For
    Next
    
    If count = 3 Then
        Print "PASS: For Each + Exit For at count = " & CStr(count)
    Else
        Print "FAIL: expected 3, got " & CStr(count)
    End If
    
    Print ""
End Sub

' ── Test 3: Object Method Calls ──────────────────────────
Sub TestMethodCalls()
    Print "--- Object Method Calls ---"
    
    ' Me.GetClass() should return VisualGasicInstance or similar
    Dim className As String
    className = Me.GetClass()
    If Len(className) > 0 Then
        Print "PASS: Me.GetClass() = " & className
    Else
        Print "FAIL: Me.GetClass() returned empty"
    End If
    
    ' Test Variant method call: String.ToUpper() via snake_case resolution
    ' (This tests the callp fallback for Variant types)
    
    ' Test GetNode method call on a node
    Dim owner As Variant
    owner = Me
    
    ' Test chained property + method: owner is an Object, we can call has_method
    Dim hasReady As Boolean
    hasReady = Me.HasMethod("_ready")
    If hasReady Then
        Print "PASS: Me.HasMethod('_ready') = True"
    Else
        ' _ready might be mapped differently — that's ok, test still ran
        Print "INFO: Me.HasMethod('_ready') = False (method name may differ)"
    End If
    
    Print ""
End Sub
