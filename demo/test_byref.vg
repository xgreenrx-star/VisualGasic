' Test ByRef
Module TestByRef

Sub ModifyByRef(num As Integer)
    Print "Inside ModifyByRef: num = " + CStr(num)
    num = num * 2
    Print "After modify: num = " + CStr(num)
End Sub

Sub Main()
    Print "ByRef Test"
    
    Dim x As Integer
    x = 10
    Print "Before call: x = " + CStr(x)
    ModifyByRef(x)
    Print "After call: x = " + CStr(x)
    
    If x = 20 Then
        Print "PASS"
    Else
        Print "FAIL"
    End If
End Sub

End Module
