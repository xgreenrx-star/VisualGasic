' ============================================================================
' CALCULATOR - Classic Four-Function Calculator
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' A faithful recreation of classic calculator apps with full keyboard support
' ============================================================================
Attribute VB_Name = "Calculator"

' ---------------------------------------------------------------------------
' Display state — these six variables form the calculator's "state machine".
' Together they track what the user sees, the numeric value being entered,
' the first operand of a two-operand expression, the pending arithmetic
' operator, and two flags that control digit-entry behaviour.
' ---------------------------------------------------------------------------
Dim displayText As String         ' The string currently shown on the display (e.g. "123.45")
Dim currentValue As Double        ' Numeric value of displayText; kept in sync via Val()
								  ' Double gives ~15 digits of floating-point precision (VB6 idiom)
Dim storedValue As Double         ' The LEFT operand saved when the user presses an operator
								  ' e.g. in "5 + 3", storedValue holds 5 after "+" is pressed
Dim pendingOperation As String    ' The operator waiting to be applied ("+", "-", "*", "/", or "")
								  ' Empty string means no operation is pending
Dim clearOnNextDigit As Boolean   ' When True, the next digit typed replaces the display
								  ' instead of appending. Set after "=", an operator, or ClearAll.
Dim hasDecimalPoint As Boolean    ' Prevents a second decimal point from being entered

' ---------------------------------------------------------------------------
' Memory register — classic M+/M-/MR/MC support.
' The calculator keeps a single independent accumulator so the user can
' store and recall intermediate results without disturbing the main display.
' ---------------------------------------------------------------------------
Dim memoryValue As Double   ' The value stored in the memory register (M+ adds to it, M- subtracts)
Dim hasMemory As Boolean    ' True when memoryValue holds a meaningful value; drives the "M" indicator

' ---------------------------------------------------------------------------
' Button layout constants (for drawing the on-screen grid)
' The grid is 4 columns × 6 rows.  Each cell is 75 px wide (70 + 5 margin)
' and 55 px tall (50 + 5 margin), giving a 300 × 330 button area below
' the 80 px display, fitting inside a 320 × 480 virtual screen.
' ---------------------------------------------------------------------------
Const BUTTON_WIDTH As Integer = 70    ' Width of one standard button in pixels
Const BUTTON_HEIGHT As Integer = 50   ' Height of one standard button in pixels
Const BUTTON_MARGIN As Integer = 5    ' Gap between adjacent buttons
Const DISPLAY_HEIGHT As Integer = 80  ' Height of the top display area (number readout)

' ============================================================================
' INITIALIZATION
' ============================================================================
' _Ready() is called once by Godot when this node enters the scene tree.
' It is the VisualGasic equivalent of VB6's Form_Load event.
Sub _Ready()
	Print "Calculator Ready"   ' Debug message to Godot's Output panel
	ClearAll                    ' Reset every state variable to power-on defaults
End Sub

' ClearAll — "C" button or Escape key.  Resets the entire calculator to
' its initial state, including the pending operation and stored operand.
' This is the equivalent of "AC" (All Clear) on a physical calculator.
Sub ClearAll()
	displayText = "0"          ' Show "0" on the display
	currentValue = 0            ' Numeric value zeroed
	storedValue = 0             ' Left operand zeroed (clears pending expression)
	pendingOperation = ""       ' No operator pending
	clearOnNextDigit = True     ' Next digit replaces the "0" rather than appending
	hasDecimalPoint = False     ' No decimal point in the fresh display
End Sub

' ClearEntry — "CE" (Clear Entry).  Resets only the CURRENT entry while
' leaving storedValue and pendingOperation intact so the user can
' re-type the second operand without losing the first.
Sub ClearEntry()
	displayText = "0"          ' Reset display to "0"
	currentValue = 0            ' Zero the current operand
	clearOnNextDigit = True     ' Next digit replaces display
	hasDecimalPoint = False     ' Allow a new decimal point
End Sub

' ============================================================================
' INPUT HANDLING
' ============================================================================
' _Input() is Godot's per-frame input callback — it receives every
' unhandled input event (keyboard, mouse, touch, etc.).
' "event As Variant" is the VisualGasic way to accept any Godot InputEvent;
' we then use the VB6-style "Is" operator for runtime type checking.
Sub _Input(ev As Variant)
	If ev Is InputEventKey Then          ' VB6 idiom: type-check against Godot class
		If ev.pressed Then               ' Only act on key-DOWN, ignore key-UP
			HandleKeyPress ev.keycode     ' Dispatch the Godot KEY_* constant
		End If
	End If
End Sub

' HandleKeyPress — central keyboard dispatcher.  Uses VB6-style Select Case
' to map Godot KEY_* constants to calculator actions.  Each Case accepts
' BOTH the main keyboard key and the numeric-keypad equivalent (KEY_KP_*).
Sub HandleKeyPress(keycode As Integer)
	Select Case keycode
		' ---- Digit keys: main row 0-9 AND numeric keypad 0-9 ----
		Case KEY_0, KEY_KP_0
			InputDigit "0"
		Case KEY_1, KEY_KP_1
			InputDigit "1"
		Case KEY_2, KEY_KP_2
			InputDigit "2"
		Case KEY_3, KEY_KP_3
			InputDigit "3"
		Case KEY_4, KEY_KP_4
			InputDigit "4"
		Case KEY_5, KEY_KP_5
			InputDigit "5"
		Case KEY_6, KEY_KP_6
			InputDigit "6"
		Case KEY_7, KEY_KP_7
			InputDigit "7"
		Case KEY_8, KEY_KP_8
			InputDigit "8"
		Case KEY_9, KEY_KP_9
			InputDigit "9"
		
		' ---- Arithmetic operators: each stores the current value and sets
		'      the pending operation so Calculate() can evaluate later. ----
		Case KEY_PLUS, KEY_KP_ADD
			InputOperation "+"       ' Addition
		Case KEY_MINUS, KEY_KP_SUBTRACT
			InputOperation "-"       ' Subtraction
		Case KEY_ASTERISK, KEY_KP_MULTIPLY
			InputOperation "*"       ' Multiplication
		Case KEY_SLASH, KEY_KP_DIVIDE
			InputOperation "/"       ' Division
		
		' ---- Equals / Enter: evaluate the pending expression ----
		Case KEY_ENTER, KEY_KP_ENTER, KEY_EQUAL
			Calculate             ' Applies storedValue <op> currentValue
		
		' ---- Decimal point ----
		Case KEY_PERIOD, KEY_KP_PERIOD
			InputDecimal          ' Appends "." (only once per number)
		
		' ---- Clear / Backspace ----
		Case KEY_ESCAPE
			ClearAll              ' Full reset (AC)
		Case KEY_DELETE, KEY_BACKSPACE
			Backspace             ' Remove the last character from the display
		
		' ---- Percent — context-sensitive (see CalculatePercent) ----
		Case KEY_PERCENT
			CalculatePercent
	End Select
End Sub

' InputDigit — appends a single digit character ("0"–"9") to the display.
' Three state transitions are handled:
'   1. clearOnNextDigit=True  → replace display entirely (new number).
'   2. Display is "0" and digit isn't "0" → replace leading zero.
'   3. Otherwise → append digit (respecting 15-char max).
Sub InputDigit(digit As String)
	If clearOnNextDigit Then
		displayText = digit           ' Start a brand-new number
		clearOnNextDigit = False      ' Subsequent digits will APPEND
	Else
		If displayText = "0" And digit <> "0" Then
			displayText = digit       ' Replace the leading "0" (no "07" display)
		ElseIf displayText <> "0" Or hasDecimalPoint Then
			' Allow "0." followed by more digits (hasDecimalPoint guard)
			' Limit display length to 15 characters to avoid overflow
			If Len(displayText) < 15 Then
				displayText = displayText & digit  ' VB6 string concat with "&"
			End If
		End If
	End If
	currentValue = Val(displayText)   ' Val() converts string→Double (VB6 idiom)
End Sub

' InputDecimal — inserts a decimal point, ensuring at most one per number.
' If the display was about to be cleared (after "=" or an operator), we
' start a fresh "0." so the user can type something like ".5".
Sub InputDecimal()
	If clearOnNextDigit Then
		displayText = "0."        ' Begin a new fractional number
		clearOnNextDigit = False
		hasDecimalPoint = True    ' Lock out further decimal points
	ElseIf Not hasDecimalPoint Then
		displayText = displayText & "."  ' Append "." to existing number
		hasDecimalPoint = True
	End If
	' If hasDecimalPoint is already True, this Sub silently does nothing.
End Sub

' InputOperation — records an arithmetic operator ("+", "-", "*", "/").
' Supports CHAINED expressions: if the user types "2 + 3 + ..." the first
' "+" is evaluated before the second "+" is stored (operation chaining).
' This mirrors the behaviour of most physical calculators.
Sub InputOperation(op As String)
	' If an operator is already pending AND the user has entered new digits
	' (clearOnNextDigit is False), evaluate the pending expression first.
	If pendingOperation <> "" And Not clearOnNextDigit Then
		Calculate              ' Evaluate storedValue <op> currentValue
	End If
	
	storedValue = currentValue ' Save left operand for the upcoming calculation
	pendingOperation = op      ' Remember which operation to perform
	clearOnNextDigit = True    ' Next digit starts a fresh right operand
	hasDecimalPoint = False    ' Reset decimal flag for the new operand
End Sub

' Calculate — evaluates  storedValue <pendingOperation> currentValue
' and puts the result on the display.  Called when the user presses "="
' or chains a new operator (via InputOperation).
Sub Calculate()
	If pendingOperation = "" Then Exit Sub  ' Nothing to evaluate
	
	Dim result As Double   ' Holds the computed result (Double precision)
	
	' Dispatch on the stored operator string — classic VB6 Select Case
	Select Case pendingOperation
		Case "+"
			result = storedValue + currentValue
		Case "-"
			result = storedValue - currentValue
		Case "*"
			result = storedValue * currentValue
		Case "/"
			' Guard against divide-by-zero: show "Error" and reset
			If currentValue = 0 Then
				displayText = "Error"
				ClearAll               ' Reset internal state to safe defaults
				displayText = "Error"  ' Re-set display AFTER ClearAll overwrote it
				Return                 ' Early exit — nothing more to do
			End If
			result = storedValue / currentValue
	End Select
	
	currentValue = result                       ' Update the live numeric value
	displayText = FormatNumber(result)           ' Pretty-print the result
	pendingOperation = ""                        ' Expression fully evaluated
	clearOnNextDigit = True                      ' Next digit starts a new number
	hasDecimalPoint = InStr(displayText, ".") > 0  ' InStr()>0 ⇒ string contains "."
End Sub

' CalculatePercent — context-sensitive percentage:
'   • WITH a pending operation  → treats currentValue as a percentage of
'     storedValue.  E.g. "200 + 10 %" → currentValue becomes 20 (10% of 200)
'     so the subsequent Calculate() yields 220.
'   • WITHOUT a pending operation → simply divides by 100.
'     E.g. "50 %" → 0.5.
Sub CalculatePercent()
	If pendingOperation <> "" Then
		' Percentage OF the stored operand (standard calculator convention)
		currentValue = storedValue * (currentValue / 100)
	Else
		' Standalone percent: just convert to a fraction
		currentValue = currentValue / 100
	End If
	displayText = FormatNumber(currentValue)  ' Update the display string
	clearOnNextDigit = True                   ' Next digit replaces result
End Sub

' Backspace — removes the rightmost character from the display string.
' Uses VB6 string functions: Right() to peek at the last char, Left()
' to trim it off, and Len() to measure the string length.
Sub Backspace()
	' Only act if the user is actively entering a number (not after "=")
	If Not clearOnNextDigit And Len(displayText) > 0 Then
		Dim lastChar As String
		lastChar = Right(displayText, 1)   ' Peek at the character being removed
		
		' If we're deleting the decimal point, re-allow a future decimal
		If lastChar = "." Then
			hasDecimalPoint = False
		End If
		
		' Chop off the last character using Left()
		displayText = Left(displayText, Len(displayText) - 1)
		
		' If nothing is left (or just a minus sign), reset to "0"
		If displayText = "" Or displayText = "-" Then
			displayText = "0"
			clearOnNextDigit = True
		End If
		
		currentValue = Val(displayText)  ' Keep numeric value in sync
	End If
End Sub

' FormatNumber — converts a Double to a clean display string.
' Str() (VB6 idiom) gives the raw decimal representation, then we strip
' ugly trailing zeros (e.g. "3.10000" → "3.1", "4.00" → "4").
' Returns a max-15-character string to fit the calculator display.
Function FormatNumber(value As Double) As String
	Dim result As String
	result = Str(value)          ' VB6-style Double→String conversion
	
	' --- Trailing-zero removal ---
	' Only relevant if the string contains a decimal point.
	If InStr(result, ".") > 0 Then              ' InStr() returns position (>0 = found)
		Do While Right(result, 1) = "0"          ' Strip trailing "0"s one at a time
			result = Left(result, Len(result) - 1)
		Loop
		' If only the "." remains (e.g. "7."), strip that too → "7"
		If Right(result, 1) = "." Then
			result = Left(result, Len(result) - 1)
		End If
	End If
	
	' Clamp to 15 characters so the display doesn't overflow
	If Len(result) > 15 Then
		result = Left(result, 15)
	End If
	
	Return result
End Function

' ============================================================================
' MEMORY FUNCTIONS
' ============================================================================
' MC — Memory Clear: zeroes the memory register and hides the "M" indicator.
Sub MemoryClear()
	memoryValue = 0
	hasMemory = False     ' Clears the "M" indicator on the display
End Sub

' MR — Memory Recall: loads the stored memory value into the display.
Sub MemoryRecall()
	currentValue = memoryValue                  ' Overwrite current operand
	displayText = FormatNumber(memoryValue)      ' Show formatted value
	clearOnNextDigit = True                      ' Next digit starts fresh entry
End Sub

' M+ — Memory Add: adds the current display value to the memory register.
Sub MemoryAdd()
	memoryValue = memoryValue + currentValue   ' Accumulate into memory
	hasMemory = True                           ' Show "M" indicator
	clearOnNextDigit = True
End Sub

' M- — Memory Subtract: subtracts the current display value from memory.
Sub MemorySubtract()
	memoryValue = memoryValue - currentValue   ' Decrease memory register
	hasMemory = True                           ' Show "M" indicator
	clearOnNextDigit = True
End Sub

' ============================================================================
' RENDERING
' ============================================================================
' _Draw() — Godot calls this every frame to repaint the node.
' VisualGasic wraps Godot's CanvasItem drawing API so you can use
' DrawRect(x, y, w, h, color) and DrawString(text, x, y, color, size)
' directly, much like VB6's Line and Print methods.
Sub _Draw()
	' Virtual screen size — fits a portrait calculator layout
	Dim screenWidth As Integer = 320
	Dim screenHeight As Integer = 480
	
	' --- Full-screen dark background ---
	DrawRect 0, 0, screenWidth, screenHeight, Color("#2D2D2D")
	'       Color("#hex") creates a Godot Color from a hex string
	
	' --- Display area: dark inset rectangle at the top ---
	DrawRect 10, 10, screenWidth - 20, DISPLAY_HEIGHT, Color("#1A1A1A")
	
	' --- Display text: right-aligned inside the display area ---
	' We approximate pixel width as Len * 18 to position the string
	' flush with the right edge (true right-alignment would need font metrics).
	Dim fontSize As Integer = 32
	Dim textWidth As Integer = Len(displayText) * 18  ' Rough glyph-width estimate
	DrawString displayText, screenWidth - 20 - textWidth, 45, Color.White, fontSize
	
	' --- Pending-operation indicator (top-left of display) ---
	' Shows "+", "-", "*", or "/" in dim grey so the user knows
	' an operator is waiting for the second operand.
	If pendingOperation <> "" Then
		DrawString pendingOperation, 20, 30, Color("#888888"), 20
	End If
	
	' --- Memory indicator: small "M" below the operator indicator ---
	If hasMemory Then
		DrawString "M", 20, 55, Color("#888888"), 16
	End If
	
	' --- Draw the full 4×6 button grid below the display ---
	DrawButtons
End Sub

' DrawButtons — renders the 4-column × 6-row button grid.
' Column stride = 75 px (BUTTON_WIDTH 70 + BUTTON_MARGIN 5).
' Row stride   = 55 px (BUTTON_HEIGHT 50 + 5 px gap).
' Colors follow a typical calculator theme:
'   #505050  — dark grey for digits and memory keys
'   #D4D4D2  — light grey for function keys (C, +/-, %)
'   #FF9F0A  — orange for operator keys (+, -, *, /, =)
Sub DrawButtons()
	Dim startY As Integer = DISPLAY_HEIGHT + 20   ' Y origin just below the display
	Dim startX As Integer = 10                    ' X origin (10 px left margin)
	
	' ---- Row 0: Memory keys (MC, MR, M+, M-) — dark grey ----
	DrawButton "MC", startX, startY, 1, Color("#505050")
	DrawButton "MR", startX + 75, startY, 1, Color("#505050")
	DrawButton "M+", startX + 150, startY, 1, Color("#505050")
	DrawButton "M-", startX + 225, startY, 1, Color("#505050")
	
	' ---- Row 1: Function row — C (clear), +/- (negate), % (percent),
	'      / (divide). Light grey for functions, orange for the operator. ----
	startY = startY + 55                                     ' Advance to next row
	DrawButton "C", startX, startY, 1, Color("#D4D4D2")     ' All Clear
	DrawButton "+/-", startX + 75, startY, 1, Color("#D4D4D2")  ' Toggle positive/negative
	DrawButton "%", startX + 150, startY, 1, Color("#D4D4D2")   ' Percent
	DrawButton "/", startX + 225, startY, 1, Color("#FF9F0A")   ' Divide (orange)
	
	' ---- Row 2: Digits 7-8-9 and multiply ----
	startY = startY + 55
	DrawButton "7", startX, startY, 1, Color("#505050")
	DrawButton "8", startX + 75, startY, 1, Color("#505050")
	DrawButton "9", startX + 150, startY, 1, Color("#505050")
	DrawButton "*", startX + 225, startY, 1, Color("#FF9F0A")   ' Multiply (orange)
	
	' ---- Row 3: Digits 4-5-6 and subtract ----
	startY = startY + 55
	DrawButton "4", startX, startY, 1, Color("#505050")
	DrawButton "5", startX + 75, startY, 1, Color("#505050")
	DrawButton "6", startX + 150, startY, 1, Color("#505050")
	DrawButton "-", startX + 225, startY, 1, Color("#FF9F0A")   ' Subtract (orange)
	
	' ---- Row 4: Digits 1-2-3 and add ----
	startY = startY + 55
	DrawButton "1", startX, startY, 1, Color("#505050")
	DrawButton "2", startX + 75, startY, 1, Color("#505050")
	DrawButton "3", startX + 150, startY, 1, Color("#505050")
	DrawButton "+", startX + 225, startY, 1, Color("#FF9F0A")   ' Add (orange)
	
	' ---- Row 5: Bottom row — "0" spans two columns (DrawButtonWide),
	'      "." for decimal, and "=" (orange) to evaluate. ----
	startY = startY + 55
	DrawButtonWide "0", startX, startY, Color("#505050")         ' Double-wide zero
	DrawButton ".", startX + 150, startY, 1, Color("#505050")   ' Decimal point
	DrawButton "=", startX + 225, startY, 1, Color("#FF9F0A")   ' Equals (orange)
End Sub

' DrawButton — renders a single button occupying `cols` columns.
' bgColor is typed As Variant because Color() returns a Godot Color object.
' Text is roughly centred: Len(text)*8 approximates half the pixel width.
Sub DrawButton(text As String, x As Integer, y As Integer, cols As Integer, bgColor As Variant)
	' Calculate pixel width — supports multi-column buttons via `cols`
	Dim width As Integer = BUTTON_WIDTH * cols + BUTTON_MARGIN * (cols - 1)
	
	' Draw a filled rectangle for the button face (no true rounded corners
	' in the basic DrawRect API, but the flat look works fine)
	DrawRect x, y, width, BUTTON_HEIGHT, bgColor
	
	' Centre the label text horizontally and vertically inside the button
	Dim textX As Integer = x + width / 2 - Len(text) * 8   ' Rough horizontal centre
	Dim textY As Integer = y + BUTTON_HEIGHT / 2 - 10       ' Rough vertical centre
	DrawString text, textX, textY, Color.White, 24           ' White text, 24 pt
End Sub

' DrawButtonWide — draws a double-width button (spans 2 columns).
' Used exclusively for the "0" key on the bottom row.
' Text is left-aligned (offset 30 px) rather than centred, matching
' the macOS/iOS calculator aesthetic.
Sub DrawButtonWide(text As String, x As Integer, y As Integer, bgColor As Variant)
	Dim width As Integer = BUTTON_WIDTH * 2 + BUTTON_MARGIN  ' 70*2 + 5 = 145 px
	
	DrawRect x, y, width, BUTTON_HEIGHT, bgColor
	
	Dim textX As Integer = x + 30                             ' Left-biased alignment
	Dim textY As Integer = y + BUTTON_HEIGHT / 2 - 10
	DrawString text, textX, textY, Color.White, 24
End Sub

' ============================================================================
' MOUSE INPUT (for clicking buttons)
' ============================================================================
' _UnhandledInput() receives events NOT consumed by _Input() or GUI nodes.
' We use it for mouse clicks so keyboard and mouse don't interfere.
' "event Is InputEventMouseButton" is the VB6-style type check for clicks.
Sub _UnhandledInput(ev As Variant)
	If ev Is InputEventMouseButton Then
		' Only respond to LEFT mouse button PRESS (not release)
		If ev.pressed And ev.button_index = MOUSE_BUTTON_LEFT Then
			HandleMouseClick ev.position.x, ev.position.y
		End If
	End If
End Sub

' HandleMouseClick — converts a pixel coordinate (mx, my) into a grid
' row/col index and dispatches the corresponding calculator action.
' The grid starts at (startX=10, startY=DISPLAY_HEIGHT+20) and each
' cell is 75 px wide × 55 px tall, giving a simple integer-division
' hit test.  No per-button bounding boxes needed!
Sub HandleMouseClick(mx As Single, my As Single)
	Dim startY As Integer = DISPLAY_HEIGHT + 20   ' Must match DrawButtons()
	Dim startX As Integer = 10
	Dim row As Integer      ' 0–5 (top to bottom)
	Dim col As Integer      ' 0–3 (left to right)
	
	' Integer-division hit detection: convert pixel offset to grid index
	row = Int((my - startY) / 55)   ' 55 = BUTTON_HEIGHT (50) + 5 px gap
	col = Int((mx - startX) / 75)   ' 75 = BUTTON_WIDTH (70)  + 5 px gap
	
	' Bounds check — ignore clicks outside the 6×4 button grid
	If row < 0 Or row > 5 Or col < 0 Or col > 3 Then Exit Sub
	
	' ---- Nested Select Case: outer = row, inner = column ----
	' Each Case mirrors the DrawButtons() layout exactly.
	Select Case row
		Case 0  ' Row 0 — Memory: MC | MR | M+ | M-
			Select Case col
				Case 0: MemoryClear
				Case 1: MemoryRecall
				Case 2: MemoryAdd
				Case 3: MemorySubtract
			End Select
		Case 1  ' Row 1 — Functions: C | +/- | % | /
			Select Case col
				Case 0: ClearAll
				Case 1: ToggleSign          ' Negate the current value
				Case 2: CalculatePercent
				Case 3: InputOperation "/"
			End Select
		Case 2  ' Row 2 — Digits: 7 | 8 | 9 | *
			Select Case col
				Case 0: InputDigit "7"
				Case 1: InputDigit "8"
				Case 2: InputDigit "9"
				Case 3: InputOperation "*"
			End Select
		Case 3  ' Row 3 — Digits: 4 | 5 | 6 | -
			Select Case col
				Case 0: InputDigit "4"
				Case 1: InputDigit "5"
				Case 2: InputDigit "6"
				Case 3: InputOperation "-"
			End Select
		Case 4  ' Row 4 — Digits: 1 | 2 | 3 | +
			Select Case col
				Case 0: InputDigit "1"
				Case 1: InputDigit "2"
				Case 2: InputDigit "3"
				Case 3: InputOperation "+"
			End Select
		Case 5  ' Row 5 — Bottom: 0 (cols 0-1) | . | =
			Select Case col
				Case 0, 1: InputDigit "0"   ' "0" is double-wide, so cols 0 AND 1 map to it
				Case 2: InputDecimal
				Case 3: Calculate
			End Select
	End Select
End Sub

' ToggleSign — the "+/-" button: flips the sign of the current value.
' Does nothing when the display is zero (negative zero is not useful).
Sub ToggleSign()
	If currentValue <> 0 Then
		currentValue = -currentValue              ' Negate the numeric value
		displayText = FormatNumber(currentValue)  ' Update the display string
	End If
End Sub
