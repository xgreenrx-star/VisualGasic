' ============================================================================
' PARALLEL PROCESSING DEMO - Multitasking Demo
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' Demonstrates:
' - Parallel For loops
' - Task.Run for async operations
' - Await for task completion
' - Thread-safe operations
' - Visual comparison: Serial vs Parallel
' ============================================================================
' VB6 attribute — sets the class/module name exposed to Godot's scene tree.
' In VB6 this lived in the .frm header; VisualGasic keeps the syntax for familiarity.
Attribute VB_Name = "ParallelDemo"

' Screen dimensions used for particle bounds-checking and UI layout.
' These are logical coordinates passed to VisualGasic's Draw* helpers, which
' map to Godot's CanvasItem drawing in the _Draw() callback.
Const SCREEN_WIDTH As Integer = 800
Const SCREEN_HEIGHT As Integer = 600

' Particle systems for visual demonstration
' 500 particles give a visually dense scene while remaining fast enough
' to see the Serial-vs-Parallel performance difference.
Const MAX_PARTICLES As Integer = 500

' Type … End Type  — VisualGasic's user-defined struct (UDT).
' Classic VB6 syntax.  At runtime each instance becomes a Godot Dictionary
' with keys matching the field names, so particles(0).X is really
' particles[0]["X"].  This gives VB6 dot-access while leveraging Godot's
' Variant system under the hood.
Type Particle
    X As Single          ' Horizontal position (pixels)
    Y As Single          ' Vertical position (pixels)
    VelX As Single       ' Horizontal velocity (pixels/sec)
    VelY As Single       ' Vertical velocity (pixels/sec)
    Color As Variant     ' Godot Color object — stored as Variant because
                         '   Color is not a VB6 primitive type
    Life As Single       ' Remaining lifetime in seconds; resets on expiry
    Size As Single       ' Radius for DrawCircle (pixels)
    Active As Boolean    ' Whether the particle should be updated/drawn
End Type

' Dim array(N) As <UDT>  — allocates a fixed-size array of struct instances.
' VisualGasic initialises every element from the Type prototype, so each
' particles(i) is already a valid Dictionary with all fields set to defaults.
Dim particles(MAX_PARTICLES) As Particle

' ---- Work-load simulation variables ----------------------------------------
' WORK_ITEMS controls how many CPU-intensive tasks to run.
Const WORK_ITEMS As Integer = 100
Dim workResults(WORK_ITEMS) As Integer  ' Stores each task's computed result
Dim serialTime As Single               ' Elapsed time for the serial run (seconds)
Dim parallelTime As Single             ' Elapsed time for the parallel run (seconds)
Dim isProcessing As Boolean            ' True while any benchmark is running
Dim processingMode As String           ' "serial" or "parallel" — shown in the UI
Dim workProgress As Integer            ' Number of tasks finished so far (for progress bar)
Dim workComplete As Boolean            ' Flipped True by the Whenever callback when done

' ---- Prime-number sieve variables ------------------------------------------
Dim primeResults(1000) As Integer  ' Buffer holding discovered primes (up to 1000)
Dim primeCount As Integer          ' How many primes have been found so far
Dim primeLimit As Integer = 10000  ' Upper bound of the search range (2..primeLimit)

' ---- Task-tracking counters ------------------------------------------------
' These are shared across threads, so any writes inside a Parallel For
' must be wrapped in Lock … Unlock to avoid data races.
Dim activeTasks As Integer       ' Tasks still running (decremented on completion)
Dim completedTasks As Integer    ' Tasks finished (incremented; triggers Whenever)
Dim totalTasks As Integer        ' Total tasks expected (used for % calculation)

' ---- UI state --------------------------------------------------------------
Dim selectedDemo As Integer      ' Active demo page: 0=Particles, 1=WorkLoad, 2=Primes
Dim demoNames(3) As String       ' Human-readable labels for each demo page

' ---- Whenever Section — VisualGasic's reactive-programming feature ---------
' Syntax:  Whenever Section <name> <variable> <condition> <callback>
'
' "Changes"    — fires every time the variable's value changes.
' "Becomes <v>" — fires only when the variable equals <v>.
'
' Under the hood VisualGasic polls these variables each frame (or after
' Lock/Unlock releases) and invokes the callback Sub automatically.
' Think of it as a lightweight observable / signal — very handy for
' progress reporting without manually checking flags in _Process().
Whenever Section TaskProgress completedTasks Changes OnTaskProgress
Whenever Section TaskComplete activeTasks Becomes 0 OnAllTasksComplete

' ============================================================================
' WHENEVER CALLBACKS
' ============================================================================
' Called automatically every time completedTasks changes value.
' Max(totalTasks, 1) avoids division-by-zero when no work is queued.
' Print writes to Godot's Output panel (like GD.print).
Sub OnTaskProgress()
    Dim pct As Integer = Int(completedTasks / Max(totalTasks, 1) * 100)
    Print "Task progress: " & Str(pct) & "% (" & Str(completedTasks) & "/" & Str(totalTasks) & ")"
End Sub

' Called when activeTasks drops to exactly 0 (all workers done).
' The guard "If totalTasks > 0" prevents a false trigger at startup
' when activeTasks is initialised to 0.
Sub OnAllTasksComplete()
    If totalTasks > 0 Then
        Print "All tasks completed!"
        workComplete = True
    End If
End Sub

' ============================================================================
' INITIALIZATION
' ============================================================================
' _Ready() — Godot lifecycle callback, called once when the node enters
' the scene tree.  Equivalent to _ready() in GDScript.
' VisualGasic maps Sub names starting with "_" to Godot virtual methods.
Sub _Ready()
    ' Print instructions to Godot's Output panel so the user knows the
    ' key bindings even before the UI renders.
    Print "=== PARALLEL PROCESSING DEMO ==="
    Print "Demonstrates VisualGasic's Multitasking Features"
    Print ""
    Print "1 = Particle Physics Demo"
    Print "2 = Work Load Comparison"
    Print "3 = Prime Number Calculation"
    Print ""
    
    ' Populate the label array used by _Draw() to display the active demo name.
    demoNames(0) = "Particle Physics"
    demoNames(1) = "Work Load Comparison"
    demoNames(2) = "Prime Calculation"
    
    ' Randomise all 500 particles so the demo has content immediately.
    InitializeParticles
    selectedDemo = 0   ' Start on the Particle Physics page
End Sub

' Iterate every particle slot and give it a random starting state.
' VB6 arrays are 0-based here (VisualGasic supports both conventions).
Sub InitializeParticles()
    Dim i As Integer
    For i = 0 To MAX_PARTICLES - 1
        ResetParticle i
    Next
End Sub

' (Re)spawn a single particle with random position, velocity, lifetime,
' and color.  Called at initialisation and whenever a particle's Life <= 0.
Sub ResetParticle(index As Integer)
    ' Rnd() returns a Single in [0, 1) — classic VB6 random function.
    particles(index).X = Rnd() * SCREEN_WIDTH          ' Random X across screen
    particles(index).Y = Rnd() * SCREEN_HEIGHT         ' Random Y across screen
    particles(index).VelX = (Rnd() - 0.5) * 200        ' -100..+100 px/sec
    particles(index).VelY = (Rnd() - 0.5) * 200        ' -100..+100 px/sec
    particles(index).Life = Rnd() * 3 + 1              ' 1–4 seconds
    particles(index).Size = Rnd() * 8 + 2              ' Radius 2–10 px
    particles(index).Active = True
    
    ' Color(r, g, b) wraps Godot's Color constructor.
    ' Each channel is 0.0–1.0.  Alpha defaults to 1.0 (opaque).
    particles(index).Color = Color(Rnd(), Rnd(), Rnd())
End Sub

' ============================================================================
' PARTICLE PHYSICS - Parallel Update
' ============================================================================
' Serial (single-threaded) particle update — plain VB6 For loop.
' Every iteration runs on the main thread, one after another.
' delta is the frame time in seconds (passed from Godot's _Process).
Sub UpdateParticlesSerial(delta As Single)
    ' Traditional serial loop
    Dim i As Integer
    For i = 0 To MAX_PARTICLES - 1
        UpdateSingleParticle i, delta
    Next
End Sub

' Parallel (multi-threaded) particle update.
' "Parallel For … Next" is VisualGasic syntax — the runtime splits
' the iteration range across all available CPU cores automatically.
' Each thread gets its own slice of indices (e.g., core 0 → 0..124,
' core 1 → 125..249, etc.).  Because every particle is independent
' (no shared writes), no Lock is needed here.
Sub UpdateParticlesParallel(delta As Single)
    ' Parallel For — note the inline "i As Integer" declaration.
    ' This is required so each thread gets its own loop variable.
    Parallel For i As Integer = 0 To MAX_PARTICLES - 1
        UpdateSingleParticle i, delta
    Next
End Sub

' Update one particle's physics for a single frame.
' This sub is called from both the serial and parallel loops.
' It is intentionally stateless w.r.t. other particles, which makes
' it safe to execute concurrently without locks.
Sub UpdateSingleParticle(index As Integer, delta As Single)
    ' Exit Sub is VB6 for early return — skip inactive particles.
    If Not particles(index).Active Then Exit Sub
    
    ' --- Euler integration: position += velocity * dt ----------------------
    particles(index).X = particles(index).X + particles(index).VelX * delta
    particles(index).Y = particles(index).Y + particles(index).VelY * delta
    
    ' --- Gravity: accelerate downward at 150 px/s² ------------------------
    particles(index).VelY = particles(index).VelY + 150 * delta
    
    ' --- Wall collision: reverse velocity and apply 0.8 damping -----------
    ' Clamp() is a VisualGasic built-in wrapping Godot's clampf().
    If particles(index).X < 0 Or particles(index).X > SCREEN_WIDTH Then
        particles(index).VelX = -particles(index).VelX * 0.8   ' 20% energy loss
        particles(index).X = Clamp(particles(index).X, 0, SCREEN_WIDTH)
    End If
    
    If particles(index).Y < 0 Or particles(index).Y > SCREEN_HEIGHT Then
        particles(index).VelY = -particles(index).VelY * 0.8   ' 20% energy loss
        particles(index).Y = Clamp(particles(index).Y, 0, SCREEN_HEIGHT)
    End If
    
    ' --- Lifetime: count down and respawn when expired ---------------------
    particles(index).Life = particles(index).Life - delta
    If particles(index).Life <= 0 Then
        ResetParticle index   ' Respawn at a new random position/velocity
    End If
End Sub

' ============================================================================
' WORK LOAD COMPARISON
' ============================================================================
' Run all WORK_ITEMS tasks sequentially on the main thread.
' This is the "baseline" — the user runs this first, then runs the
' parallel version to see the speedup ratio.
Sub RunSerialWorkLoad()
    ' Guard flags prevent re-entrant launches while already running.
    isProcessing = True
    processingMode = "serial"
    workProgress = 0
    workComplete = False
    totalTasks = WORK_ITEMS
    completedTasks = 0
    activeTasks = WORK_ITEMS
    
    ' Time() returns milliseconds since engine start (like OS.get_ticks_msec).
    Dim startTime As Single = Time()
    
    ' Serial processing — one task at a time, no threading.
    ' No Lock needed because we're single-threaded.
    Dim i As Integer
    For i = 0 To WORK_ITEMS - 1
        workResults(i) = SimulateHeavyWork(i)   ' CPU-bound computation
        workProgress = i + 1                     ' Update progress counter
        completedTasks = completedTasks + 1      ' Triggers Whenever callback
        activeTasks = activeTasks - 1            ' Triggers Whenever when → 0
    Next
    
    ' Convert ms → seconds for display.
    serialTime = (Time() - startTime) / 1000.0
    
    isProcessing = False
    Print "Serial completed in " & Format(serialTime, "0.000") & " seconds"
End Sub

' Run the same WORK_ITEMS tasks but distributed across CPU cores.
' Compare parallelTime against serialTime to show the speedup.
Sub RunParallelWorkLoad()
    isProcessing = True
    processingMode = "parallel"
    workProgress = 0
    workComplete = False
    totalTasks = WORK_ITEMS
    completedTasks = 0
    activeTasks = WORK_ITEMS
    
    Dim startTime As Single = Time()
    
    ' Parallel For — the runtime automatically divides iterations across
    ' available CPU cores (e.g., 100 items on 8 cores ≈ 12–13 items each).
    ' workResults(i) is safe WITHOUT a lock because each thread writes to
    ' a unique index — no two threads ever touch the same slot.
    Parallel For i As Integer = 0 To WORK_ITEMS - 1
        workResults(i) = SimulateHeavyWork(i)
        
        ' Lock … Unlock — VisualGasic's mutex.  Wraps Godot's Mutex class.
        ' All code between Lock and Unlock executes atomically — only one
        ' thread may enter at a time.  REQUIRED here because workProgress,
        ' completedTasks, and activeTasks are shared counters that multiple
        ' threads increment/decrement concurrently.
        Lock
            workProgress = workProgress + 1
            completedTasks = completedTasks + 1   ' Fires Whenever callback
            activeTasks = activeTasks - 1         ' When 0 → OnAllTasksComplete
        Unlock
    Next
    
    parallelTime = (Time() - startTime) / 1000.0
    
    isProcessing = False
    Print "Parallel completed in " & Format(parallelTime, "0.000") & " seconds"
    
    ' Speedup = serial_time / parallel_time.  Ideally equals the core count,
    ' but overhead (locking, scheduling) lowers it in practice.
    If parallelTime > 0 Then
        Dim speedup As Single = serialTime / parallelTime
        Print "Speedup: " & Format(speedup, "0.00") & "x faster"
    End If
End Sub

' Synthetic CPU-bound workload.  Each call performs 10,000 multiply-mod
' operations so the task takes measurable time — enough to show a real
' difference between serial and parallel execution.
' 997 is prime, so (j * index) Mod 997 produces a varied, non-trivial result.
Function SimulateHeavyWork(index As Integer) As Integer
    Dim result As Integer = 0
    Dim j As Integer
    
    For j = 1 To 10000
        result = result + (j * index) Mod 997  ' Accumulate modular products
    Next
    
    Return result   ' VB6-style Return (VisualGasic also supports FunctionName = value)
End Function

' ============================================================================
' PRIME NUMBER CALCULATION
' ============================================================================
' Trial-division prime search: test every integer 2..primeLimit on ONE thread.
' Simple but slow — O(n√n).  Used as the serial baseline.
Sub CalculatePrimesSerial()
    isProcessing = True
    processingMode = "serial"
    primeCount = 0
    totalTasks = primeLimit
    completedTasks = 0
    
    Dim startTime As Single = Time()
    
    ' Straightforward linear scan — easy to understand, easy to parallelise.
    Dim n As Integer
    For n = 2 To primeLimit
        If IsPrime(n) Then
            primeResults(primeCount) = n      ' Append to results buffer
            primeCount = primeCount + 1
        End If
        completedTasks = n                    ' Drives the progress bar in _Draw()
    Next
    
    serialTime = (Time() - startTime) / 1000.0
    isProcessing = False
    
    ' Str() converts Integer → String; Format() applies a numeric format mask.
    Print "Serial: Found " & Str(primeCount) & " primes in " & Format(serialTime, "0.000") & "s"
End Sub

' Parallel prime search — divides the search range into batches of 100
' and distributes batches across CPU cores.  Each batch is an inner
' serial loop, which amortises the Parallel For scheduling overhead.
Sub CalculatePrimesParallel()
    isProcessing = True
    processingMode = "parallel"
    primeCount = 0
    totalTasks = primeLimit
    completedTasks = 0
    
    Dim startTime As Single = Time()
    
    ' Batching strategy: instead of parallelising 10,000 individual checks
    ' (too much overhead), group them into 100-number chunks.
    Dim batchSize As Integer = 100
    Dim numBatches As Integer = primeLimit / batchSize   ' = 100 batches
    
    ' Outer loop runs in parallel; inner loop runs serially within each batch.
    Parallel For batch As Integer = 0 To numBatches - 1
        ' Compute the inclusive range [startN, endN] for this batch.
        ' +2 accounts for the fact that primes start at 2.
        Dim startN As Integer = batch * batchSize + 2
        Dim endN As Integer = Min((batch + 1) * batchSize + 1, primeLimit)
        
        Dim n As Integer
        For n = startN To endN
            If IsPrime(n) Then
                ' Lock is required here because primeResults and primeCount
                ' are shared — two threads could find primes simultaneously.
                Lock
                    primeResults(primeCount) = n
                    primeCount = primeCount + 1
                Unlock
            End If
        Next
        
        ' Update progress counter (also shared → needs Lock).
        Lock
            completedTasks = completedTasks + batchSize
        Unlock
    Next
    
    parallelTime = (Time() - startTime) / 1000.0
    isProcessing = False
    
    Print "Parallel: Found " & Str(primeCount) & " primes in " & Format(parallelTime, "0.000") & "s"
End Sub

' Classic trial-division primality test.
' Only needs to check odd divisors up to √n (Sqr is VB6 for square root).
' This function is pure (no side effects) so it's perfectly thread-safe
' and can be called from inside a Parallel For without locks.
Function IsPrime(n As Integer) As Boolean
    If n < 2 Then Return False       ' 0 and 1 are not prime
    If n = 2 Then Return True        ' 2 is the only even prime
    If n Mod 2 = 0 Then Return False ' Eliminate all other even numbers
    
    ' Check odd divisors 3, 5, 7, … up to √n.
    ' "Step 2" skips even candidates (VB6 For…Step syntax).
    Dim i As Integer
    For i = 3 To Int(Sqr(n)) Step 2
        If n Mod i = 0 Then Return False
    Next
    
    Return True  ' No divisor found — n is prime
End Function

' ============================================================================
' ASYNC TASK EXAMPLE
' ============================================================================
' Demonstrates "fire-and-forget" async execution.
' Task Run <name> … End Task  spawns a background thread.
' The main thread does NOT block — it continues to the next Print immediately.
Sub RunAsyncTask()
    Print "Starting async task..."
    
    ' Task Run <label> — all code between here and End Task runs on a
    ' background thread.  "AsyncWork" is a user-chosen label (like a
    ' task handle) that can be referenced later with Task Wait.
    Task Run AsyncWork
        Dim i As Integer
        For i = 1 To 5
            Print "Async work step " & Str(i)
            Sleep 500  ' Sleep pauses THIS thread for 500 ms, not the main thread
        Next
        Print "Async task completed!"
    End Task
    
    ' This line executes IMMEDIATELY, while AsyncWork is still running.
    Print "Main thread continues immediately..."
End Sub

' Demonstrates Task Wait — blocks the caller until the named task finishes.
' Useful when you need the result before proceeding.
Sub RunAwaitedTask()
    Print "Starting awaited task..."
    
    ' Spawn a background task that sums integers 1..1,000,000.
    ' Uses Gauss-level iteration for demo purposes (a formula would be
    ' instant, but the loop shows measurable async work).
    Task Run SumTask
        Dim sum As Integer = 0
        Dim i As Integer
        For i = 1 To 1000000
            sum = sum + i
        Next
        Print "Awaited result: " & Str(sum)   ' Prints from the worker thread
    End Task
    
    ' Task Wait <label> — BLOCKS the calling thread until "SumTask" finishes.
    ' After this line, the task's side effects (Print above) are guaranteed
    ' to have completed.
    Task Wait SumTask
    Print "Sum task completed!"
End Sub

' ============================================================================
' INPUT HANDLING
' ============================================================================
' _Process(delta) — Godot's per-frame callback (like _process in GDScript).
' "delta" is the time since the last frame in seconds.
' Called every frame (~60 Hz), so keep it fast.
Sub _Process(delta As Single)
    HandleInput
    
    ' Select Case … End Select — VB6 equivalent of GDScript's match/switch.
    Select Case selectedDemo
        Case 0
            ' Particle demo: hold SPACE for the parallel codepath,
            ' release for serial.  The user can feel the difference
            ' if MAX_PARTICLES is high enough to tax one core.
            If Input.IsKeyPressed(KEY_SPACE) Then
                UpdateParticlesParallel delta
            Else
                UpdateParticlesSerial delta
            End If
    End Select
End Sub

' Poll keyboard input each frame.  VisualGasic wraps Godot's Input singleton
' so the API looks just like GDScript (Input.IsKeyPressed, etc.).
Sub HandleInput()
    ' "ui_accept" is Godot's built-in action mapped to Enter/Space.
    ' IsActionJustPressed fires only on the frame the key goes down.
    If Input.IsActionJustPressed("ui_accept") Then
        Select Case selectedDemo
            Case 1  ' Work Load — run serial first, then parallel on next press
                If Not isProcessing Then
                    If serialTime = 0 Then
                        RunSerialWorkLoad       ' First press → serial baseline
                    Else
                        RunParallelWorkLoad     ' Second press → parallel comparison
                    End If
                End If
            Case 2  ' Primes — same serial-then-parallel pattern
                If Not isProcessing Then
                    If serialTime = 0 Then
                        CalculatePrimesSerial
                    Else
                        CalculatePrimesParallel
                    End If
                End If
        End Select
    End If
    
    ' Number keys 1/2/3 switch between demo pages and reset timers.
    If Input.IsKeyPressed(KEY_1) Then
        selectedDemo = 0
        serialTime = 0
        parallelTime = 0
    End If
    If Input.IsKeyPressed(KEY_2) Then
        selectedDemo = 1
        serialTime = 0
        parallelTime = 0
    End If
    If Input.IsKeyPressed(KEY_3) Then
        selectedDemo = 2
        serialTime = 0
        parallelTime = 0
    End If
    
    ' A / W keys trigger the async task demos (work on any demo page).
    If Input.IsKeyPressed(KEY_A) Then RunAsyncTask
    If Input.IsKeyPressed(KEY_W) Then RunAwaitedTask
    
    ' R = reinitialise all particles with fresh random values.
    If Input.IsKeyPressed(KEY_R) Then InitializeParticles
End Sub

' ============================================================================
' RENDERING
' ============================================================================
' _Draw() — Godot's CanvasItem._draw() callback, called every frame after
' _Process().  All Draw* calls here are VisualGasic wrappers around Godot's
' draw_rect, draw_circle, draw_string, etc.  Coordinates are in pixels.
' Color("#hex") parses a CSS-style hex colour; Color.White is a constant.
Sub _Draw()
    ' Full-screen dark background (near-black with a blue tint).
    DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color("#0a0a1a")
    
    ' ---- Top header bar ------------------------------------------------------
    DrawRect 0, 0, SCREEN_WIDTH, 60, Color("#1a1a3e")
    ' DrawString args: text, x, y, color, fontSize
    DrawString "⚡ PARALLEL PROCESSING DEMO", 20, 10, Color.White, 24
    DrawString "Demo: " & demoNames(selectedDemo) & " | Press 1/2/3 to switch", 20, 40, Color("#888888"), 14
    
    ' Dispatch to the appropriate page-specific renderer.
    Select Case selectedDemo
        Case 0
            DrawParticleDemo
        Case 1
            DrawWorkLoadDemo
        Case 2
            DrawPrimeDemo
    End Select
    
    ' ---- Bottom footer bar ---------------------------------------------------
    DrawRect 0, SCREEN_HEIGHT - 40, SCREEN_WIDTH, 40, Color("#1a1a3e")
    DrawString "A=Async Task | W=Awaited Task | R=Reset | Enter=Run Test", 20, SCREEN_HEIGHT - 28, Color("#666666"), 14
End Sub

' Render the particle physics demo page.
' Iterates all particles and draws a filled circle for each active one.
Sub DrawParticleDemo()
    Dim i As Integer
    For i = 0 To MAX_PARTICLES - 1
        If particles(i).Active Then
            ' Clamp alpha to [0, 1] — as Life drops below 1 the particle fades.
            ' Min() is a VisualGasic built-in (wraps Godot's minf).
            Dim alpha As Single = Min(particles(i).Life, 1.0)
            Dim pColor As Variant = particles(i).Color
            ' Modify the alpha channel of the Color copy for fade-out effect.
            ' ".a" accesses the Color's alpha property (Godot Variant member).
            pColor.a = alpha
            
            ' DrawCircle args: x, y, radius, color.  Int() truncates to integer.
            DrawCircle Int(particles(i).X), Int(particles(i).Y), Int(particles(i).Size), pColor
        End If
    Next
    
    ' HUD overlay showing instructions and particle count.
    DrawString "Hold SPACE for Parallel update, release for Serial", 20, 80, Color.Yellow, 16
    DrawString "Particles: " & Str(MAX_PARTICLES), 20, 110, Color.White, 14
End Sub

' Render the Work Load Comparison page — shows a progress bar while running
' and side-by-side timing bars after both benchmarks complete.
Sub DrawWorkLoadDemo()
    DrawString "WORK LOAD COMPARISON", 20, 80, Color.Yellow, 20
    DrawString "Simulates " & Str(WORK_ITEMS) & " CPU-intensive tasks", 20, 110, Color("#888888"), 14
    
    ' While a benchmark is actively running, show a live progress bar.
    If isProcessing Then
        DrawString processingMode & " processing...", 20, 150, Color.White, 16
        
        ' Background track (dark grey) + filled portion (Material green).
        Dim barWidth As Integer = 400
        DrawRect 20, 180, barWidth, 30, Color("#333333")
        
        Dim progress As Single = workProgress / WORK_ITEMS  ' 0.0 … 1.0
        DrawRect 20, 180, Int(barWidth * progress), 30, Color("#4CAF50")
        
        ' Percentage label to the right of the bar.
        DrawString Str(Int(progress * 100)) & "%", 430, 185, Color.White, 16
    Else
        ' ---- Static results display after benchmarks finish -----------------
        If serialTime > 0 Then
            DrawString "Serial Time: " & Format(serialTime, "0.000") & " seconds", 20, 160, Color.Red, 18
        End If
        
        If parallelTime > 0 Then
            DrawString "Parallel Time: " & Format(parallelTime, "0.000") & " seconds", 20, 190, Color.Green, 18
            
            ' Speedup ratio — serial ÷ parallel; higher is better.
            Dim speedup As Single = serialTime / parallelTime
            DrawString "Speedup: " & Format(speedup, "0.00") & "x faster!", 20, 220, Color.Cyan, 20
            
            ' Proportional bars: serial bar fills the full width, parallel bar
            ' is scaled relative to it so the visual length difference matches
            ' the actual time difference.
            Dim maxBarWidth As Integer = 500
            Dim serialBarWidth As Integer = maxBarWidth
            Dim parallelBarWidth As Integer = Int(maxBarWidth * (parallelTime / serialTime))
            
            DrawString "Serial:", 20, 270, Color.Red, 14
            DrawRect 100, 268, serialBarWidth, 20, Color.Red
            
            DrawString "Parallel:", 20, 300, Color.Green, 14
            DrawRect 100, 298, parallelBarWidth, 20, Color.Green
        Else
            ' No results yet — prompt the user to start.
            DrawString "Press ENTER to run Serial test first", 20, 160, Color.White, 16
        End If
    End If
End Sub

' Render the Prime Calculation page — progress bar during search,
' then timing comparison and a sample of discovered primes.
Sub DrawPrimeDemo()
    DrawString "PRIME NUMBER CALCULATION", 20, 80, Color.Yellow, 20
    DrawString "Finding primes up to " & Str(primeLimit), 20, 110, Color("#888888"), 14
    
    ' Live progress bar while calculating (purple Material colour).
    If isProcessing Then
        DrawString processingMode & " calculating...", 20, 150, Color.White, 16
        
        Dim barWidth As Integer = 400
        DrawRect 20, 180, barWidth, 30, Color("#333333")
        
        Dim progress As Single = completedTasks / primeLimit
        DrawRect 20, 180, Int(barWidth * progress), 30, Color("#9C27B0")
        
        DrawString Str(Int(progress * 100)) & "%", 430, 185, Color.White, 16
    Else
        ' Display serial results (red) and parallel results (green).
        If serialTime > 0 Then
            DrawString "Serial: " & Str(primeCount) & " primes in " & Format(serialTime, "0.000") & "s", 20, 160, Color.Red, 18
        End If
        
        If parallelTime > 0 Then
            DrawString "Parallel: " & Str(primeCount) & " primes in " & Format(parallelTime, "0.000") & "s", 20, 190, Color.Green, 18
            
            Dim speedup As Single = serialTime / parallelTime
            DrawString "Speedup: " & Format(speedup, "0.00") & "x faster!", 20, 220, Color.Cyan, 20
            
            ' List the first 10 primes as a quick sanity check.
            ' Min(9, primeCount-1) ensures we don't read past the buffer.
            DrawString "First 10 primes found:", 20, 270, Color.White, 14
            Dim primeStr As String = ""
            Dim i As Integer
            For i = 0 To Min(9, primeCount - 1)
                primeStr = primeStr & Str(primeResults(i)) & " "  ' Build space-separated list
            Next
            DrawString primeStr, 20, 295, Color.Yellow, 16
        Else
            DrawString "Press ENTER to run Serial test first", 20, 160, Color.White, 16
        End If
    End If
End Sub
