' ============================================================================
' SNAKE - Classic Game with Modern Features
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' Demonstrates:
' - DATA statements for level layouts and food types
' - Whenever system for game state monitoring
' - For Each for iterating snake body
' - Dictionary for quick collision lookup
' ============================================================================
' VB6-style module attribute — names this script for Godot's scene tree
Attribute VB_Name = "SnakeGame"

' ---------- Grid Constants ----------
' The playing field is a 32×24 cell grid; each cell is 20×20 pixels,
' giving a total viewport of 640×480 px (plus a 50 px HUD bar below).
Const GRID_WIDTH As Integer = 32   ' Number of columns in the grid
Const GRID_HEIGHT As Integer = 24  ' Number of rows in the grid
Const CELL_SIZE As Integer = 20    ' Pixel size of one grid cell

' ---------- Snake Body ----------
' VB6-style fixed-size arrays storing grid coordinates for each segment.
' Index 0 = head; higher indices = trailing body.  Max 500 segments.
Dim snakeX(500) As Integer   ' X grid coord of each segment
Dim snakeY(500) As Integer   ' Y grid coord of each segment
Dim snakeLength As Integer   ' Current number of active segments

' ---------- Direction (grid-based movement) ----------
' dirX/dirY = the direction applied *this* frame (±1 on one axis, 0 on the other).
' nextDirX/nextDirY = queued input; copied into dir* on the next move tick.
' Two-variable scheme prevents instant 180° reversals between ticks.
Dim dirX As Integer      ' Current horizontal direction (-1 left, 0 none, +1 right)
Dim dirY As Integer      ' Current vertical direction   (-1 up,   0 none, +1 down)
Dim nextDirX As Integer  ' Queued horizontal direction from player input
Dim nextDirY As Integer  ' Queued vertical direction from player input

' ---------- Food ----------
' A single food item sits on the grid at any time. Its type indexes into
' the foodNames/foodPoints/foodColors arrays loaded from DATA statements.
Dim foodX As Integer      ' Grid column of the current food item
Dim foodY As Integer      ' Grid row of the current food item
Dim foodType As Integer   ' Index into foodNames()/foodPoints()/foodColors()
Dim foodTimer As Single   ' Elapsed time since last food spawn (drives pulsing animation)

' ---------- Power-ups ----------
' At most one power-up on the field at a time. Spawned by Whenever milestones.
Dim powerUpX As Integer       ' Grid column of the power-up
Dim powerUpY As Integer       ' Grid row of the power-up
Dim powerUpActive As Boolean  ' True when a power-up is visible on the field
Dim powerUpType As String     ' "SPEED", "SLOW", "SHRINK", or "POINTS"

' ---------- Game State (monitored by Whenever Sections) ----------
' These variables are watched reactively by the Whenever system below.
' When their values cross thresholds, callback Subs fire automatically.
Dim score As Integer       ' Player's cumulative score (watched for milestones)
Dim level As Integer       ' Current level number, 1-based
Dim gameState As String    ' FSM state: "playing", "paused", "gameover", "levelcomplete"
Dim moveTimer As Single    ' Accumulates delta until >= moveInterval, then the snake steps
Dim moveInterval As Single ' Seconds between snake moves (lower = faster; set per level)

' ---------- Level Wall Data ----------
' Walls are obstacle cells; loaded from DATA labels per level.
Dim wallX(100) As Integer   ' X coords of wall cells (max 100)
Dim wallY(100) As Integer   ' Y coords of wall cells
Dim wallCount As Integer    ' How many wall cells are active this level

' ---------- Food Type Tables (populated from DATA at startup) ----------
' Parallel arrays — each index describes one food variety.
Dim foodNames(10) As String    ' Display name ("Apple", "Cherry", etc.)
Dim foodPoints(10) As Integer  ' Score value when eaten
Dim foodColors(10) As Variant  ' Godot Color for rendering (Variant holds Color objects)
Dim foodCount As Integer       ' Number of food types loaded from DATA

' ---------- Level Definition Tables (populated from DATA at startup) ----------
Dim levelNames(10) As String    ' Thematic name shown in HUD ("Grassland", etc.)
Dim levelSpeeds(10) As Single   ' Move interval in seconds (smaller = faster)
Dim levelTargets(10) As Integer ' Score threshold to complete the level
Dim totalLevels As Integer      ' Number of levels loaded from DATA

' ---------- Speed Boost (from SPEED power-up) ----------
Dim speedBoostTimer As Single  ' Seconds remaining on the speed boost effect
Dim isSpeedBoosted As Boolean  ' True while a speed boost is active

' ============================================================================
' WHENEVER SECTIONS — Reactive Game Monitoring
' ============================================================================
' VisualGasic's "Whenever" system is a declarative, reactive programming
' feature unique to the language.  Each declaration watches a variable and
' fires a callback Sub/Function when a condition is met.
'
' Syntax:  Whenever Section <Name> <variable> <Condition> <threshold> <callback>
'   Conditions: Exceeds, Below, Changes, Equals
'
' The runtime checks these every frame AFTER _Process returns.
' You can Suspend/Resume individual Whenever Sections at runtime to
' temporarily disable monitoring (e.g., while paused or game-over).
' ============================================================================

' --- Score milestones: fire once when score first crosses the threshold ---
Whenever Section ScoreMilestone score Exceeds 1000 ShowMilestoneBonus   ' Awards a bonus power-up at 1 000 pts
Whenever Section ScoreMilestone2 score Exceeds 5000 ShowSuperBonus      ' Awards +500 bonus at 5 000 pts

' --- Level completion: dynamic threshold from GetLevelTarget() ---
' The threshold is a Function call, re-evaluated each check.
Whenever Section LevelComplete score Exceeds GetLevelTarget() AdvanceLevel

' --- State change: fires every time gameState is assigned a new value ---
' Uses the "Changes" condition — triggers on any mutation.
Whenever Section GameStateChange gameState Changes OnStateChange

' --- Length achievement: one-shot when snake grows past 20 segments ---
Whenever Section LongSnake snakeLength Exceeds 20 ShowLengthAchievement

' --- Speed boost expiry: fires when the countdown drops below zero ---
Whenever Section SpeedBoostEnd speedBoostTimer Below 0 EndSpeedBoost

' ============================================================================
' WHENEVER CALLBACKS
' ============================================================================
' These Subs/Functions are invoked automatically by the Whenever system
' when their associated condition fires.  They should be quick — the
' Whenever check runs synchronously between frames.
' ============================================================================

' Called by the LevelComplete Whenever to get the current level's target score.
' Returning 99999 effectively disables level completion beyond the last defined level.
Function GetLevelTarget() As Integer
    If level <= totalLevels Then
        Return levelTargets(level - 1)  ' Arrays are 0-based; levels are 1-based
    Else
        Return 99999  ' No more levels — unreachable target
    End If
End Function

' Triggered once when score exceeds 1000 (ScoreMilestone Whenever)
Sub ShowMilestoneBonus()
    Print "1000 POINTS! Bonus power-up spawned!"
    SpawnPowerUp  ' Reward the player with an on-field power-up
End Sub

' Triggered once when score exceeds 5000 (ScoreMilestone2 Whenever)
Sub ShowSuperBonus()
    Print "5000 POINTS! SUPER BONUS!"
    score = score + 500  ' Direct score injection (may re-trigger other Whenevers)
End Sub

' Triggered when score exceeds the current level's target
Sub AdvanceLevel()
    If level < totalLevels Then
        gameState = "levelcomplete"  ' Triggers the GameStateChange Whenever too
        Print "Level " & Str(level) & " Complete!"
    Else
        Print "YOU WIN! All levels completed!"
        gameState = "gameover"  ' Final victory
    End If
End Sub

' Triggered whenever gameState is assigned a different value.
' Uses Select Case (VB6 pattern matching) to suspend/resume other Whenevers
' so they don't fire while the game is paused or over.
Sub OnStateChange()
    Print "Game state: " & gameState
    
    ' Select Case on a String — VisualGasic supports string matching like VB6.
    ' "Resume Whenever" / "Suspend Whenever" toggle monitoring on named sections.
    Select Case gameState
        Case "playing"
            Resume Whenever ScoreMilestone   ' Re-enable score monitoring
            Resume Whenever LevelComplete    ' Re-enable level-up check
        Case "paused", "gameover"
            Suspend Whenever ScoreMilestone  ' Freeze score monitoring
            Suspend Whenever LevelComplete   ' Freeze level-up check
    End Select
End Sub

' Triggered once when snakeLength exceeds 20 (LongSnake Whenever)
Sub ShowLengthAchievement()
    Print "ACHIEVEMENT: Snake length 20+!"
End Sub

' Triggered when speedBoostTimer drops below 0 (SpeedBoostEnd Whenever).
' Restores the level's default move interval.
Sub EndSpeedBoost()
    If isSpeedBoosted Then
        isSpeedBoosted = False
        moveInterval = levelSpeeds(level - 1)  ' Restore normal speed for current level
        Print "Speed boost ended"
    End If
End Sub

' ============================================================================
' INITIALIZATION
' ============================================================================

' _Ready() is Godot's node initialization callback, called once when the
' scene enters the tree.  VisualGasic maps it directly to Godot's _ready().
Sub _Ready()
    Print "=== SNAKE ==="
    Print "DATA Statements & Whenever Demo"
    Print ""
    Print "Controls: WASD or Arrow Keys"
    Print ""
    
    LoadFoodTypes   ' Parse embedded DATA for food varieties
    LoadLevelData   ' Parse embedded DATA for level definitions
    StartGame       ' Initialize first game session
End Sub

' ---- Read food types from the FoodTypeData: DATA block ----
' Classic BASIC DATA/Read/Restore pattern:
'   Restore <label>  — sets the DATA read pointer to that label
'   Read <var>       — reads the next datum into <var>
' DATA lines hold comma-separated literals.  "END" acts as a sentinel.
Sub LoadFoodTypes()
    Restore FoodTypeData  ' Point the DATA read cursor to FoodTypeData:
    foodCount = 0
    
    Dim fName As String
    Do
        Read fName                          ' Read the next food name (String)
        If fName = "END" Then Exit Do       ' Sentinel — stop reading
        
        foodNames(foodCount) = fName
        
        Dim pts As Integer
        Dim r, g, b As Integer
        Read pts, r, g, b                   ' Read point value and RGB components
        
        foodPoints(foodCount) = pts
        ' Color(r, g, b) — Godot Color constructor expects 0.0–1.0 floats,
        ' so we divide the 0–255 DATA values by 255.0.
        foodColors(foodCount) = Color(r/255.0, g/255.0, b/255.0)
        
        foodCount = foodCount + 1
    Loop
    
    Print "Loaded " & Str(foodCount) & " food types"
End Sub

' ---- Read level definitions from the LevelData: DATA block ----
' Same Restore/Read/sentinel pattern as LoadFoodTypes.
Sub LoadLevelData()
    Restore LevelData       ' Point DATA cursor to LevelData:
    totalLevels = 0
    
    Dim lName As String
    Do
        Read lName
        If lName = "END" Then Exit Do   ' Sentinel
        
        levelNames(totalLevels) = lName
        Read levelSpeeds(totalLevels)    ' Move interval (seconds)
        Read levelTargets(totalLevels)   ' Score needed to clear level
        
        totalLevels = totalLevels + 1
    Loop
    
    Print "Loaded " & Str(totalLevels) & " levels"
End Sub

' Start (or restart) a full game from Level 1.
Sub StartGame()
    level = 1
    score = 0
    gameState = "playing"   ' Triggers GameStateChange Whenever → OnStateChange
    
    StartLevel
End Sub

' Initialize / reset everything for the current level number.
Sub StartLevel()
    ' --- Reset snake to 3 segments, centered, facing right ---
    snakeLength = 3
    snakeX(0) = GRID_WIDTH / 2       ' Head at grid center
    snakeY(0) = GRID_HEIGHT / 2
    snakeX(1) = snakeX(0) - 1        ' 2nd segment one cell left
    snakeY(1) = snakeY(0)
    snakeX(2) = snakeX(0) - 2        ' 3rd segment two cells left
    snakeY(2) = snakeY(0)
    
    ' Initial direction: moving right (+1, 0)
    dirX = 1
    dirY = 0
    nextDirX = 1
    nextDirY = 0
    
    ' Each level has its own base speed (from DATA)
    moveInterval = levelSpeeds(level - 1)
    moveTimer = 0
    
    ' Build wall obstacles for this level (from DATA or random)
    LoadLevelWalls
    
    ' Place the first food item on an unoccupied cell
    SpawnFood
    
    ' Clear any lingering power-up / speed boost from previous level
    powerUpActive = False
    isSpeedBoosted = False
    speedBoostTimer = 0
    
    ' Str() is the VB6 number-to-string function (like GDScript's str()).
    Print "Level " & Str(level) & ": " & levelNames(level - 1)
    Print "Target: " & Str(levelTargets(level - 1)) & " points"
End Sub

' Load wall obstacles for the current level.
' Levels 1–4 have hand-designed layouts stored in DATA blocks;
' levels 5+ procedurally generate random walls.
Sub LoadLevelWalls()
    wallCount = 0
    
    ' Select Case on an Integer — each Case maps a level to its wall DATA.
    Select Case level
        Case 1
            ' No walls — beginner-friendly open field
        Case 2
            Restore Level2Walls   ' Move DATA cursor to Level2Walls:
            ReadWalls             ' Read x,y pairs until sentinel -1
        Case 3
            Restore Level3Walls   ' Cross-shaped obstacle pattern
            ReadWalls
        Case 4
            Restore Level4Walls   ' Maze-like corridor walls
            ReadWalls
        Case Else
            ' Procedural: scatter (level * 2) random walls, inset by 2 cells
            ' Int() truncates to integer; Rnd() returns 0.0–1.0 (VB6 built-ins).
            Dim i As Integer
            For i = 0 To level * 2
                wallX(wallCount) = Int(Rnd() * (GRID_WIDTH - 4)) + 2
                wallY(wallCount) = Int(Rnd() * (GRID_HEIGHT - 4)) + 2
                wallCount = wallCount + 1
            Next
    End Select
End Sub

' Helper: reads wall coordinate pairs from the current DATA cursor.
' Each DATA line has x, y pairs; a sentinel value of -1 marks the end.
Sub ReadWalls()
    Dim wx, wy As Integer
    Do
        Read wx                 ' Read next wall X
        If wx = -1 Then Exit Do ' Sentinel — all walls read
        Read wy                 ' Read next wall Y
        wallX(wallCount) = wx
        wallY(wallCount) = wy
        wallCount = wallCount + 1
    Loop
End Sub

' Place a new food item on a random unoccupied cell.
Sub SpawnFood()
    ' Rejection sampling: pick random coords until we find an empty cell.
    Do
        foodX = Int(Rnd() * GRID_WIDTH)   ' Random column
        foodY = Int(Rnd() * GRID_HEIGHT)  ' Random row
    Loop While IsOccupied(foodX, foodY)    ' Keep trying if cell is taken
    
    foodType = Int(Rnd() * foodCount)  ' Pick a random food variety
    foodTimer = 0                      ' Reset pulsing animation timer
End Sub

' Spawn a power-up on the field (called from Whenever milestone callbacks).
' Only one power-up can exist at a time — exit early if one is already active.
Sub SpawnPowerUp()
    If powerUpActive Then Exit Sub  ' Guard: only one at a time
    
    ' Same rejection-sampling loop as SpawnFood
    Do
        powerUpX = Int(Rnd() * GRID_WIDTH)
        powerUpY = Int(Rnd() * GRID_HEIGHT)
    Loop While IsOccupied(powerUpX, powerUpY)
    
    ' Pick a random power-up effect from a local array of type names.
    ' VB6-style: Dim a fixed array, fill it, then index with Rnd().
    Dim types(3) As String
    types(0) = "SPEED"    ' Halves move interval for 5 seconds
    types(1) = "SLOW"     ' Increases move interval by 50%
    types(2) = "SHRINK"   ' Removes 3 tail segments
    types(3) = "POINTS"   ' Instant +100 score bonus
    powerUpType = types(Int(Rnd() * 4))
    
    powerUpActive = True
    Print "Power-up spawned: " & powerUpType
End Sub

' Check whether a grid cell is already occupied by the snake, a wall, or food.
' Used by SpawnFood/SpawnPowerUp to avoid placing items on top of things.
Function IsOccupied(x As Integer, y As Integer) As Boolean
    ' Check every snake segment
    Dim i As Integer
    For i = 0 To snakeLength - 1
        If snakeX(i) = x And snakeY(i) = y Then Return True
    Next
    
    ' Check every wall cell
    For i = 0 To wallCount - 1
        If wallX(i) = x And wallY(i) = y Then Return True
    Next
    
    ' Check current food position
    If x = foodX And y = foodY Then Return True
    
    Return False  ' Cell is free
End Function

' ============================================================================
' DATA — Food Types
' ============================================================================
' Classic BASIC DATA statements: inline lookup tables embedded in code.
' Each line defines one food type with Name, Points, R, G, B.
' LoadFoodTypes() uses Restore/Read to parse these at startup.
' The final "END" row is a sentinel that tells the read-loop to stop.
FoodTypeData:
' Name,     Points,  Red, Green, Blue  (RGB 0–255)
Data "Apple", 10, 255, 0, 0          ' Red apple — basic 10 pts
Data "Cherry", 20, 255, 0, 100       ' Pink cherry — 20 pts
Data "Banana", 15, 255, 255, 0       ' Yellow banana — 15 pts
Data "Grape", 25, 128, 0, 255        ' Purple grape — 25 pts
Data "Orange", 30, 255, 165, 0       ' Orange — 30 pts
Data "Melon", 50, 0, 255, 128        ' Teal melon — high-value 50 pts
Data "END", 0, 0, 0, 0               ' Sentinel row

' ============================================================================
' DATA — Level Definitions
' ============================================================================
' Each level row: Name (String), MoveInterval (Single), TargetScore (Integer).
' Levels get progressively faster (lower interval) with higher score targets.
LevelData:
' Name,         Speed(s), Target(pts)
Data "Grassland", 0.15, 500    ' Lv1: easy pace, low target
Data "Forest", 0.12, 1000      ' Lv2: slightly faster
Data "Desert", 0.10, 2000      ' Lv3: moderate speed
Data "Mountains", 0.08, 3500   ' Lv4: fast, walls get tricky
Data "Ice Cave", 0.06, 5000    ' Lv5: very fast — endgame
Data "END", 0, 0               ' Sentinel

' ============================================================================
' DATA — Level Wall Layouts
' ============================================================================
' Each label corresponds to a level.  ReadWalls() reads x,y pairs until
' it hits the sentinel -1.  Walls are grid coordinates (not pixel coords).

Level2Walls:
' Four corner pillars — gentle introduction to obstacles
Data 5, 5      ' Top-left pillar
Data 5, 18     ' Bottom-left pillar
Data 26, 5     ' Top-right pillar
Data 26, 18    ' Bottom-right pillar
Data -1, 0     ' Sentinel (end of wall list)

Level3Walls:
' Cross / plus-sign pattern centered in the arena
' Vertical bar (column 16, rows 8-10 and 14-16)
Data 16, 8
Data 16, 9
Data 16, 10
Data 16, 14
Data 16, 15
Data 16, 16
' Horizontal bar (row 12, columns 12-14 and 18-20)
Data 12, 12
Data 13, 12
Data 14, 12
Data 18, 12
Data 19, 12
Data 20, 12
Data -1, 0     ' Sentinel

Level4Walls:
' Maze-like corridors — multiple pairs per DATA line (Read reads sequentially)
' Left vertical wall segment (column 8, rows 4-8)
Data 8, 4, 8, 5, 8, 6, 8, 7, 8, 8
' Right vertical wall segment (column 24, rows 16-20)
Data 24, 16, 24, 17, 24, 18, 24, 19, 24, 20
' Bottom-left horizontal segment (row 12, cols 12-15)
Data 12, 12, 13, 12, 14, 12, 15, 12
' Bottom-right horizontal segment (row 12, cols 18-21)
Data 18, 12, 19, 12, 20, 12, 21, 12
Data -1, 0     ' Sentinel

' ============================================================================
' GAME LOOP
' ============================================================================

' _Process(delta) is Godot's per-frame callback (like _process in GDScript).
' `delta` is the elapsed time since the last frame, in seconds.
' VisualGasic maps this directly to Godot's virtual _process method.
Sub _Process(delta As Single)
    ' Input is checked regardless of state so pause/restart keys always work.
    HandleInput
    
    ' Count down the speed boost timer each frame (watched by Whenever).
    If isSpeedBoosted Then
        speedBoostTimer = speedBoostTimer - delta
    End If
    
    ' State machine — Select Case on the gameState string.
    Select Case gameState
        Case "playing"
            ' Accumulate time; when enough has passed, advance the snake one cell.
            ' This creates discrete, grid-aligned movement at a fixed step rate.
            moveTimer = moveTimer + delta
            If moveTimer >= moveInterval Then
                MoveSnake          ' Advance snake by one grid cell
                moveTimer = 0      ' Reset accumulator
            End If
            
            ' foodTimer drives the pulsing animation in _Draw().
            foodTimer = foodTimer + delta
            
        Case "levelcomplete"
            ' Wait for ENTER ("ui_accept" is Godot's built-in input action).
            If Input.IsActionJustPressed("ui_accept") Then
                level = level + 1
                StartLevel
                gameState = "playing"
            End If
            
        Case "gameover"
            ' Wait for ENTER to restart the entire game.
            If Input.IsActionJustPressed("ui_accept") Then
                StartGame
            End If
    End Select
End Sub

' Handle directional input and pause toggle.
' Uses Godot's Input singleton (accessed like a VB6 global object).
' IsActionJustPressed returns True only on the frame the key is first pressed.
Sub HandleInput()
    ' Queue the next direction into nextDirX/nextDirY.
    ' The guard (e.g., dirY <> 1) prevents reversing into the snake's own body
    ' — you can't go up if you're currently heading down, etc.
    If Input.IsActionJustPressed("up") And dirY <> 1 Then
        nextDirX = 0
        nextDirY = -1       ' Up in screen coords (Y decreases upward)
    ElseIf Input.IsActionJustPressed("down") And dirY <> -1 Then
        nextDirX = 0
        nextDirY = 1        ' Down
    ElseIf Input.IsActionJustPressed("left") And dirX <> 1 Then
        nextDirX = -1
        nextDirY = 0        ' Left
    ElseIf Input.IsActionJustPressed("right") And dirX <> -1 Then
        nextDirX = 1
        nextDirY = 0        ' Right
    End If
    
    ' ESC ("ui_cancel") toggles pause.  Assigning gameState triggers the
    ' GameStateChange Whenever → OnStateChange, which suspends/resumes monitors.
    If Input.IsActionJustPressed("ui_cancel") Then
        If gameState = "playing" Then
            gameState = "paused"
        ElseIf gameState = "paused" Then
            gameState = "playing"
        End If
    End If
End Sub

' Core movement routine — called once per step (when moveTimer expires).
' This is classic snake logic: advance the head, check collisions, shift body.
Sub MoveSnake()
    ' Latch the queued input so we move in the direction the player chose.
    dirX = nextDirX
    dirY = nextDirY
    
    ' Compute where the head will land.
    ' VB6-style inline Dim initializer: "Dim x As Integer = expr".
    Dim newX As Integer = snakeX(0) + dirX
    Dim newY As Integer = snakeY(0) + dirY
    
    ' Toroidal wrap-around: exiting one edge re-enters from the opposite.
    If newX < 0 Then newX = GRID_WIDTH - 1       ' Left edge → right edge
    If newX >= GRID_WIDTH Then newX = 0           ' Right edge → left edge
    If newY < 0 Then newY = GRID_HEIGHT - 1       ' Top edge → bottom edge
    If newY >= GRID_HEIGHT Then newY = 0           ' Bottom edge → top edge
    
    ' --- Wall collision: any wall cell at the new head position = death ---
    Dim i As Integer
    For i = 0 To wallCount - 1
        If wallX(i) = newX And wallY(i) = newY Then
            GameOver "Hit a wall!"
            Return  ' Abort the move
        End If
    Next
    
    ' --- Self collision: running into any existing body segment = death ---
    For i = 0 To snakeLength - 1
        If snakeX(i) = newX And snakeY(i) = newY Then
            GameOver "Ate yourself!"
            Return
        End If
    Next
    
    ' --- Food collision: head lands on the food cell ---
    Dim ateFood As Boolean = False
    If newX = foodX And newY = foodY Then
        score = score + foodPoints(foodType)  ' Add food's point value to score
        snakeLength = snakeLength + 1         ' Grow snake by 1 segment
        ateFood = True
        SpawnFood  ' Immediately place a new food item
        ' VB6 string concatenation with & ; Str() converts Integer to String.
        Print "Ate " & foodNames(foodType) & "! +" & Str(foodPoints(foodType))
    End If
    
    ' --- Power-up collision: head lands on an active power-up ---
    If powerUpActive And newX = powerUpX And newY = powerUpY Then
        CollectPowerUp  ' Apply the power-up effect (speed/slow/shrink/points)
    End If
    
    ' --- Shift the body forward ---
    ' Walk backwards from tail to neck, copying each segment's position
    ' from the one ahead of it.  This "pulls" the body along the path.
    ' "Step -1" is VB6 syntax for a decrementing For loop.
    For i = snakeLength - 1 To 1 Step -1
        snakeX(i) = snakeX(i - 1)
        snakeY(i) = snakeY(i - 1)
    Next
    
    ' Place the head at its new position
    snakeX(0) = newX
    snakeY(0) = newY
End Sub

' Apply the collected power-up's effect.
' Select Case on a String — VisualGasic pattern-matches each Case literal.
Sub CollectPowerUp()
    powerUpActive = False   ' Remove the power-up from the field
    
    Select Case powerUpType
        Case "SPEED"
            ' Halve the move interval → snake moves twice as fast for 5 seconds.
            ' The SpeedBoostEnd Whenever watches speedBoostTimer and calls
            ' EndSpeedBoost() when it drops below 0.
            isSpeedBoosted = True
            moveInterval = moveInterval * 0.5
            speedBoostTimer = 5.0   ' 5-second countdown
            Print "SPEED BOOST!"
        Case "SLOW"
            ' Increase move interval by 50% → snake slows down (permanent).
            moveInterval = moveInterval * 1.5
            Print "SLOWED DOWN!"
        Case "SHRINK"
            ' Remove 3 tail segments (minimum length 3 enforced).
            If snakeLength > 3 Then
                snakeLength = snakeLength - 3
                Print "SHRINK! Length -3"
            End If
        Case "POINTS"
            ' Instant score bonus (may trigger score-based Whenevers).
            score = score + 100
            Print "BONUS POINTS +100!"
    End Select
End Sub

' End the game with a reason message.  Setting gameState triggers the
' GameStateChange Whenever, which suspends score/level monitoring.
Sub GameOver(reason As String)
    gameState = "gameover"
    Print "GAME OVER: " & reason
    Print "Final Score: " & Str(score)
End Sub

' ============================================================================
' RENDERING
' ============================================================================

' _Draw() is Godot's per-frame rendering callback (maps to _draw in GDScript).
' All draw calls (DrawRect, DrawCircle, DrawString, DrawLine) are VisualGasic
' wrappers around Godot's CanvasItem draw_* methods.  They only work inside
' _Draw() and render in the order they're called (painter's algorithm).
Sub _Draw()
    ' --- Level-themed background ---
    ' Color("#hex") is the hex-string Color constructor (Godot-style).
    ' Select Case with inline single-line syntax: "Case N: statement"
    Dim bgColor As Variant
    Select Case level
        Case 1: bgColor = Color("#1a3300")  ' Dark green — Grassland
        Case 2: bgColor = Color("#003300")  ' Deeper green — Forest
        Case 3: bgColor = Color("#332200")  ' Brown — Desert
        Case 4: bgColor = Color("#222233")  ' Blue-gray — Mountains
        Case 5: bgColor = Color("#003344")  ' Teal — Ice Cave
        Case Else: bgColor = Color("#111111")  ' Near-black fallback
    End Select
    ' Fill the entire play area with the background color
    DrawRect 0, 0, GRID_WIDTH * CELL_SIZE, GRID_HEIGHT * CELL_SIZE, bgColor
    
    ' --- Subtle grid lines ---
    ' Color(r, g, b, a) with alpha 0.05 = nearly transparent white lines.
    Dim x, y As Integer
    For x = 0 To GRID_WIDTH
        DrawLine x * CELL_SIZE, 0, x * CELL_SIZE, GRID_HEIGHT * CELL_SIZE, Color(1, 1, 1, 0.05)
    Next
    For y = 0 To GRID_HEIGHT
        DrawLine 0, y * CELL_SIZE, GRID_WIDTH * CELL_SIZE, y * CELL_SIZE, Color(1, 1, 1, 0.05)
    Next
    
    ' --- Wall obstacles (gray squares) ---
    Dim i As Integer
    For i = 0 To wallCount - 1
        DrawRect wallX(i) * CELL_SIZE, wallY(i) * CELL_SIZE, CELL_SIZE, CELL_SIZE, Color("#666666")
    Next
    
    ' --- Food with pulsing animation ---
    ' Sin() oscillates the draw size ±20% around CELL_SIZE, creating a "breathing" effect.
    ' Sin() and Int() are VB6 built-in math functions mapped to Godot equivalents.
    Dim foodPulse As Single = 1.0 + Sin(foodTimer * 5) * 0.2  ' Oscillates 0.8–1.2
    Dim foodDrawSize As Integer = Int(CELL_SIZE * foodPulse)   ' Pixel size this frame
    Dim foodOffset As Integer = (CELL_SIZE - foodDrawSize) / 2 ' Center the pulsing rect
    DrawRect foodX * CELL_SIZE + foodOffset, foodY * CELL_SIZE + foodOffset, foodDrawSize, foodDrawSize, foodColors(foodType)
    
    ' --- Power-up (pulsing circle, color-coded by type) ---
    ' DrawCircle draws a filled circle: centerX, centerY, radius, color.
    ' Pulses 30% faster than food (foodTimer * 8) for visual distinction.
    If powerUpActive Then
        Dim puPulse As Single = 1.0 + Sin(foodTimer * 8) * 0.3  ' Faster, larger pulse
        Dim puColor As Variant
        Select Case powerUpType
            Case "SPEED": puColor = Color("#FFFF00")   ' Yellow — speed boost
            Case "SLOW": puColor = Color("#00FFFF")    ' Cyan — slowdown
            Case "SHRINK": puColor = Color("#FF00FF")  ' Magenta — shrink
            Case "POINTS": puColor = Color("#FFD700")  ' Gold — bonus points
        End Select
        ' Center the circle in the grid cell; scale radius by pulse factor
        DrawCircle powerUpX * CELL_SIZE + CELL_SIZE/2, powerUpY * CELL_SIZE + CELL_SIZE/2, CELL_SIZE/2 * puPulse, puColor
    End If
    
    ' --- Draw the snake (head + body gradient) ---
    For i = 0 To snakeLength - 1
        Dim segColor As Variant
        If i = 0 Then
            segColor = Color("#00FF00")  ' Head: full bright green
        Else
            ' Body segments fade from bright to dark green toward the tail.
            ' "fade" ranges from ~1.0 (near head) to ~0.5 (tail).
            Dim fade As Single = 1.0 - (i / snakeLength) * 0.5
            segColor = Color(0, fade * 0.8, 0)  ' Color(r, g, b) — green channel only
        End If
        
        ' +1 / -2 insets create a 1 px gap between segments for visual clarity.
        DrawRect snakeX(i) * CELL_SIZE + 1, snakeY(i) * CELL_SIZE + 1, CELL_SIZE - 2, CELL_SIZE - 2, segColor
    Next
    
    ' --- Speed boost countdown indicator (above HUD bar) ---
    ' Int() truncates the timer to whole seconds for display.
    ' DrawString params: text, x, y, color, fontSize.
    If isSpeedBoosted Then
        DrawString "SPEED BOOST: " & Str(Int(speedBoostTimer)) & "s", 10, GRID_HEIGHT * CELL_SIZE + 25, Color.Yellow, 16
    End If
    
    ' --- HUD bar (50 px tall strip below the play area) ---
    ' Dark background strip for readability
    DrawRect 0, GRID_HEIGHT * CELL_SIZE, GRID_WIDTH * CELL_SIZE, 50, Color("#222222")
    ' Level name (top line of HUD)
    DrawString "Level: " & Str(level) & " - " & levelNames(level - 1), 10, GRID_HEIGHT * CELL_SIZE + 5, Color.White, 18
    ' Score / target (bottom line — shows progress toward level completion)
    DrawString "Score: " & Str(score) & " / " & Str(levelTargets(level - 1)), 10, GRID_HEIGHT * CELL_SIZE + 28, Color.Cyan, 16
    ' Snake length (right-aligned)
    DrawString "Length: " & Str(snakeLength), GRID_WIDTH * CELL_SIZE - 100, GRID_HEIGHT * CELL_SIZE + 15, Color.Green, 16
    
    ' --- State overlays (drawn on top of everything when not "playing") ---
    ' Each overlay uses a semi-transparent black rect to dim the play area,
    ' then centered text.  Color.Yellow / Color.Red etc. are Godot named colors.
    
    ' PAUSED overlay (70% opaque black dimmer)
    If gameState = "paused" Then
        DrawRect 0, 0, GRID_WIDTH * CELL_SIZE, GRID_HEIGHT * CELL_SIZE, Color(0, 0, 0, 0.7)
        DrawString "PAUSED", GRID_WIDTH * CELL_SIZE / 2 - 60, GRID_HEIGHT * CELL_SIZE / 2 - 20, Color.Yellow, 36
        DrawString "Press ESC to continue", GRID_WIDTH * CELL_SIZE / 2 - 90, GRID_HEIGHT * CELL_SIZE / 2 + 30, Color.Gray, 18
    End If
    
    ' GAME OVER overlay (80% opaque)
    If gameState = "gameover" Then
        DrawRect 0, 0, GRID_WIDTH * CELL_SIZE, GRID_HEIGHT * CELL_SIZE, Color(0, 0, 0, 0.8)
        DrawString "GAME OVER", GRID_WIDTH * CELL_SIZE / 2 - 90, GRID_HEIGHT * CELL_SIZE / 2 - 40, Color.Red, 40
        DrawString "Final Score: " & Str(score), GRID_WIDTH * CELL_SIZE / 2 - 70, GRID_HEIGHT * CELL_SIZE / 2 + 10, Color.White, 24
        DrawString "Press ENTER to restart", GRID_WIDTH * CELL_SIZE / 2 - 100, GRID_HEIGHT * CELL_SIZE / 2 + 50, Color.Gray, 18
    End If
    
    ' LEVEL COMPLETE overlay (blue-tinted 80% opaque)
    If gameState = "levelcomplete" Then
        DrawRect 0, 0, GRID_WIDTH * CELL_SIZE, GRID_HEIGHT * CELL_SIZE, Color(0, 0, 0.2, 0.8)
        DrawString "LEVEL COMPLETE!", GRID_WIDTH * CELL_SIZE / 2 - 120, GRID_HEIGHT * CELL_SIZE / 2 - 40, Color("#FFD700"), 36
        DrawString "Score: " & Str(score), GRID_WIDTH * CELL_SIZE / 2 - 50, GRID_HEIGHT * CELL_SIZE / 2 + 10, Color.White, 24
        DrawString "Press ENTER for next level", GRID_WIDTH * CELL_SIZE / 2 - 115, GRID_HEIGHT * CELL_SIZE / 2 + 50, Color.Cyan, 18
    End If
End Sub
