' ============================================================================
' TODO APP - UI Demo
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' Demonstrates:
' - File I/O (Open, Print #, Input #, Close)
' - For Each loops
' - Lambda expressions for filtering
' - Collections and Dictionary
' - Whenever for reactive updates
' - UBound/LBound
' ============================================================================
' VB6/VisualGasic module attribute — names this script for the runtime.
' Equivalent to setting the class name in GDScript's class_name directive.
Attribute VB_Name = "TodoApp"

' Canvas dimensions in pixels — used by all DrawRect/DrawString calls in _Draw()
Const SCREEN_WIDTH As Integer = 600
Const SCREEN_HEIGHT As Integer = 500
' Upper bound for the fixed-size todo array. VB6-style arrays have a fixed
' capacity declared at compile time (unlike GDScript's dynamic Arrays).
Const MAX_TODOS As Integer = 50

' Type...End Type defines a User-Defined Type (UDT) — a struct with named fields.
' This is the VB6 equivalent of a C struct or GDScript Dictionary with fixed keys.
' Fields are accessed with dot notation: todos(i).Text, todos(i).Completed, etc.
' Under the hood, VisualGasic compiles this to a Godot Dictionary with typed keys.
Type TodoItem
	Text As String             ' The task description entered by the user
	Completed As Boolean       ' True if the task has been checked off
	Priority As Integer        ' 1=High, 2=Medium, 3=Low
	CreatedAt As String        ' Timestamp string set when the task is created
End Type

' Fixed-size array of TodoItem structs — indices 0 to MAX_TODOS.
' VB6 convention: Dim arr(N) allocates slots 0..N (N+1 elements).
Dim todos(MAX_TODOS) As TodoItem
' Manual length counter — tracks how many array slots are actually in use.
' VB6 fixed arrays don't auto-track length, so we maintain this ourselves.
Dim todoCount As Integer

' UI State — these variables drive the interactive display in _Draw()
Dim inputText As String        ' Text buffer for the new-todo input field at the top
Dim selectedTodo As Integer    ' Index of the currently highlighted todo (-1 = none)
Dim filterMode As Integer      ' 0=All, 1=Active, 2=Completed — controls which todos are visible
Dim sortByPriority As Boolean  ' (Reserved) Flag for future priority-based sort feature

' Lookup arrays mapping priority levels (1=High, 2=Med, 3=Low) to display values.
' Indexed 1..3 to align with the Priority field. Index 0 is unused.
' "As Variant" allows storing Godot Color objects (no dedicated Color type in VB6).
Dim priorityColors(3) As Variant
Dim priorityNames(3) As String

' Statistics (reactive) — these variables are monitored by the Whenever Section below.
' When UpdateStatistics() changes completedTasks, the Whenever handlers fire automatically.
Dim totalTasks As Integer      ' Total number of todos in the array
Dim completedTasks As Integer  ' Count of todos where .Completed = True (triggers Whenever)
Dim pendingTasks As Integer    ' totalTasks - completedTasks (also watched by Whenever)

' File handling — "user://" is Godot's writable user-data directory.
' On Linux: ~/.local/share/godot/app_userdata/  On Windows: %APPDATA%
' VB6-style Const defines an immutable compile-time constant.
Const SAVE_FILE As String = "user://todos.dat"

' ============================================================================
' INITIALIZATION
' ============================================================================
' _Ready() is Godot's initialization callback — called once when the node
' enters the scene tree. VisualGasic maps Sub names starting with "_" to
' Godot virtual methods, so _Ready() here overrides Node._ready().
Sub _Ready()
	Print "=== TODO APP ==="
	Print "UI Demo with File I/O and Lambda"
	Print ""
	
	InitializePriorities           ' Set up priority color/name lookup tables
	LoadTodos                      ' Load saved todos from disk (or create samples)
	UpdateStatistics               ' Calculate initial task counts
	
	' Start with empty input and no selection
	inputText = ""
	selectedTodo = -1              ' -1 means nothing is highlighted
	filterMode = 0                 ' Default to showing all todos
End Sub

' Populates the priority lookup arrays. Color.Red, Color.Yellow, Color.Green
' are Godot built-in color constants exposed to VisualGasic.
' Arrays are 1-indexed here so priority values (1/2/3) map directly to indices.
Sub InitializePriorities()
	priorityColors(1) = Color.Red        ' High priority = red
	priorityColors(2) = Color.Yellow     ' Medium priority = yellow
	priorityColors(3) = Color.Green      ' Low priority = green
	
	priorityNames(1) = "HIGH"            ' Short labels displayed in the todo list
	priorityNames(2) = "MED"
	priorityNames(3) = "LOW"
End Sub

' ============================================================================
' REACTIVE PROGRAMMING - WHENEVER
' ============================================================================
' Whenever Section...End Whenever Section defines a named group of reactive watchers.
' This is a VisualGasic-exclusive feature with no VB6 or GDScript equivalent.
' The runtime monitors the specified variables and auto-fires handlers when conditions are met.
' Three condition types:
'   Changes  — fires whenever the variable's value changes at all
'   Becomes X — fires when the variable's value equals X (edge-triggered)
'   Exceeds X — fires when the variable crosses above X (edge-triggered)
Whenever Section TaskStatistics
	' "Changes" — fires every time completedTasks is assigned a new value.
	' This keeps pendingTasks in sync without manual recalculation everywhere.
	Whenever completedTasks Changes
		pendingTasks = totalTasks - completedTasks
		Print "Tasks remaining: " & Str(pendingTasks)
	End Whenever
	
	' "Becomes 0" — fires only when pendingTasks transitions to exactly 0.
	' Edge-triggered: won't fire again until pendingTasks changes away and back to 0.
	Whenever pendingTasks Becomes 0
		If totalTasks > 0 Then
			Print "🎉 ALL TASKS COMPLETED! 🎉"
		End If
	End Whenever
	
	' "Exceeds 10" — fires when pendingTasks crosses above 10.
	' Useful for threshold-based alerts without polling in _Process.
	Whenever pendingTasks Exceeds 10
		Print "⚠️ You have " & Str(pendingTasks) & " pending tasks!"
	End Whenever
End Whenever Section

' ============================================================================
' FILE I/O
' ============================================================================
' ---- VB6-STYLE FILE OUTPUT PATTERN ----
' The classic VB6 file I/O sequence: FreeFile → Open → Print # → Close #
' VisualGasic translates these to Godot's FileAccess API under the hood.
Sub SaveTodos()
	' FreeFile() returns the next available file handle number (1, 2, 3...).
	' This prevents file handle collisions when multiple files are open.
	Dim fileNum As Integer = FreeFile()
	
	' "Open ... For Output As #N" opens the file for writing.
	' "For Output" creates the file if missing, or overwrites if it exists.
	' The #fileNum syntax is VB6's file handle reference.
	Open SAVE_FILE For Output As #fileNum
	
	' Write the count first so LoadTodos knows how many records to expect
	Print #fileNum, todoCount
	
	' Write each todo's fields, one per line.
	' "Print #fileNum, value" writes value + newline to the file handle.
	' Each field is serialized on its own line for simple line-by-line reading.
	Dim i As Integer
	For i = 0 To todoCount - 1
		Print #fileNum, todos(i).Text       ' String field
		Print #fileNum, todos(i).Completed  ' Boolean (True/False)
		Print #fileNum, todos(i).Priority   ' Integer (1/2/3)
		Print #fileNum, todos(i).CreatedAt  ' Timestamp string
	Next
	
	' "Close #N" flushes buffered data and releases the file handle.
	' Always close files to prevent data loss or handle leaks.
	Close #fileNum
	
	Print "Saved " & Str(todoCount) & " todos to file"
End Sub

' ---- VB6-STYLE FILE INPUT PATTERN ----
' Mirror of SaveTodos: FreeFile → Open For Input → Input # → Close #
Sub LoadTodos()
	' FileExists() checks if the save file is present before reading.
	' Without this guard, "Open For Input" on a missing file would error.
	If Not FileExists(SAVE_FILE) Then
		Print "No saved todos found, starting fresh"
		CreateSampleTodos            ' Fall back to DATA-embedded sample todos
		Return
	End If
	
	Dim fileNum As Integer = FreeFile()
	
	' "Open ... For Input As #N" opens the file for sequential reading.
	' Data is read in the same order it was written by SaveTodos.
	Open SAVE_FILE For Input As #fileNum
	
	' "Input #fileNum, variable" reads the next line into the variable.
	' The runtime auto-converts types (String, Boolean, Integer) based on
	' the declared type of the target variable.
	Input #fileNum, todoCount
	
	' Read each todo's four fields in the exact order they were written
	Dim i As Integer
	For i = 0 To todoCount - 1
		Input #fileNum, todos(i).Text
		Input #fileNum, todos(i).Completed
		Input #fileNum, todos(i).Priority
		Input #fileNum, todos(i).CreatedAt
	Next
	
	Close #fileNum
	
	Print "Loaded " & Str(todoCount) & " todos from file"
End Sub

' Populates the todo list from embedded DATA statements (classic BASIC pattern).
' DATA/Read/Restore is inherited from VB6 — ideal for hardcoded sample data.
Sub CreateSampleTodos()
	' "Restore SampleTodos" moves the internal DATA read pointer to the
	' label "SampleTodos:". Without Restore, Read starts from the first DATA line.
	Restore SampleTodos
	
	Dim text As String
	Do
		' "Read variable" reads the next comma-separated value from DATA statements.
		' Values are consumed sequentially across all DATA lines after the label.
		Read text
		If text = "END" Then Exit Do  ' Sentinel value terminates the loop
		
		' Read can accept multiple variables in one call, separated by commas.
		Dim priority As Integer
		Dim completed As Integer
		Read priority, completed
		
		' (completed = 1) is a Boolean expression — converts 0/1 integer to True/False
		AddTodo text, priority, (completed = 1)
	Loop
End Sub

' DATA label — Restore jumps the Read pointer here.
' Each DATA line provides comma-separated literal values read sequentially.
' Format: "task text", priority (1=High, 2=Med, 3=Low), completed (1=yes, 0=no)
SampleTodos:
Data "Learn VisualGasic basics", 1, 1       ' Pre-completed high-priority task
Data "Build first game prototype", 1, 0     ' High priority, not yet done
Data "Read documentation", 2, 0
Data "Try Whenever system", 2, 0
Data "Explore threading features", 3, 0     ' Low priority
Data "Create demo project", 2, 0
Data "END", 0, 0                             ' Sentinel — the 0,0 satisfies Read for priority/completed

' ============================================================================
' TODO MANAGEMENT
' ============================================================================
' Adds a new todo to the end of the array and persists to disk.
Sub AddTodo(text As String, priority As Integer, completed As Boolean)
	' Bounds check — fixed-size array cannot grow beyond MAX_TODOS
	If todoCount >= MAX_TODOS Then
		Print "Maximum todos reached!"
		Return
	End If
	
	' Populate the next empty slot using dot notation on the TodoItem struct
	todos(todoCount).Text = text
	todos(todoCount).Completed = completed
	todos(todoCount).Priority = priority
	' FormatDateTime(Now(), format) formats the current date/time as a string.
	' Now() returns the system date/time — both are VB6 built-in functions.
	' "nn" = minutes ("mm" is already used for months in VB6 date formatting).
	todos(todoCount).CreatedAt = FormatDateTime(Now(), "yyyy-mm-dd hh:nn")
	
	todoCount = todoCount + 1
	
	' After mutating data, recalculate stats (triggers Whenever) and save to disk
	UpdateStatistics
	SaveTodos
End Sub

' Flips a todo's completion status (checked ↔ unchecked).
Sub ToggleTodo(index As Integer)
	' Guard clause — silently ignore out-of-range indices (VB6 single-line If)
	If index < 0 Or index >= todoCount Then Return
	
	' "Not" flips the Boolean: True→False, False→True (VB6 logical NOT operator)
	todos(index).Completed = Not todos(index).Completed
	
	UpdateStatistics               ' Triggers Whenever watchers
	SaveTodos                      ' Persist the change to disk
End Sub

' Removes a todo by index and compacts the array.
Sub DeleteTodo(index As Integer)
	If index < 0 Or index >= todoCount Then Return
	
	' Deletion in a fixed-size array: shift all elements after "index" one
	' position left. This overwrites the deleted item and keeps the array
	' contiguous — standard VB6 pattern for array element removal.
	Dim i As Integer
	For i = index To todoCount - 2
		todos(i) = todos(i + 1)    ' Struct assignment copies all fields
	Next
	
	todoCount = todoCount - 1
	
	' Adjust selection if it now points past the end of the list
	If selectedTodo >= todoCount Then
		selectedTodo = todoCount - 1
	End If
	
	UpdateStatistics
	SaveTodos
End Sub

' Removes all completed todos, keeping only active (uncompleted) ones.
' Demonstrates VisualGasic's Lambda expressions for filtering.
Sub ClearCompleted()
	' Strategy: collect indices of items to KEEP, then rebuild the array.
	' This avoids index-shifting bugs when removing multiple items in a loop.
	Dim keepIndices() As Integer
	Dim keepCount As Integer = 0
	
	Dim i As Integer
	For i = 0 To todoCount - 1
		' Lambda(t) creates an anonymous function with parameter "t" returning a Boolean.
		' "Lambda(t) Not t.Completed" is equivalent to:
		'   Function keep(t As TodoItem) As Boolean : Return Not t.Completed : End Function
		' This is a VisualGasic extension — VB6 has no lambda/anonymous function support.
		Dim keep As Boolean = Lambda(t) Not t.Completed
		' Invoke the lambda by calling it like a function: keep(todos(i))
		If keep(todos(i)) Then
			keepIndices(keepCount) = i
			keepCount = keepCount + 1
		End If
	Next
	
	' Rebuild: copy kept items into a fresh array to avoid gaps
	Dim newTodos(MAX_TODOS) As TodoItem
	For i = 0 To keepCount - 1
		newTodos(i) = todos(keepIndices(i))
	Next
	
	' Copy the compacted array back into the main todos() array
	For i = 0 To keepCount - 1
		todos(i) = newTodos(i)
	Next
	todoCount = keepCount
	
	selectedTodo = -1
	
	UpdateStatistics
	SaveTodos
	
	Print "Cleared completed tasks"
End Sub

' Recalculates all task statistics from the current array state.
' IMPORTANT: Assigning to completedTasks and pendingTasks here triggers
' the Whenever Section handlers above (Changes, Becomes, Exceeds).
' This is the bridge between imperative code and reactive programming.
Sub UpdateStatistics()
	totalTasks = todoCount
	
	' Count completed todos by iterating the full array
	completedTasks = 0
	Dim i As Integer
	For i = 0 To todoCount - 1
		If todos(i).Completed Then
			completedTasks = completedTasks + 1  ' This assignment fires "Whenever completedTasks Changes"
		End If
	Next
	
	pendingTasks = totalTasks - completedTasks  ' This may fire "Whenever pendingTasks Becomes/Exceeds"
End Sub

' ============================================================================
' FILTERING WITH LAMBDA
' ============================================================================
' Returns an Integer array of indices into todos() that pass the current filter.
' The result array is terminated with -1 as a sentinel (VB6 pattern for
' variable-length results in a fixed-size array).
' "As Integer()" declares the return type as an Integer array.
Function GetFilteredTodos() As Integer()
	Dim result(MAX_TODOS) As Integer
	Dim count As Integer = 0
	
	Dim i As Integer
	For i = 0 To todoCount - 1
		Dim include As Boolean = False
		
		' Select Case is VB6's switch/match statement — branches on filterMode
		Select Case filterMode
			Case 0  ' All — no filter, include everything
				include = True
			Case 1  ' Active only
				' Lambda creates a predicate function, then we invoke it on the todo.
				' Two-step pattern: assign lambda, then call it with the argument.
				include = Lambda(t) Not t.Completed
				include = include(todos(i))   ' Invoke lambda with current todo
			Case 2  ' Completed only
				' Same two-step Lambda pattern — filters for completed todos
				include = Lambda(t) t.Completed
				include = include(todos(i))   ' Invoke lambda with current todo
		End Select
		
		If include Then
			result(count) = i              ' Store the original index, not the todo itself
			count = count + 1
		End If
	Next
	
	' Sentinel value: -1 marks the end of valid data in the result array
	result(count) = -1
	
	Return result
End Function

' ============================================================================
' INPUT HANDLING
' ============================================================================
' _Process(delta) is Godot's per-frame callback (called every rendered frame).
' "delta" is seconds since last frame — used for framerate-independent updates.
' Here it delegates to HandleInput for polling-based keyboard checks each frame.
Sub _Process(delta As Single)
	HandleInput
End Sub

' Polling-based input handler — called every frame from _Process.
' Uses Godot's Input singleton to check keyboard state.
Sub HandleInput()
	' --- LIST NAVIGATION (Arrow Keys) ---
	' IsActionJustPressed detects the single frame a key is first pressed (no auto-repeat).
	' "ui_down"/"ui_up"/"ui_accept" are Godot's built-in input actions (Arrow keys / Enter).
	If Input.IsActionJustPressed("ui_down") Then
		selectedTodo = selectedTodo + 1
		If selectedTodo >= todoCount Then selectedTodo = 0  ' Wrap to top
	ElseIf Input.IsActionJustPressed("ui_up") Then
		selectedTodo = selectedTodo - 1
		If selectedTodo < 0 Then selectedTodo = todoCount - 1  ' Wrap to bottom
	End If
	
	' --- TOGGLE COMPLETION (Enter) ---
	If Input.IsActionJustPressed("ui_accept") Then
		ToggleTodo selectedTodo
	End If
	
	' --- DELETE (Shift+Delete or Shift+Backspace) ---
	' Requiring Shift prevents accidental deletion from a single keypress.
	If Input.IsKeyPressed(KEY_DELETE) Or Input.IsKeyPressed(KEY_BACKSPACE) Then
		If Input.IsKeyPressed(KEY_SHIFT) Then
			DeleteTodo selectedTodo
		End If
	End If
	
	' --- FILTER TABS (Number Keys 1/2/3) ---
	If Input.IsKeyPressed(KEY_1) Then filterMode = 0  ' All
	If Input.IsKeyPressed(KEY_2) Then filterMode = 1  ' Active
	If Input.IsKeyPressed(KEY_3) Then filterMode = 2  ' Completed
	
	' --- CLEAR COMPLETED (Ctrl+C) ---
	' Invokes the Lambda-based ClearCompleted subroutine
	If Input.IsKeyPressed(KEY_C) And Input.IsKeyPressed(KEY_CTRL) Then
		ClearCompleted
	End If
	
	' --- PRIORITY CYCLE (P key) ---
	' Cycles 1→2→3→1 using Mod arithmetic: (current Mod 3) + 1
	If Input.IsKeyPressed(KEY_P) Then
		If selectedTodo >= 0 And selectedTodo < todoCount Then
			todos(selectedTodo).Priority = (todos(selectedTodo).Priority Mod 3) + 1
			SaveTodos
		End If
	End If
End Sub

' _UnhandledInput is Godot's fallback — receives InputEvents not consumed by UI nodes.
' This handles character-by-character text entry for the new-todo input field.
Sub _UnhandledInput(event As InputEvent)
	' "TypeOf event Is InputEventKey" — VB6 runtime type check (like GDScript's "is").
	' Only process keyboard events; ignore mouse, touch, etc.
	If TypeOf event Is InputEventKey Then
		Dim keyEvent As InputEventKey = event  ' Cast to access keyboard-specific properties
		' Printable ASCII characters (Unicode 32-126) are appended to the input buffer.
		' Chr(unicode) converts an integer code point to a character — VB6 built-in.
		' "&" is the VB6 string concatenation operator.
		If keyEvent.Pressed And keyEvent.Unicode > 31 And keyEvent.Unicode < 127 Then
			inputText = inputText & Chr(keyEvent.Unicode)
		End If
		
		' Backspace — remove the last character from the input buffer.
		' Left(string, n) returns the leftmost n characters — classic VB6 string function.
		' Len() returns the string length.
		If keyEvent.Pressed And keyEvent.Keycode = KEY_BACKSPACE Then
			If Len(inputText) > 0 Then
				inputText = Left(inputText, Len(inputText) - 1)
			End If
		End If
		
		' Enter — submit the typed text as a new todo
		If keyEvent.Pressed And keyEvent.Keycode = KEY_ENTER Then
			If Len(inputText) > 0 Then
				AddTodo inputText, 2, False  ' Default to medium priority (2), not completed
				inputText = ""               ' Clear the input buffer after submission
			End If
		End If
	End If
End Sub

' ============================================================================
' RENDERING
' ============================================================================
' _Draw() is Godot's rendering callback — called every frame to paint the screen.
' All DrawRect/DrawString calls use pixel coordinates relative to this node's position.
' Color("#hex") creates a Godot Color from a CSS-style hex color string.
' DrawRect x, y, width, height, color — fills a rectangle.
' DrawString text, x, y, color, fontSize — renders text at the given position.
Sub _Draw()
	' Full-screen dark background
	DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color("#1a1a2e")
	
	' Header bar (darker blue) with title and subtitle
	DrawRect 0, 0, SCREEN_WIDTH, 80, Color("#16213e")
	DrawString "📝 TODO APP", 20, 15, Color.White, 28
	DrawString "VisualGasic UI Demo with File I/O & Lambda", 20, 50, Color("#888888"), 14
	
	' Input field — shows current typed text with a blinking cursor ("_")
	DrawRect 20, 90, SCREEN_WIDTH - 40, 40, Color("#0f3460")
	DrawString "New Task: " & inputText & "_", 30, 100, Color.White, 18
	
	' --- FILTER TABS ---
	' Array("All","Active","Completed") creates an inline VB6-style string array.
	Dim filters() As String = Array("All", "Active", "Completed")
	Dim tabX As Integer = 20   ' Horizontal offset, incremented per tab
	Dim i As Integer
	For i = 0 To 2
		Dim tabColor As Variant
		' Active tab is highlighted red; inactive tabs are purple
		If filterMode = i Then
			tabColor = Color("#e94560")   ' Red = selected
		Else
			tabColor = Color("#533483")   ' Purple = unselected
		End If
		DrawRect tabX, 140, 80, 30, tabColor
		DrawString filters(i), tabX + 10, 145, Color.White, 14
		tabX = tabX + 90              ' 80px tab + 10px gap
	Next
	
	' --- TODO LIST RENDERING ---
	' Render filtered todos as rows. GetFilteredTodos() returns an array of
	' original indices into todos(), terminated by -1 sentinel.
	Dim listY As Integer = 185                         ' Y-offset for the first row
	Dim filteredTodos() As Integer = GetFilteredTodos() ' Get indices matching current filter
	Dim visibleIndex As Integer = 0                     ' Counts rendered rows (for zebra striping)
	
	For i = 0 To MAX_TODOS - 1
		If filteredTodos(i) = -1 Then Exit For  ' Sentinel: no more items
		
		Dim todoIdx As Integer = filteredTodos(i)
		Dim todo As TodoItem = todos(todoIdx)
		
		' Row background — selection highlight or alternating zebra-stripe colors.
		' Mod 2 gives alternating 0/1 for even/odd row striping.
		Dim rowColor As Variant
		If todoIdx = selectedTodo Then
			rowColor = Color("#0f3460")   ' Bright blue = selected row
		ElseIf visibleIndex Mod 2 = 0 Then
			rowColor = Color("#1a1a2e")   ' Even rows
		Else
			rowColor = Color("#16213e")   ' Odd rows (slightly lighter)
		End If
		DrawRect 20, listY, SCREEN_WIDTH - 40, 35, rowColor
		
		' Checkbox — uses Choose() for inline conditional value selection.
		' Choose(condition, trueValue, falseValue) is a VB6 function:
		'   Returns Color.Green if Completed=True, dark gray if False.
		Dim checkColor As Variant = Choose(todo.Completed, Color.Green, Color("#444444"))
		DrawRect 30, listY + 7, 20, 20, checkColor
		If todo.Completed Then
			DrawString "✓", 33, listY + 8, Color.White, 16  ' Unicode checkmark
		End If
		
		' Priority indicator — thin colored bar using the lookup array
		DrawRect 60, listY + 7, 8, 20, priorityColors(todo.Priority)
		
		' Task text
		Dim textColor As Variant
		If todo.Completed Then
			textColor = Color("#666666")
		Else
			textColor = Color.White
		End If
		
		Dim displayText As String = todo.Text
		' Strikethrough simulation — wraps completed tasks in tildes (~text~)
		' since DrawString doesn't support text-decoration styling
		If todo.Completed Then
			displayText = "~" & displayText & "~"
		End If
		DrawString displayText, 80, listY + 8, textColor, 16
		
		' Priority label
		DrawString priorityNames(todo.Priority), SCREEN_WIDTH - 80, listY + 10, priorityColors(todo.Priority), 12
		
		listY = listY + 38
		visibleIndex = visibleIndex + 1
		
		' Cap at 8 visible rows to prevent overflow past the statistics bar
		If visibleIndex >= 8 Then Exit For
	Next
	
	' --- STATISTICS BAR (fixed at bottom) ---
	DrawRect 0, SCREEN_HEIGHT - 60, SCREEN_WIDTH, 60, Color("#16213e")
	
	' Str() converts Integer to String — VB6 type conversion function.
	' "&" concatenates strings; Str() + "&" is the VB6 equivalent of GDScript's str().
	Dim statsText As String = Str(totalTasks) & " total | " & Str(completedTasks) & " done | " & Str(pendingTasks) & " pending"
	DrawString statsText, 20, SCREEN_HEIGHT - 45, Color("#888888"), 16
	
	' --- PROGRESS BAR ---
	' Background track (dark gray) + filled portion (red) based on completion ratio.
	Dim progressWidth As Integer = SCREEN_WIDTH - 40
	DrawRect 20, SCREEN_HEIGHT - 20, progressWidth, 10, Color("#333333")  ' Track background
	If totalTasks > 0 Then
		' Single = VB6 single-precision float. Division gives 0.0–1.0 fraction.
		Dim progress As Single = completedTasks / totalTasks
		' Int() truncates to integer pixels for the filled bar width
		DrawRect 20, SCREEN_HEIGHT - 20, Int(progressWidth * progress), 10, Color("#e94560")
	End If
	
	' Persistent on-screen keyboard shortcut guide (small text, subtle color)
	DrawString "↑↓=Select | Enter=Toggle | P=Priority | Ctrl+C=Clear Done | 1/2/3=Filter", 20, SCREEN_HEIGHT - 55, Color("#555555"), 11
End Sub
