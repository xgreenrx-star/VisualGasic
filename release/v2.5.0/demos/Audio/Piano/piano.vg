' ============================================================================
' PIANO KEYBOARD - Audio Demo
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' Demonstrates:
' - PlayTone for generating musical notes
' - DATA statements for note frequencies
' - Keyboard input mapping
' - For Each iteration
' - Dictionary for key mapping
' ============================================================================
' VB6 idiom: Attribute VB_Name sets the module/class name exposed to Godot.
' This becomes the node name when loaded as a scene script.
Attribute VB_Name = "PianoKeyboard"

' ============================================================================
' LAYOUT CONSTANTS
' These define the piano rendering dimensions in pixels.
' The piano is drawn in _Draw() using DrawRect for each key.
' ============================================================================
Const SCREEN_WIDTH As Integer = 800    ' Viewport width in pixels
Const SCREEN_HEIGHT As Integer = 400   ' Viewport height in pixels
Const WHITE_KEY_WIDTH As Integer = 50   ' Width of each white piano key
Const WHITE_KEY_HEIGHT As Integer = 200 ' Height of white keys (taller than black)
Const BLACK_KEY_WIDTH As Integer = 30   ' Black keys are narrower than white
Const BLACK_KEY_HEIGHT As Integer = 120 ' Black keys are shorter, sit on top of whites

' ============================================================================
' NOTE DATA ARRAYS (populated from DATA statements via Read)
' VB6 idiom: Fixed-size arrays declared with Dim, filled at runtime.
' VisualGasic DATA/Read works like VB6: DATA stores literal values,
' Read pulls them sequentially, Restore resets the read pointer to a label.
' ============================================================================
Dim noteNames(20) As String      ' Piano key names: "C4", "C#4", "D4", etc.
Dim noteFrequencies(20) As Single ' Frequencies in Hz (e.g. A4=440.00) for PlayTone
Dim noteKeys(20) As String       ' Keyboard key mapped to this note ("A","W","S",...)
Dim noteIsBlack(20) As Boolean   ' True if this note is a black (sharp) key
Dim noteCount As Integer          ' How many notes were loaded from NoteData

' Currently playing notes — tracks which notes are actively sounding
Dim activeNotes(20) As Boolean   ' True while a note is held/playing
Dim noteTimers(20) As Single     ' Duration counter for each active note

' Visual feedback — drives the animated glow effect on pressed keys
Dim keyPressed(20) As Boolean    ' True while the physical key is held down (debounce state)
Dim keyGlow(20) As Single        ' Glow intensity 0.0-1.0; set to 1.0 on press, fades over time

' ============================================================================
' RECORDING SYSTEM
' Captures note index + timestamp pairs as the user plays. Timer() returns
' the current Godot time in seconds. Timestamps are later normalized so the
' first note starts at time 0, enabling instant playback.
' ============================================================================
Dim recordedNotes(500) As Integerr ' Array of note indices played during recording
Dim recordedTimes(500) As Single   ' Timestamp of each note (seconds since recording start)
Dim recordLength As Integer        ' Number of notes captured so far
Dim isRecording As Boolean         ' True while the user is recording
Dim isPlaying As Boolean           ' True during any playback (demo or user recording)
Dim isPlayingDemo As Boolean       ' True = playing built-in demo, False = playing user recording
Dim playbackTime As Single         ' Elapsed time since playback started (seconds)
Dim playbackIndex As Integer       ' Next note index to play in the playback arrays
Dim recordStartTime As Single      ' Timer() snapshot when recording began

' Demo song arrays — loaded from DemoSongData at startup
' Stores pre-composed "Mary Had a Little Lamb" as note-index/time pairs.
Dim demoSongNotes(100) As Integer  ' Note index into noteNames/noteFrequencies arrays
Dim demoSongTimes(100) As Single   ' When to play each note (seconds from start)
Dim demoSongLength As Integer      ' Total number of notes in the demo song

' Control key debounce flags.
' Godot's Input.IsKeyPressed() returns True every frame the key is held.
' These flags implement a "press-once" debounce pattern: the action fires
' only on the frame the key transitions from released to pressed.
Dim rKeyDown As Boolean    ' Debounce for R key (toggle recording)
Dim pKeyDown As Boolean    ' Debounce for P key (start playback of user recording)
Dim oneKeyDown As Boolean  ' Debounce for 1 key (start demo song playback)

' ============================================================================
' INITIALIZATION
' ============================================================================
' _Ready() is the Godot lifecycle callback — called once when the node enters
' the scene tree. VB6 equivalent: Form_Load(). Used here to print instructions
' to the Godot output console and load all DATA into arrays.
Sub _Ready()
	Print "=== PIANO KEYBOARD ==="
	Print "Audio Demo with PlayTone"
	Print ""
	Print "Keys: A-L for white keys, W-P for black keys"
	Print "R = Record, P = Playback, 1 = Demo Song"
	Print ""
	
	' Load note frequencies and demo song from DATA statements below
	LoadNoteData
	LoadDemoSong
End Sub

' Reads piano key definitions from the NoteData: DATA block.
' VB6 DATA/Read pattern:
'   Restore <label>  — resets the read pointer to a labeled DATA section
'   Read var1, var2   — reads the next values sequentially from DATA lines
' Each DATA line holds: NoteName, Frequency(Hz), KeyboardKey, IsBlack(0/1)
' The sentinel value "END" terminates the read loop.
Sub LoadNoteData()
	Restore NoteData         ' Point the Read cursor to the NoteData: label
	noteCount = 0
	
	Dim nName As String
	Do
		Read nName               ' Read the note name (e.g. "C4", "C#4", or "END")
		If nName = "END" Then Exit Do  ' Sentinel — stop reading
		
		noteNames(noteCount) = nName
		
		Dim freq As Single
		Dim key As String
		Dim isBlack As Integer
		
		' Read remaining fields from the same DATA line
		Read freq, key, isBlack
		
		noteFrequencies(noteCount) = freq           ' Hz value for PlayTone
		noteKeys(noteCount) = key                   ' Keyboard letter to map
		noteIsBlack(noteCount) = (isBlack = 1)      ' Convert 0/1 to Boolean
		
		noteCount = noteCount + 1
	Loop
	
	Print "Loaded " & Str(noteCount) & " piano keys"
End Sub

' Reads the pre-composed demo song ("Mary Had a Little Lamb") from DATA.
' Each DATA line holds a note index (into noteNames/noteFrequencies) and a
' time offset in seconds. Sentinel value -1 marks end-of-song.
Sub LoadDemoSong()
	Restore DemoSongData     ' Point Read cursor to DemoSongData: label
	demoSongLength = 0
	
	Dim noteIdx As Integer
	Do
		Read noteIdx             ' Read the note index (or -1 for end)
		If noteIdx = -1 Then Exit Do  ' Sentinel — all notes loaded
		
		demoSongNotes(demoSongLength) = noteIdx
		Read demoSongTimes(demoSongLength)  ' Read the time offset for this note
		
		demoSongLength = demoSongLength + 1
	Loop
	
	Print "Demo song loaded: " & Str(demoSongLength) & " notes"
End Sub

' ============================================================================
' NOTE DATA (frequencies in Hz)
' ============================================================================
' DATA label — Restore NoteData positions the Read cursor here.
' Each line: NoteName (string), Frequency in Hz (Single), Keyboard letter (String), IsBlack (0/1)
' White keys map to home row A-L; black (sharp) keys map to upper row W,E,T,Y,U,O.
' This mirrors a real piano layout on a QWERTY keyboard.
NoteData:
' Name, Frequency, Keyboard Key, IsBlack (0/1)
Data "C4", 261.63, "A", 0    ' Middle C — the starting note of the piano
Data "C#4", 277.18, "W", 1   ' C-sharp — first black key
Data "D4", 293.66, "S", 0
Data "D#4", 311.13, "E", 1
Data "E4", 329.63, "D", 0
Data "F4", 349.23, "F", 0
Data "F#4", 369.99, "T", 1
Data "G4", 392.00, "G", 0
Data "G#4", 415.30, "Y", 1
Data "A4", 440.00, "H", 0    ' A440 — concert pitch tuning standard
Data "A#4", 466.16, "U", 1   ' A-sharp
Data "B4", 493.88, "J", 0
Data "C5", 523.25, "K", 0
Data "C#5", 554.37, "O", 1
Data "D5", 587.33, "L", 0    ' Highest note on this keyboard
Data "END", 0, "", 0          ' Sentinel row — signals LoadNoteData to stop reading

' Demo song: "Mary Had a Little Lamb"
' Pre-composed melody using note indices (0=C4, 2=D4, 4=E4, 7=G4, etc.)
' TimeOffset is in seconds from start — used by UpdatePlayback() to trigger
' each note at the correct moment.
DemoSongData:
' NoteIndex, TimeOffset (seconds)
' Index 0=C4, 2=D4, 4=E4, 7=G4 — "Ma-ry had a lit-tle lamb"
Data 4, 0.0     ' E4 at t=0.0s  "Ma-"
Data 2, 0.4     ' D4 at t=0.4s  "-ry"
Data 0, 0.8     ' C4 at t=0.8s  "had"
Data 2, 1.2     ' D4 at t=1.2s  "a"
Data 4, 1.6     ' E4 at t=1.6s  "lit-"
Data 4, 2.0     ' E4 at t=2.0s  "-tle"
Data 4, 2.4     ' E4 at t=2.4s  "lamb" (held)
Data 2, 3.2
Data 2, 3.6
Data 2, 4.0
Data 4, 4.8
Data 7, 5.2
Data 7, 5.6
Data 4, 6.4
Data 2, 6.8
Data 0, 7.2
Data 2, 7.6
Data 4, 8.0
Data 4, 8.4
Data 4, 8.8
Data 4, 9.2
Data 2, 9.6
Data 2, 10.0
Data 4, 10.4
Data 2, 10.8
Data 0, 11.2    ' Final C4 note
Data -1, 0      ' Sentinel — signals LoadDemoSong to stop reading

' ============================================================================
' UPDATE
' ============================================================================
' _Process() is the Godot per-frame callback (VB6 equivalent: Timer event).
' Called every frame with delta = seconds since last frame (~0.016 at 60fps).
' Handles input, advances playback, and updates visual effects each frame.
Sub _Process(delta As Single)
	HandleKeyboardInput      ' Poll keyboard for note keys and control keys
	UpdatePlayback delta     ' Advance demo/recording playback by delta time
	UpdateVisuals delta      ' Fade out key glow effects
End Sub

' Polls all mapped keyboard keys each frame.
' Uses Godot's Input.IsKeyPressed(KEY_*) — returns True every frame
' the key is held. The keyPressed() array provides debounce so PlayNote
' only fires on the initial key-down, not every frame.
Sub HandleKeyboardInput()
	' Check each note's assigned key against Godot input state
	Dim i As Integer
	For i = 0 To noteCount - 1
		' Convert the note's letter ("A","W",etc.) to a Godot KEY_* constant
		Dim keyCode As Integer = GetKeyCode(noteKeys(i))
		
		If Input.IsKeyPressed(keyCode) Then
			' Key is held — only trigger on the initial press (debounce)
			If Not keyPressed(i) Then
				PlayNote i           ' Sound the note and optionally record it
				keyPressed(i) = True ' Mark as held to prevent re-triggering
			End If
		Else
			' Key was released — reset the debounce flag
			If keyPressed(i) Then
				StopNote i
				keyPressed(i) = False
			End If
		End If
	Next
	
	' --- DEBOUNCE PATTERN for control keys ---
	' Godot has no built-in "key just pressed" in _Process; Input.IsKeyPressed
	' is True every frame the key is held. So we track rKeyDown/pKeyDown/oneKeyDown
	' manually: fire action when key goes from False->True, ignore while held.
	'
	' R key — toggle recording on/off
	If Input.IsKeyPressed(KEY_R) Then
		If Not rKeyDown Then         ' First frame the key is pressed
			rKeyDown = True
			If Not isPlaying Then    ' Don't allow recording during playback
				ToggleRecording
			End If
		End If
	Else
		rKeyDown = False             ' Key released — re-arm the debounce
	End If
	
	' P key — play back user's recorded song
	If Input.IsKeyPressed(KEY_P) Then
		If Not pKeyDown Then         ' Debounce: only on initial press
			pKeyDown = True
			' Only play if idle, not recording, and there's something to play
			If Not isPlaying And Not isRecording And recordLength > 0 Then
				StartPlayback False  ' False = play user recording, not demo
			End If
		End If
	Else
		pKeyDown = False
	End If
	
	' 1 key — play the built-in demo song ("Mary Had a Little Lamb")
	If Input.IsKeyPressed(KEY_1) Then
		If Not oneKeyDown Then       ' Debounce: only on initial press
			oneKeyDown = True
			If Not isPlaying And Not isRecording Then
				StartPlayback True   ' True = play demo song data
			End If
		End If
	Else
		oneKeyDown = False
	End If
End Sub

' Converts a letter string ("A", "W", etc.) to a Godot KEY_* integer constant.
' VB6 idiom: Select Case is the equivalent of switch/case in other languages.
' KEY_A, KEY_S, etc. are Godot engine constants exposed to VisualGasic,
' representing physical keyboard scancodes used by Input.IsKeyPressed().
Function GetKeyCode(key As String) As Integer
	' Map letter string to Godot's integer key constant
	Select Case key
		Case "A": Return KEY_A    ' Home row for white keys
		Case "S": Return KEY_S
		Case "D": Return KEY_D
		Case "F": Return KEY_F
		Case "G": Return KEY_G
		Case "H": Return KEY_H
		Case "J": Return KEY_J
		Case "K": Return KEY_K
		Case "L": Return KEY_L
		Case "W": Return KEY_W
		Case "E": Return KEY_E
		Case "T": Return KEY_T
		Case "Y": Return KEY_Y
		Case "U": Return KEY_U
		Case "O": Return KEY_O
		Case "P": Return KEY_P
		Case Else: Return 0      ' Unknown key — return 0 (no match)
	End Select
End Function

' Sounds a piano note and optionally records it.
' PlayTone is a VisualGasic built-in that generates a sine wave tone through
' Godot's AudioServer. It takes frequency (Hz) and duration (milliseconds).
' Timer() returns the current engine time in seconds (like VB6's Timer function).
Sub PlayNote(noteIndex As Integer)
	If noteIndex < 0 Or noteIndex >= noteCount Then Exit Sub  ' Bounds check
	
	Dim freq As Single = noteFrequencies(noteIndex)
	PlayTone freq, 300  ' Generate a 300ms tone at the note's frequency
	
	activeNotes(noteIndex) = True  ' Mark note as sounding
	keyGlow(noteIndex) = 1.0      ' Set glow to full brightness (fades in UpdateVisuals)
	
	Print "Playing: " & noteNames(noteIndex) & " (" & Str(Int(freq)) & " Hz)"
	
	' If recording is active, capture this note and its timestamp
	If isRecording Then
		recordedNotes(recordLength) = noteIndex
		' Timer() - recordStartTime = seconds elapsed since recording started
		recordedTimes(recordLength) = Timer() - recordStartTime
		recordLength = recordLength + 1
	End If
End Sub

' Called when a key is released. Marks the note as inactive.
' (PlayTone handles its own duration, so this just updates tracking state.)
Sub StopNote(noteIndex As Integer)
	activeNotes(noteIndex) = False
End Sub

' Toggles recording on/off. When stopping, normalizes timestamps so the
' first recorded note has time=0. This way playback begins immediately
' instead of waiting for the gap between pressing R and the first note.
Sub ToggleRecording()
	If isRecording Then
		isRecording = False
		' --- Time normalization ---
		' Subtract the first note's timestamp from all notes so playback
		' starts at t=0 regardless of when the user began playing.
		If recordLength > 0 Then
			Dim firstTime As Single = recordedTimes(0)
			Dim i As Integer
			For i = 0 To recordLength - 1
				recordedTimes(i) = recordedTimes(i) - firstTime
			Next
		End If
		Print "Recording stopped: " & Str(recordLength) & " notes"
	Else
		' Start a new recording — reset counter and snapshot the current time
		isRecording = True
		recordLength = 0
		recordStartTime = Timer()  ' Timer() = current engine time in seconds
		Print "Recording started..."
	End If
End Sub

' Initializes playback state for either the demo song or user recording.
' useDemo=True reads from demoSongNotes/demoSongTimes arrays;
' useDemo=False reads from recordedNotes/recordedTimes arrays.
' Both use the same time-based playback engine in UpdatePlayback().
Sub StartPlayback(useDemo As Boolean)
	isPlaying = True
	isPlayingDemo = useDemo   ' Selects which data arrays to read from
	playbackTime = 0          ' Reset the playback clock
	playbackIndex = 0         ' Start from the first note in the sequence
	
	If useDemo Then
		Print "Playing demo song..."
	Else
		Print "Playing recording (" & Str(recordLength) & " notes)..."
	End If
End Sub

' Time-based playback engine called every frame from _Process().
' Accumulates delta time and fires notes when their stored timestamp
' is reached. The Do While loop catches up if multiple notes fall
' within the same frame (e.g. at low framerates).
Sub UpdatePlayback(delta As Single)
	If Not isPlaying Then Exit Sub  ' Nothing to do if playback is off
	
	playbackTime = playbackTime + delta  ' Advance the playback clock
	
	If isPlayingDemo Then
		' --- Demo song playback ---
		' Fire all notes whose timestamp <= current playbackTime
		Do While playbackIndex < demoSongLength
			If playbackTime >= demoSongTimes(playbackIndex) Then
				PlayNote demoSongNotes(playbackIndex)  ' Sound the note
				playbackIndex = playbackIndex + 1      ' Advance to next note
			Else
				Exit Do  ' Next note is in the future — wait for more frames
			End If
		Loop
		If playbackIndex >= demoSongLength Then
			isPlaying = False  ' All notes played — stop
			Print "Demo song finished"
		End If
	Else
		' --- User recording playback --- (same logic, different arrays)
		Do While playbackIndex < recordLength
			If playbackTime >= recordedTimes(playbackIndex) Then
				PlayNote recordedNotes(playbackIndex)
				playbackIndex = playbackIndex + 1
			Else
				Exit Do  ' Next note hasn't been reached yet
			End If
		Loop
		If playbackIndex >= recordLength Then
			isPlaying = False
			Print "Recording playback finished"
		End If
	End If
End Sub

' Fades the visual glow effect on each key over time.
' keyGlow() starts at 1.0 when a note plays and decays toward 0.
' At delta*3, a full glow fades out in ~0.33 seconds.
Sub UpdateVisuals(delta As Single)
	Dim i As Integer
	For i = 0 To noteCount - 1
		' Fade key glow by 3x delta per frame (linear decay)
		If keyGlow(i) > 0 Then
			keyGlow(i) = keyGlow(i) - delta * 3
			If keyGlow(i) < 0 Then keyGlow(i) = 0  ' Clamp to zero
		End If
	Next
End Sub

' ============================================================================
' RENDERING
' ============================================================================
' _Draw() is the Godot rendering callback — called every frame after _Process().
' VisualGasic drawing API:
'   DrawRect x, y, w, h, color [, filled]  — draw a rectangle (filled=True by default)
'   DrawString text, x, y, color, size     — draw text at position
'   Color(r,g,b) or Color("#hex")          — create color values
'   Choose(cond, trueVal, falseVal)        — inline conditional (like IIf in VB6)
'
' RENDERING ORDER: White keys are drawn first, then black keys on top.
' This is the painter's algorithm — later draws cover earlier ones.
Sub _Draw()
	' Fill the entire background with dark gray
	DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color("#222222")
	
	' --- PASS 1: Draw white keys ---
	' whiteKeyIndex counts only white keys for horizontal positioning
	Dim whiteKeyIndex As Integer = 0
	Dim i As Integer
	For i = 0 To noteCount - 1
		If Not noteIsBlack(i) Then
			' Position: skip black keys in layout, offset 50px from left edge
			Dim x As Integer = whiteKeyIndex * WHITE_KEY_WIDTH + 50
			Dim y As Integer = 100  ' Top of the keyboard area
			
			' --- White key color with glow effect ---
			' Variant type because Color() returns a Godot Color object
			Dim keyColor As Variant
			If keyPressed(i) Or keyGlow(i) > 0 Then
				' Choose(condition, trueVal, falseVal) — VisualGasic inline conditional
				' If key is held: full glow (1.0). If released: use fading keyGlow value.
				Dim glow As Single = Choose(keyPressed(i), 1.0, keyGlow(i))
				' Warm tint: red stays full, green/blue decrease with glow intensity
				' At full glow: Color(1.0, 0.7, 0.5) = warm orange-white
				keyColor = Color(1.0, 1.0 - glow * 0.3, 1.0 - glow * 0.5)
			Else
				keyColor = Color.White  ' No activity — standard white key
			End If
			
			' Draw filled rectangle for the key body, then an outline border on top.
			' The "-2" creates a 2px gap between adjacent white keys.
			' DrawRect last param: True=filled (default), False=outline only.
			DrawRect x, y, WHITE_KEY_WIDTH - 2, WHITE_KEY_HEIGHT, keyColor
			DrawRect x, y, WHITE_KEY_WIDTH - 2, WHITE_KEY_HEIGHT, Color.Black, False
			
			' Draw keyboard shortcut letter and note name at bottom of each key
			DrawString noteKeys(i), x + 18, y + WHITE_KEY_HEIGHT - 30, Color("#666666"), 16
			DrawString noteNames(i), x + 10, y + WHITE_KEY_HEIGHT - 50, Color("#999999"), 12
			
			whiteKeyIndex = whiteKeyIndex + 1
		End If
	Next
	
	' --- PASS 2: Draw black keys on top of white keys ---
	' Must be drawn second so they visually overlap the white keys (painter's algorithm).
	whiteKeyIndex = 0
	Dim prevWasBlack As Boolean = False
	For i = 0 To noteCount - 1
		If Not noteIsBlack(i) Then
			whiteKeyIndex = whiteKeyIndex + 1  ' Track white key position
			prevWasBlack = False
		Else
			' Black keys sit between two white keys — centered on the right edge
			' of the preceding white key. Offset = whiteKey right edge - half black width.
			Dim x As Integer = (whiteKeyIndex - 1) * WHITE_KEY_WIDTH + 50 + WHITE_KEY_WIDTH - BLACK_KEY_WIDTH / 2
			Dim y As Integer = 100  ' Same top as white keys
			
			' --- Black key color with glow effect ---
			Dim keyColor As Variant
			If keyPressed(i) Or keyGlow(i) > 0 Then
				Dim glow As Single = Choose(keyPressed(i), 1.0, keyGlow(i))
				' Cool blue tint for black keys: subtle purple glow when pressed
				' At full glow: Color(0.3, 0.3, 0.5) = muted blue-purple
				keyColor = Color(glow * 0.3, glow * 0.3, glow * 0.5)
			Else
				keyColor = Color("#111111")  ' Near-black when idle
			End If
			
			' Black keys have no outline border — just a filled rectangle
			DrawRect x, y, BLACK_KEY_WIDTH, BLACK_KEY_HEIGHT, keyColor
			
			' Key label
			DrawString noteKeys(i), x + 8, y + BLACK_KEY_HEIGHT - 25, Color("#888888"), 14
			
			prevWasBlack = True
		End If
	Next
	
	' --- HUD: Instructions at top of screen ---
	DrawString "Piano Keyboard - Press keys A-L (white) and W-P (black)", 50, 20, Color.White, 20
	DrawString "R = Record | P = Play Recording | 1 = Demo Song", 50, 50, Color("#888888"), 16
	
	' --- Status indicator at bottom of screen ---
	' Shows the current mode with color-coded text:
	'   Red    = actively recording
	'   Green  = playing back a song
	'   Cyan   = idle with a recording ready to play
	Dim statusText As String
	If isRecording Then
		statusText = "RECORDING... (" & Str(recordLength) & " notes)"
		DrawString statusText, 50, SCREEN_HEIGHT - 50, Color.Red, 20
	ElseIf isPlaying Then
		statusText = "PLAYING..."
		DrawString statusText, 50, SCREEN_HEIGHT - 50, Color.Green, 20
	End If
	
	' Show saved recording info when idle (not recording or playing)
	If recordLength > 0 And Not isRecording And Not isPlaying Then
		DrawString "Recording: " & Str(recordLength) & " notes (press P to play)", 50, SCREEN_HEIGHT - 50, Color.Cyan, 16
	End If
End Sub
