' ============================================================================
' PIXEL PLATFORMER - 2D Platformer Demo
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' Demonstrates:
' - Gravity, jumping, and ground collision (manual CharacterBody-style physics)
' - Tile-based level design loaded from DATA statements
' - Animated player sprite (drawn with primitives)
' - Patrolling enemies with stomp-to-kill mechanic
' - Collectible coins with bob animation
' - Scrolling camera that follows the player
' - HUD overlay with score, lives, and level indicator
' - Multiple levels with increasing difficulty
' - Game state management (title → play → death → game over → victory)
' ============================================================================
' Based on the official Godot 2D Platformer demo concepts.
' Converted to VisualGasic to showcase Godot engine integration
' with VB6-style BASIC syntax.
' ============================================================================
Attribute VB_Name = "Platformer"

' --- Screen constants ---
Const SCREEN_WIDTH As Integer = 640
Const SCREEN_HEIGHT As Integer = 480

' --- Physics constants ---
Const GRAVITY As Single = 1800.0        ' Gravity acceleration (px/sec²)
Const JUMP_VELOCITY As Single = -620.0  ' Initial jump speed (negative = upward)
Const WALK_SPEED As Single = 250.0      ' Horizontal movement speed (px/sec)
Const TERMINAL_VELOCITY As Single = 900.0  ' Max fall speed (px/sec)
Const COYOTE_TIME As Single = 0.08      ' Seconds after leaving edge where jump still works
Const JUMP_BUFFER As Single = 0.1       ' Seconds before landing where jump input is remembered

' --- Tile & level constants ---
Const TILE_SIZE As Integer = 32         ' Each tile is 32×32 pixels
Const MAX_LEVEL_WIDTH As Integer = 80   ' Max tiles per row
Const MAX_LEVEL_HEIGHT As Integer = 20  ' Max rows per level
Const MAX_COINS As Integer = 50         ' Max collectible coins per level
Const MAX_ENEMIES As Integer = 20       ' Max patrolling enemies per level

' --- Player state ---
Dim playerX As Single       ' Player X position (left edge, world coords)
Dim playerY As Single       ' Player Y position (top edge, world coords)
Dim playerVX As Single      ' Horizontal velocity (px/sec)
Dim playerVY As Single      ' Vertical velocity (px/sec; positive = downward)
Dim playerWidth As Integer  ' Player hitbox width (pixels)
Dim playerHeight As Integer ' Player hitbox height (pixels)
Dim playerOnGround As Boolean   ' True if player is standing on a solid tile
Dim playerFacing As Integer     ' 1 = facing right, -1 = facing left
Dim playerLives As Integer      ' Remaining lives
Dim playerScore As Integer      ' Accumulated score across all levels
Dim playerDead As Boolean       ' True during death animation
Dim deathTimer As Single        ' Countdown during death sequence
Dim coyoteTimer As Single       ' Time remaining for coyote-time jump
Dim jumpBufferTimer As Single   ' Time remaining for buffered jump
Dim animTimer As Single         ' Animation timer for walk cycle
Dim doubleJumpReady As Boolean  ' True if player can still double-jump in this airborne phase
Dim playerInvincible As Boolean ' Brief invincibility after taking damage
Dim invincibleTimer As Single   ' Countdown for invincibility frames

' --- Camera state ---
Dim cameraX As Single       ' Camera X offset (world coords of left screen edge)
Dim cameraY As Single       ' Camera Y offset (world coords of top screen edge)

' --- Level data ---
' The level is stored as a 2D grid of characters loaded from DATA statements.
' '#' = solid   '.' = empty   'C' = coin   'E' = enemy   'P' = player start
' 'M' = moving platform start  'S' = spike (instant kill)
Dim levelGrid(MAX_LEVEL_WIDTH, MAX_LEVEL_HEIGHT) As String
Dim levelWidth As Integer   ' Actual width of current level (tiles)
Dim levelHeight As Integer  ' Actual height of current level (rows)
Dim currentLevel As Integer ' Current level number (1-based)
Dim totalLevels As Integer  ' Total number of levels available
Dim levelComplete As Boolean ' True when player reaches the exit flag

' --- Coin entity arrays ---
Dim coinX(MAX_COINS) As Single      ' Coin X position (world coords, center)
Dim coinY(MAX_COINS) As Single      ' Coin Y position (world coords, center)
Dim coinActive(MAX_COINS) As Boolean ' True if coin hasn't been collected yet
Dim coinCount As Integer             ' Number of coins placed in current level
Dim coinsCollected As Integer        ' How many coins collected in current level

' --- Enemy entity arrays ---
Dim enemyX(MAX_ENEMIES) As Single       ' Enemy X position (world coords, left edge)
Dim enemyY(MAX_ENEMIES) As Single       ' Enemy Y position (world coords, top edge)
Dim enemyVX(MAX_ENEMIES) As Single      ' Enemy horizontal velocity (patrol direction)
Dim enemyActive(MAX_ENEMIES) As Boolean ' True if enemy is alive
Dim enemyWidth As Integer               ' Enemy hitbox width
Dim enemyHeight As Integer              ' Enemy hitbox height
Dim enemyCount As Integer               ' Number of enemies in current level
Dim enemyAnimTimer(MAX_ENEMIES) As Single ' Per-enemy animation timer

' --- Moving platforms ---
Const MAX_PLATFORMS As Integer = 10
Dim platX(MAX_PLATFORMS) As Single       ' Platform X (world coords)
Dim platY(MAX_PLATFORMS) As Single       ' Platform Y (world coords)
Dim platStartX(MAX_PLATFORMS) As Single  ' Starting X for oscillation
Dim platStartY(MAX_PLATFORMS) As Single  ' Starting Y for oscillation
Dim platDirX(MAX_PLATFORMS) As Single    ' Movement direction X (0 or 1)
Dim platDirY(MAX_PLATFORMS) As Single    ' Movement direction Y (0 or 1)
Dim platActive(MAX_PLATFORMS) As Boolean
Dim platCount As Integer
Dim platTimer As Single                  ' Shared oscillation timer

' --- Particle effects ---
Const MAX_PARTICLES As Integer = 60
Dim partX(MAX_PARTICLES) As Single
Dim partY(MAX_PARTICLES) As Single
Dim partVX(MAX_PARTICLES) As Single
Dim partVY(MAX_PARTICLES) As Single
Dim partLife(MAX_PARTICLES) As Single
Dim partColor(MAX_PARTICLES) As Variant

' --- Game state ---
Dim gameState As String     ' "TITLE", "PLAYING", "DEAD", "GAMEOVER", "VICTORY"
Dim stateTimer As Single    ' General-purpose timer for state transitions
Dim totalTime As Single     ' Total play time in seconds (for speedrun display)

' --- Background decoration ---
Const MAX_CLOUDS As Integer = 8
Dim cloudX(MAX_CLOUDS) As Single
Dim cloudY(MAX_CLOUDS) As Single
Dim cloudWidth(MAX_CLOUDS) As Single
Dim cloudSpeed(MAX_CLOUDS) As Single

' ============================================================================
' INITIALIZATION
' ============================================================================

Sub _Ready()
	Print "=== PIXEL PLATFORMER ==="
	Print "A 2D Platformer Demo for VisualGasic"
	Print ""
	Print "Controls:"
	Print "  A/D or Left/Right = Move"
	Print "  Space or W or Up  = Jump"
	Print "  Escape            = Pause/Title"
	Print ""

	playerWidth = 24
	playerHeight = 32
	enemyWidth = 28
	enemyHeight = 24
	totalLevels = 3

	InitClouds
	gameState = "TITLE"
	stateTimer = 0
End Sub

Sub InitClouds()
	Dim i As Integer
	For i = 0 To MAX_CLOUDS - 1
		cloudX(i) = Rnd() * (SCREEN_WIDTH + 200) - 100
		cloudY(i) = 20 + Rnd() * 160
		cloudWidth(i) = 60 + Rnd() * 80
		cloudSpeed(i) = 8 + Rnd() * 15
	Next
End Sub

Sub StartNewGame()
	playerLives = 3
	playerScore = 0
	currentLevel = 1
	totalTime = 0
	LoadLevel currentLevel
	gameState = "PLAYING"
End Sub

' ============================================================================
' LEVEL LOADING FROM DATA STATEMENTS
' ============================================================================
' Each level is defined as a series of DATA strings — one string per tile row.
' This is the classic BASIC approach to level design: embed the map directly
' in the source code using human-readable ASCII art.

Sub LoadLevel(levelNum As Integer)
	' Reset all entity arrays
	Dim i As Integer
	For i = 0 To MAX_COINS - 1
		coinActive(i) = False
	Next
	For i = 0 To MAX_ENEMIES - 1
		enemyActive(i) = False
	Next
	For i = 0 To MAX_PLATFORMS - 1
		platActive(i) = False
	Next
	For i = 0 To MAX_PARTICLES - 1
		partLife(i) = 0
	Next
	coinCount = 0
	coinsCollected = 0
	enemyCount = 0
	platCount = 0
	levelComplete = False
	platTimer = 0

	' Select which DATA label to Restore based on level number
	Select Case levelNum
		Case 1
			Restore Level1Data
		Case 2
			Restore Level2Data
		Case 3
			Restore Level3Data
		Case Else
			Restore Level1Data
	End Select

	' Read level dimensions
	Read levelWidth
	Read levelHeight

	' Read each row of the level grid
	Dim row As Integer
	Dim col As Integer
	Dim rowStr As String

	For row = 0 To levelHeight - 1
		Read rowStr
		For col = 0 To levelWidth - 1
			Dim ch As String
			If col < Len(rowStr) Then
				ch = Mid(rowStr, col + 1, 1)
			Else
				ch = "."
			End If

			' Process special tiles and place entities
			Select Case ch
				Case "P"
					' Player start position
					playerX = col * TILE_SIZE
					playerY = row * TILE_SIZE - playerHeight + TILE_SIZE
					playerVX = 0
					playerVY = 0
					playerOnGround = False
					playerFacing = 1
					playerDead = False
					coyoteTimer = 0
					jumpBufferTimer = 0
					doubleJumpReady = False
					playerInvincible = False
					invincibleTimer = 0
					animTimer = 0
					levelGrid(col, row) = "."  ' Player start tile is walkable

				Case "C"
					' Place a coin entity
					If coinCount < MAX_COINS Then
						coinX(coinCount) = col * TILE_SIZE + TILE_SIZE / 2
						coinY(coinCount) = row * TILE_SIZE + TILE_SIZE / 2
						coinActive(coinCount) = True
						coinCount = coinCount + 1
					End If
					levelGrid(col, row) = "."  ' Coin tile is walkable

				Case "E"
					' Place an enemy entity
					If enemyCount < MAX_ENEMIES Then
						enemyX(enemyCount) = col * TILE_SIZE
						enemyY(enemyCount) = row * TILE_SIZE + TILE_SIZE - enemyHeight
						enemyVX(enemyCount) = 60  ' Patrol speed (px/sec), positive = right
						enemyActive(enemyCount) = True
						enemyAnimTimer(enemyCount) = Rnd() * 6.28
						enemyCount = enemyCount + 1
					End If
					levelGrid(col, row) = "."  ' Enemy tile is walkable

				Case "M"
					' Moving platform
					If platCount < MAX_PLATFORMS Then
						platX(platCount) = col * TILE_SIZE
						platY(platCount) = row * TILE_SIZE
						platStartX(platCount) = col * TILE_SIZE
						platStartY(platCount) = row * TILE_SIZE
						platDirX(platCount) = 1  ' Horizontal movement
						platDirY(platCount) = 0
						platActive(platCount) = True
						platCount = platCount + 1
					End If
					levelGrid(col, row) = "."  ' Moving platform tile handled separately

				Case Else
					levelGrid(col, row) = ch
			End Select
		Next
	Next

	' Initialize camera to player position
	cameraX = playerX - SCREEN_WIDTH / 2
	cameraY = playerY - SCREEN_HEIGHT / 2
	ClampCamera

	Print "Level " & Str(levelNum) & " loaded: " & Str(levelWidth) & "x" & Str(levelHeight)
	Print "Coins: " & Str(coinCount) & "  Enemies: " & Str(enemyCount)
End Sub

Sub ClampCamera()
	' Keep camera within level bounds
	Dim maxCamX As Single = levelWidth * TILE_SIZE - SCREEN_WIDTH
	Dim maxCamY As Single = levelHeight * TILE_SIZE - SCREEN_HEIGHT
	If cameraX < 0 Then cameraX = 0
	If cameraY < 0 Then cameraY = 0
	If maxCamX > 0 And cameraX > maxCamX Then cameraX = maxCamX
	If maxCamY > 0 And cameraY > maxCamY Then cameraY = maxCamY
End Sub

' ============================================================================
