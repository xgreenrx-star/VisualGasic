' Simple enemy that patrols back and forth
Extends CharacterBody2D

Private speed As Single = 100
Private direction As Single = 1
Private gravity As Single = 980

Sub _Ready()
	' Enemy is ready
End Sub

Sub _PhysicsProcess(delta As Single)
	' Apply gravity
	If Not IsOnFloor() Then
		Me.Velocity = New Vector2(Me.Velocity.X, Me.Velocity.Y + gravity * delta)
	Else
		Me.Velocity = New Vector2(Me.Velocity.X, 0)
	End If

	' Move back and forth
	Me.Velocity = New Vector2(direction * speed, Me.Velocity.Y)

	' Check if we hit a wall or edge
	Dim collision As KinematicCollision2D = MoveAndCollide(Me.Velocity * delta)
	If collision < > Nothing Then
		' Hit something, turn around
		direction = direction * - 1
	End If

	' Also turn around if not on floor (at edge)
	If Not IsOnFloor() Then
		direction = direction * - 1
	End If
End Sub
