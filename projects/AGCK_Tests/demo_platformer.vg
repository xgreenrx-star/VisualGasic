' Event: On Start
Sub Form_Load()
End Sub

' Event: On Frame
Sub Form_Process(ByVal delta As Single)
	velY = velY + 980 * delta
	posX = posX + velX * delta
	posY = posY + velY * delta
	GetNode("Player").position.x = posX
	GetNode("Player").position.y = posY
End Sub

' Event: Key: Jump
Sub Key_Jump_Event()
	velY = -400
End Sub

' Event: Key: Left
Sub Key_Left_Event()
	velX = -200
End Sub

' Event: Key: Right
Sub Key_Right_Event()
	velX = 200
End Sub

' Event: On Collision
Sub Form_Collision(ByVal other As String)
	velY = 0
	onGround = 1
End Sub

