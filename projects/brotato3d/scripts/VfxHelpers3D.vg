' Shared 3D juice spawners — muzzle flash, sparkles, hit pops
Attribute VB_Name = "VfxHelpers3D"

Const VFX_SCENE As String = "res://scenes/VfxParticle3D.tscn"

Dim _cachedVfxScene As Object

Function GetVfxScene() As Object
	If _cachedVfxScene Is Nothing Then
		Set _cachedVfxScene = Load(VFX_SCENE)
	End If
	Set GetVfxScene = _cachedVfxScene
End Function

Sub SpawnFade3D(parent As Object, pos As Object, col As Color, radius As Single, life As Single, vel As Object)
	If parent Is Nothing Then Exit Sub
	Dim scene As Object
	Set scene = GetVfxScene()
	If scene Is Nothing Then Exit Sub
	Dim fx As Object
	Set fx = scene.instantiate()
	parent.add_child(fx)
	fx.global_position = pos
	fx.SetupMotion(col, radius, life, vel)
End Sub

Sub SpawnMuzzleFlash3D(parent As Object, pos As Object, dir As Object, col As Color)
	Dim i As Integer
	For i = 0 To 3
		Dim spread As Single
		spread = (Rnd() - 0.5) * 0.9
		Dim vel As Object
		vel = RotateDirY(dir, spread) * (4.0 + Rnd() * 3.0)
		Dim flashCol As Color
		flashCol = Color(1.0, 0.95, 0.7, 1.0)
		If i Mod 2 = 0 Then flashCol = col
		Call SpawnFade3D(parent, pos, flashCol, 0.12 + Rnd() * 0.08, 0.07 + Rnd() * 0.04, vel)
	Next i
End Sub

Sub SpawnHitPop3D(parent As Object, pos As Object)
	Call SpawnFade3D(parent, pos, Color(1.0, 0.95, 0.35, 1.0), 0.18, 0.1, Vector3(0, 0.5, 0))
	Dim i As Integer
	For i = 0 To 1
		Dim vel As Object
		vel = Vector3(Rnd() * 2 - 1, 0.3 + Rnd() * 0.5, Rnd() * 2 - 1).normalized() * (2.5 + Rnd() * 2.0)
		Call SpawnFade3D(parent, pos, Color(1.0, 0.5, 0.2, 1.0), 0.08, 0.12, vel)
	Next i
End Sub

Sub SpawnPickupSparkle3D(parent As Object, pos As Object, toward As Object)
	Dim dir As Object
	dir = (toward - pos).normalized()
	Dim vel As Object
	vel = dir * (2.0 + Rnd() * 1.5) + Vector3(Rnd() * 2 - 1, 0.2, Rnd() * 2 - 1) * 0.5
	Call SpawnFade3D(parent, pos, Color(0.55, 1.0, 0.45, 1.0), 0.1, 0.18, vel)
End Sub

Sub SpawnPickupBurst3D(parent As Object, pos As Object)
	Dim i As Integer
	For i = 0 To 5
		Dim ang As Single
		ang = 6.2831853 * i / 6.0 + Rnd() * 0.4
		Dim vel As Object
		vel = Vector3(Cos(ang), 0.3, Sin(ang)) * (2.5 + Rnd() * 2.0)
		Call SpawnFade3D(parent, pos, Color(0.45, 1.0, 0.35, 1.0), 0.1, 0.22, vel)
	Next i
End Sub

Function RotateDirY(dir As Object, angle As Single) As Object
	Dim c As Single
	Dim s As Single
	c = Cos(angle)
	s = Sin(angle)
	RotateDirY = Vector3(dir.x * c - dir.z * s, 0.0, dir.x * s + dir.z * c)
End Function
