' Short-lived 3D blob — trails, muzzle flash, pickup sparkles
Extends Node3D

Dim meshNode As Object
Dim mat As Object
Dim lifetime As Single
Dim maxLife As Single
Dim velocity As Object
Dim baseRadius As Single
Dim baseColor As Color

Sub _Ready()
	meshNode = GetNode("MeshInstance3D")
End Sub

Sub SetupMotion(col As Color, radius As Single, life As Single, vel As Object)
	lifetime = life
	maxLife = life
	baseRadius = radius
	baseColor = col
	velocity = vel
	If Not meshNode Is Nothing Then
		meshNode.scale = Vector3(radius, radius, radius)
		Dim srcMat As Object
		srcMat = meshNode.get_active_material(0)
		If Not srcMat Is Nothing Then
			Set mat = srcMat.duplicate()
			meshNode.set_surface_override_material(0, mat)
			mat.albedo_color = col
		End If
	End If
End Sub

Sub _Process(delta As Single)
	If lifetime <= 0 Then Exit Sub
	lifetime = lifetime - delta
	Dim pos As Object
	pos = Me.global_position
	Me.global_position = pos + velocity * delta
	Dim a As Single
	a = lifetime / maxLife
	If a < 0 Then a = 0
	If Not mat Is Nothing Then
		mat.albedo_color = Color(baseColor.r, baseColor.g, baseColor.b, baseColor.a * a)
	End If
	If Not meshNode Is Nothing Then
		Dim s As Single
		s = baseRadius * (0.35 + a * 0.65)
		meshNode.scale = Vector3(s, s, s)
	End If
	If lifetime <= 0 Then Me.queue_free()
End Sub
