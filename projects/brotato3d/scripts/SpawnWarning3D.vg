' Ground ring warning before enemy spawn (3D)
Extends Node3D

Event finished()

Const BLINK_HZ As Single = 8.0

Dim duration As Single
Dim radius As Single
Dim elapsed As Single
Dim done As Boolean
Dim ringMesh As Object

Sub _Ready()
	duration = 0.85
	radius = 1.4
	elapsed = 0.0
	done = False
	ringMesh = GetNode("Ring")
End Sub

Sub SetBig()
	duration = 1.5
	radius = 3.5
End Sub

Sub _Process(delta As Single)
	If done Then Exit Sub
	elapsed = elapsed + delta
	Dim t As Single
	t = elapsed / duration
	If t > 1 Then t = 1
	Dim pulse As Single
	pulse = Abs(Sin(elapsed * BLINK_HZ * 3.14159265))
	Dim scaleVal As Single
	scaleVal = radius * (0.6 + t * 0.5 + pulse * 0.15)
	If Not ringMesh Is Nothing Then
		ringMesh.scale = Vector3(scaleVal, 1.0, scaleVal)
		Dim mat As Object
		mat = ringMesh.get_active_material(0)
		If Not mat Is Nothing Then
			mat.albedo_color = Color(1.0, 0.35, 0.3, 0.35 + pulse * 0.45)
		End If
	End If
	If elapsed >= duration Then
		done = True
		RaiseEvent finished()
		Me.queue_free()
	End If
End Sub
