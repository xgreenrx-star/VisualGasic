' Kenney blocky skins — Godot GLTF import leaves external PNGs unbound; apply at runtime.
Attribute VB_Name = "CharacterSkins3D"

Const TEX_DIR As String = "res://assets/models/kenney_blocky/textures/"
Const SHADOW_OFF As Integer = 0

Dim _texCache As Object
Dim _matCache As Object

Sub EnsureTexCache()
	If _texCache Is Nothing Then
		Set _texCache = New Dictionary
	End If
	If _matCache Is Nothing Then
		Set _matCache = New Dictionary
	End If
End Sub

Function SkinLetter(skinId As String) As String
	Dim prefix As String
	prefix = "character-"
	If Len(skinId) > Len(prefix) Then
		If Left(skinId, Len(prefix)) = prefix Then
			SkinLetter = Mid(skinId, Len(prefix) + 1)
			Exit Function
		End If
	End If
	SkinLetter = skinId
End Function

Function LoadSkinTex(skinId As String) As Object
	Call EnsureTexCache()
	Dim key As String
	key = SkinLetter(skinId)
	If _texCache(key) Is Nothing Then
		Dim path As String
		path = TEX_DIR & "texture-" & key & ".png"
		If ResourceLoader.exists(path) Then
			_texCache(key) = Load(path)
		End If
	End If
	LoadSkinTex = _texCache(key)
End Function

Function GetSkinMaterial(skinId As String) As Object
	Call EnsureTexCache()
	Dim key As String
	key = SkinLetter(skinId)
	If _matCache(key) Is Nothing Then
		Dim tex As Object
		tex = LoadSkinTex(skinId)
		If tex Is Nothing Then Exit Function
		Dim mat As Object
		Set mat = ClassDB.Instantiate("StandardMaterial3D")
		mat.albedo_texture = tex
		mat.albedo_color = Color(1, 1, 1, 1)
		_matCache(key) = mat
	End If
	GetSkinMaterial = _matCache(key)
End Function

Sub ApplyKenneySkin(root As Object, skinId As String)
	If root Is Nothing Then Exit Sub
	Dim mat As Object
	Set mat = GetSkinMaterial(skinId)
	If mat Is Nothing Then Exit Sub
	Call ApplyMatRecursive(root, mat)
End Sub

Sub ApplyMatRecursive(node As Object, mat As Object)
	If node Is Nothing Then Exit Sub
	Dim cls As String
	cls = node.get_class()
	If cls = "MeshInstance3D" Then
		node.cast_shadow = SHADOW_OFF
		Dim surfCount As Integer
		surfCount = 1
		Dim mesh As Object
		mesh = node.mesh
		If Not mesh Is Nothing Then
			surfCount = mesh.get_surface_count()
		End If
		If surfCount <= 0 Then surfCount = 1
		Dim i As Integer
		For i = 0 To surfCount - 1
			node.set_surface_override_material(i, mat)
		Next i
	End If
	Dim c As Integer
	For c = 0 To node.get_child_count() - 1
		Call ApplyMatRecursive(node.get_child(c), mat)
	Next c
End Sub

Sub FaceMoveDirection(pivot As Object, pos As Object, dirX As Single, dirZ As Single)
	If pivot Is Nothing Then Exit Sub
	If pos Is Nothing Then Exit Sub
	' Kenney GLBs face +Z; LookAt points -Z at target so aim behind movement.
	Dim target As Vector3
	target = pos - Vector3(dirX, 0, dirZ)
	pivot.LookAt(target, Vector3(0, 1, 0))
End Sub
