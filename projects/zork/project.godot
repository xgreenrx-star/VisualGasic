; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Zork I: The Great Underground Empire"
config/description="A faithful VG reimplementation of the classic Infocom text adventure by Marc Blank, Dave Lebling, Bruce Daniels, and Tim Anderson."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

VGDebugHandler="*uid://bba4n02t2dx1g"

[display]

window/size/viewport_width=900
window/size/viewport_height=700
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_gasic/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"

[audio]

driver/enable_input=true
