func _draw_panel_chrome(panel: Rect2, title: String, accent: Color) -> void:
	canvas.call(
		"DrawRect",
		panel,
		0.0,
		Color(0, 0, 0, 0),
		true,
		Color(0.01, 0.015, 0.035, 0.62)
	)
	var header := Rect2(panel.position.x, panel.position.y, panel.size.x, 20.0)
	canvas.call(
		"DrawRect",
		header,
		0.0,
		Color(0, 0, 0, 0),
		true,
		Color(accent.r * 0.12, accent.g * 0.12, accent.b * 0.12, 0.88)
	)
	canvas.call(
		"DrawVectorText",
		panel.position + Vector2(10.0, 14.0),
		title,
		Color(accent.r, accent.g, accent.b, 0.92),
		0.68,
		1.0,
		"left",
		0.0,
		""
	)
	var p0 := panel.position
	var p1 := panel.position + Vector2(panel.size.x, 0.0)
	var p2 := panel.position + panel.size
	var p3 := panel.position + Vector2(0.0, panel.size.y)
	var edge := Color(accent.r, accent.g, accent.b, 0.38)
	canvas.call("DrawLine", p0, p1, 1.2, edge)
	canvas.call("DrawLine", p1, p2, 1.2, edge)
	canvas.call("DrawLine", p2, p3, 1.2, edge)
	canvas.call("DrawLine", p3, p0, 1.2, edge)


func _panel_content_fade(content: Rect2, y: float, top_fade: float, bot_fade: float) -> float:
	var top := content.position.y
	var bot := content.position.y + content.size.y
	if y < top or y > bot:
		return 0.0
	var a := smoothstep(top, top + top_fade, y)
	a *= smoothstep(bot, bot - bot_fade, y)
	return a



func _draw_feature_crawl(panel: Rect2) -> void:
	_draw_panel_chrome(panel, "FEATURES", Color(0.98, 0.86, 0.38))
	var scroll_t := _panel_scroll_time()
	var body := Rect2(panel.position.x, panel.position.y + 22.0, panel.size.x, panel.size.y - 22.0)
	var vanish_x := body.position.x + body.size.x * 0.5
	var line_count := _crawl_lines.size()
	if line_count == 0:
		return
	var scroll := fmod(scroll_t * CRAWL_SPEED, float(line_count) * CRAWL_LINE_SP)
	var content_top := body.position.y
	var content_bot := body.position.y + body.size.y
	var anchor := content_bot + 36.0 - scroll
	var k_lo := int(floor((content_top - CRAWL_LINE_SP - anchor) / CRAWL_LINE_SP))
	var k_hi := int(ceil((content_bot + CRAWL_LINE_SP - anchor) / CRAWL_LINE_SP))

	for k in range(k_lo, k_hi + 1):
		var y := anchor + float(k) * CRAWL_LINE_SP
		var idx := posmod(k, line_count)
		var crawl_line: String = _crawl_lines[idx]
		var fade := _panel_content_fade(body, y, 36.0, 48.0)
		if fade <= 0.01:
			continue
		var depth := clampf((y - body.position.y) / maxf(body.size.y - 8.0, 1.0), 0.0, 1.0)
		var scale := lerpf(0.42, 1.08, depth)
		var col := Color(0.98, 0.88, 0.42, fade * 0.94)
		canvas.call(
			"DrawVectorTextCentered",
			Vector2(vanish_x, y),
			crawl_line,
			col,
			scale,
			1.25,
			1.0,
			""
		)


func _draw_benchmark_terminal(panel: Rect2) -> void:
	_draw_panel_chrome(panel, "BENCHMARKS", Color(0.38, 0.98, 0.68))
	var scroll_t := _panel_scroll_time()
	var body := Rect2(panel.position.x, panel.position.y + 22.0, panel.size.x, panel.size.y - 22.0)
	var x := body.position.x + 12.0
	var line_count := BENCHMARK_LOG_LINES.size()
	var scroll := fmod(scroll_t * TERMINAL_SPEED, float(line_count) * TERMINAL_LINE_SP)
	var content_top := body.position.y
	var content_bot := body.position.y + body.size.y
	var anchor := content_bot + 8.0 - scroll
	var k_lo := int(floor((content_top - TERMINAL_LINE_SP - anchor) / TERMINAL_LINE_SP))
	var k_hi := int(ceil((content_bot + TERMINAL_LINE_SP - anchor) / TERMINAL_LINE_SP))

	for k in range(k_lo, k_hi + 1):
		var y := anchor + float(k) * TERMINAL_LINE_SP
		var idx := posmod(k, line_count)
		var line: String = BENCHMARK_LOG_LINES[idx]
		if line.is_empty():
			continue
		var fade := _panel_content_fade(body, y, 28.0, 36.0)
		if fade <= 0.01:
			continue
		var col: Color
		if line.find("X FASTER") >= 0 or line.begins_with("SCORE"):
			col = Color(0.42, 1.0, 0.68, fade * 0.95)
		elif line.begins_with(" VG ") or line.begins_with(" CPP"):
			col = Color(0.72, 0.95, 1.0, fade * 0.9)
		elif line.find("SUITE") >= 0 or line.begins_with("VS C++") or line.begins_with("SPEED") or line.begins_with("SAME") or line.begins_with("IDENTICAL") or line.begins_with("HOW LONG") or line.begins_with("COMPUTE") or line.begins_with("DRAW ") or line.begins_with("CPP STILL"):
			col = Color(0.98, 0.86, 0.38, fade * 0.92)
		else:
			col = Color(0.55, 0.88, 1.0, fade * 0.78)
		canvas.call(
			"DrawVectorText",
			Vector2(x, y),
			line,
			col,
			0.88,
			1.15,
			"left",
			0.0,
			""
		)


func _draw_border_words() -> void:
	if belt_letters.is_empty():
		return

	var palette: Array[Color] = [
		Color(0.45, 1.0, 1.0, 1.0),
		Color(1.0, 0.92, 0.35, 1.0),
		Color(0.55, 1.0, 0.65, 1.0),
		Color(1.0, 0.65, 0.95, 1.0),
	]
	var li := 0
	for entry in belt_letters:
		var ch: String = entry["ch"]
		if ch == " ":
			continue
		var s_char: float = _normalize_near(float(entry["s"]), pac_s)
		var frame := _path_frame(s_char)
		var cw_angle: float = frame.angle
		var read_angle: float = frame.get("read_angle", cw_angle)
		var wave_phase: float = t * WAVE_FREQ + float(li) * 0.07
		var col: Color = palette[li % palette.size()]
		col.a = 0.94
		var wave_off: float = sin(wave_phase) * WAVE_AMP
		var origin: Vector2 = frame.pos + _path_normal(cw_angle) * wave_off

		if _has_path_text:
			canvas.call(
				"DrawVectorTextPath",
				origin,
				cw_angle,
				read_angle,
				ch,
				col,
				BANNER_SCALE,
				1.65,
				0.0,
				""
			)
		else:
			canvas.call(
				"DrawVectorText",
				origin,
				ch,
				col,
				BANNER_SCALE,
				1.65,
				"left",
				0.0,
				""
			)
		li += 1


func _draw_pacman() -> void:
	var frame := _path_frame(pac_s)
	var pos: Vector2 = frame.pos
	var angle: float = frame.angle
	var mouth: float = 0.22 + chomp * 0.55 + absf(sin(t * 9.0)) * 0.12
	var radius := 14.0

	canvas.call("SetAdditiveBlend", false)
	canvas.call(
		"DrawCircle",
		pos,
		radius,
		Color(1.0, 0.88, 0.0, 1.0),
		true,
		Color(1.0, 0.88, 0.0, 1.0)
	)

	var p1 := pos + Vector2(cos(angle + mouth), sin(angle + mouth)) * radius * 1.05
	var p2 := pos + Vector2(cos(angle - mouth), sin(angle - mouth)) * radius * 1.05
	var pts := PackedVector2Array([pos, p1, p2, pos])
	canvas.call(
		"DrawPolyline",
		pts,
		1.0,
		Color(0.008, 0.012, 0.028, 1.0),
		true,
		Color(0.008, 0.012, 0.028, 1.0),
		true
	)

	if chomp > 0.05:
		canvas.call("SetAdditiveBlend", true)
		canvas.call(
			"DrawCircle",
			pos,
			radius * (1.0 + chomp * 0.35),
			Color(1.0, 0.95, 0.2, chomp * 0.45),
			false,
			Color(0, 0, 0, 0)
		)
		canvas.call("SetAdditiveBlend", false)


