func _tagline_scroll_width(scale: float, spacing: float) -> float:
	return _estimate_word_width(TAGLINE, scale, spacing)


func _draw_tagline_scroller() -> void:
	if not _has_wave_text:
		return

	var scale := 2.15
	var spacing := 2.0
	var width := _tagline_scroll_width(scale, spacing)
	var gap := 140.0
	var period := width + gap
	var x0 := fmod(-t * RIBBON_SPEED, period)
	var pulse := 0.78 + 0.22 * sin(t * 2.1)
	var col := Color(0.3 * pulse, 0.92 * pulse, 1.0 * pulse, 0.9 * pulse)

	canvas.call(
		"DrawRect",
		Rect2(0.0, RIBBON_Y - 28.0, SW, 56.0),
		0.0,
		Color(0, 0, 0, 0),
		true,
		Color(0.0, 0.0, 0.0, 0.28)
	)
	canvas.call("SetAdditiveBlend", true)
	for i in 3:
		var x_off: float = x0 + float(i) * period
		canvas.call(
			"DrawVectorTextWave",
			TAGLINE,
			x_off,
			RIBBON_Y,
			t,
			col,
			scale,
			2.2,
			RIBBON_WAVE_AMP,
			RIBBON_WAVE_FREQ,
			RIBBON_WAVE_SPEED,
			spacing,
			false,
			""
		)
	canvas.call("SetAdditiveBlend", false)


