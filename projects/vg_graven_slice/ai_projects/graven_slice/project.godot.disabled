; Engine configuration file.
; GRAVEN vertical slice — Visual Gasic 6 flagship demo

config_version=5

[application]

config/name="GRAVEN (VG6 slice)"
config/description="Mass-gravity cave explorer — flagship Visual Gasic demo"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

VGDebugHandler="*uid://bba4n02t2dx1g"

[display]

window/size/viewport_width=1280
window/size/viewport_height=704
window/stretch/mode="viewport"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_gasic/plugin.cfg")

