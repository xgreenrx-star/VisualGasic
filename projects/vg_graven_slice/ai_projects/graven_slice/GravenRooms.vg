' GravenRooms.vg — room tile maps, mass tables, spawn/exit transitions (R2 mass physics fix)

Dim exitCount As Integer
Dim exitTX(7) As Integer
Dim exitTY(7) As Integer
Dim spikeCount As Integer
Dim spikeTX(47) As Integer
Dim spikeTY(47) As Integer
Dim gateCount As Integer
Dim gateTX(15) As Integer
Dim gateTY(15) As Integer

' Handler: CacheRoomMarkers — E / S / G lists so gameplay never scans 40×22
Sub CacheRoomMarkers()
	Dim tx As Integer
	Dim ty As Integer
	Dim ch As String
	exitCount = 0
	spikeCount = 0
	gateCount = 0
	For ty = 0 To ROWS - 1
		For tx = 0 To COLS - 1
			ch = tileChar(tx, ty)
			If ch = "E" Then
				If exitCount < 8 Then
					exitTX(exitCount) = tx
					exitTY(exitCount) = ty
					exitCount = exitCount + 1
				End If
			ElseIf ch = "S" Then
				If spikeCount < 48 Then
					spikeTX(spikeCount) = tx
					spikeTY(spikeCount) = ty
					spikeCount = spikeCount + 1
				End If
			ElseIf ch = "G" Then
				If gateCount < 16 Then
					gateTX(gateCount) = tx
					gateTY(gateCount) = ty
					gateCount = gateCount + 1
				End If
			End If
		Next tx
	Next ty
End Sub

' Handler: CacheExitTiles — kept for older Call sites
Sub CacheExitTiles()
	Call CacheRoomMarkers()
End Sub

' Handler: LoadRoomTiles — parse ASCII Data rows into tileChar grid for roomId
Sub LoadRoomTiles()
	Dim ty As Integer
	Dim row As String
	For ty = 0 To ROWS - 1
		Call ClearRoomRow(ty)
	Next ty
	If roomId < 1 Or roomId > 17 Then Exit Sub
	Restore "R" + CStr(roomId) + "Map"
	For ty = 0 To ROWS - 1
		Read row
		Call ParseRoomRow(row, ty)
	Next ty
	Call CacheRoomMarkers()
	Call CacheLogTiles()
End Sub

' Handler: ApplyExitShaderParams — watery mouths on E tiles (hub has five)
Sub ApplyExitShaderParams()
	Dim n As Integer
	Dim uv As Variant
	If postMaterial = Null Then Exit Sub
	n = exitCount
	If n > 5 Then n = 5
	Shader.Param postMaterial, "exit_count", n
	If n > 0 Then
		uv = Vector2((exitTX(0) * TILE + 16) / GAME_W, (exitTY(0) * TILE + 16) / GAME_H)
		Shader.Param postMaterial, "exit_uv0", uv
	Else
		Shader.Param postMaterial, "exit_uv0", Vector2(-1, -1)
	End If
	If n > 1 Then
		uv = Vector2((exitTX(1) * TILE + 16) / GAME_W, (exitTY(1) * TILE + 16) / GAME_H)
		Shader.Param postMaterial, "exit_uv1", uv
	Else
		Shader.Param postMaterial, "exit_uv1", Vector2(-1, -1)
	End If
	If n > 2 Then
		uv = Vector2((exitTX(2) * TILE + 16) / GAME_W, (exitTY(2) * TILE + 16) / GAME_H)
		Shader.Param postMaterial, "exit_uv2", uv
	Else
		Shader.Param postMaterial, "exit_uv2", Vector2(-1, -1)
	End If
	If n > 3 Then
		uv = Vector2((exitTX(3) * TILE + 16) / GAME_W, (exitTY(3) * TILE + 16) / GAME_H)
		Shader.Param postMaterial, "exit_uv3", uv
	Else
		Shader.Param postMaterial, "exit_uv3", Vector2(-1, -1)
	End If
	If n > 4 Then
		uv = Vector2((exitTX(4) * TILE + 16) / GAME_W, (exitTY(4) * TILE + 16) / GAME_H)
		Shader.Param postMaterial, "exit_uv4", uv
	Else
		Shader.Param postMaterial, "exit_uv4", Vector2(-1, -1)
	End If
End Sub

' Handler: ClearRoomRow — fill one row with air markers
Sub ClearRoomRow(ty As Integer)
	Dim tx As Integer
	For tx = 0 To COLS - 1
		tileChar(tx, ty) = "."
	Next tx
End Sub

' Handler: ParseRoomRow — copy row string into tileChar (40 cols)
Sub ParseRoomRow(row As String, ty As Integer)
	Dim tx As Integer
	Dim ch As String
	For tx = 0 To COLS - 1
		If tx < Len(row) Then
			ch = Mid(row, tx + 1, 1)
		Else
			ch = "."
		End If
		tileChar(tx, ty) = ch
	Next tx
End Sub

' Handler: IsSolidTile — # and closed G gate block pod/crate; OOB solid
Function IsSolidTile(tx As Integer, ty As Integer) As Boolean
	Dim ch As String
	If tx < 0 Or tx >= COLS Or ty < 0 Or ty >= ROWS Then
		IsSolidTile = True
		Exit Function
	End If
	ch = tileChar(tx, ty)
	If ch = "#" Then
		IsSolidTile = True
		Exit Function
	End If
	' Gate tiles stay solid until the room's challenge is beaten
	If ch = "G" And Not ChallengeOpen() Then
		IsSolidTile = True
		Exit Function
	End If
	IsSolidTile = False
End Function

' Handler: IsSpikeTile — S cells kill pod on touch (R5 hazard row)
Function IsSpikeTile(tx As Integer, ty As Integer) As Boolean
	If tx < 0 Or tx >= COLS Or ty < 0 Or ty >= ROWS Then
		IsSpikeTile = False
		Exit Function
	End If
	IsSpikeTile = (tileChar(tx, ty) = "S")
End Function

' Handler: IsGateTile — G marker for draw overlay (not # solid)
Function IsGateTile(tx As Integer, ty As Integer) As Boolean
	If tx < 0 Or tx >= COLS Or ty < 0 Or ty >= ROWS Then
		IsGateTile = False
		Exit Function
	End If
	IsGateTile = (tileChar(tx, ty) = "G")
End Function

' Handler: LoadRoomMasses — inverse-square sources per BLUEPRINT.md
Sub LoadRoomMasses()
	massCount = 0
	Select Case roomId
		Case 1
			massCount = 1
			massX(0) = 640
			massY(0) = 780
			massS(0) = 2.0
		Case 2
			' R2 Bend — M1 loft pulls into ceiling channel (BLUEPRINT 0.6 / 1.8)
			massCount = 2
			massX(0) = 640
			massY(0) = 780
			massS(0) = 0.8
			massX(1) = 1040
			massY(1) = 320
			massS(1) = 2.2
		Case 3
			massCount = 1
			massX(0) = 640
			massY(0) = -60
			massS(0) = 0.85
		Case 4
			massCount = 1
			massX(0) = 640
			massY(0) = 780
			massS(0) = 1.0
		Case 5
			massCount = 2
			massX(0) = 200
			massY(0) = 400
			massS(0) = 1.4
			massX(1) = 1080
			massY(1) = 400
			massS(1) = 1.4
		Case 6
			massCount = 1
			massX(0) = 640
			massY(0) = 352
			massS(0) = 2.5
		Case 7
			massCount = 1
			massX(0) = 640
			massY(0) = 780
			massS(0) = 1.2
		Case 8
			massCount = 0
		Case 9
			massCount = 1
			massX(0) = 640
			massY(0) = 240
			massS(0) = 1.8
		Case 10
			massCount = 2
			massX(0) = 280
			massY(0) = 520
			massS(0) = 2.0
			massX(1) = 1000
			massY(1) = 200
			massS(1) = 2.0
		Case 11
			massCount = 1
			massX(0) = 400
			massY(0) = 360
			massS(0) = 2.2
		Case 12
			massCount = 1
			massX(0) = 520
			massY(0) = 400
			massS(0) = 1.4
		Case 13
			massCount = 1
			massX(0) = 640
			massY(0) = 500
			massS(0) = 1.1
		Case 14
			massCount = 1
			massX(0) = 1000
			massY(0) = 140
			massS(0) = 5.0
		Case 15
			massCount = 1
			massX(0) = 600
			massY(0) = 240
			massS(0) = 5.2
		Case 16
			massCount = 1
			massX(0) = 640
			massY(0) = 360
			massS(0) = 8.6
		Case 17
			massCount = 0
	End Select
End Sub

' Handler: ResetPodSpawn — pixel spawn from BLUEPRINT markers / tables
Sub ResetPodSpawn()
	podVX = 0
	podVY = 0
	podAngle = 0
	Select Case roomId
		Case 1
			podX = 272
			podY = 560
		Case 2
			podX = 48
			podY = 560
		Case 3
			podX = 112
			podY = 560
		Case 4
			podX = 144
			podY = 496
		Case 5
			podX = 144
			podY = 528
		Case 6
			podX = 80
			podY = 560
		Case 7
			podX = 48
			podY = 368
		Case 8
			podX = 220
			podY = 368
		Case 9
			podX = 220
			podY = 368
		Case 10
			podX = 220
			podY = 200
		Case 11
			podX = 220
			podY = 500
		Case 12
			podX = 220
			podY = 80
		Case 13
			podX = 220
			podY = 500
		Case 14
			podX = 220
			podY = 368
		Case 15
			podX = 640
			podY = 120
		Case 16
			podX = 640
			podY = 520
		Case 17
			podX = 220
			podY = 368
		Case Else
			podX = 64
			podY = 560
	End Select
End Sub

' Handler: GetRoomStinger — short vector title for the room-enter sting
Function GetRoomStinger() As String
	Select Case roomId
		Case 1
			GetRoomStinger = "AIRLOCK"
		Case 2
			GetRoomStinger = "BEND"
		Case 3
			GetRoomStinger = "SHELF"
		Case 4
			GetRoomStinger = "CRATE"
		Case 5
			GetRoomStinger = "DARK POOL"
		Case 6
			GetRoomStinger = "ORBIT"
		Case 7
			GetRoomStinger = "HEAT RUN"
		Case 8
			GetRoomStinger = "CORE HUB"
		Case 9
			GetRoomStinger = "STEAL"
		Case 10
			GetRoomStinger = "PHASE"
		Case 11
			GetRoomStinger = "WARP"
		Case 12
			GetRoomStinger = "TOW"
		Case 13
			GetRoomStinger = "LASER"
		Case 14
			GetRoomStinger = "CROSSROADS"
		Case 15
			GetRoomStinger = "FIELD"
		Case 16
			GetRoomStinger = "HORIZON"
		Case 17
			GetRoomStinger = "ARCHIVE"
		Case Else
			GetRoomStinger = "GRAVEN"
	End Select
End Function

' Handler: GetRoomCaption — HUD title string
Function GetRoomCaption() As String
	Select Case roomId
		Case 1
			GetRoomCaption = "GRAVEN — Room 1 Airlock"
		Case 2
			GetRoomCaption = "GRAVEN — Room 2 Bend"
		Case 3
			GetRoomCaption = "GRAVEN — Room 3 Shelf"
		Case 4
			GetRoomCaption = "GRAVEN — Room 4 Crate"
		Case 5
			GetRoomCaption = "GRAVEN — Room 5 Dark pool"
		Case 6
			GetRoomCaption = "GRAVEN — Room 6 Orbit"
		Case 7
			GetRoomCaption = "GRAVEN — Room 7 Heat run"
		Case 8
			GetRoomCaption = "GRAVEN — Core Hub"
		Case 9
			GetRoomCaption = "GRAVEN — Steal the well"
		Case 10
			GetRoomCaption = "GRAVEN — Phase lock"
		Case 11
			GetRoomCaption = "GRAVEN — Warp bubble"
		Case 12
			GetRoomCaption = "GRAVEN — Tow the ring"
		Case 13
			GetRoomCaption = "GRAVEN — Laser sluice"
		Case 14
			GetRoomCaption = "GRAVEN — Crossroads"
		Case 15
			GetRoomCaption = "GRAVEN — Singularity field"
		Case 16
			GetRoomCaption = "GRAVEN — Horizon"
		Case 17
			GetRoomCaption = "GRAVEN — Archive"
		Case Else
			GetRoomCaption = "GRAVEN"
	End Select
End Function

' Handler: GetRoomHint — status bar blurb
Function GetRoomHint() As String
	Select Case roomId
		Case 1
			GetRoomHint = "Fly east along the floor — glowing exit leads to Room 2"
		Case 2
			GetRoomHint = "Curve into the ceiling channel — fly into the EXIT glow"
		Case 3
			GetRoomHint = "Floor alcove — thrust UP the left ramp, east along shelf to EXIT"
		Case 4
			GetRoomHint = "Push crate onto floor plate (F at terminal for log)"
		Case 5
			GetRoomHint = "Pulse wakes a hidden well — slip spikes, fly the mouth east"
		Case 6
			If orbitComplete Then
				GetRoomHint = "Orbit gate open — exit east"
			Else
				GetRoomHint = "Orbit the mass (80–200 px) — 540° opens east gate"
			End If
		Case 7
			GetRoomHint = "Amber band cooks the suit — coast through, recharge on the sides"
		Case 8
			If HubBalanced() Then
				GetRoomHint = "Core balanced — fly the skiff"
			Else
				GetRoomHint = "Choose: E steal (opens the world) / S phase / N warp / SW tow / NE lasers"
			End If
		Case 9
			GetRoomHint = "F steals the well — west hub, east the world"
		Case 10
			GetRoomHint = "Wells are tori — Pulse snaps which ring pulls; grab the east seed"
		Case 11
			GetRoomHint = "Time crawls near the well — take the magenta seed west"
		Case 12
			GetRoomHint = "F hooks the gold ring — it hangs toward the well. Haul it to the east dock"
		Case 13
			GetRoomHint = "Lasers kill — slip the gaps, grab the seed, west home"
		Case 14
			GetRoomHint = "N horizon (challenge) / E archive / S field / W steal"
		Case 15
			GetRoomHint = "Skirt the lesser mouth — F log in the west alcove"
		Case 16
			If challengeHorizon Then
				GetRoomHint = "Gate open — north to warp, south to crossroads"
			Else
				GetRoomHint = "Take the rim seed without kissing the dark — south retreats"
			End If
		Case 17
			GetRoomHint = "Three logs. West back to the crossroads"
		Case Else
			GetRoomHint = ""
	End Select
End Function

' Handler: LoadRoom — swap tiles, masses, entities, beacon saves
Sub LoadRoom(newId As Integer)
	roomId = newId
	Call LoadRoomTiles()
	Call LoadRoomMasses()
	Call InitRoomObjects()
	Call InitPulseForRoom()
	Call InitOrbitForRoom()
	Call InitHeatForRoom()
	Call InitTowForRoom()
	Call ResetPodSpawn()
	Call ApplyEnterSpawn()
	doorLock = 0.55
	statusText = GetRoomHint()
	If roomId = 4 Then
		Call SetBeaconCheckpointAt(4, 144, 496)
	End If
	If roomId = 6 Then
		Call SetBeaconCheckpointAt(6, 3 * TILE + 16, 2 * TILE + 16)
	End If
	If roomId = 8 Then
		Call SetBeaconCheckpointAt(8, 220, 368)
	End If
	If roomLabel <> Null Then
		roomLabel.Caption = GetRoomCaption()
	End If
	Call RebuildVectorCave()
	Call JuiceOnRoomLoad()
	needRedraw = True
End Sub

' Handler: WarpThroughExit — LoadRoom plus a 1s carry-over screen warp
Sub WarpThroughExit(newId As Integer)
	warpFromExit = True
	Call LoadRoom(newId)
End Sub

' Handler: PodInZone — pod circle overlaps exit trigger (not center-point only)
Function PodInZone(zx As Single, zy As Single, zw As Single, zh As Single) As Boolean
	PodInZone = CircleRectOverlap(podX, podY, POD_R + 1, zx, zy, zw, zh)
End Function

' Handler: PodOnExitTile — must overlap the E cell itself (not a 80px pad)
Function PodOnExitTile(tx As Integer, ty As Integer) As Boolean
	PodOnExitTile = PodInZone(tx * TILE + 8, ty * TILE + 8, TILE - 16, TILE - 16)
End Function

' Handler: PodNearExitMarker — overlap any E tile in current room map
Function PodNearExitMarker() As Boolean
	Dim i As Integer
	For i = 0 To exitCount - 1
		If PodOnExitTile(exitTX(i), exitTY(i)) Then
			PodNearExitMarker = True
			Exit Function
		End If
	Next i
	PodNearExitMarker = False
End Function

' Handler: TryRoomTransition — E tiles + special south/gate exits
Sub TryRoomTransition()
	If doorLock > 0 Then Exit Sub
	Select Case roomId
		Case 1, 2, 3, 5
			If PodNearExitMarker() Then
				Call WarpThroughExit(roomId + 1)
			End If
		Case 4
			If plateSatisfied Then
				If PodInZone(19 * TILE + 8, 20 * TILE + 8, TILE, TILE - 8) Then
					Call WarpThroughExit(5)
				End If
			End If
		Case 6
			If orbitComplete Then
				If PodInZone(37 * TILE, 17 * TILE, TILE * 2, TILE * 2) Then
					Call WarpThroughExit(7)
				End If
			End If
		Case 7
			If PodNearExitMarker() Then
				enterFrom = 1
				Call WarpThroughExit(8)
			End If
		Case Else
			Call TrySliceCTransition()
	End Select
End Sub

' Handler: IsExitTile — E marker from ASCII maps (transition target hint)
Function IsExitTile(tx As Integer, ty As Integer) As Boolean
	If tx < 0 Or tx >= COLS Or ty < 0 Or ty >= ROWS Then
		IsExitTile = False
		Exit Function
	End If
	IsExitTile = (tileChar(tx, ty) = "E")
End Function

' Handler: DrawExitMarkers — bright cyan glow on E tiles (post shader dims — overdraw)
Sub DrawExitMarkers()
	Dim tx As Integer
	Dim ty As Integer
	Dim px As Single
	Dim py As Single
	For ty = 0 To ROWS - 1
		For tx = 0 To COLS - 1
			If IsExitTile(tx, ty) Then
				px = tx * TILE
				py = ty * TILE
				DrawRect px + 6, py + 6, TILE - 12, TILE - 12, Color(0.2, 0.7, 0.95, 0.55)
				DrawString "E", px + 10, py + 8, Color(1.0, 1.0, 1.0, 0.95), 13
			End If
		Next tx
	Next ty
End Sub

