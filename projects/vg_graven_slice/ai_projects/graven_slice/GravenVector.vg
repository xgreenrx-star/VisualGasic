' GravenVector.vg — inline *Vector: Data blocks rendered via VGVectorCanvas2D
' Edit art in Context Rail → Vector data while caret is inside a block below.

Option Explicit

Dim canvasCave As Variant
Dim canvasWorld As Variant
Dim canvasHud As Variant
Dim podVectorRaw As Variant
Dim caveTileVectorRaw As Variant
Dim exitVectorRaw As Variant
Dim skiffVectorRaw As Variant

' Handler: InitGravenVector — static cave canvas + cheap per-frame pod canvas
Sub InitGravenVector()
	useVectorArt = True
	If canvasCave = Null Then
		Set canvasCave = CreateNode("VGVectorCanvas2D")
		canvasCave.ZIndex = - 1
		Call canvasCave.SetBatchMode(True)
	End If
	If canvasWorld = Null Then
		Set canvasWorld = CreateNode("VGVectorCanvas2D")
		canvasWorld.ZIndex = 1
	End If
	If canvasHud = Null Then
		Set canvasHud = CreateNode("VGVectorCanvas2D")
	End If
	If Not canvasCave.IsInsideTree() Then
		AddChild(canvasCave)
	End If
	If Not canvasWorld.IsInsideTree() Then
		AddChild(canvasWorld)
	End If
	If Not canvasHud.IsInsideTree() Then
		If GetNode("HUD") < > Null Then
			GetNode("HUD").AddChild(canvasHud)
		Else
			AddChild(canvasHud)
		End If
	End If
	podVectorRaw = DataToArray("PodCapsuleVector")
	caveTileVectorRaw = DataToArray("CaveTileVector")
	exitVectorRaw = DataToArray("ExitMarkerVector")
	skiffVectorRaw = DataToArray("SkiffVector")
	Print "GRAVEN vector art — cave cached; pod layer per frame"
End Sub

' Handler: GetVectorAmbient — match Lit() dimming for R5 dark pool
Function GetVectorAmbient() As Single
	If roomDark And Not devLightsOn Then
		GetVectorAmbient = GetAmbientMul()
	Else
		GetVectorAmbient = 1.0
	End If
End Function

' Handler: VectorColor — RGBA 0..255 from Data rows → Godot Color
Function VectorColor(r As Single, g As Single, b As Single, a As Single, amb As Single) As Variant
	VectorColor = Color(r / 255.0 * amb, g / 255.0 * amb, b / 255.0 * amb, a / 255.0)
End Function

' Handler: VTransformX — local shape coord → world X (rotate + scale + offset)
Function VTransformX(lx As Single, ly As Single, ox As Single, oy As Single, angleDeg As Single, scale As Single) As Single
	Dim rad As Single
	Dim ca As Single
	Dim sa As Single
	rad = Deg2Rad(angleDeg)
	ca = Cos(rad)
	sa = Sin(rad)
	VTransformX = ox + (lx * scale * ca - ly * scale * sa)
End Function

' Handler: VTransformY — local shape coord → world Y
Function VTransformY(lx As Single, ly As Single, ox As Single, oy As Single, angleDeg As Single, scale As Single) As Single
	Dim rad As Single
	Dim ca As Single
	Dim sa As Single
	rad = Deg2Rad(angleDeg)
	ca = Cos(rad)
	sa = Sin(rad)
	VTransformY = oy + (lx * scale * sa + ly * scale * ca)
End Function

' Handler: DrawVectorBlock — walk cached DataToArray tape → canvas Draw* calls
Sub DrawVectorBlock(canvas As Variant, raw As Variant, ox As Single, oy As Single, angleDeg As Single, scale As Single)
	Dim i As Integer
	Dim n As Integer
	Dim typ As String
	Dim amb As Single
	Dim col As Variant
	Dim x1 As Single
	Dim y1 As Single
	Dim x2 As Single
	Dim y2 As Single
	Dim sw As Single
	Dim r As Single
	Dim g As Single
	Dim b As Single
	Dim a As Single
	Dim wx1 As Single
	Dim wy1 As Single
	Dim wx2 As Single
	Dim wy2 As Single
	Dim rx As Single
	Dim ry As Single
	Dim rw As Single
	Dim rh As Single
	Dim pi As Integer
	Dim lx As Single
	Dim ly As Single
	Dim pts() As Vector2
	Dim ti As Integer

	If canvas = Null Then Exit Sub
	If raw = Null Then Exit Sub
	If UBound(raw) < 2 Then Exit Sub
	amb = GetVectorAmbient()
	i = 3
	Do While i < = UBound(raw)
		typ = UCase(Str(raw(i)))
		Select Case typ
			Case "LINE"
			If i + 9 > UBound(raw) Then Exit Do
			x1 = CSng(raw(i + 1))
			y1 = CSng(raw(i + 2))
			x2 = CSng(raw(i + 3))
			y2 = CSng(raw(i + 4))
			r = CSng(raw(i + 5))
			g = CSng(raw(i + 6))
			b = CSng(raw(i + 7))
			a = CSng(raw(i + 8))
			sw = CSng(raw(i + 9))
			col = VectorColor(r, g, b, a, amb)
			wx1 = VTransformX(x1, y1, ox, oy, angleDeg, scale)
			wy1 = VTransformY(x1, y1, ox, oy, angleDeg, scale)
			wx2 = VTransformX(x2, y2, ox, oy, angleDeg, scale)
			wy2 = VTransformY(x2, y2, ox, oy, angleDeg, scale)
			Call canvas.DrawLine(Vector2(wx1, wy1), Vector2(wx2, wy2), sw, col)
			i = i + 10
			Case "RECT"
			If i + 9 > UBound(raw) Then Exit Do
			x1 = CSng(raw(i + 1))
			y1 = CSng(raw(i + 2))
			x2 = CSng(raw(i + 3))
			y2 = CSng(raw(i + 4))
			r = CSng(raw(i + 5))
			g = CSng(raw(i + 6))
			b = CSng(raw(i + 7))
			a = CSng(raw(i + 8))
			sw = CSng(raw(i + 9))
			col = VectorColor(r, g, b, a, amb)
			rx = VTransformX(x1, y1, ox, oy, angleDeg, scale)
			ry = VTransformY(x1, y1, ox, oy, angleDeg, scale)
			rw = VTransformX(x2, y1, ox, oy, angleDeg, scale) - rx
			rh = VTransformY(x1, y2, ox, oy, angleDeg, scale) - ry
			If Abs(angleDeg) > 0.01 Then
				Call canvas.DrawRect(Rect2(VTransformX(x1, y1, ox, oy, angleDeg, scale), VTransformY(x1, y1, ox, oy, angleDeg, scale), Abs(x2 - x1) * scale, Abs(y2 - y1) * scale), sw, col, True, col)
			Else
				If x2 < x1 Then
					rx = VTransformX(x2, y1, ox, oy, angleDeg, scale)
					rw = (x1 - x2) * scale
				End If
				If y2 < y1 Then
					ry = VTransformY(x1, y2, ox, oy, angleDeg, scale)
					rh = (y1 - y2) * scale
				End If
				If sw < = 0.01 Then
					Call canvas.DrawRect(Rect2(rx, ry, rw, rh), 0, col, True, col)
				Else
					Call canvas.DrawRect(Rect2(rx, ry, rw, rh), sw, col, True, col)
				End If
			End If
			i = i + 10
			Case "POLYLINE"
			If i + 1 > UBound(raw) Then Exit Do
			n = Int(raw(i + 1))
			ti = i + 2
			If n < 2 Or ti + n * 2 + 5 > UBound(raw) Then Exit Do
			ReDim pts(n - 1)
			For pi = 0 To n - 1
				lx = CSng(raw(ti))
				ly = CSng(raw(ti + 1))
				pts(pi) = Vector2(VTransformX(lx, ly, ox, oy, angleDeg, scale), VTransformY(lx, ly, ox, oy, angleDeg, scale))
				ti = ti + 2
			Next pi
			r = CSng(raw(ti))
			g = CSng(raw(ti + 1))
			b = CSng(raw(ti + 2))
			a = CSng(raw(ti + 3))
			sw = CSng(raw(ti + 4))
			col = VectorColor(r, g, b, a, amb)
			Call canvas.DrawPolyline(pts, sw, col, False, Color(0, 0, 0, 0), False)
			i = ti + 5
			Case Else
			i = i + 1
		End Select
	Loop
End Sub

' Handler: DrawVectorCaveTiles — merge solid runs into long rects (not 1 command/tile)
Sub DrawVectorCaveTiles()
	Dim tx As Integer
	Dim ty As Integer
	Dim tx1 As Integer
	Dim px As Single
	Dim py As Single
	Dim rw As Single
	Dim stone As Variant
	If Not useVectorArt Then Exit Sub
	If canvasCave = Null Then Exit Sub
	stone = GetRoomStone()
	For ty = 0 To ROWS - 1
		tx = 0
		While tx < COLS
			If tileChar(tx, ty) < > "#" Then
				tx = tx + 1
			Else
				tx1 = tx
				While tx1 + 1 < COLS
					If tileChar(tx1 + 1, ty) < > "#" Then Exit While
					tx1 = tx1 + 1
				Wend
				px = tx * TILE
				py = ty * TILE
				rw = (tx1 - tx + 1) * TILE
				Call canvasCave.DrawRect(Rect2(px, py, rw, TILE), 0, stone, True, stone)
				tx = tx1 + 1
			End If
		Wend
	Next ty
End Sub

' Handler: DrawVectorExitMarkers — small door frame; water shader sells the mouth
Sub DrawVectorExitMarkers()
	Dim i As Integer
	Dim px As Single
	Dim py As Single
	If Not useVectorArt Then Exit Sub
	If canvasCave = Null Then Exit Sub
	For i = 0 To exitCount - 1
		px = exitTX(i) * TILE
		py = exitTY(i) * TILE
		Call canvasCave.DrawRect(Rect2(px + 4, py + 4, TILE - 8, TILE - 8), 1.5, Color(GLOW_R, GLOW_G, GLOW_B, 0.85), False, Color(0, 0, 0, 0))
	Next i
End Sub

' Handler: DrawVectorPod — Fleuch-style dart: nose, swept fins, cockpit, rear hook
Sub DrawVectorPod()
	Dim rad As Single
	Dim fx As Single
	Dim fy As Single
	Dim px As Single
	Dim py As Single
	Dim hull As Variant
	Dim edge As Variant
	Dim glow As Variant
	Dim pts() As Vector2
	If Not useVectorArt Then Exit Sub
	If gameWon Then Exit Sub
	rad = Deg2Rad(podAngle)
	fx = Cos(rad)
	fy = Sin(rad)
	px = - fy
	py = fx
	hull = Lit(0.16, 0.26, 0.36, 1.0)
	edge = Lit(GLOW_R, GLOW_G, GLOW_B, 0.95)
	glow = Lit(GLOW_R, GLOW_G, GLOW_B, 1.0)
	ReDim pts(4)
	pts(0) = Vector2(podX + fx * 14, podY + fy * 14)
	pts(1) = Vector2(podX + px * 11 - fx * 3, podY + py * 11 - fy * 3)
	pts(2) = Vector2(podX - fx * 10 + px * 3.5, podY - fy * 10 + py * 3.5)
	pts(3) = Vector2(podX - fx * 10 - px * 3.5, podY - fy * 10 - py * 3.5)
	pts(4) = Vector2(podX - px * 11 - fx * 3, podY - py * 11 - fy * 3)
	Call canvasWorld.DrawPolygon(pts, 0, hull, True, hull)
	Call canvasWorld.DrawPolyline(pts, 1.5, edge, False, Color(0, 0, 0, 0), True)
	Call canvasWorld.DrawCircle(Vector2(podX + fx * 5, podY + fy * 5), 3.2, glow, True, glow)
	Call canvasWorld.DrawLine(Vector2(podX + px * 11 - fx * 3, podY + py * 11 - fy * 3), Vector2(podX - fx * 8, podY - fy * 8), 1.4, Lit(GLOW_R, GLOW_G, GLOW_B, 0.55))
	Call canvasWorld.DrawLine(Vector2(podX - px * 11 - fx * 3, podY - py * 11 - fy * 3), Vector2(podX - fx * 8, podY - fy * 8), 1.4, Lit(GLOW_R, GLOW_G, GLOW_B, 0.55))
	Call canvasWorld.DrawCircle(Vector2(podX - fx * 11, podY - fy * 11), 2.4, Lit(1.0, 0.5, 0.18, 0.85), True, Lit(1.0, 0.5, 0.18, 0.85))
	Call canvasWorld.DrawLine(Vector2(podX - fx * 12, podY - fy * 12), Vector2(podX - fx * 18, podY - fy * 18), 1.6, Lit(GLOW_R, GLOW_G, GLOW_B, 0.4))
End Sub

' Handler: DrawVectorSkiff — skiff goal art in Room 8 (dim until hub sockets balance)
Sub DrawVectorSkiff()
	If Not useVectorArt Then Exit Sub
	If roomId < > 8 Then Exit Sub
	If HubBalanced() Then
		Call canvasWorld.DrawCircle(Vector2(SKIFF_X, SKIFF_Y), SKIFF_R + 8, Lit(0.91, 0.96, 1, 0.22))
		Call DrawVectorBlock(canvasWorld, skiffVectorRaw, SKIFF_X - 36, SKIFF_Y - 14, 0, 1)
	Else
		Call canvasWorld.DrawCircle(Vector2(SKIFF_X, SKIFF_Y), SKIFF_R + 6, Lit(0.4, 0.45, 0.55, 0.2), True, Lit(0.4, 0.45, 0.55, 0.2))
	End If
End Sub

' Handler: DrawVectorSpikes — sonar-only teeth from the room spike cache
Sub DrawVectorSpikes()
	Dim i As Integer
	Dim px As Single
	Dim py As Single
	Dim k As Integer
	Dim x0 As Single
	Dim fill As Variant
	Dim pts() As Vector2
	Dim pulseOn As Boolean
	Dim revealR As Single
	Dim cx As Single
	Dim cy As Single
	Dim dx As Single
	Dim dy As Single
	Dim fade As Single
	If spikeCount < = 0 Then Exit Sub
	If canvasWorld = Null Then Exit Sub
	pulseOn = IsPulseActive()
	If Not pulseOn And Not devLightsOn Then Exit Sub
	fade = 1.0
	If pulseOn Then
		If pulseTimer < 0.45 Then
			fade = pulseTimer / 0.45
			If fade < 0 Then fade = 0
		End If
		revealR = 48 + GetPulsePhase() * 420
	Else
		revealR = 9999
	End If
	fill = Color(HAZARD_R, HAZARD_G, HAZARD_B, fade)
	ReDim pts(2)
	For i = 0 To spikeCount - 1
		px = spikeTX(i) * TILE
		py = spikeTY(i) * TILE
		cx = px + TILE * 0.5
		cy = py + TILE * 0.5
		dx = cx - podX
		dy = cy - podY
		If dx * dx + dy * dy < = revealR * revealR Then
			For k = 0 To 1
				x0 = px + k * 16
				pts(0) = Vector2(x0 + 1, py + TILE - 1)
				pts(1) = Vector2(x0 + 8, py + 4)
				pts(2) = Vector2(x0 + 15, py + TILE - 1)
				Call canvasWorld.DrawPolygon(pts, 0, fill, True, fill)
			Next k
		End If
	Next i
End Sub

' Handler: DrawVectorPulse — two expanding rings on the cheap per-frame canvas
Sub DrawVectorPulse()
	Dim phase As Single
	Dim ringR As Single
	Dim alpha As Single
	Dim col As Variant
	If canvasWorld = Null Then Exit Sub
	If Not IsPulseActive() Then Exit Sub
	phase = GetPulsePhase()
	ringR = 48 + phase * 380
	alpha = 0.9 * (1.0 - phase * 0.7)
	If alpha < 0.08 Then Exit Sub
	col = Color(GLOW_R, GLOW_G, GLOW_B, alpha)
	Call canvasWorld.DrawArc(Vector2(podX, podY), ringR, 0, 6.28318, 28, 2.5, col, False, Color(0, 0, 0, 0))
	If phase > 0.18 Then
		Call canvasWorld.DrawArc(Vector2(podX, podY), ringR * 0.52, 0, 6.28318, 24, 2, Color(GLOW_R, GLOW_G, GLOW_B, alpha * 0.45), False, Color(0, 0, 0, 0))
	End If
End Sub

' Handler: DrawVectorGates — sealed energy door, or open frame (world layer, not cave)
Sub DrawVectorGates()
	Dim i As Integer
	Dim minTX As Integer
	Dim minTY As Integer
	Dim maxTX As Integer
	Dim maxTY As Integer
	Dim x As Single
	Dim y As Single
	Dim w As Single
	Dim h As Single
	Dim slab As Variant
	Dim bar As Variant
	Dim frame As Variant
	Dim mouth As Variant
	If gateCount < = 0 Then Exit Sub
	If canvasWorld = Null Then Exit Sub
	minTX = gateTX(0)
	minTY = gateTY(0)
	maxTX = minTX
	maxTY = minTY
	For i = 1 To gateCount - 1
		If gateTX(i) < minTX Then minTX = gateTX(i)
		If gateTY(i) < minTY Then minTY = gateTY(i)
		If gateTX(i) > maxTX Then maxTX = gateTX(i)
		If gateTY(i) > maxTY Then maxTY = gateTY(i)
	Next i
	x = minTX * TILE
	y = minTY * TILE
	w = (maxTX - minTX + 1) * TILE
	h = (maxTY - minTY + 1) * TILE
	If ChallengeOpen() Then
		frame = Color(GLOW_R, GLOW_G, GLOW_B, 0.95)
		mouth = Color(GLOW_R, GLOW_G, GLOW_B, 0.18)
		Call canvasWorld.DrawRect(Rect2(x + 3, y + 3, w - 6, h - 6), 0, mouth, True, mouth)
		Call canvasWorld.DrawRect(Rect2(x + 2, y + 2, w - 4, h - 4), 2.2, frame, False, Color(0, 0, 0, 0))
	Else
		slab = Color(0.08, 0.12, 0.16, 0.96)
		bar = Color(GLOW_R, GLOW_G, GLOW_B, 0.55)
		Call canvasWorld.DrawRect(Rect2(x, y, w, h), 0, slab, True, slab)
		Call canvasWorld.DrawRect(Rect2(x + 3, y + 3, w - 6, h - 6), 1.6, Color(0.91, 0.96, 1.0, 0.35), False, Color(0, 0, 0, 0))
		Call canvasWorld.DrawLine(Vector2(x + w * 0.32, y + 6), Vector2(x + w * 0.32, y + h - 6), 2, bar)
		Call canvasWorld.DrawLine(Vector2(x + w * 0.5, y + 6), Vector2(x + w * 0.5, y + h - 6), 2, bar)
		Call canvasWorld.DrawLine(Vector2(x + w * 0.68, y + 6), Vector2(x + w * 0.68, y + h - 6), 2, bar)
	End If
End Sub

' Handler: DrawVectorOrbit — R6 band rings on the per-frame world canvas
Sub DrawVectorOrbit()
	Dim mx As Single
	Dim my As Single
	Dim pct As Single
	Dim band As Variant
	Dim faint As Variant
	If roomId < > 6 Then Exit Sub
	If orbitComplete Then Exit Sub
	If canvasWorld = Null Then Exit Sub
	mx = massX(0)
	my = massY(0)
	pct = orbitAngle / ORBIT_DEG_NEED
	If pct > 1 Then pct = 1
	faint = Lit(GLOW_R, GLOW_G, GLOW_B, 0.12)
	band = Lit(GLOW_R, GLOW_G, GLOW_B, 0.45)
	Call canvasWorld.DrawArc(Vector2(mx, my), ORBIT_R_MIN, 0, 6.28318, 28, 1.2, faint, False, Color(0, 0, 0, 0))
	Call canvasWorld.DrawArc(Vector2(mx, my), ORBIT_R_MAX, 0, 6.28318, 32, 1.2, Lit(GLOW_R, GLOW_G, GLOW_B, 0.08), False, Color(0, 0, 0, 0))
	If orbitInBand Then
		Call canvasWorld.DrawArc(Vector2(mx, my), (ORBIT_R_MIN + ORBIT_R_MAX) * 0.5, 0, pct * 6.28318, 24, 2, band, False, Color(0, 0, 0, 0))
	End If
End Sub

' Handler: RebuildVectorCave — stamp walls/exits once (spikes live on world + pulse)
Sub RebuildVectorCave()
	If Not useVectorArt Then Exit Sub
	If canvasCave = Null Then Exit Sub
	Call canvasCave.Clear()
	Call canvasCave.DrawRect(Rect2(0, 0, GAME_W, GAME_H), 0, Color(0, 0, 0, 0), True, GetRoomVoid())
	Call DrawVectorCaveTiles()
	Call DrawVectorExitMarkers()
End Sub

' Handler: DrawVectorWorld — pod/masses/pulse only; cave stays on canvasCave
Sub DrawVectorWorld()
	If Not useVectorArt Then Exit Sub
	If canvasWorld = Null Then Exit Sub
	Call canvasWorld.Clear()
	Call DrawSliceCBackdrop()
	Call DrawSliceCWorld()
	Call DrawLogMarkers()
	Call DrawVectorSkiff()
	Call DrawJuiceHeatZone()
	Call DrawWellMotes()
	Call DrawPhantomWell()
	Call DrawExitMouths()
	Call DrawJuiceBehind()
	Call DrawRoomObjects()
	Call DrawVectorGates()
	Call DrawTowWorld()
	Call DrawVectorPod()
	Call DrawJuiceFront()
	Call DrawVectorPulse()
	Call DrawVectorOrbit()
	Call DrawGravityHud()
End Sub

' Handler: DrawGravityHud — pull compass on HUD layer (not attached to the pod)
Sub DrawGravityHud()
	Dim cx As Single
	Dim cy As Single
	Dim rr As Single
	Dim nlen As Single
	Dim mag As Single
	Dim nx As Single
	Dim ny As Single
	Dim amber As Variant
	Dim ring As Variant
	If canvasHud = Null Then Exit Sub
	If gameWon Then
		Call canvasHud.Clear()
		Exit Sub
	End If
	cx = GAME_W - 56
	cy = 64
	rr = 22
	nlen = Sqr(gravAX * gravAX + gravAY * gravAY)
	amber = Color(1.0, 0.69, 0.125, 0.95)
	ring = Color(0.91, 0.96, 1.0, 0.45)
	Call canvasHud.Clear()
	Call canvasHud.DrawCircle(Vector2(cx, cy), rr + 2, Color(0.08, 0.1, 0.14, 0.72), True, Color(0.08, 0.1, 0.14, 0.72))
	Call canvasHud.DrawCircle(Vector2(cx, cy), rr, ring, False, Color(0, 0, 0, 0))
	Call canvasHud.DrawText(Vector2(cx - 4, cy + rr + 14), "G", Color(1.0, 0.69, 0.125, 0.85))
	Call DrawJuiceHud()
	If nlen < 0.01 Then Exit Sub
	mag = nlen / G_MAX
	If mag > 1 Then mag = 1
	If mag < 0.22 Then mag = 0.22
	nx = gravAX / nlen
	ny = gravAY / nlen
	Call canvasHud.DrawLine(Vector2(cx, cy), Vector2(cx + nx * (rr - 3) * mag, cy + ny * (rr - 3) * mag), 2.5, amber)
	Call canvasHud.DrawCircle(Vector2(cx + nx * (rr - 5) * mag, cy + ny * (rr - 5) * mag), 3, amber, True, amber)
End Sub

' --- Inline vector art (Context Rail → Vector data) -------------------------
' Label names must end with Vector. Edit shapes here; runtime reads via DataToArray.

CaveTileVector:
Data 32, 32, 4
Data RECT, 0, 0, 32, 32, 76, 102, 133, 255, 0
Data Line, 1, 1, 31, 1, 122, 158, 194, 220, 1.5
Data Line, 1, 1, 1, 31, 122, 158, 194, 220, 1.5
Data Line, 31, 1, 31, 31, 26, 41, 56, 230, 1.5
Data Line, 1, 31, 31, 31, 26, 41, 56, 230, 1.5

PodCapsuleVector:
Data 48, 28, 2
Data POLYLINE, 5, 22, 0, 8, 12, - 12, 5, - 12, - 5, 8, - 12, 61, 204, 255, 230, 1.8
Data RECT, 16, - 4, 26, 4, 61, 204, 255, 255, 0
Data Line, - 12, 0, - 20, 0, 255, 128, 46, 200, 2

ExitMarkerVector:
Data 32, 32, 4
Data RECT, 8, 8, 24, 24, 38, 140, 217, 90, 0
Data RECT, 10, 10, 22, 22, 61, 204, 255, 0, 1.5

SkiffVector:
Data 72, 28, 2
Data RECT, 0, 10, 72, 26, 232, 245, 255, 191, 0
Data RECT, 18, 4, 54, 16, 61, 204, 255, 140, 0
Data Line, 58, 14, 68, 14, 61, 204, 255, 230, 2
Data POLYLINE, 3, 68, 14, 72, 12, 72, 16, 61, 204, 255, 200, 1.5
