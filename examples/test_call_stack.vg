' test_call_stack.vg - Test project for debugger Call Stack feature
' Set breakpoints inside the nested functions to see the call stack
Option Explicit

Dim counter As Integer

' _Ready is called automatically when the scene starts (Godot lifecycle)
Sub _Ready()
	Print "=== Call Stack Test ==="
	counter = 0
	Call LevelOne()
	Print "Done! Counter = " & counter
End Sub

Sub LevelOne()
	Print "Entering LevelOne"
	counter = counter + 1
	Call LevelTwo()
	Print "Exiting LevelOne"
End Sub

Sub LevelTwo()
	Print "Entering LevelTwo"
	counter = counter + 10
	Call LevelThree()
	Print "Exiting LevelTwo"
End Sub

Sub LevelThree()
	Print "Entering LevelThree"
	counter = counter + 100
	
	' === SET BREAKPOINT HERE ===
	' When you hit this breakpoint, the Stack tab should show:
	'   LevelThree  (yellow - current)
	'   LevelTwo
	'   LevelOne
	'   Main
	Dim result As Integer
	result = AddNumbers(5, 10)  ' Call a Function too
	
	Print "Result from AddNumbers: " & result
	Print "Exiting LevelThree"
End Sub

Function AddNumbers(a As Integer, b As Integer) As Integer
	' === OR SET BREAKPOINT HERE ===
	' Stack should show:
	'   AddNumbers  (yellow - current)
	'   LevelThree
	'   LevelTwo
	'   LevelOne
	'   Main
	Dim sum As Integer
	sum = a + b
	AddNumbers = sum
End Function

' Test recursive calls
Sub RecursiveTest(depth As Integer)
	Print "Recursion depth: " & depth
	If depth > 0 Then
		' Each recursive call adds to the stack
		Call RecursiveTest(depth - 1)
	End If
	' Set breakpoint here to see full recursive stack
End Sub

Sub TestRecursion()
	Print "=== Recursive Call Stack Test ==="
	Call RecursiveTest(5)
	Print "Recursion complete"
End Sub
