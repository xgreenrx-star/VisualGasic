' Form1.vg - Main Menu (Game)
' Generated from Visual Gasic template
Option Explicit

' Game Main Menu
Sub Form_Load()
	' Play menu music, animate background, etc.
End Sub

Sub btnPlay_Click()
	' Start the game
	GetTree().change_scene_to_file("res://Game.tscn")
End Sub

Sub btnOptions_Click()
	' Show options menu
	Dim options As Control
	Set options = load("res://Options.tscn").instantiate()
	add_child(options)
End Sub

Sub btnCredits_Click()
	' Show credits
	GetTree().change_scene_to_file("res://Credits.tscn")
End Sub

Sub btnQuit_Click()
	' Exit the game
	GetTree().quit()
End Sub
