' Isolate ResetBall issue
Option Explicit

Dim Ball As Object
Dim bx As Single
Dim by As Single
Dim BallVelX As Single
Dim BallVelY As Single

Sub _Ready()
    Set Ball = CreateNode("ColorRect")
    AddChild(Ball)
    Ball.color = vbWhite
    Ball.size = Vector2(20, 20)
    
    Call ResetBall
    
    Print "Ready"
End Sub

Sub ResetBall()
    bx = 300
    by = 200
    Ball.position = Vector2(bx, by)
    
    BallVelX = 300
    If Rnd() > 0.5 Then BallVelX = -BallVelX
    
    ' Randomize Y start (Ensure non-zero)
    BallVelY = (Rnd() * 200) + 100
    'If Rnd() > 0.5 Then BallVelY = -BallVelY
    
    Print "ResetBall done: VelX=" & Str(BallVelX) & " VelY=" & Str(BallVelY)
End Sub

Sub _Process(delta)
    ' Simple movement
    bx = bx + (BallVelX * delta)
    by = by + (BallVelY * delta)
    Ball.position = Vector2(bx, by)
End Sub
