' Minimal color test with debug output
Option Explicit

Dim rect As Object

Sub _Ready()
    Print "=== _Ready starting ==="
    Print "About to call CreateNode..."
    Set rect = CreateNode("ColorRect")
    Print "CreateNode returned: " & TypeName(rect)
    
    If rect Is Nothing Then
        Print "ERROR: rect is Nothing!"
    Else
        Print "rect is valid, calling AddChild..."
        AddChild(rect)
        Print "AddChild done"
        
        Print "vbGreen = " & Str(vbGreen)
        rect.color = vbGreen
        Print "color assignment done"
        
        rect.size = Vector2(200, 200)
        rect.position = Vector2(100, 100)
        Print "size and position set"
    End If
    Print "=== _Ready complete ==="
End Sub
