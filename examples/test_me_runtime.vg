' Test Me. member access at runtime
Option Explicit

Sub TestMe()
    ' This should work - accessing owner's text property
    Me.name = "TestForm"
    Print "Me.name = "; Me.name
    
    ' Try accessing non-existent property (should fail gracefully)
    Dim x
    x = Me.text
    Print "Me.text = "; x
End Sub

Sub _Ready()
    TestMe()
End Sub
