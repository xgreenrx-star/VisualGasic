' Test Breakpoint Debug Script
' Set a breakpoint on any Print line and run the scene

Option Explicit

Sub _Ready()
	Print "Line 7: Starting test"
	Dim x As Integer
	x = 1
	Print "Line 10: x = " & x
	x = x + 1
	Print "Line 12: x = " & x
	x = x + 1
	Print "Line 14: x = " & x
	Print "Line 15: Test complete"
End Sub
