' Simple test for bytecode member access
Option Explicit

Dim TestRect As Object
Dim vx As Single
Dim vy As Single

Sub _Ready()
    Set TestRect = CreateNode("ColorRect")
    AddChild(TestRect)
    TestRect.color = vbGreen
    TestRect.size = Vector2(50, 50)
    TestRect.position = Vector2(100, 100)
    Print "Test Ready!"
End Sub

Sub _Process(delta)
    Dim pos As Object
    
    ' Get position
    Set pos = TestRect.position
    vx = pos.x
    vy = pos.y
    
    ' Move
    vx = vx + (100 * delta)
    vy = vy + (50 * delta)
    
    ' Update
    TestRect.position = Vector2(vx, vy)
    
    ' Print position every second or so
    If vx > 500 Then
        Print "Reached x=500"
        vx = 100
    End If
End Sub
