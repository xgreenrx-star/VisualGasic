' Pong Clone in Visual Gasic
' demonstrating dynamic node creation and basic physics loop

Option Explicit

Dim Ball As Object
Dim Paddle1 As Object
Dim Paddle2 As Object
Dim LabelScore1 As Object
Dim LabelScore2 As Object

Dim BallVelX As Single
Dim BallVelY As Single
Dim Score1 As Integer
Dim Score2 As Integer

' Position and size tracking variables
Dim bx As Single
Dim by As Single
Dim p1x As Single
Dim p1y As Single
Dim p2x As Single
Dim p2y As Single

' Original paddle colors (for flash reset)
Dim Paddle1OrigColor As Object
Dim Paddle2OrigColor As Object
Dim FlashTimer1 As Single
Dim FlashTimer2 As Single

' Additional reactive variables
Dim BallSpeed As Single       ' Current ball speed (for Exceeds demo)
Dim RallyCount As Integer     ' Hits without scoring (for Becomes demo)
Dim BallZone As Integer       ' 1=Left danger, 2=Middle, 3=Right danger (for Between demo)
Dim BallOrigColor As Object   ' For ball color effects

' Speed tier tracking (edge detection)
Dim SpeedTier As Integer      ' 0=slow, 1=normal, 2=fast, 3=insane

Sub _Ready()
	Randomize
	' Setup Screen
	' Assume 800x600 resolution or similar
	
	Score1 = 0
	Score2 = 0
	
	' Create Visual Elements using standard Godot Nodes
	
	' --- PADDLE 1 (Left) ---
	Set Paddle1 = CreateNode("ColorRect")
	AddChild(Paddle1)
	Set Paddle1OrigColor = Color(0.2, 0.8, 0.2)
	Paddle1.color = Paddle1OrigColor
	Paddle1.size = Vector2(20, 100)
	Paddle1.position = Vector2(50, 250)
	
	' --- PADDLE 2 (Right) ---
	Set Paddle2 = CreateNode("ColorRect")
	AddChild(Paddle2)
	Set Paddle2OrigColor = Color(0.2, 0.2, 0.8)
	Paddle2.color = Paddle2OrigColor
	Paddle2.size = Vector2(20, 100)
	Paddle2.position = Vector2(1080, 250)
	
	FlashTimer1 = 0
	FlashTimer2 = 0
	
	' --- BALL ---
	Set Ball = CreateNode("ColorRect")
	AddChild(Ball)
	Set BallOrigColor = Color(1.0, 1.0, 1.0, 1.0)
	Ball.color = BallOrigColor
	Ball.size = Vector2(20, 20)
	RallyCount = 0
	BallSpeed = 0
	BallZone = 2  ' Start in middle
	SpeedTier = 1  ' Start at normal speed tier
	Call ResetBall
	
	' --- UI ---
	Set LabelScore1 = CreateLabel("0", 300, 50)
	LabelScore1.AddThemeFontSizeOverride("font_size", 40)
	
	Set LabelScore2 = CreateLabel("0", 800, 50)
	LabelScore2.AddThemeFontSizeOverride("font_size", 40)
	
	' Setup Whenever reactive sections
	Call SetupWhenever
	
	Print "Pong Ready!"
End Sub

Sub ResetBall()
	bx = 576
	by = 324
	Ball.position = Vector2(bx, by)
	
	BallVelX = 300
	If Rnd() > 0.5 Then BallVelX = -BallVelX
	
	' Randomize Y start (Ensure non-zero)
	BallVelY = (Rnd() * 200) + 100
	If Rnd() > 0.5 Then BallVelY = -BallVelY
End Sub

Sub _Process(delta)
	Dim P1Vy As Single
	Dim P2Vy As Single
	Dim bPos As Object
	Dim bSize As Object
	Dim p1Pos As Object
	Dim p2Pos As Object
	
	' Handle paddle flash reset timers
	If FlashTimer1 > 0 Then
		FlashTimer1 = FlashTimer1 - delta
		If FlashTimer1 <= 0 Then
			Paddle1.color = Paddle1OrigColor
		End If
	End If
	If FlashTimer2 > 0 Then
		FlashTimer2 = FlashTimer2 - delta
		If FlashTimer2 <= 0 Then
			Paddle2.color = Paddle2OrigColor
		End If
	End If
	
	' Get current positions
	Set bPos = Ball.position
	Set bSize = Ball.size
	bx = bPos.x
	by = bPos.y
	
	Set p1Pos = Paddle1.position
	p1x = p1Pos.x
	p1y = p1Pos.y
	
	Set p2Pos = Paddle2.position
	p2x = p2Pos.x
	p2y = p2Pos.y
	
	' Move Ball
	bx = bx + (BallVelX * delta)
	by = by + (BallVelY * delta)
	Ball.position = Vector2(bx, by)
	
	' Calculate actual ball speed (approximate - sum of abs velocities)
	Dim ActualSpeed As Single
	Dim AbsX As Single
	Dim AbsY As Single
	If BallVelX < 0 Then
		AbsX = -BallVelX
	Else
		AbsX = BallVelX
	End If
	If BallVelY < 0 Then
		AbsY = -BallVelY
	Else
		AbsY = BallVelY
	End If
	ActualSpeed = AbsX + AbsY
	
	' Update SpeedTier for edge detection (only changes at thresholds)
	' Thresholds for sum of abs velocities (approximate speed)
	' Starting: ~450 (300 + 150), Fast: ~600, Insane: ~900
	Dim NewTier As Integer
	If ActualSpeed < 300 Then
		NewTier = 0  ' Slow
	ElseIf ActualSpeed < 550 Then
		NewTier = 1  ' Normal
	ElseIf ActualSpeed < 800 Then
		NewTier = 2  ' Fast
	Else
		NewTier = 3  ' Insane
	End If
	
	' Only update SpeedTier if it changed (edge detection)
	' This triggers Whenever only once per transition
	If NewTier <> SpeedTier Then
		SpeedTier = NewTier
	End If
	
	' Update ball zone (1=left danger, 2=middle, 3=right danger)
	If bx < 200 Then
		BallZone = 1  ' Left danger zone
	ElseIf bx > 952 Then
		BallZone = 3  ' Right danger zone
	Else
		BallZone = 2  ' Safe middle zone
	End If
	
	' Simple AI for Paddle 2 (Right)
	P2Vy = 0
	If by > p2y + 50 Then
		P2Vy = 200
	Else
		P2Vy = -200
	End If
	p2y = p2y + (P2Vy * delta)
	Paddle2.position = Vector2(p2x, p2y)
	
	' Player Input for Paddle 1
	P1Vy = 0
	If IsKeyDown("S") Then
		P1Vy = 300
	End If
	If IsKeyDown("W") Then
		P1Vy = -300
	End If
	p1y = p1y + (P1Vy * delta)
	Paddle1.position = Vector2(p1x, p1y)
	
	' Screen Collision (Top/Bottom)
	If by < 0.0 Then
		by = 0.0
		BallVelY = Abs(BallVelY)
		Ball.position = Vector2(bx, by)
	End If

	If by > 628.0 Then 
		by = 628.0
		BallVelY = -Abs(BallVelY)
		Ball.position = Vector2(bx, by)
	End If
	
	' Paddle Collision (Simple AABB)
	' Paddle 1 - using hardcoded size (20x100)
	If bx < p1x + 20 And bx + 20 > p1x And by < p1y + 100 And by + 20 > p1y Then
		BallVelX = Abs(BallVelX) * 1.1
		BallVelY = BallVelY + (P1Vy * 0.5)
		RallyCount = RallyCount + 1  ' Increment rally on hit
	End If
	
	' Paddle 2 - using hardcoded size (20x100)
	If bx < p2x + 20 And bx + 20 > p2x And by < p2y + 100 And by + 20 > p2y Then
		BallVelX = -Abs(BallVelX) * 1.1
		BallVelY = BallVelY + (P2Vy * 0.5)
		RallyCount = RallyCount + 1  ' Increment rally on hit
	End If
	
	' Scoring
	If bx < 0 Then
		Score2 = Score2 + 1
		LabelScore2.Text = Str(Score2)
		RallyCount = 0  ' Reset rally on score
		Ball.color = BallOrigColor  ' Reset ball color
		Call ResetBall
	End If
	
	If bx > 1152 Then
		Score1 = Score1 + 1
		LabelScore1.Text = Str(Score1)
		RallyCount = 0  ' Reset rally on score
		Ball.color = BallOrigColor  ' Reset ball color
		Call ResetBall
	End If
End Sub

' ============================================================
' WHENEVER SECTIONS - Reactive Programming Demo
' These sections run automatically when conditions are met
' Syntax: Whenever Section <Name> <Variable> <Operator> <Callback>
' ============================================================

' Register Whenever sections in a setup sub (called from _Ready)
Sub SetupWhenever()
	' === CHANGES Operator - React to any value change ===
	Whenever Section Player1Scores Score1 Changes OnPlayer1Score
	Whenever Section Player2Scores Score2 Changes OnPlayer2Score
	
	' === EXCEEDS Operator - React when value goes above threshold ===
	' (Good for one-time thresholds like score limits)
	Whenever Section Player1GamePoint Score1 Exceeds 4 OnPlayer1GamePoint
	Whenever Section Player2GamePoint Score2 Exceeds 4 OnPlayer2GamePoint
	Whenever Section Player1Wins Score1 Exceeds 5 OnPlayer1Victory
	Whenever Section Player2Wins Score2 Exceeds 5 OnPlayer2Victory
	
	' === CHANGES Operator for SpeedTier - React when speed tier changes ===
	' (We use Changes and check the value in the callback for more control)
	Whenever Section SpeedTierChanged SpeedTier Changes OnSpeedTierChange
	
	' Rally milestones (also using Becomes for exact values)
	Whenever Section Rally5 RallyCount Becomes 5 OnRally5
	Whenever Section Rally10 RallyCount Becomes 10 OnRally10
	Whenever Section Rally15 RallyCount Becomes 15 OnRally15
	
	Print "Whenever sections registered! (10 sections)"
End Sub

' ============================================================
' CALLBACK PROCEDURES - Called when conditions are triggered
' ============================================================

Sub OnPlayer1Score()
	Print "Player 1 scored! Score: " & Str(Score1)
	Paddle1.color = Color(0.0, 1.0, 0.0, 1.0)  ' Bright green flash
	FlashTimer1 = 0.3  ' Flash for 0.3 seconds
End Sub

Sub OnPlayer2Score()
	Print "Player 2 scored! Score: " & Str(Score2)
	Paddle2.color = Color(0.0, 0.0, 1.0, 1.0)  ' Bright blue flash
	FlashTimer2 = 0.3  ' Flash for 0.3 seconds
End Sub

Sub OnPlayer1GamePoint()
	Print "*** GAME POINT for Player 1! ***"
End Sub

Sub OnPlayer2GamePoint()
	Print "*** GAME POINT for Player 2! ***"
End Sub

Sub OnPlayer1Victory()
	Print "========================================="
	Print "   PLAYER 1 WINS!"
	Print "========================================="
End Sub

Sub OnPlayer2Victory()
	Print "========================================="
	Print "   PLAYER 2 WINS!"
	Print "========================================="
End Sub

' === SPEED TIER CALLBACK (using Changes for edge detection) ===

Sub OnSpeedTierChange()
	' Handle speed tier changes based on current tier value
	If SpeedTier = 0 Then
		Print "Ball slowing down... (Tier 0)"
		Ball.color = Color(0.5, 0.5, 1.0, 1.0)  ' Light blue = slow
	ElseIf SpeedTier = 1 Then
		Print "Normal speed (Tier 1)"
		Ball.color = BallOrigColor  ' Back to white
	ElseIf SpeedTier = 2 Then
		Print "Ball getting fast! (Tier 2)"
		Ball.color = Color(1.0, 1.0, 0.0, 1.0)  ' Yellow = fast
	ElseIf SpeedTier = 3 Then
		Print "INSANE SPEED! (Tier 3)"
		Ball.color = Color(1.0, 0.0, 0.0, 1.0)  ' Red = crazy fast
	End If
End Sub

' === RALLY CALLBACKS (Becomes) ===

Sub OnRally5()
	Print "Nice rally! 5 hits!"
	Ball.color = Color(0.0, 1.0, 1.0, 1.0)  ' Cyan
End Sub

Sub OnRally10()
	Print "HOT RALLY! 10 hits!"
	Ball.color = Color(1.0, 0.5, 0.0, 1.0)  ' Orange
End Sub

Sub OnRally15()
	Print "MEGA RALLY! 15 hits! Amazing!"
	Ball.color = Color(1.0, 0.0, 1.0, 1.0)  ' Magenta
End Sub
