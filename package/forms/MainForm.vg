' MainForm.vg - Your first VisualGasic form!
Option Explicit

Private Sub Form_Load()
    ' This runs when the form opens
    Me.Caption = "Welcome to VisualGasic!"
    Debug.Print "MainForm loaded successfully!"
End Sub

Private Sub btnHello_Click()
    ' This runs when the Hello button is clicked
    MsgBox "Hello, VisualGasic!", vbInformation, "Welcome"
End Sub

Private Sub btnQuit_Click()
    ' This runs when the Quit button is clicked
    Unload Me
End Sub
