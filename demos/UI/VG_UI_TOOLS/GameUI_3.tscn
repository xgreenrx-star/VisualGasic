[node name="GameUI_3" type="Window"]
title = "Game UI — Dialogs & Chat"
initial_position = 1
size = Vector2i(640, 640)
theme = ExtResource("1")
script = ExtResource("2")

[node name="_FormBackground" type="Panel" parent="."]
offset_right = 640.0
offset_bottom = 640.0
mouse_filter = 2
script = ExtResource("3")

[node name="ScrollContainer" type="ScrollContainer" parent="."]
offset_right = 640.0
offset_bottom = 640.0
follow_focus = true

[node name="VBox" type="VBoxContainer" parent="ScrollContainer"]
offset_right = 640.0

[node name="lblHeader" type="Label" parent="ScrollContainer/VBox"]
text = "Game UI — Dialogs & Chat"
theme_override_colors/font_color = Color(1.0, 1.0, 1.0, 1.0)
theme_override_styles/normal = SubResource("header_bg")
theme_override_font_sizes/font_size = 16

[node name="secDialogPanel" type="Label" parent="ScrollContainer/VBox"]
text = "── DialogPanel — click to advance ──"
theme_override_styles/normal = SubResource("section_bg")
theme_override_font_sizes/font_size = 13

[node name="dlgNpc" type="RichTextLabel" parent="ScrollContainer/VBox"]
text = "[b]Guard:[/b] Halt! Who goes there?"
custom_minimum_size = Vector2(0, 50)
bbcode_enabled = true
fit_content = true

[node name="btnNextLine" type="Button" parent="ScrollContainer/VBox"]
text = "Next Line ▶"

[node name="secConfirmDialog" type="Label" parent="ScrollContainer/VBox"]
text = "── ConfirmDialog — real Godot ConfirmationDialog ──"
theme_override_styles/normal = SubResource("section_bg")
theme_override_font_sizes/font_size = 13

[node name="btnConfirm" type="Button" parent="ScrollContainer/VBox"]
text = "Delete Save File..."

[node name="secSettingsPanel" type="Label" parent="ScrollContainer/VBox"]
text = "── SettingsPanel ──"
theme_override_styles/normal = SubResource("section_bg")
theme_override_font_sizes/font_size = 13

[node name="chkMusic" type="CheckBox" parent="ScrollContainer/VBox"]
text = "Music On"
button_pressed = true

[node name="chkSfx" type="CheckBox" parent="ScrollContainer/VBox"]
text = "Sound Effects On"
button_pressed = true

[node name="secNotificationToast" type="Label" parent="ScrollContainer/VBox"]
text = "── NotificationToast — auto-hides after 2s ──"
theme_override_styles/normal = SubResource("section_bg")
theme_override_font_sizes/font_size = 13

[node name="btnNotify" type="Button" parent="ScrollContainer/VBox"]
text = "Show Toast"

[node name="lblToast" type="Label" parent="ScrollContainer/VBox"]
text = ""
autowrap_mode = 3
theme_override_styles/normal = SubResource("feedback_bg")
theme_override_font_sizes/font_size = 12

[node name="tmrToast" type="Timer" parent="ScrollContainer/VBox"]
wait_time = 2.0
one_shot = true

[node name="secChatBox" type="Label" parent="ScrollContainer/VBox"]
text = "── ChatBox — type and send ──"
theme_override_styles/normal = SubResource("section_bg")
theme_override_font_sizes/font_size = 13

[node name="chatBox" type="RichTextLabel" parent="ScrollContainer/VBox"]
text = "[Player1]: hello!
[Player2]: hey! ready for the raid?"
custom_minimum_size = Vector2(0, 70)
bbcode_enabled = true
fit_content = true

[node name="hbox_txtChatInput" type="HBoxContainer" parent="ScrollContainer/VBox"]
[node name="lbl_txtChatInput" type="Label" parent="ScrollContainer/VBox/hbox_txtChatInput"]
text = "Say:"
custom_minimum_size = Vector2(100, 0)
vertical_alignment = 1
[node name="txtChatInput" type="LineEdit" parent="ScrollContainer/VBox/hbox_txtChatInput"]
placeholder_text = "Type a message..."
size_flags_horizontal = 3

[node name="btnSendChat" type="Button" parent="ScrollContainer/VBox"]
text = "Send"

[node name="secDamageNumber" type="Label" parent="ScrollContainer/VBox"]
text = "── DamageNumber — floating damage text ──"
theme_override_styles/normal = SubResource("section_bg")
theme_override_font_sizes/font_size = 13

[node name="btnDealDamage" type="Button" parent="ScrollContainer/VBox"]
text = "Attack!"

[node name="lblDamage" type="Label" parent="ScrollContainer/VBox"]
text = ""
theme_override_font_sizes/font_size = 24

[node name="lblFeedback" type="Label" parent="ScrollContainer/VBox"]
text = "Try the controls above."
