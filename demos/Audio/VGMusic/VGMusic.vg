' ============================================================================
' VGMusic.vg — Live Coding Music Synthesizer
' ============================================================================
' A Strudel-inspired live coding environment for creating music with plain
' English BASIC commands. Write code in the editor, hit Play, and hear your
' composition in real time. All commands are readable English words.
'
' CONCEPT:
'   Instead of cryptic Strudel mini-notation like "bd sd [hh hh]",
'   VG Music uses clear BASIC-style commands like:
'       Play "C4", Quarter
'       Rest Eighth
'       Repeat 4, "bd sd hh hh"
'
' MUSIC LANGUAGE REFERENCE:
'   Play <note>, <duration>     — Play a note (e.g., "C4", "A#3")
'   PlayDrum <drum>, <duration> — Play a percussion sound
'   Rest <duration>             — Wait for a duration
'   Tempo <bpm>                 — Set beats per minute
'   Wave <type>                 — Set waveform: Sine, Square, Saw, Triangle
'   Volume <0-100>              — Set volume level
'   Layer <name>                — Start a new simultaneous layer
'   Repeat <count>              — Repeat the following block
'   EndRepeat                   — End of repeat block
'
' DURATIONS: Whole, Half, Quarter, Eighth, Sixteenth, Triplet
' NOTES: C, C#, D, D#, E, F, F#, G, G#, A, A#, B  (octaves 1-7)
' DRUMS: Kick, Snare, HiHat, Clap, Tom, Rim, Cowbell
' WAVES: Sine, Square, Saw, Triangle, Noise
'
' FEATURES:
'   - Live text editor with syntax highlighting
'   - Real-time audio via PlayTone
'   - Scrolling visualizer showing notes as they play
'   - Pre-loaded example songs
'   - Save/Load .VGS (VG Song) files
'   - Tempo control with visual BPM display
'   - Panic button to silence everything
'
' OS INTEGRATION DEMONSTRATED:
'   - PlayTone (waveform synthesis)
'   - Timer-based sequencer
'   - File I/O (save/load .VGS songs)
'   - SaveSetting/GetSetting (preferences)
'   - MsgBox/InputBox (dialogs)
'   - Clipboard (copy/paste code)
'
' PLATFORMS: Linux, Windows, Android, Apple, HTML5
' ============================================================================
Option Explicit

' ── Note Frequency Table ──────────────────────────────────────────────────
' MIDI note numbers map to frequencies: freq = 440 * 2^((midi-69)/12)
' We'll pre-calculate common notes

' ── Song Data ─────────────────────────────────────────────────────────────
Const MAX_EVENTS As Integer = 2000   ' Maximum events in a song
Const MAX_LAYERS As Integer = 8      ' Maximum simultaneous layers

' Events parsed from the editor text
Dim evtType(2000) As String          ' "NOTE", "REST", "DRUM", "WAVE", "VOLUME"
Dim evtNote(2000) As Double          ' Frequency for notes
Dim evtDuration(2000) As Double      ' Duration in beats
Dim evtLayer(2000) As Integer        ' Which layer this event belongs to
Dim evtNoteName(2000) As String      ' Display name (e.g., "C4", "Kick")
Dim eventCount As Integer            ' Total parsed events

' Layer state
Dim layerPos(8) As Integer           ' Current event position per layer
Dim layerTimer(8) As Double          ' Time remaining on current event
Dim layerWave(8) As String           ' Waveform per layer
Dim layerVolume(8) As Integer        ' Volume per layer (0-100)
Dim layerCount As Integer            ' Number of active layers

' ── Playback State ────────────────────────────────────────────────────────
Dim bpm As Integer                   ' Beats per minute
Dim isPlaying As Boolean             ' Playback active
Dim playTime As Double               ' Total elapsed play time
Dim beatLength As Double             ' Seconds per beat
Dim currentBeat As Double            ' Current beat position

' ── Visualizer ────────────────────────────────────────────────────────────
Const VIS_MAX As Integer = 200       ' Visualizer history slots
Dim visNotes(200) As String          ' Note names in visualizer
Dim visFreqs(200) As Double          ' Frequencies
Dim visLayers(200) As Integer        ' Which layer
Dim visTimes(200) As Double          ' When the note was played
Dim visCount As Integer              ' Number of visualizer entries
Dim visScroll As Double              ' Auto-scroll position

' ── Editor Text ───────────────────────────────────────────────────────────
Dim editorLines(500) As String       ' The code in the editor
Dim editorLineCount As Integer       ' Number of lines
Dim cursorLine As Integer            ' Current cursor line
Dim cursorCol As Integer             ' Current cursor column
Dim editorScroll As Integer          ' First visible line

' ── UI State ──────────────────────────────────────────────────────────────
Dim showHelp As Boolean              ' Show language reference panel
Dim errorMessage As String           ' Parse error message to display
Dim lastPlayedNote As String         ' For display

' ============================================================================
' INITIALIZATION
' ============================================================================

Sub _Ready()
    bpm = 120
    beatLength = 60.0 / bpm
    isPlaying = False
    playTime = 0
    currentBeat = 0
    eventCount = 0
    visCount = 0
    visScroll = 0
    showHelp = False
    errorMessage = ""
    lastPlayedNote = ""
    cursorLine = 0
    cursorCol = 0
    editorScroll = 0
    layerCount = 1

    ' Initialize layers
    Dim l As Integer
    For l = 0 To MAX_LAYERS - 1
        layerPos(l) = 0
        layerTimer(l) = 0
        layerWave(l) = "Square"
        layerVolume(l) = 80
    Next

    ' Load saved tempo preference
    bpm = Val(GetSetting("VGMusic", "Config", "Tempo", "120"))
    If bpm < 40 Then bpm = 40
    If bpm > 300 Then bpm = 300
    beatLength = 60.0 / bpm

    ' Start with a default example song
    LoadExample 0
End Sub

' ============================================================================
' EXAMPLE SONGS
' ============================================================================

