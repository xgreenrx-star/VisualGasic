        AddEditorLine "  Play G4, Sixteenth"
        AddEditorLine "  Play C5, Sixteenth"
        AddEditorLine "  Play G4, Sixteenth"
        AddEditorLine "  Play E4, Sixteenth"
        AddEditorLine "EndRepeat"
