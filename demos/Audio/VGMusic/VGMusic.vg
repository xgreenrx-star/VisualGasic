        AddEditorLine ""
        AddEditorLine "' --- Melody Layer ---"
        AddEditorLine "Layer Melody"
        AddEditorLine "Wave Sine"
        AddEditorLine "Volume 70"
        AddEditorLine "Play E4, Quarter"
        AddEditorLine "Play D4, Quarter"
        AddEditorLine "Play C4, Quarter"
        AddEditorLine "Play D4, Quarter"
        AddEditorLine "Play E4, Quarter"
        AddEditorLine "Play E4, Quarter"
        AddEditorLine "Play E4, Half"
        AddEditorLine ""
        AddEditorLine "' --- Bass Layer ---"
        AddEditorLine "Layer Bass"
        AddEditorLine "Wave Square"
        AddEditorLine "Volume 50"
        AddEditorLine "Play C3, Half"
        AddEditorLine "Play G2, Half"
        AddEditorLine "Play C3, Half"
        AddEditorLine "Play G2, Half"

    Case 4
        ' ── Ambient Pad ───────────────────────────────────────────────────
        AddEditorLine "' Ambient Pad — Long tones"
        AddEditorLine ""
        AddEditorLine "Tempo 60"
        AddEditorLine "Wave Triangle"
        AddEditorLine "Volume 50"
        AddEditorLine ""
        AddEditorLine "Play C3, Whole"
        AddEditorLine "Play E3, Whole"
        AddEditorLine "Play G3, Whole"
