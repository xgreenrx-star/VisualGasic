        AddEditorLine ""
        AddEditorLine "Tempo 100"
        AddEditorLine "Wave Sine"
        AddEditorLine "Volume 75"
        AddEditorLine ""
        AddEditorLine "Play C4, Quarter"
        AddEditorLine "Play C4, Quarter"
        AddEditorLine "Play G4, Quarter"
        AddEditorLine "Play G4, Quarter"
        AddEditorLine "Play A4, Quarter"
        AddEditorLine "Play A4, Quarter"
        AddEditorLine "Play G4, Half"
        AddEditorLine ""
        AddEditorLine "Play F4, Quarter"
        AddEditorLine "Play F4, Quarter"
        AddEditorLine "Play E4, Quarter"
        AddEditorLine "Play E4, Quarter"
        AddEditorLine "Play D4, Quarter"
        AddEditorLine "Play D4, Quarter"
        AddEditorLine "Play C4, Half"

    Case 1
        ' ── Drum Pattern ──────────────────────────────────────────────────
        AddEditorLine "' Simple 4/4 Drum Beat"
        AddEditorLine "' Kick on 1 and 3, Snare on 2 and 4"
        AddEditorLine ""
        AddEditorLine "Tempo 110"
        AddEditorLine "Volume 90"
        AddEditorLine ""
        AddEditorLine "Repeat 4"
        AddEditorLine "  PlayDrum Kick, Quarter"
        AddEditorLine "  PlayDrum HiHat, Eighth"
        AddEditorLine "  PlayDrum HiHat, Eighth"
        AddEditorLine "  PlayDrum Snare, Quarter"
        AddEditorLine "  PlayDrum HiHat, Eighth"
        AddEditorLine "  PlayDrum HiHat, Eighth"
