    Case 2
        ' ── Bass Line ─────────────────────────────────────────────────────
        AddEditorLine "' Funky Bass Line"
        AddEditorLine ""
        AddEditorLine "Tempo 95"
        AddEditorLine "Wave Saw"
        AddEditorLine "Volume 70"
        AddEditorLine ""
        AddEditorLine "Repeat 2"
        AddEditorLine "  Play E2, Eighth"
        AddEditorLine "  Play E2, Sixteenth"
        AddEditorLine "  Play E2, Sixteenth"
        AddEditorLine "  Rest Eighth"
        AddEditorLine "  Play G2, Eighth"
        AddEditorLine "  Play A2, Quarter"
