' Screen Space Shaders Demo - VisualGasic port of Godot 2D Screen Space Shaders demo
' Ported from: https://github.com/godotengine/godot-demo-projects/tree/master/2d/screen_space_shaders
'
' Demonstrates full-screen 2D shader post-processing effects:
'   Vignette, Blur, Pixelize, Whirl, Sepia, Negative,
'   Contrasted, Normalized, BCS, Mirage, Old Film

Class ScreenShaders Extends Control

    Dim effect As OptionButton
    Dim effects As Control
    Dim picture As OptionButton
    Dim pictures As Control

    Sub _ready()
        effect = GetNode("Effect")
        effects = GetNode("Effects")
        picture = GetNode("Picture")
        pictures = GetNode("Pictures")

        Dim c As Node
        For Each c In pictures.get_children()
            picture.add_item("PIC: " & String(c.get_name()))
        Next

        For Each c In effects.get_children()
            effect.add_item("FX: " & String(c.get_name()))
        Next
    End Sub

    Sub _on_picture_item_selected(id As Integer)
        Dim c As Integer
        For c = 0 To pictures.get_child_count() - 1
            If id = c Then
                pictures.get_child(c).show()
            Else
                pictures.get_child(c).hide()
            End If
        Next
    End Sub

    Sub _on_effect_item_selected(id As Integer)
        Dim c As Integer
        For c = 0 To effects.get_child_count() - 1
            If id = c Then
                effects.get_child(c).show()
            Else
                effects.get_child(c).hide()
            End If
        Next
    End Sub

End Class
