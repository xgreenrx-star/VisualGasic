' ============================================================================
' VGVector.vg — Vector Graphics & Animation Editor
' ============================================================================
' A coordinate-based vector graphics editor with an animation timeline.
' All graphics are stored as mathematical shapes (coordinates, not pixels).
' Saves to the custom .VGV (VisualGasic Vector) format.
'
' .VGV FILE FORMAT SPECIFICATION:
' ───────────────────────────────────────────────────────────────────────────
'   Line 1:  "VGV1"                         (format identifier)
'   Line 2:  canvasWidth,canvasHeight        (document dimensions)
'   Line 3:  frameCount,fps                  (animation settings)
'   Line 4:  "FRAMES"                        (frames section marker)
'   For each frame:
'     "FRAME n"                              (frame number, 0-based)
'     "SHAPE type,x1,y1,x2,y2,r,g,b,a,strokeW,fillR,fillG,fillB,fillA"
'     ...more shapes...
'     "ENDFRAME"
'   Line N:  "ENDVGV"                        (end of file marker)
'
' Shape types: LINE, RECT, ELLIPSE, POLYGON, POLYLINE, TEXT
'   LINE:     x1,y1,x2,y2 (start/end points)
'   RECT:     x1,y1,x2,y2 (top-left / bottom-right corners)
'   ELLIPSE:  cx,cy,rx,ry  (center + radii)
'   POLYGON:  x1,y1,x2,y2,...,xN,yN (vertex list, auto-closed)
'   POLYLINE: x1,y1,x2,y2,...,xN,yN (vertex list, open)
'   TEXT:     x,y,fontSize,0 + text on next line
'
' FEATURES:
'   - Shape tools: Line, Rectangle, Ellipse, Polygon, Polyline, Text
'   - Select tool: click to select, drag to move shapes
'   - Color picker for stroke and fill colors
'   - Adjustable stroke width
'   - Animation timeline with frame thumbnails
'   - Play/pause animation preview
'   - Onion skinning (ghost of previous frame)
'   - Frame management: add, delete, clone, reorder
'   - Save/Load .VGV files
'
' OS INTEGRATION DEMONSTRATED:
'   - File I/O (Save/Load .VGV with Open/Print #/Close)
'   - InputBox/MsgBox (dialogs for FPS, text input, canvas size)
'   - SaveSetting/GetSetting (remember last settings)
'   - Clipboard (copy/paste shape data as text)
'   - Timer-based animation playback
'
' PLATFORMS: Linux, Windows, Android, Apple, HTML5
' ============================================================================
Option Explicit

' ── Shape Data Structure ──────────────────────────────────────────────────
' Each shape is stored as arrays of properties indexed by shape ID.
' This avoids UDTs for maximum compatibility with the VG runtime.
Const MAX_SHAPES As Integer = 500       ' Max shapes per frame
Const MAX_FRAMES As Integer = 120       ' Max animation frames
Const MAX_POINTS As Integer = 50        ' Max vertices per polygon

' Shape property arrays (per-frame, per-shape)
' We flatten: shape index = frameIdx * MAX_SHAPES + shapeIdx
Dim shapeType(60000) As String          ' "LINE","RECT","ELLIPSE","POLYGON","POLYLINE","TEXT"
Dim shapeX1(60000) As Double            ' Primary X coordinate
Dim shapeY1(60000) As Double            ' Primary Y coordinate
Dim shapeX2(60000) As Double            ' Secondary X coordinate
Dim shapeY2(60000) As Double            ' Secondary Y coordinate
Dim shapeStrokeR(60000) As Integer      ' Stroke color red
Dim shapeStrokeG(60000) As Integer      ' Stroke color green
Dim shapeStrokeB(60000) As Integer      ' Stroke color blue
Dim shapeStrokeA(60000) As Integer      ' Stroke alpha (0-255)
Dim shapeStrokeW(60000) As Double       ' Stroke width
Dim shapeFillR(60000) As Integer        ' Fill color red
Dim shapeFillG(60000) As Integer        ' Fill color green
Dim shapeFillB(60000) As Integer        ' Fill color blue
Dim shapeFillA(60000) As Integer        ' Fill alpha (0=no fill, 255=solid)
Dim shapeText(60000) As String          ' Text content (for TEXT shapes)

' Polygon vertex storage (separate arrays for multi-point shapes)
Dim polyPointX(3000, 50) As Double      ' X coords per polygon vertex
Dim polyPointY(3000, 50) As Double      ' Y coords per polygon vertex
Dim polyPointCount(3000) As Integer     ' Vertex count per polygon

' Per-frame shape counts
Dim frameShapeCount(120) As Integer     ' Number of shapes in each frame

' ── Document State ────────────────────────────────────────────────────────
Dim docWidth As Integer                 ' Document/canvas width
Dim docHeight As Integer                ' Document/canvas height
Dim frameCount As Integer               ' Total number of frames
Dim fps As Integer                      ' Frames per second for playback
Dim currentFrame As Integer             ' Currently displayed frame index
Dim currentFile As String               ' Current .VGV file path
Dim isModified As Boolean               ' Unsaved changes flag

' ── Tool State ────────────────────────────────────────────────────────────
' Tools: 0=Select, 1=Line, 2=Rect, 3=Ellipse, 4=Polygon, 5=Polyline, 6=Text
Dim currentToolIdx As Integer           ' Currently selected tool
Dim isDrawingShape As Boolean           ' True while creating a shape
Dim drawStartX As Double                ' Shape creation start point X
Dim drawStartY As Double                ' Shape creation start point Y
Dim drawEndX As Double                  ' Shape creation end point X
Dim drawEndY As Double                  ' Shape creation end point Y
Dim selectedShape As Integer            ' Index of selected shape (-1=none)
Dim isDragging As Boolean               ' True while dragging a selected shape
Dim dragOffsetX As Double               ' Drag offset from shape origin
Dim dragOffsetY As Double

' Polygon drawing state
Dim tempPolyX(50) As Double             ' Temporary polygon vertices
Dim tempPolyY(50) As Double
Dim tempPolyCount As Integer            ' Number of temp vertices so far

' ── Color State ───────────────────────────────────────────────────────────
Dim strokeR As Integer, strokeG As Integer, strokeB As Integer, strokeA As Integer
Dim fillR As Integer, fillG As Integer, fillB As Integer, fillA As Integer
Dim strokeWidth As Double

' ── Animation Playback ────────────────────────────────────────────────────
Dim isPlaying As Boolean                ' True when animation is playing
Dim playTimer As Double                 ' Accumulated time for frame advance
Dim onionSkin As Boolean                ' Show previous frame as ghost

' ── UI Layout ─────────────────────────────────────────────────────────────
Const MENU_H As Integer = 32
Const TOOLBAR_W As Integer = 60         ' Left toolbar width
Const PROPS_W As Integer = 180          ' Right properties panel width
Const TIMELINE_H As Integer = 90        ' Bottom timeline height
Const STATUS_H As Integer = 22          ' Status bar height
Const TOOL_BTN_SZ As Integer = 24       ' Tool button size

' ── Tool Names ────────────────────────────────────────────────────────────
Dim vecToolNames(7) As String

' ── Palette for quick color selection ─────────────────────────────────────
Const QPAL_COUNT As Integer = 16
Dim qpalR(16) As Integer, qpalG(16) As Integer, qpalB(16) As Integer

' Mouse tracking
Dim mouseScrX As Integer, mouseScrY As Integer  ' Screen coordinates
Dim mouseDocX As Double, mouseDocY As Double    ' Document coordinates

' ============================================================================
' INITIALIZATION
' ============================================================================

Sub _Ready()
    ' ── Document defaults ─────────────────────────────────────────────────
    docWidth = 800
    docHeight = 500
    frameCount = 1
    fps = 12
    currentFrame = 0
    currentFile = ""
    isModified = False
    selectedShape = -1

    ' ── Tool defaults ─────────────────────────────────────────────────────
    currentToolIdx = 0           ' Select tool
    isDrawingShape = False
    isDragging = False
    tempPolyCount = 0

    ' ── Color defaults ────────────────────────────────────────────────────
    strokeR = 0 : strokeG = 0 : strokeB = 0 : strokeA = 255
    fillR = 100 : fillG = 150 : fillB = 255 : fillA = 128
    strokeWidth = 2.0

    ' ── Animation defaults ────────────────────────────────────────────────
    isPlaying = False
    playTimer = 0
    onionSkin = True

    ' ── Tool names ────────────────────────────────────────────────────────
    vecToolNames(0) = "Select"
    vecToolNames(1) = "Line"
    vecToolNames(2) = "Rect"
    vecToolNames(3) = "Ellipse"
    vecToolNames(4) = "Polygon"
    vecToolNames(5) = "PolyLine"
    vecToolNames(6) = "Text"

    ' ── Quick palette ─────────────────────────────────────────────────────
    SetQPal 0,   0,   0,   0      ' Black
    SetQPal 1, 255, 255, 255      ' White
    SetQPal 2, 255,   0,   0      ' Red
    SetQPal 3,   0, 255,   0      ' Green
    SetQPal 4,   0,   0, 255      ' Blue
    SetQPal 5, 255, 255,   0      ' Yellow
    SetQPal 6, 255,   0, 255      ' Magenta
    SetQPal 7,   0, 255, 255      ' Cyan
    SetQPal 8, 255, 128,   0      ' Orange
    SetQPal 9, 128,   0, 255      ' Purple
    SetQPal 10, 128, 128, 128     ' Gray
    SetQPal 11,   0, 128,   0     ' Dark Green
    SetQPal 12,   0,   0, 128     ' Navy
    SetQPal 13, 128,   0,   0     ' Dark Red
    SetQPal 14, 255, 200, 150     ' Peach
    SetQPal 15, 100, 200, 255     ' Sky

    ' ── Initialize first frame with zero shapes ───────────────────────────
    frameShapeCount(0) = 0

    ' ── Load saved settings ───────────────────────────────────────────────
    fps = Val(GetSetting("VGVector", "Config", "FPS", "12"))
    onionSkin = (GetSetting("VGVector", "Config", "OnionSkin", "1") = "1")
End Sub

Sub SetQPal(idx As Integer, r As Integer, g As Integer, b As Integer)
    qpalR(idx) = r : qpalG(idx) = g : qpalB(idx) = b
End Sub

' ============================================================================
' SHAPE MANAGEMENT — get/set shapes using flattened array indexing
' ============================================================================

' Get the flat index for a shape in a specific frame
Function ShapeIdx(frame As Integer, shape As Integer) As Integer
    ShapeIdx = frame * MAX_SHAPES + shape
End Function

' Add a new shape to the current frame and return its index
Function AddShape(sType As String, x1 As Double, y1 As Double, x2 As Double, y2 As Double) As Integer
    Dim count As Integer
    count = frameShapeCount(currentFrame)
    If count >= MAX_SHAPES Then
        MsgBox "Maximum shapes reached for this frame!", vbExclamation, "Limit"
        AddShape = -1
        Exit Function
    End If

    Dim idx As Integer
    idx = ShapeIdx(currentFrame, count)

    ' Set shape properties
    shapeType(idx) = sType
    shapeX1(idx) = x1
    shapeY1(idx) = y1
    shapeX2(idx) = x2
    shapeY2(idx) = y2
    shapeStrokeR(idx) = strokeR
    shapeStrokeG(idx) = strokeG
    shapeStrokeB(idx) = strokeB
    shapeStrokeA(idx) = strokeA
    shapeStrokeW(idx) = strokeWidth
    shapeFillR(idx) = fillR
    shapeFillG(idx) = fillG
    shapeFillB(idx) = fillB
    shapeFillA(idx) = fillA
    shapeText(idx) = ""
    polyPointCount(count) = 0

    frameShapeCount(currentFrame) = count + 1
    isModified = True
    AddShape = count
End Function

' Delete a shape from the current frame (shift remaining shapes down)
Sub DeleteShape(shapeIndex As Integer)
    Dim count As Integer
    count = frameShapeCount(currentFrame)
    If shapeIndex < 0 Or shapeIndex >= count Then Exit Sub

    ' Shift all shapes above the deleted one down by one
    Dim i As Integer
    For i = shapeIndex To count - 2
        Dim src As Integer, dst As Integer
        src = ShapeIdx(currentFrame, i + 1)
        dst = ShapeIdx(currentFrame, i)
        shapeType(dst) = shapeType(src)
        shapeX1(dst) = shapeX1(src) : shapeY1(dst) = shapeY1(src)
        shapeX2(dst) = shapeX2(src) : shapeY2(dst) = shapeY2(src)
        shapeStrokeR(dst) = shapeStrokeR(src)
        shapeStrokeG(dst) = shapeStrokeG(src)
        shapeStrokeB(dst) = shapeStrokeB(src)
        shapeStrokeA(dst) = shapeStrokeA(src)
        shapeStrokeW(dst) = shapeStrokeW(src)
        shapeFillR(dst) = shapeFillR(src)
        shapeFillG(dst) = shapeFillG(src)
        shapeFillB(dst) = shapeFillB(src)
        shapeFillA(dst) = shapeFillA(src)
        shapeText(dst) = shapeText(src)
    Next

    frameShapeCount(currentFrame) = count - 1
    selectedShape = -1
    isModified = True
End Sub

' ============================================================================
' FRAME MANAGEMENT
' ============================================================================

' Add a new blank frame after the current one
Sub AddFrame()
    If frameCount >= MAX_FRAMES Then
        MsgBox "Maximum frames reached!", vbExclamation, "Limit"
        Exit Sub
    End If
    frameCount = frameCount + 1
    currentFrame = frameCount - 1
    frameShapeCount(currentFrame) = 0
    selectedShape = -1
    isModified = True
End Sub

' Clone the current frame (duplicate all shapes into a new frame)
Sub CloneFrame()
    If frameCount >= MAX_FRAMES Then
        MsgBox "Maximum frames reached!", vbExclamation, "Limit"
        Exit Sub
    End If

    Dim srcFrame As Integer
    srcFrame = currentFrame
    frameCount = frameCount + 1
    Dim dstFrame As Integer
    dstFrame = frameCount - 1
    currentFrame = dstFrame

    ' Copy all shapes from source to destination
    Dim count As Integer
    count = frameShapeCount(srcFrame)
    frameShapeCount(dstFrame) = count

    Dim i As Integer
    For i = 0 To count - 1
        Dim src As Integer, dst As Integer
        src = ShapeIdx(srcFrame, i)
        dst = ShapeIdx(dstFrame, i)
        shapeType(dst) = shapeType(src)
        shapeX1(dst) = shapeX1(src) : shapeY1(dst) = shapeY1(src)
        shapeX2(dst) = shapeX2(src) : shapeY2(dst) = shapeY2(src)
        shapeStrokeR(dst) = shapeStrokeR(src)
        shapeStrokeG(dst) = shapeStrokeG(src)
        shapeStrokeB(dst) = shapeStrokeB(src)
        shapeStrokeA(dst) = shapeStrokeA(src)
        shapeStrokeW(dst) = shapeStrokeW(src)
        shapeFillR(dst) = shapeFillR(src)
        shapeFillG(dst) = shapeFillG(src)
        shapeFillB(dst) = shapeFillB(src)
        shapeFillA(dst) = shapeFillA(src)
        shapeText(dst) = shapeText(src)
    Next

    selectedShape = -1
    isModified = True
End Sub

' Delete the current frame
Sub DeleteFrame()
    If frameCount <= 1 Then
        MsgBox "Cannot delete the only frame!", vbExclamation, "Delete Frame"
        Exit Sub
    End If
    ' Simple approach: just decrement frame count
    ' (in a full implementation we'd shift frames)
    frameCount = frameCount - 1
    If currentFrame >= frameCount Then currentFrame = frameCount - 1
    selectedShape = -1
    isModified = True
End Sub

' ============================================================================
' .VGV FILE FORMAT — SAVE
' ============================================================================

Sub SaveVGV(filePath As String)
    Dim f As Integer
    f = FreeFile()
    Open filePath For Output As #f

    ' ── Header ────────────────────────────────────────────────────────────
    Print #f, "VGV1"
    Print #f, Str(docWidth) & "," & Str(docHeight)
    Print #f, Str(frameCount) & "," & Str(fps)
    Print #f, "FRAMES"

    ' ── Write each frame ──────────────────────────────────────────────────
    Dim fr As Integer
    For fr = 0 To frameCount - 1
        Print #f, "FRAME " & Str(fr)

        Dim count As Integer
        count = frameShapeCount(fr)
        Dim s As Integer
        For s = 0 To count - 1
            Dim idx As Integer
            idx = ShapeIdx(fr, s)

            ' Build shape line: TYPE,x1,y1,x2,y2,sR,sG,sB,sA,sW,fR,fG,fB,fA
            Dim line As String
            line = "SHAPE " & shapeType(idx) & ","
            line = line & Str(shapeX1(idx)) & "," & Str(shapeY1(idx)) & ","
            line = line & Str(shapeX2(idx)) & "," & Str(shapeY2(idx)) & ","
            line = line & Str(shapeStrokeR(idx)) & "," & Str(shapeStrokeG(idx)) & ","
            line = line & Str(shapeStrokeB(idx)) & "," & Str(shapeStrokeA(idx)) & ","
            line = line & Str(shapeStrokeW(idx)) & ","
            line = line & Str(shapeFillR(idx)) & "," & Str(shapeFillG(idx)) & ","
            line = line & Str(shapeFillB(idx)) & "," & Str(shapeFillA(idx))
            Print #f, line

            ' Write polygon vertices if applicable
            If shapeType(idx) = "POLYGON" Or shapeType(idx) = "POLYLINE" Then
                Dim pc As Integer
                pc = polyPointCount(s)
                Dim pLine As String
                pLine = "POINTS " & Str(pc)
                Dim p As Integer
                For p = 0 To pc - 1
                    pLine = pLine & "," & Str(polyPointX(s, p)) & "," & Str(polyPointY(s, p))
                Next
                Print #f, pLine
            End If

            ' Write text content if applicable
            If shapeType(idx) = "TEXT" Then
                Print #f, "TEXTDATA " & shapeText(idx)
            End If
        Next

        Print #f, "ENDFRAME"
    Next

    Print #f, "ENDVGV"
    Close #f

    currentFile = filePath
    isModified = False
End Sub

' ============================================================================
' .VGV FILE FORMAT — LOAD
' ============================================================================

Sub LoadVGV(filePath As String)
    If Not FileExists(filePath) Then
        MsgBox "File not found: " & filePath, vbExclamation, "Open Error"
        Exit Sub
    End If

    Dim f As Integer
    f = FreeFile()
    Open filePath For Input As #f

    ' ── Read header ───────────────────────────────────────────────────────
    Dim header As String
    Line Input #f, header
    If Left(header, 4) <> "VGV1" Then
        MsgBox "Not a valid .VGV file!", vbExclamation, "Format Error"
        Close #f
        Exit Sub
    End If

    ' Read dimensions
    Dim dimLine As String
    Line Input #f, dimLine
    Dim dimParts() As String
    dimParts = Split(dimLine, ",")
    docWidth = Val(dimParts(0))
    docHeight = Val(dimParts(1))

    ' Read frame count and FPS
    Dim animLine As String
    Line Input #f, animLine
    Dim animParts() As String
    animParts = Split(animLine, ",")
    frameCount = Val(animParts(0))
    fps = Val(animParts(1))

    ' Skip "FRAMES" marker
    Dim marker As String
    Line Input #f, marker

    ' ── Read frames ───────────────────────────────────────────────────────
    Dim curFr As Integer
    curFr = -1
    Dim curSh As Integer

    Do While Not EOF(f)
        Dim lineText As String
        Line Input #f, lineText
        lineText = Trim(lineText)

        If Left(lineText, 5) = "FRAME" Then
            curFr = curFr + 1
            frameShapeCount(curFr) = 0
            curSh = 0

        ElseIf Left(lineText, 5) = "SHAPE" Then
            ' Parse shape data
            Dim shapeData As String
            shapeData = Mid(lineText, 7)   ' Remove "SHAPE "
            Dim parts() As String
            parts = Split(shapeData, ",")

            Dim idx As Integer
            idx = ShapeIdx(curFr, curSh)

            shapeType(idx) = parts(0)
            shapeX1(idx) = Val(parts(1))
            shapeY1(idx) = Val(parts(2))
            shapeX2(idx) = Val(parts(3))
            shapeY2(idx) = Val(parts(4))
            shapeStrokeR(idx) = Val(parts(5))
            shapeStrokeG(idx) = Val(parts(6))
            shapeStrokeB(idx) = Val(parts(7))
            shapeStrokeA(idx) = Val(parts(8))
            shapeStrokeW(idx) = Val(parts(9))
            shapeFillR(idx) = Val(parts(10))
            shapeFillG(idx) = Val(parts(11))
            shapeFillB(idx) = Val(parts(12))
            shapeFillA(idx) = Val(parts(13))

            frameShapeCount(curFr) = curSh + 1
            curSh = curSh + 1

        ElseIf Left(lineText, 6) = "POINTS" Then
            ' Parse polygon vertices
            Dim ptData As String
            ptData = Mid(lineText, 8)
            Dim ptParts() As String
            ptParts = Split(ptData, ",")
            Dim pc As Integer
            pc = Val(ptParts(0))
            polyPointCount(curSh - 1) = pc
            Dim p As Integer
            For p = 0 To pc - 1
                polyPointX(curSh - 1, p) = Val(ptParts(1 + p * 2))
                polyPointY(curSh - 1, p) = Val(ptParts(2 + p * 2))
            Next

        ElseIf Left(lineText, 8) = "TEXTDATA" Then
            Dim prevIdx As Integer
            prevIdx = ShapeIdx(curFr, curSh - 1)
            shapeText(prevIdx) = Mid(lineText, 10)

        ElseIf lineText = "ENDVGV" Then
            Exit Do
        End If
    Loop

    Close #f
    currentFile = filePath
    currentFrame = 0
    selectedShape = -1
    isModified = False
End Sub

' ============================================================================
' INPUT HANDLING
' ============================================================================

Sub _Input(ev)
    If TypeOf ev Is InputEventMouseButton Then
        HandleMouseClick ev
    End If

    If TypeOf ev Is InputEventMouseMotion Then
        HandleMouseMove ev
    End If

    If TypeOf ev Is InputEventKey Then
        If ev.pressed Then HandleKeyInput ev
    End If
End Sub

Sub HandleMouseClick(ev)
    Dim mx As Integer, my As Integer
    mx = Int(ev.position.x)
    my = Int(ev.position.y)

    ' ── Toolbar click (left side) ─────────────────────────────────────────
    If mx < TOOLBAR_W And my > MENU_H Then
        If ev.pressed And ev.button_index = 1 Then
            Dim toolIdx As Integer
            toolIdx = (my - MENU_H - 4) \ (TOOL_BTN_SZ + 4)
            If toolIdx >= 0 And toolIdx <= 6 Then
                currentToolIdx = toolIdx
                isDrawingShape = False
                tempPolyCount = 0
            End If
        End If
        Exit Sub
    End If

    ' ── Properties panel click (right side) ───────────────────────────────
    Dim propsX As Integer
    propsX = 1024 - PROPS_W
    If mx >= propsX Then
        If ev.pressed And ev.button_index = 1 Then
            HandlePropsClick mx - propsX, my
        End If
        Exit Sub
    End If

    ' ── Timeline click (bottom) ───────────────────────────────────────────
    Dim timelineY As Integer
    timelineY = 700 - TIMELINE_H - STATUS_H
    If my >= timelineY And my < 700 - STATUS_H Then
        If ev.pressed And ev.button_index = 1 Then
            ' Click on frame thumbnail to switch frame
            Dim frameIdx As Integer
            frameIdx = (mx - TOOLBAR_W) \ 70
            If frameIdx >= 0 And frameIdx < frameCount Then
                currentFrame = frameIdx
                selectedShape = -1
            End If
        End If
        Exit Sub
    End If

    ' ── Canvas area click ─────────────────────────────────────────────────
    ' Convert screen to document coordinates
    mouseDocX = mx - TOOLBAR_W
    mouseDocY = my - MENU_H

    If ev.button_index = 1 Then
        If ev.pressed Then
            ' ── Start shape drawing or selection ──────────────────────────
            Select Case currentToolIdx

            Case 0  ' Select tool
                selectedShape = HitTestShapes(mouseDocX, mouseDocY)
                If selectedShape >= 0 Then
                    isDragging = True
                    Dim si As Integer
                    si = ShapeIdx(currentFrame, selectedShape)
                    dragOffsetX = mouseDocX - shapeX1(si)
                    dragOffsetY = mouseDocY - shapeY1(si)
                Else
                    isDragging = False
                End If

            Case 1, 2, 3  ' Line, Rect, Ellipse
                isDrawingShape = True
                drawStartX = mouseDocX
                drawStartY = mouseDocY
                drawEndX = mouseDocX
                drawEndY = mouseDocY

            Case 4, 5  ' Polygon, Polyline
                ' Add vertex on click
                If tempPolyCount < MAX_POINTS Then
                    tempPolyX(tempPolyCount) = mouseDocX
                    tempPolyY(tempPolyCount) = mouseDocY
                    tempPolyCount = tempPolyCount + 1
                End If

            Case 6  ' Text
                Dim textIn As String
                textIn = InputBox("Enter text:", "Text Tool", "Hello")
                If Len(textIn) > 0 Then
                    Dim si2 As Integer
                    si2 = AddShape("TEXT", mouseDocX, mouseDocY, mouseDocX + Len(textIn) * 10, mouseDocY + 20)
                    If si2 >= 0 Then
                        Dim ti As Integer
                        ti = ShapeIdx(currentFrame, si2)
                        shapeText(ti) = textIn
                    End If
                End If

            End Select

        Else  ' Mouse released
            If isDrawingShape And (currentToolIdx >= 1 And currentToolIdx <= 3) Then
                ' Finalize shape
                drawEndX = mouseDocX
                drawEndY = mouseDocY
                Select Case currentToolIdx
                    Case 1: AddShape "LINE", drawStartX, drawStartY, drawEndX, drawEndY
                    Case 2: AddShape "RECT", drawStartX, drawStartY, drawEndX, drawEndY
                    Case 3: AddShape "ELLIPSE", drawStartX, drawStartY, drawEndX, drawEndY
                End Select
                isDrawingShape = False
            End If
            isDragging = False
        End If
    End If

    ' ── Right-click to finish polygon/polyline ────────────────────────────
    If ev.button_index = 2 And ev.pressed Then
        If tempPolyCount >= 2 And (currentToolIdx = 4 Or currentToolIdx = 5) Then
            Dim sType As String
            If currentToolIdx = 4 Then sType = "POLYGON" Else sType = "POLYLINE"
            Dim newIdx As Integer
            newIdx = AddShape(sType, tempPolyX(0), tempPolyY(0), tempPolyX(tempPolyCount - 1), tempPolyY(tempPolyCount - 1))
            If newIdx >= 0 Then
                polyPointCount(newIdx) = tempPolyCount
                Dim v As Integer
                For v = 0 To tempPolyCount - 1
                    polyPointX(newIdx, v) = tempPolyX(v)
                    polyPointY(newIdx, v) = tempPolyY(v)
                Next
            End If
            tempPolyCount = 0
        End If
    End If
End Sub

Sub HandleMouseMove(ev)
    mouseScrX = Int(ev.position.x)
    mouseScrY = Int(ev.position.y)
    mouseDocX = mouseScrX - TOOLBAR_W
    mouseDocY = mouseScrY - MENU_H

    If isDrawingShape Then
        drawEndX = mouseDocX
        drawEndY = mouseDocY
    End If

    ' Move selected shape while dragging
    If isDragging And selectedShape >= 0 Then
        Dim si As Integer
        si = ShapeIdx(currentFrame, selectedShape)
        Dim dx As Double, dy As Double
        dx = (mouseDocX - dragOffsetX) - shapeX1(si)
        dy = (mouseDocY - dragOffsetY) - shapeY1(si)
        shapeX1(si) = shapeX1(si) + dx
        shapeY1(si) = shapeY1(si) + dy
        shapeX2(si) = shapeX2(si) + dx
        shapeY2(si) = shapeY2(si) + dy
        isModified = True
    End If

    QueueRedraw
End Sub

' Simple hit test — check if a point is near any shape
Function HitTestShapes(px As Double, py As Double) As Integer
    Dim count As Integer
    count = frameShapeCount(currentFrame)
    Dim i As Integer

    ' Check in reverse order (top shapes first)
    For i = count - 1 To 0 Step -1
        Dim idx As Integer
        idx = ShapeIdx(currentFrame, i)
        Dim x1 As Double, y1 As Double, x2 As Double, y2 As Double
        x1 = shapeX1(idx) : y1 = shapeY1(idx)
        x2 = shapeX2(idx) : y2 = shapeY2(idx)

        ' Simple bounding box test
        Dim minX As Double, minY As Double, maxX As Double, maxY As Double
        If x1 < x2 Then minX = x1 : maxX = x2 Else minX = x2 : maxX = x1
        If y1 < y2 Then minY = y1 : maxY = y2 Else minY = y2 : maxY = y1

        ' Add some margin for thin shapes
        If px >= minX - 5 And px <= maxX + 5 And py >= minY - 5 And py <= maxY + 5 Then
            HitTestShapes = i
            Exit Function
        End If
    Next

    HitTestShapes = -1
End Function

Sub HandleKeyInput(ev)
    ' ── Space = Play/Pause ────────────────────────────────────────────────
    If ev.keycode = 32 Then
        isPlaying = Not isPlaying
        playTimer = 0
    End If

    ' ── Delete = Delete selected shape ────────────────────────────────────
    If ev.keycode = 4194312 Then  ' KEY_DELETE
        If selectedShape >= 0 Then DeleteShape selectedShape
    End If

    ' ── Ctrl+D = Duplicate shape ──────────────────────────────────────────
    If ev.ctrl_pressed And ev.keycode = 68 Then
        If selectedShape >= 0 Then
            Dim si As Integer
            si = ShapeIdx(currentFrame, selectedShape)
            Dim newIdx As Integer
            newIdx = AddShape(shapeType(si), shapeX1(si) + 20, shapeY1(si) + 20, shapeX2(si) + 20, shapeY2(si) + 20)
        End If
    End If

    ' ── Ctrl+S = Save ─────────────────────────────────────────────────────
    If ev.ctrl_pressed And ev.keycode = 83 Then
        If Len(currentFile) > 0 Then
            SaveVGV currentFile
        Else
            Dim path As String
            path = InputBox("Save as:", "Save VGV", "user://animation.vgv")
            If Len(path) > 0 Then SaveVGV path
        End If
    End If

    ' ── Left/Right arrows = navigate frames ───────────────────────────────
    If ev.keycode = 4194319 Then  ' Left
        If currentFrame > 0 Then currentFrame = currentFrame - 1 : selectedShape = -1
    End If
    If ev.keycode = 4194321 Then  ' Right
        If currentFrame < frameCount - 1 Then currentFrame = currentFrame + 1 : selectedShape = -1
    End If

    ' ── O = toggle onion skin ─────────────────────────────────────────────
    If ev.keycode = 79 And Not ev.ctrl_pressed Then
        onionSkin = Not onionSkin
    End If

    ' ── Number keys = tool shortcuts ──────────────────────────────────────
    If ev.keycode >= 49 And ev.keycode <= 55 Then
        currentToolIdx = ev.keycode - 49
    End If
End Sub

' Handle clicks in the properties panel
Sub HandlePropsClick(relX As Integer, absY As Integer)
    ' ── Stroke color palette clicks ───────────────────────────────────────
    Dim palStartY As Integer
    palStartY = MENU_H + 160

    If absY >= palStartY And absY < palStartY + 44 Then
        Dim ci As Integer
        ci = ((absY - palStartY) \ 22) * 8 + (relX \ 22)
        If ci >= 0 And ci < QPAL_COUNT Then
            strokeR = qpalR(ci) : strokeG = qpalG(ci) : strokeB = qpalB(ci)
        End If
    End If

    ' ── Fill color palette clicks ─────────────────────────────────────────
    Dim fillPalY As Integer
    fillPalY = palStartY + 70
    If absY >= fillPalY And absY < fillPalY + 44 Then
        Dim fi As Integer
        fi = ((absY - fillPalY) \ 22) * 8 + (relX \ 22)
        If fi >= 0 And fi < QPAL_COUNT Then
            fillR = qpalR(fi) : fillG = qpalG(fi) : fillB = qpalB(fi) : fillA = 180
        End If
    End If

    ' ── Stroke width buttons ──────────────────────────────────────────────
    Dim swY As Integer
    swY = fillPalY + 70
    If absY >= swY And absY < swY + 24 Then
        If relX < 60 Then
            If strokeWidth > 0.5 Then strokeWidth = strokeWidth - 0.5
        Else
            If strokeWidth < 20 Then strokeWidth = strokeWidth + 0.5
        End If
    End If
End Sub

' ============================================================================
' MENU HANDLERS
' ============================================================================

Sub mnuFile_New_Click()
    frameCount = 1 : currentFrame = 0
    frameShapeCount(0) = 0
    selectedShape = -1 : currentFile = "" : isModified = False
End Sub

Sub mnuFile_OpenVGV_Click()
    Dim path As String
    path = InputBox("Enter .VGV file path:", "Open", "user://animation.vgv")
    If Len(path) > 0 Then LoadVGV path
End Sub

Sub mnuFile_Save_Click()
    If Len(currentFile) > 0 Then
        SaveVGV currentFile
    Else
        mnuFile_SaveAs_Click
    End If
End Sub

Sub mnuFile_SaveAs_Click()
    Dim path As String
    path = InputBox("Save as:", "Save VGV", "user://animation.vgv")
    If Len(path) > 0 Then SaveVGV path
End Sub

Sub mnuFile_Exit_Click()
    GetTree().Quit()
End Sub

Sub mnuAnim_AddFrame_Click()
    AddFrame
End Sub

Sub mnuAnim_DeleteFrame_Click()
    DeleteFrame
End Sub

Sub mnuAnim_CloneFrame_Click()
    CloneFrame
End Sub

Sub mnuAnim_PlayPause_Click()
    isPlaying = Not isPlaying : playTimer = 0
End Sub

Sub mnuAnim_SetFPS_Click()
    Dim newFps As String
    newFps = InputBox("Set frames per second:", "FPS", Str(fps))
    If Len(newFps) > 0 Then
        fps = Val(newFps)
        If fps < 1 Then fps = 1
        If fps > 60 Then fps = 60
        SaveSetting "VGVector", "Config", "FPS", Str(fps)
    End If
End Sub

Sub mnuHelp_AboutVGVector_Click()
    MsgBox "VG Vector v1.0" & Chr(10) & Chr(10) & _
           "Vector Graphics & Animation Editor" & Chr(10) & _
           "Written in VisualGasic" & Chr(10) & Chr(10) & _
           "Saves to .VGV (VisualGasic Vector) format" & Chr(10) & _
           "Coordinate-based shapes — NOT pixel/bitmap" & Chr(10) & _
           "Tools: Select, Line, Rect, Ellipse, Polygon, Polyline, Text" & Chr(10) & _
           "Animation: timeline, onion skin, play/pause" & Chr(10) & Chr(10) & _
           "Shortcuts: 1-7=Tools, Space=Play, O=Onion, Arrows=Frames", _
           vbInformation, "About VG Vector"
End Sub

' ============================================================================
' ANIMATION PLAYBACK
' ============================================================================

Sub _Process(delta)
    If isPlaying Then
        playTimer = playTimer + delta
        Dim frameInterval As Double
        frameInterval = 1.0 / fps
        If playTimer >= frameInterval Then
            playTimer = playTimer - frameInterval
            currentFrame = currentFrame + 1
            If currentFrame >= frameCount Then currentFrame = 0
        End If
    End If
    QueueRedraw
End Sub

' ============================================================================
' RENDERING
' ============================================================================

Sub _Draw()
    Dim winW As Integer, winH As Integer
    winW = 1024 : winH = 700
    Dim canvasX As Integer, canvasY As Integer
    canvasX = TOOLBAR_W
    canvasY = MENU_H

    Dim timelineY As Integer
    timelineY = winH - TIMELINE_H - STATUS_H
    Dim canvasAreaW As Integer
    canvasAreaW = winW - TOOLBAR_W - PROPS_W
    Dim canvasAreaH As Integer
    canvasAreaH = timelineY - MENU_H

    ' ── Draw canvas background ────────────────────────────────────────────
    DrawRect Rect2(canvasX, canvasY, canvasAreaW, canvasAreaH), Color(1, 1, 1)

    ' ── Draw onion skin (previous frame, ghosted) ─────────────────────────
    If onionSkin And currentFrame > 0 And Not isPlaying Then
        DrawFrameShapes currentFrame - 1, canvasX, canvasY, 0.2
    End If

    ' ── Draw current frame shapes ─────────────────────────────────────────
    DrawFrameShapes currentFrame, canvasX, canvasY, 1.0

    ' ── Draw shape preview while creating ─────────────────────────────────
    If isDrawingShape Then
        Dim sx As Double, sy As Double, ex As Double, ey As Double
        sx = canvasX + drawStartX : sy = canvasY + drawStartY
        ex = canvasX + drawEndX : ey = canvasY + drawEndY
        Select Case currentToolIdx
            Case 1: DrawLine Vector2(sx, sy), Vector2(ex, ey), Color(0, 0, 0, 0.5), 2
            Case 2: DrawRect Rect2(sx, sy, ex - sx, ey - sy), Color(0, 0, 0, 0.3)
            Case 3
                Dim ecx As Double, ecy As Double, erx As Double, ery As Double
                ecx = (sx + ex) / 2 : ecy = (sy + ey) / 2
                erx = Abs(ex - sx) / 2 : ery = Abs(ey - sy) / 2
                ' Approximate ellipse with arc segments
                DrawCircle Vector2(ecx, ecy), (erx + ery) / 2, Color(0, 0, 0, 0.3)
        End Select
    End If

    ' ── Draw polygon vertices in progress ─────────────────────────────────
    If tempPolyCount > 0 Then
        Dim v As Integer
        For v = 0 To tempPolyCount - 2
            DrawLine Vector2(canvasX + tempPolyX(v), canvasY + tempPolyY(v)), _
                      Vector2(canvasX + tempPolyX(v + 1), canvasY + tempPolyY(v + 1)), _
                      Color(0, 0, 0.8), 2
        Next
        ' Show vertices
        For v = 0 To tempPolyCount - 1
            DrawCircle Vector2(canvasX + tempPolyX(v), canvasY + tempPolyY(v)), 4, Color(0, 0, 0.8)
        Next
    End If

    ' ── Draw selection handles ────────────────────────────────────────────
    If selectedShape >= 0 And Not isPlaying Then
        Dim si As Integer
        si = ShapeIdx(currentFrame, selectedShape)
        Dim selX1 As Double, selY1 As Double, selX2 As Double, selY2 As Double
        selX1 = canvasX + shapeX1(si) : selY1 = canvasY + shapeY1(si)
        selX2 = canvasX + shapeX2(si) : selY2 = canvasY + shapeY2(si)
        ' Bounding box
        DrawRect Rect2(selX1 - 3, selY1 - 3, selX2 - selX1 + 6, selY2 - selY1 + 6), Color(0, 0.5, 1, 0.3)
        ' Corner handles
        DrawRect Rect2(selX1 - 4, selY1 - 4, 8, 8), Color(0, 0.5, 1)
        DrawRect Rect2(selX2 - 4, selY2 - 4, 8, 8), Color(0, 0.5, 1)
    End If

    ' ── Draw toolbar ──────────────────────────────────────────────────────
    DrawRect Rect2(0, MENU_H, TOOLBAR_W, winH - MENU_H), Color(0.88, 0.88, 0.9)

    Dim toolLabels(7) As String
    toolLabels(0) = "Sel" : toolLabels(1) = "Lin" : toolLabels(2) = "Rct"
    toolLabels(3) = "Ell" : toolLabels(4) = "Pgn" : toolLabels(5) = "PLn"
    toolLabels(6) = "Txt"

    Dim t As Integer
    For t = 0 To 6
        Dim bx As Integer, by As Integer
        bx = 4 : by = MENU_H + 4 + t * (TOOL_BTN_SZ + 4)
        If t = currentToolIdx Then
            DrawRect Rect2(bx, by, TOOLBAR_W - 8, TOOL_BTN_SZ), Color(0.3, 0.5, 0.9)
            DrawString GetThemeDefaultFont(), Vector2(bx + 6, by + 17), toolLabels(t), Color(1, 1, 1)
        Else
            DrawRect Rect2(bx, by, TOOLBAR_W - 8, TOOL_BTN_SZ), Color(0.95, 0.95, 0.97)
            DrawString GetThemeDefaultFont(), Vector2(bx + 6, by + 17), toolLabels(t), Color(0.2, 0.2, 0.2)
        End If
    Next

    ' ── Draw properties panel ─────────────────────────────────────────────
    Dim propsX As Integer
    propsX = winW - PROPS_W
    DrawRect Rect2(propsX, MENU_H, PROPS_W, winH - MENU_H), Color(0.9, 0.9, 0.92)
    DrawRect Rect2(propsX, MENU_H, 1, winH - MENU_H), Color(0.7, 0.7, 0.75)

    ' Stroke section
    DrawString GetThemeDefaultFont(), Vector2(propsX + 8, MENU_H + 20), "STROKE", Color(0.3, 0.3, 0.4)
    DrawRect Rect2(propsX + 8, MENU_H + 28, 30, 20), Color8(strokeR, strokeG, strokeB, strokeA)
    DrawString GetThemeDefaultFont(), Vector2(propsX + 44, MENU_H + 44), "W:" & Str(strokeWidth), Color(0.3, 0.3, 0.4)

    ' Fill section
    DrawString GetThemeDefaultFont(), Vector2(propsX + 8, MENU_H + 60), "FILL", Color(0.3, 0.3, 0.4)
    DrawRect Rect2(propsX + 8, MENU_H + 68, 30, 20), Color8(fillR, fillG, fillB, fillA)

    ' Quick color palettes
    DrawString GetThemeDefaultFont(), Vector2(propsX + 8, MENU_H + 105), "Stroke Colors:", Color(0.4, 0.4, 0.5)
    Dim ci As Integer
    For ci = 0 To QPAL_COUNT - 1
        Dim cr As Integer, cc As Integer
        cr = ci \ 8 : cc = ci Mod 8
        DrawRect Rect2(propsX + 8 + cc * 22, MENU_H + 112 + cr * 22, 20, 20), _
                 Color8(qpalR(ci), qpalG(ci), qpalB(ci), 255)
    Next

    DrawString GetThemeDefaultFont(), Vector2(propsX + 8, MENU_H + 175), "Fill Colors:", Color(0.4, 0.4, 0.5)
    For ci = 0 To QPAL_COUNT - 1
        cr = ci \ 8 : cc = ci Mod 8
        DrawRect Rect2(propsX + 8 + cc * 22, MENU_H + 182 + cr * 22, 20, 20), _
                 Color8(qpalR(ci), qpalG(ci), qpalB(ci), 255)
    Next

    ' Shape info
    If selectedShape >= 0 Then
        Dim selIdx As Integer
        selIdx = ShapeIdx(currentFrame, selectedShape)
        DrawString GetThemeDefaultFont(), Vector2(propsX + 8, MENU_H + 260), "Selected: " & shapeType(selIdx), Color(0, 0.3, 0.6)
        DrawString GetThemeDefaultFont(), Vector2(propsX + 8, MENU_H + 280), _
            "Pos: " & Str(Int(shapeX1(selIdx))) & "," & Str(Int(shapeY1(selIdx))), Color(0.3, 0.3, 0.4)
    End If

    ' ── Draw timeline ─────────────────────────────────────────────────────
    DrawRect Rect2(0, timelineY, winW, TIMELINE_H), Color(0.2, 0.2, 0.25)
    DrawRect Rect2(0, timelineY, winW, 1), Color(0.4, 0.4, 0.5)

    ' Timeline label
    DrawString GetThemeDefaultFont(), Vector2(8, timelineY + 16), "Timeline", Color(0.6, 0.6, 0.7)
    Dim playLabel As String
    If isPlaying Then playLabel = "PLAYING" Else playLabel = "PAUSED"
    DrawString GetThemeDefaultFont(), Vector2(8, timelineY + 34), playLabel, Color(0.4, 0.8, 0.4)

    ' Frame thumbnails
    Dim fr As Integer
    For fr = 0 To frameCount - 1
        Dim fThumbX As Integer
        fThumbX = TOOLBAR_W + fr * 70
        Dim fThumbY As Integer
        fThumbY = timelineY + 8

        ' Frame box
        If fr = currentFrame Then
            DrawRect Rect2(fThumbX, fThumbY, 64, 50), Color(0.3, 0.5, 0.9)
        Else
            DrawRect Rect2(fThumbX, fThumbY, 64, 50), Color(0.35, 0.35, 0.4)
        End If

        ' Frame number
        DrawString GetThemeDefaultFont(), Vector2(fThumbX + 4, fThumbY + 15), Str(fr + 1), Color(1, 1, 1)
        ' Shape count
        DrawString GetThemeDefaultFont(), Vector2(fThumbX + 4, fThumbY + 35), _
            Str(frameShapeCount(fr)) & " shp", Color(0.7, 0.7, 0.8)

        ' Onion skin indicator
        If onionSkin And fr = currentFrame - 1 Then
            DrawString GetThemeDefaultFont(), Vector2(fThumbX + 44, fThumbY + 15), "O", Color(1, 0.8, 0.3)
        End If
    Next

    ' FPS indicator
    DrawString GetThemeDefaultFont(), Vector2(winW - 80, timelineY + 30), Str(fps) & " FPS", Color(0.6, 0.6, 0.7)

    ' ── Draw status bar ───────────────────────────────────────────────────
    Dim statusY As Integer
    statusY = winH - STATUS_H
    DrawRect Rect2(0, statusY, winW, STATUS_H), Color(0.15, 0.15, 0.2)

    Dim status As String
    status = vecToolNames(currentToolIdx) & "  |  Frame " & Str(currentFrame + 1) & "/" & Str(frameCount)
    status = status & "  |  " & Str(Int(mouseDocX)) & ", " & Str(Int(mouseDocY))
    status = status & "  |  Shapes: " & Str(frameShapeCount(currentFrame))
    If onionSkin Then status = status & "  |  Onion: ON"
    If isModified Then status = status & "  |  * Modified"
    DrawString GetThemeDefaultFont(), Vector2(8, statusY + 16), status, Color(0.7, 0.7, 0.8)
End Sub

' Draw all shapes for a given frame at a given opacity
Sub DrawFrameShapes(frameIdx As Integer, offsetX As Integer, offsetY As Integer, alpha As Double)
    Dim count As Integer
    count = frameShapeCount(frameIdx)
    Dim i As Integer

    For i = 0 To count - 1
        Dim idx As Integer
        idx = ShapeIdx(frameIdx, i)

        Dim x1 As Double, y1 As Double, x2 As Double, y2 As Double
        x1 = offsetX + shapeX1(idx)
        y1 = offsetY + shapeY1(idx)
        x2 = offsetX + shapeX2(idx)
        y2 = offsetY + shapeY2(idx)

        Dim sColor As Color
        sColor = Color8(shapeStrokeR(idx), shapeStrokeG(idx), shapeStrokeB(idx), Int(shapeStrokeA(idx) * alpha))
        Dim fColor As Color
        fColor = Color8(shapeFillR(idx), shapeFillG(idx), shapeFillB(idx), Int(shapeFillA(idx) * alpha))
        Dim sw As Double
        sw = shapeStrokeW(idx)

        Select Case shapeType(idx)

        Case "LINE"
            DrawLine Vector2(x1, y1), Vector2(x2, y2), sColor, sw

        Case "RECT"
            ' Draw filled rectangle
            If shapeFillA(idx) > 0 Then
                DrawRect Rect2(x1, y1, x2 - x1, y2 - y1), fColor
            End If
            ' Draw rectangle outline
            DrawLine Vector2(x1, y1), Vector2(x2, y1), sColor, sw
            DrawLine Vector2(x2, y1), Vector2(x2, y2), sColor, sw
            DrawLine Vector2(x2, y2), Vector2(x1, y2), sColor, sw
            DrawLine Vector2(x1, y2), Vector2(x1, y1), sColor, sw

        Case "ELLIPSE"
            Dim cx As Double, cy As Double, rx As Double, ry As Double
            cx = (x1 + x2) / 2 : cy = (y1 + y2) / 2
            rx = Abs(x2 - x1) / 2 : ry = Abs(y2 - y1) / 2
            ' Approximate with line segments
            Dim segments As Integer
            segments = Int((rx + ry) / 2)
            If segments < 16 Then segments = 16
            If segments > 64 Then segments = 64
            Dim a As Integer
            For a = 0 To segments - 1
                Dim ang1 As Double, ang2 As Double
                ang1 = (a * 6.2832) / segments
                ang2 = ((a + 1) * 6.2832) / segments
                DrawLine Vector2(cx + rx * Cos(ang1), cy + ry * Sin(ang1)), _
                          Vector2(cx + rx * Cos(ang2), cy + ry * Sin(ang2)), sColor, sw
            Next

        Case "POLYGON", "POLYLINE"
            Dim pc As Integer
            pc = polyPointCount(i)
            If pc >= 2 Then
                Dim v As Integer
                For v = 0 To pc - 2
                    DrawLine Vector2(offsetX + polyPointX(i, v), offsetY + polyPointY(i, v)), _
                              Vector2(offsetX + polyPointX(i, v + 1), offsetY + polyPointY(i, v + 1)), sColor, sw
                Next
                ' Close polygon
                If shapeType(idx) = "POLYGON" And pc >= 3 Then
                    DrawLine Vector2(offsetX + polyPointX(i, pc - 1), offsetY + polyPointY(i, pc - 1)), _
                              Vector2(offsetX + polyPointX(i, 0), offsetY + polyPointY(i, 0)), sColor, sw
                End If
            End If

        Case "TEXT"
            DrawString GetThemeDefaultFont(), Vector2(x1, y1 + 14), shapeText(idx), sColor

        End Select
    Next
End Sub
