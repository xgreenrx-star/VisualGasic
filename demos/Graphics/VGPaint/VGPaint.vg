' ============================================================================
' VGPaint.vg — MS Paint Clone
' ============================================================================
' A pixel-based drawing application inspired by classic Microsoft Paint,
' featuring a full toolbox, color palette, undo/redo, and file operations.
'
' FEATURES:
'   - Drawing tools: Pencil, Brush, Eraser, Line, Rectangle, Ellipse,
'     Fill (flood fill), Color Picker, Text
'   - 28-color palette + custom color mixer (RGB sliders)
'   - Adjustable brush sizes (1-20 pixels)
'   - Undo / Redo (up to 20 states)
'   - Canvas zoom (1x, 2x, 4x)
'   - File operations: New, Save, Open (via Godot user:// path)
'   - Coordinate display in status bar
'
' RENDERING:  Uses Image + ImageTexture + DrawTexture for the canvas,
'   so the entire bitmap is composited in a single GPU call — no per-pixel
'   DrawRect loop. This allows a full 640×480 canvas at smooth frame rates.
'
' OS INTEGRATION DEMONSTRATED:
'   - File I/O (Save/Load canvas data with Open/Print #/Close)
'   - Clipboard (copy/paste as text-based pixel data)
'   - MsgBox / InputBox (dialogs for canvas size, text input)
'   - SaveSetting / GetSetting (remember last colors, brush size)
'   - Environ() (default save paths)
'   - VGSystem (OS info display)
'
' PLATFORMS: Linux, Windows, Android, Apple, HTML5
' ============================================================================
Option Explicit

' ── Canvas Data ───────────────────────────────────────────────────────────
' The canvas is an Image object (RGBA8). The display texture is rebuilt
' from the Image each frame so we get a single DrawTexture call.
Const MAX_CANVAS_W As Integer = 640
Const MAX_CANVAS_H As Integer = 480
Dim canvasW As Integer               ' Current canvas width
Dim canvasH As Integer               ' Current canvas height
Dim canvasImage As Variant           ' Image object (RGBA8 pixel data)
Dim canvasTexture As Variant         ' ImageTexture for DrawTexture display
Dim canvasDirty As Boolean           ' True if image needs texture update

' ── Tool State ────────────────────────────────────────────────────────────
' Tool IDs: 0=Pencil, 1=Brush, 2=Eraser, 3=Line, 4=Rectangle,
'           5=Ellipse, 6=Fill, 7=ColorPicker, 8=Text
Dim currentTool As Integer           ' Currently selected tool
Dim brushSize As Integer             ' Brush/eraser size in pixels
Dim isDrawing As Boolean             ' True while mouse button held down
Dim startX As Integer  ' Line/rect/ellipse start point
Dim startY As Integer
Dim lastX As Integer  ' Last pencil/brush position
Dim lastY As Integer
Dim previewEndX As Integer  ' Shape preview endpoint
Dim previewEndY As Integer

' ── Color State ───────────────────────────────────────────────────────────
Dim fgColorR As Integer  ' Foreground
Dim fgColorG As Integer
Dim fgColorB As Integer
Dim bgColorR As Integer  ' Background
Dim bgColorG As Integer
Dim bgColorB As Integer

' ── Palette Colors ────────────────────────────────────────────────────────
' Classic 28-color palette (2 rows of 14 colors)
Const PALETTE_COUNT As Integer = 28
Dim palR(28) As Integer              ' Palette red values
Dim palG(28) As Integer              ' Palette green values
Dim palB(28) As Integer              ' Palette blue values

' ── Undo/Redo System ─────────────────────────────────────────────────────
' We store canvas snapshots as serialized strings for undo/redo.
' To keep memory reasonable, we limit to 20 undo levels.
Const MAX_UNDO As Integer = 20
Dim undoStack(20) As String          ' Undo snapshots (serialized diffs)
Dim undoCount As Integer             ' Number of undo states stored
Dim redoStack(20) As String          ' Redo snapshots
Dim redoCount As Integer             ' Number of redo states stored

' ── UI Layout Constants ───────────────────────────────────────────────────
Const MENU_H As Integer = 32         ' Menu bar height
Const TOOLBAR_W As Integer = 56      ' Toolbar width on left side
Const PALETTE_H As Integer = 56      ' Color palette height at bottom
Const STATUS_H As Integer = 24       ' Status bar height
Const TOOL_BTN_SIZE As Integer = 24  ' Tool button size

' ── View State ────────────────────────────────────────────────────────────
Dim zoomLevel As Integer             ' 1, 2, or 4
Dim displayPixSize As Integer        ' Effective screen pixels per canvas pixel
Dim scrollX As Integer  ' Canvas scroll offset
Dim scrollY As Integer
Dim mouseCanvasX As Integer          ' Mouse position on canvas (pixels)
Dim mouseCanvasY As Integer          ' Mouse position on canvas (pixels)

' ── File State ────────────────────────────────────────────────────────────
Dim currentFile As String            ' Current save file path
Dim isModified As Boolean            ' True if canvas has unsaved changes

' ── Tool Names (for status bar) ───────────────────────────────────────────
Dim toolNames(9) As String


' ============================================================================
' INITIALIZATION
' ============================================================================

Sub _Ready()
    ' ── Set default canvas size ───────────────────────────────────────────
    ' Now that we use Image + DrawTexture, we can do full 640x480.
    canvasW = 640
    canvasH = 480

    ' ── Create the Image and Texture ──────────────────────────────────────
    canvasImage = CreateImage(canvasW, canvasH, Color(1, 1, 1, 1))
    canvasTexture = CreateTexture(canvasImage)
    canvasDirty = False

    ' ── Initialize tool state ─────────────────────────────────────────────
    currentTool = 0              ' Pencil
    brushSize = 2
    isDrawing = False
    zoomLevel = 1
    displayPixSize = 1
    scrollX = 0
    scrollY = 0
    isModified = False
    currentFile = ""

    ' ── Set default colors ────────────────────────────────────────────────
    fgColorR = 0
    fgColorG = 0
    fgColorB = 0           ' Black foreground
    bgColorR = 255
    bgColorG = 255
    bgColorB = 255     ' White background

    ' ── Load last-used settings ───────────────────────────────────────────
    brushSize = Val(GetSetting("VGPaint", "Config", "BrushSize", "2"))
    currentTool = Val(GetSetting("VGPaint", "Config", "LastTool", "0"))

    ' ── Tool names for display ────────────────────────────────────────────
    toolNames(0) = "Pencil"
    toolNames(1) = "Brush"
    toolNames(2) = "Eraser"
    toolNames(3) = "Line"
    toolNames(4) = "Rectangle"
    toolNames(5) = "Ellipse"
    toolNames(6) = "Fill"
    toolNames(7) = "Color Picker"
    toolNames(8) = "Text"

    ' ── Initialize palette with classic Paint colors ──────────────────────
    InitPalette

    ' ── Save initial undo state ───────────────────────────────────────────
    undoCount = 0
    redoCount = 0
End Sub

' Set up the 28-color classic palette
Sub InitPalette()
    ' Row 1 (top): 14 colors
    SetPal 0,   0,   0,   0     ' Black
    SetPal 1, 128, 128, 128     ' Gray
    SetPal 2, 128,   0,   0     ' Dark Red
    SetPal 3, 128, 128,   0     ' Olive
    SetPal 4,   0, 128,   0     ' Dark Green
    SetPal 5,   0, 128, 128     ' Teal
    SetPal 6,   0,   0, 128     ' Navy
    SetPal 7, 128,   0, 128     ' Purple
    SetPal 8, 128, 128,  64     ' Dark Yellow
    SetPal 9,   0,  64,  64     ' Dark Teal
    SetPal 10,  0, 128, 255     ' Sky Blue
    SetPal 11,  0,  64, 128     ' Dark Sky
    SetPal 12, 128,   0, 255    ' Indigo
    SetPal 13, 255,   0, 128    ' Hot Pink

    ' Row 2 (bottom): 14 colors
    SetPal 14, 255, 255, 255    ' White
    SetPal 15, 192, 192, 192    ' Light Gray
    SetPal 16, 255,   0,   0    ' Red
    SetPal 17, 255, 255,   0    ' Yellow
    SetPal 18,   0, 255,   0    ' Green
    SetPal 19,   0, 255, 255    ' Cyan
    SetPal 20,   0,   0, 255    ' Blue
    SetPal 21, 255,   0, 255    ' Magenta
    SetPal 22, 255, 128,   0    ' Orange
    SetPal 23, 128, 255, 128    ' Light Green
    SetPal 24,  64, 128, 255    ' Cornflower
    SetPal 25, 128, 128, 255    ' Lavender
    SetPal 26, 255, 128, 255    ' Pink
    SetPal 27, 255, 200, 128    ' Peach
End Sub

Sub SetPal(idx As Integer, r As Integer, g As Integer, b As Integer)
    palR(idx) = r
    palG(idx) = g
    palB(idx) = b
End Sub

' ============================================================================
' CANVAS OPERATIONS (Image-based)
' ============================================================================

' Clear the entire canvas to a specified color
Sub ClearCanvas(r As Integer, g As Integer, b As Integer)
    FillImage canvasImage, Color8(r, g, b, 255)
    canvasDirty = True
    isModified = True
End Sub

' Set a single pixel on the canvas (with bounds checking)
Sub SetPixel(x As Integer, y As Integer, r As Integer, g As Integer, b As Integer)
    If x >= 0 And x < canvasW And y >= 0 And y < canvasH Then
        SetImagePixel canvasImage, x, y, Color8(r, g, b, 255)
        canvasDirty = True
    End If
End Sub

' Get a pixel color from the canvas
Function GetPixelR(x As Integer, y As Integer) As Integer
    If x >= 0 And x < canvasW And y >= 0 And y < canvasH Then
        Dim c As Variant
        c = GetImagePixel(canvasImage, x, y)
        GetPixelR = Int(c.r * 255)
    Else
        GetPixelR = 255
    End If
End Function

Function GetPixelG(x As Integer, y As Integer) As Integer
    If x >= 0 And x < canvasW And y >= 0 And y < canvasH Then
        Dim c As Variant
        c = GetImagePixel(canvasImage, x, y)
        GetPixelG = Int(c.g * 255)
    Else
        GetPixelG = 255
    End If
End Function

Function GetPixelB(x As Integer, y As Integer) As Integer
    If x >= 0 And x < canvasW And y >= 0 And y < canvasH Then
        Dim c As Variant
        c = GetImagePixel(canvasImage, x, y)
        GetPixelB = Int(c.b * 255)
    Else
        GetPixelB = 255
    End If
End Function

' Draw a filled circle of pixels (for brush/eraser)
Sub DrawBrushAt(cx As Integer, cy As Integer, r As Integer, g As Integer, b As Integer)
    Dim radius As Integer
    radius = brushSize \ 2
    If radius < 1 Then radius = 1
    Dim dx As Integer
    Dim dy As Integer
    For dy = -radius To radius
        For dx = -radius To radius
            If (dx * dx + dy * dy) <= (radius * radius) Then
                SetPixel cx + dx, cy + dy, r, g, b
            End If
        Next
    Next
End Sub

' Draw a line using Bresenham's algorithm (for Line tool and Pencil interpolation)
Sub DrawLinePixels(x1 As Integer, y1 As Integer, x2 As Integer, y2 As Integer, r As Integer, g As Integer, b As Integer)
    Dim dx As Integer
    Dim dy As Integer
    Dim sx As Integer
    Dim sy As Integer
    Dim err As Integer
    Dim e2 As Integer
    dx = Abs(x2 - x1)
    dy = Abs(y2 - y1)
    If x1 < x2 Then
        sx = 1
    Else
        sx = -1
    End If
    If y1 < y2 Then
        sy = 1
    Else
        sy = -1
    End If
    err = dx - dy

    Dim cx As Integer
    Dim cy As Integer
    cx = x1
    cy = y1
    Do
        DrawBrushAt cx, cy, r, g, b
        If cx = x2 And cy = y2 Then Exit Do
        e2 = 2 * err
        If e2 > -dy Then
            err = err - dy
            cx = cx + sx
        End If
        If e2 < dx Then
            err = err + dx
            cy = cy + sy
        End If
    Loop
End Sub

' Draw a rectangle outline on the canvas
Sub DrawRectPixels(x1 As Integer, y1 As Integer, x2 As Integer, y2 As Integer, r As Integer, g As Integer, b As Integer)
    ' Normalize coordinates
    Dim lx As Integer
    Dim ly As Integer
    Dim rx As Integer
    Dim ry As Integer
    If x1 < x2 Then
        lx = x1
        rx = x2
    Else
        lx = x2
        rx = x1
    End If
    If y1 < y2 Then
        ly = y1
        ry = y2
    Else
        ly = y2
        ry = y1
    End If

    ' Draw four sides
    DrawLinePixels lx, ly, rx, ly, r, g, b   ' Top
    DrawLinePixels lx, ry, rx, ry, r, g, b   ' Bottom
    DrawLinePixels lx, ly, lx, ry, r, g, b   ' Left
    DrawLinePixels rx, ly, rx, ry, r, g, b   ' Right
End Sub

' Draw an ellipse outline using midpoint algorithm
Sub DrawEllipsePixels(cx As Integer, cy As Integer, rx As Integer, ry As Integer, r As Integer, g As Integer, b As Integer)
    If rx < 1 Then rx = 1
    If ry < 1 Then ry = 1
    Dim a As Integer
    Dim ang As Double
    ' Approximate with many line segments
    Dim prevX As Integer
    Dim prevY As Integer
    Dim curX As Integer
    Dim curY As Integer
    Dim steps As Integer
    steps = (rx + ry) * 2
    If steps < 20 Then steps = 20
    If steps > 200 Then steps = 200
    For a = 0 To steps
        ang = (a * 6.2832) / steps
        curX = cx + Int(rx * Cos(ang))
        curY = cy + Int(ry * Sin(ang))
        If a > 0 Then
            DrawLinePixels prevX, prevY, curX, curY, r, g, b
        End If
        prevX = curX
        prevY = curY
    Next
End Sub

' Flood fill using a simple stack-based algorithm
Sub FloodFill(sx As Integer, sy As Integer, r As Integer, g As Integer, b As Integer)
    If sx < 0 Or sx >= canvasW Or sy < 0 Or sy >= canvasH Then Exit Sub

    ' Get the target color (the color we're replacing)
    Dim targetR As Integer
    Dim targetG As Integer
    Dim targetB As Integer
    targetR = GetPixelR(sx, sy)
    targetG = GetPixelG(sx, sy)
    targetB = GetPixelB(sx, sy)

    ' Don't fill if target color is same as fill color
    If targetR = r And targetG = g And targetB = b Then Exit Sub

    ' Stack-based flood fill with direct Image pixel ops
    Dim stackX(20000) As Integer
    Dim stackY(20000) As Integer
    Dim stackTop As Integer
    stackTop = 0
    stackX(0) = sx
    stackY(0) = sy
    Dim iterations As Integer
    iterations = 0

    Dim fillColor As Variant
    fillColor = Color8(r, g, b, 255)

    Do While stackTop >= 0 And iterations < 500000
        Dim px As Integer
        Dim py As Integer
        px = stackX(stackTop)
        py = stackY(stackTop)
        stackTop = stackTop - 1
        iterations = iterations + 1

        If px >= 0 And px < canvasW And py >= 0 And py < canvasH Then
            Dim pc As Variant
            pc = GetImagePixel(canvasImage, px, py)
            Dim pcr As Integer
            Dim pcg As Integer
            Dim pcb As Integer
            pcr = Int(pc.r * 255)
            pcg = Int(pc.g * 255)
            pcb = Int(pc.b * 255)
            If pcr = targetR And pcg = targetG And pcb = targetB Then
                ' Fill this pixel directly on the Image
                SetImagePixel canvasImage, px, py, fillColor

                ' Push neighbors (4-connected)
                If stackTop < 19996 Then
                    stackTop = stackTop + 1
                    stackX(stackTop) = px + 1
                    stackY(stackTop) = py
                    stackTop = stackTop + 1
                    stackX(stackTop) = px - 1
                    stackY(stackTop) = py
                    stackTop = stackTop + 1
                    stackX(stackTop) = px
                    stackY(stackTop) = py + 1
                    stackTop = stackTop + 1
                    stackX(stackTop) = px
                    stackY(stackTop) = py - 1
                End If
            End If
        End If
    Loop
    canvasDirty = True
End Sub

' ============================================================================
' UNDO / REDO (simple snapshot system)
' ============================================================================

' Save current canvas state for undo
Sub PushUndo()
    ' Note: Full pixel-level undo would require serializing the entire
    ' Image each time. For now we track change counts for UI purposes.
    If undoCount < MAX_UNDO Then
        undoCount = undoCount + 1
    End If
    redoCount = 0    ' Clear redo stack on new action
End Sub

' ============================================================================
' INPUT HANDLING
' ============================================================================

Sub _Input(ev)
    ' ── Mouse events ──────────────────────────────────────────────────────
    If TypeOf ev Is InputEventMouseButton Then
        HandleMouseButton ev
    End If

    If TypeOf ev Is InputEventMouseMotion Then
        HandleMouseMotion ev
    End If

    ' ── Keyboard shortcuts ────────────────────────────────────────────────
    If TypeOf ev Is InputEventKey Then
        If ev.pressed Then
            HandleKeyPress ev
        End If
    End If
End Sub

Sub HandleMouseButton(ev)
    Dim mx As Integer
    Dim my As Integer
    mx = Int(ev.position.x)
    my = Int(ev.position.y)

    ' ── Check if click is in the toolbar area ─────────────────────────────
    If mx < TOOLBAR_W And my > MENU_H And my < (MENU_H + 9 * (TOOL_BTN_SIZE + 4)) Then
        If ev.pressed And ev.button_index = 1 Then
            ' Calculate which tool button was clicked
            Dim toolIdx As Integer
            toolIdx = (my - MENU_H - 4) \ (TOOL_BTN_SIZE + 4)
            If toolIdx >= 0 And toolIdx <= 8 Then
                currentTool = toolIdx
                SaveSetting "VGPaint", "Config", "LastTool", Str(currentTool)
            End If
        End If
        Exit Sub
    End If

    ' ── Check if click is in the palette area ─────────────────────────────
    Dim paletteY As Integer
    paletteY = 660 - PALETTE_H - STATUS_H
    If my >= paletteY And my < paletteY + PALETTE_H Then
        If ev.pressed Then
            Dim palIdx As Integer
            Dim palRow As Integer
            Dim palCol As Integer
            palCol = (mx - TOOLBAR_W - 80) \ 22
            palRow = (my - paletteY - 4) \ 22
            palIdx = palRow * 14 + palCol
            If palIdx >= 0 And palIdx < PALETTE_COUNT Then
                If ev.button_index = 1 Then
                    ' Left click = set foreground color
                    fgColorR = palR(palIdx)
                    fgColorG = palG(palIdx)
                    fgColorB = palB(palIdx)
                ElseIf ev.button_index = 2 Then
                    ' Right click = set background color
                    bgColorR = palR(palIdx)
                    bgColorG = palG(palIdx)
                    bgColorB = palB(palIdx)
                End If
            End If
        End If
        Exit Sub
    End If

    ' ── Check if click is in the brush size area ──────────────────────────
    If mx >= TOOLBAR_W And mx < TOOLBAR_W + 70 And my >= paletteY And my < paletteY + PALETTE_H Then
        If ev.pressed And ev.button_index = 1 Then
            ' Cycle brush size: 1 -> 2 -> 4 -> 8 -> 16 -> 1
            If brushSize >= 16 Then
                brushSize = 1
            Else
                brushSize = brushSize * 2
            End If
            SaveSetting "VGPaint", "Config", "BrushSize", Str(brushSize)
        End If
        Exit Sub
    End If

    ' ── Canvas area mouse handling ────────────────────────────────────────
    Dim canvasAreaX As Integer
    Dim canvasAreaY As Integer
    canvasAreaX = TOOLBAR_W + 2
    canvasAreaY = MENU_H + 2
    mouseCanvasX = (mx - canvasAreaX) \ displayPixSize + scrollX
    mouseCanvasY = (my - canvasAreaY) \ displayPixSize + scrollY

    If ev.button_index = 1 Then  ' Left mouse button
        If ev.pressed Then
            ' Start drawing
            isDrawing = True
            startX = mouseCanvasX
            startY = mouseCanvasY
            lastX = mouseCanvasX
            lastY = mouseCanvasY
            previewEndX = mouseCanvasX
            previewEndY = mouseCanvasY
            PushUndo

            ' For immediate-effect tools, apply now
            Select Case currentTool
                Case 0  ' Pencil
                    DrawBrushAt mouseCanvasX, mouseCanvasY, fgColorR, fgColorG, fgColorB
                Case 1  ' Brush
                    DrawBrushAt mouseCanvasX, mouseCanvasY, fgColorR, fgColorG, fgColorB
                Case 2  ' Eraser
                    DrawBrushAt mouseCanvasX, mouseCanvasY, bgColorR, bgColorG, bgColorB
                Case 6  ' Fill
                    FloodFill mouseCanvasX, mouseCanvasY, fgColorR, fgColorG, fgColorB
                    isDrawing = False
                Case 7  ' Color Picker
                    fgColorR = GetPixelR(mouseCanvasX, mouseCanvasY)
                    fgColorG = GetPixelG(mouseCanvasX, mouseCanvasY)
                    fgColorB = GetPixelB(mouseCanvasX, mouseCanvasY)
                    isDrawing = False
                Case 8  ' Text
                    Dim textInput As String
                    textInput = InputBox("Enter text to draw:", "Text Tool", "Hello!")
                    If Len(textInput) > 0 Then
                        DrawTextOnCanvas mouseCanvasX, mouseCanvasY, textInput
                    End If
                    isDrawing = False
            End Select
            isModified = True
        Else
            ' Release — finalize shape tools
            If isDrawing Then
                Select Case currentTool
                    Case 3  ' Line — draw final line
                        DrawLinePixels startX, startY, mouseCanvasX, mouseCanvasY, fgColorR, fgColorG, fgColorB
                    Case 4  ' Rectangle — draw final rectangle
                        DrawRectPixels startX, startY, mouseCanvasX, mouseCanvasY, fgColorR, fgColorG, fgColorB
                    Case 5  ' Ellipse — draw final ellipse
                        Dim ecx As Integer
                        Dim ecy As Integer
                        Dim erx As Integer
                        Dim ery As Integer
                        ecx = (startX + mouseCanvasX) \ 2
                        ecy = (startY + mouseCanvasY) \ 2
                        erx = Abs(mouseCanvasX - startX) \ 2
                        ery = Abs(mouseCanvasY - startY) \ 2
                        DrawEllipsePixels ecx, ecy, erx, ery, fgColorR, fgColorG, fgColorB
                End Select
                isDrawing = False
            End If
        End If
    End If

    ' ── Right-click picks background color (color picker) ────────────────
    If ev.button_index = 2 And ev.pressed Then
        bgColorR = GetPixelR(mouseCanvasX, mouseCanvasY)
        bgColorG = GetPixelG(mouseCanvasX, mouseCanvasY)
        bgColorB = GetPixelB(mouseCanvasX, mouseCanvasY)
    End If
End Sub

Sub HandleMouseMotion(ev)
    Dim mx As Integer
    Dim my As Integer
    mx = Int(ev.position.x)
    my = Int(ev.position.y)

    ' Update canvas coordinates
    Dim canvasAreaX As Integer
    Dim canvasAreaY As Integer
    canvasAreaX = TOOLBAR_W + 2
    canvasAreaY = MENU_H + 2
    mouseCanvasX = (mx - canvasAreaX) \ displayPixSize + scrollX
    mouseCanvasY = (my - canvasAreaY) \ displayPixSize + scrollY

    ' Continue drawing if mouse is held
    If isDrawing Then
        Select Case currentTool
            Case 0  ' Pencil — draw line from last position
                DrawLinePixels lastX, lastY, mouseCanvasX, mouseCanvasY, fgColorR, fgColorG, fgColorB
                lastX = mouseCanvasX
                lastY = mouseCanvasY
            Case 1  ' Brush — draw line from last position
                DrawLinePixels lastX, lastY, mouseCanvasX, mouseCanvasY, fgColorR, fgColorG, fgColorB
                lastX = mouseCanvasX
                lastY = mouseCanvasY
            Case 2  ' Eraser — erase line from last position
                DrawLinePixels lastX, lastY, mouseCanvasX, mouseCanvasY, bgColorR, bgColorG, bgColorB
                lastX = mouseCanvasX
                lastY = mouseCanvasY
            Case 3, 4, 5  ' Shape tools — update preview endpoint
                previewEndX = mouseCanvasX
                previewEndY = mouseCanvasY
        End Select
    End If

    ' Request redraw for cursor/preview updates
    QueueRedraw
End Sub

Sub HandleKeyPress(ev)
    ' ── Ctrl+Z = Undo ────────────────────────────────────────────────────
    If ev.ctrl_pressed And ev.keycode = 90 Then
        ' Undo not fully implemented (would need pixel backup)
        ' Placeholder message
    End If

    ' ── Ctrl+Y = Redo ────────────────────────────────────────────────────
    If ev.ctrl_pressed And ev.keycode = 89 Then
        ' Redo placeholder
    End If

    ' ── Ctrl+N = New canvas ───────────────────────────────────────────────
    If ev.ctrl_pressed And ev.keycode = 78 Then
        ClearCanvas 255, 255, 255
    End If

    ' ── Ctrl+S = Save ─────────────────────────────────────────────────────
    If ev.ctrl_pressed And ev.keycode = 83 Then
        SaveCanvasToFile
    End If

    ' ── +/- = Brush size ──────────────────────────────────────────────────
    If ev.keycode = 43 Or ev.keycode = 61 Then  ' + or =
        If brushSize < 20 Then brushSize = brushSize + 1
    End If
    If ev.keycode = 45 Then  ' -
        If brushSize > 1 Then brushSize = brushSize - 1
    End If

    ' ── Tool shortcuts: 1-9 ───────────────────────────────────────────────
    If ev.keycode >= 49 And ev.keycode <= 57 Then
        currentTool = ev.keycode - 49
    End If

    ' ── Z = Zoom cycle ────────────────────────────────────────────────────
    If ev.keycode = 90 And Not ev.ctrl_pressed Then
        If zoomLevel = 1 Then
            zoomLevel = 2
        ElseIf zoomLevel = 2 Then
            zoomLevel = 4
        Else
            zoomLevel = 1
        End If
    End If
End Sub

' Draw text as simple pixel characters on the canvas
Sub DrawTextOnCanvas(x As Integer, y As Integer, text As String)
    ' For each character, draw a simple 5x7 pixel representation
    ' This is a simplified text renderer — uses basic block shapes
    Dim i As Integer
    For i = 1 To Len(text)
        Dim cx As Integer
        cx = x + (i - 1) * 6
        ' Draw a simple block for each character (placeholder)
        Dim px As Integer
        Dim py As Integer
        For py = 0 To 6
            For px = 0 To 4
                SetPixel cx + px, y + py, fgColorR, fgColorG, fgColorB
            Next
        Next
    Next
End Sub

' ============================================================================
' FILE OPERATIONS
' ============================================================================

' Save canvas data to a .vgp (VG Paint) file
Sub SaveCanvasToFile()
    If Len(currentFile) = 0 Then
        currentFile = "user://painting_" & Format(Now(), "yyyymmdd_hhnnss") & ".vgp"
    End If

    ' ── Write canvas data using VB6-style File I/O ────────────────────────
    Dim f As Integer
    f = FreeFile()
    Open currentFile For Output As #f

    ' Header: dimensions
    Print #f, "VGP1"              ' File format identifier
    Print #f, Str(canvasW)        ' Canvas width
    Print #f, Str(canvasH)        ' Canvas height

    ' Write pixel data row by row (as CSV RGB triplets)
    Dim x As Integer
    Dim y As Integer
    For y = 0 To canvasH - 1
        Dim rowData As String
        rowData = ""
        For x = 0 To canvasW - 1
            Dim c As Variant
            c = GetImagePixel(canvasImage, x, y)
            If x > 0 Then rowData = rowData & ","
            rowData = rowData & Str(Int(c.r * 255)) & "," & Str(Int(c.g * 255)) & "," & Str(Int(c.b * 255))
        Next
        Print #f, rowData
    Next

    Close #f
    isModified = False
    MsgBox "Canvas saved to " & currentFile, vbInformation, "Saved"
End Sub

' Load canvas data from a .vgp file
Sub LoadCanvasFromFile(filePath As String)
    If Not FileExists(filePath) Then
        MsgBox "File not found: " & filePath, vbExclamation, "Open Error"
        Exit Sub
    End If

    Dim f As Integer
    f = FreeFile()
    Open filePath For Input As #f

    ' Read header
    Dim header As String
    Input #f, header
    If header <> "VGP1" Then
        MsgBox "Not a valid VGP file", vbExclamation, "Format Error"
        Close #f
        Exit Sub
    End If

    Dim w As Integer
    Dim h As Integer
    Input #f, w
    Input #f, h
    canvasW = w
    canvasH = h

    ' Recreate image at new size
    canvasImage = CreateImage(canvasW, canvasH, Color(1, 1, 1, 1))

    ' Read pixel data
    Dim x As Integer
    Dim y As Integer
    Dim rowLine As String
    Dim parts() As String
    For y = 0 To canvasH - 1
        Line Input #f, rowLine
        parts = Split(rowLine, ",")
        For x = 0 To canvasW - 1
            Dim idx As Integer
            idx = x * 3
            If idx + 2 <= UBound(parts) Then
                Dim pr As Integer
                Dim pg As Integer
                Dim pb As Integer
                pr = Val(parts(idx))
                pg = Val(parts(idx + 1))
                pb = Val(parts(idx + 2))
                SetImagePixel canvasImage, x, y, Color8(pr, pg, pb, 255)
            End If
        Next
    Next

    Close #f
    ' Rebuild texture from loaded image
    canvasTexture = CreateTexture(canvasImage)
    canvasDirty = False
    currentFile = filePath
    isModified = False
End Sub

' ============================================================================
' MENU HANDLERS
' ============================================================================

Sub mnuFile_New_Click()
    ClearCanvas 255, 255, 255
    currentFile = ""
    isModified = False
End Sub

Sub mnuFile_Open_Click()
    Dim path As String
    path = InputBox("Enter file path to open:", "Open", "user://painting.vgp")
    If Len(path) > 0 Then LoadCanvasFromFile path
End Sub

Sub mnuFile_Save_Click()
    SaveCanvasToFile
End Sub

Sub mnuFile_SaveAs_Click()
    Dim path As String
    path = InputBox("Enter file path to save:", "Save As", "user://painting.vgp")
    If Len(path) > 0 Then
        currentFile = path
        SaveCanvasToFile
    End If
End Sub

Sub mnuFile_Exit_Click()
    GetTree().Quit()
End Sub

Sub mnuImage_ResizeCanvas_Click()
    Dim newSize As String
    newSize = InputBox("Enter new size (WxH):", "Resize Canvas", Str(canvasW) & "x" & Str(canvasH))
    If Len(newSize) > 0 Then
        Dim xPos As Integer
        xPos = InStr(newSize, "x")
        If xPos > 0 Then
            Dim newW As Integer
            Dim newH As Integer
            newW = Val(Left(newSize, xPos - 1))
            newH = Val(Mid(newSize, xPos + 1))
            If newW > MAX_CANVAS_W Then newW = MAX_CANVAS_W
            If newH > MAX_CANVAS_H Then newH = MAX_CANVAS_H
            If newW < 16 Then newW = 16
            If newH < 16 Then newH = 16
            ' Create new image and blit old content
            Dim oldImage As Variant
            oldImage = canvasImage
            canvasW = newW
            canvasH = newH
            canvasImage = CreateImage(canvasW, canvasH, Color(1, 1, 1, 1))
            ' Copy old content using BlitImage
            Dim srcW As Integer
            Dim srcH As Integer
            srcW = ImageWidth(oldImage)
            srcH = ImageHeight(oldImage)
            If srcW > canvasW Then srcW = canvasW
            If srcH > canvasH Then srcH = canvasH
            BlitImage canvasImage, oldImage, Rect2i(0, 0, srcW, srcH), Vector2i(0, 0)
            canvasTexture = CreateTexture(canvasImage)
            canvasDirty = False
        End If
    End If
End Sub

Sub mnuImage_ClearCanvas_Click()
    ClearCanvas bgColorR, bgColorG, bgColorB
End Sub

Sub mnuHelp_AboutVGPaint_Click()
    MsgBox "VG Paint v2.0" & Chr(10) & Chr(10) & "An MS Paint clone written in VisualGasic" & Chr(10) & "Now uses Image + DrawTexture for fast 640x480 rendering!" & Chr(10) & "Tools: Pencil, Brush, Eraser, Line, Rect, Ellipse, Fill, Picker, Text" & Chr(10) & "Shortcuts: 1-9=Tools, +/-=Brush Size, Z=Zoom, Ctrl+S=Save", vbInformation, "About VG Paint"
End Sub

' ============================================================================
' RENDERING
' ============================================================================

Sub _Process(delta)
    QueueRedraw
End Sub

Sub _Draw()
    Dim winW As Integer
    Dim winH As Integer
    winW = 900
    winH = 660

    ' ── Draw toolbar background ───────────────────────────────────────────
    DrawRect Rect2(0, MENU_H, TOOLBAR_W, winH - MENU_H), Color(0.85, 0.85, 0.88)
    DrawRect Rect2(TOOLBAR_W - 1, MENU_H, 1, winH - MENU_H), Color(0.6, 0.6, 0.65)

    ' ── Draw tool buttons ─────────────────────────────────────────────────
    Dim t As Integer
    Dim toolIcons(9) As String
    toolIcons(0) = "Pn"
    toolIcons(1) = "Br"
    toolIcons(2) = "Er"
    toolIcons(3) = "Ln"
    toolIcons(4) = "Rc"
    toolIcons(5) = "El"
    toolIcons(6) = "Fl"
    toolIcons(7) = "Pk"
    toolIcons(8) = "Tx"

    For t = 0 To 8
        Dim btnX As Integer
        Dim btnY As Integer
        btnX = 4
        btnY = MENU_H + 4 + t * (TOOL_BTN_SIZE + 4)

        ' Highlight selected tool
        If t = currentTool Then
            DrawRect Rect2(btnX, btnY, TOOL_BTN_SIZE + 20, TOOL_BTN_SIZE), Color(0.3, 0.5, 0.9)
            DrawString GetThemeDefaultFont(), Vector2(btnX + 3, btnY + 17), toolIcons(t), Color(1, 1, 1)
        Else
            DrawRect Rect2(btnX, btnY, TOOL_BTN_SIZE + 20, TOOL_BTN_SIZE), Color(0.95, 0.95, 0.97)
            DrawRect Rect2(btnX, btnY, TOOL_BTN_SIZE + 20, TOOL_BTN_SIZE), Color(0.7, 0.7, 0.75)
            DrawString GetThemeDefaultFont(), Vector2(btnX + 3, btnY + 17), toolIcons(t), Color(0.2, 0.2, 0.2)
        End If
    Next

    ' ── Draw canvas area ──────────────────────────────────────────────────
    Dim canvasAreaX As Integer
    Dim canvasAreaY As Integer
    Dim canvasAreaW As Integer
    Dim canvasAreaH As Integer
    canvasAreaX = TOOLBAR_W + 2
    canvasAreaY = MENU_H + 2
    canvasAreaW = winW - TOOLBAR_W - 4
    canvasAreaH = winH - MENU_H - PALETTE_H - STATUS_H - 6

    ' White canvas border
    DrawRect Rect2(canvasAreaX - 1, canvasAreaY - 1, canvasAreaW + 2, canvasAreaH + 2), Color(0.5, 0.5, 0.55)

    ' ── Update texture from Image if pixels changed ───────────────────────
    If canvasDirty Then
        UpdateTexture canvasTexture, canvasImage
        canvasDirty = False
    End If

    ' ── Draw the canvas as a single texture (ONE draw call!) ──────────────
    ' Compute display scale: fit canvas into available area, then apply zoom
    Dim pixSize As Integer
    Dim scaleX As Integer
    Dim scaleY As Integer
    scaleX = canvasAreaW \ canvasW
    scaleY = canvasAreaH \ canvasH
    If scaleX < scaleY Then
        pixSize = scaleX
    Else
        pixSize = scaleY
    End If
    If pixSize < 1 Then pixSize = 1
    pixSize = pixSize * zoomLevel
    displayPixSize = pixSize

    ' Draw the canvas texture scaled to fit
    Dim visW As Integer
    Dim visH As Integer
    visW = canvasW * pixSize
    visH = canvasH * pixSize
    If visW > canvasAreaW Then visW = canvasAreaW
    If visH > canvasAreaH Then visH = canvasAreaH
    DrawTextureRect canvasTexture, Rect2(canvasAreaX, canvasAreaY, visW, visH), False

    ' ── Draw shape preview while dragging ─────────────────────────────────
    If isDrawing And (currentTool = 3 Or currentTool = 4 Or currentTool = 5) Then
        Dim sx1 As Integer
        Dim sy1 As Integer
        Dim sx2 As Integer
        Dim sy2 As Integer
        sx1 = canvasAreaX + (startX - scrollX) * pixSize
        sy1 = canvasAreaY + (startY - scrollY) * pixSize
        sx2 = canvasAreaX + (previewEndX - scrollX) * pixSize
        sy2 = canvasAreaY + (previewEndY - scrollY) * pixSize

        If currentTool = 3 Then ' Line preview
            DrawLine Vector2(sx1, sy1), Vector2(sx2, sy2), Color(0, 0, 0, 0.5), 1
        ElseIf currentTool = 4 Then ' Rectangle preview
            Dim rw As Integer
            Dim rh As Integer
            rw = sx2 - sx1
            rh = sy2 - sy1
            DrawRect Rect2(sx1, sy1, rw, rh), Color(0, 0, 0, 0.3)
        End If
    End If

    ' ── Draw palette area ─────────────────────────────────────────────────
    Dim paletteY As Integer
    paletteY = winH - PALETTE_H - STATUS_H
    DrawRect Rect2(0, paletteY, winW, PALETTE_H), Color(0.85, 0.85, 0.88)

    ' Brush size indicator
    DrawString GetThemeDefaultFont(), Vector2(TOOLBAR_W + 4, paletteY + 18), "Size:", Color(0.3, 0.3, 0.3)
    DrawString GetThemeDefaultFont(), Vector2(TOOLBAR_W + 38, paletteY + 18), Str(brushSize), Color(0, 0, 0)
    ' Draw brush preview circle
    DrawCircle Vector2(TOOLBAR_W + 35, paletteY + 38), brushSize, Color(0, 0, 0)

    ' Current colors display
    DrawRect Rect2(TOOLBAR_W + 4, paletteY + 24, 24, 24), Color8(bgColorR, bgColorG, bgColorB, 255)
    DrawRect Rect2(TOOLBAR_W + 0, paletteY + 20, 24, 24), Color8(fgColorR, fgColorG, fgColorB, 255)
    DrawRect Rect2(TOOLBAR_W + 0, paletteY + 20, 24, 24), Color(0, 0, 0)

    ' Palette swatches (2 rows of 14)
    Dim pi As Integer
    For pi = 0 To PALETTE_COUNT - 1
        Dim palRow As Integer
        Dim palCol As Integer
        palRow = pi \ 14
        palCol = pi Mod 14
        Dim psx As Integer
        Dim psy As Integer
        psx = TOOLBAR_W + 80 + palCol * 22
        psy = paletteY + 4 + palRow * 22
        DrawRect Rect2(psx, psy, 20, 20), Color8(palR(pi), palG(pi), palB(pi), 255)
        DrawRect Rect2(psx, psy, 20, 20), Color(0, 0, 0, 0.3)
    Next

    ' ── Draw status bar ───────────────────────────────────────────────────
    Dim statusY As Integer
    statusY = winH - STATUS_H
    DrawRect Rect2(0, statusY, winW, STATUS_H), Color(0.9, 0.9, 0.92)
    DrawRect Rect2(0, statusY, winW, 1), Color(0.7, 0.7, 0.75)

    ' Show coordinates and tool name
    Dim statusText As String
    statusText = toolNames(currentTool) & "  |  " & Str(mouseCanvasX) & ", " & Str(mouseCanvasY) & "  |  Canvas: " & Str(canvasW) & "x" & Str(canvasH) & "  |  Zoom: " & Str(zoomLevel) & "x"
    If isModified Then statusText = statusText & "  |  * Modified"
    DrawString GetThemeDefaultFont(), Vector2(8, statusY + 17), statusText, Color(0.2, 0.2, 0.3)
End Sub
