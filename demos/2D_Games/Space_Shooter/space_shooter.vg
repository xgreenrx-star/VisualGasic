' ============================================================================
' SPACE SHOOTER - Parallel Processing & Lambda Demo
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' Demonstrates:
' - Parallel For loops for updating many entities
' - Lambda expressions for filtering and mapping
' - DATA statements for enemy wave definitions
' - For Each iteration over collections
' - Pattern matching with Select Match
' ============================================================================
Attribute VB_Name = "SpaceShooter"

Const SCREEN_WIDTH As Integer = 600
Const SCREEN_HEIGHT As Integer = 800
Const PLAYER_SPEED As Single = 350.0
Const BULLET_SPEED As Single = 600.0
Const MAX_BULLETS As Integer = 50
Const MAX_ENEMIES As Integer = 30
Const MAX_PARTICLES As Integer = 100

' Player state
Dim playerX As Single
Dim playerY As Single
Dim playerLives As Integer
Dim playerInvincible As Boolean
Dim invincibleTimer As Single

' Bullets (parallel arrays)
Dim bulletX(MAX_BULLETS) As Single
Dim bulletY(MAX_BULLETS) As Single
Dim bulletActive(MAX_BULLETS) As Boolean
Dim bulletCount As Integer

' Enemies
Dim enemyX(MAX_ENEMIES) As Single
Dim enemyY(MAX_ENEMIES) As Single
Dim enemyType(MAX_ENEMIES) As Integer
Dim enemyHealth(MAX_ENEMIES) As Integer
Dim enemyActive(MAX_ENEMIES) As Boolean
Dim enemyCount As Integer

' Particles (for explosions)
Dim particleX(MAX_PARTICLES) As Single
Dim particleY(MAX_PARTICLES) As Single
Dim particleVX(MAX_PARTICLES) As Single
Dim particleVY(MAX_PARTICLES) As Single
Dim particleLife(MAX_PARTICLES) As Single
Dim particleColor(MAX_PARTICLES) As Variant

' Game state
Dim score As Integer
Dim wave As Integer
Dim waveTimer As Single
Dim gameOver As Boolean
Dim shootCooldown As Single

' Stars background
Dim starX(50) As Single
Dim starY(50) As Single
Dim starSpeed(50) As Single

' Enemy type definitions (loaded from DATA)
Dim enemyTypeNames(5) As String
Dim enemyTypeSpeeds(5) As Single
Dim enemyTypeHealth(5) As Integer
Dim enemyTypePoints(5) As Integer
Dim enemyTypeCount As Integer

' Wave definitions
Dim waveEnemyCounts(10) As Integer
Dim waveEnemyTypes(10) As String
Dim totalWaves As Integer

' ============================================================================
' LAMBDA EXPRESSIONS for game logic
' ============================================================================

' Lambda to check if entity is on screen
Dim IsOnScreen As Variant = Lambda(x, y) (x >= -50 And x <= SCREEN_WIDTH + 50 And y >= -50 And y <= SCREEN_HEIGHT + 50)

' Lambda for distance calculation
Dim Distance As Variant = Lambda(x1, y1, x2, y2) Sqr((x2-x1)*(x2-x1) + (y2-y1)*(y2-y1))

' Lambda for collision check (circle-based)
Dim Collides As Variant = Lambda(x1, y1, r1, x2, y2, r2) Distance(x1, y1, x2, y2) < (r1 + r2)

' ============================================================================
' INITIALIZATION
' ============================================================================
Sub _Ready()
    Print "=== SPACE SHOOTER ==="
    Print "Demonstrating Parallel Processing & Lambdas"
    Print ""
    Print "Controls: A/D or Arrows = Move, Space = Fire"
    Print ""
    
    LoadEnemyTypes
    LoadWaveData
    InitStars
    StartGame
End Sub

Sub LoadEnemyTypes()
    Restore EnemyTypeData
    enemyTypeCount = 0
    
    Dim typeName As String
    Do
        Read typeName
        If typeName = "END" Then Exit Do
        
        enemyTypeNames(enemyTypeCount) = typeName
        Read enemyTypeSpeeds(enemyTypeCount)
        Read enemyTypeHealth(enemyTypeCount)
        Read enemyTypePoints(enemyTypeCount)
        
        enemyTypeCount = enemyTypeCount + 1
    Loop
    
    Print "Loaded " & Str(enemyTypeCount) & " enemy types"
End Sub

Sub LoadWaveData()
    Restore WaveData
    totalWaves = 0
    
    Dim count As Integer
    Do
        Read count
        If count = -1 Then Exit Do
        
        waveEnemyCounts(totalWaves) = count
        Read waveEnemyTypes(totalWaves)
        
        totalWaves = totalWaves + 1
    Loop
    
    Print "Loaded " & Str(totalWaves) & " wave definitions"
End Sub

Sub InitStars()
    Dim i As Integer
    For i = 0 To 49
        starX(i) = Rnd() * SCREEN_WIDTH
        starY(i) = Rnd() * SCREEN_HEIGHT
        starSpeed(i) = 50 + Rnd() * 150
    Next
End Sub

Sub StartGame()
    playerX = SCREEN_WIDTH / 2
    playerY = SCREEN_HEIGHT - 80
    playerLives = 3
    playerInvincible = False
    
    score = 0
    wave = 0
    waveTimer = 2.0
    gameOver = False
    bulletCount = 0
    enemyCount = 0
    
    ' Clear arrays
    Dim i As Integer
    For i = 0 To MAX_BULLETS - 1
        bulletActive(i) = False
    Next
    For i = 0 To MAX_ENEMIES - 1
        enemyActive(i) = False
    Next
    
    Print "Game started! Wave 1 incoming..."
End Sub

' ============================================================================
' ENEMY & WAVE DATA (using DATA statements)
' ============================================================================

EnemyTypeData:
' Name, Speed, Health, Points
Data "SCOUT", 200.0, 1, 100
Data "FIGHTER", 150.0, 2, 200
Data "BOMBER", 100.0, 3, 300
Data "ELITE", 180.0, 4, 500
Data "BOSS", 50.0, 20, 2000
Data "END", 0, 0, 0

WaveData:
' EnemyCount, TypePattern
Data 5, "SCOUT"
Data 8, "SCOUT,SCOUT,FIGHTER"
Data 6, "FIGHTER,FIGHTER"
Data 10, "SCOUT,FIGHTER,SCOUT"
Data 8, "FIGHTER,BOMBER"
Data 12, "SCOUT,FIGHTER,BOMBER"
Data 10, "ELITE,FIGHTER"
Data 15, "SCOUT,FIGHTER,ELITE"
Data 1, "BOSS"
Data 20, "ELITE,BOMBER,FIGHTER"
Data -1, ""

' ============================================================================
' GAME LOOP
' ============================================================================
Sub _Process(delta As Single)
    If gameOver Then
        If Input.IsActionJustPressed("fire") Then
            StartGame
        End If
        Return
    End If
    
    UpdateInput delta
    UpdateBullets delta
    UpdateEnemies delta
    UpdateParticles delta
    UpdateStars delta
    UpdateWaveSpawner delta
    CheckCollisions
    
    ' Update invincibility
    If playerInvincible Then
        invincibleTimer = invincibleTimer - delta
        If invincibleTimer <= 0 Then
            playerInvincible = False
        End If
    End If
    
    shootCooldown = shootCooldown - delta
End Sub

Sub UpdateInput(delta As Single)
    If Input.IsActionPressed("move_left") Then
        playerX = playerX - PLAYER_SPEED * delta
    End If
    If Input.IsActionPressed("move_right") Then
        playerX = playerX + PLAYER_SPEED * delta
    End If
    
    playerX = Clamp(playerX, 20, SCREEN_WIDTH - 20)
    
    If Input.IsActionPressed("fire") And shootCooldown <= 0 Then
        FireBullet
        shootCooldown = 0.15
    End If
End Sub

Sub FireBullet()
    ' Find inactive bullet slot
    Dim i As Integer
    For i = 0 To MAX_BULLETS - 1
        If Not bulletActive(i) Then
            bulletX(i) = playerX
            bulletY(i) = playerY - 20
            bulletActive(i) = True
            bulletCount = bulletCount + 1
            Exit For
        End If
    Next
End Sub

' ============================================================================
' PARALLEL PROCESSING - Update many entities efficiently
' ============================================================================

Sub UpdateBullets(delta As Single)
    ' Use Parallel For for performance with many bullets
    Parallel For i = 0 To MAX_BULLETS - 1
        If bulletActive(i) Then
            bulletY(i) = bulletY(i) - BULLET_SPEED * delta
            
            ' Check if off screen using Lambda
            If Not IsOnScreen(bulletX(i), bulletY(i)) Then
                bulletActive(i) = False
                bulletCount = bulletCount - 1
            End If
        End If
    Next
End Sub

Sub UpdateEnemies(delta As Single)
    ' Parallel update of all enemies
    Parallel For i = 0 To MAX_ENEMIES - 1
        If enemyActive(i) Then
            ' Get enemy type properties
            Dim typeIdx As Integer = enemyType(i)
            Dim speed As Single = enemyTypeSpeeds(typeIdx)
            
            ' Simple downward movement with slight wave
            enemyY(i) = enemyY(i) + speed * delta
            enemyX(i) = enemyX(i) + Sin(enemyY(i) * 0.02) * 50 * delta
            
            ' Remove if off screen
            If enemyY(i) > SCREEN_HEIGHT + 50 Then
                enemyActive(i) = False
                enemyCount = enemyCount - 1
            End If
        End If
    Next
End Sub

Sub UpdateParticles(delta As Single)
    ' Parallel particle update
    Parallel For i = 0 To MAX_PARTICLES - 1
        If particleLife(i) > 0 Then
            particleX(i) = particleX(i) + particleVX(i) * delta
            particleY(i) = particleY(i) + particleVY(i) * delta
            particleLife(i) = particleLife(i) - delta
            
            ' Gravity effect
            particleVY(i) = particleVY(i) + 200 * delta
        End If
    Next
End Sub

Sub UpdateStars(delta As Single)
    Dim i As Integer
    For i = 0 To 49
        starY(i) = starY(i) + starSpeed(i) * delta
        If starY(i) > SCREEN_HEIGHT Then
            starY(i) = 0
            starX(i) = Rnd() * SCREEN_WIDTH
        End If
    Next
End Sub

Sub UpdateWaveSpawner(delta As Single)
    waveTimer = waveTimer - delta
    
    If waveTimer <= 0 And enemyCount = 0 Then
        SpawnWave
        waveTimer = 3.0
    End If
End Sub

Sub SpawnWave()
    If wave >= totalWaves Then
        Print "You've completed all waves!"
        gameOver = True
        Return
    End If
    
    wave = wave + 1
    Print "Wave " & Str(wave) & " starting!"
    
    Dim count As Integer = waveEnemyCounts(wave - 1)
    Dim typePattern As String = waveEnemyTypes(wave - 1)
    
    ' Parse type pattern and spawn enemies
    Dim types() As String = Split(typePattern, ",")
    
    Dim i As Integer
    For i = 0 To count - 1
        ' Find enemy slot
        Dim slot As Integer
        For slot = 0 To MAX_ENEMIES - 1
            If Not enemyActive(slot) Then
                ' Spawn position
                enemyX(slot) = 50 + (i Mod 10) * 50
                enemyY(slot) = -50 - Int(i / 10) * 60
                
                ' Get type from pattern using For Each
                Dim typeIdx As Integer = i Mod UBound(types) + 1
                Dim typeName As String = Trim(types(typeIdx - 1))
                
                ' Find type index
                Dim t As Integer
                For t = 0 To enemyTypeCount - 1
                    If enemyTypeNames(t) = typeName Then
                        enemyType(slot) = t
                        enemyHealth(slot) = enemyTypeHealth(t)
                        Exit For
                    End If
                Next
                
                enemyActive(slot) = True
                enemyCount = enemyCount + 1
                Exit For
            End If
        Next
    Next
End Sub

' ============================================================================
' COLLISION DETECTION
' ============================================================================
Sub CheckCollisions()
    Dim i, j As Integer
    
    ' Bullets vs Enemies
    For i = 0 To MAX_BULLETS - 1
        If bulletActive(i) Then
            For j = 0 To MAX_ENEMIES - 1
                If enemyActive(j) Then
                    ' Use Lambda for collision check
                    If Collides(bulletX(i), bulletY(i), 5, enemyX(j), enemyY(j), 20) Then
                        ' Hit!
                        bulletActive(i) = False
                        bulletCount = bulletCount - 1
                        
                        enemyHealth(j) = enemyHealth(j) - 1
                        If enemyHealth(j) <= 0 Then
                            ' Enemy destroyed
                            SpawnExplosion enemyX(j), enemyY(j)
                            score = score + enemyTypePoints(enemyType(j))
                            enemyActive(j) = False
                            enemyCount = enemyCount - 1
                        End If
                        
                        Exit For
                    End If
                End If
            Next
        End If
    Next
    
    ' Enemies vs Player
    If Not playerInvincible Then
        For j = 0 To MAX_ENEMIES - 1
            If enemyActive(j) Then
                If Collides(playerX, playerY, 15, enemyX(j), enemyY(j), 20) Then
                    PlayerHit
                    Exit For
                End If
            End If
        Next
    End If
End Sub

Sub PlayerHit()
    playerLives = playerLives - 1
    playerInvincible = True
    invincibleTimer = 2.0
    
    SpawnExplosion playerX, playerY
    
    If playerLives <= 0 Then
        gameOver = True
        Print "GAME OVER! Final Score: " & Str(score)
    Else
        Print "Hit! Lives remaining: " & Str(playerLives)
    End If
End Sub

Sub SpawnExplosion(x As Single, y As Single)
    Dim i As Integer
    For i = 0 To MAX_PARTICLES - 1
        If particleLife(i) <= 0 Then
            particleX(i) = x
            particleY(i) = y
            particleVX(i) = (Rnd() - 0.5) * 300
            particleVY(i) = (Rnd() - 0.5) * 300
            particleLife(i) = 0.5 + Rnd() * 0.5
            
            ' Random warm color
            Dim r As Single = 0.8 + Rnd() * 0.2
            Dim g As Single = 0.3 + Rnd() * 0.5
            particleColor(i) = Color(r, g, 0)
            
            ' Only spawn 20 particles per explosion
            If i Mod 20 = 19 Then Exit For
        End If
    Next
End Sub

' ============================================================================
' RENDERING
' ============================================================================
Sub _Draw()
    ' Background
    DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color("#000011")
    
    ' Stars
    Dim i As Integer
    For i = 0 To 49
        Dim brightness As Single = starSpeed(i) / 200
        DrawCircle starX(i), starY(i), 1 + brightness, Color(brightness, brightness, brightness)
    Next
    
    ' Particles
    For i = 0 To MAX_PARTICLES - 1
        If particleLife(i) > 0 Then
            Dim alpha As Single = particleLife(i) * 2
            Dim size As Single = particleLife(i) * 6
            DrawCircle particleX(i), particleY(i), size, particleColor(i)
        End If
    Next
    
    ' Bullets
    For i = 0 To MAX_BULLETS - 1
        If bulletActive(i) Then
            DrawRect bulletX(i) - 2, bulletY(i), 4, 15, Color("#00FFFF")
        End If
    Next
    
    ' Enemies
    For i = 0 To MAX_ENEMIES - 1
        If enemyActive(i) Then
            Dim typeIdx As Integer = enemyType(i)
            Dim enemyColor As Variant
            
            ' Color based on type using Pattern Matching
            Select Match enemyTypeNames(typeIdx)
                Case "SCOUT"
                    enemyColor = Color("#FF4444")
                Case "FIGHTER"
                    enemyColor = Color("#FF8844")
                Case "BOMBER"
                    enemyColor = Color("#FFFF44")
                Case "ELITE"
                    enemyColor = Color("#FF44FF")
                Case "BOSS"
                    enemyColor = Color("#FF0000")
                Case Else
                    enemyColor = Color.White
            End Select
            
            ' Draw enemy (simple shapes)
            Dim size As Integer = Choose(typeIdx = 4, 40, 20)  ' Boss is bigger
            DrawCircle enemyX(i), enemyY(i), size, enemyColor
            
            ' Health bar for tough enemies
            If enemyTypeHealth(typeIdx) > 1 Then
                Dim healthPct As Single = enemyHealth(i) / enemyTypeHealth(typeIdx)
                DrawRect enemyX(i) - 15, enemyY(i) - size - 8, 30, 4, Color.DarkRed
                DrawRect enemyX(i) - 15, enemyY(i) - size - 8, 30 * healthPct, 4, Color.Green
            End If
        End If
    Next
    
    ' Player
    If Not gameOver Then
        Dim playerAlpha As Single = 1.0
        If playerInvincible Then
            playerAlpha = 0.5 + Sin(invincibleTimer * 20) * 0.5
        End If
        
        ' Player ship (triangle-ish)
        DrawCircle playerX, playerY, 15, Color(0, playerAlpha, playerAlpha)
        DrawRect playerX - 5, playerY + 10, 10, 15, Color(0, playerAlpha * 0.5, playerAlpha)
    End If
    
    ' HUD
    DrawString "SCORE: " & Str(score), 10, 10, Color.White, 24
    DrawString "WAVE: " & Str(wave), 10, 40, Color.Yellow, 20
    DrawString "LIVES: " & String(playerLives, "♥"), SCREEN_WIDTH - 120, 10, Color.Red, 24
    
    ' Game over overlay
    If gameOver Then
        DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color(0, 0, 0, 0.8)
        
        If wave > totalWaves Then
            DrawString "VICTORY!", SCREEN_WIDTH/2 - 80, SCREEN_HEIGHT/2 - 60, Color("#FFD700"), 48
        Else
            DrawString "GAME OVER", SCREEN_WIDTH/2 - 100, SCREEN_HEIGHT/2 - 60, Color.Red, 48
        End If
        
        DrawString "Final Score: " & Str(score), SCREEN_WIDTH/2 - 80, SCREEN_HEIGHT/2, Color.White, 28
        DrawString "Wave Reached: " & Str(wave), SCREEN_WIDTH/2 - 70, SCREEN_HEIGHT/2 + 40, Color.Gray, 20
        DrawString "Press SPACE to restart", SCREEN_WIDTH/2 - 100, SCREEN_HEIGHT/2 + 100, Color.Cyan, 20
    End If
End Sub
