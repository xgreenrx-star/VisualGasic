' ============================================================================
' COINS COUNTER - HUD Element for Coin Tracking
' Converted from official Godot 2D Platformer demo
' ============================================================================
' Attached to a Panel node in coins_counter.tscn.
' Displays the number of collected coins with an animated coin sprite.
' The collect_coin() method is called by pause_menu.vg when the
' coin_collected signal fires from the Player.
' ============================================================================
Attribute VB_Name = "CoinsCounter"

' --- State ---
Dim coinsCollected As Integer

' --- Node references ---
Dim coinsLabel As Object            ' Label - displays coin count text
Dim coinSprite As Object            ' AnimatedSprite2D - spinning coin icon

' ============================================================================
' INITIALIZATION
' ============================================================================
Sub _Ready()
    coinsCollected = 0

    ' Get child node references
    coinsLabel = GetNode("Label")
    coinSprite = GetNode("AnimatedSprite2D")

    ' Update the label text and start the coin animation
    coinsLabel.text = Str(coinsCollected)
    coinSprite.Play()
End Sub

' ============================================================================
' COLLECT COIN - Increment counter and update display
' ============================================================================
' Called by pause_menu.vg's _on_coin_collected handler.
Sub collect_coin()
    coinsCollected = coinsCollected + 1
    coinsLabel.text = Str(coinsCollected)
End Sub
