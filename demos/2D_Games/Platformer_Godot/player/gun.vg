' ============================================================================
' GUN - Weapon System for Player Character
' Converted from official Godot 2D Platformer demo
' ============================================================================
' Attached to a Marker2D node that sits on the player's sprite.
' Spawns bullet instances and manages a cooldown timer between shots.
'
' GDScript original used preload("res://player/bullet.tscn") which is not
' available in VG. We use Load() at runtime instead — called once in _Ready
' and cached in a module-level variable for efficiency.
' ============================================================================
Attribute VB_Name = "Gun"

' --- Constants ---
Const BULLET_VELOCITY As Single = 850.0

' --- Cached resources ---
Dim bulletScene As Object ' PackedScene loaded from bullet.tscn

' --- Node references ---
Dim soundShoot As Object ' AudioStreamPlayer2D - shooting SFX
Dim cooldownTimer As Object ' Timer - prevents rapid fire

' ============================================================================
' INITIALIZATION
' ============================================================================
Sub _Ready()
	' Load the bullet scene once and cache it.
	' Load() is VG's runtime equivalent of GDScript's preload().
	bulletScene = load("res://player/bullet.tscn")

	' Get child node references
	soundShoot = GetNode("Shoot")
	cooldownTimer = GetNode("Cooldown")
End Sub

' ============================================================================
' SHOOT - Instantiate and fire a bullet
' ============================================================================
' Called by player.vg when the shoot button is pressed.
' Returns True if a bullet was actually fired (False if on cooldown).
'
' direction: 1.0 for right, -1.0 for left (matches sprite.scale.x)
Function Shoot(direction As Single) As Boolean
	' Check cooldown — can't fire if timer is still running
	If Not cooldownTimer.IsStopped() Then
		Shoot = False
		Exit Function
	End If

	' Instantiate a new bullet from the cached PackedScene
	Dim bullet As Object
	bullet = bulletScene.Instantiate()

	' Position the bullet at the gun's global position
	bullet.global_position = Me.global_position

	' Set bullet velocity — flies horizontally in the facing direction
	bullet.linear_velocity = Vector2(direction * BULLET_VELOCITY, 0.0)

	' Make bullet independent of player's transform hierarchy
	bullet.SetAsTopLevel(True)

	' Add bullet as child of the gun node (keeps scene tree organized)
	Me.AddChild(bullet)

	' Play shooting sound effect
	soundShoot.Play()

	' Start cooldown timer to prevent rapid fire
	cooldownTimer.Start()

	Shoot = True
End Function
