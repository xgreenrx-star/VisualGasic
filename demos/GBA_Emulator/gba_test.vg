' gba_test.vg -- Standalone GBA Emulator Test Harness
' Runs the CPU core with a loaded ROM and prints debug info.
' Usage: vg run gba_test.vg <rom_file.gba>

Import "gba_constants.vg"
Import "gba_memory.vg"
Import "gba_cpu.vg"

Declare Sub Print(ParamArray args() As Variant)

Dim Mem As GBAMemory
Dim Emu As GBACPU

Sub Main()
    Dim args As Variant = Command()
    If UBound(args) < 1 Then
        Print "Usage: vg run gba_test.vg <rom_file.gba>"
        Return
    End If

    Dim romPath As String = args(1)
    Print "Loading ROM: " & romPath

    Set Mem = New GBAMemory
    Mem.Init()

    If Not Mem.LoadROM(romPath) Then
        Print "ERROR: Failed to load ROM file: " & romPath
        Return
    End If

    Print "ROM loaded: " & Mem.RomSize & " bytes"
    Print "Cart header at 0x08000000:"
    Print "  Entry (bytes 0-3): " & Hex(Mem.Read32(&H08000000))
    Print "  Logo check: " & Hex(Mem.Read32(&H08000004))
    Print "  Game title: " & Mem.Read8(&H080000A0) & "... (checking)"

    Set Emu = New GBACPU
    Emu.Init(Mem)

    ' Set up ARM state boot from ROM
    Emu.SetReg(15, &H08000000)
    Emu.CPSR = MODE_SYS Or (1 << CPSR_IRQ_DISABLE) Or (1 << CPSR_FIQ_DISABLE)

    Print ""
    Print "=== STARTING CPU EXECUTION ==="

    Dim cycles As Long
    Dim maxInstructions As Long = 10000
    Dim instCount As Long
    Dim pcLog(200) As String
    Dim logIdx As Integer

    Do While instCount < maxInstructions And Emu.GetReg(15) <> 0
        Dim pc As Long = Emu.GetReg(15)
        Dim isThumb As Boolean = BitTst(Emu.CPSR, CPSR_THUMB)

        ' Log PC for crash analysis
        If instCount < 200 Then
            pcLog(logIdx) = Hex(instCount) & ": " & Hex(pc) & IIf(isThumb, " (Thumb)", " (ARM)")
            logIdx = logIdx + 1
        End If

        Dim instCycles As Long = Emu.Step()
        cycles = cycles + instCycles
        instCount = instCount + 1

        ' Check for infinite loop (same PC twice)
        If instCount >= 2 Then
            If Emu.GetReg(15) = pc Then
                Dim r0 As Long = Emu.GetReg(0)
                Dim r1 As Long = Emu.GetReg(1)
                Print "WARNING: PC stuck at " & Hex(pc) & " after " & instCount & " instructions"
                Print "  R0=" & Hex(r0) & " R1=" & Hex(r1) & " LR=" & Hex(Emu.GetReg(14))
                Print "  CPSR=" & Hex(Emu.CPSR)

                ' Check if waiting for interrupt (common pattern: loop until IF changes)
                Dim ieReg As Integer = Mem.Read16(ADDR_IO + IO_IE)
                Dim ifReg As Integer = Mem.Read16(ADDR_IO + IO_IF)
                Dim dispstat As Integer = Mem.Read16(ADDR_IO + IO_DISPSTAT)
                Print "  IE=" & Hex(ieReg) & " IF=" & Hex(ifReg) & " DISPSTAT=" & Hex(dispstat)

                ' Simulate VBlank to unblock
                If BitAnd(ieReg, IRQ_VBLANK) <> 0 Then
                    Print "  *** INJECTING VBLANK IRQ to unblock ***"
                    Mem.Write16 ADDR_IO + IO_IF, BitOr(ifReg, IRQ_VBLANK)
                    ' Set DISPSTAT VBlank
                    Mem.Write16 ADDR_IO + IO_DISPSTAT, BitOr(dispstat, DISPSTAT_VBLANK_FLAG)
                End If
                Exit Do
            End If
        End If
    Loop

    Print ""
    Print "=== EXECUTION REPORT ==="
    Print "Instructions executed: " & instCount
    Print "Total cycles: " & cycles
    Print "Final PC: " & Hex(Emu.GetReg(15))
    Print "CPSR: " & Hex(Emu.CPSR)
    Print "R0=" & Hex(Emu.GetReg(0)) & " R1=" & Hex(Emu.GetReg(1))
    Print "R13/SP=" & Hex(Emu.GetReg(13)) & " R14/LR=" & Hex(Emu.GetReg(14))
    Print ""
    Print "Last PC trace:"
    Dim j As Integer
    For j = 0 To logIdx - 1
        Print "  " & pcLog(j)
    Next
End Sub