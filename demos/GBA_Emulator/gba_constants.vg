' Blending
Global Const IO_BLDCNT As Integer = &H50
Global Const IO_BLDALPHA As Integer = &H52
Global Const IO_BLDY As Integer = &H54

' Sound
Global Const IO_SOUND1CNT_L As Integer = &H60
Global Const IO_SOUND1CNT_H As Integer = &H62
Global Const IO_SOUND1CNT_X As Integer = &H64
Global Const IO_SOUND2CNT_L As Integer = &H68
Global Const IO_SOUND2CNT_H As Integer = &H6C
