' gba_constants.vg — GBA Hardware Constants and Memory Map
' Game Boy Advance emulator written in pure VisualGasic
' Tier 2: Playable Subset

' === CPU Constants ===
' ARM7TDMI at 16.78 MHz, ~280,000 cycles per frame at 60fps
Global Const CYCLES_PER_FRAME As Long = 280896
Global Const GBA_SCREEN_W As Integer = 240
Global Const GBA_SCREEN_H As Integer = 160

' CPSR Flag Bit Positions
Global Const CPSR_FLAG_N As Integer = 31  ' Negative/Less Than
Global Const CPSR_FLAG_Z As Integer = 30  ' Zero
Global Const CPSR_FLAG_C As Integer = 29  ' Carry/Borrow/Extend
Global Const CPSR_FLAG_V As Integer = 28  ' Overflow
Global Const CPSR_IRQ_DISABLE As Integer = 7
Global Const CPSR_FIQ_DISABLE As Integer = 6
Global Const CPSR_THUMB As Integer = 5

' CPU Operating Modes
Global Const MODE_USER As Integer = &H10
Global Const MODE_FIQ As Integer = &H11
Global Const MODE_IRQ As Integer = &H12
Global Const MODE_SVC As Integer = &H13
Global Const MODE_ABT As Integer = &H17
Global Const MODE_UND As Integer = &H1B
Global Const MODE_SYS As Integer = &H1F

' === Memory Address Map ===
' External Work RAM (256KB)
Global Const ADDR_EWRAM As Long = &H02000000
' Internal Work RAM (32KB)
Global Const ADDR_IWRAM As Long = &H03000000
' I/O Registers
Global Const ADDR_IO As Long = &H04000000
' Palette RAM (1KB)
Global Const ADDR_PALETTE As Long = &H05000000
' Video RAM (96KB)
Global Const ADDR_VRAM As Long = &H06000000
' Object Attribute Memory (1KB)
Global Const ADDR_OAM As Long = &H07000000
' Game Pak ROM (Wait State 0, 32MB max)
Global Const ADDR_ROM_WS0 As Long = &H08000000
' Game Pak ROM (Wait State 1)
Global Const ADDR_ROM_WS1 As Long = &H0A000000
' Game Pak ROM (Wait State 2)
Global Const ADDR_ROM_WS2 As Long = &H0C000000
' SRAM (64KB)
Global Const ADDR_SRAM As Long = &H0E000000

' Memory sizes
Global Const SIZE_EWRAM As Long = &H40000   ' 256KB
Global Const SIZE_IWRAM As Long = &H8000    ' 32KB
Global Const SIZE_IO As Long = &H400        ' 1KB
Global Const SIZE_PALETTE As Long = &H400   ' 1KB
Global Const SIZE_VRAM As Long = &H18000    ' 96KB
Global Const SIZE_OAM As Long = &H400       ' 1KB

' === I/O Register Offsets (relative to &H04000000) ===
' Display
Global Const IO_DISPCNT As Integer = &H00
Global Const IO_DISPSTAT As Integer = &H04
Global Const IO_VCOUNT As Integer = &H06
Global Const IO_BG0CNT As Integer = &H08
Global Const IO_BG1CNT As Integer = &H0A
Global Const IO_BG2CNT As Integer = &H0C
Global Const IO_BG3CNT As Integer = &H0E
Global Const IO_BG0HOFS As Integer = &H10
Global Const IO_BG0VOFS As Integer = &H12
Global Const IO_BG1HOFS As Integer = &H14
Global Const IO_BG1VOFS As Integer = &H16
Global Const IO_BG2HOFS As Integer = &H18
Global Const IO_BG2VOFS As Integer = &H1A
Global Const IO_BG3HOFS As Integer = &H1C
Global Const IO_BG3VOFS As Integer = &H1E
' BG2 affine matrix
Global Const IO_BG2PA As Integer = &H20
Global Const IO_BG2PB As Integer = &H22
Global Const IO_BG2PC As Integer = &H24
Global Const IO_BG2PD As Integer = &H26
Global Const IO_BG2X As Integer = &H28  ' 4 bytes
Global Const IO_BG2Y As Integer = &H2C  ' 4 bytes
' BG3 affine matrix
Global Const IO_BG3PA As Integer = &H30
Global Const IO_BG3PB As Integer = &H32
Global Const IO_BG3PC As Integer = &H34
Global Const IO_BG3PD As Integer = &H36
