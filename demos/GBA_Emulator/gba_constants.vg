Global Const IO_TM3CNT_H As Integer = &H10E

' Keypad
Global Const IO_KEYINPUT As Integer = &H130
Global Const IO_KEYCNT As Integer = &H132

' Serial / SIO
Global Const IO_SIODATA32 As Integer = &H120
