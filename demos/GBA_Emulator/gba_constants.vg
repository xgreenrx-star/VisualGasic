Global Const IRQ_GAMEPAK As Integer = &H2000

' === Display Control (DISPCNT) Bit Flags ===
Global Const DISPCNT_MODE_MASK As Integer = &H0007
Global Const DISPCNT_FRAMESELECT As Integer = &H0010
Global Const DISPCNT_HBLANK_OAM As Integer = &H0020
