Global Const IO_BG3Y As Integer = &H3C  ' 4 bytes
' Windows
Global Const IO_WIN0H As Integer = &H40
Global Const IO_WIN1H As Integer = &H42
Global Const IO_WIN0V As Integer = &H44
Global Const IO_WIN1V As Integer = &H46
