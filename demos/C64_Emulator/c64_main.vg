' c64_main.vg -- Commodore 64 Emulator Main Scene
' Ties together CPU, Memory, VIC-II, and I/O
' Uses module-level globals for CPU state (bytecode-compiled path).

Import "c64_constants.vg"
Import "c64_memory.vg"
Import "c64_cpu.vg"
Import "c64_vic.vg"

' === Boot Configuration ===
' Change to True/False here to toggle. See C64.config for documentation.
Dim SKIP_RAM_TEST As Boolean = True

' === Turbo Mode (opt-in native CPU core) ===
' Off by default -- the pure-VG 6510 core (c64_cpu.vg) stays the marketed
' "C64 emulator written in 100% VG" showcase. Flip to True to swap ONLY the
' opcode fetch/decode/execute loop for the native VGCpu6502 engine primitive
' (src/cpu_cores/); all memory banking, VIC, and CIA logic stays the existing,
' already-verified VG code (the native core's entire 64KB bus is routed back
' through Mem_Read/Mem_Write via VGCpu6502.SetIOHook, so behavior is identical
' to the pure-VG path -- this is a decode/dispatch speed lever only, not a
' full-native-memory-bus rewrite; see /memories/repo/vgcpucore_6502_plan.md).
Dim TURBO_MODE As Boolean = True
Dim NativeCpu As Variant
Dim gIRQLineNative As Boolean

' === Native Machine Mode (opt-in FULL native C64: CPU + bus + VIC + CIA) ===
' The ultimate speed lever. Turbo Mode (above) runs a native 6502 decode loop
' but still round-trips EVERY memory access back through the interpreted VG bus
' (IOBus_Read/Write -> Mem_Read/Write) via a Callable -- 2-4 interpreter calls
' per instruction, which dominates and erases the native decode win. Native
' Machine mode instead hands the ENTIRE machine to VGC64Machine
' (src/cpu_cores/visual_gasic_c64_machine.*): 6510 execution, RAM/ROM banking,
' VIC-II raster rendering, and the CIA1 system-IRQ timer all run in C++ with
' ZERO per-access Callable round-trips. VG only loads ROMs, pumps the keyboard
' matrix, and blits the finished framebuffer once per frame. This is the
' "something to show at real hardware speed" path; the pure-VG c64_cpu.vg core
' remains the untouched "100% VG" showcase. Takes precedence over TURBO_MODE.
Dim NATIVE_MACHINE As Boolean = True
Dim Machine As Variant

Dim DisplayTex As Variant
Dim DisplayImage As Variant
Dim bLoaded As Boolean
Dim FrameCount As Long
Dim SoundHandle As Long
Dim CyclesThisFrame As Long

' PERF DIAGNOSTIC (Jul 29 2026): running totals + wall-clock throughput print,
' independent of the existing 60-virtual-frame status print (which requires
' ~1.18M virtual C64 cycles before it fires even once -- too coarse to tell
' "stuck" from "just slow" during a long boot). Safe to remove once boot-time
' performance is understood/acceptable.
Dim TotalStepsExecuted As Long
Dim TotalCyclesExecuted As Long
Dim LastProgressPrintTime As Double
Dim LastProgressCycles As Long
Dim LastProgressSteps As Long

' CIA1 Timer A emulation (simple countdown for ~60Hz system IRQ)
Dim CIA1_TimerA As Long = 16421      ' PAL: $4025 cycles between IRQs
Dim CIA1_TimerA_Latch As Long = 16421

Sub _Ready()
    ' Init memory subsystem (module-level, bytecode-compiled). Still used in
    ' Native Machine mode purely for the keyboard-matrix scratch (gMem_KeyCol);
    ' the native machine owns its own RAM/ROM/VIC/CIA state independently.
    Mem_Init()

    ' Init CPU: native machine (owns everything), native VGCpu6502 (Turbo Mode),
    ' or pure-VG 6510 core (default).
    If NATIVE_MACHINE Then
        ' CPU + bus + VIC + CIA are all owned by the native VGC64Machine, which
        ' is created once ROMs are located (see TryAutoLoad). Nothing to init here.
    ElseIf TURBO_MODE Then
        Set NativeCpu = New VGCpu6502
        ' Route the ENTIRE 64KB bus through the existing, already-verified VG
        ' memory subsystem (RAM/ROM banking, VIC/CIA/color-RAM decode) --
        ' only the opcode fetch/decode/execute loop below is native.
        ' NOTE: the Callable must target a Sub/Function defined directly in
        ' THIS file (c64_main.vg) -- VisualGasicScript::_has_method() (which
        ' Callable::is_valid() consults) only scans the OWNING script's own
        ' AST subs, not cross-module imports. Mem_Read/Mem_Write live in the
        ' imported c64_memory.vg module, so a Callable built straight from
        ' their names is silently invalid (bus reads/writes then fall through
        ' to VGCpu6502's internal, never-populated RAM). Route through the
        ' local IOBus_Read/IOBus_Write forwarders below instead.
        NativeCpu.SetIOHook Me, "IOBus_Read", "IOBus_Write", 0, &HFFFF
    Else
        C64_Init Empty
    End If

    ' Init VIC (module-level) -- not needed when the native machine renders.
    If Not NATIVE_MACHINE Then Vic_Init()

    bLoaded = False
    FrameCount = 0

    ' Create display
    Set DisplayImage = CreateImage(SCREEN_W, SCREEN_H, Color8(0, 0, 0, 255))
    Set DisplayTex = CreateTexture(DisplayImage)

    Print "========================================"
    Print "  Commodore 64 Emulator for VisualGasic"
    Print "========================================"
    Print ""

    LastProgressPrintTime = Timer()

    ' Try auto-load ROMs
    TryAutoLoad()
End Sub

Sub TryAutoLoad()
    Dim basePath As String = "res://roms/"
    Dim basicPath As String = basePath & "basic.901226-01.bin"
    Dim kernalPath As String = basePath & "kernal.901227-03.bin"
    Dim charPath As String = basePath & "characters.901225-01.bin"

    If FileExists(basicPath) And FileExists(kernalPath) And FileExists(charPath) Then
        Print "Auto-loading ROMs..."
        If NATIVE_MACHINE Then
            Set Machine = New VGC64Machine
            If Machine.LoadROMs(basicPath, kernalPath, charPath) Then
                Print "Loaded ROMs into native VGC64Machine"
                InitializeC64()
            End If
        ElseIf Mem_LoadROMs(basicPath, kernalPath, charPath) Then
            InitializeC64()
        End If
    Else
        Print "ROMs not found in roms/ folder."
        Print "Place basic.901226-01.bin, kernal.901227-03.bin, and characters.901225-01.bin"
        Print "in the demos/C64_Emulator/roms/ directory."
    End If
End Sub

Sub InitializeC64()
    ' Set up VIC-II default registers
    Bus_Write &HD011, &H1B   ' Control 1: 25 rows, display on, YSCROLL=3
    Bus_Write &HD016, &H08   ' Control 2: 40 columns, standard mode
    Bus_Write &HD018, &H15   ' Memory: Screen at $0400, charset at $0800
    Bus_Write &HD020, &H0E   ' Border: light blue
    Bus_Write &HD021, &H06   ' Background: blue

    ' CIA1: keyboard
    Bus_Write &HDC00, &H7F
    Bus_Write &HDC02, &HFF
    Bus_Write &HDC03, &H00

    ' CIA2: serial/VIC bank
    Bus_Write &HDD00, &H03

    ' Reset CPU: native machine, native core (Turbo Mode), or module-level VG core
    If NATIVE_MACHINE Then
        Machine.Reset()
    ElseIf TURBO_MODE Then
        NativeCpu.Reset()
    Else
        C64_Reset()
    End If
    
    ' Apply boot configuration: skip RAMTAS RAM test
    ' The KERNAL boot at $FCE2 runs: LDX #$FF/TXS (reset SP) → IOINIT → RAMTAS
    ' → RESTOR → CINT → BASIC. We can't skip just RAMTAS in the linear
    ' sequence, so we write a tiny 6502 stub at $C000 that does everything
    ' EXCEPT RAMTAS:
    '   LDX #$FF : TXS  (reset stack pointer to $FF, same as real KERNAL reset --
    '                    REQUIRED: C64_Reset() leaves SP=$FD, and without this,
    '                    JSR return addresses land at $01FC/$01FD, which is
    '                    exactly where INITMEM's zero-page copy loop writes
    '                    during BASIC cold start, corrupting the stack and
    '                    causing a bogus BRK/warm-start that skips the banner)
    '   JSR $FDA3  (IOINIT — init CIA/VIC/SID/processor port)
    '   JSR $FD15  (RESTOR — set default IRQ/NMI vectors)
    '   JSR $FF5B  (CINT — init screen editor, clear screen)
    '   CLI        (enable interrupts)
    '   JMP ($A000)(indirect jump to BASIC cold start)
    If SKIP_RAM_TEST Then
        ' Pre-write memory state that RAMTAS would leave:
        Bus_Write &HB2, &H3C       ' Tape buffer pointer low
        Bus_Write &HB3, &H03       ' Tape buffer pointer high ($033C)
        Bus_Write &H0281, &H00     ' MEMTOP low ($0800 — start of BASIC text)
        Bus_Write &H0282, &H08     ' MEMTOP high
        Bus_Write &H0283, &H00     ' MEMBOT low ($A000 — top of BASIC RAM)
        Bus_Write &H0284, &HA0     ' MEMBOT high
        Bus_Write &H0288, &H04     ' Screen memory page ($0400)
        
        ' Write boot stub at $C000
        Bus_Write &HC000, &HA2     ' LDX #$FF
        Bus_Write &HC001, &HFF
        Bus_Write &HC002, &H9A     ' TXS (set SP=$FF like real KERNAL reset)
        Bus_Write &HC003, &H20     ' JSR
        Bus_Write &HC004, &HA3     '   $FDA3 (IOINIT)
        Bus_Write &HC005, &HFD
        Bus_Write &HC006, &H20     ' JSR
        Bus_Write &HC007, &H15     '   $FD15 (RESTOR)
        Bus_Write &HC008, &HFD
        Bus_Write &HC009, &H20     ' JSR
        Bus_Write &HC00A, &H5B     '   $FF5B (CINT)
        Bus_Write &HC00B, &HFF
        Bus_Write &HC00C, &H58     ' CLI
        Bus_Write &HC00D, &H6C     ' JMP ($A000)
        Bus_Write &HC00E, &H00
        Bus_Write &HC00F, &HA0
        
        If NATIVE_MACHINE Then
            Machine.SetPC &HC000
        ElseIf TURBO_MODE Then
            NativeCpu.SetPC &HC000
        Else
            C64_SetPC &HC000
        End If
        Print "[SETUP] Skipping RAMTAS — boot stub at $C000 (IOINIT+RESTOR+CINT+BASIC)"
        Print "[SETUP] $A000=$" & Hex(Bus_ReadByte(&HA000)) & " $A001=$" & Hex(Bus_ReadByte(&HA001))
        Print "[SETUP] JMP target = $" & Hex(Bus_ReadByte(&HA001) * 256 + Bus_ReadByte(&HA000))
    End If
    
    bLoaded = True

    Print "C64 Emulator ready!"
    Print "PC=$" & Hex(Emu_GetPC())
    Print ""
    Print "  SKIP_RAM_TEST = " & SKIP_RAM_TEST
    Print "  TURBO_MODE (native VGCpu6502) = " & TURBO_MODE
    Print "  NATIVE_MACHINE (full native VGC64Machine) = " & NATIVE_MACHINE
    Print ""
    Print "Controls:"
    Print "  Arrow keys = Joystick"
    Print "  Keys = C64 keyboard"
    Print "  Space, Enter, Backspace mapped"

    InitAudio()
End Sub

Sub InitAudio()
    SoundHandle = SoundGen.Open(44100, 0.05)
    If SoundHandle = 0 Then
        Print "Warning: Could not open audio"
    End If
End Sub

' === Keyboard to C64 Matrix ===
Sub UpdateKeyboard()
    ' Read PC keyboard and map to C64 matrix
    ' This maps common PC keys to the C64 keyboard matrix

    ' Build column states (active low)
    Dim col0 As Integer = &HFF, col1 As Integer = &HFF
    Dim col2 As Integer = &HFF, col3 As Integer = &HFF
    Dim col4 As Integer = &HFF, col5 As Integer = &HFF
    Dim col6 As Integer = &HFF, col7 As Integer = &HFF

    ' Row 7 (column 0, PA bit 0) -- STOP, Q, C=, SPACE, 2, CTRL, ←, 1
    ' Row 6 (col 1) -- /, ↑, =, Right Shift, HOME, ;, *, £
    ' Row 5 (col 2) -- ,, @, :, ., -, L, P, +
    ' Row 4 (col 3) -- N, O, K, M, 0, J, I, 9
    ' Row 3 (col 4) -- V, U, H, B, 8, G, Y, 7
    ' Row 2 (col 5) -- X, T, F, C, 6, D, R, 5
    ' Row 1 (col 6) -- Left Shift, E, S, Z, 4, A, W, 3
    ' Row 0 (col 7) -- ↓, F5, F3, F1, F7, →, RETURN, DEL

    ' Simplified: just map essential keys for testing
    If IsActionPressed("ui_accept") Then col7 = BitClr(col7, 1)  ' RETURN
    If IsActionPressed("ui_cancel") Then col7 = col7
    If IsActionPressed("ui_up") Then col7 = BitClr(col7, 0)
    If IsActionPressed("ui_down") Then col7 = col7
    If IsActionPressed("ui_left") Then col7 = col7
    If IsActionPressed("ui_right") Then col7 = BitClr(col7, 2)

    ' Space
    If IsKeyPressed(KEY_SPACE) Then col7 = BitClr(col7, 4)

    ' Letter keys - rough mapping
    If IsKeyPressed(KEY_A) Then col6 = BitClr(col6, 2)
    If IsKeyPressed(KEY_B) Then col4 = BitClr(col4, 3)
    If IsKeyPressed(KEY_C) Then col5 = BitClr(col5, 3)
    If IsKeyPressed(KEY_D) Then col5 = BitClr(col5, 5)
    If IsKeyPressed(KEY_E) Then col6 = BitClr(col6, 1)
    If IsKeyPressed(KEY_F) Then col5 = BitClr(col5, 2)
    If IsKeyPressed(KEY_G) Then col4 = BitClr(col4, 5)
    If IsKeyPressed(KEY_H) Then col4 = BitClr(col4, 2)
    If IsKeyPressed(KEY_I) Then col4 = BitClr(col4, 6)
    If IsKeyPressed(KEY_J) Then col4 = BitClr(col4, 5)
    If IsKeyPressed(KEY_K) Then col5 = BitClr(col5, 2)
    If IsKeyPressed(KEY_L) Then col5 = BitClr(col5, 6)
    If IsKeyPressed(KEY_M) Then col4 = BitClr(col4, 3)
    If IsKeyPressed(KEY_N) Then col4 = BitClr(col4, 0)
    If IsKeyPressed(KEY_O) Then col4 = BitClr(col4, 1)
    If IsKeyPressed(KEY_P) Then col5 = BitClr(col5, 6)
    If IsKeyPressed(KEY_Q) Then col6 = BitClr(col6, 6)
    If IsKeyPressed(KEY_R) Then col5 = BitClr(col5, 1)
    If IsKeyPressed(KEY_S) Then col6 = BitClr(col6, 5)
    If IsKeyPressed(KEY_T) Then col5 = BitClr(col5, 1)
    If IsKeyPressed(KEY_U) Then col4 = BitClr(col4, 1)
    If IsKeyPressed(KEY_V) Then col4 = BitClr(col4, 0)
    If IsKeyPressed(KEY_W) Then col6 = BitClr(col6, 1)
    If IsKeyPressed(KEY_X) Then col5 = BitClr(col5, 0)
    If IsKeyPressed(KEY_Y) Then col4 = BitClr(col4, 6)
    If IsKeyPressed(KEY_Z) Then col6 = BitClr(col6, 3)

    ' Numbers
    If IsKeyPressed(KEY_0) Then col4 = BitClr(col4, 4)
    If IsKeyPressed(KEY_1) Then col7 = BitClr(col7, 7)
    If IsKeyPressed(KEY_2) Then col7 = BitClr(col7, 3)
    If IsKeyPressed(KEY_3) Then col6 = BitClr(col6, 7)
    If IsKeyPressed(KEY_4) Then col6 = BitClr(col6, 3)
    If IsKeyPressed(KEY_5) Then col5 = BitClr(col5, 6)
    If IsKeyPressed(KEY_6) Then col5 = BitClr(col5, 3)
    If IsKeyPressed(KEY_7) Then col4 = BitClr(col4, 7)
    If IsKeyPressed(KEY_8) Then col4 = BitClr(col4, 3)
    If IsKeyPressed(KEY_9) Then col4 = BitClr(col4, 7)

    Mem_SetKeyCol 0, col0
    Mem_SetKeyCol 1, col1
    Mem_SetKeyCol 2, col2
    Mem_SetKeyCol 3, col3
    Mem_SetKeyCol 4, col4
    Mem_SetKeyCol 5, col5
    Mem_SetKeyCol 6, col6
    Mem_SetKeyCol 7, col7
End Sub

' === Main Loop ===
Sub _Process(delta As Double)
    If Not bLoaded Then
        QueueRedraw()
        Return
    End If

    UpdateKeyboard()

    ' === Native Machine fast path ===
    If NATIVE_MACHINE Then
        ' Push the freshly-scanned keyboard matrix into the native machine
        ' (UpdateKeyboard writes the 8 column bytes into the VG key matrix).
        Dim kc As Integer
        For kc = 0 To 7
            Machine.SetKeyCol kc, Mem_GetKeyCol(kc)
        Next

        ' Run one COMPLETE PAL frame entirely in C++ -- 6510 execution, RAM/ROM
        ' banking, VIC-II raster rendering, and the CIA1 system-IRQ timer all
        ' happen inside VGC64Machine.RunFrame with ZERO per-access Callable
        ' round-trips. This is the whole point of Native Machine mode.
        Machine.RunFrame()

        ' Blit the finished framebuffer straight to the display texture. The
        ' machine renders into its own RGBA8 384x272 Image, identical in layout
        ' to the VG VIC framebuffer, so DisplayTex (same dimensions) refreshes
        ' in one shot with no intermediate VG-side pixel work.
        UpdateTexture DisplayTex, Machine.GetFramebuffer()

        OutputAudio()

        FrameCount = FrameCount + 1
        Dim nowN As Double = Timer()
        Dim elN As Double = nowN - LastProgressPrintTime
        If elN >= 2 And elN > 0 Then
            Dim icNow As Long = Machine.GetInstructionCount()
            Dim instDelta As Long = icNow - LastProgressSteps
            Print "[NATIVE] frame=" & CStr(FrameCount) & " PC=$" & Hex(Machine.GetPC()) & " instr/s=" & CStr(Int(instDelta / elN)) & " $0428=" & Hex(Machine.PeekRAM(&H0428)) & " $042C=" & Hex(Machine.PeekRAM(&H042C))
            LastProgressPrintTime = nowN
            LastProgressSteps = icNow
        End If

        QueueRedraw()
        Return
    End If

    ' Every cross-module Sub here (C64_Step, Mem_Read, Vic_Tick, ...) runs via
    ' slow AST interpretation (see "Compiler: Entry point not found" — none of
    ' these get bytecode-compiled since they live in imported modules). A full
    ' PAL frame is ~19705 cycles, which can take a long time to interpret in an
    ' editor/debug build. Running the whole frame synchronously in one
    ' _Process call makes the app appear to freeze at startup. Instead, we
    ' process a small chunk of cycles per call and accumulate progress toward
    ' a full virtual frame across many real _Process calls.
    Dim chunkCycles As Long = 200
    Dim chunkRun As Long = 0
    Dim safetyCounter As Long = 0

    Do While chunkRun < chunkCycles
        ' Check for crash (PC = 0 or too many cycles)
        If Emu_GetPC() = 0 Then
            Print "CPU crash at PC=0! Cycles=" & CStr(CyclesThisFrame + chunkRun)
            bLoaded = False
            Return
        End If

        Dim instCycles As Integer = Emu_Step()
        chunkRun = chunkRun + instCycles
        TotalStepsExecuted = TotalStepsExecuted + 1
        TotalCyclesExecuted = TotalCyclesExecuted + instCycles

        ' Tick VIC for the instruction's cycle count in ONE call (was:
        ' one Vic_Tick() call PER CYCLE, i.e. 2-7 full Sub calls per
        ' instruction just for VIC ticking -- VG's per-call overhead
        ' dominates cost, so batching this into a single call with the
        ' cycle count is a large, safe win; see c64_vic.vg's Vic_Tick).
        Vic_Tick(instCycles)

        ' CIA1 Timer A countdown — fires ~60Hz system IRQ for keyboard scan
        CIA1_TimerA = CIA1_TimerA - instCycles
        If CIA1_TimerA <= 0 Then
            CIA1_TimerA = CIA1_TimerA + CIA1_TimerA_Latch
            ' Set CIA1 ICR flag ($DC0D bit 0) and trigger CPU IRQ
            Dim icr As Integer = Mem_GetBuf(&HDC0D)
            Mem_SetBuf &HDC0D, BitOr(icr, &H81)
            Emu_SetIRQ True
        End If

        safetyCounter = safetyCounter + 1
        If safetyCounter > chunkCycles * 3 Then
            Exit Do
        End If
    Loop

    CyclesThisFrame = CyclesThisFrame + chunkRun

    ' PERF DIAGNOSTIC: print real throughput every ~2 wall-clock seconds,
    ' regardless of virtual-frame progress -- proves whether execution is
    ' actually advancing (and how fast) instead of guessing from a black screen.
    Dim nowT As Double = Timer()
    Dim elapsed As Double = nowT - LastProgressPrintTime
    If elapsed >= 2 And elapsed > 0 Then
        Dim stepsDelta As Long = TotalStepsExecuted - LastProgressSteps
        Dim cyclesDelta As Long = TotalCyclesExecuted - LastProgressCycles
        Dim d012val As Integer = Mem_GetBuf(&HD012)
        Dim rasterHi As Integer = BitAnd(Mem_GetBuf(&HD011), &H80)
        Dim v0428 As Integer = Mem_GetBuf(&H0428)
        Dim v042C As Integer = Mem_GetBuf(&H042C)
        Print "[PERF] cyc=" & CStr(TotalCyclesExecuted) & " PC=$" & Hex(Emu_GetPC()) & " rate=" & CStr(Int(cyclesDelta / elapsed)) & " $0428=" & Hex(v0428) & " $042C=" & Hex(v042C)
        LastProgressPrintTime = nowT
        LastProgressCycles = TotalCyclesExecuted
        LastProgressSteps = TotalStepsExecuted

    End If

    If CyclesThisFrame >= CYCLES_PER_FRAME_PAL Then
        CyclesThisFrame = CyclesThisFrame - CYCLES_PER_FRAME_PAL

        ' Copy VIC framebuffer to display
        BlitImage DisplayImage, Vic_GetFramebuf(), 0, 0, SCREEN_W, SCREEN_H, 0, 0
        UpdateTexture DisplayTex, DisplayImage

        ' Audio
        OutputAudio()

        ' Update status every second
        FrameCount = FrameCount + 1
        If FrameCount Mod 60 = 0 Then
            Print "C64 PC=$" & Hex(Emu_GetPC()) & " A=$" & Hex(Emu_GetA()) & " X=$" & Hex(Emu_GetX()) & " Y=$" & Hex(Emu_GetY()) & " SP=$" & Hex(Emu_GetSP()) & " Flags=$" & Hex(Emu_GetFlags())
        End If
    End If
    QueueRedraw()
End Sub

Sub _Draw()
    If IsObject(DisplayTex) Then
        ' Scale to fit window. Screen.Width/Height reflect the physical
        ' monitor resolution (DisplayServer::screen_get_size), NOT the game
        ' window's client size -- using them here made the scale factor far
        ' too large, so the texture was drawn much bigger than the window
        ' and only its top-left sliver (mostly interior, since the border is
        ' a thin band near the source image's edges) was visible. That looked
        ' like a border that didn't surround the interior and was "thick and
        ' off-center." GetViewportRect().Size is the actual window/viewport
        ' size and is the documented pattern for this (see
        ' docs/tutorials/your_first_2d_game.md). Fixed Jul 30 2026.
        Dim winSize As Variant = GetViewportRect().Size
        Dim scaleX As Double = winSize.x / SCREEN_W
        Dim scaleY As Double = winSize.y / SCREEN_H
        Dim sc As Double
        If scaleX < scaleY Then sc = scaleX Else sc = scaleY
        Dim drawW As Double = SCREEN_W * sc
        Dim drawH As Double = SCREEN_H * sc
        Dim offX As Double = (winSize.x - drawW) / 2
        Dim offY As Double = (winSize.y - drawH) / 2
        DrawTextureRect DisplayTex, offX, offY, drawW, drawH
    End If
End Sub

Sub OutputAudio()
    If SoundHandle = 0 Then Return

    Dim available As Integer = SoundGen.Available(SoundHandle)
    If available > 0 Then
        ' SID stub - generate silence
        Dim silence As PackedFloat32Array
        silence.resize(available * 2)
        SoundGen.PushStereoBuffer(SoundHandle, silence)
    End If
End Sub

Sub Shutdown()
    If SoundHandle <> 0 Then
        SoundGen.Close SoundHandle
        SoundHandle = 0
    End If
    bLoaded = False
End Sub

' === Emu_* dispatch helpers (Turbo Mode indirection) ===
' Route CPU stepping/register access to either the native VGCpu6502 core or
' the pure-VG c64_cpu.vg core, depending on TURBO_MODE. Keeps _Process/_Ready/
' InitializeC64 free of scattered If/Else branches.

' Local forwarders for VGCpu6502.SetIOHook -- MUST live in this file (see the
' comment at the SetIOHook call site in _Ready for why Mem_Read/Mem_Write
' can't be used directly as Callable targets).
Function IOBus_Read(addr As Integer) As Integer
    Return Mem_Read(addr)
End Function

Sub IOBus_Write(addr As Integer, value As Integer)
    Mem_Write addr, value
End Sub

' Bus_Write / Bus_ReadByte -- setup-time bus access that targets whichever
' machine owns memory: the native VGC64Machine (its own C++ RAM/ROM/IO) or the
' VG c64_memory.vg subsystem (Turbo and pure-VG paths share it). Used by
' InitializeC64 so the VIC-register defaults and the $C000 boot stub land in the
' right place regardless of mode. Bus_ReadByte reads THROUGH banking, so at boot
' (KERNAL/BASIC/IO mapped in) $A000 returns the BASIC cold-start vector, not RAM.
Sub Bus_Write(addr As Integer, value As Integer)
    If NATIVE_MACHINE Then
        Machine.WriteByte addr, value
    Else
        Mem_Write addr, value
    End If
End Sub

Function Bus_ReadByte(addr As Integer) As Integer
    If NATIVE_MACHINE Then Return Machine.ReadByte(addr)
    Return Mem_Read(addr)
End Function

Function Emu_Step() As Integer
    If TURBO_MODE Then
        ' Service a pending IRQ at the instruction boundary, same as
        ' C64_Step()'s own check. TriggerIRQ() is level-gated internally by
        ' the I flag and returns the 7-cycle service cost only if it actually
        ' fired -- if masked, gIRQLineNative stays set and we retry next step
        ' (matches the edge-latched-until-serviced semantics of gC64_IRQPending).
        If gIRQLineNative Then
            Dim irqCyc As Integer = NativeCpu.TriggerIRQ()
            If irqCyc > 0 Then
                gIRQLineNative = False
                Return irqCyc
            End If
        End If
        Return NativeCpu.Step()
    End If
    Return C64_Step()
End Function

Sub Emu_SetIRQ(state As Boolean)
    If TURBO_MODE Then
        gIRQLineNative = state
    Else
        C64_SetIRQ state
    End If
End Sub

Function Emu_GetPC() As Integer
    If NATIVE_MACHINE Then Return Machine.GetPC()
    If TURBO_MODE Then Return NativeCpu.GetPC()
    Return C64_GetPC()
End Function

Function Emu_GetA() As Integer
    If NATIVE_MACHINE Then Return Machine.GetA()
    If TURBO_MODE Then Return NativeCpu.GetA()
    Return C64_GetA()
End Function

Function Emu_GetX() As Integer
    If NATIVE_MACHINE Then Return Machine.GetX()
    If TURBO_MODE Then Return NativeCpu.GetX()
    Return C64_GetX()
End Function

Function Emu_GetY() As Integer
    If NATIVE_MACHINE Then Return Machine.GetY()
    If TURBO_MODE Then Return NativeCpu.GetY()
    Return C64_GetY()
End Function

Function Emu_GetSP() As Integer
    If NATIVE_MACHINE Then Return Machine.GetSP()
    If TURBO_MODE Then Return NativeCpu.GetSP()
    Return C64_GetSP()
End Function

Function Emu_GetFlags() As Integer
    If NATIVE_MACHINE Then Return Machine.GetStatus()
    If TURBO_MODE Then Return NativeCpu.GetStatus()
    Return C64_GetFlags()
End Function

' === File I/O helper ===
Function FileExists(path As String) As Boolean
    Dim sz As Long = FileLen(path)
    Return (sz > 0)
End Function

Function IsKeyPressed(keyCode As Integer) As Boolean
    Return Input.IsKeyPressed(keyCode)
End Function

Function IsActionPressed(actionName As String) As Boolean
    Return Input.IsActionPressed(actionName)
End Function

' === Drag-and-drop support ===
Sub OnFilesDropped(files As Variant)
    If IsArray(files) Then
        If UBound(files) >= 0 Then
            Print "Files dropped: " & files(0)
        End If
    End If
End Sub
