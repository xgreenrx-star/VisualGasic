' c64_vic.vg -- VIC-II Video Interface Chip Emulation
' RESTRUCTURED: Module-level functions for bytecode-compilation.
' Renders C64 display into an Image framebuffer

Import "c64_constants.vg"


' ================================================================
' === MODULE-LEVEL STATE ===
' ================================================================
Public  gVic_RasterLine    As Integer
Public  gVic_RasterIRQ     As Integer
Public  gVic_CycleInLine   As Integer
Public  gVic_BorderX       As Integer
Public  gVic_BorderY       As Integer
Public  gVic_Framebuf      As Variant

' Private scratch
Private gVic_tmpCol As Integer


' ================================================================
' === INIT ===
' ================================================================
Sub Vic_Init()
    Set gVic_Framebuf = CreateImage(SCREEN_W, SCREEN_H, Color8(0, 0, 0, 255))
    gVic_RasterLine  = 0
    gVic_RasterIRQ   = 0
    gVic_CycleInLine = 0
    gVic_BorderX     = BORDER_X
    gVic_BorderY     = BORDER_Y
End Sub


' ================================================================
' === TICK (per CPU cycle) ===
' ================================================================
Sub Vic_Tick()
    gVic_CycleInLine = gVic_CycleInLine + 1
    If gVic_CycleInLine >= 63 Then
        gVic_CycleInLine = 0
        gVic_RasterLine = gVic_RasterLine + 1

        ' PAL: 312 lines per frame (0-311)
        If gVic_RasterLine >= 312 Then
            gVic_RasterLine = 0
            Vic_RenderFrame()
        End If

        ' Update VIC register $D012 (raster)
        gMem_Buf(&HD012) = BitAnd(gVic_RasterLine, &HFF)

        ' Check raster IRQ
        If gVic_RasterLine = gVic_RasterIRQ Then
            Dim flags As Integer = gMem_Buf(&HD019)
            gMem_Buf(&HD019) = BitOr(flags, &H01)
        End If

        ' Render scanline if in visible area
        If gVic_RasterLine >= 16 And gVic_RasterLine < 251 Then
            Vic_RenderScanline()
        End If
    End If
End Sub


' ================================================================
' === RENDER FRAME ===
' ================================================================
Sub Vic_RenderFrame()
    Dim borderCol As Integer = BitAnd(gMem_Buf(&HD020), &H0F)
    Dim x As Integer, y As Integer
    For y = 0 To SCREEN_H - 1
        For x = 0 To SCREEN_W - 1
            SetImagePixel gVic_Framebuf, x, y, GetC64Color(borderCol)
        Next
    Next
End Sub


' ================================================================
' === RENDER SCANLINE ===
' ================================================================
Sub Vic_RenderScanline()
    Dim screenY As Integer = gVic_RasterLine - 16
    If screenY < 0 Or screenY >= VISIBLE_H Then Return

    Dim ctrl1 As Integer = gMem_Buf(&HD011)
    Dim ctrl2 As Integer = gMem_Buf(&HD016)
    Dim memPtr As Integer = gMem_Buf(&HD018)

    Dim DEN   As Boolean = BitTst(ctrl1, 4)
    Dim BMM   As Boolean = BitTst(ctrl1, 5)
    Dim ECM   As Boolean = BitTst(ctrl1, 6)
    Dim RSEL  As Boolean = BitTst(ctrl1, 3)
    Dim MCM   As Boolean = BitTst(ctrl2, 4)
    Dim CSEL  As Boolean = BitTst(ctrl2, 3)

    Dim yScroll  As Integer = BitAnd(ctrl1, &H07)
    Dim charRow  As Integer = (screenY + yScroll) \ 8
    Dim pixelRow As Integer = (screenY + yScroll) Mod 8

    Dim vm10     As Integer = BitShiftRight(BitAnd(memPtr, &HF0), 4)
    Dim scrBase  As Integer = BitShiftLeft(vm10, 10)

    Dim cbBits   As Integer = BitShiftRight(BitAnd(memPtr, &H0E), 1)
    Dim charBase As Integer = BitShiftLeft(cbBits, 11)

    Dim numCols As Integer
    If CSEL Then numCols = 40 Else numCols = 38
    Dim xOff As Integer
    If CSEL Then xOff = 0 Else xOff = 8

    If BMM Then
        Vic_RenderBitmapScanline screenY, charRow, pixelRow, scrBase, charBase, xOff
    ElseIf MCM Then
        Vic_RenderMCCharScanline screenY, charRow, pixelRow, scrBase, numCols, xOff
    Else
        Vic_RenderCharScanline screenY, charRow, pixelRow, scrBase, charBase, numCols, xOff
    End If
End Sub


' ================================================================
' === STANDARD CHARACTER MODE ===
' ================================================================
Sub Vic_RenderCharScanline(screenY As Integer, charRow As Integer, pixelRow As Integer, scrBase As Integer, charBase As Integer, numCols As Integer, xOff As Integer)
    Dim bgCol As Integer = BitAnd(gMem_Buf(&HD021), &H0F)
    Dim col As Integer, ch As Integer

    For col = 0 To numCols - 1
        Dim scrAddr As Integer = scrBase + charRow * 40 + col
        ch = gMem_Buf(scrAddr)
        Dim chAddr As Integer = charBase + ch * 8 + pixelRow
        Dim data As Integer = gMem_Buf(chAddr)

        Dim index As Integer = charRow * 40 + col
        If index >= 0 And index < &H0400 Then
            gVic_tmpCol = BitAnd(gMem_ColorRAM(index), &H0F)
        End If

        Dim px As Integer
        For px = 0 To 7
            Dim sx As Integer = xOff + col * 8 + px + gVic_BorderX
            If sx >= 0 And sx < SCREEN_W And screenY + gVic_BorderY >= 0 And screenY + gVic_BorderY < SCREEN_H Then
                If BitTst(data, 7 - px) Then
                    SetImagePixel gVic_Framebuf, sx, screenY + gVic_BorderY, GetC64Color(gVic_tmpCol)
                End If
            End If
        Next
    Next
End Sub


' ================================================================
' === MULTI-COLOR CHARACTER MODE ===
' ================================================================
Sub Vic_RenderMCCharScanline(screenY As Integer, charRow As Integer, pixelRow As Integer, scrBase As Integer, numCols As Integer, xOff As Integer)
    Dim mc1   As Integer = BitAnd(gMem_Buf(&HD022), &H0F)
    Dim mc2   As Integer = BitAnd(gMem_Buf(&HD023), &H0F)
    Dim bgCol As Integer = BitAnd(gMem_Buf(&HD021), &H0F)

    Dim col As Integer
    For col = 0 To numCols - 1
        Dim scrAddr As Integer = scrBase + charRow * 40 + col
        Dim ch As Integer = gMem_Buf(scrAddr)

        Dim chBase As Integer
        If BitTst(ch, 3) Then chBase = &H0000 Else chBase = &H0800
        Dim chAddr As Integer = chBase + (BitAnd(ch, &H07)) * 8 + pixelRow
        Dim data As Integer = gMem_Buf(chAddr)

        Dim index As Integer = charRow * 40 + col
        If index < &H0400 Then
            gVic_tmpCol = BitAnd(gMem_ColorRAM(index), &H0F)
        End If

        Dim px As Integer
        For px = 0 To 3
            Dim pair As Integer = BitShiftRight(BitAnd(data, &HC0), 6)
            data = BitAnd(BitShiftLeft(data, 2), &HFF)

            Dim pc As Integer
            Select Case pair
                Case 0: pc = bgCol
                Case 1: pc = mc1
                Case 2: pc = mc2
                Case 3: pc = gVic_tmpCol
            End Select

            Dim dx As Integer
            For dx = 0 To 1
                Dim sx As Integer = xOff + col * 8 + px * 2 + dx + gVic_BorderX
                If sx >= 0 And sx < SCREEN_W And screenY + gVic_BorderY >= 0 And screenY + gVic_BorderY < SCREEN_H Then
                    SetImagePixel gVic_Framebuf, sx, screenY + gVic_BorderY, GetC64Color(pc)
                End If
            Next
        Next
    Next
End Sub


' ================================================================
' === BITMAP MODE ===
' ================================================================
Sub Vic_RenderBitmapScanline(screenY As Integer, charRow As Integer, pixelRow As Integer, scrBase As Integer, charBase As Integer, xOff As Integer)
    Dim col As Integer
    For col = 0 To 39
        Dim bitmapRow  As Integer = charRow * 8 + pixelRow
        Dim bitmapAddr As Integer = charBase + bitmapRow * 40 + col
        Dim data       As Integer = gMem_Buf(bitmapAddr)

        Dim scrAddr    As Integer = scrBase + charRow * 40 + col
        Dim colorInfo  As Integer = gMem_Buf(scrAddr)
        Dim fgCol      As Integer = BitShiftRight(colorInfo, 4) And &H0F

        Dim px As Integer
        For px = 0 To 7
            Dim sx As Integer = xOff + col * 8 + px + gVic_BorderX
            If sx >= 0 And sx < SCREEN_W And screenY + gVic_BorderY >= 0 And screenY + gVic_BorderY < SCREEN_H Then
                If BitTst(data, 7 - px) Then
                    SetImagePixel gVic_Framebuf, sx, screenY + gVic_BorderY, GetC64Color(fgCol)
                End If
            End If
        Next
    Next
End Sub

Function Vic_GetFramebuf() As Variant
    Return gVic_Framebuf
End Function
