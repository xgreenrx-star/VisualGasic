; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="VG Terminal — ANSI BBS Client"
config/description="ANSI BBS terminal client with WinSock networking written in VisualGasic"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

VGDebugHandler="*res://addons/visual_gasic/vg_debug_handler.gd"

[display]

window/size/viewport_width=820
window/size/viewport_height=620

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_gasic/plugin.cfg")
