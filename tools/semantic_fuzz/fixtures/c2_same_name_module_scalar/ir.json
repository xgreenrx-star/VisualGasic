      "content": "' SEMANTIC_FUZZ_MODULE c2_lib_bump.vg\nAttribute VB_Name = \"c2_lib_bump\"\n\nDim x As Integer\nDim _sem_mod_ready As Integer\n\nFunction LibBump(ByRef n As Integer) As Integer\n\tIf _sem_mod_ready = 0 Then\n\t\tx = 7\n\t\t_sem_mod_ready = 1\n\tEnd If\n\tx = (x + 1)\n\tn = (n + 2)\n\tReturn (n * 2)\nEnd Function\n\nFunction LibPeekX() As Integer\n\tIf _sem_mod_ready = 0 Then\n\t\tx = 7\n\t\t_sem_mod_ready = 1\n\tEnd If\n\tReturn x\nEnd Function\n\n",
