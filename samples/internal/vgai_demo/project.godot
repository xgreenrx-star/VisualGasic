; Engine configuration file.

config_version=5

[application]
config/name="VGAI Demo"
config/description="Minimal VisualGasic project demonstrating VGAI integration."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[display]
window/size/viewport_width=800
window/size/viewport_height=600
window/stretch/mode="viewport"

[editor_plugins]
enabled=PackedStringArray("res://addons/visual_gasic/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[vg]

gdai/enabled=false
gdai/provider="local"
gdai/api_key=""
gdai/endpoint="http://127.0.0.1:8000/v1"
gdai/model=""
gdai/embedding_model=""
gdai/temperature=0.7
gdai/max_tokens=256
gdai/top_p=1.0
gdai/n=1
gdai/timeout_ms=15000

[audio]
driver/enable_input=true
