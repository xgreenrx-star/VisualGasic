; Engine configuration file.
; Visual Gasic HTML5 smoke sample — Open-Meteo HTTP demo.

config_version=5

[application]

config/name="VG Web Hello"
config/description="HTML5 sample: VGHttpRequest + canvas UI (Open-Meteo)"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=400
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_gasic/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
