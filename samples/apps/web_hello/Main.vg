' Web Hello — HTML5 export smoke test (HTTP + _Draw UI)
Attribute VB_Name = "WebHello"

Const SCREEN_W As Integer = 640
Const SCREEN_H As Integer = 400

Dim headline As String
Dim body As String
Dim weatherStarted As Boolean

Sub _Ready()
	headline = "Visual Gasic · HTML5"
	body = "Fetching Open-Meteo…"
	weatherStarted = False
	QueueRedraw
End Sub

Dim loadDelay As Single

Sub _Process(delta As Single)
	If weatherStarted Then Exit Sub
	loadDelay = loadDelay + delta
	If loadDelay < 0.25 Then Exit Sub
	weatherStarted = True
	Call LoadWeather
End Sub

Sub LoadWeather()
	Dim url As String
	url = "https://api.open-meteo.com/v1/forecast?latitude=40.7128&longitude=-74.0060&current_weather=true&timezone=auto"

	Dim http As New VGHttpRequest
	Dim data As Object
	Set data = http.GetJson(url)

	If http.Status = 200 Then
		Dim cw As Object
		Set cw = data("current_weather")
		Dim temp As Single
		Dim wind As Single
		temp = cw("temperature")
		wind = cw("windspeed")
		body = "NYC now: " & CStr(temp) & " °C, wind " & CStr(wind) & " km/h"
	Else
		body = "HTTP " & CStr(http.Status) & " — " & http.StatusText
		If Len(http.ResponseText) > 0 Then
			body = body & "  " & Left(http.ResponseText, 120)
		End If
	End If
	QueueRedraw
End Sub

Sub _Draw()
	DrawRect Rect2(0, 0, SCREEN_W, SCREEN_H), Color8(24, 28, 36), True
	DrawString headline, 24, 28, Color8(180, 220, 255), 26
	DrawString "Open-Meteo (NYC) via VGHttpRequest", 24, 62, Color8(140, 150, 170), 14
	DrawString body, 24, 96, Color8(230, 235, 245), 13
	DrawString "Rebuild WASM: bash scripts/build_web_gdextension.sh", 24, SCREEN_H - 36, Color8(100, 110, 130), 12
End Sub
