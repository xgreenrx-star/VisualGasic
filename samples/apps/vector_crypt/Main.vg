	Call canvas.AddWireLine3D(6.6, 0.05, 16.35, 10.4, 0.05, 16.35, 2.0, Color(0.95, 0.45, 0.1, 1.0))
	Call AddSolid(6.35, 0.0, 8.4, 6.6, 4.4, 20.4, 0)
