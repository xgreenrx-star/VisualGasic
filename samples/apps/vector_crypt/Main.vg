	Call AddSolid(14.85, 0.0, 16.3, 15.2, 2.15, 19.9, 0)
	Call AddSolid(20.45, 0.0, 16.3, 20.75, 4.4, 17.15, 0)
	Call AddSolid(20.45, 0.0, 18.85, 20.75, 4.4, 19.95, 0)
	Call AddDoor(20.45, 0.0, 17.15, 20.75, 3.3, 18.85, 3, 1)
	Call AddCeil(10.5, 16.3, 20.6, 19.9, 4.35)
	Call canvas.AddWireQuad3D(14.85, 0.0, 16.3, 15.2, 0.0, 16.3, 15.2, 2.15, 16.3, 14.85, 2.15, 16.3, Color(0.55, 0.2, 0.22, 1.0))
	Call canvas.AddWireQuad3D(14.85, 0.0, 19.9, 14.85, 2.15, 19.9, 15.2, 2.15, 19.9, 15.2, 0.0, 19.9, Color(0.55, 0.2, 0.22, 1.0))
	Call canvas.AddWireQuad3D(11.35, 0.05, 17.05, 12.55, 0.05, 17.05, 12.55, 0.05, 18.45, 11.35, 0.05, 18.45, Color(0.85, 0.25, 0.75, 1.0))
	Call canvas.AddWireQuad3D(18.25, 0.05, 17.05, 19.45, 0.05, 17.05, 19.45, 0.05, 18.45, 18.25, 0.05, 18.45, Color(0.25, 0.85, 0.45, 1.0))
	' Room 5 custodians. Catwalk along the south edge.
	' The south wall is split at the catwalk so a full-height plank cannot paint across the deck.
	Call canvas.SetWireRoom(5)
	Call Panel(canvas, 20.6, 0.0, 15.5, 9.9, 0.0, 0.0, 0.0, 2.05, 0.0, 0.32, 0.18, 0.14)
	Call Panel(canvas, 20.6, 2.05, 15.5, 9.9, 0.0, 0.0, 0.0, 2.35, 0.0, 0.32, 0.18, 0.14)
