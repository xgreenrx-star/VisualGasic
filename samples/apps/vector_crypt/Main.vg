	Call Panel(canvas, 20.6, 0.0, 18.85, 0.0, 4.4, 0.0, 0.0, 0.0, 1.05, 0.45, 0.42, 0.5)
	Call Panel(canvas, 10.5, 0.0, 19.9, 10.1, 0.0, 0.0, 0.0, 4.4, 0.0, 0.4, 0.38, 0.46)
	Call AddSolid(10.6, 0.0, 19.82, 20.5, 4.4, 20.15, 0)
	Call Panel(canvas, 10.5, 4.35, 16.3, 10.1, 0.0, 0.0, 0.0, 0.0, 3.6, 0.72, 0.7, 0.78)
