	Call AddSolid(10.6, 0.0, 16.02, 20.5, 4.4, 16.38, 0)
	Call Panel(canvas, 20.6, 0.0, 16.3, 0.0, 4.4, 0.0, 0.0, 0.0, 0.85, 0.45, 0.42, 0.5)
