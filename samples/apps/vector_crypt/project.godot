; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vector Crypt"
config/description="First-person vector puzzle prototype — helmet HUD, gravity/portal direction (Visual Gasic)."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

VGDebugHandler="*res://addons/visual_gasic/vg_debug_handler.gd"
VoiceOver="*res://voice_over.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="/home/Commodore/Documents/VisualGasic/samples/apps/vector_crypt/DemoVideo/Vid2.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_gasic/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
