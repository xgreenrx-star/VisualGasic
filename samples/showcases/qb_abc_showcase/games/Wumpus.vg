' Hunt the Wumpus — cave graph (Tier B)
Option Explicit

Dim wu_active As Boolean
Dim wu_player As Integer
Dim wu_wumpus As Integer
Dim wu_pit1 As Integer
Dim wu_pit2 As Integer
Dim wu_arrows As Integer
Dim wu_msg As String
Dim wu_aim As Integer

Sub Wumpus_Init()
	Screen 13
	Cls
	wu_player = 1
	wu_wumpus = 8 + Int(Rnd() * 10)
	wu_pit1 = 12
	wu_pit2 = 17
	' Keep hazards off the start room and its three tunnels.
	If wu_wumpus < 4 Then wu_wumpus = 8
	wu_arrows = 5
	wu_active = True
	Call Wumpus_Sense
	Call Wumpus_Draw
End Sub

Function Wumpus_Active() As Boolean
	Wumpus_Active = wu_active
End Function

Sub Wumpus_GetHud(ByRef l1 As String, ByRef l2 As String)
	l1 = "WUMPUS  room:" & CStr(wu_player) & "  arrows:" & CStr(wu_arrows)
	l2 = wu_msg
End Sub

Function Wumpus_Adj(r As Integer, slot As Integer) As Integer
	Dim a As Integer
	Dim b As Integer
	Dim c As Integer
	a = r - 1
	If a < 1 Then a = 20
	b = r + 1
	If b > 20 Then b = 1
	c = r + 10
	If c > 20 Then c = c - 20
	If slot = 1 Then Wumpus_Adj = a
	If slot = 2 Then Wumpus_Adj = b
	If slot = 3 Then Wumpus_Adj = c
End Function

Sub Wumpus_Move(slot As Integer)
	Dim nr As Integer
	nr = Wumpus_Adj(wu_player, slot)
	If nr = wu_pit1 Or nr = wu_pit2 Then
		wu_msg = "Fell in pit! Game over."
		wu_active = False
		Exit Sub
	End If
	If nr = wu_wumpus Then
		wu_msg = "Wumpus ate you!"
		wu_active = False
		Exit Sub
	End If
	wu_player = nr
	Call Wumpus_Sense
	Call Wumpus_Draw
End Sub

Sub Wumpus_Sense()
	wu_msg = "Room " & CStr(wu_player) & ". "
	Dim i As Integer
	For i = 1 To 3
		Dim n As Integer
		n = Wumpus_Adj(wu_player, i)
		If n = wu_wumpus Then wu_msg = wu_msg & "Smell wumpus! "
		If n = wu_pit1 Or n = wu_pit2 Then wu_msg = wu_msg & "Draft... "
	Next i
	wu_msg = wu_msg & "  1/2/3 move along a tunnel, S then 1/2/3 shoots"
End Sub

Sub Wumpus_Shoot(slot As Integer)
	If wu_arrows <= 0 Then
		wu_msg = "No arrows."
		Exit Sub
	End If
	wu_arrows = wu_arrows - 1
	Dim nr As Integer
	nr = Wumpus_Adj(wu_player, slot)
	If nr = wu_wumpus Then
		wu_msg = "You slayed the Wumpus!"
		wu_active = False
	Else
		wu_msg = "Miss. Wumpus may move."
		If Rnd() > 0.5 Then
			wu_wumpus = Wumpus_Adj(wu_wumpus, 1 + Int(Rnd() * 3))
		End If
	End If
	Call Wumpus_Draw
End Sub

Sub Wumpus_Key(ch As String)
	Dim c As String
	c = UCase(ch)
	If c = "Q" Then
		wu_active = False
		Exit Sub
	End If
	If c = "S" Then
		wu_aim = 1
		wu_msg = "Shoot: press 1, 2, or 3 for the tunnel."
		Call Wumpus_Draw
		Exit Sub
	End If
	If c = "1" Or c = "2" Or c = "3" Then
		Dim slot As Integer
		slot = Asc(c) - 48
		If wu_aim = 1 Then
			wu_aim = 0
			Call Wumpus_Shoot(slot)
		Else
			Call Wumpus_Move(slot)
		End If
		Call Wumpus_Draw
	End If
End Sub

Sub Wumpus_Draw()
	Cls
	' Twenty caves in a ring. You are the white room. Tunnels 1, 2, 3
	' are the previous cave, the next cave, and the cave across.
	Dim i As Integer
	For i = 1 To 20
		Dim ang As Single
		ang = (i - 1) * 6.28318 / 20
		Dim x As Integer
		Dim y As Integer
		x = 160 + Int(Cos(ang) * 70)
		y = 100 + Int(Sin(ang) * 55)
		Dim col As Integer
		col = 1
		If i = wu_player Then col = 15
		Circle (x, y), 6, col
		If i = wu_player Then Circle (x, y), 3, 15
	Next i
	Locate 2, 2
	Print Left(wu_msg, 38);
End Sub
