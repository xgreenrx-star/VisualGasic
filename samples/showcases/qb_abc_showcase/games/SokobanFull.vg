' Sokoban — three levels (Tier C)
Option Explicit

Dim sf_active As Boolean
Dim sf_level As Integer
Dim sf_px As Integer
Dim sf_py As Integer
Dim sf_map(10, 10) As Integer
Dim sf_msg As String

Sub SokobanFull_Init()
	sf_level = 1
	sf_active = True
	Call SokobanFull_LoadLevel
End Sub

Function SokobanFull_Active() As Boolean
	SokobanFull_Active = sf_active
End Function

Sub SokobanFull_GetHud(ByRef l1 As String, ByRef l2 As String)
	l1 = "SOKOBAN FULL  level " & CStr(sf_level) & "/3"
	l2 = sf_msg
End Sub

Sub SokobanFull_LoadLevel()
	Screen 13
	Dim x As Integer
	Dim y As Integer
	For y = 0 To 10
		For x = 0 To 10
			sf_map(x, y) = 0
		Next x
	Next y
	For x = 0 To 10
		sf_map(0, x) = 1
		sf_map(10, x) = 1
		sf_map(x, 0) = 1
		sf_map(x, 10) = 1
	Next x
	If sf_level = 1 Then
		sf_px = 2: sf_py = 2
		sf_map(4, 3) = 2
		sf_map(5, 3) = 3
		sf_map(6, 4) = 4
	End If
	If sf_level = 2 Then
		sf_px = 2: sf_py = 5
		sf_map(3, 3) = 2
		sf_map(5, 4) = 3
		sf_map(7, 5) = 4
		sf_map(4, 6) = 3
	End If
	If sf_level = 3 Then
		sf_px = 1: sf_py = 1
		sf_map(5, 2) = 2
		sf_map(6, 3) = 3
		sf_map(7, 4) = 4
		sf_map(8, 5) = 3
		sf_map(8, 4) = 4
	End If
	sf_msg = "Push boxes onto goals (green)."
	Call SokobanFull_Draw
End Sub

Sub SokobanFull_TryMove(dx As Integer, dy As Integer)
	Dim nx As Integer
	Dim ny As Integer
	nx = sf_px + dx
	ny = sf_py + dy
	If sf_map(ny, nx) = 1 Then Exit Sub
	If sf_map(ny, nx) = 3 Or sf_map(ny, nx) = 4 Then
		Dim bx As Integer
		Dim by As Integer
		bx = nx + dx
		by = ny + dy
		If sf_map(by, bx) = 1 Or sf_map(by, bx) = 3 Or sf_map(by, bx) = 4 Then Exit Sub
		If sf_map(ny, nx) = 3 Then sf_map(ny, nx) = 0
		If sf_map(ny, nx) = 4 Then sf_map(ny, nx) = 2
		If sf_map(by, bx) = 2 Then sf_map(by, bx) = 4 Else sf_map(by, bx) = 3
	End If
	sf_px = nx
	sf_py = ny
	If SokobanFull_Won() Then
		If sf_level >= 3 Then
			sf_msg = "All levels done!"
			sf_active = False
		Else
			sf_level = sf_level + 1
			Call SokobanFull_LoadLevel
		End If
	End If
	Call SokobanFull_Draw
End Sub

Function SokobanFull_Won() As Boolean
	Dim y As Integer
	Dim x As Integer
	For y = 0 To 10
		For x = 0 To 10
			If sf_map(y, x) = 3 Then
				SokobanFull_Won = False
				Exit Function
			End If
		Next x
	Next y
	SokobanFull_Won = True
End Function

Sub SokobanFull_Draw()
	Cls
	Dim r As Integer
	Dim c As Integer
	For r = 0 To 10
		For c = 0 To 10
			Dim x As Integer
			Dim y As Integer
			x = 30 + c * 24
			y = 20 + r * 16
			If sf_map(r, c) = 1 Then Line (x, y)-(x + 22, y + 14), 8, BF
			If sf_map(r, c) = 2 Then Line (x + 4, y + 4)-(x + 18, y + 10), 6, BF
			If sf_map(r, c) = 3 Then Line (x + 6, y + 4)-(x + 16, y + 10), 14, BF
			If sf_map(r, c) = 4 Then Line (x + 4, y + 2)-(x + 18, y + 12), 10, BF
		Next c
	Next r
	Line (30 + sf_px * 24 + 4, 20 + sf_py * 16 + 2)-(30 + sf_px * 24 + 18, 20 + sf_py * 16 + 12), 15, BF
End Sub
