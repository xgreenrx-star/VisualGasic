' Mandelbrot animator — inspired by Microsoft/QB64 sample (original VG)
Option Explicit

Dim qm_active As Boolean
Dim qm_phase As Integer
Dim qm_y As Integer

Sub Q64Mandel_Init()
	Screen 13
	Cls
	qm_active = True
	qm_phase = 0
	qm_y = 0
End Sub

Function Q64Mandel_Active() As Boolean
	Q64Mandel_Active = qm_active
End Function

Sub Q64Mandel_GetHud(ByRef l1 As String, ByRef l2 As String)
	l1 = "Mandelbrot (320×200 scan)"
	l2 = "Space = re-seed palette phase  Esc = menu"
End Sub

Sub Q64Mandel_Tick(delta As Single)
	' A few rows per frame. Redrawing the whole set every tick locked the editor.
	If qm_y > 199 Then Exit Sub
	Dim n As Integer
	For n = 1 To 2
		If qm_y <= 199 Then
			Call Q64Mandel_Row(qm_y)
			qm_y = qm_y + 2
		End If
	Next n
End Sub

Sub Q64Mandel_KeyReseed()
	qm_phase = Int(Rnd() * 64)
	qm_y = 0
	Cls
End Sub

Sub Q64Mandel_Row(py As Integer)
	Dim px As Integer
	Dim y0 As Single
	y0 = (py - 100) / 80.0
	For px = 0 To 319 Step 2
			Dim x0 As Single
			x0 = (px - 160) / 80.0
			Dim x As Single
			Dim y As Single
			x = 0
			y = 0
			Dim i As Integer
			i = 0
			Do While i < 16 And x * x + y * y < 4
				Dim xt As Single
				xt = x * x - y * y + x0
				y = 2 * x * y + y0
				x = xt
				i = i + 1
			Loop
			Dim c As Integer
			If i >= 16 Then
				c = 0
			Else
				c = ((i + qm_phase) Mod 63) + 1
			End If
			PSet (px, py), c
			PSet (px + 1, py), c
			PSet (px, py + 1), c
			PSet (px + 1, py + 1), c
		Next px
End Sub
