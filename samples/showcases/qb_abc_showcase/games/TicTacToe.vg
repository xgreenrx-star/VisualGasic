' Tic Tac Toe — inspired by QB64 / QBasic sample gallery (original VG code)
Option Explicit

Dim tt_active As Boolean
Dim tt_board(8) As Integer
Dim tt_cursor As Integer
Dim tt_turn As Integer
Dim tt_msg As String

Sub Ttt_Init()
	Screen 13
	Cls
	Dim i As Integer
	For i = 0 To 8
		tt_board(i) = 0
	Next i
	tt_cursor = 0
	tt_turn = 1
	tt_msg = "Arrows move  Space = X  Esc = menu"
	tt_active = True
	Call Ttt_Draw
End Sub

Function Ttt_Active() As Boolean
	Ttt_Active = tt_active
End Function

Sub Ttt_GetHud(ByRef l1 As String, ByRef l2 As String)
	l1 = "Tic Tac Toe (you = X)"
	l2 = tt_msg
End Sub

Sub Ttt_MoveCursor(dx As Integer)
	If Not tt_active Then Exit Sub
	tt_cursor = tt_cursor + dx
	If tt_cursor < 0 Then tt_cursor = 0
	If tt_cursor > 8 Then tt_cursor = 8
	Call Ttt_Draw
End Sub

Sub Ttt_TryPlace()
	If Not tt_active Or tt_turn <> 1 Then Exit Sub
	If tt_board(tt_cursor) <> 0 Then Exit Sub
	tt_board(tt_cursor) = 1
	If Ttt_CheckWin(1) Then
		tt_msg = "You win!"
		tt_active = False
		Call Ttt_Draw
		Exit Sub
	End If
	If Ttt_BoardFull() Then
		tt_msg = "Draw."
		tt_active = False
		Call Ttt_Draw
		Exit Sub
	End If
	tt_turn = 2
	Call Ttt_AiMove
End Sub

Sub Ttt_AiMove()
	Dim i As Integer
	Dim pick As Integer
	pick = -1
	For i = 0 To 8
		If tt_board(i) = 0 Then
			tt_board(i) = 2
			If Ttt_CheckWin(2) Then
				pick = i
				tt_board(i) = 0
				Exit For
			End If
			tt_board(i) = 0
		End If
	Next i
	If pick < 0 Then
		For i = 0 To 8
			If tt_board(i) = 0 Then
				tt_board(i) = 1
				If Ttt_CheckWin(1) Then
					pick = i
					tt_board(i) = 0
					Exit For
				End If
				tt_board(i) = 0
			End If
		Next i
	End If
	If pick < 0 Then
		For i = 0 To 8
			If tt_board(i) = 0 Then pick = i
		Next i
	End If
	If pick >= 0 Then tt_board(pick) = 2
	If Ttt_CheckWin(2) Then
		tt_msg = "Computer (O) wins."
		tt_active = False
	ElseIf Ttt_BoardFull() Then
		tt_msg = "Draw."
		tt_active = False
	Else
		tt_turn = 1
	End If
	Call Ttt_Draw
End Sub

Function Ttt_BoardFull() As Boolean
	Dim i As Integer
	For i = 0 To 8
		If tt_board(i) = 0 Then
			Ttt_BoardFull = False
			Exit Function
		End If
	Next i
	Ttt_BoardFull = True
End Function

Function Ttt_CheckWin(p As Integer) As Boolean
	If tt_board(0) = p And tt_board(1) = p And tt_board(2) = p Then Ttt_CheckWin = True: Exit Function
	If tt_board(3) = p And tt_board(4) = p And tt_board(5) = p Then Ttt_CheckWin = True: Exit Function
	If tt_board(6) = p And tt_board(7) = p And tt_board(8) = p Then Ttt_CheckWin = True: Exit Function
	If tt_board(0) = p And tt_board(3) = p And tt_board(6) = p Then Ttt_CheckWin = True: Exit Function
	If tt_board(1) = p And tt_board(4) = p And tt_board(7) = p Then Ttt_CheckWin = True: Exit Function
	If tt_board(2) = p And tt_board(5) = p And tt_board(8) = p Then Ttt_CheckWin = True: Exit Function
	If tt_board(0) = p And tt_board(4) = p And tt_board(8) = p Then Ttt_CheckWin = True: Exit Function
	If tt_board(2) = p And tt_board(4) = p And tt_board(6) = p Then Ttt_CheckWin = True: Exit Function
	Ttt_CheckWin = False
End Function

Sub Ttt_Draw()
	Cls
	Line (80, 40)-(240, 40), 7, B
	Line (80, 100)-(240, 100), 7, B
	Line (80, 160)-(240, 160), 7, B
	Line (120, 20)-(120, 180), 7, B
	Line (180, 20)-(180, 180), 7, B
	Dim i As Integer
	For i = 0 To 8
		Dim cx As Integer
		Dim cy As Integer
		cx = 80 + (i Mod 3) * 60 + 30
		cy = 40 + (i \ 3) * 60 + 10
		If tt_board(i) = 1 Then
			Line (cx - 18, cy)-(cx + 18, cy + 36), 14
			Line (cx + 18, cy)-(cx - 18, cy + 36), 14
		ElseIf tt_board(i) = 2 Then
			Circle (cx, cy + 18), 16, 12
		End If
		If i = tt_cursor And tt_active Then
			Line (cx - 22, cy - 4)-(cx + 22, cy + 40), 15, B
		End If
	Next i
End Sub

Sub Ttt_Tick(delta As Single)
End Sub
