' Haunted House — mini adventure (ABC lineage, Tier B)
Option Explicit

Dim hh_active As Boolean
Dim hh_room As Integer
Dim hh_hasKey As Boolean
Dim hh_hasTorch As Boolean
Dim hh_ghost As Boolean
Dim hh_won As Boolean
Dim hh_msg As String

Sub Haunted_Init()
	Screen 13
	hh_room = 1
	hh_hasKey = False
	hh_hasTorch = False
	hh_ghost = True
	hh_won = False
	hh_msg = "Foyer. N hall, E library. Find the key and the torch."
	hh_active = True
	Call Haunted_Draw
End Sub

Function Haunted_Active() As Boolean
	Haunted_Active = hh_active And Not hh_won
End Function

Sub Haunted_GetHud(ByRef l1 As String, ByRef l2 As String)
	l1 = "HAUNTED HOUSE  room " & CStr(hh_room) & "  key:" & CStr(hh_hasKey) & " torch:" & CStr(hh_hasTorch)
	l2 = hh_msg
End Sub

Sub Haunted_Cmd(ch As String)
	Dim c As String
	c = UCase(ch)
	If c = "N" Then Call Haunted_Go(1)
	If c = "S" Then Call Haunted_Go(2)
	If c = "E" Then Call Haunted_Go(3)
	If c = "W" Then Call Haunted_Go(4)
	If c = "T" Then Call Haunted_Take
	If c = "U" Then Call Haunted_Use
	If c = "Q" Then
		hh_msg = "You leave the house."
		hh_active = False
	End If
	Call Haunted_Draw
End Sub

Sub Haunted_Go(dir As Integer)
	Dim prev As Integer
	prev = hh_room
	If hh_room = 1 And dir = 1 Then hh_room = 2: hh_msg = "Hall. Torch on the wall (T). W foyer. E dining."
	If hh_room = 1 And dir = 3 Then hh_room = 3: hh_msg = "Library. Key on the desk (T). W foyer."
	If hh_room = 2 And dir = 4 Then hh_room = 1: hh_msg = "Foyer. N hall, E library."
	If hh_room = 2 And dir = 3 Then hh_room = 4: hh_msg = "Dining room. S hall. N attic door."
	If hh_room = 3 And dir = 4 Then hh_room = 1: hh_msg = "Foyer. N hall, E library."
	If hh_room = 4 And dir = 2 Then hh_room = 2: hh_msg = "Hall. Torch on the wall (T). W foyer. E dining."
	If hh_room = 4 And dir = 1 Then
		If hh_hasKey And hh_hasTorch Then
			hh_room = 5
			hh_msg = "Attic. The ghost is gone. You win."
			hh_won = True
			hh_active = False
		Else
			hh_msg = "The attic door is locked. You need the key and a lit torch."
		End If
	End If
	If hh_room = prev And hh_room <> 4 Then hh_msg = "No exit that way."
	If hh_room = prev And hh_room = 4 And dir <> 1 Then hh_msg = "No exit that way."
End Sub

Sub Haunted_Take()
	If hh_room = 3 And Not hh_hasKey Then
		hh_hasKey = True
		hh_msg = "You take the rusty key."
	ElseIf hh_room = 2 And Not hh_hasTorch Then
		hh_hasTorch = True
		hh_msg = "You take the torch."
	Else
		hh_msg = "Nothing here to take."
	End If
End Sub

Sub Haunted_Use()
	If hh_hasTorch Then
		hh_ghost = False
		hh_msg = "Torch lit. The ghost keeps its distance."
	Else
		hh_msg = "You have nothing to use."
	End If
End Sub

Sub Haunted_Draw()
	Cls
	Locate 2, 2
	Print "HAUNTED HOUSE";
	Locate 4, 2
	Print Left(hh_msg, 38);
	Locate 8, 2
	Print "Arrows or N S E W";
	Locate 9, 2
	Print "T take    U light torch";
	Locate 12, 2
	If hh_hasKey Then Print "Key: yes";
	If Not hh_hasKey Then Print "Key: no";
	Locate 13, 2
	If hh_hasTorch Then Print "Torch: yes";
	If Not hh_hasTorch Then Print "Torch: no";
End Sub
