' Dialog demo — reconstruction of the Abacus CH13 dialog-box sample.
' This is not a line-by-line port. The original .BAS was not in the tree.
' What you get is the same kind of screen: a titled box, a field, and
' OK / Cancel, then a second panel. Space cycles the panels.
Option Explicit

Dim qd_active As Boolean
Dim qd_step As Integer

Sub Q64Dialog_Init()
	Screen 13
	Cls
	qd_active = True
	qd_step = 0
	Call Q64Dialog_Draw
End Sub

Function Q64Dialog_Active() As Boolean
	Q64Dialog_Active = qd_active
End Function

Sub Q64Dialog_GetHud(ByRef l1 As String, ByRef l2 As String)
	l1 = "Dialog demo box (text UI lite)"
	l2 = "Space = next panel  Esc = menu"
End Sub

Sub Q64Dialog_Advance()
	qd_step = qd_step + 1
	If qd_step > 2 Then qd_step = 0
	Call Q64Dialog_Draw
End Sub

Sub Q64Dialog_Draw()
	Cls
	' Shadow, frame, and a title bar. The field and buttons sit inside.
	Line (48, 38)-(288, 178), 8, BF
	Line (40, 30)-(280, 46), 1, BF
	Line (40, 30)-(280, 170), 15, B
	Line (41, 47)-(279, 169), 0, BF
	Locate 3, 6
	Color 15
	If qd_step = 0 Then
		Print "Customer record"
		Locate 5, 6
		Color 7
		Print "Name: ___Alice________"
		Locate 7, 6
		Print "ID:   1042"
		Locate 10, 6
		Color 10
		Line (56, 120)-(120, 140), 15, B
		Line (140, 120)-(230, 140), 7, B
		Locate 16, 9
		Print "OK"
		Locate 16, 20
		Print "Cancel"
	ElseIf qd_step = 1 Then
		Print "Confirm delete?"
		Locate 6, 6
		Color 12
		Print "This cannot be undone."
		Locate 10, 6
		Color 15
		Print "Y / N"
	Else
		Print "Help (F1 style)"
		Locate 5, 6
		Color 7
		Print "Tab between fields."
		Locate 7, 6
		Print "Enter saves, Esc closes."
	End If
End Sub
