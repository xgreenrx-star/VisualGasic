' Space Invaders — mode 13 (Alan Bruzzi / Kenneth Green lineage)
Option Explicit

Dim si_active As Boolean
Dim si_px As Integer
Dim si_dir As Integer
Dim si_tick As Single
Dim si_alx(4) As Integer
Dim si_aly(4) As Integer
Dim si_alive(4) As Integer
Dim si_bx As Integer
Dim si_by As Integer
Dim si_bon As Boolean

Sub Invaders_Init()
	Screen 13
	Cls
	si_px = 152
	si_dir = 1
	si_tick = 0
	si_bon = False
	Dim i As Integer
	For i = 0 To 4
		si_alx(i) = 40 + i * 55
		si_aly(i) = 30
		si_alive(i) = 1
	Next i
	si_active = True
	Call Invaders_Draw
End Sub

Function Invaders_Active() As Boolean
	Invaders_Active = si_active
End Function

Sub Invaders_Tick(delta As Single)
	If Not si_active Then Exit Sub
	si_tick = si_tick + delta
	If si_tick < 0.35 Then Exit Sub
	si_tick = 0
	Dim moved As Boolean
	moved = False
	Dim i As Integer
	For i = 0 To 4
		If si_alive(i) = 1 Then
			si_alx(i) = si_alx(i) + si_dir * 6
			moved = True
		End If
	Next i
	If moved Then
		If si_alx(0) < 10 Or si_alx(4) > 280 Then
			si_dir = -si_dir
			For i = 0 To 4
				si_aly(i) = si_aly(i) + 8
			Next i
		End If
	End If
	If si_bon Then
		si_by = si_by - 10
		If si_by < 0 Then si_bon = False
		Dim j As Integer
		For j = 0 To 4
			If si_alive(j) = 1 Then
				If Abs(si_bx - si_alx(j)) < 14 And Abs(si_by - si_aly(j)) < 10 Then
					si_alive(j) = 0
					si_bon = False
				End If
			End If
		Next j
	End If
	Dim left As Integer
	left = 0
	For i = 0 To 4
		If si_alive(i) = 1 Then left = left + 1
	Next i
	If left = 0 Then
		si_active = False
		Exit Sub
	End If
	For i = 0 To 4
		If si_alive(i) = 1 And si_aly(i) > 170 Then si_active = False
	Next i
	Call Invaders_Draw
End Sub

Sub Invaders_KeyLeft()
	If si_px > 4 Then si_px = si_px - 8
End Sub

Sub Invaders_KeyRight()
	If si_px < 300 Then si_px = si_px + 8
End Sub

Sub Invaders_Fire()
	If Not si_bon Then
		si_bon = True
		si_bx = si_px + 6
		si_by = 175
	End If
End Sub

Sub Invaders_Draw()
	Cls
	Dim i As Integer
	For i = 0 To 4
		If si_alive(i) = 1 Then
			Line (si_alx(i), si_aly(i))-(si_alx(i) + 20, si_aly(i) + 10), 2, BF
		End If
	Next i
	Line (si_px, 185)-(si_px + 12, 195), 15, BF
	If si_bon Then
		PSet (si_bx, si_by), 14
	End If
End Sub
