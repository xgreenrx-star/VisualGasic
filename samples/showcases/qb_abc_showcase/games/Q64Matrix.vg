' Matrix rain — inspired by TylerDarko QB64 sample (original VG, no alpha)
Option Explicit

Dim qx_active As Boolean
Dim qx_col(39) As Integer
Dim qx_len(39) As Integer
Dim qx_tick As Single

Sub Q64Matrix_Init()
	Screen 13
	Cls
	Palette 0, 0, 0, 0
	Palette 2, 0, 180, 0
	Palette 10, 0, 255, 40
	Palette 15, 200, 255, 200
	qx_active = True
	Dim i As Integer
	For i = 0 To 39
		qx_col(i) = Int(Rnd() * 200)
		qx_len(i) = 8 + Int(Rnd() * 18)
	Next i
	qx_tick = 0
End Sub

Function Q64Matrix_Active() As Boolean
	Q64Matrix_Active = qx_active
End Function

Sub Q64Matrix_GetHud(ByRef l1 As String, ByRef l2 As String)
	l1 = "Matrix effect (simplified)"
	l2 = "Green columns on SCREEN 13 — Esc = menu"
End Sub

Sub Q64Matrix_Tick(delta As Single)
	qx_tick = qx_tick + delta
	If qx_tick < 0.08 Then Exit Sub
	qx_tick = 0
	' Glyph cells, 8 pixels apart. A 2-pixel tick did not read as rain.
	Dim i As Integer
	For i = 0 To 39
		qx_col(i) = qx_col(i) + 8
		If qx_col(i) > 200 + qx_len(i) * 8 Then
			qx_col(i) = 0
			qx_len(i) = 8 + Int(Rnd() * 14)
		End If
		Dim j As Integer
		For j = 0 To qx_len(i)
			Dim yy As Integer
			yy = qx_col(i) - j * 8
			If yy >= 0 And yy < 192 Then
				Dim col As Integer
				If j = 0 Then col = 15 Else If j < 3 Then col = 10 Else col = 2
				PSet (i * 8 + 1, yy + 1), col
				PSet (i * 8 + 4, yy + 2), col
				PSet (i * 8 + 2, yy + 4), col
				PSet (i * 8 + 5, yy + 6), col
			End If
		Next j
		Dim tail As Integer
		tail = qx_col(i) - (qx_len(i) + 1) * 8
		If tail >= 0 And tail < 192 Then
			Line (i * 8, tail)-(i * 8 + 6, tail + 7), 0, BF
		End If
	Next i
End Sub
