' Relief 3D scroll — inspired by Danilin QB64 sample (original VG)
Option Explicit

Dim qr_active As Boolean
Dim qr_h(79) As Integer
Dim qr_off As Single
Dim qr_tick As Single

Sub Q64Relief_Init()
	Screen 13
	Cls
	qr_active = True
	qr_off = 0
	qr_tick = 0
	Dim i As Integer
	For i = 0 To 79
		qr_h(i) = 20 + Int(Rnd() * 60)
	Next i
	Call Q64Relief_Draw
End Sub

Function Q64Relief_Active() As Boolean
	Q64Relief_Active = qr_active
End Function

Sub Q64Relief_GetHud(ByRef l1 As String, ByRef l2 As String)
	l1 = "Relief 3D (isometric lines)"
	l2 = "Scrolling height field — Esc = menu"
End Sub

Sub Q64Relief_Tick(delta As Single)
	qr_tick = qr_tick + delta
	If qr_tick < 0.1 Then Exit Sub
	qr_tick = 0
	qr_off = qr_off + 1
	If qr_off >= 4 Then
		qr_off = 0
		Dim k As Integer
		For k = 0 To 78
			qr_h(k) = qr_h(k + 1)
		Next k
		qr_h(79) = 20 + Int(Rnd() * 60)
	End If
	Call Q64Relief_Draw
End Sub

Sub Q64Relief_Draw()
	' A height field drawn as stacked horizontal traces, back row first.
	' The old draw was one diagonal per row, which read as a sheared sheet.
	Cls
	Dim depth As Integer
	' Every other row and column. The full mesh was thousands of lines a frame.
	For depth = 0 To 48 Step 2
		Dim prevX As Integer
		Dim prevY As Integer
		prevX = -1
		Dim col As Integer
		For col = 0 To 79 Step 2
			Dim hi As Integer
			hi = qr_h((col + depth) Mod 80)
			Dim x As Integer
			Dim y As Integer
			x = 16 + col * 3 + depth \ 3
			y = 40 + depth * 3 - hi \ 2
			Dim shade As Integer
			If hi > 50 Then shade = 11 Else shade = 10
			If prevX >= 0 Then Line (prevX, prevY)-(x, y), shade
			prevX = x
			prevY = y
		Next col
	Next depth
End Sub
