' Relief 3D scroll — inspired by Danilin QB64 sample (original VG)
Option Explicit

Dim qr_active As Boolean
Dim qr_h(79) As Integer
Dim qr_off As Single
Dim qr_tick As Single

Sub Q64Relief_Init()
	Screen 13
	Cls
	qr_active = True
	qr_off = 0
	qr_tick = 0
	Dim i As Integer
	For i = 0 To 79
		qr_h(i) = 20 + Int(Rnd() * 60)
	Next i
	Call Q64Relief_Draw
End Sub

Function Q64Relief_Active() As Boolean
	Q64Relief_Active = qr_active
End Function

Sub Q64Relief_GetHud(ByRef l1 As String, ByRef l2 As String)
	l1 = "Relief 3D (isometric lines)"
	l2 = "Scrolling height field — Esc = menu"
End Sub

Sub Q64Relief_Tick(delta As Single)
	qr_tick = qr_tick + delta
	If qr_tick < 0.04 Then Exit Sub
	qr_tick = 0
	qr_off = qr_off + 1
	If qr_off >= 4 Then
		qr_off = 0
		Dim k As Integer
		For k = 0 To 78
			qr_h(k) = qr_h(k + 1)
		Next k
		qr_h(79) = 20 + Int(Rnd() * 60)
	End If
	Call Q64Relief_Draw
End Sub

Sub Q64Relief_Draw()
	Cls
	Dim row As Integer
	For row = 0 To 79
		Dim z As Integer
		z = row
		Dim h As Integer
		h = qr_h(row)
		Dim yb As Integer
		yb = 180 - z
		Dim x0 As Integer
		x0 = 160 - z \ 2
		Line (x0, yb)-(x0 + 40 + h, yb - h \ 2), 11
		Line (x0 + 40 + h, yb)-(x0 + 80 + h, yb - h \ 2), 10
	Next row
End Sub
