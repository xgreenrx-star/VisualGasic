Const MODE_BREAKOUT As Integer = 4
Const MODE_LANDER As Integer = 5
Const MODE_SOKOBAN As Integer = 6
Const MODE_NIBBLES As Integer = 7
Const MODE_INTRO As Integer = 8
Const MODE_ABOUT As Integer = 9
Const MODE_MENU_B As Integer = 10
Const MODE_MENU_C As Integer = 11
Const MODE_GORILLAS As Integer = 12
Const MODE_HAUNTED As Integer = 13
Const MODE_WUMPUS As Integer = 14
Const MODE_BLACKJACK As Integer = 15
Const MODE_MINES As Integer = 16
Const MODE_HANOI As Integer = 17
Const MODE_DUNGEON As Integer = 18
Const MODE_TREK_FULL As Integer = 19
Const MODE_JETPACK As Integer = 20
Const MODE_DEFENDER As Integer = 21
Const MODE_SOKOBAN_FULL As Integer = 22
Const MODE_NIBBLES_FULL As Integer = 23
Const MODE_MENU_Q As Integer = 24
Const MODE_TICTACTOE As Integer = 25
Const MODE_LIGHTSON As Integer = 26
Const MODE_LIFE As Integer = 27
Const MODE_Q64_SHOOTER As Integer = 28
Const MODE_Q64_PLATFORM As Integer = 29
Const MODE_Q64_QBRICKS As Integer = 30
Const MODE_Q64_PIPES As Integer = 31
Const MODE_Q64_FIRE As Integer = 32
Const MODE_Q64_MANDEL As Integer = 33
Const MODE_Q64_MATRIX As Integer = 34
Const MODE_Q64_PARTICLES As Integer = 35
Const MODE_Q64_RELIEF As Integer = 36
Const MODE_Q64_TORUS As Integer = 37
Const MODE_Q64_VFIELD As Integer = 38
Const MODE_Q64_TURTLE As Integer = 39
Const MODE_Q64_FLAG As Integer = 40
Const MODE_Q64_DIALOG As Integer = 41
Const MODE_MENU_QG As Integer = 42
Const MODE_MENU_QD As Integer = 43
Const MODE_MENU_QTOOLS As Integer = 44
Const MODE_MENU_QSKIP As Integer = 45

Dim curMode As Integer
Dim pendingMode As Integer
Dim menuReturn As Integer
Dim hud1 As String
Dim hud2 As String
Dim statusLine As String
Dim introTitle As String
Dim introCredit As String
Dim introCtrl1 As String
Dim introCtrl2 As String
Dim introSource As String
Dim introDisclaimer As String

Sub _Ready()
	Randomize
	curMode = MODE_MENU
	pendingMode = 0
	statusLine = "1-7 demos  B/C/Q tiers  8 = About"
	menuReturn = MODE_MENU
	QueueRedraw
End Sub

Sub _Draw()
	If curMode = MODE_MENU Then
		Call DrawMenu
	ElseIf curMode = MODE_MENU_B Then
		Call DrawMenuB
	ElseIf curMode = MODE_MENU_C Then
		Call DrawMenuC
	ElseIf curMode = MODE_MENU_Q Then
		Call DrawMenuQ
	ElseIf curMode = MODE_MENU_QG Then
		Call Q64_DrawMenuGames
	ElseIf curMode = MODE_MENU_QD Then
		Call Q64_DrawMenuDemos
	ElseIf curMode = MODE_MENU_QTOOLS Then
		Call Q64_DrawMenuTools
	ElseIf curMode = MODE_MENU_QSKIP Then
		Call Q64_DrawMenuSkipped
	ElseIf curMode = MODE_INTRO Then
		Call DrawIntro
	ElseIf curMode = MODE_ABOUT Then
		Call DrawAbout
	Else
		Call DrawHud
	End If
End Sub

Sub DrawMenu()
	Dim src As String
	Dim disc As String
	Call Meta_SourceNote(src)
	Call Meta_Disclaimer(disc)
	DrawRect 0, 0, 960, 600, Color8(12, 18, 32), True
	DrawString "Visual Gasic — QB ABC Showcase", 48, 36, Color8(120, 200, 255), 28
	DrawString "Classic-style games (simple demos + QB SCREEN layer)", 48, 72, Color8(200, 210, 220), 16
	DrawString "1  Bagels (Mastermind)     5  Lunar Lander", 48, 120, Color8(255, 255, 255), 16
	DrawString "2  Super Star Trek         6  Sokoban (mini)", 48, 148, Color8(255, 255, 255), 16
	DrawString "3  Space Invaders          7  Nibbles (snake)", 48, 176, Color8(255, 255, 255), 16
	DrawString "4  Breakout", 48, 204, Color8(255, 255, 255), 16
	DrawString "B  Tier B (7)   C  Tier C (5)   Q  QB64 gallery (games/demos/tools)", 48, 238, Color8(180, 220, 255), 15
	DrawString "8  About", 48, 262, Color8(180, 220, 255), 15
	DrawString statusLine, 48, 286, Color8(180, 220, 180), 14
	DrawString Left(src, 92), 48, 480, Color8(130, 140, 155), 11
	DrawString Left(disc, 92), 48, 498, Color8(130, 140, 155), 11
	DrawString "Tier lists: docs/showcase/QB_ABC_COMPLEX_CANDIDATES.md", 48, 524, Color8(110, 120, 135), 11
End Sub

