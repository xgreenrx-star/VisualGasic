' ============================================================================
' VG Beta Showcase — Squash the Creeps tease (20 seconds)
' Official Godot "Your First 3D Game" running from .vg with autopilot.
' carrier_embedded: skip ChangeScene when inside SubViewport (backrooms/carrier).
' ============================================================================

Const DemoDuration As Single = 20.0
Const SW As Single = 1280.0
Const SH As Single = 720.0

Dim t As Single
Dim is_headless As Boolean
Dim carrier_embedded As Boolean
Dim canvas As Object
Dim game_root As Object
Dim game_scene As Object
Dim reload_cooldown As Single

Sub _Ready()
	is_headless = DisplayServer.get_name() = "headless"
	carrier_embedded = (GetViewport().GetClass() = "SubViewport")
	Set game_scene = Load("res://squash_tease/game.tscn")
	Dim overlay As Object
	Set overlay = CreateNode("CanvasLayer")
	overlay.set("layer", 10)
	AddChild(overlay)
	Set canvas = CreateNode("VGVectorCanvas2D")
	overlay.AddChild(canvas)
	Call _SpawnGame()
	Set_Process(True)
End Sub

Sub _SpawnGame()
	If Not game_root Is Nothing Then
		game_root.queue_free()
	End If
	Set game_root = game_scene.instantiate()
	AddChild(game_root)
	reload_cooldown = 0.5
End Sub

Sub _Process(ByVal delta As Single)
	t = t + delta
	If reload_cooldown > 0.0 Then reload_cooldown = reload_cooldown - delta

	Dim player As Object = Nothing
	If Not game_root Is Nothing Then player = game_root.GetNode("Player")
	If player Is Nothing And reload_cooldown <= 0.0 Then Call _SpawnGame()

	canvas.Clear()
	Call _DrawOverlay()

	If t >= DemoDuration Then
		If is_headless Then
			GetTree().Quit()
		ElseIf Not carrier_embedded Then
			Call ChangeScene("res://dash_main.tscn")
		End If
	End If
End Sub

Sub _DrawOverlay()
	Call canvas.BeginGroup("Overlay")
	Call canvas.DrawRect(Rect2(0, 0, SW, 72), 0, Color(0, 0, 0, 0), True, Color(0, 0, 0, 0.55))
	Call canvas.DrawVectorText(Vector2(16, 18), "GODOT FIRST 3D GAME", Color(1.0, 0.85, 0.2, 0.95), 1.5, 1.3, "left", 2.0, "")
	Call canvas.DrawVectorText(Vector2(16, 44), "WRITTEN IN VISUAL GASIC (.VG)", Color(0.5, 1.0, 1.0, 0.9), 1.2, 1.0, "left", 1.6, "")
	Dim remain As Single = DemoDuration - t
	If remain < 0.0 Then remain = 0.0
	Call canvas.DrawVectorTextRightAligned(Vector2(SW - 16, 22), Str(Int(remain + 0.5)) & "S", Color(1, 1, 1, 0.8), 1.4, 1.2, 1.6, "")
	Call canvas.DrawVectorTextCentered(Vector2(SW * 0.5, SH - 28), "CHARACTERBODY3D  MOVEANDSLIDE  STOMP PHYSICS  SPACE SKIP", Color(1, 1, 1, 0.45), 1.0, 0.9, 1.3, "")
	Call canvas.EndGroup()
End Sub

Sub _UnhandledInput(ByVal Event As Object)
	If Event Is InputEventKey Then
		If Event.Pressed And Event.Keycode = KEY_ESCAPE Then GetTree().Quit()
		If Event.Pressed And (Event.Keycode = KEY_SPACE Or Event.Keycode = KEY_ENTER) Then
			If Not carrier_embedded Then Call ChangeScene("res://dash_main.tscn")
		End If
	End If
End Sub
