' ============================================================================
' SCORE LABEL - Score Counter for Squash the Creeps 3D
' Converted from the official Godot demo: godotengine/godot-demo-projects
' ============================================================================
' Attached to the ScoreLabel (Label) node in the UserInterface.
' Tracks and displays the player's score.
'
' Original GDScript: extends Label
' ============================================================================
Attribute VB_Name = "ScoreLabel"

Dim score As Integer

' ============================================================================
' INITIALIZATION
' ============================================================================
Sub _Ready()
    score = 0
    Me.text = "Score: 0"
End Sub

' ============================================================================
' ADD SCORE - Called by the player when a mob is squashed
' ============================================================================
Sub AddScore()
    score = score + 1
    Me.text = "Score: " & CStr(score)
End Sub
