; Engine configuration file.
config_version=5

[application]

config/name="VG Narcea Movie Demo"
config/description="Scripted Narcea × Cursor movie — fake AI Pair UI, real generated apps in preview."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

VGDebugHandler="*res://addons/visual_gasic/vg_debug_handler.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[audio]

driver/mix_rate=48000

[editor]

movie_writer/mix_rate=48000
movie_writer/movie_file="res://vg_narcea_movie.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_gasic/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
