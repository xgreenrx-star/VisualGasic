' ============================================================================
' PONG - Classic Two-Player Pong Game
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' Controls:
'   Player 1 (Left):  W = Up, S = Down
'   Player 2 (Right): Up Arrow = Up, Down Arrow = Down
' ============================================================================
' Attribute VB_Name is a VB6-era module-level attribute that names this code module.
' In VisualGasic, it tags the script so the Godot runtime can identify it. Think of
' it like "class_name" in GDScript — it registers the script's identity.
Attribute VB_Name = "PongGame"

' --- GAME CONSTANTS -----------------------------------------------------------
' "Const" is VB6 syntax for compile-time constants (like GDScript's "const").
' "As Integer" / "As Single" are VB6-style type annotations.
' Integer = whole numbers; Single = 32-bit float (equivalent to GDScript "float").
Const SCREEN_WIDTH As Integer = 800          ' Viewport width in pixels
Const SCREEN_HEIGHT As Integer = 600         ' Viewport height in pixels
Const PADDLE_WIDTH As Integer = 15            ' Paddle thickness (X-axis)
Const PADDLE_HEIGHT As Integer = 80           ' Paddle height (Y-axis)
Const BALL_SIZE As Integer = 15               ' Ball is drawn as a square of this side length
Const PADDLE_SPEED As Single = 400.0          ' Pixels per second each paddle can move
Const BALL_SPEED_INITIAL As Single = 300.0    ' Starting ball speed in pixels/sec (magnitude of velocity vector)
Const BALL_SPEED_INCREMENT As Single = 25.0   ' Speed boost added on every paddle hit — makes rallies harder
Const WIN_SCORE As Integer = 11               ' First player to this score wins the match

' --- BALL STATE ---------------------------------------------------------------
' "Dim" is the VB6 keyword for declaring variables (like GDScript's "var").
' Module-level Dim = class-level instance variable, accessible from any Sub.
' "As Single" = 32-bit float — needed for smooth sub-pixel movement.
Dim ballX As Single       ' Ball's top-left X coordinate (world pixels)
Dim ballY As Single       ' Ball's top-left Y coordinate (world pixels)
Dim ballVelX As Single    ' Horizontal velocity component (pixels/sec, negative = moving left)
Dim ballVelY As Single    ' Vertical velocity component (pixels/sec, negative = moving up)
Dim ballSpeed As Single   ' Scalar speed (magnitude); increases each rally hit

' --- PADDLE POSITIONS ---------------------------------------------------------
' Only the Y-coordinate is stored because each paddle's X is fixed:
'   Paddle 1 (left)  is always at X = 30
'   Paddle 2 (right) is always at X = SCREEN_WIDTH - 30 - PADDLE_WIDTH
' This is a common Pong simplification — paddles only slide vertically.
Dim paddle1Y As Single    ' Top edge Y of the left paddle
Dim paddle2Y As Single    ' Top edge Y of the right paddle

' --- SCORES -------------------------------------------------------------------
' Integer scores for each player. In VB6/VisualGasic, Integer is a whole number
' type (maps to Godot's int). Scores are checked against WIN_SCORE each frame.
Dim score1 As Integer     ' Player 1 (left paddle) current score
Dim score2 As Integer     ' Player 2 (right paddle) current score

' --- GAME STATE FLAGS ---------------------------------------------------------
' Boolean = True/False (VB6 type, same as GDScript's bool).
' String   = text (like GDScript's String). These drive the state machine:
'   Title → Playing → Paused (toggle) → Playing → Game Over → restart cycle.
Dim gameOver As Boolean   ' True once a player reaches WIN_SCORE
Dim winner As String      ' "Player 1" or "Player 2" — shown on the game-over screen
Dim paused As Boolean     ' True while the game is paused (ESC / ui_cancel)

' ============================================================================
' INITIALIZATION
' ============================================================================
' _Ready() is a Godot lifecycle callback. In GDScript you'd write "func _ready():"
' VisualGasic uses VB6-style "Sub" with the Godot underscore prefix convention.
' It fires once when the node enters the scene tree — perfect for setup code.
' "Print" outputs to Godot's Output panel (like GDScript's print()).
' "&" is VB6 string concatenation; Str() converts a number to a String.
Sub _Ready()
    Print "=== PONG ==="
    Print "Player 1: W/S keys"
    Print "Player 2: Arrow keys"
    Print "First to " & Str(WIN_SCORE) & " wins!"  ' Str() = VB6 number-to-string (like str() in GDScript)
    Print ""
    
    ResetGame  ' VB6 allows calling Subs without parentheses when there are no args
End Sub

' ResetGame — called on first load and when restarting after a game-over.
' Zeros all state, then delegates ball and paddle placement to helper Subs.
Sub ResetGame()
    score1 = 0
    score2 = 0
    gameOver = False
    winner = ""
    paused = False
    
    ' In VB6 style, a Sub with one arg can be called without parentheses.
    ' "0" means serve direction is random (see ResetBall for the logic).
    ResetBall 0  ' Serve to random direction
    ResetPaddles
End Sub

' ResetBall — places the ball at center-screen and gives it an initial velocity.
' serveDirection: -1 = serve left, 1 = serve right, 0 = pick randomly.
' VB6 parameter syntax: "paramName As Type".
Sub ResetBall(serveDirection As Integer)
    ' Center the ball on screen
    ballX = SCREEN_WIDTH / 2
    ballY = SCREEN_HEIGHT / 2
    ballSpeed = BALL_SPEED_INITIAL    ' Reset to base speed (it ramps up during play)
    
    ' Pick a random launch angle so the ball doesn't always go perfectly horizontal.
    ' Rnd() returns a random Single between 0.0 and 1.0 — classic VB6 function.
    ' Subtracting 0.5 centers the range around zero, then *1.2 scales to ±0.6 rad (~±34°).
    Dim angle As Single
    angle = (Rnd() - 0.5) * 1.2  ' -0.6 to 0.6 radians
    
    ' Decide horizontal serve direction
    ' If caller passed 0, flip a coin; otherwise use the explicit direction.
    ' After a goal, the ball is served toward the player who just scored.
    If serveDirection = 0 Then
        If Rnd() > 0.5 Then
            serveDirection = 1        ' Serve right
        Else
            serveDirection = -1       ' Serve left
        End If
    End If
    
    ' Decompose speed into X and Y components using trig:
    '   velX = cos(angle) * speed → horizontal component
    '   velY = sin(angle) * speed → vertical component
    ' Multiplying velX by serveDirection flips the horizontal direction.
    ' Cos() and Sin() are VB6 math built-ins (same as GDScript's cos/sin).
    ballVelX = Cos(angle) * ballSpeed * serveDirection
    ballVelY = Sin(angle) * ballSpeed
End Sub

' ResetPaddles — vertically center both paddles on the screen.
' Formula: (totalHeight - paddleHeight) / 2 puts the paddle's top edge
' so that its center aligns with the screen's vertical midpoint.
Sub ResetPaddles()
    paddle1Y = (SCREEN_HEIGHT - PADDLE_HEIGHT) / 2  ' Left paddle to center
    paddle2Y = (SCREEN_HEIGHT - PADDLE_HEIGHT) / 2  ' Right paddle to center
End Sub

' ============================================================================
' GAME LOOP
' ============================================================================
' _Process(delta) is the Godot per-frame callback (GDScript: "func _process(delta):").
' "delta" is the elapsed time in seconds since the last frame (~0.016 at 60 FPS).
' Multiplying movement by delta makes the game frame-rate independent.
'
' This Sub implements a simple state machine:
'   1. gameOver = True  → wait for ENTER to restart
'   2. paused   = True  → wait for ENTER to unpause
'   3. Otherwise        → run the simulation (paddles, ball, collisions, scoring)
' "Return" exits the Sub early — same as VB6's "Exit Sub" (both work in VisualGasic).
Sub _Process(delta As Single)
    ' --- STATE: GAME OVER -------------------------------------------------
    If gameOver Then
        ' Input.IsActionJustPressed() checks Godot's Input Map for a one-shot press.
        ' "ui_accept" is Godot's built-in action mapped to Enter/Space by default.
        If Input.IsActionJustPressed("ui_accept") Then
            ResetGame
        End If
        Return   ' Skip all gameplay logic while on the game-over screen
    End If
    
    ' --- STATE: PAUSED -----------------------------------------------------
    If paused Then
        If Input.IsActionJustPressed("ui_accept") Then
            paused = False
        End If
        Return   ' Freeze gameplay while paused
    End If
    
    ' --- TOGGLE PAUSE (ESC) ------------------------------------------------
    ' "ui_cancel" is mapped to Escape by default in Godot's Input Map.
    If Input.IsActionJustPressed("ui_cancel") Then
        paused = True
        Return
    End If
    
    ' --- STATE: PLAYING — run the four simulation steps each frame ---------
    UpdatePaddles delta      ' Move paddles based on player input
    UpdateBall delta         ' Advance ball position by velocity * delta
    CheckCollisions          ' Test ball vs. paddles, calculate bounce angles
    CheckScore               ' See if the ball left the screen (goal scored)
End Sub

' UpdatePaddles — reads held-key input and moves paddles vertically.
' Input.IsActionPressed() returns True every frame the key is held
' (unlike IsActionJustPressed which fires only on the initial press).
' These action names ("player1_up", etc.) must be defined in the Godot
' Project → Input Map, or via VisualGasic's input configuration.
Sub UpdatePaddles(delta As Single)
    ' Player 1 controls (W/S)
    ' Subtracting moves UP because Godot's Y-axis points downward.
    If Input.IsActionPressed("player1_up") Then
        paddle1Y = paddle1Y - PADDLE_SPEED * delta   ' Move up (negative Y)
    End If
    If Input.IsActionPressed("player1_down") Then
        paddle1Y = paddle1Y + PADDLE_SPEED * delta   ' Move down (positive Y)
    End If
    
    ' Player 2 controls (Arrow keys) — same logic, different input actions
    If Input.IsActionPressed("player2_up") Then
        paddle2Y = paddle2Y - PADDLE_SPEED * delta
    End If
    If Input.IsActionPressed("player2_down") Then
        paddle2Y = paddle2Y + PADDLE_SPEED * delta
    End If
    
    ' Clamp paddles so they can't leave the visible screen area.
    ' Clamp(value, min, max) is a VisualGasic built-in (like GDScript's clampf).
    ' Min = 0 (top edge), Max = SCREEN_HEIGHT - PADDLE_HEIGHT (bottom edge
    ' so the full paddle is still visible).
    paddle1Y = Clamp(paddle1Y, 0, SCREEN_HEIGHT - PADDLE_HEIGHT)
    paddle2Y = Clamp(paddle2Y, 0, SCREEN_HEIGHT - PADDLE_HEIGHT)
End Sub

' UpdateBall — simple Euler integration: position += velocity * delta.
' This is the most basic physics step; no acceleration/gravity needed for Pong.
Sub UpdateBall(delta As Single)
    ' Euler integration: new_pos = old_pos + velocity * time_step
    ballX = ballX + ballVelX * delta
    ballY = ballY + ballVelY * delta
    
    ' --- WALL BOUNCE (top & bottom) ----------------------------------------
    ' If the ball crosses the top edge (Y <= 0), snap it to Y = 0 and
    ' force velY positive (downward) using Abs() — a VB6 math built-in.
    ' Similarly for the bottom edge.  "ElseIf" is VB6 syntax for else-if.
    If ballY <= 0 Then
        ballY = 0                       ' Snap to top edge
        ballVelY = Abs(ballVelY)        ' Ensure moving downward (+Y)
    ElseIf ballY >= SCREEN_HEIGHT - BALL_SIZE Then
        ballY = SCREEN_HEIGHT - BALL_SIZE   ' Snap to bottom edge
        ballVelY = -Abs(ballVelY)           ' Ensure moving upward (-Y)
    End If
End Sub

' CheckCollisions — AABB (Axis-Aligned Bounding Box) collision between the ball
' and each paddle. On a hit, the bounce angle depends on WHERE the ball struck
' the paddle face — hitting the edge sends the ball at a steep angle, hitting
' the center sends it nearly horizontal.  This is the classic Pong mechanic.
Sub CheckCollisions()
    ' Fixed X positions for each paddle (must match _Draw coordinates)
    Dim paddleLeft As Single = 30                              ' Left paddle X
    Dim paddleRight As Single = SCREEN_WIDTH - 30 - PADDLE_WIDTH  ' Right paddle X
    
    ' --- BALL vs PADDLE 1 (left) -------------------------------------------
    ' Check if the ball's left edge has reached the right face of paddle 1.
    If ballX <= paddleLeft + PADDLE_WIDTH Then
        ' Vertical overlap test: ball bottom >= paddle top AND ball top <= paddle bottom
        If ballY + BALL_SIZE >= paddle1Y And ballY <= paddle1Y + PADDLE_HEIGHT Then
            ' --- HIT POSITION & ANGLE CALCULATION ---
            ' hitPos: where on the paddle face the ball center struck.
            '   (ballY + BALL_SIZE/2) = ball center Y
            '   Subtract paddle1Y   = offset from paddle top
            '   Divide by PADDLE_HEIGHT = normalize to 0..1 range
            '     0.0 = top edge, 0.5 = dead center, 1.0 = bottom edge
            Dim hitPos As Single
            hitPos = (ballY + BALL_SIZE/2 - paddle1Y) / PADDLE_HEIGHT  ' 0 to 1
            ' Map 0..1 → -0.7..+0.7 radians (~±40°). Subtracting 0.5 centers
            ' the range; multiplying by 1.4 controls the max deflection angle.
            Dim angle As Single
            angle = (hitPos - 0.5) * 1.4  ' -0.7 to 0.7 radians
            
            ' Ramp up ball speed to make rallies progressively harder
            ballSpeed = ballSpeed + BALL_SPEED_INCREMENT
            
            ' Recompute velocity from angle and speed.
            ' Cos(angle) is always positive → ball moves RIGHT (away from paddle 1).
            ballVelX = Cos(angle) * ballSpeed
            ballVelY = Sin(angle) * ballSpeed
            ' Nudge ball just past the paddle to prevent re-triggering next frame
            ballX = paddleLeft + PADDLE_WIDTH + 1
            
            Print "Player 1 returns!"
        End If
    End If
    
    ' --- BALL vs PADDLE 2 (right) ------------------------------------------
    ' Check if the ball's right edge has reached the left face of paddle 2.
    If ballX + BALL_SIZE >= paddleRight Then
        If ballY + BALL_SIZE >= paddle2Y And ballY <= paddle2Y + PADDLE_HEIGHT Then
            ' Same hit-position / angle math as paddle 1
            Dim hitPos2 As Single
            hitPos2 = (ballY + BALL_SIZE/2 - paddle2Y) / PADDLE_HEIGHT
            Dim angle2 As Single
            angle2 = (hitPos2 - 0.5) * 1.4
            
            ballSpeed = ballSpeed + BALL_SPEED_INCREMENT
            
            ' Note the NEGATIVE Cos — sends the ball LEFT (away from paddle 2)
            ballVelX = -Cos(angle2) * ballSpeed
            ballVelY = Sin(angle2) * ballSpeed
            ' Nudge ball left to avoid re-collision
            ballX = paddleRight - BALL_SIZE - 1
            
            Print "Player 2 returns!"
        End If
    End If
End Sub

' CheckScore — detects when the ball has fully left the screen on either side.
' A goal is detected when the ball moves past the screen edge by its full size
' (so it's completely off-screen, not just partially). After scoring, the ball
' is re-served toward the player who scored (traditional Pong courtesy serve).
Sub CheckScore()
    ' Ball exited LEFT edge → Player 2 scores
    If ballX < -BALL_SIZE Then
        score2 = score2 + 1
        Print "SCORE! Player 2: " & Str(score2)  ' "&" = VB6 string concatenation
        
        ' Check for match win
        If score2 >= WIN_SCORE Then
            gameOver = True              ' Triggers the game-over state in _Process
            winner = "Player 2"          ' Displayed on-screen in _Draw
            Print "=== PLAYER 2 WINS! ==="
        Else
            ResetBall 1   ' Serve right — ball goes toward Player 2 (the scorer)
        End If
    End If
    
    ' Ball exited RIGHT edge → Player 1 scores
    If ballX > SCREEN_WIDTH Then
        score1 = score1 + 1
        Print "SCORE! Player 1: " & Str(score1)
        
        If score1 >= WIN_SCORE Then
            gameOver = True
            winner = "Player 1"
            Print "=== PLAYER 1 WINS! ==="
        Else
            ResetBall -1  ' Serve left — ball goes toward Player 1 (the scorer)
        End If
    End If
End Sub

' ============================================================================
' RENDERING
' ============================================================================
' _Draw() is a Godot lifecycle callback (GDScript: "func _draw():").
' It's called every frame AFTER _Process. All custom drawing must happen here.
' VisualGasic provides DrawRect, DrawCircle, DrawString, DrawLine as wrappers
' around Godot's CanvasItem draw_* methods.
'
' Color.Black, Color.White, Color.Gray, Color.Yellow are built-in named colors.
' You can also use Color("#RRGGBB") or Color(r, g, b, a) constructors.
Sub _Draw()
    ' Re-declare fixed paddle X positions (must match CheckCollisions values)
    Dim paddleLeft As Single = 30
    Dim paddleRight As Single = SCREEN_WIDTH - 30 - PADDLE_WIDTH
    
    ' --- BACKGROUND --------------------------------------------------------
    ' DrawRect(x, y, width, height, color) fills a rectangle.
    ' Drawing a full-screen black rect effectively clears the frame.
    DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color.Black
    
    ' --- CENTER COURT LINE (dashed) ----------------------------------------
    ' VB6-style For loop: "For var = start To end Step increment".
    ' Draws a series of small 4×15 px rectangles down the center to simulate
    ' a dashed line, just like the original 1972 Pong.
    Dim i As Integer
    For i = 0 To SCREEN_HEIGHT Step 30
        DrawRect SCREEN_WIDTH/2 - 2, i, 4, 15, Color.Gray
    Next  ' "Next" closes the For loop (VB6 syntax; you can also write "Next i")
    
    ' --- PADDLES -----------------------------------------------------------
    DrawRect paddleLeft, paddle1Y, PADDLE_WIDTH, PADDLE_HEIGHT, Color.White   ' Left paddle
    DrawRect paddleRight, paddle2Y, PADDLE_WIDTH, PADDLE_HEIGHT, Color.White  ' Right paddle
    
    ' --- BALL --------------------------------------------------------------
    ' The ball is a simple filled square (not a circle) for retro aesthetics.
    DrawRect ballX, ballY, BALL_SIZE, BALL_SIZE, Color.White
    
    ' --- SCORE DISPLAY -----------------------------------------------------
    ' DrawString(text, x, y, color) renders text at the given screen position.
    ' Str() converts Integer to String — required because DrawString expects a String.
    ' Scores are positioned at 1/4 and 3/4 screen width for symmetry.
    DrawString Str(score1), SCREEN_WIDTH/4, 30, Color.White       ' P1 score (left)
    DrawString Str(score2), 3 * SCREEN_WIDTH/4, 30, Color.White   ' P2 score (right)
    
    ' --- STATE OVERLAYS (drawn on top of everything) -----------------------
    ' These messages only appear when the game is in a non-playing state.
    ' Color.Yellow for emphasis, Color.Gray for secondary/instructional text.
    If gameOver Then
        DrawString winner & " WINS!", SCREEN_WIDTH/2 - 80, SCREEN_HEIGHT/2 - 20, Color.Yellow
        DrawString "Press ENTER to restart", SCREEN_WIDTH/2 - 100, SCREEN_HEIGHT/2 + 20, Color.Gray
    ElseIf paused Then
        DrawString "PAUSED", SCREEN_WIDTH/2 - 40, SCREEN_HEIGHT/2, Color.Yellow
        DrawString "Press ENTER to continue", SCREEN_WIDTH/2 - 100, SCREEN_HEIGHT/2 + 30, Color.Gray
    End If
End Sub
