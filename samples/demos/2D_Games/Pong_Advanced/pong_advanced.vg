' ============================================================================
' PONG ADVANCED - Reactive Programming with Whenever
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' This demo showcases the Whenever system for reactive game programming.
' Instead of checking conditions every frame, we declare reactive rules
' that automatically trigger when conditions are met.
' ============================================================================
Attribute VB_Name = "PongAdvanced"

' Game constants — VB6-style Const declarations with explicit types.
' These define the playfield dimensions, paddle/ball sizing, and win condition.
Const SCREEN_WIDTH As Integer = 800       ' Playfield width in pixels
Const SCREEN_HEIGHT As Integer = 600      ' Playfield height in pixels
Const PADDLE_WIDTH As Integer = 15        ' Width of each paddle (thin rectangle)
Const PADDLE_HEIGHT As Integer = 80       ' Height of each paddle (tall rectangle)
Const BALL_SIZE As Integer = 15           ' Ball rendered as a square of this side length
Const PADDLE_SPEED As Single = 400.0      ' Pixels per second the paddles move
Const WIN_SCORE As Integer = 5            ' First to this many points wins the match

' Ball state — position, velocity vector, and current scalar speed.
' ballVelX/ballVelY are the actual per-frame velocity components.
' ballSpeed is the scalar magnitude used when recalculating direction after hits.
Dim ballX As Single       ' Ball's X position (left edge of ball square)
Dim ballY As Single       ' Ball's Y position (top edge of ball square)
Dim ballVelX As Single    ' Horizontal velocity in pixels/sec (negative = moving left)
Dim ballVelY As Single    ' Vertical velocity in pixels/sec (negative = moving up)
Dim ballSpeed As Single   ' Scalar speed magnitude — increases each rally hit

' Paddle positions — only Y coordinates because X positions are fixed (left/right edges).
Dim paddle1Y As Single   ' Player 1 (left) paddle's top-edge Y position
Dim paddle2Y As Single   ' Player 2 (right) paddle's top-edge Y position

' Score counters — IMPORTANT: These are monitored by Whenever Sections!
' Whenever score1 or score2 changes, reactive callbacks fire automatically.
' This is the core of VisualGasic's reactive programming model.
Dim score1 As Integer    ' Player 1 (left) score — monitored by Player1Scores/Player1Wins
Dim score2 As Integer    ' Player 2 (right) score — monitored by Player2Scores/Player2Wins

' Game state — gameState is also monitored by a Whenever Section.
' When gameState changes, the OnGameStateChange callback suspends/resumes
' other Whenever Sections to prevent scoring during pause or gameover.
Dim gameState As String  ' Current state: "playing", "paused", or "gameover"
Dim winner As String     ' Name of the winning player, set on game over
Dim comboHits As Integer ' Consecutive rally hits within 2 seconds — monitored by ComboBonus/SuperCombo
Dim lastHitTime As Single ' Seconds since last paddle hit — used to detect rapid rallies

' Visual effects — juice/feedback variables for screen shake, flash, and combo HUD.
Dim screenShakeAmount As Single ' Current shake intensity; decays by 0.9x each frame in UpdateEffects
Dim flashColor As Variant       ' Color flash overlay after scoring (Variant holds Color or Nothing)
Dim showComboText As Boolean    ' Whether to display the "COMBO x#" text on screen
Dim comboTextTimer As Single    ' Countdown in seconds before hiding the combo text

' Power-ups — spawned on SuperCombo, definitions loaded from DATA statements at startup.
' Only one power-up can be on-screen at a time.
Dim powerUpActive As Boolean   ' True when a power-up is visible on the field
Dim powerUpType As String      ' Current power-up name: "SPEED", "SLOW", "BIG", "MULTI", or "SHIELD"
Dim powerUpX As Single         ' Power-up X position (always screen center)
Dim powerUpY As Single         ' Power-up Y position (random vertical placement)
Dim powerUpTimer As Single     ' Countdown in seconds before the power-up despawns

' AI player — controls the right paddle (Player 2) when enabled.
' Uses predictive tracking with intentional imperfection for fair gameplay.
Dim aiEnabled As Boolean        ' True = Player 2 is computer-controlled
Dim aiSpeed As Single           ' AI paddle movement speed in pixels/sec (slightly less than player)
Dim aiReactionDelay As Single   ' Reserved for future reaction-time simulation
Dim aiTargetY As Single         ' Y position the AI is currently steering toward
Dim aiToggleDown As Boolean     ' Debounce flag to prevent rapid AI on/off toggling

' ============================================================================
' WHENEVER SECTIONS - Reactive Game Logic
' ============================================================================
' These sections automatically trigger when conditions are met.
' No need to check every frame - VisualGasic monitors for you!

' --- Score Monitoring ---
' "Changes" condition: fires every time the monitored variable's value changes.
' When score1 changes, OnPlayer1Score() is called. Same for score2.
' These react to any assignment to score1/score2 — you never poll for score changes.
Whenever Section Player1Scores score1 Changes OnPlayer1Score
Whenever Section Player2Scores score2 Changes OnPlayer2Score

' --- Win Conditions ---
' "Becomes" condition: fires only when the variable transitions TO the specified value.
' Unlike "Changes" (which fires on any change), "Becomes" fires exactly once —
' when score1 first equals WIN_SCORE (5). This prevents repeated triggering.
Whenever Section Player1Wins score1 Becomes WIN_SCORE DeclareWinner1
Whenever Section Player2Wins score2 Becomes WIN_SCORE DeclareWinner2

' --- Combo System ---
' "Exceeds" condition: fires when the variable crosses above the threshold.
' ComboBonus fires when comboHits goes from 3 -> 4 (first crossing of 3).
' SuperCombo fires when comboHits goes from 7 -> 8.
' comboHits resets each serve, so these can re-trigger in later rallies.
Whenever Section ComboBonus comboHits Exceeds 3 ActivateComboBonus
Whenever Section SuperCombo comboHits Exceeds 7 ActivateSuperCombo

' --- Game State Transitions ---
' Monitors the gameState String variable. Fires on any change to/from
' "playing", "paused", or "gameover". The callback uses Select Case to
' Suspend/Resume other Whenever Sections based on the new state.
Whenever Section GameStateChanged gameState Changes OnGameStateChange

' --- Ball Speed Escalation ---
' ballSpeed increases +15 on every paddle hit. These Whenever Sections
' provide automatic guardrails:
' SpeedWarning: flashes yellow when speed crosses 600 px/sec.
' MaxSpeed: hard-caps speed at 800 px/sec to keep the game playable.
Whenever Section SpeedWarning ballSpeed Exceeds 600 ShowSpeedWarning
Whenever Section MaxSpeed ballSpeed Exceeds 800 CapBallSpeed

' --- Match Point Detection ---
' Uses a compound Boolean expression as the Whenever condition.
' Fires when either player reaches WIN_SCORE - 1 (i.e., 4 points).
' This triggers a "MATCH POINT!" announcement and subtle screen shake.
Whenever Section CloseGame (score1 >= WIN_SCORE - 1 Or score2 >= WIN_SCORE - 1) ShowMatchPoint

' ============================================================================
' WHENEVER CALLBACKS
' ============================================================================

' Called reactively when score1 changes. Provides visual/audio feedback
' and resets the ball, serving toward Player 2 (direction = 1 = rightward).
Sub OnPlayer1Score()
	Print "Player 1 scores! Total: " & Str(score1)  ' Str() converts Integer to String — VB6 idiom
	TriggerScreenShake 5.0              ' Moderate shake on score
	flashColor = Color("#00FF00")       ' Green flash for Player 1's color
	PlayScoreSound                      ' Placeholder sound effect
	ResetBall 1                         ' Serve ball to the right (toward Player 2)
End Sub

' Called reactively when score2 changes. Red flash for Player 2's color.
' Serves ball to the left (direction = -1) toward Player 1.
Sub OnPlayer2Score()
	Print "Player 2 scores! Total: " & Str(score2)
	TriggerScreenShake 5.0              ' Same shake intensity as Player 1's goal
	flashColor = Color("#FF0000")       ' Red flash for Player 2's color
	PlayScoreSound
	ResetBall -1                        ' Serve ball to the left (toward Player 1)
End Sub

' Called by Whenever Section Player1Wins when score1 Becomes WIN_SCORE.
' Setting gameState to "gameover" triggers the GameStateChanged Whenever Section,
' which in turn handles the gameover overlay logic.
Sub DeclareWinner1()
	winner = "Player 1"
	gameState = "gameover"             ' This assignment triggers OnGameStateChange()
	Print "=== PLAYER 1 WINS! ==="
End Sub

' Mirror of DeclareWinner1 for Player 2.
Sub DeclareWinner2()
	winner = "Player 2"
	gameState = "gameover"             ' This assignment triggers OnGameStateChange()
	Print "=== PLAYER 2 WINS! ==="
End Sub

' Triggered when comboHits Exceeds 3 — rewards sustained rallies.
' Speeds up the ball by 10% and shows "COMBO" text for 2 seconds.
Sub ActivateComboBonus()
	Print "COMBO x" & Str(comboHits) & "!"  ' & is VB6 string concatenation operator
	showComboText = True
	comboTextTimer = 2.0          ' Display combo text for 2 seconds
	ballSpeed = ballSpeed * 1.1   ' 10% speed boost as rally reward
	TriggerScreenShake 3.0        ' Light shake for combo feedback
End Sub

' Triggered when comboHits Exceeds 7 — an epic rally!
' Spawns a power-up on the field and creates a big screen shake.
Sub ActivateSuperCombo()
	Print "SUPER COMBO! x" & Str(comboHits)
	showComboText = True
	comboTextTimer = 3.0          ' Longer display for super combo (3 seconds)
	SpawnPowerUp                  ' Reward: place a collectible power-up on-screen
	TriggerScreenShake 8.0        ' Heavy shake — the screen really rumbles
End Sub

' Reactive callback for gameState changes. Uses Select Case (VB6's switch statement)
' combined with Suspend/Resume Whenever — a VisualGasic-specific feature that
' enables or disables individual Whenever Sections at runtime.
' This prevents scoring while the game is paused or over.
Sub OnGameStateChange()
	Print "Game state changed to: " & gameState
	
	Select Case gameState                       ' VB6-style switch statement
		Case "playing"
			Resume Whenever Player1Scores       ' Re-enable score monitoring
			Resume Whenever Player2Scores
		Case "paused"
			Suspend Whenever Player1Scores      ' Disable score monitoring while paused
			Suspend Whenever Player2Scores
		Case "gameover"
			' Play victory fanfare
			Print "Game Over! Winner: " & winner
	End Select
End Sub

' Triggered when ballSpeed Exceeds 600 — visual warning via yellow flash.
Sub ShowSpeedWarning()
	Print "WARNING: Ball speed increasing!"
	flashColor = Color("#FFFF00")  ' Yellow flash to warn players the pace is intensifying
End Sub

' Triggered when ballSpeed Exceeds 800 — hard cap to keep the game playable.
' Without this, the ball could become impossibly fast after many rally hits.
Sub CapBallSpeed()
	ballSpeed = 800
	Print "Maximum ball speed reached!"
End Sub

' Triggered when either player is one point from winning.
' Adds dramatic tension with a screen shake and console message.
Sub ShowMatchPoint()
	Print "MATCH POINT!"
	TriggerScreenShake 2.0    ' Subtle shake to build suspense
End Sub

' ============================================================================
' INITIALIZATION
' ============================================================================
' _Ready() is a Godot lifecycle callback — called once when this node enters the scene tree.
' VisualGasic maps it as a Sub so it integrates with Godot's node system.
' Here we print help text to the output console, load DATA tables, and start the game.
Sub _Ready()
	Print "=== PONG ADVANCED ==="
	Print "Demonstrating the Whenever System"
	Print ""
	Print "Controls:"
	Print "  Player 1: W/S keys"
	Print "  Player 2: Arrow keys (or AI)"
	Print "  Press 2 to toggle AI opponent"
	Print ""
	Print "Features:"
	Print "- Reactive score tracking"
	Print "- Automatic win detection"
	Print "- Combo system with thresholds"
	Print "- Dynamic speed escalation"
	Print ""
	
	LoadPowerUpData    ' Read power-up definitions from DATA statements (classic BASIC pattern)
	StartNewGame       ' Initialize all game state and serve the ball
End Sub

' Initialize/reset all game variables for a fresh match.
' Note: setting gameState = "playing" triggers OnGameStateChange(),
' which resumes the score-monitoring Whenever Sections.
Sub StartNewGame()
	score1 = 0                        ' Reset scores (triggers Whenever Changes callbacks)
	score2 = 0
	comboHits = 0                     ' Reset rally combo counter
	winner = ""
	gameState = "playing"             ' Triggers OnGameStateChange -> resumes Whenever Sections
	ballSpeed = 300.0                 ' Starting ball speed in pixels/sec
	powerUpActive = False             ' No power-ups at game start
	aiSpeed = 350.0                   ' AI moves at 350 px/sec (slightly slower than player's 400)
	aiReactionDelay = 0.08            ' Reserved for future AI difficulty tuning
	aiTargetY = SCREEN_HEIGHT / 2     ' AI starts aiming at screen center
	
	ResetBall 0      ' 0 = random serve direction (coin flip)
	ResetPaddles     ' Center both paddles vertically
End Sub

' Places the ball at screen center and launches it at a random angle.
' serveDirection: 1 = serve right, -1 = serve left, 0 = random (coin flip).
' Rnd() returns a random Single between 0.0 and 1.0 — classic VB6/BASIC function.
' IIf(cond, trueVal, falseVal) is VB6's inline If — like a ternary operator.
Sub ResetBall(serveDirection As Integer)
	ballX = SCREEN_WIDTH / 2         ' Center ball horizontally
	ballY = SCREEN_HEIGHT / 2         ' Center ball vertically
	
	Dim angle As Single
	angle = (Rnd() - 0.5) * 1.0      ' Random angle from -0.5 to +0.5 radians (~±29°)
	
	If serveDirection = 0 Then
		serveDirection = IIf(Rnd() > 0.5, 1, -1)  ' VB6 IIf: coin flip for serve direction
	End If
	
	ballVelX = Cos(angle) * ballSpeed * serveDirection  ' X component: direction * speed
	ballVelY = Sin(angle) * ballSpeed                   ' Y component: angle-based vertical
	
	' Reset combo on new serve — each rally starts a fresh combo counter
	comboHits = 0
End Sub

' Center both paddles vertically on the screen.
Sub ResetPaddles()
	paddle1Y = (SCREEN_HEIGHT - PADDLE_HEIGHT) / 2  ' Vertically centered
	paddle2Y = (SCREEN_HEIGHT - PADDLE_HEIGHT) / 2  ' Both start in same position
End Sub

' ============================================================================
' POWER-UP SYSTEM (using DATA statements)
' ============================================================================
' VB6-style fixed-size arrays (0..5) to hold power-up definitions loaded from DATA.
Dim powerUpNames(5) As String     ' Array of power-up name strings (e.g., "SPEED", "SLOW")
Dim powerUpColors(5) As Variant   ' Array of Color values for each power-up's display color
Dim powerUpCount As Integer       ' How many power-ups were actually loaded from DATA

' Reads power-up definitions from embedded DATA statements using classic BASIC Read/Restore.
' Restore <label> sets the DATA read pointer to the labeled DATA block.
' Read <var> reads the next value from the DATA sequence into the variable.
' This pattern is a hallmark of classic BASIC — data is embedded directly in the source.
Sub LoadPowerUpData()
	Restore PowerUpDefinitions    ' Set DATA pointer to the PowerUpDefinitions label below
	powerUpCount = 0
	
	Dim pName As String
	Do                            ' VB6-style Do...Loop (infinite loop, broken by Exit Do)
		Read pName                ' Read next string from DATA; advances the pointer
		If pName = "END" Then Exit Do  ' Sentinel value signals end of data
		
		powerUpNames(powerUpCount) = pName
		
		Dim r, g, b As Integer
		Read r, g, b             ' Read 3 integers (R, G, B) for this power-up's color
		powerUpColors(powerUpCount) = Color(r/255.0, g/255.0, b/255.0)  ' Convert 0-255 to 0.0-1.0
		
		powerUpCount = powerUpCount + 1
	Loop
	
	Print "Loaded " & Str(powerUpCount) & " power-up types"
End Sub

' Spawns a random power-up at screen center if none is already active.
' Called from ActivateSuperCombo() as a reward for 7+ rally hits.
Sub SpawnPowerUp()
	If powerUpActive Then Exit Sub  ' Only one power-up on screen at a time
	
	Dim idx As Integer = Int(Rnd() * powerUpCount)  ' Int() truncates to integer — VB6 idiom
	powerUpType = powerUpNames(idx)                 ' Pick a random power-up type
	powerUpX = SCREEN_WIDTH / 2                     ' Always spawn at horizontal center
	powerUpY = RandRange(100, SCREEN_HEIGHT - 100)  ' Random Y within safe margins
	powerUpActive = True
	powerUpTimer = 10.0    ' Power-up disappears after 10 seconds if not collected
	
	Print "Power-up spawned: " & powerUpType
End Sub

' Applies the power-up effect when the ball collides with it.
' Select Case (VB6's switch) branches on the power-up type string.
' Some power-ups are placeholders (BIG, MULTI, SHIELD) for future expansion.
Sub CollectPowerUp()
	Print "Power-up collected: " & powerUpType
	powerUpActive = False             ' Remove power-up from the field
	
	Select Case powerUpType           ' VB6-style Select Case — matches String values
		Case "SPEED"
			ballSpeed = ballSpeed * 1.5   ' 50% speed boost — makes things frantic
		Case "SLOW"
			ballSpeed = ballSpeed * 0.7   ' 30% speed reduction — breather moment
		Case "BIG"
			' Would increase paddle size (not yet implemented)
		Case "MULTI"
			' Would add extra ball (not yet implemented)
		Case "SHIELD"
			' Would add goal protection (not yet implemented)
	End Select
	
	TriggerScreenShake 4.0   ' Medium shake for power-up collection feedback
End Sub

' Power-up definitions using DATA — a classic BASIC pattern for embedding data tables.
' Each DATA line holds a name followed by R, G, B color components (0-255).
' The Read statement in LoadPowerUpData() consumes these values sequentially.
' "END" is a sentinel value that signals the reader loop to stop.
' Label "PowerUpDefinitions:" lets Restore jump the read pointer here.
PowerUpDefinitions:
Data "SPEED", 255, 255, 0       ' Yellow — increases ball speed by 50%
Data "SLOW", 0, 255, 255        ' Cyan — decreases ball speed by 30%
Data "BIG", 0, 255, 0           ' Green — (placeholder) would enlarge paddles
Data "MULTI", 255, 0, 255       ' Magenta — (placeholder) would add extra balls
Data "SHIELD", 100, 100, 255    ' Light blue — (placeholder) would protect the goal
Data "END", 0, 0, 0             ' Sentinel — marks end of the data table

' ============================================================================
' GAME LOOP
' ============================================================================
' _Process(delta) is Godot's per-frame update callback.
' delta is the time in seconds since the last frame — used for framerate-independent movement.
' This is the main game loop: handles input, updates all systems, checks collisions and scoring.
Sub _Process(delta As Single)
	' Handle input for state changes using Godot's action system.
	' "ui_accept" = Enter/Space (Godot built-in), "ui_cancel" = Escape (Godot built-in).
	' IsActionJustPressed fires only on the first frame the key goes down (edge-triggered).
	If Input.IsActionJustPressed("ui_accept") Then
		Select Case gameState
			Case "gameover"
				StartNewGame              ' Enter restarts after game over
			Case "paused"
				gameState = "playing"     ' Enter unpauses (triggers OnGameStateChange)
			Case "playing"
				' Nothing - enter doesn't pause during gameplay
		End Select
	End If
	
	If Input.IsActionJustPressed("ui_cancel") Then
		If gameState = "playing" Then
			gameState = "paused"          ' ESC pauses (triggers OnGameStateChange)
		ElseIf gameState = "paused" Then
			gameState = "playing"         ' ESC again resumes
		End If
	End If
	
	' Toggle AI with the 2 key — manual debounce using aiToggleDown flag.
	' IsKeyPressed is level-triggered (true every frame while held), so we
	' debounce with aiToggleDown to detect only the key-down edge.
	If Input.IsKeyPressed(KEY_2) Then
		If Not aiToggleDown Then          ' Only toggle on the first frame of key press
			aiEnabled = Not aiEnabled     ' VB6 boolean toggle idiom
			If aiEnabled Then
				Print "AI opponent ENABLED"
			Else
				Print "AI opponent DISABLED (2-player mode)"
			End If
			aiToggleDown = True           ' Set debounce flag
		End If
	Else
		aiToggleDown = False              ' Key released — allow next toggle
	End If
	
	' Only update game logic when playing — paused/gameover skips physics and scoring.
	If gameState <> "playing" Then Return  ' <> is VB6's "not equal" operator
	
	' Per-frame update pipeline: paddles -> AI -> ball -> power-ups -> effects -> collisions -> scoring
	UpdatePaddles delta
	If aiEnabled Then UpdateAI delta       ' AI overrides Player 2's paddle2Y
	UpdateBall delta
	UpdatePowerUp delta
	UpdateEffects delta
	CheckCollisions
	CheckScoring
End Sub

' Reads player input and moves paddles. Uses delta for framerate-independent speed.
' IsActionPressed is level-triggered (true every frame the key is held).
' Player 1 uses W/S (mapped to "player1_up"/"player1_down" in Godot Input Map).
' Player 2 uses Up/Down arrows (or is overridden by AI when aiEnabled = True).
Sub UpdatePaddles(delta As Single)
	If Input.IsActionPressed("player1_up") Then
		paddle1Y = paddle1Y - PADDLE_SPEED * delta    ' Move up (Y decreases upward)
	End If
	If Input.IsActionPressed("player1_down") Then
		paddle1Y = paddle1Y + PADDLE_SPEED * delta    ' Move down
	End If
	If Input.IsActionPressed("player2_up") Then
		paddle2Y = paddle2Y - PADDLE_SPEED * delta
	End If
	If Input.IsActionPressed("player2_down") Then
		paddle2Y = paddle2Y + PADDLE_SPEED * delta
	End If
	
	' Clamp paddles to screen bounds so they can't move off-screen.
	paddle1Y = Clamp(paddle1Y, 0, SCREEN_HEIGHT - PADDLE_HEIGHT)
	paddle2Y = Clamp(paddle2Y, 0, SCREEN_HEIGHT - PADDLE_HEIGHT)
End Sub

' AI opponent logic for Player 2 (right paddle).
' Strategy: Predictive tracking with deliberate imperfection.
'   1. When ball moves toward AI (ballVelX > 0), predict where it will arrive.
'   2. When ball moves away, lazily drift toward center (default position).
'   3. Add random noise (±15 pixels) so the AI occasionally misjudges.
'   4. Movement speed is capped at aiSpeed (350), slightly below player's 400.
Sub UpdateAI(delta As Single)
	If ballVelX > 0 Then
		' --- Ball approaching: predictive interception ---
		Dim paddleRight As Single = SCREEN_WIDTH - 30 - PADDLE_WIDTH  ' AI paddle X position
		Dim timeToReach As Single = (paddleRight - ballX) / ballVelX  ' Seconds until arrival
		aiTargetY = ballY + ballVelY * timeToReach  ' Linear extrapolation of ball Y position
		
		' Clamp predicted position to screen bounds (ignores wall bounces for simplicity)
		aiTargetY = Clamp(aiTargetY, PADDLE_HEIGHT / 2, SCREEN_HEIGHT - PADDLE_HEIGHT / 2)
		
		' Add slight imperfection so AI isn't unbeatable — ±15 pixels of random noise
		aiTargetY = aiTargetY + (Rnd() - 0.5) * 30
	Else
		' --- Ball moving away: drift lazily toward center ---
		aiTargetY = SCREEN_HEIGHT / 2
	End If
	
	' Move toward target with limited speed — creates smooth, human-like movement
	Dim paddleCenter As Single = paddle2Y + PADDLE_HEIGHT / 2
	Dim diff As Single = aiTargetY - paddleCenter
	
	If Abs(diff) > 5 Then         ' Dead zone: don't jitter when close enough
		If diff > 0 Then
			paddle2Y = paddle2Y + aiSpeed * delta   ' Move down toward target
		Else
			paddle2Y = paddle2Y - aiSpeed * delta   ' Move up toward target
		End If
	End If
	
	paddle2Y = Clamp(paddle2Y, 0, SCREEN_HEIGHT - PADDLE_HEIGHT)
End Sub

' Moves the ball by its velocity and bounces off top/bottom walls.
' No left/right wall bounce — the ball leaving left or right triggers scoring.
' lastHitTime accumulates time since last paddle hit for combo detection.
Sub UpdateBall(delta As Single)
	ballX = ballX + ballVelX * delta   ' Apply horizontal velocity (pixels/sec * seconds)
	ballY = ballY + ballVelY * delta   ' Apply vertical velocity
	
	' Wall bounce — clamp Y and reflect velocity using Abs() to ensure correct direction.
	If ballY <= 0 Then
		ballY = 0                       ' Prevent going above the screen
		ballVelY = Abs(ballVelY)        ' Force downward (positive Y = down in Godot)
	ElseIf ballY >= SCREEN_HEIGHT - BALL_SIZE Then
		ballY = SCREEN_HEIGHT - BALL_SIZE  ' Prevent going below the screen
		ballVelY = -Abs(ballVelY)          ' Force upward
	End If
	
	lastHitTime = lastHitTime + delta   ' Track time since last paddle contact (for combos)
End Sub

' Counts down the power-up's lifespan. Power-ups expire after 10 seconds if uncollected.
Sub UpdatePowerUp(delta As Single)
	If Not powerUpActive Then Exit Sub    ' No power-up on screen — nothing to do
	
	powerUpTimer = powerUpTimer - delta
	If powerUpTimer <= 0 Then
		powerUpActive = False             ' Remove expired power-up from the field
		Print "Power-up expired"
	End If
End Sub

' Updates visual effect timers — screen shake, flash, and combo text.
' All effects are purely visual and don't affect gameplay physics.
Sub UpdateEffects(delta As Single)
	' Screen shake decay — exponential falloff (multiply by 0.9 each frame).
	' This creates a smooth, natural-feeling shake that quickly settles.
	screenShakeAmount = screenShakeAmount * 0.9
	If screenShakeAmount < 0.1 Then screenShakeAmount = 0  ' Cut off tiny residual jitter
	
	' Flash decay — "IsNot Nothing" is VB6-style null check for Variant types.
	If flashColor IsNot Nothing Then
		' Fade to nothing over time (placeholder — full impl would lerp alpha)
	End If
	
	' Combo text timer — hide the "COMBO x#" overlay when its display time runs out.
	If showComboText Then
		comboTextTimer = comboTextTimer - delta
		If comboTextTimer <= 0 Then
			showComboText = False
		End If
	End If
End Sub

' AABB collision detection for ball vs paddles and ball vs power-up.
' Paddles are positioned 30px from screen edges. The "And ballVelX < 0" check
' ensures we only test collision when the ball is moving toward that paddle,
' preventing double-hit glitches.
Sub CheckCollisions()
	Dim paddleLeft As Single = 30                              ' Player 1 paddle X
	Dim paddleRight As Single = SCREEN_WIDTH - 30 - PADDLE_WIDTH  ' Player 2 paddle X
	
	' Ball vs Paddle 1 (left side) — only check when ball moves leftward
	If ballX <= paddleLeft + PADDLE_WIDTH And ballVelX < 0 Then
		If ballY + BALL_SIZE >= paddle1Y And ballY <= paddle1Y + PADDLE_HEIGHT Then
			PaddleHit 1, paddle1Y   ' Deflect ball and update combo
		End If
	End If
	
	' Ball vs Paddle 2 (right side) — only check when ball moves rightward
	If ballX + BALL_SIZE >= paddleRight And ballVelX > 0 Then
		If ballY + BALL_SIZE >= paddle2Y And ballY <= paddle2Y + PADDLE_HEIGHT Then
			PaddleHit 2, paddle2Y   ' Deflect ball and update combo
		End If
	End If
	
	' Ball vs Power-up — simple distance-based collision (30px radius)
	If powerUpActive Then
		If Abs(ballX - powerUpX) < 30 And Abs(ballY - powerUpY) < 30 Then
			CollectPowerUp          ' Apply power-up effect and remove from field
		End If
	End If
End Sub

' Handles ball deflection when it hits a paddle. The bounce angle depends on
' WHERE the ball strikes the paddle (top, center, or bottom).
' hitPos: 0.0 = top edge, 0.5 = center, 1.0 = bottom edge.
' angle: maps hitPos to a radians range of roughly -0.7 to +0.7 (~±40°).
' This gives players control over the ball's direction via paddle positioning.
Sub PaddleHit(player As Integer, paddleY As Single)
	Dim hitPos As Single
	hitPos = (ballY + BALL_SIZE/2 - paddleY) / PADDLE_HEIGHT  ' Normalized hit position (0..1)
	Dim angle As Single
	angle = (hitPos - 0.5) * 1.4  ' Center hit = straight, edges = steep angles
	
	' Increase speed slightly — each hit adds 15 px/sec, creating escalating tension.
	' The Whenever Sections SpeedWarning (600) and MaxSpeed (800) monitor this reactively.
	ballSpeed = ballSpeed + 15
	
	' Direction based on which paddle: Player 1 sends rightward, Player 2 sends leftward.
	Dim dirX As Integer = IIf(player = 1, 1, -1)  ' IIf: VB6 inline conditional
	ballVelX = Cos(angle) * ballSpeed * dirX  ' Horizontal component with direction
	ballVelY = Sin(angle) * ballSpeed         ' Vertical component from hit angle
	
	' Combo tracking — if less than 2 seconds since last hit, the rally continues.
	' comboHits is monitored by Whenever Sections: ComboBonus (>3) and SuperCombo (>7).
	If lastHitTime < 2.0 Then
		comboHits = comboHits + 1   ' Continue rally — may trigger ComboBonus or SuperCombo!
	Else
		comboHits = 1               ' Too slow — restart combo counter
	End If
	lastHitTime = 0                 ' Reset the hit timer
	
	TriggerScreenShake 2.0          ' Light shake on every paddle hit for impact feel
	Print "Rally: " & Str(comboHits)
End Sub

' Detects when the ball leaves the screen left or right (i.e., someone scored).
' CRITICAL: Assigning to score1/score2 here is what triggers the Whenever Sections.
' The reactive system detects the value change and automatically calls the callbacks.
' This is the beauty of Whenever — no manual "if scored then do X" spaghetti needed.
Sub CheckScoring()
	If ballX < -BALL_SIZE Then
		score2 = score2 + 1  ' Ball left LEFT -> P2 scores (triggers OnPlayer2Score, maybe DeclareWinner2)
	End If
	
	If ballX > SCREEN_WIDTH Then
		score1 = score1 + 1  ' Ball left RIGHT -> P1 scores (triggers OnPlayer1Score, maybe DeclareWinner1)
	End If
End Sub

' Sets the screen shake intensity. The value decays in UpdateEffects each frame (* 0.9).
' Higher amounts = more violent shaking. Typical values: hits=2, combos=3-8, scoring=5.
Sub TriggerScreenShake(amount As Single)
	screenShakeAmount = amount
End Sub

' Placeholder for sound playback. In a full game, PlaySound would load and play a WAV.
' Currently just prints to the console so the demo runs without audio assets.
Sub PlayScoreSound()
	' PlaySound "res://sounds/score.wav"   ' Would play via Godot's audio system
	Print "[Sound: Score]"
End Sub

' ============================================================================
' RENDERING
' ============================================================================
' _Draw() is Godot's per-frame rendering callback. Called after _Process every frame.
' All drawing uses VisualGasic's built-in primitives: DrawRect, DrawCircle, DrawString.
' Screen shake is applied by offsetting all draw positions by random shakeX/shakeY amounts.
' Color("#hex") constructs a color from a hex string; Color(r,g,b,a) uses 0.0-1.0 floats.
Sub _Draw()
	' Apply screen shake offset — random displacement scaled by current shake intensity.
	' Rnd() returns 0..1, so (Rnd()-0.5)*2 gives -1..+1 range, then scaled by shakeAmount.
	Dim shakeX As Single = (Rnd() - 0.5) * screenShakeAmount * 2
	Dim shakeY As Single = (Rnd() - 0.5) * screenShakeAmount * 2
	
	' Background — solid dark blue rectangle covering the entire screen
	DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color("#000022")
	
	' Center line — dashed line made of small rectangles at regular intervals.
	' VB6-style For...Next loop with Step keyword for the interval.
	Dim i As Integer
	For i = 0 To SCREEN_HEIGHT Step 30
		DrawRect SCREEN_WIDTH/2 - 2 + shakeX, i + shakeY, 4, 15, Color("#333366")
	Next
	
	' Paddles — drawn as colored rectangles. Green for P1 (left), Orange for P2 (right).
	' shakeX/shakeY offsets applied to all elements for consistent screen shake.
	Dim paddleLeft As Single = 30                              ' P1 paddle 30px from left edge
	Dim paddleRight As Single = SCREEN_WIDTH - 30 - PADDLE_WIDTH  ' P2 paddle 30px from right
	DrawRect paddleLeft + shakeX, paddle1Y + shakeY, PADDLE_WIDTH, PADDLE_HEIGHT, Color("#00FF88")
	DrawRect paddleRight + shakeX, paddle2Y + shakeY, PADDLE_WIDTH, PADDLE_HEIGHT, Color("#FF8800")
	
	' Ball — drawn as a white square
	DrawRect ballX + shakeX, ballY + shakeY, BALL_SIZE, BALL_SIZE, Color.White
	
	' Power-up — pulsing circle that oscillates in size using Sin() for a breathing effect.
	' Looks up the power-up's color from the DATA-loaded arrays by name matching.
	If powerUpActive Then
		Dim pulseSize As Single = 20 + Sin(powerUpTimer * 5) * 5  ' Oscillates 15..25 radius
		Dim idx As Integer
		For idx = 0 To powerUpCount - 1
			If powerUpNames(idx) = powerUpType Then
				DrawCircle powerUpX + shakeX, powerUpY + shakeY, pulseSize, powerUpColors(idx)
				Exit For   ' Found the matching color — stop searching
			End If
		Next
	End If
	
	' Score display — large numbers at top of screen, color-coded per player.
	DrawString Str(score1), SCREEN_WIDTH/4, 30, Color("#00FF88"), 48      ' P1 score (green)
	DrawString Str(score2), 3 * SCREEN_WIDTH/4, 30, Color("#FF8800"), 48  ' P2 score (orange)
	
	' Combo display — shown in center screen when showComboText is True.
	' Purple for super combos (>7 hits), yellow for regular combos.
	If showComboText Then
		Dim comboColor As Variant = IIf(comboHits > 7, Color("#FF00FF"), Color("#FFFF00"))
		DrawString "COMBO x" & Str(comboHits), SCREEN_WIDTH/2 - 60, SCREEN_HEIGHT/2 - 50, comboColor, 32
	End If
	
	' Ball speed indicator — small gray text in the bottom-left corner.
	' Int() truncates the float to a whole number for cleaner display.
	DrawString "Speed: " & Str(Int(ballSpeed)), 10, SCREEN_HEIGHT - 30, Color("#666666"), 16
	
	' AI status indicator — bottom-right corner. Cyan when active, gray when off.
	If aiEnabled Then
		DrawString "AI: ON", SCREEN_WIDTH - 80, SCREEN_HEIGHT - 30, Color("#00FFFF"), 16
	Else
		DrawString "2P Mode", SCREEN_WIDTH - 80, SCREEN_HEIGHT - 30, Color("#666666"), 16
	End If
	
	' Game state overlays — semi-transparent black rectangles with centered text.
	' Color(0, 0, 0, 0.7) = black with 70% opacity for the overlay dimming effect.
	' These only render when the game is paused or over — Select Case on gameState.
	Select Case gameState
		Case "paused"
			DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color(0, 0, 0, 0.7)   ' Dim overlay
			DrawString "PAUSED", SCREEN_WIDTH/2 - 60, SCREEN_HEIGHT/2 - 20, Color.Yellow, 36
			DrawString "Press ESC to resume", SCREEN_WIDTH/2 - 90, SCREEN_HEIGHT/2 + 30, Color.Gray, 20
			
		Case "gameover"
			DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color(0, 0, 0, 0.8)   ' Darker overlay
			DrawString winner & " WINS!", SCREEN_WIDTH/2 - 100, SCREEN_HEIGHT/2 - 40, Color("#FFD700"), 48  ' Gold
			DrawString "Final Score: " & Str(score1) & " - " & Str(score2), SCREEN_WIDTH/2 - 80, SCREEN_HEIGHT/2 + 20, Color.White, 24
			DrawString "Press ENTER to play again", SCREEN_WIDTH/2 - 110, SCREEN_HEIGHT/2 + 60, Color.Gray, 20
	End Select
End Sub
