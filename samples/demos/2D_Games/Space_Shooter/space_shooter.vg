' ============================================================================
' SPACE SHOOTER - Parallel Processing & Lambda Demo
' Written in VisualGasic for Godot 4.5+
' ============================================================================
' Demonstrates:
' - Parallel For loops for updating many entities
' - Lambda expressions for filtering and mapping
' - DATA statements for enemy wave definitions
' - For Each iteration over collections
' - Pattern matching with Select Match
' ============================================================================
' VB6-style module attribute — names this module "SpaceShooter" for the runtime.
' In classic VB6, Attribute VB_Name set the class/module name in .frm/.bas files.
' VisualGasic preserves this idiom so VB6 code ports cleanly.
Attribute VB_Name = "SpaceShooter"

' --- Screen & physics constants (VB6-style Const declarations) ---
' VisualGasic Const works like VB6: module-level, typed, immutable at runtime.
Const SCREEN_WIDTH As Integer = 600     ' Viewport width in pixels
Const SCREEN_HEIGHT As Integer = 800    ' Viewport height in pixels (tall for vertical scroller)
Const PLAYER_SPEED As Single = 350.0    ' Player horizontal movement speed (pixels/sec)
Const BULLET_SPEED As Single = 600.0    ' Bullet upward travel speed (pixels/sec)
Const MAX_BULLETS As Integer = 50       ' Object pool size for player bullets
Const MAX_ENEMIES As Integer = 30       ' Object pool size for on-screen enemies
Const MAX_PARTICLES As Integer = 100    ' Object pool size for explosion particles

' --- Player state ---
' Dim declares module-level variables (VB6 idiom). Single = 32-bit float (like VB6).
Dim playerX As Single              ' Player ship X position (center of sprite)
Dim playerY As Single              ' Player ship Y position (center of sprite)
Dim playerLives As Integer         ' Remaining lives; game over at 0
Dim playerInvincible As Boolean    ' True during post-hit invincibility frames
Dim invincibleTimer As Single      ' Seconds remaining for invincibility (counts down)

' --- Bullet entity pool (parallel arrays pattern) ---
' Instead of an array of objects, we use parallel arrays — one array per property.
' This is a classic VB6/BASIC pattern and is also cache-friendly for Parallel For.
' Each index i represents one bullet; bulletActive(i) marks if slot i is alive.
Dim bulletX(MAX_BULLETS) As Single         ' X position of each bullet
Dim bulletY(MAX_BULLETS) As Single         ' Y position of each bullet
Dim bulletActive(MAX_BULLETS) As Boolean   ' True = slot in use; False = available for reuse
Dim bulletCount As Integer                 ' Count of currently active bullets

' --- Enemy entity pool (parallel arrays) ---
' Same pool pattern as bullets. enemyType(i) indexes into the enemy type lookup
' tables (loaded from DATA at startup) so we can look up speed, health, points.
Dim enemyX(MAX_ENEMIES) As Single          ' X position of each enemy
Dim enemyY(MAX_ENEMIES) As Single          ' Y position (moves downward toward player)
Dim enemyType(MAX_ENEMIES) As Integer      ' Index into enemyTypeNames/Speeds/Health/Points
Dim enemyHealth(MAX_ENEMIES) As Integer    ' Current HP; destroyed at 0
Dim enemyActive(MAX_ENEMIES) As Boolean    ' True = slot in use
Dim enemyCount As Integer                  ' Count of currently active enemies

' --- Particle pool (for explosions & visual effects) ---
' Particles have position, velocity, lifetime, and color.
' When particleLife(i) <= 0 the slot is dead and available for reuse.
' Variant type for particleColor stores a Godot Color object.
Dim particleX(MAX_PARTICLES) As Single     ' Particle X position
Dim particleY(MAX_PARTICLES) As Single     ' Particle Y position
Dim particleVX(MAX_PARTICLES) As Single    ' Particle X velocity (pixels/sec)
Dim particleVY(MAX_PARTICLES) As Single    ' Particle Y velocity (pixels/sec; gravity applied)
Dim particleLife(MAX_PARTICLES) As Single  ' Remaining lifetime in seconds (<=0 = dead)
Dim particleColor(MAX_PARTICLES) As Variant ' Godot Color — Variant holds any type (VB6 idiom)

' --- Game state ---
Dim score As Integer           ' Player's accumulated score (points per enemy kill)
Dim wave As Integer            ' Current wave number (1-based; indexes into wave data)
Dim waveTimer As Single        ' Countdown to next wave spawn (seconds)
Dim gameOver As Boolean        ' True when player loses all lives or clears all waves
Dim shootCooldown As Single    ' Time until player can fire again (prevents bullet spam)

' --- Scrolling star field (parallax background) ---
' 50 stars with varying speeds create a parallax depth illusion.
' Faster stars appear brighter/larger in _Draw(), simulating distance.
Dim starX(50) As Single       ' Star X positions (randomized across screen width)
Dim starY(50) As Single       ' Star Y positions (scroll downward to simulate ship movement)
Dim starSpeed(50) As Single   ' Scroll speed per star (50–200 px/sec; faster = "closer")

' --- Enemy type lookup tables (populated from DATA statements at startup) ---
' These parallel arrays define the properties of each enemy *type*.
' enemyType(i) on a live enemy indexes into these tables.
' Loaded via Read/Restore from the EnemyTypeData: label below.
Dim enemyTypeNames(5) As String    ' Type name ("SCOUT", "FIGHTER", etc.)
Dim enemyTypeSpeeds(5) As Single   ' Downward movement speed for this type (px/sec)
Dim enemyTypeHealth(5) As Integer  ' Starting HP for this type
Dim enemyTypePoints(5) As Integer  ' Score awarded when destroyed
Dim enemyTypeCount As Integer      ' How many types were loaded from DATA

' --- Wave definition tables (also loaded from DATA at startup) ---
' Each wave has a count of enemies to spawn and a comma-separated type pattern.
' The pattern cycles (e.g., "SCOUT,FIGHTER" alternates Scout/Fighter).
Dim waveEnemyCounts(10) As Integer ' Number of enemies to spawn in each wave
Dim waveEnemyTypes(10) As String   ' Comma-delimited type pattern (e.g., "SCOUT,FIGHTER")
Dim totalWaves As Integer          ' Total number of waves loaded from DATA

' ============================================================================
' LAMBDA EXPRESSIONS for game logic
' ============================================================================

' --- Lambda Expressions ---
' VisualGasic Lambda(params) expression  is like JS arrow functions or VB.NET lambdas.
' Syntax:  Lambda(param1, param2, ...) expression
' The expression is evaluated and its result returned. Stored in a Variant.
' Lambdas can be called like regular functions: IsOnScreen(100, 200)

' Bounds-check with 50px margin so entities aren't culled the instant they touch the edge
Dim IsOnScreen As Variant = Lambda(x, y) (x >= -50 And x <= SCREEN_WIDTH + 50 And y >= -50 And y <= SCREEN_HEIGHT + 50)

' Euclidean distance — used by Collides below. Sqr() is VB6's square root function.
Dim Distance As Variant = Lambda(x1, y1, x2, y2) Sqr((x2-x1)*(x2-x1) + (y2-y1)*(y2-y1))

' Circle-vs-circle collision: true when distance between centers < sum of radii.
' Composes the Distance lambda — VisualGasic lambdas can call other lambdas.
Dim Collides As Variant = Lambda(x1, y1, r1, x2, y2, r2) Distance(x1, y1, x2, y2) < (r1 + r2)

' ============================================================================
' INITIALIZATION
' ============================================================================
' _Ready() is Godot's initialization callback — called once when the node enters
' the scene tree. Equivalent to Form_Load in VB6. VisualGasic maps Sub _Ready()
' directly to Godot's _ready() virtual method.
Sub _Ready()
	Print "=== SPACE SHOOTER ==="
	Print "Demonstrating Parallel Processing & Lambdas"
	Print ""
	Print "Controls: A/D or Arrows = Move, Space = Fire"
	Print ""
	
	LoadEnemyTypes   ' Read enemy type stats from DATA statements into lookup tables
	LoadWaveData      ' Read wave definitions from DATA statements
	InitStars         ' Randomize the scrolling star field
	StartGame         ' Reset all game state for a fresh start
End Sub

' Load enemy type definitions from DATA statements using classic BASIC Read/Restore.
' Restore <label>  — sets the DATA read pointer to the specified label.
' Read <var>       — reads the next DATA value into the variable.
' This is a VisualGasic feature carried over from QuickBASIC/VB6; it lets you
' embed static data tables right in the source code (no external files needed).
Sub LoadEnemyTypes()
	Restore EnemyTypeData      ' Point the DATA cursor to the EnemyTypeData: label
	enemyTypeCount = 0
	
	Dim typeName As String
	Do                         ' Loop until sentinel value "END" is read
		Read typeName          ' Read next string from DATA line
		If typeName = "END" Then Exit Do  ' Sentinel — stop reading
		
		enemyTypeNames(enemyTypeCount) = typeName
		Read enemyTypeSpeeds(enemyTypeCount)   ' Read speed (Single)
		Read enemyTypeHealth(enemyTypeCount)   ' Read starting HP (Integer)
		Read enemyTypePoints(enemyTypeCount)   ' Read score value (Integer)
		
		enemyTypeCount = enemyTypeCount + 1
	Loop
	
	Print "Loaded " & Str(enemyTypeCount) & " enemy types"
End Sub

' Load wave definitions — each wave specifies how many enemies and which types.
' Uses the same Restore/Read pattern as LoadEnemyTypes.
' Sentinel value is count = -1 (marks end of wave data).
Sub LoadWaveData()
	Restore WaveData           ' Point the DATA cursor to the WaveData: label
	totalWaves = 0
	
	Dim count As Integer
	Do
		Read count             ' Number of enemies in this wave
		If count = -1 Then Exit Do  ' Sentinel value — no more waves
		
		waveEnemyCounts(totalWaves) = count
		Read waveEnemyTypes(totalWaves)  ' Comma-separated type pattern string
		
		totalWaves = totalWaves + 1
	Loop
	
	Print "Loaded " & Str(totalWaves) & " wave definitions"
End Sub

' Initialize the parallax star field with random positions and scroll speeds.
' Rnd() returns a Single in [0, 1) — same as VB6's Rnd function.
Sub InitStars()
	Dim i As Integer
	For i = 0 To 49
		starX(i) = Rnd() * SCREEN_WIDTH       ' Random X across the screen
		starY(i) = Rnd() * SCREEN_HEIGHT      ' Random starting Y
		starSpeed(i) = 50 + Rnd() * 150       ' Speed range 50–200 px/sec (depth layers)
	Next
End Sub

' Reset all game state for a new game (called at start and on restart).
Sub StartGame()
	playerX = SCREEN_WIDTH / 2         ' Center player horizontally
	playerY = SCREEN_HEIGHT - 80       ' Near bottom of screen
	playerLives = 3
	playerInvincible = False
	
	score = 0
	wave = 0               ' Will increment to 1 when first wave spawns
	waveTimer = 2.0         ' 2-second delay before first wave
	gameOver = False
	bulletCount = 0
	enemyCount = 0
	
	' Mark all pool slots as available by setting Active = False
	Dim i As Integer
	For i = 0 To MAX_BULLETS - 1
		bulletActive(i) = False
	Next
	For i = 0 To MAX_ENEMIES - 1
		enemyActive(i) = False
	Next
	
	Print "Game started! Wave 1 incoming..."
End Sub

' ============================================================================
' ENEMY & WAVE DATA (using DATA statements)
' ============================================================================

' ---- DATA STATEMENTS (Classic BASIC data tables) ----
' DATA lines store literal values inline in the source code.
' Restore <label> sets the read pointer; Read <var> consumes values left-to-right.
' This avoids needing external JSON/CSV files — very convenient for game tuning.
'
' Each Data line below holds comma-separated values that are read in order.
' Labels (EnemyTypeData:, WaveData:) act as bookmarks for Restore.

EnemyTypeData:                       ' Label — Restore EnemyTypeData jumps here
' Name,       Speed,  Health, Points
Data "SCOUT", 200.0, 1, 100          ' Fast, fragile, low value
Data "FIGHTER", 150.0, 2, 200        ' Medium speed, 2 HP
Data "BOMBER", 100.0, 3, 300         ' Slow, tanky
Data "ELITE", 180.0, 4, 500         ' Fast AND tough — dangerous
Data "BOSS", 50.0, 20, 2000         ' Very slow, massive HP, high reward
Data "END", 0, 0, 0                  ' Sentinel record — signals end of table

WaveData:                            ' Label — Restore WaveData jumps here
' EnemyCount, TypePattern (comma-separated type names that cycle)
Data 5, "SCOUT"                      ' Wave 1: 5 scouts (easy intro)
Data 8, "SCOUT,SCOUT,FIGHTER"        ' Wave 2: mostly scouts + a few fighters
Data 6, "FIGHTER,FIGHTER"            ' Wave 3: all fighters
Data 10, "SCOUT,FIGHTER,SCOUT"       ' Wave 4: mixed, more enemies
Data 8, "FIGHTER,BOMBER"             ' Wave 5: introduce bombers
Data 12, "SCOUT,FIGHTER,BOMBER"      ' Wave 6: full mix, larger count
Data 10, "ELITE,FIGHTER"             ' Wave 7: introduce elites
Data 15, "SCOUT,FIGHTER,ELITE"       ' Wave 8: large mixed wave
Data 1, "BOSS"                       ' Wave 9: single boss fight!
Data 20, "ELITE,BOMBER,FIGHTER"      ' Wave 10: post-boss gauntlet
Data -1, ""                          ' Sentinel — count of -1 ends the table

' ============================================================================
' GAME LOOP
' ============================================================================
' _Process(delta) is Godot's per-frame update callback (maps to _process()).
' "delta" is the time in seconds since the last frame — multiply speeds by delta
' for frame-rate-independent movement (standard Godot practice).
Sub _Process(delta As Single)
	If gameOver Then
		' On game-over screen, wait for fire input to restart
		If Input.IsActionJustPressed("fire") Then
			StartGame
		End If
		Return  ' Skip all game logic while game is over
	End If
	
	' --- Main game loop: update each system in order ---
	UpdateInput delta           ' Handle player movement & shooting
	UpdateBullets delta         ' Move bullets (uses Parallel For)
	UpdateEnemies delta         ' Move enemies (uses Parallel For)
	UpdateParticles delta       ' Animate explosion particles (uses Parallel For)
	UpdateStars delta           ' Scroll background stars
	UpdateWaveSpawner delta     ' Check if it's time to spawn the next wave
	CheckCollisions             ' Bullet-vs-enemy and enemy-vs-player checks
	
	' Tick down invincibility timer (player flashes while invincible)
	If playerInvincible Then
		invincibleTimer = invincibleTimer - delta
		If invincibleTimer <= 0 Then
			playerInvincible = False
		End If
	End If
	
	shootCooldown = shootCooldown - delta  ' Tick down fire rate limiter
End Sub

' Handle player movement and shooting input.
' Input.IsActionPressed() checks Godot's Input Map — these actions must be
' defined in Project > Project Settings > Input Map (or via code).
Sub UpdateInput(delta As Single)
	If Input.IsActionPressed("move_left") Then
		playerX = playerX - PLAYER_SPEED * delta  ' Move left (delta-scaled)
	End If
	If Input.IsActionPressed("move_right") Then
		playerX = playerX + PLAYER_SPEED * delta  ' Move right (delta-scaled)
	End If
	
	' Clamp player within screen bounds (20px margin for ship half-width)
	playerX = Clamp(playerX, 20, SCREEN_WIDTH - 20)
	
	' Fire with rate-limiting: 0.15s cooldown ≈ ~6.7 shots/sec
	If Input.IsActionPressed("fire") And shootCooldown <= 0 Then
		FireBullet
		shootCooldown = 0.15  ' Reset fire cooldown
	End If
End Sub

' Spawn a new bullet from the player's position.
' Uses the object pool pattern: scan for the first inactive slot, initialize it,
' and mark it active. If all slots are occupied, the bullet simply isn't fired
' (pool exhaustion — a soft cap on screen bullet count).
Sub FireBullet()
	Dim i As Integer
	For i = 0 To MAX_BULLETS - 1
		If Not bulletActive(i) Then         ' Found a free slot
			bulletX(i) = playerX            ' Spawn at player's X
			bulletY(i) = playerY - 20       ' Slightly above player center
			bulletActive(i) = True          ' Mark slot as in-use
			bulletCount = bulletCount + 1
			Exit For                        ' VB6 idiom: break out of For loop
		End If
	Next
End Sub

' ============================================================================
' PARALLEL PROCESSING - Update many entities efficiently
' ============================================================================

' Update all bullets — move them upward, deactivate if off-screen.
' ── Parallel For ──
' "Parallel For ... Next" is a VisualGasic-specific feature that distributes
' loop iterations across multiple threads automatically. Each iteration runs
' independently on a worker thread (like OpenMP parallel for).
' IMPORTANT: iterations must not depend on each other's results. Here each
' bullet's update only reads/writes its own slot, so parallelism is safe.
Sub UpdateBullets(delta As Single)
	Parallel For i = 0 To MAX_BULLETS - 1
		If bulletActive(i) Then
			bulletY(i) = bulletY(i) - BULLET_SPEED * delta  ' Move bullet upward
			
			' Use our Lambda expression to bounds-check
			If Not IsOnScreen(bulletX(i), bulletY(i)) Then
				bulletActive(i) = False        ' Return slot to pool
				bulletCount = bulletCount - 1
			End If
		End If
	Next  ' End Parallel For — threads rejoin here
End Sub

' Update all enemies — move them downward with sinusoidal weaving.
' Also uses Parallel For since each enemy's update is independent.
Sub UpdateEnemies(delta As Single)
	Parallel For i = 0 To MAX_ENEMIES - 1
		If enemyActive(i) Then
			' Look up this enemy's type to get its movement speed
			Dim typeIdx As Integer = enemyType(i)
			Dim speed As Single = enemyTypeSpeeds(typeIdx)
			
			' Primary movement: straight down at type-specific speed
			enemyY(i) = enemyY(i) + speed * delta
			' Secondary movement: horizontal sine wave (gives enemies a weaving path)
			' Sin(y * 0.02) uses Y position as phase, so wave progresses as enemy descends
			enemyX(i) = enemyX(i) + Sin(enemyY(i) * 0.02) * 50 * delta
			
			' Off-screen cleanup (50px buffer below bottom edge)
			If enemyY(i) > SCREEN_HEIGHT + 50 Then
				enemyActive(i) = False
				enemyCount = enemyCount - 1
			End If
		End If
	Next  ' End Parallel For
End Sub

' Update explosion particles — position, lifetime decay, and simulated gravity.
' Third use of Parallel For: particles are fully independent of each other.
Sub UpdateParticles(delta As Single)
	Parallel For i = 0 To MAX_PARTICLES - 1
		If particleLife(i) > 0 Then              ' Only process living particles
			particleX(i) = particleX(i) + particleVX(i) * delta  ' Apply X velocity
			particleY(i) = particleY(i) + particleVY(i) * delta  ' Apply Y velocity
			particleLife(i) = particleLife(i) - delta             ' Countdown to death
			
			' Simulate gravity — accelerates particles downward over time
			' 200 px/sec² is a gentle pull that makes explosions arc nicely
			particleVY(i) = particleVY(i) + 200 * delta
		End If
	Next  ' End Parallel For
End Sub

' Scroll stars downward to simulate the player's ship flying upward.
' When a star passes the bottom edge, wrap it to the top with a new random X.
' Note: regular For (not Parallel) since 50 iterations is too few to benefit.
Sub UpdateStars(delta As Single)
	Dim i As Integer
	For i = 0 To 49
		starY(i) = starY(i) + starSpeed(i) * delta
		If starY(i) > SCREEN_HEIGHT Then   ' Scrolled off bottom
			starY(i) = 0                   ' Wrap to top
			starX(i) = Rnd() * SCREEN_WIDTH ' New random horizontal position
		End If
	Next
End Sub

' Wave spawner — waits for timer AND all enemies cleared before spawning next wave.
' This gives the player a brief breather between waves.
Sub UpdateWaveSpawner(delta As Single)
	waveTimer = waveTimer - delta
	
	' Spawn next wave only when: timer expired AND no enemies remaining on screen
	If waveTimer <= 0 And enemyCount = 0 Then
		SpawnWave
		waveTimer = 3.0  ' 3-second delay before the NEXT wave after this one
	End If
End Sub

' Spawn the next wave of enemies according to wave definitions loaded from DATA.
' Enemies are placed in a grid formation above the screen (rows of 10).
Sub SpawnWave()
	' Victory condition: all waves cleared
	If wave >= totalWaves Then
		Print "You've completed all waves!"
		gameOver = True
		Return
	End If
	
	wave = wave + 1
	' CInt() casts to Integer for clean display — VB6 idiom
	Print "Wave " & Str(CInt(wave)) & " starting!"
	
	Dim count As Integer = waveEnemyCounts(wave - 1)    ' How many enemies this wave
	Dim typePattern As String = waveEnemyTypes(wave - 1) ' e.g., "SCOUT,FIGHTER"
	
	' Split() breaks the comma-separated pattern into a String array — VB6 function.
	Dim types() As String = Split(typePattern, ",")
	
	Dim i As Integer
	For i = 0 To count - 1
		' --- Object pool allocation: find first inactive enemy slot ---
		Dim slot As Integer
		For slot = 0 To MAX_ENEMIES - 1
			If Not enemyActive(slot) Then
				' Grid formation: 10 per row, 50px spacing, stacked above screen
				enemyX(slot) = 50 + (i Mod 10) * 50
				enemyY(slot) = -50 - Int(i / 10) * 60  ' Negative Y = above viewport
				
				' Cycle through the type pattern (Mod wraps index around)
				' UBound(types) + 1 = number of elements; Mod cycles 0..count-1
				Dim typeIdx As Integer = i Mod (UBound(types) + 1)
				Dim typeName As String = Trim(types(typeIdx))
				
				' Linear search to resolve type name → type index
				Dim t As Integer
				For t = 0 To enemyTypeCount - 1
					If enemyTypeNames(t) = typeName Then
						enemyType(slot) = t                    ' Store type index
						enemyHealth(slot) = enemyTypeHealth(t) ' Set HP from type table
						Exit For
					End If
				Next
				
				enemyActive(slot) = True
				enemyCount = enemyCount + 1
				Exit For  ' Move to next enemy (i); this slot is now taken
			End If
		Next
	Next
End Sub

' ============================================================================
' COLLISION DETECTION
' ============================================================================
' Collision detection — O(bullets × enemies) brute-force, fine for small pools.
' Uses the Collides Lambda for circle-vs-circle overlap tests.
Sub CheckCollisions()
	Dim i, j As Integer   ' VB6 multi-declaration: both are Integer
	
	' --- Phase 1: Bullets vs Enemies (nested loop) ---
	For i = 0 To MAX_BULLETS - 1
		If bulletActive(i) Then
			For j = 0 To MAX_ENEMIES - 1
				If enemyActive(j) Then
					' Collides Lambda: bullet radius=5, enemy radius=20
					If Collides(bulletX(i), bulletY(i), 5, enemyX(j), enemyY(j), 20) Then
						' Deactivate the bullet (it's consumed on hit)
						bulletActive(i) = False
						bulletCount = bulletCount - 1
						
						' Reduce enemy HP; each bullet does 1 damage
						enemyHealth(j) = enemyHealth(j) - 1
						If enemyHealth(j) <= 0 Then
							' Enemy destroyed — spawn explosion, award points
							SpawnExplosion enemyX(j), enemyY(j)
							score = score + enemyTypePoints(enemyType(j))
							enemyActive(j) = False
							enemyCount = enemyCount - 1
						End If
						
						Exit For  ' This bullet is gone; stop checking enemies
					End If
				End If
			Next
		End If
	Next
	
	' --- Phase 2: Enemies vs Player (body collision) ---
	' Skip entirely if player is invincible (post-hit grace period)
	If Not playerInvincible Then
		For j = 0 To MAX_ENEMIES - 1
			If enemyActive(j) Then
				' Player radius=15, enemy radius=20
				If Collides(playerX, playerY, 15, enemyX(j), enemyY(j), 20) Then
					PlayerHit             ' Lose a life, trigger invincibility
					Exit For              ' Only one hit per frame
				End If
			End If
		Next
	End If
End Sub

' Called when an enemy collides with the player. Decrements lives, grants
' 2 seconds of invincibility, and spawns a visual explosion at the player.
Sub PlayerHit()
	playerLives = playerLives - 1
	playerInvincible = True          ' Enable i-frames
	invincibleTimer = 2.0            ' 2 seconds of invincibility
	
	SpawnExplosion playerX, playerY  ' Visual feedback for the hit
	
	If playerLives <= 0 Then
		gameOver = True
		Print "GAME OVER! Final Score: " & Str(score)
	Else
		Print "Hit! Lives remaining: " & Str(playerLives)
	End If
End Sub

' Spawn up to 20 particles at (x, y) with random velocities and warm colors.
' Reuses dead particle slots (particleLife <= 0) from the pool.
Sub SpawnExplosion(x As Single, y As Single)
	Dim i As Integer
	For i = 0 To MAX_PARTICLES - 1
		If particleLife(i) <= 0 Then        ' Dead slot — reuse it
			particleX(i) = x                ' Start at explosion center
			particleY(i) = y
			' Random velocity burst: (Rnd()-0.5)*300 gives -150 to +150 px/sec
			particleVX(i) = (Rnd() - 0.5) * 300
			particleVY(i) = (Rnd() - 0.5) * 300
			particleLife(i) = 0.5 + Rnd() * 0.5  ' Lifespan: 0.5–1.0 seconds
			
			' Generate a random warm color (red-orange-yellow range)
			Dim r As Single = 0.8 + Rnd() * 0.2  ' Red channel: 0.8–1.0 (always high)
			Dim g As Single = 0.3 + Rnd() * 0.5  ' Green channel: 0.3–0.8 (varies)
			particleColor(i) = Color(r, g, 0)    ' Blue=0 → warm tones only
			
			' Cap at 20 particles per explosion to avoid flooding the pool
			If i Mod 20 = 19 Then Exit For
		End If
	Next
End Sub

' ============================================================================
' RENDERING
' ============================================================================
' _Draw() is Godot's rendering callback (maps to _draw()). Called every frame
' after _Process(). VisualGasic provides DrawRect, DrawCircle, DrawString as
' wrappers around Godot's CanvasItem draw_rect/draw_circle/draw_string.
' Rendering order = painter's algorithm: first drawn = furthest back.
Sub _Draw()
	' --- Layer 0: Background (dark navy, almost black) ---
	DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color("#000011")
	
	' --- Layer 1: Scrolling star field (parallax depth effect) ---
	' Faster stars (higher starSpeed) are drawn brighter and slightly larger,
	' creating the illusion that they're closer to the camera.
	Dim i As Integer
	For i = 0 To 49
		Dim brightness As Single = starSpeed(i) / 200  ' Normalize to 0.25–1.0 range
		DrawCircle starX(i), starY(i), 1 + brightness, Color(brightness, brightness, brightness)
	Next
	
	' --- Layer 2: Explosion particles (drawn behind bullets/ships) ---
	' Size and alpha fade with remaining lifetime for a natural dissipation look.
	For i = 0 To MAX_PARTICLES - 1
		If particleLife(i) > 0 Then
			Dim alpha As Single = particleLife(i) * 2     ' Fade out as life decreases
			Dim size As Single = particleLife(i) * 6      ' Shrink as life decreases
			DrawCircle particleX(i), particleY(i), size, particleColor(i)
		End If
	Next
	
	' --- Layer 3: Player bullets (small cyan rectangles) ---
	For i = 0 To MAX_BULLETS - 1
		If bulletActive(i) Then
			' 4×15 pixel cyan bolt, centered on bulletX
			DrawRect bulletX(i) - 2, bulletY(i), 4, 15, Color("#00FFFF")
		End If
	Next
	
	' --- Layer 4: Enemies ---
	For i = 0 To MAX_ENEMIES - 1
		If enemyActive(i) Then
			Dim typeIdx As Integer = enemyType(i)
			Dim enemyColor As Variant
			
			' ── Select Match (VisualGasic pattern matching) ──
			' "Select Match" works like VB6's Select Case, but performs
			' pattern matching on the value. Each Case branch is compared
			' against the matched expression. Case Else is the default.
			' Here we map enemy type name → display color.
			Select Match enemyTypeNames(typeIdx)
				Case "SCOUT"              ' Red — weakest, most common
					enemyColor = Color("#FF4444")
				Case "FIGHTER"            ' Orange — mid-tier
					enemyColor = Color("#FF8844")
				Case "BOMBER"             ' Yellow — slow but tanky
					enemyColor = Color("#FFFF44")
				Case "ELITE"              ' Magenta — dangerous
					enemyColor = Color("#FF44FF")
				Case "BOSS"               ' Bright red — max threat
					enemyColor = Color("#FF0000")
				Case Else                 ' Fallback for unknown types
					enemyColor = Color.White
			End Select
			
			' Choose() is a VB6 function: Choose(condition, trueVal, falseVal)
			' Boss (typeIdx=4) gets radius 40; all others get radius 20
			Dim size As Integer = Choose(typeIdx = 4, 40, 20)
			DrawCircle enemyX(i), enemyY(i), size, enemyColor
			
			' Draw a health bar above enemies that have more than 1 HP
			If enemyTypeHealth(typeIdx) > 1 Then
				Dim healthPct As Single = enemyHealth(i) / enemyTypeHealth(typeIdx)
				' Background bar (dark red) — full width
				DrawRect enemyX(i) - 15, enemyY(i) - size - 8, 30, 4, Color.DarkRed
				' Foreground bar (green) — width proportional to remaining HP
				DrawRect enemyX(i) - 15, enemyY(i) - size - 8, 30 * healthPct, 4, Color.Green
			End If
		End If
	Next
	
	' --- Layer 5: Player ship ---
	If Not gameOver Then
		Dim playerAlpha As Single = 1.0
		If playerInvincible Then
			' Rapid sine flash: oscillates alpha 0–1 at high frequency (20× timer)
			' Creates the classic "blinking" invincibility effect
			playerAlpha = 0.5 + Sin(invincibleTimer * 20) * 0.5
		End If
		
		' Ship drawn as a cyan circle (body) + darker rectangle (thruster/tail)
		' Color(0, alpha, alpha) = cyan that fades during invincibility blink
		DrawCircle playerX, playerY, 15, Color(0, playerAlpha, playerAlpha)
		DrawRect playerX - 5, playerY + 10, 10, 15, Color(0, playerAlpha * 0.5, playerAlpha)
	End If
	
	' --- Layer 6: Heads-Up Display (drawn on top of everything) ---
	' DrawString syntax: DrawString text, x, y, color, fontSize
	' Str() converts number to string (VB6 function); & is string concatenation.
	DrawString "SCORE: " & Str(score), 10, 10, Color.White, 24
	DrawString "WAVE: " & Str(CInt(wave)), 10, 40, Color.Yellow, 20
	' String(n, char) repeats char n times — VB6 function. Shows lives as hearts.
	DrawString "LIVES: " & String(playerLives, "♥"), SCREEN_WIDTH - 120, 10, Color.Red, 24
	
	' --- Game over / victory overlay ---
	If gameOver Then
		' Semi-transparent black overlay (alpha=0.8) darkens the gameplay beneath
		DrawRect 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, Color(0, 0, 0, 0.8)
		
		If wave > totalWaves Then
			' All waves cleared — victory! Gold color (#FFD700)
			DrawString "VICTORY!", SCREEN_WIDTH/2 - 80, SCREEN_HEIGHT/2 - 60, Color("#FFD700"), 48
		Else
			' Player lost all lives
			DrawString "GAME OVER", SCREEN_WIDTH/2 - 100, SCREEN_HEIGHT/2 - 60, Color.Red, 48
		End If
		
		DrawString "Final Score: " & Str(score), SCREEN_WIDTH/2 - 80, SCREEN_HEIGHT/2, Color.White, 28
		DrawString "Wave Reached: " & Str(CInt(wave)), SCREEN_WIDTH/2 - 70, SCREEN_HEIGHT/2 + 40, Color.Gray, 20
		DrawString "Press SPACE to restart", SCREEN_WIDTH/2 - 100, SCREEN_HEIGHT/2 + 100, Color.Cyan, 20
	End If
End Sub
