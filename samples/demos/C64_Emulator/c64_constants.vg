' === C64 Color Palette (16 colors, 8-bit per channel) ===
Function C64Color(idx As Integer) As Variant
    Dim pal As Variant
    ' Build palette array on first call
    pal = CreateArray(16)
    pal(0) = Color8(0, 0, 0, 255)
    pal(1) = Color8(255, 255, 255, 255)
    pal(2) = Color8(136, 0, 0, 255)
    pal(3) = Color8(170, 255, 238, 255)
    pal(4) = Color8(204, 68, 204, 255)
    pal(5) = Color8(0, 204, 85, 255)
    pal(6) = Color8(0, 0, 170, 255)
    pal(7) = Color8(238, 238, 119, 255)
    pal(8) = Color8(221, 136, 85, 255)
    pal(9) = Color8(102, 68, 0, 255)
    pal(10) = Color8(255, 119, 119, 255)
    pal(11) = Color8(51, 51, 51, 255)
    pal(12) = Color8(119, 119, 119, 255)
    pal(13) = Color8(170, 255, 102, 255)
    pal(14) = Color8(0, 136, 255, 255)
    pal(15) = Color8(187, 187, 187, 255)
    Return pal(idx)
End Function

' Keep last-built palette cached
Dim g_c64PalCached As Boolean
Dim g_c64Pal(15) As Variant

Function GetC64Color(idx As Integer) As Variant
    If Not g_c64PalCached Then
        g_c64Pal(0) = Color8(0, 0, 0, 255)
        g_c64Pal(1) = Color8(255, 255, 255, 255)
        g_c64Pal(2) = Color8(136, 0, 0, 255)
        g_c64Pal(3) = Color8(170, 255, 238, 255)
        g_c64Pal(4) = Color8(204, 68, 204, 255)
        g_c64Pal(5) = Color8(0, 204, 85, 255)
        g_c64Pal(6) = Color8(0, 0, 170, 255)
        g_c64Pal(7) = Color8(238, 238, 119, 255)
        g_c64Pal(8) = Color8(221, 136, 85, 255)
        g_c64Pal(9) = Color8(102, 68, 0, 255)
        g_c64Pal(10) = Color8(255, 119, 119, 255)
        g_c64Pal(11) = Color8(51, 51, 51, 255)
        g_c64Pal(12) = Color8(119, 119, 119, 255)
        g_c64Pal(13) = Color8(170, 255, 102, 255)
        g_c64Pal(14) = Color8(0, 136, 255, 255)
        g_c64Pal(15) = Color8(187, 187, 187, 255)
        g_c64PalCached = True
    End If
    Return g_c64Pal(idx)
End Function

Function CreateArray(size As Integer) As Variant
    Dim arr As Variant
    arr = Array()
    Dim i As Integer
    For i = 0 To size - 1
        Push arr, 0
    Next
    Return arr
End Function