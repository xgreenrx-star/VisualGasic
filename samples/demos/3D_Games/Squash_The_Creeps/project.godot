; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Squash the Creeps 3D (VisualGasic)"
config/description="Official Godot 'Your First 3D Game' demo converted to VisualGasic.
Shows how VB6-style scripting drives a real Godot 3D game with CharacterBody3D,
move_and_slide, 3D physics, mob spawning, stomp mechanics, and scoring.
All GDScript replaced with VisualGasic (.vg) — same gameplay, same feel."
config/tags=PackedStringArray("3d", "demo", "visualgasic", "physics")
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

[autoload]

VGDebugHandler="*res://addons/visual_gasic/vg_debug_handler.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_gasic/plugin.cfg")

