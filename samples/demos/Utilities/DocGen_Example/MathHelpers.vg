''' MathHelpers — Utility functions for common math operations.
'''
''' A collection of pure functions with no side effects.
''' Safe to call from any module.
Attribute VB_Name = "MathHelpers"
Option Explicit

''' The ratio of a circle's circumference to its diameter.
Const PI As Double = 3.14159265358979

''' Euler's number — base of the natural logarithm.
Const E As Double = 2.71828182845905

''' Clamps a value between a minimum and maximum.
'''
''' @param value  The input value
''' @param lo     The minimum allowed value
''' @param hi     The maximum allowed value
''' @return The clamped result (lo ≤ result ≤ hi)
''' @example
'''   Dim health As Integer
'''   health = Clamp(health - damage, 0, 100)
Function Clamp(value As Double, lo As Double, hi As Double) As Double
    If value < lo Then
        Clamp = lo
    ElseIf value > hi Then
        Clamp = hi
    Else
        Clamp = value
    End If
End Function

''' Linearly interpolates between two values.
'''
''' @param a  Start value (returned when t = 0)
''' @param b  End value (returned when t = 1)
''' @param t  Interpolation factor (0.0 to 1.0)
''' @return The interpolated value
''' @example
'''   Dim halfway As Double
'''   halfway = Lerp(0, 100, 0.5)   ' → 50.0
Function Lerp(a As Double, b As Double, t As Double) As Double
    Lerp = a + (b - a) * t
End Function

''' Returns the inverse lerp — what fraction of the way value is between a and b.
'''
''' @param a      Range start
''' @param b      Range end
''' @param value  The value to query
''' @return A factor where 0.0 means value=a and 1.0 means value=b
Function InverseLerp(a As Double, b As Double, value As Double) As Double
    If b - a = 0 Then
        InverseLerp = 0
        Exit Function
    End If
    InverseLerp = (value - a) / (b - a)
End Function

''' Remaps a value from one range to another.
'''
''' @param value   The input value
''' @param fromLo  Source range minimum
''' @param fromHi  Source range maximum
''' @param toLo    Target range minimum
''' @param toHi    Target range maximum
''' @return The remapped value
''' @example
'''   ' Convert a 0–255 byte to a 0.0–1.0 float
'''   Dim f As Double
'''   f = Remap(128, 0, 255, 0.0, 1.0)   ' → ~0.502
Function Remap(value As Double, fromLo As Double, fromHi As Double, toLo As Double, toHi As Double) As Double
    Dim t As Double
    t = InverseLerp(fromLo, fromHi, value)
    Remap = Lerp(toLo, toHi, t)
End Function

''' Returns the larger of two values.
'''
''' @param a  First value
''' @param b  Second value
''' @return The greater of a and b
Function Max(a As Double, b As Double) As Double
    If a >= b Then
        Max = a
    Else
        Max = b
    End If
End Function

''' Returns the smaller of two values.
'''
''' @param a  First value
''' @param b  Second value
''' @return The lesser of a and b
Function Min(a As Double, b As Double) As Double
    If a <= b Then
        Min = a
    Else
        Min = b
    End If
End Function

''' Returns the sign of a number: -1, 0, or +1.
'''
''' @param value  The number to test
''' @return -1 if negative, 0 if zero, +1 if positive
Function Sign(value As Double) As Integer
    If value > 0 Then
        Sign = 1
    ElseIf value < 0 Then
        Sign = -1
    Else
        Sign = 0
    End If
End Function

''' Converts degrees to radians.
'''
''' @param degrees  Angle in degrees
''' @return Angle in radians
Function DegToRad(degrees As Double) As Double
    DegToRad = degrees * PI / 180.0
End Function

''' Converts radians to degrees.
'''
''' @param radians  Angle in radians
''' @return Angle in degrees
Function RadToDeg(radians As Double) As Double
    RadToDeg = radians * 180.0 / PI
End Function

''' Computes the distance between two 2D points.
'''
''' @param x1  X of point 1
''' @param y1  Y of point 1
''' @param x2  X of point 2
''' @param y2  Y of point 2
''' @return The Euclidean distance
''' @example
'''   Dim d As Double
'''   d = Distance2D(0, 0, 3, 4)   ' → 5.0
Function Distance2D(x1 As Double, y1 As Double, x2 As Double, y2 As Double) As Double
    Dim dx As Double
    Dim dy As Double
    dx = x2 - x1
    dy = y2 - y1
    Distance2D = Sqr(dx * dx + dy * dy)
End Function

''' Wraps an integer value into a range [0, maxVal).
'''
''' Useful for array index wrapping.
'''
''' @param value   The input integer
''' @param maxVal  The exclusive upper bound
''' @return The wrapped value in [0, maxVal)
''' @example
'''   Dim idx As Integer
'''   idx = WrapIndex(-1, 10)   ' → 9
'''   idx = WrapIndex(10, 10)   ' → 0
Function WrapIndex(value As Integer, maxVal As Integer) As Integer
    WrapIndex = ((value Mod maxVal) + maxVal) Mod maxVal
End Function
