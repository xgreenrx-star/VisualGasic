Dim game As Object
Dim view As Object
Dim yard As Object
Dim elapsed_frames As Integer
Dim failures As Integer
Dim checks As Integer
Dim mesh_id As Variant
Dim sky_before As Image
Dim fog_before As Image

Sub Check(ByVal condition As Boolean, ByVal label As String)
	checks = checks + 1
	If condition Then
		Print "PASS: " & label
	Else
		failures = failures + 1
		Print "FAIL: " & label
	End If
End Sub

Sub _Ready()
	Dim packed As Object
	packed = Load("res://main.tscn")
	game = packed.instantiate()
	add_child(game)
	game.set_process(False)
	game.opt_fps = False
	game.opt_detail = 1
	view = game.GetNode("Presentation")
	game.dev_i = 14
	game.WarpDev()
End Sub

Sub _Process(ByVal delta As Single)
	Dim i As Integer
	Dim door As Vector2
	Dim directory As String
	Dim x As Integer
	Dim y As Integer
	Dim changed As Integer
	Dim image As Image
	elapsed_frames = elapsed_frames + 1
	If elapsed_frames < 40 Or elapsed_frames >= 60 Then game.QueueRedraw()
	If elapsed_frames = 8 Then
		yard = view.backlight_city
		Check(game.phase = 18, "backlight_yard_has_own_phase")
		Check(game.DevLabel(14) = "BACKLIGHT YARD", "backlight_yard_terminal_label")
		Check(yard.yard_mode And yard.initialized, "backlight_yard_built_in_vg")
		Check(yard.buildings.size() = 8, "backlight_yard_eight_enterable_depots")
		Check(yard.world.mesh.get_surface_count() = 2, "backlight_yard_solid_and_luminous_surfaces")
		Check(yard.world.mesh.surface_get_array_len(0) > 10000, "backlight_yard_volumetric_architecture")
		Check(yard.optics.size() = 3 And view.camera.environment = yard.atmosphere, "backlight_yard_optics_and_horizon")
		Check(yard.yard_scenery.doors.size() = 8, "backlight_yard_sliding_doors")
		Check(yard.shell_material.get_shader_parameter("yard_haze") = 1.0 And yard.light_material.get_shader_parameter("yard_haze") = 1.0, "backlight_yard_outdoor_fog_enabled")
		Check(yard.yard_scenery.sky_material.shader.resource_path = "res://shaders/backlight_yard_sky.gdshader", "backlight_yard_own_celestial_sky")
		Check(Not yard.blocked(Vector2(0, 100), 1.4), "backlight_yard_drivable_central_lane")
		Check(yard.blocked(Vector2(78, 15), 0.4), "backlight_yard_tower_collision")
		Check(yard.blocked(Vector2(119, 50), 0.4), "backlight_yard_boundary_collision")
		For i = 0 To 7
			door = yard.buildings(i).door
			Check(Not yard.blocked(door, 0.4) And Not yard.blocked(door - Vector2(0, 3), 0.4), "backlight_yard_door_clear_" & Str(i))
		Next
		yard.position_xz = Vector2(0, 90)
		yard.heading = 0
		yard.move_distance(12)
		Check(yard.position_xz.y > 101, "backlight_yard_movement_along_road")
		mesh_id = yard.world.mesh.get_instance_id()
		yard.position_xz = Vector2(-41, 36)
		yard.use_object()
		Check(yard.place = "building" And yard.building_index = 0, "backlight_yard_archive_entry")
	ElseIf elapsed_frames = 12 Then
		Check(Not yard.yard_scenery.visible And yard.shell_material.get_shader_parameter("yard_haze") = 0.0, "backlight_yard_no_outdoor_fog_or_doors_interior")
		yard.position_xz = Vector2(0, 14)
		yard.use_object()
		Check(yard.discovered.has(0), "backlight_yard_archive_clue")
		yard.position_xz = Vector2(0, 2)
		yard.use_object()
		Check(yard.place = "surface", "backlight_yard_exit_interior")
		yard.position_xz = Vector2(2.5, 14)
		yard.interact_vehicle()
		Check(yard.driving, "backlight_yard_buggy_entry")
		yard.interact_vehicle()
		Check(Not yard.driving, "backlight_yard_buggy_exit")
		game.SaveRun()
		Check(game.save_msg = "BACKLIGHT YARD IS A DEV DEMO - CHAPTER SAVE UNCHANGED", "backlight_yard_save_protection")
		yard.position_xz = Vector2(0, 9)
		yard.heading = 0
	ElseIf elapsed_frames = 20 Then
		directory = OS.get_environment("ASH_YARD_CAPTURE")
		If Len(directory) > 0 And DisplayServer.get_name() <> "headless" Then
			Check(yard.optics.back().get_texture().get_image().save_png(directory & "/backlight-yard.png") = 0, "backlight_yard_capture")
		End If
		yard.position_xz = Vector2(4, 60)
		yard.heading = -0.6
	ElseIf elapsed_frames = 24 Then
		directory = OS.get_environment("ASH_YARD_CAPTURE")
		If Len(directory) > 0 And DisplayServer.get_name() <> "headless" Then
			Check(yard.optics.back().get_texture().get_image().save_png(directory & "/press-halls.png") = 0, "backlight_yard_hall_capture")
		End If
		yard.position_xz = Vector2(-41, 27)
		yard.heading = 0
	ElseIf elapsed_frames = 28 Then
		Check(yard.yard_scenery.doors(0).position.distance_to(yard.yard_scenery.door_origins(0)) < 0.01, "backlight_yard_door_closed_from_distance")
		directory = OS.get_environment("ASH_YARD_CAPTURE")
		If Len(directory) > 0 And DisplayServer.get_name() <> "headless" Then
			Check(yard.optics.back().get_texture().get_image().save_png(directory & "/door-closed.png") = 0, "backlight_yard_closed_door_capture")
		End If
		yard.position_xz = Vector2(-41, 33)
	ElseIf elapsed_frames = 32 Then
		Check(yard.yard_scenery.doors(0).position.x < yard.yard_scenery.door_origins(0).x - 2.0, "backlight_yard_door_opens_on_approach")
		Check(yard.yard_scenery.doors(0).GetChild(0).position.x > 6.2, "backlight_yard_both_leaves_slide")
		directory = OS.get_environment("ASH_YARD_CAPTURE")
		If Len(directory) > 0 And DisplayServer.get_name() <> "headless" Then
			Check(yard.optics.back().get_texture().get_image().save_png(directory & "/door-open.png") = 0, "backlight_yard_open_door_capture")
		End If
		yard.position_xz = Vector2(0, 100)
		yard.inspection = 1
		game.clock = 7
	ElseIf elapsed_frames = 36 Then
		If DisplayServer.get_name() <> "headless" Then sky_before = view.viewport.get_texture().get_image()
		game.clock = 7.55
	ElseIf elapsed_frames = 40 Then
		If DisplayServer.get_name() <> "headless" Then
			image = view.viewport.get_texture().get_image()
			For y = 0 To 130
				For x = 0 To 959
					If image.get_pixel(x, y) <> sky_before.get_pixel(x, y) Then changed = changed + 1
				Next
			Next
			Check(changed > 20, "backlight_yard_animated_stars_and_meteor")
			directory = OS.get_environment("ASH_YARD_CAPTURE")
			If Len(directory) > 0 Then Check(yard.optics.back().get_texture().get_image().save_png(directory & "/night-sky.png") = 0, "backlight_yard_sky_capture")
		End If
		view.present(0, 1.8, 100, 0, 0.35, 420)
		yard.yard_scenery.sky_material.set_shader_parameter("sky_time", 7.0)
	ElseIf elapsed_frames = 44 Then
		If DisplayServer.get_name() <> "headless" Then sky_before = view.viewport.get_texture().get_image()
		yard.yard_scenery.sky_material.set_shader_parameter("sky_time", 7.55)
	ElseIf elapsed_frames = 48 Then
		If DisplayServer.get_name() <> "headless" Then
			image = view.viewport.get_texture().get_image()
			For y = 0 To 250
				For x = 0 To 959
					If image.get_pixel(x, y).r - sky_before.get_pixel(x, y).r > 0.2 Then changed = changed + 1
				Next
			Next
			Check(changed > 3, "backlight_yard_visible_meteor_streak")
			directory = OS.get_environment("ASH_YARD_CAPTURE")
			If Len(directory) > 0 Then Check(image.save_png(directory & "/celestial-sky.png") = 0, "backlight_yard_celestial_capture")
		End If
		view.present(0, 1.8, 9, 0, -0.025, 420)
		yard.shell_material.set_shader_parameter("yard_haze", 0.0)
		yard.light_material.set_shader_parameter("yard_haze", 0.0)
	ElseIf elapsed_frames = 52 Then
		If DisplayServer.get_name() <> "headless" Then fog_before = view.viewport.get_texture().get_image()
		directory = OS.get_environment("ASH_YARD_CAPTURE")
		If Len(directory) > 0 And DisplayServer.get_name() <> "headless" Then fog_before.save_png(directory & "/no-fog.png")
		yard.shell_material.set_shader_parameter("yard_haze", 1.0)
		yard.light_material.set_shader_parameter("yard_haze", 1.0)
	ElseIf elapsed_frames = 56 Then
		If DisplayServer.get_name() <> "headless" Then
			image = view.viewport.get_texture().get_image()
			For y = 190 To 310
				For x = 200 To 760
					If Abs(image.get_pixel(x, y).b - fog_before.get_pixel(x, y).b) > 0.015 Then changed = changed + 1
				Next
			Next
			Check(changed > 200, "backlight_yard_visible_distance_fog")
			changed = 0
			For y = 440 To 460
				For x = 100 To 180
					If Abs(image.get_pixel(x, y).b - fog_before.get_pixel(x, y).b) > 0.01 Then changed = changed + 1
				Next
			Next
			Check(changed = 0, "backlight_yard_fog_preserves_nearby_detail")
			directory = OS.get_environment("ASH_YARD_CAPTURE")
			If Len(directory) > 0 Then Check(image.save_png(directory & "/distance-fog.png") = 0, "backlight_yard_fog_capture")
		End If
	ElseIf elapsed_frames = 60 Then
		game.dev_i = 13
		game.WarpDev()
	ElseIf elapsed_frames = 68 Then
		Check(Not yard.visible And view.backlight_city <> yard, "backlight_yard_city_isolation")
		Check(view.backlight_city.buildings.size() = 24, "backlight_city_keeps_original_layout")
		Check(view.backlight_city.shell_material.get_shader_parameter("yard_haze") = 0.0, "backlight_city_keeps_original_haze")
		game.dev_i = 14
		game.WarpDev()
	ElseIf elapsed_frames = 76 Then
		Check(view.backlight_city = yard And yard.world.mesh.get_instance_id() = mesh_id, "backlight_yard_reuses_geometry")
		Check(yard.discovered.size() = 0 And Not yard.driving, "backlight_yard_reentry_resets_progress")
		game.opt_detail = 0
	ElseIf elapsed_frames = 80 Then
		Check(yard.shell_material.get_shader_parameter("yard_haze") = 1.0 And yard.yard_scenery.visible, "backlight_yard_atmosphere_and_doors_on_low_detail")
		game.dev_i = 3
		game.WarpDev()
	ElseIf elapsed_frames = 84 Then
		Check(Not yard.visible And view.camera.environment Is Nothing, "backlight_yard_restores_chapter_environment")
		Check(view.world_mesh.visible, "original_yard_still_available")
		Print "BACKLIGHT_YARD_RESULT=" & Str(checks - failures) & "/" & Str(checks)
		GetTree().quit(failures)
	End If
End Sub
