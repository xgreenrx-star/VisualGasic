Sub bleed_city_2_reset()
	Call EnsureInit()
	position_xz = Vector2(5, 9)
	heading = -0.18
	velocity = 0
	driving = False
	inspection = 0
	buggy_position = Vector2(0, 18)
	buggy_heading = 0
	collected = 0
	wheel_angle = 0
	steering = 0
	For Each bottle In AsArray(bottles)
		bottle.visible = True
	Next
End Sub

Sub backlight_city_reset()
	Call EnsureInit()
	bleed_city_2_reset()
	position_xz = Vector2(3.8, 4)
	heading = -0.06
	buggy_position = Vector2(0, 14)
End Sub

Sub reset()
	Call EnsureInit()
	backlight_city_reset()
	place = "surface"
	building_index = -1
	discovered.clear()
	inventory.clear()
	visited.clear()
	keypad = False
	sequence = ""
	floor_code = ""
	transit_left = 0
	awakening = False
	countdown = 255
	alarm_elapsed = 0
	damage_cooldown = 0
	shield = 100
	completed = False
	launch_elapsed = 0
	If ship_model <> Nothing Then
		ship_model.position.y = 0
	End If
	failed = False
	pending_room = True
	If audio <> Nothing Then
		audio.stop()
	End If
	If atmosphere <> Nothing Then
		atmosphere.fog_enabled = False
	End If
	notify("ZEN OFFLINE. Find a pressure regulator, ignition cell, and reflector coupler.")
End Sub

Function _freeze(ByVal view As Node, ByVal label As String) As MeshInstance3D
	Dim seen As Dictionary
	Dim unique_edges As PackedVector3Array
	Dim unique_colors As PackedColorArray
	Dim a As Vector3
	Dim b As Vector3
	Dim pair As Variant
	Dim instance As Variant
	Dim halo As ShaderMaterial
	Dim _t0 As Variant
	Call EnsureInit()
	seen = New Dictionary
	For i = 0 To (view.edges.size() - 1) Step 2
		a = view.edges(i)
		b = view.edges(i + 1)
		If a = b Then
			Continue For
		End If
		If a < b Then
			pair = Array(a, b)
		Else
			pair = Array(b, a)
		End If
		If seen.has(pair) Then
			Continue For
		End If
		seen(pair) = True
		unique_edges.append(a)
		unique_edges.append(b)
		unique_colors.append(view.edge_colors(i))
		unique_colors.append(view.edge_colors(i + 1))
	Next
	view.edges = unique_edges
	view.edge_colors = unique_colors
	instance = ClassDB.Instantiate("MeshInstance3D")
	instance.name = label
	instance.mesh = view._mesh()
	If neon = Nothing Then
		neon = view.line_material.duplicate()
		neon.set_shader_parameter("line_width", 1.05)
		halo = view.line_material.next_pass.duplicate()
		halo.set_shader_parameter("line_width", 4.5)
		neon.next_pass = halo
	End If
	If instance.mesh.get_surface_count() = 2 Then
		instance.mesh.surface_set_material(1, neon)
	End If
	view.vertices.clear()
	view.colors.clear()
	view.edges.clear()
	view.edge_colors.clear()
	add_child(instance)
	Return instance
End Function

Sub bleed_city_2_build(ByVal view As Node)
	Dim wheel_mesh As Variant
	Dim wheel As Variant
	Dim beam_material As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	_roads(view)
	_hall(view, Vector3(-31, 0, 12), 16, 24, 9, False)
	_hall(view, Vector3(15, 0, 15), 18, 22, 11, True)
	_hall(view, Vector3(-34, 0, 61), 19, 24, 12, True)
	_hall(view, Vector3(16, 0, 63), 18, 22, 8, False)
	_hall(view, Vector3(-31, 0, 117), 16, 23, 10, False)
	_hall(view, Vector3(16, 0, 119), 18, 22, 10, True)
	For Each side In Array(-1.0, 1.0)
		For Each z In Array(22.0, 73.0, 129.0)
			_refinery(view, Vector3(side * 46, 0, z), 2.8, 16 + FMod(z, 9), PINK)
			If z > 100 Then
				_t0 = AMBER
			Else
				_t0 = PINK
			End If
			_refinery(view, Vector3(side * 52, 0, z + 8), 2.2, 12, _t0)
			_pipe(view, Array(Vector3(side * 46, 14, z), Vector3(side * 39, 14, z), Vector3(side * 39, 6, z), Vector3(side * 31, 6, z)), 0.38, PINK)
			For Each dz In Array(0.0, 5.0, 10.0)
				_frame(view, Vector3(side * 40, 0, z + dz), 3.5, 9)
			Next
		Next
	Next
	_catwalk(view, Vector3(-40, 7, 43), Vector3(40, 7, 43), AMBER)
	_catwalk(view, Vector3(-39, 8, 93), Vector3(39, 8, 93), PINK)
	_shaft(view)
	_crane(view, Vector3(38, 0, 108))
	_dock(view, Vector3(-46, 0, 100))
	For Each x In Array(-22.0, -14.0)
		_refinery(view, Vector3(x, 0, 149), 3, 23, AMBER)
	Next
	world = _freeze(view, "DistrictGeometry")
	_buggy(view)
	vehicle = _freeze(view, "AirBuggy")
	_wheel(view)
	wheel_mesh = _freeze(view, "WheelPrototype")
	remove_child(wheel_mesh)
	For Each side In Array(-1.0, 1.0)
		For Each z In Array(-1.35, 1.4)
			wheel = ClassDB.Instantiate("MeshInstance3D")
			wheel.mesh = wheel_mesh.mesh
			wheel.position = Vector3(side * 1.12, 0.59, z)
			vehicle.add_child(wheel)
			wheels.append(wheel)
		Next
	Next
	wheel_mesh.free()
	For Each point In AsArray(BOTTLE_POSITIONS)
		_bottle(view, Transform3D(Basis(), point), 0.65)
		bottles.append(_freeze(view, "AirBottle"))
	Next
	_beam(view)
	beam = _freeze(view, "ShaftLight")
	beam_material = ClassDB.Instantiate("StandardMaterial3D")
	beam_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	beam_material.albedo_color = WHITE
	beam.mesh.surface_set_material(0, beam_material)
	initialized = True
End Sub

Sub backlight_city_build(ByVal view As Node)
	Dim z As Variant
	Dim x As Variant
	Dim wheel_mesh As Variant
	Dim wheel As Variant
	Dim cell As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	_materials()
	If yard_mode Then
		Dim yard_builder As Object
		yard_builder = SpawnVg("res://backlight_yard.vg", "RefCounted")
		yard_builder.build(Me, view)
	Else
	_box(Vector3(-62, -0.5, -16), Vector3(124, 0.5, 178), Color(0.07, 0.13, 0.18))
	For Each x In Array(-6.5, 6.5)
		_box(Vector3(x - 0.1, 0.006, -12), Vector3(0.20, 0.025, 166), ICE, True)
	Next
	For Each z In Array(36.0, 84.0, 132.0)
		For Each side In Array(-1.0, 1.0)
			_box(Vector3(-56, 0.01, z + side * 4), Vector3(112, 0.025, 0.17), ICE * 0.7, True)
		Next
	Next
	For Each z In Array(25.0, 73.0, 121.0)
		_gate(z)
	Next
	For Each side In Array(-1.0, 1.0)
		For i = 0 To (4 - 1)
			z = 10.0 + i * 35
			If side < 0 Then
				x = -52.0
			Else
				x = 24.0
			End If
			_building(Vector3(x, 0, z), Vector3(28, 15 + (i  Mod  3) * 7, 21), side, i)
		Next
		_monument(Vector3(side * 43, 0, 61))
	Next
	_plaza()
	_transit_court()
	End If
	world = _finish("SolidBacklitArchitecture")
	_courier()
	vehicle = _finish("ArcCourier")
	_cylinder(Vector3(0, 0, 0), 0.6, 0.34, INK, 0)
	For Each x In Array(-0.177, 0.177)
		_wheel_ring(x, 0.53, 0.105, ICE)
		_wheel_ring(x * 1.01, 0.22, 0.08, ICE * 0.7)
	Next
	wheel_mesh = _finish("WheelPrototype")
	For Each side In Array(-1.0, 1.0)
		For Each z In Array(-1.35, 1.4)
			wheel = ClassDB.Instantiate("MeshInstance3D")
			wheel.mesh = wheel_mesh.mesh
			wheel.position = Vector3(side * 1.12, 0.62, z)
			vehicle.add_child(wheel)
			wheels.append(wheel)
		Next
	Next
	wheel_mesh.queue_free()
	_carrier()
	carrier = _finish("DistrictCarrier")
	carrier.position = Vector3(-11, 1.4, 48)
	carrier.rotation.y = -0.25
	solids.append(Rect2(-14.5, 43, 7, 10))
	For Each point In AsArray(CELLS)
		_cell()
		cell = _finish("ChargeCell")
		cell.position = point
		bottles.append(cell)
	Next
	_create_optics(view)
	initialized = True
End Sub

Sub build(ByVal view As Node)
	Dim warning_shader As Variant
	Dim x As Variant
	Dim extension As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Dim _t3 As Variant
	Call EnsureInit()
	backlight_city_build(view)
	warning_shader = ClassDB.Instantiate("Shader")
	warning_shader = Load("res://shaders/backlight_exploration_06.gdshader")
	light_material.shader = warning_shader
	If Not yard_mode Then
	_box(Vector3(-118, -0.52, 162), Vector3(236, 0.5, 258), Color(0.07, 0.13, 0.18))
	For Each x In Array(-118.0, 62.0)
		_box(Vector3(x, -0.52, -12), Vector3(56, 0.5, 174), Color(0.07, 0.13, 0.18))
	Next
	For Each x In Array(-66.0, 0.0, 66.0)
		For Each side In Array(-1.0, 1.0)
			If x = 0 Then
				_t0 = 162
			Else
				_t0 = -12
			End If
			If x = 0 Then
				_t1 = 258
			Else
				_t1 = 432
			End If
			_box(Vector3(x + side * 6.5, 0.015, _t0), Vector3(0.16, 0.025, _t1), ICE * 0.8, True)
		Next
	Next
	For Each z In Array(185.0, 255.0, 325.0, 395.0)
		_gate(z)
		For Each side In Array(-1.0, 1.0)
			If side < 0 Then
				x = -52.0
			Else
				x = 24.0
			End If
			_building(Vector3(x, 0, z + 8), Vector3(28, 18 + FMod(z, 14), 23), side, 1)
		Next
	Next
	For Each z In Array(18.0, 108.0, 220.0, 330.0)
		For Each side In Array(-1.0, 1.0)
			If side < 0 Then
				_t3 = -112
			Else
				_t3 = 84
			End If
			_building(Vector3(_t3, 0, z), Vector3(26, 22, 24), side, 2)
		Next
	Next
	For Each z In Array(170.0, 240.0, 310.0, 380.0)
		For Each side In Array(-1.0, 1.0)
			_box(Vector3(-114, 0.016, z + side * 4), Vector3(228, 0.02, 0.12), ICE * 0.6, True)
		Next
	Next
	extension = _finish("ExpandedDistrict")
	extension.reparent(world)
	End If
	For Each z In Array(64.0, 205.0, 340.0)
		For Each side In Array(-1.0, 1.0)
			_turret(Vector2(side * 19, z))
		Next
	Next
	_ship()
	ship_model = _finish("StrandedAsh")
	ship_model.position = Vector3(SHIP.x, 0, SHIP.y)
	surface_solids = solids.duplicate()
	hud_view = ClassDB.Instantiate("SubViewport")
	hud_view.size = Vector2i(960, 540)
	hud_view.transparent_bg = True
	hud_view.disable_3d = True
	hud_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	view.add_child(hud_view)
	hud = SpawnVg("res://backlight_exploration_hud.vg", "Node2D")
	hud.city = Me
	hud_view.add_child(hud)
	_create_audio()
End Sub

Sub _road_strip(ByVal view As Node, ByVal center As Vector3, ByVal width As Single, ByVal length As Single, Optional across As Variant = False)
	Dim size As Variant
	Dim a As Variant
	Dim b As Variant
	Call EnsureInit()
	size = Vector3(width, 0.28, length)
	If across Then
		size = Vector3(length, 0.28, width)
	End If
	view.box(center - size * Vector3(0.5, 0, 0.5) - Vector3(0, 0.3, 0), size, CYAN * 0.27)
	For Each side In Array(-1.0, 1.0)
		For Each rail In Array(width * 0.5 - 0.1, width * 0.5 - 0.45)
			a = Vector3(side * rail, 0.015, -length * 0.5)
			b = Vector3(side * rail, 0.015, length * 0.5)
			If across Then
				a = Vector3(a.z, a.y, a.x)
				b = Vector3(b.z, b.y, b.x)
			End If
			view.segment(center + a, center + b, CYAN)
		Next
	Next
End Sub

Sub _roads(ByVal view As Node)
	Dim center As Variant
	Dim previous As Variant
	Dim angle As Variant
	Dim point As Vector3
	Call EnsureInit()
	' Separate strips leave the junction interiors clear of crossing edge lines.
	For Each x In Array(-36.0, 0.0, 36.0)
		For Each span In Array(Vector2(-12, 42), Vector2(54, 94), Vector2(106, 155))
			If x = 0 And span.x = 106 Then
				_road_strip(view, Vector3(0, 0, 136), 12, 38)
			ElseIf x = 0 And span.x = 54 Then
				_road_strip(view, Vector3(0, 0, 70), 12, 32)
			Else
				_road_strip(view, Vector3(x, 0, (span.x + span.y) / 2), 12, span.y - span.x)
			End If
		Next
	Next
	For Each z In Array(48.0, 100.0)
		If z = 100 Then
			For Each span In Array(Vector2(-42, -9), Vector2(9, 42))
				_road_strip(view, Vector3((span.x + span.y) / 2, -0.025, z), 12, span.y - span.x, True)
			Next
		Else
			_road_strip(view, Vector3(0, -0.025, z), 12, 84, True)
		End If
		For Each x In Array(-36.0, 0.0, 36.0)
			For Each side In Array(-1.0, 1.0)
				For Each end_n In Array(-1.0, 1.0)
					center = Vector3(x + side * 9, 0.03, z + end_n * 9)
					For Each inset In Array(0.0, 0.3)
						previous = center + Vector3(-side * (3 + inset), 0, 0)
						For i = 1 To (13 - 1)
							angle = i * PI * 0.5 / 12
							point = center + Vector3(-side * Cos(angle), 0, -end_n * Sin(angle)) * (3 + inset)
							view.segment(previous, point, CYAN)
							previous = point
						Next
					Next
				Next
			Next
		Next
	Next
	For z = -8 To (150 - 1) Step 5
		If Abs(z - 48) > 8 And Abs(z - 100) > 14 Then
			view.segment(Vector3(-0.1, 0.02, z), Vector3(-0.1, 0.02, z + 2), CYAN * 0.5)
		End If
	Next
	For z = 4 To (150 - 1) Step 20
		For Each x In Array(-6.8, 6.8)
			view.box(Vector3(x - 0.2, 0, z), Vector3(0.4, 0.65, 0.4), AMBER)
		Next
	Next
	' Piers and service ducts make the roadway a structure suspended in the void.
	For Each x In Array(-36.0, 0.0, 36.0)
		For z = 0 To (150 - 1) Step 12
			For Each side In Array(-1.0, 1.0)
				view.box(Vector3(x + side * 5 - 0.12, -7, z), Vector3(0.24, 6.7, 0.24), CYAN * 0.35)
			Next
			view.segment(Vector3(x - 5, -1.8, z), Vector3(x + 5, -1.8, z), CYAN * 0.4)
		Next
		_pipe(view, Array(Vector3(x - 4.5, -0.7, -10), Vector3(x - 4.5, -0.7, 86)), 0.18, CYAN * 0.6)
	Next
End Sub

Sub _strut(ByVal view As Node, ByVal a As Vector3, ByVal b As Vector3, ByVal width As Single, ByVal color As Color)
	Dim direction As Variant
	Dim up As Variant
	Dim right As Variant
	Dim basis As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	direction = b - a
	If Abs(direction.normalized().dot(Vector3(0, 1, 0))) > 0.95 Then
		up = Vector3(0, 0, -1)
	Else
		up = Vector3(0, 1, 0)
	End If
	right = up.cross(direction).normalized()
	basis = Basis(right, direction.normalized(), right.cross(direction).normalized())
	view.box(Vector3(-width / 2, 0, -width / 2), Vector3(width, direction.length(), width), color, Transform3D(basis, a))
End Sub

Sub _frame(ByVal view As Node, ByVal origin As Vector3, ByVal width As Single, ByVal height As Single)
	Dim y As Variant
	Call EnsureInit()
	For Each side In Array(-1.0, 1.0)
		_strut(view, origin + Vector3(side * width / 2, 0, 0), origin + Vector3(side * width / 2, height, 0), 0.18, PINK)
	Next
	For Each y In Array(0.3, height * 0.5, height)
		_strut(view, origin + Vector3(-width / 2, y, 0), origin + Vector3(width / 2, y, 0), 0.16, PINK)
	Next
	For level = 0 To (2 - 1)
		y = level * height / 2
		view.segment(origin + Vector3(-width / 2, y, 0), origin + Vector3(width / 2, y + height / 2, 0), PINK)
		view.segment(origin + Vector3(width / 2, y, 0), origin + Vector3(-width / 2, y + height / 2, 0), PINK)
	Next
End Sub

Sub _hall(ByVal view As Node, ByVal p As Vector3, ByVal width As Single, ByVal length As Single, ByVal height As Single, ByVal sawtooth As Boolean)
	Dim crest As Variant
	Dim a As Variant
	Dim b As Variant
	Dim peak As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Call EnsureInit()
	' An open doorway has actual side walls and a lintel, not a filled front plane.
	solids.append(Rect2(Vector2(p.x, p.z), Vector2(0.5, length)))
	solids.append(Rect2(Vector2(p.x + width - 0.5, p.z), Vector2(0.5, length)))
	solids.append(Rect2(Vector2(p.x, p.z + length - 0.5), Vector2(width, 0.5)))
	view.box(p, Vector3(0.35, height, length), PINK)
	view.box(p + Vector3(width - 0.35, 0, 0), Vector3(0.35, height, length), PINK)
	view.box(p + Vector3(0, 0, length - 0.35), Vector3(width, height, 0.35), PINK)
	view.box(p + Vector3(0, height - 2, 0), Vector3(width, 2, 0.4), PINK)
	For Each x In Array(0.0, width)
		For z = 0 To (Int(length) + 1 - 1) Step 4
			_strut(view, p + Vector3(x, 0, z), p + Vector3(x, height, z), 0.22, PINK)
			view.segment(p + Vector3(x, height * 0.45, z), p + Vector3(x, height, Min(z + 4, length)), PINK * 0.7)
		Next
	Next
	For z = 0 To (Int(length) - 1) Step 6
		If sawtooth Then
			_t0 = 2.8
		Else
			_t0 = 1.5
		End If
		crest = height + (_t0)
		a = p + Vector3(0, height, z)
		b = p + Vector3(width, height, z)
		If sawtooth Then
			_t1 = 0.8
		Else
			_t1 = 0.5
		End If
		peak = p + Vector3(width * (_t1), crest, z)
		For Each offset In Array(0.0, 6.0)
			view.segment(a + Vector3(0, 0, offset), peak + Vector3(0, 0, offset), PINK)
			view.segment(b + Vector3(0, 0, offset), peak + Vector3(0, 0, offset), PINK)
		Next
		view.face(a, peak, peak + Vector3(0, 0, 6), a + Vector3(0, 0, 6), PINK * 0.8)
		view.face(peak, b, b + Vector3(0, 0, 6), peak + Vector3(0, 0, 6), PINK * 0.8)
	Next
	view.box(p + Vector3(0.5, -0.15, 0.5), Vector3(width - 1, 0.15, length - 1), CYAN * 0.35)
	For Each x In Array(width * 0.2, width * 0.8)
		_bottle(view, Transform3D(Basis(), p + Vector3(x, 0.8, length * 0.65)), 1.2)
	Next
	' Door portal is amber; the rest of the structure remains magenta.
	_strut(view, p + Vector3(1, 0, 0.05), p + Vector3(1, height - 2, 0.05), 0.1, AMBER)
	_strut(view, p + Vector3(width - 1, 0, 0.05), p + Vector3(width - 1, height - 2, 0.05), 0.1, AMBER)
End Sub

Sub _tube(ByVal view As Node, ByVal a As Vector3, ByVal b As Vector3, ByVal radius As Single, ByVal color As Color, Optional ribs As Variant = 0)
	Dim direction As Variant
	Dim up As Variant
	Dim right As Variant
	Dim basis As Variant
	Dim transform As Variant
	Dim offset As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	direction = b - a
	If Abs(direction.normalized().dot(Vector3(0, 1, 0))) > 0.95 Then
		up = Vector3(0, 0, -1)
	Else
		up = Vector3(0, 1, 0)
	End If
	right = up.cross(direction).normalized()
	basis = Basis(right, direction.normalized(), right.cross(direction).normalized())
	transform = Transform3D(basis, a)
	view._cylinder(Vector3(0, 0, 0), radius, direction.length(), 1, color, transform)
	For i = 0 To (4 - 1)
		offset = Vector3(Cos(i * PI / 2), 0, Sin(i * PI / 2)) * radius
		view.segment(transform * offset, transform * (offset + Vector3(0, 1, 0) * direction.length()), color * 0.65)
	Next
	For i = 1 To (ribs + 1 - 1)
		view._ring(Vector3(0, direction.length() * i / (ribs + 1), 0), radius * 1.025, 1, color, transform)
	Next
End Sub

Sub _pipe(ByVal view As Node, ByVal points As Array, ByVal radius As Single, ByVal color As Color)
	Call EnsureInit()
	For i = 0 To (points.size() - 1 - 1)
		_tube(view, points(i), points(i + 1), radius, color)
		view._ring(Vector3(0, 0, 0), radius * 1.18, 1, color, Transform3D(Basis(), points(i)))
	Next
End Sub

Sub _refinery(ByVal view As Node, ByVal p As Vector3, ByVal radius As Single, ByVal height As Single, ByVal color As Color)
	Dim angle As Variant
	Dim edge As Variant
	Dim next_n As Variant
	Dim y As Variant
	Call EnsureInit()
	_tube(view, p + Vector3(0, 1, 0) * 2, p + Vector3(0, 1, 0) * height, radius, color, 6)
	For Each y In Array(2.0, height * 0.55, height)
		view._ring(p + Vector3(0, 1, 0) * y, radius + 0.25, 1, color, Transform3D())
	Next
	For i = 0 To (12 - 1)
		angle = 6.283185307179586 * i / 12
		edge = p + Vector3(Cos(angle) * radius, height, Sin(angle) * radius)
		next_n = p + Vector3(Cos(angle + 6.283185307179586 / 12) * radius, height, Sin(angle + 6.283185307179586 / 12) * radius)
		view.face(edge, next_n, p + Vector3(0, 1, 0) * (height + 1.5), p + Vector3(0, 1, 0) * (height + 1.5), color * 0.7)
	Next
	For Each side In Array(-1.0, 1.0)
		For Each z In Array(-1.0, 1.0)
			view.box(p + Vector3(side * radius * 0.65 - 0.12, 0, z * radius * 0.65 - 0.12), Vector3(0.24, 2, 0.24), color)
		Next
	Next
	For rung = 1 To (Int(height * 2) - 1)
		y = rung * 0.5
		view.segment(p + Vector3(-0.4, y, -radius - 0.3), p + Vector3(0.4, y, -radius - 0.3), color)
	Next
	For Each x In Array(-0.4, 0.4)
		view.segment(p + Vector3(x, 0.2, -radius - 0.3), p + Vector3(x, height, -radius - 0.3), color)
	Next
	solids.append(Rect2(Vector2(p.x - radius, p.z - radius), Vector2(1, 1) * radius * 2))
End Sub

Sub _catwalk(ByVal view As Node, ByVal a As Vector3, ByVal b As Vector3, ByVal color As Color)
	Call EnsureInit()
	view.box(a + Vector3(0, -0.25, -0.7), Vector3(b.x - a.x, 0.25, 1.4), color * 0.65)
	For Each side In Array(-1.0, 1.0)
		view.segment(a + Vector3(0, 1, side * 0.7), b + Vector3(0, 1, side * 0.7), color)
		For x = Int(a.x) To (Int(b.x) + 1 - 1) Step 2
			view.segment(Vector3(x, a.y, a.z + side * 0.7), Vector3(x, a.y + 1, a.z + side * 0.7), color)
		Next
	Next
	For Each x In Array(-12.0, 12.0)
		_strut(view, Vector3(x, 0, a.z), Vector3(x, a.y, a.z), 0.22, color)
	Next
End Sub

Sub _shaft(ByVal view As Node)
	Dim center As Variant
	Dim a As Variant
	Dim b As Variant
	Dim p As Variant
	Dim q As Variant
	Call EnsureInit()
	center = Vector3(0, -0.1, 100)
	For i = 0 To (48 - 1)
		a = 6.283185307179586 * i / 48
		b = 6.283185307179586 * (i + 1) / 48
		p = Vector3(Cos(a), 0, Sin(a))
		q = Vector3(Cos(b), 0, Sin(b))
		view.face(center + p * 9, center + q * 9, center + q * 6, center + p * 6, CYAN)
		view.face(center + p * 6, center + q * 6, center + q * 6 - Vector3(0, 1, 0) * 5, center + p * 6 - Vector3(0, 1, 0) * 5, CYAN * 0.6)
		If i  Mod  3 = 0 Then
			view.segment(center + p * 8.5, center + p * 8.5 + Vector3(0, 1, 0), CYAN)
			view.segment(center + p * 8.5 + Vector3(0, 1, 0), center + q * 8.5 + Vector3(0, 1, 0), CYAN)
		End If
	Next
	solids.append(Rect2(-6, 94, 12, 12))
	For Each z In Array(91.0, 109.0)
		_road_strip(view, Vector3(0, 0, z), 3, 24, True)
	Next
End Sub

Sub _beam(ByVal view As Node)
	Dim angle As Variant
	Dim offset As Variant
	Call EnsureInit()
	_tube(view, Vector3(0, -4, 100), Vector3(0, 64, 100), 0.48, WHITE)
	For i = 0 To (8 - 1)
		angle = i * 6.283185307179586 / 8
		offset = Vector3(Cos(angle), 0, Sin(angle)) * (0.9 + i * 0.15)
		view.segment(Vector3(0, 0, 100) + offset, Vector3(0, 58 - i * 3, 100) + offset, WHITE * 0.65)
	Next
	view._ring(Vector3(0, 0.05, 100), 5.5, 1, WHITE, Transform3D())
End Sub

Sub _crane(ByVal view As Node, ByVal p As Vector3)
	Call EnsureInit()
	_frame(view, p, 4, 13)
	_strut(view, p + Vector3(0, 13, 0), p + Vector3(-20, 15, 0), 0.4, AMBER)
	view.segment(p + Vector3(0, 16, 0), p + Vector3(-20, 15, 0), AMBER)
	_tube(view, p + Vector3(-19, 15, 0), p + Vector3(-19, 3, 0), 0.035, AMBER)
	view._ring(p + Vector3(-19, 3, 0), 0.5, 0, AMBER, Transform3D())
	view.box(p + Vector3(-2, 10, -1.5), Vector3(3, 2, 3), AMBER)
End Sub

Sub _dock(ByVal view As Node, ByVal p As Vector3)
	Dim outline As Variant
	Call EnsureInit()
	view.box(p + Vector3(-8, -0.5, -10), Vector3(16, 0.5, 21), CYAN * 0.45)
	solids.append(Rect2(Vector2(p.x - 5, p.z - 7), Vector2(10, 14)))
	' A tapered, closed hull with a raised canopy and paired engine pods.
	outline = PackedVector2Array(Array(Vector2(-1.1, 0.7), Vector2(-4.2, 0.8), Vector2(-4.2, 2), Vector2(-2.1, 3), Vector2(2.1, 3), Vector2(4.2, 2), Vector2(4.2, 0.8), Vector2(1.1, 0.7)))
	view._extrude(outline, 10, CYAN, Transform3D(Basis(), p + Vector3(0, 0, -5)))
	view.box(p + Vector3(-1.6, 2.7, -1), Vector3(3.2, 1.3, 4), CYAN)
	For Each side In Array(-1.0, 1.0)
		_tube(view, p + Vector3(side * 4.3, 2, -6), p + Vector3(side * 4.3, 2, 4), 1, CYAN, 4)
		_tube(view, p + Vector3(side * 4.3, 2, -6.05), p + Vector3(side * 4.3, 2, -5.9), 0.65, AMBER)
		_strut(view, p + Vector3(side * 2.5, 0, -4), p + Vector3(side * 2.5, 1, -4), 0.2, CYAN)
	Next
End Sub

Sub _bottle(ByVal view As Node, ByVal transform As Transform3D, ByVal scale As Single)
	Dim shaped As Variant
	Dim profile As Variant
	Dim angle As Variant
	Dim next_n As Variant
	Dim a As Variant
	Dim b As Variant
	Dim c As Variant
	Dim d As Variant
	Call EnsureInit()
	shaped = transform.scaled_local(Vector3(1, 1, 1) * scale)
	profile = PackedVector2Array(Array(Vector2(0, 0.1), Vector2(0.28, 0.12), Vector2(0.42, 0.28), Vector2(0.42, 1.4), Vector2(0.30, 1.62), Vector2(0.12, 1.77), Vector2(0, 1.77)))
	For i = 0 To (24 - 1)
		angle = 6.283185307179586 * i / 24
		next_n = 6.283185307179586 * (i + 1) / 24
		For j = 0 To (profile.size() - 1 - 1)
			a = Vector3(Cos(angle) * profile(j).x, profile(j).y, Sin(angle) * profile(j).x)
			b = Vector3(Cos(next_n) * profile(j).x, profile(j).y, Sin(next_n) * profile(j).x)
			c = Vector3(Cos(next_n) * profile(j + 1).x, profile(j + 1).y, Sin(next_n) * profile(j + 1).x)
			d = Vector3(Cos(angle) * profile(j + 1).x, profile(j + 1).y, Sin(angle) * profile(j + 1).x)
			For Each point In Array(a, b, c, a, c, d)
				view.vertices.append(shaped * point)
				view.colors.append(Color(0.016, 0.005, 0.014))
			Next
			If i  Mod  6 = 0 Then
				view.segment(shaped * a, shaped * d, PINK * 0.65)
			End If
		Next
	Next
	view._cylinder(Vector3(0, 1.77, 0), 0.12, 0.3, 1, CYAN, shaped)
	For Each y In Array(0.3, 0.42, 1.3, 1.4)
		view._ring(Vector3(0, y, 0), 0.45, 1, PINK, shaped)
	Next
	view._cylinder(Vector3(-0.3, 1.91, 0), 0.14, 0.6, 0, CYAN, shaped)
	view._ring(Vector3(0.36, 1.72, 0), 0.19, 0, AMBER, shaped)
End Sub

Sub _buggy(ByVal view As Node)
	Dim points As Variant
	Dim t As Variant
	Dim p As Variant
	Call EnsureInit()
	view.box(Vector3(-0.7, 0.44, -1.7), Vector3(1.4, 0.2, 3.4), PINK)
	view.box(Vector3(-0.6, 0.7, -0.5), Vector3(1.2, 0.5, 1.2), CYAN * 0.6)
	For Each side In Array(-1.0, 1.0)
		points = Array(Vector3(side * 0.7, 0.65, 1.7), Vector3(side * 0.7, 1.5, 0.75), Vector3(side * 0.65, 1.6, -0.65), Vector3(side * 0.8, 0.7, -1.55))
		_pipe(view, points, 0.055, PINK)
		_strut(view, points(0), points(3), 0.08, PINK)
		_strut(view, points(1), points(3), 0.065, PINK)
		For Each z In Array(-1.35, 1.4)
			_tube(view, Vector3(side * 0.48, 0.95, z * 0.8), Vector3(side * 1.05, 0.5, z), 0.07, CYAN)
			For rib = 0 To (9 - 1)
				t = rib / 8.0
				p = Vector3(side * LerpF(0.48, 1.05, t), LerpF(0.95, 0.5, t), LerpF(z * 0.8, z, t))
				view._ring(p, 0.12, 1, PINK, Transform3D())
			Next
			_pipe(view, Array(Vector3(0, 1.3, -1.25), Vector3(side * 0.6, 1.3, -1.4), Vector3(side * 1.0, 0.65, z)), 0.025, CYAN)
		Next
	Next
	For Each z In Array(-0.65, 0.75)
		_tube(view, Vector3(-0.7, 1.55, z), Vector3(0.7, 1.55, z), 0.055, PINK)
	Next
	_bottle(view, Transform3D(Basis(Vector3(1, 0, 0), PI / 2), Vector3(0, 1, -1.0)), 0.65)
	For Each x In Array(-0.38, 0.38)
		view.box(Vector3(x - 0.2, 0.65, -0.4), Vector3(0.4, 0.65, 0.5), PINK * 0.55)
		_tube(view, Vector3(x, 0.8, 1.6), Vector3(x, 0.8, 1.72), 0.16, AMBER)
	Next
	view._ring(Vector3(-0.38, 1.05, 0.8), 0.21, 1, CYAN, Transform3D())
	view.box(Vector3(-0.76, 0.45, 1.7), Vector3(1.52, 0.12, 0.12), CYAN)
End Sub

Sub _wheel(ByVal view As Node)
	Dim angle As Variant
	Call EnsureInit()
	view._cylinder(Vector3(-0.2, 0, 0), 0.55, 0.4, 0, PINK, Transform3D())
	For Each x In Array(-0.21, 0.21)
		view._ring(Vector3(x, 0, 0), 0.39, 0, CYAN, Transform3D(), True)
		view._ring(Vector3(x, 0, 0), 0.14, 0, CYAN, Transform3D())
	Next
	For i = 0 To (16 - 1)
		angle = i * 6.283185307179586 / 16
		view.segment(Vector3(-0.2, Cos(angle) * 0.55, Sin(angle) * 0.55), Vector3(0.2, Cos(angle + 0.1) * 0.55, Sin(angle + 0.1) * 0.55), PINK * 0.5)
	Next
End Sub

Function blocked(ByVal point As Vector2, ByVal radius As Single) As Boolean
	Dim bounds As Variant
	Dim obstacles As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Call EnsureInit()
	If place = "surface" Then
		bounds = CITY_BOUNDS
	Else
		bounds = Rect2(-22, 0, 44, 58)
	End If
	If Not bounds.grow(-radius).has_point(point) Then
		Return True
	End If
	If place = "surface" Then
		obstacles = surface_solids
	Else
		obstacles = interior_solids
	End If
	For Each rect In AsArray(obstacles)
		If rect.grow(radius).has_point(point) Then
			Return True
		End If
	Next
	Return False
End Function

Sub move_distance(ByVal distance As Single)
	Dim delta As Variant
	Dim steps As Variant
	Dim radius As Variant
	Dim step_n As Variant
	Dim x As Variant
	Dim z As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	delta = Vector2(Sin(heading), Cos(heading)) * distance
	steps = Max(1, CeilInt(delta.length() / 0.25))
	If driving Then
		radius = 1.4
	Else
		radius = 0.35
	End If
	For i = 0 To (steps - 1)
		step_n = delta / steps
		x = position_xz + Vector2(step_n.x, 0)
		If Not blocked(x, radius) Then
			position_xz = x
		End If
		z = position_xz + Vector2(0, step_n.y)
		If Not blocked(z, radius) Then
			position_xz = z
		End If
	Next
End Sub

Sub interact_vehicle()
	Dim exit_position As Vector2
	Call EnsureInit()
	If inspection <> 0 Then
		inspection = 0
	End If
	If driving Then
		For Each side In Array(1.0, -1.0)
			exit_position = buggy_position + Vector2(Cos(heading), -Sin(heading)) * side * 2.5
			If Not blocked(exit_position, 0.35) Then
				driving = False
				velocity = 0
				position_xz = exit_position
				Exit Sub
			End If
		Next
	ElseIf position_xz.distance_to(buggy_position) < 3.8 Then
		driving = True
		position_xz = buggy_position
		heading = buggy_heading
		velocity = 0
	End If
End Sub

Sub collect_bottle()
	Dim point As Vector3
	Call EnsureInit()
	If driving Then
		Exit Sub
	End If
	For i = 0 To (bottles.size() - 1)
		point = CELLS(i)
		If Not inventory.has("cell_" & Str(i)) And position_xz.distance_to(Vector2(point.x, point.z)) < 2.4 Then
			inventory("cell_%d" % i) = True
			bottles(i).visible = False
			collected = collected + 1
			notify("Recovered an auxiliary charge cell. Ship repair components are inside buildings.")
			Exit Sub
		End If
	Next
End Sub

Sub bleed_city_2_tick(ByVal delta As Single, ByVal view As Node)
	Dim turn As Variant
	Dim throttle As Variant
	Dim before As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Dim _t3 As Variant
	Call EnsureInit()
	If view.menu_tap(KEY_V) Then
		inspection = (inspection + 1)  Mod  3
	End If
	If view.menu_tap(KEY_F) Then
		interact_vehicle()
	End If
	If view.menu_tap(KEY_E) Then
		collect_bottle()
	End If
	If inspection <> 0 Then
		Exit Sub
	End If
	turn = Num(Input.is_physical_key_pressed(KEY_D) Or Input.is_key_pressed(KEY_D) Or Input.is_key_pressed(KEY_RIGHT))
	turn = turn - Num(Input.is_physical_key_pressed(KEY_A) Or Input.is_key_pressed(KEY_A) Or Input.is_key_pressed(KEY_LEFT))
	throttle = Num(Input.is_physical_key_pressed(KEY_W) Or Input.is_key_pressed(KEY_W) Or Input.is_key_pressed(KEY_UP))
	throttle = throttle - Num(Input.is_physical_key_pressed(KEY_S) Or Input.is_key_pressed(KEY_S) Or Input.is_key_pressed(KEY_DOWN))
	If driving Then
		_t0 = 1.3
	Else
		_t0 = 1.7
	End If
	heading = heading + turn * delta * (_t0)
	If driving Then
		_t1 = turn * 0.4
	Else
		_t1 = 0.0
	End If
	steering = MoveToward(steering, _t1, delta * 2)
	If driving Then
		If throttle > 0 Then
			_t2 = 18
		Else
			_t2 = 6
		End If
		If throttle <> 0 Then
			_t3 = 7
		Else
			_t3 = 5
		End If
		velocity = MoveToward(velocity, throttle * (_t2), delta * (_t3))
		before = position_xz
		move_distance(velocity * delta)
		If delta > 0 And position_xz.distance_to(before) < Abs(velocity * delta) * 0.2 Then
			velocity = 0
		End If
		buggy_position = position_xz
		buggy_heading = heading
		wheel_angle = wheel_angle + velocity * delta / 0.55
	Else
		move_distance(throttle * 4.5 * delta)
	End If
End Sub

Sub tick(ByVal delta As Single, ByVal view As Node)
	Dim turn As Variant
	Dim throttle As Variant
	Call EnsureInit()
	message_left = Max(0, message_left - delta)
	If completed Or failed Then
		If completed Then
			launch_elapsed = launch_elapsed + delta
		End If
		If view.menu_tap(KEY_ENTER) Then
			If failed Then
				retry_escape()
			Else
				reset()
			End If
		End If
		Exit Sub
	End If
	If awakening Then
		countdown = Max(0, countdown - delta)
		alarm_elapsed = alarm_elapsed + delta
		alarm_pulse = alarm_pulse - delta
		If alarm_pulse <= 0 Then
			alarm_pulse = 2
			audio.play()
		End If
		If countdown <= 0 Then
			failed = True
			audio.stop()
			notify("PURGE COMPLETE. Enter retries from the chamber checkpoint.")
			Exit Sub
		End If
	End If
	damage_cooldown = Max(0, damage_cooldown - delta)
	If transit_left > 0 Then
		transit_left = Max(0, transit_left - delta)
		If transit_left <= 0 Then
			finish_lift()
		End If
		Exit Sub
	End If
	If keypad Then
		For digit = 0 To (10 - 1)
			If view.menu_tap(KEY_0 + digit) Or view.menu_tap(KEY_KP_0 + digit) Then
				enter_symbol(Str(digit))
			End If
		Next
		If view.menu_tap(KEY_BACKSPACE) Then
			sequence = sequence.left(Max(0, sequence.length() - 1))
		End If
		If view.menu_tap(KEY_ENTER) Then
			submit_sequence()
		End If
		If view.menu_tap(KEY_F) Then
			keypad = False
		End If
		Exit Sub
	End If
	If view.menu_tap(KEY_E) Then
		use_object()
	End If
	If place = "surface" Then
		bleed_city_2_tick(delta, view)
	Else
		view.menu_tap(KEY_F)
		view.menu_tap(KEY_V)
		turn = Num(Input.is_key_pressed(KEY_D) Or Input.is_physical_key_pressed(KEY_D) Or Input.is_key_pressed(KEY_RIGHT))
		turn = turn - Num(Input.is_key_pressed(KEY_A) Or Input.is_physical_key_pressed(KEY_A) Or Input.is_key_pressed(KEY_LEFT))
		throttle = Num(Input.is_key_pressed(KEY_W) Or Input.is_physical_key_pressed(KEY_W) Or Input.is_key_pressed(KEY_UP))
		throttle = throttle - Num(Input.is_key_pressed(KEY_S) Or Input.is_physical_key_pressed(KEY_S) Or Input.is_key_pressed(KEY_DOWN))
		heading = heading + turn * delta * 1.7
		move_distance(throttle * 5.5 * delta)
	End If
	_tick_turrets(delta)
End Sub

Function render(ByVal view As Node, ByVal time_n As Single, ByVal distance As Single) As Texture2D
	Dim _t0 As Variant
	Dim _t1 As Variant
	Call EnsureInit()
	If Not initialized Then
		build(view)
	End If
	vehicle.position = Vector3(buggy_position.x, 0, buggy_position.y)
	vehicle.rotation.y = buggy_heading
	vehicle.visible = Not driving Or inspection <> 0
	For Each wheel In AsArray(wheels)
		wheel.rotation.x = wheel_angle
		If wheel.position.z > 0 Then
			_t0 = steering
		Else
			_t0 = 0
		End If
		wheel.rotation.y = _t0
	Next
	beam.scale.x = 1 + Sin(time_n * 2) * 0.05
	If inspection = 1 Then
		camera_position = Vector3(52, 43, -12)
		camera_heading = -0.59
		camera_pitch = -0.45
	ElseIf inspection = 2 Then
		camera_position = Vector3(buggy_position.x + 4.5, 3.2, buggy_position.y + 5)
		camera_heading = -2.4
		camera_pitch = -0.3
	Else
		camera_position = Vector3(position_xz.x, 1.65, position_xz.y)
		camera_heading = heading
		camera_pitch = -0.06
	End If
	If inspection = 0 Then
		_t1 = distance
	Else
		_t1 = Max(distance, 220)
	End If
	Return view.present(camera_position.x, camera_position.y, camera_position.z, camera_heading, camera_pitch, _t1)
End Function

Sub _triangle(ByVal a As Vector3, ByVal b As Vector3, ByVal c As Vector3, ByVal color As Color, ByVal lit As Boolean, ByVal normal As Vector3)
	Call EnsureInit()
	If lit Then
		light_points.append_array(PackedVector3Array(Array(a, b, c)))
		light_shades.append_array(PackedColorArray(Array(color, color, color)))
		light_normals.append_array(PackedVector3Array(Array(normal, normal, normal)))
	Else
		points.append_array(PackedVector3Array(Array(a, b, c)))
		shades.append_array(PackedColorArray(Array(color, color, color)))
		normals.append_array(PackedVector3Array(Array(normal, normal, normal)))
	End If
End Sub

Sub _quad(ByVal a As Vector3, ByVal b As Vector3, ByVal c As Vector3, ByVal d As Vector3, ByVal color As Color, Optional lit As Variant = False, Optional normal As Variant)
	If normal Is Nothing Then
		normal = Vector3(0, 0, 0)
	End If
	Call EnsureInit()
	If normal = Vector3(0, 0, 0) Then
		normal = (b - a).cross(c - a).normalized()
	End If
	_triangle(a, b, c, color, lit, normal)
	_triangle(a, c, d, color, lit, normal)
End Sub

Sub _box(ByVal p As Vector3, ByVal size As Vector3, ByVal color As Color, Optional lit As Variant = False, Optional transform As Variant)
	Dim corners As Array
	Dim directions As Variant
	Dim faces As Variant
	Dim f As Array
	If transform Is Nothing Then
		transform = Transform3D()
	End If
	Call EnsureInit()
	corners = Array()
	For Each v In Array(Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(1, 1, 0), Vector3(0, 1, 0), Vector3(0, 0, 1), Vector3(1, 0, 1), Vector3(1, 1, 1), Vector3(0, 1, 1))
		corners.append(transform * (p + v * size))
	Next
	directions = Array(Vector3(0, 0, -1), Vector3(0, 0, 1), Vector3(-1, 0, 0), Vector3(1, 0, 0), Vector3(0, 1, 0), Vector3(0, -1, 0))
	faces = Array(Array(0, 1, 2, 3), Array(4, 7, 6, 5), Array(0, 3, 7, 4), Array(1, 5, 6, 2), Array(3, 2, 6, 7), Array(0, 4, 5, 1))
	For i = 0 To (6 - 1)
		f = faces(i)
		_quad(corners(f(0)), corners(f(1)), corners(f(2)), corners(f(3)), color, lit, transform.basis * directions(i))
	Next
End Sub

Sub _trace(ByVal path As Array, ByVal width As Single, ByVal color As Color, Optional transform As Variant)
	Dim a As Vector3
	Dim b As Vector3
	Dim across As Variant
	If transform Is Nothing Then
		transform = Transform3D()
	End If
	Call EnsureInit()
	For i = 0 To (path.size() - 1 - 1)
		a = path(i)
		b = path(i + 1)
		across = Vector3(-(b.y - a.y), b.x - a.x, 0).normalized() * width * 0.5
		_quad(transform * (a - across), transform * (b - across), transform * (b + across), transform * (a + across), color, True)
	Next
End Sub

Sub _prism(ByVal profile As PackedVector2Array, ByVal depth As Single, ByVal color As Color, Optional transform As Variant)
	Dim center As Variant
	Dim a As Variant
	Dim q As Variant
	Dim b As Variant
	Dim edge As Variant
	Dim n As Variant
	Dim _t0 As Variant
	If transform Is Nothing Then
		transform = Transform3D()
	End If
	Call EnsureInit()
	center = Vector2(0, 0)
	For Each p In AsArray(profile)
		center = center + p / profile.size()
	Next
	For i = 0 To (profile.size() - 1)
		a = Vector3(profile(i).x, profile(i).y, 0)
		q = profile((i + 1)  Mod  profile.size())
		b = Vector3(q.x, q.y, 0)
		edge = q - profile(i)
		n = Vector3(edge.y, -edge.x, 0).normalized()
		_quad(transform * a, transform * b, transform * (b + Vector3(0, 0, depth)), transform * (a + Vector3(0, 0, depth)), color, False, transform.basis * n)
		For Each z In Array(0.0, depth)
			If z = 0 Then
				_t0 = Vector3(0, 0, -1)
			Else
				_t0 = Vector3(0, 0, 1)
			End If
			_triangle(transform * Vector3(center.x, center.y, z), transform * (a + Vector3(0, 0, z)), transform * (b + Vector3(0, 0, z)), color, False, transform.basis * (_t0))
		Next
	Next
End Sub

Sub _cylinder(ByVal center As Vector3, ByVal radius As Single, ByVal length As Single, ByVal color As Color, Optional axis As Variant = 1, Optional lit As Variant = False)
	Dim basis As Variant
	Dim a As Variant
	Dim b As Variant
	Dim p As Variant
	Dim q As Variant
	Dim cap As Vector3
	Dim _t0 As Variant
	Call EnsureInit()
	If axis = 1 Then
		basis = Basis()
	Else
		basis = Basis(Vector3(0, 0, -1), PI / 2)
	End If
	For i = 0 To (32 - 1)
		a = Vector3(Cos(i * 6.283185307179586 / 32), 0, Sin(i * 6.283185307179586 / 32))
		b = Vector3(Cos((i + 1) * 6.283185307179586 / 32), 0, Sin((i + 1) * 6.283185307179586 / 32))
		p = center + basis * (a * radius - Vector3(0, 1, 0) * length / 2)
		q = center + basis * (b * radius - Vector3(0, 1, 0) * length / 2)
		_quad(p, q, q + basis * Vector3(0, 1, 0) * length, p + basis * Vector3(0, 1, 0) * length, color, lit, basis * (a + b).normalized())
		For Each side In Array(-1.0, 1.0)
			cap = center + basis * Vector3(0, 1, 0) * length * side / 2
			_triangle(cap, cap + basis * a * radius, cap + basis * b * radius, color, lit, basis * Vector3(0, 1, 0) * side)
		Next
	Next
End Sub

Sub _wheel_ring(ByVal x As Single, ByVal radius As Single, ByVal width As Single, ByVal color As Color)
	Dim a As Variant
	Dim b As Variant
	Call EnsureInit()
	For i = 0 To (48 - 1)
		a = Vector3(0, Cos(i * 6.283185307179586 / 48), Sin(i * 6.283185307179586 / 48))
		b = Vector3(0, Cos((i + 1) * 6.283185307179586 / 48), Sin((i + 1) * 6.283185307179586 / 48))
		_quad(Vector3(x, 0, 0) + a * radius, Vector3(x, 0, 0) + b * radius, Vector3(x, 0, 0) + b * (radius - width), Vector3(x, 0, 0) + a * (radius - width), color, True)
	Next
End Sub

Function _finish(ByVal label As String) As MeshInstance3D
	Dim mesh As Variant
	Dim vertices_for_surface As Variant
	Dim arrays As Variant
	Dim instance As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Dim _t3 As Variant
	Call EnsureInit()
	mesh = ClassDB.Instantiate("ArrayMesh")
	For Each luminous In Array(False, True)
		If luminous Then
			vertices_for_surface = light_points
		Else
			vertices_for_surface = points
		End If
		If vertices_for_surface.is_empty() Then
			Continue For
		End If
		arrays = Array()
		arrays.resize(Mesh.ARRAY_MAX)
		arrays(Mesh.ARRAY_VERTEX) = vertices_for_surface
		If luminous Then
			_t1 = light_normals
		Else
			_t1 = normals
		End If
		arrays(Mesh.ARRAY_NORMAL) = _t1
		If luminous Then
			_t2 = light_shades
		Else
			_t2 = shades
		End If
		arrays(Mesh.ARRAY_COLOR) = _t2
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		If luminous Then
			_t3 = light_material
		Else
			_t3 = shell_material
		End If
		mesh.surface_set_material(mesh.get_surface_count() - 1, _t3)
	Next
	points.clear()
	shades.clear()
	normals.clear()
	light_points.clear()
	light_shades.clear()
	light_normals.clear()
	instance = ClassDB.Instantiate("MeshInstance3D")
	instance.name = label
	instance.mesh = mesh
	instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(instance)
	Return instance
End Function

Sub _materials()
	Dim shader As Variant
	Dim light_shader As Variant
	Dim sky As Variant
	Dim sky_shader As Variant
	Dim sky_material As Variant
	Call EnsureInit()
	shell_material = ClassDB.Instantiate("ShaderMaterial")
	shader = ClassDB.Instantiate("Shader")
	shader = Load("res://shaders/backlight_city_01.gdshader")
	shell_material.shader = shader
	light_material = ClassDB.Instantiate("ShaderMaterial")
	light_shader = ClassDB.Instantiate("Shader")
	light_shader = Load("res://shaders/backlight_city_02.gdshader")
	light_material.shader = light_shader
	atmosphere = ClassDB.Instantiate("Environment")
	atmosphere.background_mode = Environment.BG_SKY
	sky = ClassDB.Instantiate("Sky")
	sky_shader = ClassDB.Instantiate("Shader")
	sky_shader = Load("res://shaders/backlight_city_03.gdshader")
	sky_material = ClassDB.Instantiate("ShaderMaterial")
	sky_material.shader = sky_shader
	sky.sky_material = sky_material
	atmosphere.sky = sky
End Sub

Sub _gate(ByVal z As Single)
	Dim x As Single
	Dim transform As Variant
	Call EnsureInit()
	For Each side In Array(-1.0, 1.0)
		x = side * 13
		transform = Transform3D(Basis(), Vector3(x, 0, z))
		_prism(PackedVector2Array(Array(Vector2(-2.7, 0), Vector2(2.7, 0), Vector2(2.1, 10), Vector2(1.1, 14), Vector2(-1.1, 14), Vector2(-2.1, 10))), 3.4, SHELL, transform)
		solids.append(Rect2(x - 2.7, z, 5.4, 3.4))
		_box(Vector3(x - 1.6, 1.2, z - 0.03), Vector3(3.2, 8.5, 0.025), INK)
		For Each offset In Array(-0.9, 0.9)
			_trace(Array(Vector3(offset, 1.6, -0.06), Vector3(offset, 8.3, -0.06), Vector3(offset * 0.45, 9.6, -0.06), Vector3(offset * 0.45, 12, -0.06)), 0.14, GOLD, transform)
		Next
		For Each y In Array(2.0, 2.6, 3.2)
			_box(Vector3(x - 0.4, y, z - 0.07), Vector3(0.8, 0.19, 0.04), GOLD * 0.9, True)
		Next
	Next
	_box(Vector3(-15.3, 12, z), Vector3(30.6, 2.0, 3.4), SHELL)
	_box(Vector3(-10, 12.5, z - 0.04), Vector3(20, 0.9, 0.03), INK)
	For Each x In Array(-8.0, -4.0, 0.0, 4.0, 8.0)
		_box(Vector3(x - 1.4, 12.7, z - 0.08), Vector3(2.8, 0.44, 0.04), GOLD, True)
	Next
	_box(Vector3(-10, 11.9, z + 0.3), Vector3(20, 0.09, 2.8), ICE * 0.7, True)
End Sub

Sub backlight_city__building(ByVal p As Vector3, ByVal size As Vector3, ByVal side As Single, ByVal index As Integer)
	Dim face_x As Variant
	Dim lens_center As Variant
	Dim transform As Variant
	Dim x As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Call EnsureInit()
	' A recessed entrance is a real gap between two blocks, with a solid lintel.
	solids.append(Rect2(p.x, p.z + 3, size.x, size.z - 3))
	solids.append(Rect2(p.x, p.z, size.x * 0.38, 3))
	solids.append(Rect2(p.x + size.x * 0.62, p.z, size.x * 0.38, 3))
	_box(p + Vector3(0, 0, 3), size - Vector3(0, 0, 3), SHELL * (0.8 + index * 0.08))
	For Each offset In Array(0.0, size.x * 0.62)
		_box(p + Vector3(offset, 0, 0), Vector3(size.x * 0.38, size.y, 3), SHELL)
	Next
	_box(p + Vector3(size.x * 0.38, 4, 0), Vector3(size.x * 0.24, size.y - 4, 3), SHELL)
	_box(p + Vector3(size.x * 0.38, 0, 0), Vector3(size.x * 0.24, 0.02, 3), ICE * 0.28, True)
	For y = 6 To (Int(size.y - 2) - 1) Step 3
		If y  Mod  2 = 0 Then
			_t0 = 0.7
		Else
			_t0 = 0.45
		End If
		_box(p + Vector3(2, y, -0.04), Vector3(size.x - 4, 0.4, 0.04), ICE * (_t0), True)
	Next
	_box(p + Vector3(3, size.y, 4), Vector3(size.x - 6, 1.5, size.z - 6), INK)
	_box(p + Vector3(4, size.y + 1.51, 5), Vector3(size.x - 8, 0.02, size.z - 8), ICE * 0.24, True)
	If side < 0 Then
		face_x = p.x + size.x + 0.02
	Else
		face_x = p.x - 0.02
	End If
	lens_center = Vector3(face_x - side * 0.03, Min(size.y - 4, 9), p.z + size.z - 4)
	_cylinder(lens_center, 2.8, 0.16, SHELL * 0.65, 0)
	_cylinder(lens_center - Vector3(side * 0.10, 0, 0), 2.12, 0.18, ICE * 0.72, 0, True)
	If side < 0 Then
		_t2 = PI / 2
	Else
		_t2 = -PI / 2
	End If
	transform = Transform3D(Basis(Vector3(0, 1, 0), _t2), Vector3(face_x, 0, p.z + size.z * 0.5))
	For i = 0 To (5 - 1)
		x = -5.0 + i * 2.2
		_trace(Array(Vector3(x, 1.0, 0), Vector3(x, size.y * 0.35, 0), Vector3(x + 1, size.y * 0.35 + 1, 0), Vector3(x + 1, size.y * 0.74, 0)), 0.12, ICE * 0.85, transform)
		_box(Vector3(x + 0.7, size.y * 0.75, -0.015), Vector3(0.6, 0.8, 0.05), ICE, True, transform)
	Next
	For y = 4 To (Int(size.y) - 1) Step 4
		_trace(Array(Vector3(-size.z / 2, y, 0.025), Vector3(size.z / 2, y, 0.025)), 0.025, Color(0.12, 0.21, 0.30), transform)
	Next
	For Each x In Array(-8.0, -4.0, 0.0, 4.0, 8.0)
		_trace(Array(Vector3(x, 0.1, 0.025), Vector3(x, size.y - 0.1, 0.025)), 0.025, Color(0.12, 0.21, 0.30), transform)
	Next
End Sub

Sub _building(ByVal p As Vector3, ByVal size As Vector3, ByVal side As Single, ByVal index As Integer)
	Dim id As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Dim _t3 As Variant
	Dim _t4 As Variant
	Dim _t5 As Variant
	Call EnsureInit()
	backlight_city__building(p, size, side, index)
	id = buildings.size()
	_t3 = New Dictionary
	_t3("door") = Vector2(p.x + size.x * 0.5, p.z + 1.0)
	If id < 5 Then
		_t4 = "ARCHIVE " & PadInt(id + 1, 2)
	Else
		_t4 = (_t2)
	End If
	_t3("label") = _t4
	If id = 7 Then
		_t0 = "DEEP TRANSIT / ELEVATOR"
	Else
		_t0 = "ABANDONED BLOCK " & PadInt(id + 1, 2)
	End If
	If id = 6 Then
		_t1 = "IGNITION STORE"
	Else
		_t1 = (_t0)
	End If
	If id = 5 Then
		_t2 = "PRESSURE WORKSHOP"
	Else
		_t2 = (_t1)
	End If
	buildings.append(_t3)
	If id = 7 Then
		_t5 = GOLD
	Else
		_t5 = ICE
	End If
	_box(p + Vector3(size.x * 0.5 - 1.3, 4.2, -0.06), Vector3(2.6, 0.35, 0.06), _t5, True)
End Sub

Sub _transit_court()
	Dim center As Variant
	Dim transform As Variant
	Dim digit As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	For Each side In Array(-1.0, 1.0)
		For i = 0 To (2 - 1)
			center = Vector3(side * 10.2, 0, 95 + i * 16)
			transform = Transform3D(Basis(), center - Vector3(0, 0, 1.2))
			_prism(PackedVector2Array(Array(Vector2(-1.6, 0), Vector2(1.6, 0), Vector2(0.9, 3.2), Vector2(-0.9, 3.2))), 2.4, SHELL, transform)
			_box(center + Vector3(-1.05, 3.2, -1.4), Vector3(2.1, 0.26, 2.8), INK)
			_box(center + Vector3(-0.67, 1.5, -1.22), Vector3(1.34, 1.15, 0.025), INK)
			If side > 0 Then
				_t0 = 2
			Else
				_t0 = 0
			End If
			digit = 1 + i + (_t0)
			_digit(center + Vector3(-0.30, 1.62, -1.25), digit)
			solids.append(Rect2(center.x - 1.6, center.z - 1.2, 3.2, 2.4))
			_annulus(center + Vector3(0, 5.5, 0), 1.45, 0.14, GOLD)
			_trace(Array(Vector3(-0.36, 6.3, 0), Vector3(0, 6.72, 0), Vector3(0.36, 6.3, 0)), 0.10, GOLD, Transform3D(Basis(), center))
			_box(center + Vector3(-0.05, 5.9, 0), Vector3(0.1, 0.7, 0.05), GOLD, True)
		Next
		_box(Vector3(side * 10.2 - 0.14, 0.012, 89), Vector3(0.28, 0.025, 31), GOLD * 0.75, True)
	Next
End Sub

Sub _annulus(ByVal center As Vector3, ByVal radius As Single, ByVal width As Single, ByVal color As Color)
	Dim a As Variant
	Dim b As Variant
	Dim p As Variant
	Call EnsureInit()
	For i = 0 To (64 - 1)
		a = Vector3(Cos(i * 6.283185307179586 / 64), 0, Sin(i * 6.283185307179586 / 64))
		b = Vector3(Cos((i + 1) * 6.283185307179586 / 64), 0, Sin((i + 1) * 6.283185307179586 / 64))
		For Each y In Array(-0.08, 0.08)
			p = center + Vector3(0, y, 0)
			_quad(p + a * radius, p + b * radius, p + b * (radius - width), p + a * (radius - width), color, True)
		Next
		_quad(center + a * radius - Vector3(0, 1, 0) * 0.08, center + b * radius - Vector3(0, 1, 0) * 0.08, center + b * radius + Vector3(0, 1, 0) * 0.08, center + a * radius + Vector3(0, 1, 0) * 0.08, color, True)
	Next
End Sub

Sub _digit(ByVal p As Vector3, ByVal number As Integer)
	Dim segments As Variant
	Dim bars As Variant
	Dim rect As Rect2
	Dim _t0 As Variant
	Call EnsureInit()
	segments = Array("", "bc", "abged", "abgcd", "fgbc")
	bars = New Dictionary
	bars("a") = Rect2(0, 0.85, 0.6, 0.08)
	bars("b") = Rect2(0.52, 0.45, 0.08, 0.4)
	bars("c") = Rect2(0.52, 0.05, 0.08, 0.4)
	bars("d") = Rect2(0, 0, 0.6, 0.08)
	bars("e") = Rect2(0, 0.05, 0.08, 0.4)
	bars("f") = Rect2(0, 0.45, 0.08, 0.4)
	bars("g") = Rect2(0, 0.43, 0.6, 0.08)
	For Each segment In AsArray(segments(number))
		rect = bars(segment)
		_box(p + Vector3(rect.position.x, rect.position.y, 0), Vector3(rect.size.x, rect.size.y, 0.03), GOLD * 0.85, True)
	Next
End Sub

Sub _monument(ByVal p As Vector3)
	Call EnsureInit()
	_cylinder(p + Vector3(0, 2, 0), 5.2, 4, SHELL)
	_cylinder(p + Vector3(0, 11, 0), 3.7, 16, INK)
	For Each y In Array(4.0, 6.0, 9.0, 12.0, 15.0, 19.0)
		_cylinder(p + Vector3(0, y, 0), 3.85, 0.32, ICE, 1, True)
	Next
	_cylinder(p + Vector3(0, 24, 0), 1.6, 10, SHELL)
	_cylinder(p + Vector3(0, 29.1, 0), 1.65, 0.18, GOLD, 1, True)
	solids.append(Rect2(p.x - 5.2, p.z - 5.2, 10.4, 10.4))
End Sub

Sub _plaza()
	Call EnsureInit()
	For Each x In Array(-14.0, 14.0)
		For Each z In Array(8.0, 42.0, 89.0, 145.0)
			_box(Vector3(x - 0.5, 0, z), Vector3(1, 1.8, 1), INK)
			_box(Vector3(x - 0.36, 1.5, z - 0.025), Vector3(0.72, 0.22, 1.05), ICE, True)
			solids.append(Rect2(x - 0.5, z, 1, 1))
		Next
	Next
	_box(Vector3(-9, 0, 145), Vector3(18, 0.4, 6), SHELL)
	For Each x In Array(-5.0, 0.0, 5.0)
		_box(Vector3(x - 1, 0.4, 147), Vector3(2, 4.5, 2), INK)
		_box(Vector3(x - 0.7, 1, 146.98), Vector3(1.4, 2.8, 0.03), GOLD, True)
	Next
	solids.append(Rect2(-9, 145, 18, 6))
End Sub

Sub _courier()
	Dim path As Array
	Call EnsureInit()
	_box(Vector3(-0.72, 0.42, -1.75), Vector3(1.44, 0.21, 3.5), SHELL)
	_box(Vector3(-0.68, 0.66, -1.5), Vector3(1.36, 0.35, 0.7), INK)
	For Each side In Array(-1.0, 1.0)
		path = Array(Vector3(side * 0.8, 0.65, -1.65), Vector3(side * 0.68, 1.85, -0.65), Vector3(side * 0.7, 1.85, 0.65), Vector3(side * 0.8, 0.65, 1.7))
		For i = 0 To (3 - 1)
			_bar(path(i), path(i + 1), 0.075, SHELL)
			_bar(path(i) + Vector3(0, 0.015, 0), path(i + 1) + Vector3(0, 0.015, 0), 0.025, ICE, True)
		Next
		_bar(path(0), path(3), 0.09, SHELL)
		_bar(path(0), path(2), 0.05, SHELL)
		For Each z In Array(-1.35, 1.4)
			_bar(Vector3(side * 0.4, 0.9, z * 0.8), Vector3(side * 1.1, 0.55, z), 0.075, SHELL)
			For coil = 0 To (7 - 1)
				_cylinder(Vector3(side * (0.58 + coil * 0.05), 0.82 - coil * 0.035, z), 0.13, 0.045, ICE, 1, True)
			Next
		Next
		_box(Vector3(side * 0.4 - 0.19, 0.65, -0.35), Vector3(0.38, 0.58, 0.55), SHELL * 0.65)
		_box(Vector3(side * 0.5 - 0.18, 0.83, 1.72), Vector3(0.36, 0.14, 0.07), ICE, True)
	Next
	For Each z In Array(-0.65, 0.65)
		_bar(Vector3(-0.68, 1.85, z), Vector3(0.68, 1.85, z), 0.075, SHELL)
	Next
	_cylinder(Vector3(0, 1.15, -1.12), 0.27, 1.1, SHELL, 0)
	For Each x In Array(-0.48, 0.48)
		_cylinder(Vector3(x, 1.15, -1.12), 0.28, 0.075, ICE, 0, True)
	Next
	_box(Vector3(-0.65, 1.05, 0.7), Vector3(1.3, 0.2, 0.25), INK)
	_bar(Vector3(-0.78, 0.47, 1.86), Vector3(0.78, 0.47, 1.86), 0.12, SHELL)
End Sub

Sub _carrier()
	Dim profile As Variant
	Dim transform As Variant
	Call EnsureInit()
	profile = PackedVector2Array(Array(Vector2(-2.5, 0.0), Vector2(2.5, 0.0), Vector2(3.1, 0.7), Vector2(2.7, 2.1), Vector2(1.7, 2.8), Vector2(-1.7, 2.8), Vector2(-2.7, 2.1), Vector2(-3.1, 0.7)))
	_prism(profile, 7.2, SHELL * 0.8, Transform3D(Basis(), Vector3(0, 0, -3.6)))
	_box(Vector3(-1.6, 1.55, 3.61), Vector3(3.2, 0.8, 0.03), INK)
	_box(Vector3(-1.6, 1.55, -3.65), Vector3(3.2, 0.8, 0.03), INK)
	For Each z In Array(-3.67, 3.67)
		For Each side In Array(-1.0, 1.0)
			_trace(Array(Vector3(side * 2.2, 0.5, z), Vector3(side * 1.4, 0.5, z), Vector3(side * 0.9, 1.1, z), Vector3(side * 0.9, 2.45, z)), 0.16, GOLD)
		Next
		For Each x In Array(-0.5, 0.0, 0.5)
			_box(Vector3(x - 0.12, 1.7, z - 0.01), Vector3(0.24, 0.42, 0.03), GOLD * 0.85, True)
		Next
	Next
	For Each side In Array(-1.0, 1.0)
		transform = Transform3D(Basis(Vector3(0, 1, 0), side * PI / 2), Vector3(side * 2.9, 0, 0))
		_trace(Array(Vector3(-2.6, 0.65, 0.06), Vector3(-1.4, 0.65, 0.06), Vector3(-0.8, 1.3, 0.06), Vector3(1.3, 1.3, 0.06), Vector3(2, 1.9, 0.06)), 0.18, GOLD, transform)
		_box(Vector3(side * 2.0 - 0.4, -0.16, -3.0), Vector3(0.8, 0.12, 6), GOLD * 0.8, True)
		_box(Vector3(side * 1.2 - 0.3, 1.3, 3.66), Vector3(0.6, 0.16, 0.04), GOLD, True)
	Next
	For Each z In Array(-2.8, -2.1, -1.4, -0.7)
		_box(Vector3(-1.6, 2.81, z), Vector3(3.2, 0.03, 0.23), GOLD * 0.8, True)
	Next
End Sub

Sub _cell()
	Call EnsureInit()
	_cylinder(Vector3(0, 0.15, 0), 0.42, 0.3, SHELL)
	_cylinder(Vector3(0, 0.7, 0), 0.28, 0.9, INK)
	For Each y In Array(0.35, 0.53, 0.71, 0.89, 1.07)
		_cylinder(Vector3(0, y, 0), 0.295, 0.07, ICE, 1, True)
	Next
	_cylinder(Vector3(0, 1.23, 0), 0.34, 0.18, SHELL)
	_cylinder(Vector3(0, 1.35, 0), 0.13, 0.08, GOLD, 1, True)
End Sub

Function _effect(ByVal view As Node, ByVal size As Vector2i, ByVal code As Variant, ByVal texture As Texture2D) As SubViewport
	Dim target As Variant
	Dim canvas As Variant
	Dim material As Variant
	Dim shader As Variant
	Call EnsureInit()
	target = ClassDB.Instantiate("SubViewport")
	target.size = size
	target.disable_3d = True
	target.render_target_update_mode = SubViewport.UPDATE_DISABLED
	view.add_child(target)
	canvas = ClassDB.Instantiate("TextureRect")
	canvas.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	canvas.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	canvas.size = Vector2(size)
	canvas.texture = texture
	material = ClassDB.Instantiate("ShaderMaterial")
	' Load() of a .gdshader is a Shader resource. Assigning that resource to a
	' String parameter stringifies it, and shader.code then holds the resource
	' description. A string is still source text for the inline-shader path.
	If VarType(code) = 8 Then
		shader = ClassDB.Instantiate("Shader")
		shader.code = code
	Else
		shader = code
	End If
	material.shader = shader
	canvas.material = material
	target.add_child(canvas)
	optics.append(target)
	Return target
End Function

Sub _create_optics(ByVal view As Node)
	Dim blur As Variant
	Dim horizontal As Variant
	Dim horizontal_material As ShaderMaterial
	Dim vertical As Variant
	Dim vertical_material As ShaderMaterial
	Dim composite As Variant
	Dim output_n As Variant
	Call EnsureInit()
	blur = Load("res://shaders/backlight_city_04.gdshader")
	horizontal = _effect(view, Vector2i(320, 180), blur, view.viewport.get_texture())
	horizontal_material = horizontal.get_child(0).material
	horizontal_material.set_shader_parameter("threshold", True)
	horizontal_material.set_shader_parameter("direction", Vector2(3, 0))
	vertical = _effect(view, Vector2i(320, 180), blur, horizontal.get_texture())
	vertical_material = vertical.get_child(0).material
	vertical_material.set_shader_parameter("direction", Vector2(0, 1))
	composite = Load("res://shaders/backlight_city_05.gdshader")
	output_n = _effect(view, view.viewport.size, composite, view.viewport.get_texture())
	optical_material = output_n.get_child(0).material
	optical_material.set_shader_parameter("halo_texture", vertical.get_texture())
	dashboard_view = ClassDB.Instantiate("SubViewport")
	dashboard_view.size = view.viewport.size
	dashboard_view.transparent_bg = True
	dashboard_view.disable_3d = True
	dashboard_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	view.add_child(dashboard_view)
	dashboard = SpawnVg("res://backlight_cockpit.vg", "Node2D")
	dashboard_view.add_child(dashboard)
End Sub

Sub backlight_city_deactivate()
	Call EnsureInit()
	Me.visible = False
	For Each output_n In AsArray(optics)
		output_n.render_target_update_mode = SubViewport.UPDATE_DISABLED
	Next
	If dashboard_view <> Nothing Then
		dashboard_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	End If
End Sub

Sub deactivate()
	Call EnsureInit()
	backlight_city_deactivate()
	If hud_view <> Nothing Then
		hud_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	End If
End Sub

Function backlight_city_render_style(ByVal view As Node, ByVal time_n As Single, ByVal distance As Single, ByVal detail As Integer) As Texture2D
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Dim _t3 As Variant
	Dim _t4 As Variant
	Call EnsureInit()
	If Not initialized Then
		build(view)
	End If
	Me.visible = True
	If view.viewport.transparent_bg Then
		view.viewport.transparent_bg = False
	End If
	If view.camera.environment <> atmosphere Then
		view.camera.environment = atmosphere
	End If
	If detail = 0 Then
		antialiasing = Viewport.MSAA_DISABLED
	Else
		antialiasing = Viewport.MSAA_2X
	End If
	vehicle.position = Vector3(buggy_position.x, 0, buggy_position.y)
	vehicle.rotation.y = buggy_heading
	vehicle.visible = Not driving Or inspection <> 0
	For Each wheel In AsArray(wheels)
		wheel.rotation.x = wheel_angle
		If wheel.position.z > 0 Then
			_t1 = steering
		Else
			_t1 = 0
		End If
		wheel.rotation.y = _t1
	Next
	carrier.position.y = 1.4 + Sin(time_n * 0.8) * 0.07
	If inspection = 1 Then
		camera_position = Vector3(44, 35, -16)
		camera_heading = -0.48
		camera_pitch = -0.27
	ElseIf inspection = 2 Then
		camera_position = Vector3(buggy_position.x + 4.6, 2.9, buggy_position.y + 5.3)
		camera_heading = -2.43
		camera_pitch = -0.20
	Else
		If driving Then
			_t2 = 1.62
		Else
			_t2 = 1.8
		End If
		camera_position = Vector3(position_xz.x, _t2, position_xz.y)
		camera_heading = heading
		camera_pitch = -0.025
	End If
	If inspection = 0 Then
		_t3 = distance
	Else
		_t3 = Max(distance, 240)
	End If
	view.present(camera_position.x, camera_position.y, camera_position.z, camera_heading, camera_pitch, _t3)
	If detail = 0 Then
		Return view.viewport.get_texture()
	End If
	For Each output_n In AsArray(optics)
		output_n.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	Next
	If detail = 1 Then
		_t4 = 0.62
	Else
		_t4 = 0.85
	End If
	optical_material.set_shader_parameter("glow_amount", _t4)
	optical_material.set_shader_parameter("film_time", Floor(time_n * 24))
	Return optics.back().get_texture()
End Function

Function render_style(ByVal view As Node, ByVal time_n As Single, ByVal distance As Single, ByVal detail As Integer) As Texture2D
	Dim result As Variant
	Dim outdoors As Variant
	Dim index As Variant
	Dim opening As Variant
	Dim elapsed As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Dim _t3 As Variant
	Dim _t4 As Variant
	Dim _t5 As Variant
	Call EnsureInit()
	If Not initialized Then
		build(view)
	End If
	visual_time = time_n
	If awakening And FMod(alarm_elapsed, 1.0) < 0.15 Then
		_t0 = 1.0
	Else
		_t0 = 0.0
	End If
	light_material.set_shader_parameter("warning_flash", _t0)
	_sync_room()
	' The base renderer still owns the cached optical pipeline and camera.
	result = backlight_city_render_style(view, time_n, distance, detail)
	outdoors = place = "surface"
	world.visible = outdoors
	carrier.visible = outdoors
	vehicle.visible = outdoors And (Not driving Or inspection <> 0)
	For Each child In AsArray(get_children())
		If child.IsClass("MeshInstance3D") And child <> world And child <> vehicle And Not wheels.has(child) Then
			child.visible = outdoors
		End If
	Next
	For Each bottle In AsArray(bottles)
		index = bottles.find(bottle)
		bottle.visible = outdoors And Not inventory.has("cell_" & Str(index))
	Next
	For Each turret In AsArray(turrets)
		turret.visible = outdoors
	Next
	For i = 0 To (turret_beams.size() - 1)
		turret_beams(i).visible = outdoors And turret_flashes(i) > 0
	Next
	interior.visible = Not outdoors
	atmosphere.fog_enabled = awakening And Not outdoors
	atmosphere.fog_light_color = Color(0.12, 0.22, 0.28)
	If awakening Then
		_t1 = 0.012
	Else
		_t1 = 0
	End If
	atmosphere.fog_density = _t1
	If Not outdoors Then
		If place = "floor" And floor_code = FEB_CODE Then
			_t2 = 0.09
		Else
			_t2 = -0.03
		End If
		view.present(position_xz.x, 1.8, position_xz.y, heading, _t2, 90)
	End If
	If inspection = 1 And outdoors Then
		view.present(106, 96, -30, -0.29, -0.28, 520)
	End If
	If completed Then
		ship_model.position.y = Min(launch_elapsed * launch_elapsed * 0.6, 80)
		view.present(13, 7, -18, -0.78, 0.12, 180)
	End If
	If pod_figure <> Nothing Then
		If awakening Then
			_t3 = Sin(alarm_elapsed * 0.8) * Min(alarm_elapsed / 60, 0.18)
		Else
			_t3 = 0
		End If
		pod_figure.rotation.y = _t3
		If awakening Then
			_t4 = Min(alarm_elapsed / 120, 0.15)
		Else
			_t4 = 0
		End If
		pod_figure.position.y = _t4
	End If
	If mist <> Nothing Then
		mist.visible = awakening
		mist.material_override.set_shader_parameter("alarm_time", alarm_elapsed)
	End If
	For i = 0 To (lift_doors.size() - 1)
		opening = 1.0
		If transit_left > 0 Then
			elapsed = transit_total - transit_left
			opening = Max(1 - elapsed * 2, 1 - transit_left * 2)
		End If
		If i = 0 Then
			_t5 = -1
		Else
			_t5 = 1
		End If
		lift_doors(i).position.x = (_t5) * ClampF(opening, 0, 1) * 1.5
	Next
	hud.queue_redraw()
	hud_view.render_target_update_mode = SubViewport.UPDATE_ONCE
	Return result
End Function

Function cockpit_texture(ByVal time_n As Single) As Texture2D
	Call EnsureInit()
	dashboard.time = time_n
	dashboard.speed = velocity
	dashboard.heading = heading
	dashboard.charge = collected
	dashboard.queue_redraw()
	dashboard_view.render_target_update_mode = SubViewport.UPDATE_ONCE
	Return dashboard_view.get_texture()
End Function

Sub notify(ByVal text As String)
	Call EnsureInit()
	message = text
	message_left = 7
End Sub

Sub _bar(ByVal a As Vector3, ByVal b As Vector3, ByVal width As Single, ByVal color As Color, Optional lit As Variant = False)
	Dim direction As Variant
	Dim up As Variant
	Dim right As Variant
	Dim basis As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	direction = b - a
	If Abs(direction.normalized().dot(Vector3(0, 1, 0))) > 0.95 Then
		up = Vector3(0, 0, -1)
	Else
		up = Vector3(0, 1, 0)
	End If
	right = up.cross(direction).normalized()
	basis = Basis(right, direction.normalized(), right.cross(direction).normalized())
	_box(Vector3(-width / 2, 0, -width / 2), Vector3(width, direction.length(), width), color, lit, Transform3D(basis, a))
End Sub

Sub _ship()
	Call EnsureInit()
	_prism(PackedVector2Array(Array(Vector2(-5, 0.7), Vector2(5, 0.7), Vector2(3.2, 2.2), Vector2(1.8, 3.8), Vector2(-1.8, 3.8), Vector2(-3.2, 2.2))), 7, SHELL, Transform3D(Basis(), Vector3(0, 0, -3.5)))
	_box(Vector3(-1.5, 2.3, 3.52), Vector3(3, 0.7, 0.05), INK)
	For Each side In Array(-1.0, 1.0)
		_box(Vector3(side * 3.3 - 0.6, 0, -2), Vector3(1.2, 1.0, 4), SHELL)
		_box(Vector3(side * 3.0 - 0.2, 1.2, 3.55), Vector3(0.4, 0.4, 0.03), GOLD, True)
	Next
End Sub

Sub _turret(ByVal point As Vector2)
	Dim base As Variant
	Dim gun As Variant
	Dim flash As Variant
	Call EnsureInit()
	_cylinder(Vector3(0, 0.5, 0), 1.5, 1, SHELL)
	_cylinder(Vector3(0, 1.5, 0), 0.65, 1.5, INK)
	base = _finish("TurretPlinth")
	base.position = Vector3(point.x, 0, point.y)
	_box(Vector3(-1.2, 2.1, -0.7), Vector3(2.4, 0.8, 1.5), SHELL)
	For Each x In Array(-0.7, 0.7)
		_box(Vector3(x - 0.16, 2.3, 0.8), Vector3(0.32, 0.32, 2.3), INK)
		_box(Vector3(x - 0.11, 2.34, 3.11), Vector3(0.22, 0.22, 0.04), GOLD, True)
	Next
	gun = _finish("SweepingTurret")
	gun.position = base.position
	_bar(Vector3(0, 2.45, 3.2), Vector3(0, 2.45, 30), 0.035, GOLD, True)
	flash = _finish("TurretPulse")
	flash.reparent(gun)
	flash.position = Vector3(0, 0, 0)
	flash.visible = False
	turret_beams.append(flash)
	turrets.append(gun)
	turret_flashes.append(0)
	solids.append(Rect2(point.x - 1.5, point.y - 1.5, 3, 3))
End Sub

Sub _create_audio()
	Dim samples As PackedByteArray
	Dim t As Variant
	Dim envelope As Variant
	Dim value As Variant
	Call EnsureInit()
	audio = ClassDB.Instantiate("AudioStreamPlayer")
	audio.volume_db = -20
	add_child(audio)
	alarm_stream = ClassDB.Instantiate("AudioStreamWAV")
	alarm_stream.format = AudioStreamWAV.FORMAT_16_BITS
	alarm_stream.mix_rate = 22050
	samples.resize(11025 * 2)
	For i = 0 To (11025 - 1)
		t = Num(i) / 22050
		envelope = Min(t * 30, 1) * Min((0.5 - t) * 20, 1)
		value = Int(Sin(6.283185307179586 * (360 * t + 180 * t * t)) * envelope * 12000)
		samples.encode_s16(i * 2, value)
	Next
	alarm_stream.data = samples
	audio.stream = alarm_stream
End Sub

Function nearest_building(Optional max_distance As Variant = 3.5) As Integer
	Dim nearest As Variant
	Dim best As Variant
	Dim door As Vector2
	Dim distance As Variant
	Call EnsureInit()
	nearest = -1
	best = max_distance
	For i = 0 To (buildings.size() - 1)
		door = buildings(i).door
		distance = position_xz.distance_to(door)
		If distance < best Then
			best = distance
			nearest = i
		End If
	Next
	Return nearest
End Function

Sub enter_building(ByVal index As Integer)
	Call EnsureInit()
	If driving Or place <> "surface" Or index < 0 Or index >= buildings.size() Then
		Exit Sub
	End If
	surface_position = buildings(index).door + Vector2(0, -2)
	surface_heading = heading
	building_index = index
	place = "building"
	position_xz = Vector2(0, 3)
	heading = 0
	inspection = 0
	visited(index) = True
	pending_room = True
	notify(Str(buildings(index).label)  & " / E examines objects; E at the entry returns outside.")
End Sub

Sub leave_building()
	Call EnsureInit()
	place = "surface"
	position_xz = surface_position
	heading = PI
	keypad = False
	pending_room = True
	notify("Back outside. The buggy is where you parked it.")
End Sub

Sub use_object()
	Dim index As Variant
	Dim item As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	If completed Or failed Or transit_left > 0 Then
		Exit Sub
	End If
	If place = "surface" Then
		If position_xz.distance_to(SHIP) < 7 Then
			If inventory.has("regulator") And inventory.has("ignition") And inventory.has("coupler") Then
				completed = True
				awakening = False
				audio.stop()
				notify("ZEN: Coupler seated. Engines live. We are leaving!")
			Else
				notify("ASH: NEED PRESSURE REGULATOR / IGNITION CELL / REFLECTOR COUPLER.")
			End If
			Exit Sub
		End If
		index = nearest_building()
		If index >= 0 Then
			If driving Then
				notify("Park and leave the buggy with F before entering a building.")
			Else
				enter_building(index)
			End If
			Exit Sub
		End If
		collect_bottle()
	ElseIf position_xz.distance_to(Vector2(0, 2)) < 3 Then
		If place = "building" Then
			leave_building()
		Else
			start_lift("surface")
		End If
	ElseIf place = "building" Then
		If building_index = 7 And position_xz.distance_to(Vector2(0, 21)) < 3.2 Then
			If awakening Then
				notify("ZEN: No time for another descent. Get to the ship!")
			Else
				keypad = True
				sequence = ""
			End If
		ElseIf position_xz.distance_to(Vector2(0, 14)) < 3 Then
			If building_index < 5 Then
				discovered(building_index) = FEB_CODE.substr(building_index, 1)
				notify(CLUES(building_index)  & " Copied to the five-slot journal.")
			ElseIf building_index = 5 Or building_index = 6 Then
				If building_index = 5 Then
					item = "regulator"
				Else
					item = "ignition"
				End If
				If inventory.has(item) Then
					notify("Already salvaged. No compatible parts remain in this workshop.")
				Else
					inventory(item) = True
					notify("Recovered ship "  & item  & ". Other containers here are empty.")
					pending_room = True
				End If
			Else
				notify("Empty storage. Cracked ceramics, dead cable, and obsolete fittings. Nothing compatible.")
			End If
		End If
	ElseIf floor_code = FEB_CODE And position_xz.distance_to(Vector2(3.4, 47)) < 3 Then
		take_coupler()
	ElseIf position_xz.distance_to(Vector2(0, 26)) < 3 Then
		notify("Dead monitoring console. This floor contains no compatible ship parts.")
	End If
End Sub

Sub enter_symbol(ByVal symbol As String)
	Call EnsureInit()
	If Not keypad Or sequence.length() >= 5 Or Not symbol.is_valid_int() Or symbol.length() <> 1 Then
		Exit Sub
	End If
	sequence = sequence + symbol
End Sub

Sub submit_sequence()
	Call EnsureInit()
	If Not keypad Then
		Exit Sub
	End If
	If sequence.length() <> 5 Then
		notify("The destination requires exactly five symbols.")
		Exit Sub
	End If
	keypad = False
	start_lift(sequence)
End Sub

Sub start_lift(ByVal target As String)
	Dim _t0 As Variant
	Dim _t1 As Variant
	Call EnsureInit()
	lift_target = target
	If target <> "surface" Then
		transit_total = 4.0
	Else
		transit_total = 3.0
	End If
	transit_left = transit_total
	inspection = 0
	keypad = False
	position_xz = Vector2(0, 2)
	heading = 0
	place = "lift"
	pending_room = True
	If target <> "surface" Then
		_t1 = "ZEN OFFLINE / Lift descending."
	Else
		_t1 = "Emergency ascent / returning to the surface lobby."
	End If
	notify(_t1)
End Sub

Sub finish_lift()
	Dim _t0 As Variant
	Call EnsureInit()
	If lift_target = "surface" Then
		place = "building"
		floor_code = ""
		position_xz = Vector2(0, 19)
		heading = PI
		If awakening Then
			_t0 = "Surface lobby. Exit behind the entry marker and return to the Ash."
		Else
			_t0 = "Surface lobby. E at the entry returns outside."
		End If
		notify(_t0)
	Else
		place = "floor"
		floor_code = lift_target
		position_xz = Vector2(0, 3)
		heading = 0
		notify("Stratum reached. The lift behind you can return to the surface.")
	End If
	pending_room = True
End Sub

Sub take_coupler()
	Call EnsureInit()
	If inventory.has("coupler") Then
		Exit Sub
	End If
	inventory("coupler") = True
	awakening = True
	countdown = 255
	alarm_elapsed = 0
	alarm_pulse = 0
	If repair_part <> Nothing Then
		repair_part.visible = False
	End If
	notify("ZEN: RUN!")
	If audio <> Nothing Then
		audio.play()
	End If
End Sub

Sub retry_escape()
	Call EnsureInit()
	failed = False
	shield = 100
	damage_cooldown = 0
	inventory.erase("coupler")
	awakening = False
	countdown = 255
	alarm_elapsed = 0
	place = "floor"
	floor_code = FEB_CODE
	building_index = 7
	surface_position = buildings(7).door + Vector2(0, -2)
	position_xz = Vector2(0, 43)
	heading = 0
	driving = False
	keypad = False
	transit_left = 0
	pending_room = True
	notify("Chamber checkpoint restored. Recover the coupler, then return to the lift.")
End Sub

Sub _tick_turrets(ByVal delta As Single)
	Dim turret As Variant
	Dim point As Variant
	Dim offset As Variant
	Call EnsureInit()
	For i = 0 To (turrets.size() - 1)
		turret = turrets(i)
		turret_flashes(i) = Max(0, turret_flashes(i) - delta)
		point = Vector2(turret.position.x, turret.position.z)
		offset = position_xz - point
		If awakening And place = "surface" Then
			turret.rotation.y = RotateToward(turret.rotation.y, Atan2(offset.x, offset.y), delta * 0.8)
			If offset.length() < 34 And damage_cooldown <= 0 And Abs(AngleDifference(turret.rotation.y, Atan2(offset.x, offset.y))) < 0.12 And _line_clear(point, position_xz) Then
				shield = Max(0, shield - 12)
				damage_cooldown = 2
				turret_flashes(i) = 0.2
				velocity = velocity * 0.55
				notify("ZEN: Turrets are live! Stay behind the buildings!")
				If shield = 0 Then
					failed = True
					audio.stop()
					notify("SUIT BREACHED. Enter retries the chamber checkpoint.")
				End If
			End If
		Else
			turret.rotation.y = Sin(visual_time * 0.35 + i) * 0.9
		End If
	Next
End Sub

Function _line_clear(ByVal a As Vector2, ByVal b As Vector2) As Boolean
	Dim length As Variant
	Dim point As Variant
	Call EnsureInit()
	length = a.distance_to(b)
	For step_n = 4 To (CeilInt(length / 0.5) - 1)
		point = a.Lerp(b, step_n * 0.5 / Max(length, 0.01))
		For Each rect In AsArray(surface_solids)
			If rect.has_point(point) Then
				Return False
			End If
		Next
	Next
	Return True
End Function

Sub _sync_room()
	Call EnsureInit()
	If Not pending_room Then
		Exit Sub
	End If
	pending_room = False
	If interior <> Nothing Then
		interior.free()
	End If
	interior = ClassDB.Instantiate("Node3D")
	interior.name = "SeparateInterior"
	add_child(interior)
	lift_doors.clear()
	interior_solids.clear()
	pod_figure = Nothing
	repair_part = Nothing
	mist = Nothing
	If place <> "surface" Then
		interior_builder.build(Me)
	End If
End Sub

Function prompt() As String
	Dim index As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Call EnsureInit()
	If completed Then
		Return "SHIP REPAIRED / Enter: restart prototype"
	End If
	If failed Then
		Return "ESCAPE FAILED / Enter: chamber checkpoint"
	End If
	If transit_left > 0 Then
		Return "LIFT IN TRANSIT / Doors locked"
	End If
	If keypad Then
		Return "0-9 SELECT GLYPH / BACKSPACE ERASE / ENTER TRAVEL / F CANCEL"
	End If
	If place = "surface" Then
		If position_xz.distance_to(SHIP) < 7 Then
			Return "E: install recovered parts and launch the Ash"
		End If
		index = nearest_building(15)
		If index >= 0 Then
			If driving Then
				_t0 = " / F: park first"
			Else
				_t0 = " / E at the door: enter"
			End If
			Return Str(buildings(index).label) + (_t0)
		End If
		Return "W/S MOVE  A/D TURN  F BUGGY  E INTERACT  V INSPECT"
	End If
	If position_xz.distance_to(Vector2(0, 2)) < 4 Then
		If place = "building" Then
			_t1 = "E: return outside"
		Else
			_t1 = "E: call emergency ascent"
		End If
		Return _t1
	End If
	If place = "building" Then
		If building_index = 7 Then
			Return "E at rear panel: five-symbol destination / journal at left"
		End If
		Return "E at the rear workbench: search / entry behind you"
	End If
	If floor_code = FEB_CODE Then
		If inventory.has("coupler") Then
			_t2 = "Coupler recovered. Return to the lift behind you!"
		Else
			_t2 = "E at the amber service socket: take reflector coupler / lift behind you"
		End If
		Return _t2
	End If
	Return "Explore this floor / E at entry: return to the surface"
End Function
