' Generated Visual Gasic port of cockpit_instruments.vg
Dim __ready As Boolean
Dim CYAN As Variant
Dim AMBER As Variant
Dim INK As Variant
Dim buggy As Variant
Dim time_n As Variant
Dim speed As Variant
Dim heading As Variant
Dim altitude As Variant
Dim warning As Variant
Dim progress As Variant
Dim range_end As Variant
Dim max_speed As Variant


Function Num(ByVal value As Variant) As Single
	If value = True Then
		Num = 1.0
	ElseIf value = False Then
		Num = 0.0
	Else
		Num = value
	End If
End Function

Function FPosMod(ByVal value As Single, ByVal modulus As Single) As Single
	Dim wrapped As Single
	wrapped = value - modulus * Int(value / modulus)
	If wrapped < 0 Then wrapped = wrapped + modulus
	FPosMod = wrapped
End Function

Function FMod(ByVal value As Single, ByVal modulus As Single) As Single
	FMod = value - modulus * Int(value / modulus)
End Function

Function CeilInt(ByVal value As Single) As Integer
	Dim floored As Integer
	floored = Int(value)
	If value > floored Then
		CeilInt = floored + 1
	Else
		CeilInt = floored
	End If
End Function

Function RoundInt(ByVal value As Single) As Integer
	If value >= 0 Then
		RoundInt = Int(value + 0.5)
	Else
		RoundInt = Int(value - 0.5)
	End If
End Function

Function PadInt(ByVal value As Integer, ByVal width As Integer) As String
	Dim text As String
	If value < 0 Then value = 0
	text = Str(value)
	While Len(text) < width
		text = "0" & text
	Wend
	PadInt = text
End Function

Function AngleDifference(ByVal from_angle As Single, ByVal to_angle As Single) As Single
	Dim diff As Single
	diff = FPosMod(to_angle - from_angle, 6.283185307179586)
	If diff > 3.141592653589793 Then diff = diff - 6.283185307179586
	AngleDifference = diff
End Function

Function RotateToward(ByVal from_angle As Single, ByVal to_angle As Single, ByVal amount As Single) As Single
	Dim diff As Single
	diff = AngleDifference(from_angle, to_angle)
	If diff > amount Then diff = amount
	If diff < 0 - amount Then diff = 0 - amount
	RotateToward = from_angle + diff
End Function

Function DictFlag(ByVal table As Dictionary, ByVal code As Integer) As Boolean
	If table.Has(code) Then
		DictFlag = table(code)
	Else
		DictFlag = False
	End If
End Function

Function VecLess(ByVal a As Vector3, ByVal b As Vector3) As Boolean
	If a.x <> b.x Then
		VecLess = a.x < b.x
	ElseIf a.y <> b.y Then
		VecLess = a.y < b.y
	Else
		VecLess = a.z < b.z
	End If
End Function

Function SpawnVg(ByVal path As String, ByVal type_name As String) As Object
	Dim node As Object
	Dim script As Object
	node = ClassDB.Instantiate(type_name)
	script = Load(path)
	node.SetScript(script)
	SpawnVg = node
End Function

Function PackVec2(ByVal items As Array) As PackedVector2Array
	Dim packed As PackedVector2Array
	Dim item As Variant
	For Each item In AsArray(items)
		packed.append(item)
	Next
	PackVec2 = packed
End Function

Function PackVec3(ByVal items As Array) As PackedVector3Array
	Dim packed As PackedVector3Array
	Dim item As Variant
	For Each item In AsArray(items)
		packed.append(item)
	Next
	PackVec3 = packed
End Function

Function PackColor(ByVal items As Array) As PackedColorArray
	Dim packed As PackedColorArray
	Dim item As Variant
	For Each item In AsArray(items)
		packed.append(item)
	Next
	PackColor = packed
End Function

Function PackByte(ByVal items As Array) As PackedByteArray
	Dim packed As PackedByteArray
	Dim item As Variant
	For Each item In AsArray(items)
		packed.append(item)
	Next
	PackByte = packed
End Function

Function Sign(ByVal value As Single) As Single
	If value > 0 Then
		Sign = 1
	ElseIf value < 0 Then
		Sign = -1
	Else
		Sign = 0
	End If
End Function

Function AsArray(ByVal items As Variant) As Array
	Dim out As Array
	Dim i As Integer
	Dim n As Integer
	out = Array()
	If items = Nothing Then
		AsArray = out
		Exit Function
	End If
	' vbString = 8. Digit bars iterate "bc" as characters. String subscript is not an array.
	If VarType(items) = 8 Then
		n = Len(items)
		If n > 0 Then
			For i = 1 To n
				out.append(Mid(items, i, 1))
			Next
		End If
		AsArray = out
		Exit Function
	End If
	' GDScript `for x in N` walks 0..N-1. vbLong=3, vbDouble=5, vbInteger=2, vbSingle=4.
	If VarType(items) = 2 Or VarType(items) = 3 Or VarType(items) = 4 Or VarType(items) = 5 Then
		n = Int(items)
		If n > 0 Then
			For i = 0 To n - 1
				out.append(i)
			Next
		End If
		AsArray = out
		Exit Function
	End If
	For i = 0 To items.size() - 1
		out.append(items(i))
	Next
	AsArray = out
End Function


Sub EnsureInit()
	If __ready Then Exit Sub
	__ready = True
	CYAN = Color(0.2, 0.92, 1.0)
	AMBER = Color(1.0, 0.45, 0.15)
	INK = Color(0.005, 0.018, 0.025)
	buggy = False
	time_n = 0.0
	speed = 0.0
	heading = 0.0
	altitude = 0.0
	warning = 0.0
	progress = 0.0
	range_end = 368.0
	max_speed = 16.0
End Sub

Sub update_readings(ByVal t As Single, ByVal velocity As Single, ByVal bearing As Single, ByVal height As Single, ByVal alert As Single, ByVal distance As Single, Optional destination As Variant = 368.0, Optional top_speed As Variant = 16.0)
	Call EnsureInit()
	time_n = t
	speed = velocity
	heading = bearing
	altitude = height
	warning = alert
	progress = distance
	range_end = destination
	max_speed = top_speed
	queue_redraw()
End Sub

Sub _draw()
	Dim font As Variant
	Dim bearing As Variant
	Dim blip As Variant
	Dim level As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Dim _t3 As Variant
	Call EnsureInit()
	font = ThemeDB.fallback_font
	If buggy Then
		draw_rect(Rect2(219, 372, 121, 58), INK)
		draw_rect(Rect2(359, 359, 242, 75), INK)
		draw_rect(Rect2(620, 372, 121, 58), INK)
		draw_string(font, Vector2(229, 384), "DRIVE / km/h", 0, -1, 8, CYAN)
		draw_string(font, Vector2(229, 410), PadInt(RoundInt(Abs(speed) * 3.6), 2), 0, -1, 23, CYAN)
		For i = 0 To (10 - 1)
			If i < Abs(speed) / max_speed * 10 Then
				_t0 = CYAN
			Else
				_t0 = CYAN * 0.18
			End If
			draw_rect(Rect2(229 + i * 10, 419, 7, 4), _t0)
		Next
		draw_string(font, Vector2(372, 373), "MERIDIAN / YARD TELEMETRY", 0, -1, 9, CYAN)
		bearing = FPosMod(((heading) * 57.29577951308232), 360.0)
		draw_string(font, Vector2(372, 392), "HDG " & PadInt(RoundInt(bearing), 3) & "    RANGE " & PadInt(RoundInt(Max(0, range_end - progress)), 3) & "m", 0, -1, 12, CYAN)
		_wave(Rect2(373, 402, 132, 20), 2.0 + Abs(speed) * 0.3)
		For i = 0 To (5 - 1)
			draw_rect(Rect2(521, 402 + i * 5, 62 * (0.4 + 0.4 * Sin(time_n * 2 + i)), 2), CYAN)
		Next
		_dial(Vector2(653, 407), 24, Abs(speed) / max_speed)
		draw_string(font, Vector2(679, 392), "MOTOR", 0, -1, 9, CYAN)
		draw_string(font, Vector2(680, 412), PadInt(RoundInt(ClampF(Abs(speed) / max_speed, 0, 1) * 100), 2) & "%", 0, -1, 13, CYAN)
	Else
		draw_rect(Rect2(219, 343, 139, 88), INK)
		draw_rect(Rect2(379, 343, 202, 76), INK)
		draw_rect(Rect2(602, 343, 139, 88), INK)
		_dial(Vector2(289, 386), 36, FPosMod(time_n * 0.12, 1))
		draw_line(Vector2(253, 386), Vector2(325, 386), CYAN * 0.4)
		draw_line(Vector2(289, 350), Vector2(289, 422), CYAN * 0.4)
		blip = Vector2(289, 386) + Vector2(Sin(time_n * 0.3), Cos(time_n * 0.2)) * 23
		draw_circle(blip, 2, CYAN)
		draw_string(font, Vector2(391, 358), "ASH / FLIGHT SYSTEMS", 0, -1, 9, CYAN)
		draw_string(font, Vector2(391, 376), "VEL " & PadInt(RoundInt(speed), 3) & "  ALT " & PadInt(RoundInt(altitude), 3), 0, -1, 13, CYAN)
		_wave(Rect2(391, 384, 174, 20), 6 + warning * 8)
		If warning > 0.5 Then
			_t1 = "COUPLER FAULT"
		Else
			_t1 = "APPROACH LOCK"
		End If
		If warning > 0.5 Then
			_t2 = AMBER
		Else
			_t2 = CYAN
		End If
		draw_string(font, Vector2(391, 415), _t1, 0, -1, 10, _t2)
		For i = 0 To (3 - 1)
			level = ClampF(0.55 + Sin(time_n * (0.6 + i * 0.2)) * 0.22 - warning * i * 0.08, 0.1, 1)
			draw_rect(Rect2(638 + i * 30, 351, 19, 70), CYAN * 0.15)
			If i = 2 And warning > 0.5 Then
				_t3 = AMBER
			Else
				_t3 = CYAN
			End If
			draw_rect(Rect2(638 + i * 30, 421 - 70 * level, 19, 70 * level), _t3)
		Next
	End If
End Sub

Sub _dial(ByVal center As Vector2, ByVal radius As Single, ByVal value As Single)
	Dim angle As Variant
	Call EnsureInit()
	draw_arc(center, radius, -PI * 1.2, PI * 0.2, 36, CYAN, 1.5, True)
	For i = 0 To (11 - 1)
		angle = -PI * 1.2 + i * PI * 1.4 / 10
		draw_line(center + Vector2(Cos(angle), Sin(angle)) * (radius - 4), center + Vector2(Cos(angle), Sin(angle)) * radius, CYAN, 1, True)
	Next
	draw_line(center, center + Vector2(Cos(-PI * 1.2 + value * PI * 1.4), Sin(-PI * 1.2 + value * PI * 1.4)) * (radius - 5), CYAN, 2, True)
End Sub

Sub _wave(ByVal rect As Rect2, ByVal amplitude As Single)
	Dim points As PackedVector2Array
	Call EnsureInit()
	For i = 0 To (48 - 1)
		points.append(Vector2(rect.position.x + i * rect.size.x / 47, rect.get_center().y + Sin(i * 0.55 + time_n * 5) * Min(amplitude, rect.size.y * 0.45)))
	Next
	draw_polyline(points, CYAN, 1, True)
End Sub
