Function bleed_city2(ByVal time_n As Single, ByVal distance As Single, ByVal detail As Integer) As Texture2D
	Dim _t0 As Variant
	Dim _t1 As Variant
	Call EnsureInit()
	_ensure_city2()
	city2.visible = True
	If detail = 2 Then
		_t0 = Viewport.MSAA_4X
	Else
		_t0 = Viewport.MSAA_2X
	End If
	If detail = 0 Then
		city2_antialiasing = Viewport.MSAA_DISABLED
	Else
		city2_antialiasing = (_t0)
	End If
	city2.render(Me, time_n, distance)
	If detail = 0 Then
		Return viewport.get_texture()
	End If
	city2_output.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	Return city2_output.get_texture()
End Function

