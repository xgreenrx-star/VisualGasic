Sub end_yard()
	Call EnsureInit()
	world_mesh.mesh = _mesh()
	building_yard = False
	rebuild_count = rebuild_count + 1
	vertices.clear()
	colors.clear()
	edges.clear()
	edge_colors.clear()
End Sub

Function present(ByVal x As Single, ByVal y As Single, ByVal z As Single, ByVal yaw As Single, ByVal pitch As Single, ByVal distance As Single, Optional roll As Variant = 0.0) As Texture2D
	Dim antialiasing As Variant
	Dim forward As Variant
	Dim right As Variant
	Dim up As Variant
	Call EnsureInit()
	antialiasing = Viewport.MSAA_DISABLED
	If backlight_city <> Nothing And backlight_city.visible Then
		antialiasing = backlight_city.antialiasing
	ElseIf city3 <> Nothing And city3.visible Then
		antialiasing = city3_antialiasing
	ElseIf city2 <> Nothing And city2.visible Then
		antialiasing = city2_antialiasing
	End If
	If viewport.msaa_3d <> antialiasing Then
		viewport.msaa_3d = antialiasing
	End If
	forward = Vector3(Sin(yaw) * Cos(pitch), Sin(pitch), Cos(yaw) * Cos(pitch))
	right = Vector3(0, 1, 0).cross(forward).normalized()
	up = forward.cross(right)
	If roll <> 0.0 Then
		right = right * Cos(roll) + up * Sin(roll)
		up = forward.cross(right)
	End If
	camera.transform = Transform3D(Basis(right, up, -forward), Vector3(x, y, z))
	camera.fov = ((2.0 * Atan2(270.0 / 520.0, 1.0)) * 57.29577951308232)
	camera.far = Max(distance, 50.0)
	If Not edges.is_empty() Or Not vertices.is_empty() Then
		frame_mesh.mesh = _mesh()
		frame_mesh.visible = True
	End If
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	Return viewport.get_texture()
End Function

Sub box(ByVal origin As Vector3, ByVal size As Vector3, ByVal color As Color, Optional transform As Variant)
	Dim p As Array
	If transform Is Nothing Then
		transform = Transform3D()
	End If
	Call EnsureInit()
	p = Array()
	For Each offset In Array(Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(1, 1, 0), Vector3(0, 1, 0), Vector3(0, 0, 1), Vector3(1, 0, 1), Vector3(1, 1, 1), Vector3(0, 1, 1))
		p.append(transform * (origin + offset * size))
	Next
	For Each indices In Array(Array(0, 1, 2, 3), Array(4, 7, 6, 5), Array(0, 3, 7, 4), Array(1, 5, 6, 2), Array(3, 2, 6, 7), Array(0, 4, 5, 1))
		face(p(indices(0)), p(indices(1)), p(indices(2)), p(indices(3)), color)
	Next
End Sub

Sub tower(ByVal x As Single, ByVal z As Single, ByVal w As Single, ByVal h As Single, ByVal side As Single, ByVal kind As Integer, ByVal detail As Integer)
	Dim d As Variant
	Dim outline As Variant
	Dim mast As Variant
	Dim street_x As Variant
	Dim height As Variant
	Dim conduit_x As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	d = w * 0.72
	outline = yard_profile(w, h, kind)
	_extrude(outline, d, CYAN, Transform3D(Basis(), Vector3(x, 0, z)))
	mast = Vector3(x + w * 0.44, h, z + d * 0.48)
	segment(mast, mast + Vector3(0, 2.2 + kind, 0), CYAN)
	segment(mast + Vector3(-w * 0.16, -h * 0.2, 0), mast + Vector3(-w * 0.16, 1.0, 0), CYAN * 0.5)
	If side < 0 Then
		street_x = x + w
	Else
		street_x = x
	End If
	For Each dz In Array(0.0, d)
		face(Vector3(street_x, 0, z + dz), Vector3(street_x - side * 2.0, 0, z + dz), Vector3(street_x, h * 0.25, z + dz), Vector3(street_x, h * 0.42, z + dz), CYAN * 0.65)
	Next
	If detail = 0 Then
		Exit Sub
	End If
	For i = 0 To (2 + detail * 2 - 1)
		height = h * 0.18 + i * 0.22
		segment(Vector3(x + w * 0.36, height, z - 0.015), Vector3(x + w * 0.56, height, z - 0.015), CYAN * 0.65)
	Next
	conduit_x = x + w * 0.67
	segment(Vector3(conduit_x, 0.1, z - 0.02), Vector3(conduit_x, h * 0.35, z - 0.02), CYAN)
	segment(Vector3(conduit_x, h * 0.35, z - 0.02), Vector3(conduit_x - w * 0.22, h * 0.44, z - 0.02), CYAN)
	segment(Vector3(conduit_x - w * 0.22, h * 0.44, z - 0.02), Vector3(conduit_x - w * 0.22, h * 0.82, z - 0.02), CYAN)
	For Each dz In Array(d * 0.2, d * 0.55)
		segment(Vector3(street_x, h * 0.12, z + dz), Vector3(street_x, h * 0.3, z + dz), CYAN * 0.55)
		segment(Vector3(street_x, h * 0.3, z + dz), Vector3(street_x - side * w * 0.15, h * 0.4, z + dz), CYAN * 0.55)
	Next
End Sub

Function yard_profile(ByVal w As Single, ByVal h As Single, ByVal kind As Integer) As PackedVector2Array
	Return PackedVector2Array(Array(Vector2(0, 0), Vector2(w, 0), Vector2(w * 0.78, h * 0.14), Vector2(w * 0.78, h * 0.38), Vector2(w * 0.96, h * 0.42), Vector2(w * 0.96, h * 0.48), Vector2(w * 0.7, h * 0.48), Vector2(w * 0.7, h * 0.65), Vector2(w * 0.58, h * 0.65), Vector2(w * 0.58, h), Vector2(w * 0.43, h), Vector2(w * 0.43, h * (0.86 - kind * 0.03)), Vector2(w * 0.27, h * 0.8), Vector2(w * 0.27, h * 0.58), Vector2(w * 0.15, h * 0.58), Vector2(w * 0.15, h * 0.32), Vector2(w * 0.32, h * 0.25), Vector2(w * 0.32, h * 0.14)))
End Function

Sub _extrude(ByVal outline As PackedVector2Array, ByVal depth As Single, ByVal color As Color, ByVal transform As Transform3D)
	Dim indices As Variant
	Dim point As Variant
	Dim p As Variant
	Dim q As Variant
	Call EnsureInit()
	indices = Geometry2D.triangulate_polygon(outline)
	For Each back In Array(0.0, depth)
		For Each index In AsArray(indices)
			point = outline(index)
			vertices.append(transform * Vector3(point.x, point.y, back))
			colors.append(Color(color.r * 0.04, color.g * 0.045, color.b * 0.06))
		Next
	Next
	For i = 0 To (outline.size() - 1)
		p = outline(i)
		q = outline((i + 1)  Mod  outline.size())
		face(transform * Vector3(p.x, p.y, 0), transform * Vector3(q.x, q.y, 0), transform * Vector3(q.x, q.y, depth), transform * Vector3(p.x, p.y, depth), color)
	Next
End Sub

Sub _cylinder(ByVal center As Vector3, ByVal radius As Single, ByVal length As Single, ByVal axis As Integer, ByVal color As Color, ByVal transform As Transform3D)
	Dim a As Variant
	Dim b As Variant
	Dim p As Variant
	Dim q As Variant
	Dim extent As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Dim _t3 As Variant
	Call EnsureInit()
	For i = 0 To (16 - 1)
		a = 6.283185307179586 * i / 16.0
		b = 6.283185307179586 * (i + 1) / 16.0
		If axis = 0 Then
			p = Vector3(0, Cos(a), Sin(a)) * radius
		Else
			p = Vector3(Cos(a), 0, Sin(a)) * radius
		End If
		If axis = 0 Then
			q = Vector3(0, Cos(b), Sin(b)) * radius
		Else
			q = Vector3(Cos(b), 0, Sin(b)) * radius
		End If
		If axis = 0 Then
			extent = Vector3(length, 0, 0)
		Else
			extent = Vector3(0, length, 0)
		End If
		' Filled sides are independent of decorative coil rings.
		For Each point In Array(center + p, center + q, center + q + extent, center + p, center + q + extent, center + p + extent)
			vertices.append(transform * point)
			colors.append(Color(0.008, 0.015, 0.022))
		Next
		For Each end_n In Array(Vector3(0, 0, 0), extent)
			For Each point In Array(center + end_n, center + p + end_n, center + q + end_n)
				vertices.append(transform * point)
				colors.append(Color(0.008, 0.012, 0.019))
			Next
		Next
	Next
	_ring(center, radius, axis, color, transform)
	If axis = 0 Then
		_t3 = Vector3(length, 0, 0)
	Else
		_t3 = Vector3(0, length, 0)
	End If
	_ring(center + (_t3), radius, axis, color, transform)
End Sub

Sub _ring(ByVal center As Vector3, ByVal radius As Single, ByVal axis As Integer, ByVal color As Color, ByVal transform As Transform3D, Optional spokes As Variant = False)
	Dim a As Variant
	Dim b As Variant
	Dim p As Variant
	Dim q As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Call EnsureInit()
	For i = 0 To (20 - 1)
		a = 6.283185307179586 * i / 20.0
		b = 6.283185307179586 * (i + 1) / 20.0
		If axis = 0 Then
			p = Vector3(0, Cos(a), Sin(a))
		Else
			p = Vector3(Cos(a), 0, Sin(a))
		End If
		If axis = 0 Then
			q = Vector3(0, Cos(b), Sin(b))
		Else
			q = Vector3(Cos(b), 0, Sin(b))
		End If
		segment(transform * (center + p * radius), transform * (center + q * radius), color)
		If spokes And i  Mod  4 = 0 Then
			segment(transform * (center + p * radius * 0.2), transform * (center + p * radius), color)
		End If
	Next
End Sub

Sub turret(ByVal x As Single, ByVal y As Single, ByVal z As Single, ByVal yaw As Single)
	Dim transform As Variant
	Dim a As Variant
	Dim b As Variant
	Dim p As Variant
	Dim q As Variant
	Dim housing As Variant
	Call EnsureInit()
	transform = Transform3D(Basis(Vector3(0, 1, 0), -yaw), Vector3(x, y, z))
	For Each side In Array(-1.0, 1.0)
		For Each end_n In Array(-1.0, 1.0)
			box(Vector3(-0.6 + end_n * 1.05, 0.03, side * 1.2 - 0.3), Vector3(1.1, 0.22, 0.6), PINK, transform)
		Next
	Next
	For i = 0 To (8 - 1)
		a = 6.283185307179586 * i / 8.0
		b = 6.283185307179586 * (i + 1) / 8.0
		p = Vector3(Cos(a), 0, Sin(a))
		q = Vector3(Cos(b), 0, Sin(b))
		face(transform * (p * 1.8), transform * (q * 1.8), transform * (q * 1.45 + Vector3(0, 1, 0) * 0.3), transform * (p * 1.45 + Vector3(0, 1, 0) * 0.3), PINK)
	Next
	_cylinder(Vector3(0, 0.3, 0), 0.6, 0.8, 1, PINK, transform)
	_ring(Vector3(0, 0.32, 0), 1.0, 1, CYAN, transform)
	_ring(Vector3(0, 0.45, 0), 0.72, 1, PINK, transform)
	For Each side In Array(-1.0, 1.0)
		box(Vector3(-0.55, 0.8, side * 0.7 - 0.12), Vector3(1.15, 0.65, 0.24), PINK, transform)
		housing = PackedVector2Array(Array(Vector2(-0.8, 1.3), Vector2(0.85, 1.3), Vector2(0.85, 1.8), Vector2(0.55, 2.12), Vector2(-0.55, 2.12), Vector2(-0.8, 1.85)))
		_extrude(housing, 0.6, PINK, transform.translated_local(Vector3(0, 0, side * 0.58 - 0.3)))
		_cylinder(Vector3(0.8, 1.66, side * 0.58), 0.13, 1.5, 0, CYAN, transform)
		For rib = 0 To (5 - 1)
			_ring(Vector3(1.62 + rib * 0.12, 1.66, side * 0.58), 0.19, 0, CYAN, transform)
		Next
		_ring(Vector3(2.3, 1.66, side * 0.58), 0.15, 0, PINK, transform)
		_ring(Vector3(-0.52, 2.35, side * 0.64), 0.5, 0, CYAN, transform, True)
		_ring(Vector3(-0.52, 2.35, side * 0.64), 0.3, 0, CYAN, transform)
		segment(transform * Vector3(-0.52, 2.0, side * 0.64), transform * Vector3(-0.52, 2.35, side * 0.64), PINK)
	Next
	box(Vector3(-0.45, 1.4, -0.22), Vector3(1, 0.5, 0.44), PINK, transform)
End Sub

Sub bridge(ByVal z As Single)
	Dim previous As Variant
	Dim angle As Variant
	Dim point As Variant
	Call EnsureInit()
	box(Vector3(-8.5, 4.8, z - 0.7), Vector3(17, 0.4, 1.4), CYAN * 0.65)
	For Each side In Array(-1.0, 1.0)
		box(Vector3(side * 8.4 - 0.4, 0, z - 0.8), Vector3(0.8, 4.8, 1.6), CYAN * 0.7)
		For rib = 0 To (3 - 1)
			previous = Vector3(side * 7.8, 0, z - 0.75 - rib * 0.06)
			For step_n = 1 To (17 - 1)
				angle = step_n * PI * 0.5 / 16.0
				point = Vector3(side * (7.8 - Sin(angle) * 6.8), (1.0 - Cos(angle)) * 4.5, previous.z)
				segment(previous, point, CYAN * (0.55 + rib * 0.2))
				previous = point
			Next
		Next
	Next
End Sub
