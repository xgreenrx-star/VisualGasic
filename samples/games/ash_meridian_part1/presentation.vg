Function Num(ByVal value As Variant) As Single
	If value = True Then
		Num = 1.0
	ElseIf value = False Then
		Num = 0.0
	Else
		Num = value
	End If
End Function

Function FPosMod(ByVal value As Single, ByVal modulus As Single) As Single
	Dim wrapped As Single
	wrapped = value - modulus * Int(value / modulus)
	If wrapped < 0 Then wrapped = wrapped + modulus
	FPosMod = wrapped
End Function

Function FMod(ByVal value As Single, ByVal modulus As Single) As Single
	FMod = value - modulus * Int(value / modulus)
End Function

Function CeilInt(ByVal value As Single) As Integer
	Dim floored As Integer
	floored = Int(value)
	If value > floored Then
		CeilInt = floored + 1
	Else
		CeilInt = floored
	End If
End Function

Function RoundInt(ByVal value As Single) As Integer
	If value >= 0 Then
		RoundInt = Int(value + 0.5)
	Else
		RoundInt = Int(value - 0.5)
	End If
End Function

Function PadInt(ByVal value As Integer, ByVal width As Integer) As String
	Dim text As String
	If value < 0 Then value = 0
	text = Str(value)
	While Len(text) < width
		text = "0" & text
	Wend
	PadInt = text
End Function

Function AngleDifference(ByVal from_angle As Single, ByVal to_angle As Single) As Single
	Dim diff As Single
	diff = FPosMod(to_angle - from_angle, 6.283185307179586)
	If diff > 3.141592653589793 Then diff = diff - 6.283185307179586
	AngleDifference = diff
End Function

Function RotateToward(ByVal from_angle As Single, ByVal to_angle As Single, ByVal amount As Single) As Single
	Dim diff As Single
	diff = AngleDifference(from_angle, to_angle)
	If diff > amount Then diff = amount
	If diff < 0 - amount Then diff = 0 - amount
	RotateToward = from_angle + diff
End Function

Function DictFlag(ByVal table As Dictionary, ByVal code As Integer) As Boolean
	If table.Has(code) Then
		DictFlag = table(code)
	Else
		DictFlag = False
	End If
End Function

Function VecLess(ByVal a As Vector3, ByVal b As Vector3) As Boolean
	If a.x <> b.x Then
		VecLess = a.x < b.x
	ElseIf a.y <> b.y Then
		VecLess = a.y < b.y
	Else
		VecLess = a.z < b.z
	End If
End Function

Function SpawnVg(ByVal path As String, ByVal type_name As String) As Object
	Dim node As Object
	Dim script As Object
	node = ClassDB.Instantiate(type_name)
	script = Load(path)
	node.SetScript(script)
	SpawnVg = node
End Function

Function PackVec2(ByVal items As Array) As PackedVector2Array
	PackVec2 = PackedVector2Array(items)
End Function

Function PackVec3(ByVal items As Array) As PackedVector3Array
	PackVec3 = PackedVector3Array(items)
End Function

Function PackColor(ByVal items As Array) As PackedColorArray
	PackColor = PackedColorArray(items)
End Function

Function PackByte(ByVal items As Array) As PackedByteArray
	PackByte = PackedByteArray(items)
End Function

Function Sign(ByVal value As Single) As Single
	If value > 0 Then
		Sign = 1
	ElseIf value < 0 Then
		Sign = -1
	Else
		Sign = 0
	End If
End Function

Function AsArray(ByVal items As Variant) As Array
	Dim out As Array
	Dim i As Integer
	Dim n As Integer
	out = Array()
	If items = Nothing Then
		AsArray = out
		Exit Function
	End If
	' vbString = 8. Digit bars iterate "bc" as characters. String subscript is not an array.
	If VarType(items) = 8 Then
		n = Len(items)
		If n > 0 Then
			For i = 1 To n
				out.append(Mid(items, i, 1))
			Next
		End If
		AsArray = out
		Exit Function
	End If
	' GDScript `for x in N` walks 0..N-1. vbLong=3, vbDouble=5, vbInteger=2, vbSingle=4.
	If VarType(items) = 2 Or VarType(items) = 3 Or VarType(items) = 4 Or VarType(items) = 5 Then
		n = Int(items)
		If n > 0 Then
			For i = 0 To n - 1
				out.append(i)
			Next
		End If
		AsArray = out
		Exit Function
	End If
	For i = 0 To items.size() - 1
		out.append(items(i))
	Next
	AsArray = out
End Function


Sub EnsureInit()
	If __ready Then Exit Sub
	__ready = True
	CYAN = Color(0.18, 0.86, 1.0)
	PINK = Color(1.0, 0.24, 0.78)
	KEYS = Array(KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT, KEY_W, KEY_A, KEY_S, KEY_D, KEY_ENTER, KEY_SPACE, KEY_ESCAPE, KEY_F, KEY_E, KEY_V, KEY_BACKSPACE, KEY_0, KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_KP_0, KEY_KP_1, KEY_KP_2, KEY_KP_3, KEY_KP_4, KEY_KP_5, KEY_KP_6, KEY_KP_7, KEY_KP_8, KEY_KP_9)
	KEYS.append(KEY_Q)
	KEYS.append(KEY_F10)
	held = New Dictionary
	taps = New Dictionary
	yard_key = ""
	building_yard = False
	rebuild_count = 0
	city2_antialiasing = Viewport.MSAA_2X
	city3_antialiasing = Viewport.MSAA_2X
End Sub

Sub _ready()
	Dim shader As Variant
	Dim halo As Variant
	Dim halo_shader As Variant
	Call EnsureInit()
	viewport = ClassDB.Instantiate("SubViewport")
	viewport.size = Vector2i(960, 540)
	viewport.own_world_3d = True
	viewport.transparent_bg = True
	viewport.handle_input_locally = False
	viewport.render_target_update_mode = SubViewport.UPDATE_DISABLED
	add_child(viewport)
	camera = ClassDB.Instantiate("Camera3D")
	camera.near = 0.1
	camera.current = True
	viewport.add_child(camera)
	world_mesh = ClassDB.Instantiate("MeshInstance3D")
	frame_mesh = ClassDB.Instantiate("MeshInstance3D")
	viewport.add_child(world_mesh)
	viewport.add_child(frame_mesh)
	face_material = ClassDB.Instantiate("StandardMaterial3D")
	face_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	face_material.vertex_color_use_as_albedo = True
	face_material.cull_mode = BaseMaterial3D.CULL_DISABLED
	line_material = ClassDB.Instantiate("ShaderMaterial")
	shader = ClassDB.Instantiate("Shader")
	shader = Load("res://shaders/presentation_07.gdshader")
	line_material.shader = shader
	halo = ClassDB.Instantiate("ShaderMaterial")
	halo_shader = ClassDB.Instantiate("Shader")
	halo_shader.code = shader.code.replace("unshaded, cull_disabled, depth_draw_never", "unshaded, cull_disabled, blend_add, depth_draw_never").replace("line_width = 1.6", "line_width = 5.0").replace("ALBEDO = COLOR.rgb * 1.25;", "ALBEDO = COLOR.rgb; ALPHA = 0.12;")
	halo.shader = halo_shader
	line_material.next_pass = halo
	cockpit_view = ClassDB.Instantiate("SubViewport")
	cockpit_view.size = Vector2i(960, 540)
	cockpit_view.transparent_bg = True
	cockpit_view.render_target_update_mode = SubViewport.UPDATE_ONCE
	add_child(cockpit_view)
	stars = ClassDB.Instantiate("Node2D")
	stars.set_script(Load("res://cockpit_stars.vg"))
	cockpit_view.add_child(stars)
	_add_cached_art(cockpit_view, "res://cockpit_art.vg")
	ship_instruments = ClassDB.Instantiate("Node2D")
	ship_instruments.set_script(Load("res://cockpit_instruments.vg"))
	cockpit_view.add_child(ship_instruments)
	buggy_view = ClassDB.Instantiate("SubViewport")
	buggy_view.size = Vector2i(960, 540)
	buggy_view.transparent_bg = True
	buggy_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	add_child(buggy_view)
	_add_cached_art(buggy_view, "res://buggy_art.vg")
	buggy_instruments = ClassDB.Instantiate("Node2D")
	buggy_instruments.set_script(Load("res://cockpit_instruments.vg"))
	buggy_instruments.buggy = True
	buggy_view.add_child(buggy_instruments)
	_create_clouds()
	ship = ClassDB.Instantiate("MeshInstance3D")
	ship.name = "AshHull"
	ship.visible = False
	ship.cast_shadow = 0
	viewport.add_child(ship)
	' The dashboard's external monitor shares the landing world but culls the
	' cloud layer, so it shows the chase view without the weather.
	external_view = ClassDB.Instantiate("SubViewport")
	external_view.size = Vector2i(320, 180)
	external_view.own_world_3d = False
	external_view.world_3d = viewport.find_world_3d()
	external_view.transparent_bg = True
	external_view.handle_input_locally = False
	external_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	add_child(external_view)
	external_camera = ClassDB.Instantiate("Camera3D")
	external_camera.near = 0.1
	external_camera.far = 400.0
	external_camera.cull_mask = 1
	external_camera.current = True
	external_view.add_child(external_camera)
	deck_view = ClassDB.Instantiate("SubViewport")
	deck_view.size = Vector2i(1000, 580)
	deck_view.transparent_bg = True
	deck_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	add_child(deck_view)
	deck = ClassDB.Instantiate("Node2D")
	deck.set_script(Load("res://landing_deck.vg"))
	deck.position = Vector2(20, 20)
	deck_view.add_child(deck)
	deck.external = external_view.get_texture()
End Sub

Function landing_external(ByVal x As Single, ByVal y As Single, ByVal z As Single, ByVal yaw As Single, ByVal pitch As Single) As Texture2D
	Dim forward As Variant
	Dim right As Variant
	Call EnsureInit()
	forward = Vector3(Sin(yaw) * Cos(pitch), Sin(pitch), Cos(yaw) * Cos(pitch))
	right = Vector3(0, 1, 0).cross(forward).normalized()
	external_camera.transform = Transform3D(Basis(right, forward.cross(right), -forward), Vector3(x, y, z))
	external_camera.fov = camera.fov
	external_view.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	Return external_view.get_texture()
End Function

Function landing_deck(ByVal state As Dictionary) As Texture2D
	Call EnsureInit()
	deck.update_deck(state)
	deck_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	deck_view.render_target_update_mode = SubViewport.UPDATE_ONCE
	Return deck_view.get_texture()
End Function

Sub _add_cached_art(ByVal target As SubViewport, ByVal script_path As String)
	Dim art_view As Variant
	Dim art As Variant
	Dim canvas As Variant
	Call EnsureInit()
	art_view = ClassDB.Instantiate("SubViewport")
	art_view.size = Vector2i(960, 540)
	art_view.transparent_bg = True
	art_view.render_target_update_mode = SubViewport.UPDATE_ONCE
	add_child(art_view)
	art = ClassDB.Instantiate("Node2D")
	art.set_script(load(script_path))
	art_view.add_child(art)
	canvas = ClassDB.Instantiate("TextureRect")
	canvas.texture = art_view.get_texture()
	canvas.size = Vector2(960, 540)
	target.add_child(canvas)
End Sub

Function cockpit_texture(ByVal t As Single, ByVal speed As Single, ByVal height As Single, ByVal alert As Single) As Texture2D
	Call EnsureInit()
	stars.time_n = t
	stars.queue_redraw()
	ship_instruments.update_readings(t, speed, 0, height, alert, 0)
	' UPDATE_ONCE leaves the property at ONCE after the render, so assigning
	' ONCE again does not schedule another frame.
	cockpit_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	cockpit_view.render_target_update_mode = SubViewport.UPDATE_ONCE
	Return cockpit_view.get_texture()
End Function

Function buggy_texture(ByVal t As Single, ByVal speed As Single, ByVal heading As Single, ByVal distance As Single, Optional destination As Variant = 368.0, Optional top_speed As Variant = 16.0) As Texture2D
	Call EnsureInit()
	buggy_instruments.update_readings(t, speed, heading, 0, 0, distance, destination, top_speed)
	buggy_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
	buggy_view.render_target_update_mode = SubViewport.UPDATE_ONCE
	Return buggy_view.get_texture()
End Function

Sub _create_clouds()
	Dim mesh As Variant
	Dim cloud_vertices As PackedVector3Array
	Dim cloud_uvs As PackedVector2Array
	Dim cloud_colors As PackedColorArray
	Dim cloud_indices As PackedInt32Array
	Dim arrays As Variant
	Dim material As Variant
	Dim shader As Variant
	Dim x As Single
	Dim z As Single
	Dim tint As Color
	Dim base As Integer
	Call EnsureInit()
	clouds = ClassDB.Instantiate("MeshInstance3D")
	mesh = ClassDB.Instantiate("ArrayMesh")
	For i = 0 To (8 - 1)
		z = 40.0 + i * 38.0
		If i Mod 2 = 0 Then
			x = -18.0
		Else
			x = 16.0
		End If
		tint = Color(0.82 + (i Mod 3) * 0.06, 0.88, 0.96)
		base = i * 4
		cloud_vertices.append(Vector3(x - 28.0, 8.0, z))
		cloud_vertices.append(Vector3(x + 28.0, 8.0, z))
		cloud_vertices.append(Vector3(x + 28.0, 26.0, z))
		cloud_vertices.append(Vector3(x - 28.0, 26.0, z))
		cloud_uvs.append(Vector2(0.0, 1.0))
		cloud_uvs.append(Vector2(1.0, 1.0))
		cloud_uvs.append(Vector2(1.0, 0.0))
		cloud_uvs.append(Vector2(0.0, 0.0))
		cloud_colors.append(tint)
		cloud_colors.append(tint)
		cloud_colors.append(tint)
		cloud_colors.append(tint)
		cloud_indices.append(base)
		cloud_indices.append(base + 1)
		cloud_indices.append(base + 2)
		cloud_indices.append(base)
		cloud_indices.append(base + 2)
		cloud_indices.append(base + 3)
	Next
	arrays = Array()
	arrays.resize(Mesh.ARRAY_MAX)
	arrays(Mesh.ARRAY_VERTEX) = cloud_vertices
	arrays(Mesh.ARRAY_TEX_UV) = cloud_uvs
	arrays(Mesh.ARRAY_COLOR) = cloud_colors
	arrays(Mesh.ARRAY_INDEX) = cloud_indices
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	material = ClassDB.Instantiate("ShaderMaterial")
	shader = Load("res://shaders/landing_clouds.gdshader")
	material.shader = shader
	mesh.surface_set_material(0, material)
	clouds.mesh = mesh
	clouds.cast_shadow = 0
	clouds.extra_cull_margin = 80.0
	clouds.layers = 2
	clouds.visible = False
	viewport.add_child(clouds)
End Sub

Sub landing_clouds()
	Call EnsureInit()
	clouds.visible = True
End Sub

Sub adopt_ship()
	Dim canopy As Variant
	Dim canopy_mesh As Variant
	Dim canopy_vertices As PackedVector3Array
	Dim canopy_colors As PackedColorArray
	Dim canopy_arrays As Variant
	Dim canopy_material As Variant
	Call EnsureInit()
	ship.mesh = _mesh()
	vertices.clear()
	colors.clear()
	edges.clear()
	edge_colors.clear()
	If ship.get_child_count() > 0 Then Exit Sub
	canopy = ClassDB.Instantiate("MeshInstance3D")
	canopy_mesh = ClassDB.Instantiate("ArrayMesh")
	canopy_vertices.append(Vector3(-0.72, 2.05, 1.5))
	canopy_vertices.append(Vector3(0.0, 2.62, 1.75))
	canopy_vertices.append(Vector3(0.0, 1.28, 4.35))
	canopy_vertices.append(Vector3(0.72, 2.05, 1.5))
	canopy_vertices.append(Vector3(0.0, 1.28, 4.35))
	canopy_vertices.append(Vector3(0.0, 2.62, 1.75))
	canopy_colors.append(Color(0.55, 0.92, 1.0, 0.55))
	canopy_colors.append(Color(0.75, 0.96, 1.0, 0.4))
	canopy_colors.append(Color(0.85, 0.98, 1.0, 0.28))
	canopy_colors.append(Color(0.55, 0.92, 1.0, 0.55))
	canopy_colors.append(Color(0.85, 0.98, 1.0, 0.28))
	canopy_colors.append(Color(0.75, 0.96, 1.0, 0.4))
	canopy_arrays = Array()
	canopy_arrays.resize(Mesh.ARRAY_MAX)
	canopy_arrays(Mesh.ARRAY_VERTEX) = canopy_vertices
	canopy_arrays(Mesh.ARRAY_COLOR) = canopy_colors
	canopy_mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, canopy_arrays)
	canopy_material = ClassDB.Instantiate("StandardMaterial3D")
	canopy_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	canopy_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	canopy_material.vertex_color_use_as_albedo = True
	canopy_material.cull_mode = BaseMaterial3D.CULL_DISABLED
	canopy_mesh.surface_set_material(0, canopy_material)
	canopy.mesh = canopy_mesh
	canopy.cast_shadow = 0
	ship.add_child(canopy)
	Call _attach_flames()
	ship.visible = False
End Sub

Sub place_ship(ByVal x As Single, ByVal y As Single, ByVal z As Single, ByVal sc As Single, ByVal pitch As Single, ByVal yaw As Single, ByVal roll As Single)
	Call EnsureInit()
	ship.visible = True
	ship.position = Vector3(x, y, z)
	ship.rotation = Vector3(pitch, yaw, roll)
	ship.scale = Vector3(sc, sc, sc)
End Sub

Sub _attach_flames()
	Dim flames As Variant
	Dim mesh As Variant
	Dim flame_vertices As PackedVector3Array
	Dim flame_uvs As PackedVector2Array
	Dim flame_indices As PackedInt32Array
	Dim arrays As Variant
	Dim material As Variant
	Dim shader As Variant
	Dim side As Single
	Dim i As Integer
	Dim base As Integer
	flames = ClassDB.Instantiate("MeshInstance3D")
	mesh = ClassDB.Instantiate("ArrayMesh")
	For i = 0 To 1
		If i = 0 Then
			side = -1.8
		Else
			side = 1.8
		End If
		base = flame_vertices.size()
		flame_vertices.append(Vector3(side, 0.2, -2.75))
		flame_vertices.append(Vector3(side, 1.15, -2.75))
		flame_vertices.append(Vector3(side, 0.85, -6.4))
		flame_vertices.append(Vector3(side, 0.4, -6.4))
		flame_uvs.append(Vector2(0.0, 0.0))
		flame_uvs.append(Vector2(1.0, 0.0))
		flame_uvs.append(Vector2(1.0, 1.0))
		flame_uvs.append(Vector2(0.0, 1.0))
		flame_indices.append(base)
		flame_indices.append(base + 1)
		flame_indices.append(base + 2)
		flame_indices.append(base)
		flame_indices.append(base + 2)
		flame_indices.append(base + 3)
		base = flame_vertices.size()
		flame_vertices.append(Vector3(side - 0.48, 0.63, -2.75))
		flame_vertices.append(Vector3(side + 0.48, 0.63, -2.75))
		flame_vertices.append(Vector3(side + 0.22, 0.63, -6.4))
		flame_vertices.append(Vector3(side - 0.22, 0.63, -6.4))
		flame_uvs.append(Vector2(0.0, 0.0))
		flame_uvs.append(Vector2(1.0, 0.0))
		flame_uvs.append(Vector2(1.0, 1.0))
		flame_uvs.append(Vector2(0.0, 1.0))
		flame_indices.append(base)
		flame_indices.append(base + 1)
		flame_indices.append(base + 2)
		flame_indices.append(base)
		flame_indices.append(base + 2)
		flame_indices.append(base + 3)
	Next
	arrays = Array()
	arrays.resize(Mesh.ARRAY_MAX)
	arrays(Mesh.ARRAY_VERTEX) = flame_vertices
	arrays(Mesh.ARRAY_TEX_UV) = flame_uvs
	arrays(Mesh.ARRAY_INDEX) = flame_indices
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	material = ClassDB.Instantiate("ShaderMaterial")
	shader = Load("res://shaders/landing_flame.gdshader")
	material.shader = shader
	mesh.surface_set_material(0, material)
	flames.mesh = mesh
	flames.cast_shadow = 0
	flames.extra_cull_margin = 4.0
	ship.add_child(flames)
End Sub

Sub sample_input()
	Dim down As Variant
	Call EnsureInit()
	taps.clear()
	For Each code In AsArray(KEYS)
		down = Input.is_key_pressed(code) Or Input.is_physical_key_pressed(code)
		taps(code) = down And Not DictFlag(held, code)
		held(code) = down
	Next
End Sub

Function menu_tap(ByVal code As Integer) As Boolean
	Dim hit As Boolean
	Call EnsureInit()
	hit = DictFlag(taps, code)
	taps(code) = False
	Return hit
End Function

Sub begin_frame(Optional backlight_active As Variant = False)
	Call EnsureInit()
	vertices.clear()
	colors.clear()
	edges.clear()
	edge_colors.clear()
	world_mesh.visible = False
	frame_mesh.visible = False
	clouds.visible = False
	If ship <> Nothing Then ship.visible = False
	If Not backlight_active Then
		If camera.environment <> Nothing Then
			camera.environment = Nothing
		End If
		If Not viewport.transparent_bg Then
			viewport.transparent_bg = True
		End If
	End If
	If backlight_city <> Nothing Then
		backlight_city.deactivate()
		If backlight_city.audio <> Nothing Then
			If Not backlight_active Then
				backlight_city.audio.stop()
			Else
				backlight_city.audio.stream_paused = CBool(get_parent().get("menu_on")) Or CBool(get_parent().get("dev_on"))
			End If
		End If
	End If
	If city2 <> Nothing Then
		city2.visible = False
		city2_output.render_target_update_mode = SubViewport.UPDATE_DISABLED
	End If
	If city3 <> Nothing Then
		city3.visible = False
		city3_output.render_target_update_mode = SubViewport.UPDATE_DISABLED
	End If
	viewport.render_target_update_mode = SubViewport.UPDATE_DISABLED
	If external_view <> Nothing Then external_view.render_target_update_mode = SubViewport.UPDATE_DISABLED
End Sub

Sub segment(ByVal a As Vector3, ByVal b As Vector3, ByVal color As Color)
	Call EnsureInit()
	edges.append(a)
	edges.append(b)
	edge_colors.append(color)
	edge_colors.append(color)
End Sub

Sub hoop(ByVal x As Single, ByVal y As Single, ByVal z As Single, ByVal radius As Single, ByVal color As Color)
	Dim center As Variant
	Dim a As Variant
	Dim b As Variant
	Call EnsureInit()
	center = Vector3(x, y, z)
	For i = 0 To (40 - 1)
		a = 6.283185307179586 * i / 40.0
		b = 6.283185307179586 * (i + 1) / 40.0
		segment(center + Vector3(Cos(a), Sin(a), 0) * radius, center + Vector3(Cos(b), Sin(b), 0) * radius, color)
	Next
End Sub

Sub face(ByVal a As Vector3, ByVal b As Vector3, ByVal c As Vector3, ByVal d As Vector3, ByVal color As Color)
	Dim ink As Variant
	Call EnsureInit()
	ink = Color(color.r * 0.055, color.g * 0.055, color.b * 0.07, 1.0)
	For Each point In Array(a, b, c, a, c, d)
		vertices.append(point)
		colors.append(ink)
	Next
	For Each pair In Array(Array(a, b), Array(b, c), Array(c, d), Array(d, a))
		segment(pair(0), pair(1), color)
	Next
End Sub

Function _mesh() As ArrayMesh
	Dim mesh As Variant
	Dim arrays As Variant
	Dim src_edges As PackedVector3Array
	Dim src_colors As PackedColorArray
	Dim line_vertices As PackedVector3Array
	Dim line_normals As PackedVector3Array
	Dim line_colors As PackedColorArray
	Dim line_uvs As PackedVector2Array
	Dim n As Integer
	Dim i As Integer
	Call EnsureInit()
	mesh = ClassDB.Instantiate("ArrayMesh")
	If vertices.size() > 0 Then
		arrays = Array()
		arrays.resize(Mesh.ARRAY_MAX)
		arrays(Mesh.ARRAY_VERTEX) = vertices
		arrays(Mesh.ARRAY_COLOR) = colors
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		mesh.surface_set_material(mesh.get_surface_count() - 1, face_material)
	End If
	If edges.size() > 0 Then
		' Locals so the Step-2 ribbon body compiles to one native expand.
		' Stop at the shorter even length so a deduped edge list cannot
		' subscript past its colors.
		src_edges = edges
		src_colors = edge_colors
		n = src_edges.size()
		If src_colors.size() < n Then
			n = src_colors.size()
		End If
		If (n Mod 2) = 1 Then
			n = n - 1
		End If
		If n > 0 Then
		For i = 0 To (n - 1) Step 2
			line_vertices.append(src_edges(i))
			line_normals.append(src_edges(i + 1) - src_edges(i))
			line_colors.append(src_colors(i))
			line_uvs.append(Vector2(-1, 0))
			line_vertices.append(src_edges(i))
			line_normals.append(src_edges(i + 1) - src_edges(i))
			line_colors.append(src_colors(i))
			line_uvs.append(Vector2(1, 0))
			line_vertices.append(src_edges(i + 1))
			line_normals.append(src_edges(i + 1) - src_edges(i))
			line_colors.append(src_colors(i + 1))
			line_uvs.append(Vector2(1, 0))
			line_vertices.append(src_edges(i))
			line_normals.append(src_edges(i + 1) - src_edges(i))
			line_colors.append(src_colors(i))
			line_uvs.append(Vector2(-1, 0))
			line_vertices.append(src_edges(i + 1))
			line_normals.append(src_edges(i + 1) - src_edges(i))
			line_colors.append(src_colors(i + 1))
			line_uvs.append(Vector2(1, 0))
			line_vertices.append(src_edges(i + 1))
			line_normals.append(src_edges(i + 1) - src_edges(i))
			line_colors.append(src_colors(i + 1))
			line_uvs.append(Vector2(-1, 0))
		Next
		End If
		arrays = Array()
		arrays.resize(Mesh.ARRAY_MAX)
		arrays(Mesh.ARRAY_VERTEX) = line_vertices
		arrays(Mesh.ARRAY_NORMAL) = line_normals
		arrays(Mesh.ARRAY_COLOR) = line_colors
		arrays(Mesh.ARRAY_TEX_UV) = line_uvs
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		mesh.surface_set_material(mesh.get_surface_count() - 1, line_material)
	End If
	Return mesh
End Function

Function begin_yard(ByVal key As String) As Boolean
	Call EnsureInit()
	world_mesh.visible = True
	If yard_key = key And world_mesh.mesh <> Nothing Then
		Return False
	End If
	building_yard = True
	yard_key = key
	Return True
End Function

Sub bleed_city()
	Dim city As Node
	Call EnsureInit()
	If Not begin_yard("bleed-city") Then
		Exit Sub
	End If
	city = get_node_or_null("BleedCity")
	If city = Nothing Then
		city = SpawnVg("res://bleed_city.vg", "Node")
		city.name = "BleedCity"
		add_child(city)
	End If
	city.build(Me)
	end_yard()
End Sub

