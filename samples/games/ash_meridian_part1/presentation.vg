Dim CYAN As Variant
Dim PINK As Variant
Dim KEYS As Variant
Dim viewport As SubViewport
Dim camera As Camera3D
Dim world_mesh As MeshInstance3D
Dim frame_mesh As MeshInstance3D
Dim line_material As ShaderMaterial
Dim face_material As StandardMaterial3D
Dim held As Dictionary
Dim taps As Dictionary
Dim vertices As PackedVector3Array
Dim colors As PackedColorArray
Dim edges As PackedVector3Array
Dim edge_colors As PackedColorArray
Dim yard_key As Variant
Dim building_yard As Variant
Dim rebuild_count As Variant
Dim cockpit_view As SubViewport
Dim buggy_view As SubViewport
Dim ship_instruments As Node2D
Dim buggy_instruments As Node2D
Dim stars As Node2D
Dim clouds As MeshInstance3D
Dim ship As MeshInstance3D
Dim city2 As Node3D
Dim city2_output As SubViewport
Dim city2_antialiasing As Variant
Dim city3 As Node3D
Dim city3_output As SubViewport
Dim city3_antialiasing As Variant
Dim backlight_city As Node3D
Dim backlight_city_cache As Node3D
Dim backlight_yard As Node3D
Dim campaign_yard As Node3D
