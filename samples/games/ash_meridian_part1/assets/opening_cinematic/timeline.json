  "lines": [
    {
      "id": "01",
      "at": 2,
      "shot": "table",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "Oh, come on. You've been sitting on that all night?",
      "gap": 0.3,
      "speed": 1.02,
      "silence": 0.16,
      "audio": "voice/01.ogg",
      "backend": "kokoro",
      "seconds": 2.654375
    },
    {
      "id": "02",
      "at": 6,
      "shot": "table",
      "speaker": "JASON",
      "profile": "JASON",
      "text": "Thought you said I was easy to read.",
      "gap": 0.35,
      "speed": 1.02,
      "silence": 0.16,
      "audio": "voice/02.ogg",
      "backend": "kokoro",
      "seconds": 1.781583
    },
    {
      "id": "03",
      "at": 10,
      "shot": "warning",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "You are. When I'm sober.",
      "gap": 0.7,
      "speed": 1.01,
      "silence": 0.18,
      "audio": "voice/03.ogg",
      "backend": "kokoro",
      "seconds": 1.961333
    },
    {
      "id": "04",
      "at": 14,
      "shot": "warning",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "All right... you won. I'll send the coordinates.",
      "gap": 0.6,
      "speed": 0.98,
      "silence": 0.26,
      "audio": "voice/04.ogg",
      "backend": "kokoro",
      "seconds": 2.780625
    },
    {
      "id": "05",
      "at": 19,
      "shot": "warning",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "Jason. Look at me. Don't go there. I'm serious.",
      "gap": 0.75,
      "speed": 0.93,
      "silence": 0.32,
      "audio": "voice/05.ogg",
      "backend": "kokoro",
      "seconds": 4.02525
    },
    {
      "id": "06",
      "at": 24,
      "shot": "warning",
      "speaker": "JASON",
      "profile": "JASON",
      "text": "What happened out there?",
      "gap": 0.45,
      "speed": 1,
      "silence": 0.18,
      "audio": "voice/06.ogg",
      "backend": "kokoro",
      "seconds": 1.176125
    },
    {
      "id": "07",
      "at": 27,
      "shot": "warning",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "I don't want to talk about it. Not tonight.",
      "gap": 1,
      "speed": 0.94,
      "silence": 0.3,
      "audio": "voice/07.ogg",
      "backend": "kokoro",
      "seconds": 2.481417
    },
    {
      "id": "08",
      "at": 32,
      "shot": "choice",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "I think I'm done, Jason. I just... don't have it in me anymore. I used to love this work.",
      "gap": 0.8,
      "speed": 0.92,
      "silence": 0.34,
      "audio": "voice/08.ogg",
      "backend": "kokoro",
      "seconds": 5.155917
    },
    {
      "id": "09",
      "at": 39,
      "shot": "choice",
      "speaker": "JASON",
      "profile": "JASON",
      "text": "I'm tired of scraping by. One good haul, and Stacy and I might actually get somewhere.",
      "gap": 0.65,
      "speed": 0.98,
      "silence": 0.2,
      "audio": "voice/09.ogg",
      "backend": "kokoro",
      "seconds": 4.905667
    },
    {
      "id": "10",
      "at": 45,
      "shot": "choice",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "Yeah... I used to tell myself that too.",
      "gap": 1.15,
      "speed": 0.93,
      "silence": 0.34,
      "audio": "voice/10.ogg",
      "backend": "kokoro",
      "seconds": 2.357083
    },
    {
      "id": "11",
      "at": 50.51,
      "shot": "gift",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "Wait... you're going anyway, aren't you? I know you.",
      "gap": 0.65,
      "speed": 1.02,
      "silence": 0.2,
      "audio": "voice/11.ogg",
      "backend": "kokoro",
      "seconds": 2.964833
    },
    {
      "id": "12",
      "at": 56.51,
      "shot": "gift",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "My pack's still out there. Little shelter, east of the yard road. Broken amber marker by the drain.",
      "gap": 0.5,
      "speed": 1,
      "silence": 0.18,
      "audio": "voice/12.ogg",
      "backend": "kokoro",
      "seconds": 5.89425
    },
    {
      "id": "13",
      "at": 64.51,
      "shot": "gift",
      "speaker": "JASON",
      "profile": "JASON",
      "text": "You left your gear?",
      "gap": 0.3,
      "speed": 1,
      "silence": 0.16,
      "audio": "voice/13.ogg",
      "backend": "kokoro",
      "seconds": 1.227083
    },
    {
      "id": "14",
      "at": 67.51,
      "shot": "gift",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "There's a computer in there. Looks like junk. It isn't. I'll send you the software.",
      "gap": 0.7,
      "speed": 1.04,
      "silence": 0.16,
      "audio": "voice/14.ogg",
      "backend": "kokoro",
      "seconds": 4.711917
    },
    {
      "id": "15",
      "at": 75.51,
      "shot": "gift",
      "speaker": "MARK",
      "profile": "am_michael",
      "text": "Take it. I'm not going back. But listen... if it feels wrong, you leave. Right away.",
      "gap": 1.5,
      "speed": 0.93,
      "silence": 0.32,
      "audio": "voice/15.ogg",
      "backend": "kokoro",
      "seconds": 5.340458
    },
    {
      "id": "16",
      "at": 87.35,
      "shot": "departure",
      "speaker": "JASON",
      "profile": "JASON",
      "text": "Hey, Stace, it's me. I'm heading out. Might be out of range for a while. I'll call you when I can.",
      "gap": 1.5,
      "speed": 0.99,
      "silence": 0.2,
      "audio": "voice/16.ogg",
      "backend": "kokoro",
      "seconds": 5.423292
    },
    {
      "id": "17",
      "at": 107.35,
      "shot": "arrival",
      "speaker": "ORAC",
      "profile": "ORAC",
      "text": "Well, Mark wasn't making it up. Still, no one's answering us.",
      "gap": 1.1,
      "speed": 0.98,
      "silence": 0.2,
      "audio": "voice/17.ogg",
      "backend": "kokoro",
      "seconds": 4.033417
    },
    {
      "id": "18",
      "at": 116.35,
      "shot": "arrival",
      "speaker": "JASON",
      "profile": "JASON",
      "text": "He didn't mention it was this big.",
      "gap": 1.5,
      "speed": 1,
      "silence": 0.18,
      "audio": "voice/18.ogg",
      "backend": "kokoro",
      "seconds": 1.686417
    },
    {
      "id": "19",
      "at": 127.35,
      "shot": "approach",
      "speaker": "ORAC",
      "profile": "ORAC",
      "text": "I've found a way in. Give me a moment to match its rotation.",
      "gap": 0.65,
      "speed": 1,
      "silence": 0.18,
      "audio": "voice/19.ogg",
      "backend": "kokoro",
      "seconds": 3.708333
    },
    {
      "id": "20",
      "at": 135.35,
      "shot": "approach",
      "speaker": "JASON",
      "profile": "JASON",
      "text": "All right. Let's have a look.",
      "gap": 1.5,
      "speed": 1,
