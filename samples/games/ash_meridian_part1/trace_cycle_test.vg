Sub _Ready()
	If GetTree() Is Nothing Then Exit Sub
	If GetTree().current_scene = Me Then Call start_test("f6")
End Sub

Sub _Process(ByVal delta As Single)
	If mode = "f6" Then Call tick(delta)
End Sub

Sub start_test(ByVal start_mode As String)
	mode = start_mode
	yard_field = start_mode = "yard" Or start_mode = "yard_test"
	ignore_input = start_mode = "test" Or start_mode = "yard_test"
	paused = False
	debug_hud = False
	auto_speed = 0.0
	running = False
	host = Nothing
	inventory = New Dictionary
	gloss_age = New Dictionary
	translator_start_owned = True
	cradle_released = False
	yard_save_released = False
	yard_save_translator = False
	lock_open = False
	walk_pitch = 0.0
	lock_entry = ""
	lock_flash_t = 0.0
	nearby_hud = ""
	cradle_code = "2741"
	gloss_range_m = 6.0
	trans_signs = Array()
	trans_lock_path = "YardDock/ReleaseLock"
	trans_tag_path = "ServiceTag"
	trans_post_path = "TranslatorPost"
	trans_point_path = "TranslatorPoint"
	If get_parent() <> Nothing Then
		If get_parent().get_class() = "SubViewport" Then
			host = get_parent().get_parent()
		End If
	End If
	Call EnsureWorld()
	If ride_camera <> Nothing Then ride_camera.current = mode = "f6"
	set_process(mode = "f6")
	Call reset_run()
	If start_mode = "far_dock" Then Call SkipToFarDock()
	running = True
End Sub

' Dest skip: already at the far cradle with the field linked, so the vault
' can be reviewed without riding the outbound crossing.
Sub SkipToFarDock()
	If route Is Nothing Then Exit Sub
	If route.stage_name = "outbound_ready" Then route.advance("outbound_boarded")
	If route.stage_name = "outbound_crossing" Then route.advance("outbound_docked")
	relays = 3
	If relay_armed.size() >= 3 Then relay_armed = Array(False, False, False)
	Call UpdateRelayMasts(0.0)
	Call ApplyDock("far")
	ride_state = "docked"
	dock_id = "far"
	area_name = "crossing"
	inspect_return = "far"
	Call AimRideCamera(0.05)
	Call RefreshHud()
End Sub

Sub EnsureWorld()
	Dim packed As Object
	If world_ready Then Exit Sub
	route = ClassDB.Instantiate("RefCounted")
	route.SetScript(Load("res://trace_route.vg"))
	cyan_mat = Load("res://assets/trace_vault/materials/cyan.tres")
	amber_mat = Load("res://assets/trace_vault/materials/amber.tres")
	red_mat = Load("res://assets/trace_vault/materials/red.tres")
	trail_glow = MakeTraceGlow(Color(0.25, 0.95, 1.0, 1))
	trail_glow_red = MakeTraceGlow(Color(1.0, 0.14, 0.2, 1))
	atmosphere = ClassDB.Instantiate("Environment")
	atmosphere.background_mode = 1
	atmosphere.background_color = Color(0.016, 0.013, 0.033, 1)
	night_sky = ClassDB.Instantiate("Sky")
	night_sky.sky_material = Load("res://assets/trace_vault/materials/trace_sky.tres")
	night_sky.radiance_size = 1
	If night_sky.sky_material <> Nothing Then
		atmosphere.sky = night_sky
		atmosphere.background_mode = 2
	End If
	atmosphere.ambient_light_source = 3
	atmosphere.ambient_light_color = Color(0.45, 0.59, 0.75, 1)
	atmosphere.ambient_light_energy = 0.8
	atmosphere.glow_enabled = True
	atmosphere.glow_intensity = 1.5
	atmosphere.glow_strength = 1.3
	atmosphere.glow_bloom = 0.1
	atmosphere.glow_hdr_threshold = 0.95
	atmosphere.glow_blend_mode = 1
	atmosphere.set_glow_level(1, 1.0)
	atmosphere.set_glow_level(2, 1.0)
	atmosphere.set_glow_level(3, 0.8)
	atmosphere.set_glow_level(4, 0.6)
	If LowGpu() Then
		atmosphere.glow_intensity = 1.1
		atmosphere.glow_strength = 1.05
		atmosphere.glow_bloom = 0.04
		atmosphere.set_glow_level(5, 0.0)
		atmosphere.set_glow_level(6, 0.0)
	Else
		atmosphere.set_glow_level(5, 0.6)
		atmosphere.set_glow_level(6, 0.35)
	End If
	atmosphere.fog_enabled = True
	atmosphere.fog_light_color = Color(0.1, 0.075, 0.18, 1)
	atmosphere.fog_light_energy = 1.0
	atmosphere.fog_density = 0.0016
	atmosphere.fog_sky_affect = 0.0
	atmosphere.fog_height = -12.0
	atmosphere.fog_height_density = 0.02
	env_node = ClassDB.Instantiate("WorldEnvironment")
	env_node.environment = atmosphere
	add_child(env_node)
	sun_node = ClassDB.Instantiate("DirectionalLight3D")
	sun_node.rotation_degrees = Vector3(-42, -28, 0)
	sun_node.light_color = Color(0.6, 0.78, 1, 1)
	sun_node.light_energy = 1.6
	add_child(sun_node)
	rim_node = ClassDB.Instantiate("DirectionalLight3D")
	rim_node.rotation_degrees = Vector3(-24, 135, 0)
	rim_node.light_color = Color(0.65, 0.28, 0.42, 1)
	rim_node.light_energy = 1.0
	add_child(rim_node)
	If yard_field Then
		Call LoadYardConfig()
		packed = Load(Str(field_cfg("scene")))
		crossing = packed.instantiate()
		crossing.name = "YardVoidField"
	Else
		packed = Load("res://assets/trace_vault/scenes/void_crossing.tscn")
		crossing = packed.instantiate()
		crossing.name = "VoidCrossing"
	End If
	add_child(crossing)
	Call MuteCameras(crossing)
	Call QuietFloors(crossing)
	rid_bucket = Array()
	Call CollectBodyRids(crossing, "Support")
	Call CollectBodyRids(crossing, "Deck")
	floor_rids = rid_bucket
	rid_bucket = Array()
	If crossing.has_node("NearCradle") Then
		Call CollectBodyRids(crossing.get_node("NearCradle"), "Side")
	ElseIf crossing.has_node("YardDock/Cradle") Then
		Call CollectBodyRids(crossing.get_node("YardDock/Cradle"), "Side")
	End If
	near_cradle_rids = rid_bucket
	rid_bucket = Array()
	If crossing.has_node("FarCradle") Then
		Call CollectBodyRids(crossing.get_node("FarCradle"), "Side")
	ElseIf crossing.has_node("VaultCradle") Then
		Call CollectBodyRids(crossing.get_node("VaultCradle"), "Side")
	End If
	far_cradle_rids = rid_bucket
	packed = Load("res://assets/trace_vault/scenes/trace_cycle.tscn")
	player = packed.instantiate()
	player.name = "TraceCycle"
	player.motion_mode = 1
	add_child(player)
	visual = player.get_node("VisualRoot")
	canopy = player.get_node("VisualRoot/CanopyPivot")
	front_wheel = player.get_node("VisualRoot/FrontWheelPivot")
	rear_wheel = player.get_node("VisualRoot/RearWheelPivot")
	emitter = player.get_node("TraceEmitter")
	camera_target = player.get_node("CameraTarget")
	hull_col = player.get_node("HullCollision")
	player.safe_margin = 0.001
	hull_query = ClassDB.Instantiate("PhysicsShapeQueryParameters3D")
	hull_query.shape = hull_col.shape
	hull_query.collision_mask = 1
	hull_query.margin = 0.04
	hull_query.collide_with_areas = False
	hull_query.exclude = Array(player.get_rid())
	If visual <> Nothing Then Call ApplyMeshLayers(visual, SHELL_LAYER)
	packed = Load("res://assets/trace_vault/scenes/trace_cockpit.tscn")
	cockpit = packed.instantiate()
	cockpit.name = "Cockpit"
	camera_target.add_child(cockpit)
	Call ApplyMeshLayers(cockpit, COCKPIT_LAYER)
	hud_speed = cockpit.get_node("Windscreen/HudAnchor/HudSpeed")
	hud_trace = cockpit.get_node("Windscreen/HudAnchor/HudTrace")
	hud_hint = cockpit.get_node("Windscreen/HudAnchor/HudHint")
	motion_params = ClassDB.Instantiate("PhysicsTestMotionParameters3D")
	motion_result = ClassDB.Instantiate("PhysicsTestMotionResult3D")
	physics_srv = Engine.get_singleton("PhysicsServer3D")
	packed = Load("res://assets/trace_vault/scenes/security_cycle.tscn")
	remote = packed.instantiate()
	remote.name = "RemoteCycle"
	remote.motion_mode = 1
	add_child(remote)
	Call PlaceRemote()
	packed = Load("res://assets/trace_vault/scenes/vault_preview.tscn")
	vault = packed.instantiate()
	vault.name = "VaultPreview"
	vault.visible = False
	add_child(vault)
	Call MuteCameras(vault)
	Call SetCollisionEnabled(vault, False)
	If vault.has_node("Environment") Then vault.get_node("Environment").environment = Nothing
	Call AssembleFacility()
	Call MakeAbyssFlashes()
	Call MakeDockBeacons()
	Call MakeStarfield()
	Call MakeCueBank()
	Call MakeWalker()
	If remote <> Nothing Then
		If remote.has_node("TraceEmitter") Then enemy_emitter = remote.get_node("TraceEmitter")
		If remote.has_node("HullCollision") Then
			enemy_col = remote.get_node("HullCollision")
			enemy_query = ClassDB.Instantiate("PhysicsShapeQueryParameters3D")
			enemy_query.shape = enemy_col.shape
			enemy_query.collision_mask = 1
			enemy_query.exclude = Array(remote.get_rid())
		End If
	End If
	trail_root = ClassDB.Instantiate("Node3D")
	trail_root.name = "Trails"
	add_child(trail_root)
	grow_box = ClassDB.Instantiate("BoxMesh")
	grow_box.size = Vector3(0.16, 1.05, 0.2)
	grow_mesh = ClassDB.Instantiate("MeshInstance3D")
	grow_mesh.mesh = grow_box
	grow_mesh.material_override = trail_glow
	grow_mesh.cast_shadow = 0
	grow_mesh.visible = False
	grow_mesh.layers = SHELL_LAYER
	trail_root.add_child(grow_mesh)
	ride_camera = ClassDB.Instantiate("Camera3D")
	ride_camera.name = "RideCamera"
	ride_camera.fov = 68.0
	ride_camera.near = 0.05
	ride_camera.far = 420.0
	If yard_field Then ride_camera.far = 2800.0
	ride_camera.cull_mask = 1
	ride_camera.current = False
	add_child(ride_camera)
	Call MakeExteriorMonitor()
	Call MakeDashboard()
	Call MakeRelayGuides()
	If yard_field Then
		Call MakeFreeRelayGuides()
		Call MakeYardRadar()
		Call BindYardTranslation()
	End If
	Call MountBinnacleScreens()
	trails = Array()
	trail_born = Array()
	test_walls = Array()
	world_ready = True
End Sub

Sub ApplyMeshLayers(ByVal node As Object, ByVal layer As Integer)
	Dim i As Integer
	If node Is Nothing Then Exit Sub
	If node.get_class() = "MeshInstance3D" Or node.get_class() = "Label3D" Then node.layers = layer
	For i = 0 To node.get_child_count() - 1
		Call ApplyMeshLayers(node.get_child(i), layer)
	Next
End Sub

Sub CollectBodyRids(ByVal node As Object, ByVal prefix As String)
	Dim i As Integer
	If node Is Nothing Then Exit Sub
	If node.get_class() = "StaticBody3D" Then
		If Str(node.name).begins_with(prefix) Then rid_bucket.append(node.get_rid())
	End If
	For i = 0 To node.get_child_count() - 1
		Call CollectBodyRids(node.get_child(i), prefix)
	Next
End Sub

Sub QuietFloors(ByVal node As Object)
	Dim i As Integer
	Dim nm As String
	If node Is Nothing Then Exit Sub
	If node.get_class() = "StaticBody3D" Then
		nm = Str(node.name)
		If nm.begins_with("Deck") Then node.collision_layer = FLOOR_LAYER
	End If
	For i = 0 To node.get_child_count() - 1
		Call QuietFloors(node.get_child(i))
	Next
End Sub

Sub MakeExteriorMonitor()
	exterior_view = ClassDB.Instantiate("SubViewport")
	exterior_view.name = "ExteriorMonitor"
	exterior_view.size = Vector2i(524, 264)
	exterior_view.own_world_3d = False
	exterior_view.transparent_bg = True
	exterior_view.handle_input_locally = False
	exterior_view.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	add_child(exterior_view)
	exterior_view.world_3d = get_world_3d()
	exterior_camera = ClassDB.Instantiate("Camera3D")
	exterior_camera.name = "ExteriorCamera"
	exterior_camera.fov = 52.0
	exterior_camera.near = 0.12
	exterior_camera.far = 420.0
	exterior_camera.cull_mask = NO_COCKPIT_MASK
	exterior_camera.current = True
	exterior_view.add_child(exterior_camera)
End Sub

Function MakeLabel(ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal size As Integer, ByVal col As Color) As Object
	Dim lab As Object
	lab = ClassDB.Instantiate("Label")
	lab.position = Vector2(x, y)
	lab.size = Vector2(w, h)
	lab.add_theme_font_size_override("font_size", size)
	lab.add_theme_color_override("font_color", col)
	lab.mouse_filter = 2
	MakeLabel = lab
End Function

Function MakeSwatch(ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal col As Color) As Object
	Dim box As Object
	box = ClassDB.Instantiate("ColorRect")
	box.position = Vector2(x, y)
	box.size = Vector2(w, h)
	box.color = col
	box.mouse_filter = 2
	MakeSwatch = box
End Function

Sub AddChamferPoints(ByVal line As Object, ByVal w As Single, ByVal h As Single, ByVal cut As Single)
	line.add_point(Vector2(cut, 0.0))
	line.add_point(Vector2(w - cut, 0.0))
	line.add_point(Vector2(w, cut))
	line.add_point(Vector2(w, h - cut))
	line.add_point(Vector2(w - cut, h))
	line.add_point(Vector2(cut, h))
	line.add_point(Vector2(0.0, h - cut))
	line.add_point(Vector2(0.0, cut))
End Sub

Function MakeHudFrame(ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single) As Object
	Dim root As Object
	Dim glass As Object
	Dim outer As Object
	Dim inner As Object
	Dim cut As Single
	cut = 14.0
	root = ClassDB.Instantiate("Control")
	root.position = Vector2(x, y)
	root.size = Vector2(w, h)
	root.mouse_filter = 2
	glass = MakeSwatch(6.0, 6.0, w - 12.0, h - 12.0, Color(0.01, 0.03, 0.05, 0.9))
	root.add_child(glass)
	outer = ClassDB.Instantiate("Line2D")
	outer.width = 3.0
	outer.default_color = Color(0.28, 0.78, 0.92, 0.95)
	outer.closed = True
	outer.antialiased = True
	Call AddChamferPoints(outer, w, h, cut)
	root.add_child(outer)
	inner = ClassDB.Instantiate("Line2D")
	inner.width = 1.0
	inner.default_color = Color(0.55, 0.95, 1.0, 0.45)
	inner.closed = True
	inner.antialiased = True
	inner.position = Vector2(6.0, 6.0)
	Call AddChamferPoints(inner, w - 12.0, h - 12.0, cut - 5.0)
	root.add_child(inner)
	MakeHudFrame = root
End Function

Sub MakeClusterHousing()
	Dim body As Object
	Dim edge As Object
	Dim slot As Object
	cluster_hud = ClassDB.Instantiate("Control")
	cluster_hud.name = "ClusterHousing"
	cluster_hud.mouse_filter = 2
	hud_layer.add_child(cluster_hud)
	body = ClassDB.Instantiate("Polygon2D")
	body.polygon = PackedVector2Array(Array(Vector2(150, 540), Vector2(176, 380), Vector2(212, 360), Vector2(748, 360), Vector2(784, 380), Vector2(810, 540)))
	body.color = Color(0.035, 0.05, 0.075, 0.96)
	cluster_hud.add_child(body)
	edge = ClassDB.Instantiate("Line2D")
	edge.width = 2.0
	edge.antialiased = True
	edge.default_color = Color(0.3, 0.85, 1.0, 0.9)
	edge.add_point(Vector2(150, 540))
	edge.add_point(Vector2(176, 380))
	edge.add_point(Vector2(212, 360))
	edge.add_point(Vector2(748, 360))
	edge.add_point(Vector2(784, 380))
	edge.add_point(Vector2(810, 540))
	cluster_hud.add_child(edge)
	edge = ClassDB.Instantiate("Line2D")
	edge.width = 1.0
	edge.default_color = Color(0.3, 0.85, 1.0, 0.25)
	edge.add_point(Vector2(216, 365))
	edge.add_point(Vector2(744, 365))
	cluster_hud.add_child(edge)
	slot = MakeSwatch(476.0, 400.0, 8.0, 3.0, Color(1.0, 0.6, 0.2, 0.85))
	cluster_hud.add_child(slot)
	slot = MakeSwatch(476.0, 408.0, 8.0, 3.0, Color(0.3, 0.85, 1.0, 0.6))
	cluster_hud.add_child(slot)
End Sub

Sub AddMapGrid(ByVal host As Object, ByVal w As Single, ByVal h As Single)
	Dim i As Integer
	Dim line As Object
	For i = 1 To 11
		line = ClassDB.Instantiate("Line2D")
		line.width = 1.0
		line.default_color = Color(0.22, 0.58, 0.68, 0.28)
		line.add_point(Vector2(w * i / 12.0, 0.0))
		line.add_point(Vector2(w * i / 12.0, h))
		host.add_child(line)
	Next
	For i = 1 To 7
		line = ClassDB.Instantiate("Line2D")
		line.width = 1.0
		line.default_color = Color(0.22, 0.58, 0.68, 0.28)
		line.add_point(Vector2(0.0, h * i / 8.0))
		line.add_point(Vector2(w, h * i / 8.0))
		host.add_child(line)
	Next
End Sub

