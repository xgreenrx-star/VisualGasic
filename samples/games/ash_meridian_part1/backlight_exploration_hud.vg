' Generated Visual Gasic port of backlight_exploration_hud.vg
Dim __ready As Boolean
Dim CYAN As Variant
Dim AMBER As Variant
Dim PINK As Variant
Dim VIOLET As Variant
Dim city As Node


Function Num(ByVal value As Variant) As Single
	If value = True Then
		Num = 1.0
	ElseIf value = False Then
		Num = 0.0
	Else
		Num = value
	End If
End Function

Function FPosMod(ByVal value As Single, ByVal modulus As Single) As Single
	Dim wrapped As Single
	wrapped = value - modulus * Int(value / modulus)
	If wrapped < 0 Then wrapped = wrapped + modulus
	FPosMod = wrapped
End Function

Function FMod(ByVal value As Single, ByVal modulus As Single) As Single
	FMod = value - modulus * Int(value / modulus)
End Function

Function CeilInt(ByVal value As Single) As Integer
	Dim floored As Integer
	floored = Int(value)
	If value > floored Then
		CeilInt = floored + 1
	Else
		CeilInt = floored
	End If
End Function

Function RoundInt(ByVal value As Single) As Integer
	If value >= 0 Then
		RoundInt = Int(value + 0.5)
	Else
		RoundInt = Int(value - 0.5)
	End If
End Function

Function PadInt(ByVal value As Integer, ByVal width As Integer) As String
	Dim text As String
	If value < 0 Then value = 0
	text = Str(value)
	While Len(text) < width
		text = "0" & text
	Wend
	PadInt = text
End Function

Function AngleDifference(ByVal from_angle As Single, ByVal to_angle As Single) As Single
	Dim diff As Single
	diff = FPosMod(to_angle - from_angle, 6.283185307179586)
	If diff > 3.141592653589793 Then diff = diff - 6.283185307179586
	AngleDifference = diff
End Function

Function RotateToward(ByVal from_angle As Single, ByVal to_angle As Single, ByVal amount As Single) As Single
	Dim diff As Single
	diff = AngleDifference(from_angle, to_angle)
	If diff > amount Then diff = amount
	If diff < 0 - amount Then diff = 0 - amount
	RotateToward = from_angle + diff
End Function

Function DictFlag(ByVal table As Dictionary, ByVal code As Integer) As Boolean
	If table.Has(code) Then
		DictFlag = table(code)
	Else
		DictFlag = False
	End If
End Function

Function VecLess(ByVal a As Vector3, ByVal b As Vector3) As Boolean
	If a.x <> b.x Then
		VecLess = a.x < b.x
	ElseIf a.y <> b.y Then
		VecLess = a.y < b.y
	Else
		VecLess = a.z < b.z
	End If
End Function

Function SpawnVg(ByVal path As String, ByVal type_name As String) As Object
	Dim node As Object
	Dim script As Object
	node = ClassDB.Instantiate(type_name)
	script = Load(path)
	node.SetScript(script)
	SpawnVg = node
End Function

Function PackVec2(ByVal items As Array) As PackedVector2Array
	PackVec2 = PackedVector2Array(items)
End Function

Function PackVec3(ByVal items As Array) As PackedVector3Array
	PackVec3 = PackedVector3Array(items)
End Function

Function PackColor(ByVal items As Array) As PackedColorArray
	PackColor = PackedColorArray(items)
End Function

Function PackByte(ByVal items As Array) As PackedByteArray
	PackByte = PackedByteArray(items)
End Function

Function Sign(ByVal value As Single) As Single
	If value > 0 Then
		Sign = 1
	ElseIf value < 0 Then
		Sign = -1
	Else
		Sign = 0
	End If
End Function

Function AsArray(ByVal items As Variant) As Array
	Dim out As Array
	Dim i As Integer
	Dim n As Integer
	out = Array()
	If items = Nothing Then
		AsArray = out
		Exit Function
	End If
	' vbString = 8. Digit bars iterate "bc" as characters. String subscript is not an array.
	If VarType(items) = 8 Then
		n = Len(items)
		If n > 0 Then
			For i = 1 To n
				out.append(Mid(items, i, 1))
			Next
		End If
		AsArray = out
		Exit Function
	End If
	' GDScript `for x in N` walks 0..N-1. vbLong=3, vbDouble=5, vbInteger=2, vbSingle=4.
	If VarType(items) = 2 Or VarType(items) = 3 Or VarType(items) = 4 Or VarType(items) = 5 Then
		n = Int(items)
		If n > 0 Then
			For i = 0 To n - 1
				out.append(i)
			Next
		End If
		AsArray = out
		Exit Function
	End If
	For i = 0 To items.size() - 1
		out.append(items(i))
	Next
	AsArray = out
End Function


Sub EnsureInit()
	If __ready Then Exit Sub
	__ready = True
	CYAN = Color(0.4, 0.85, 1.0)
	AMBER = Color(1.0, 0.65, 0.22)
	PINK = Color(1.0, 0.3, 0.65)
	VIOLET = Color(0.7, 0.35, 1.0)
End Sub

Sub _text(ByVal at As Vector2, ByVal text As String, Optional size As Variant = 14, Optional color As Variant)
	If color Is Nothing Then
		color = CYAN
	End If
	Call EnsureInit()
	draw_string(ThemeDB.fallback_font, at, text, 0, -1, size, color)
End Sub

Sub glyph(ByVal at As Vector2, ByVal digit As Integer, Optional scale As Variant = 1.0, Optional color As Variant)
	Dim patterns As Variant
	Dim paths As Variant
	Dim points As PackedVector2Array
	If color Is Nothing Then
		color = AMBER
	End If
	Call EnsureInit()
	' An original stroke alphabet; keyboard numerals are controls, not the display.
	patterns = Array(15, 21, 38, 56, 41, 26, 52, 35, 29, 51)
	paths = Array(PackedVector2Array(Array(Vector2(0, 0), Vector2(7, 6), Vector2(14, 0))), PackedVector2Array(Array(Vector2(0, 18), Vector2(7, 12), Vector2(14, 18))), PackedVector2Array(Array(Vector2(0, 2), Vector2(0, 16))), PackedVector2Array(Array(Vector2(14, 2), Vector2(14, 16))), PackedVector2Array(Array(Vector2(3, 9), Vector2(11, 9))), PackedVector2Array(Array(Vector2(7, -3), Vector2(7, 21))))
	For i = 0 To (paths.size() - 1)
		If patterns(digit)  And  (1 << i) Then
			For Each p In AsArray(paths(i))
				points.append(at + p * scale)
			Next
			draw_polyline(points, color, 1.7 * scale, True)
		End If
	Next
End Sub

Sub glyph_string(ByVal at As Vector2, ByVal text As String, Optional scale As Variant = 1.0, Optional color As Variant)
	If color Is Nothing Then
		color = AMBER
	End If
	Call EnsureInit()
	For i = 0 To (text.length() - 1)
		glyph(at + Vector2(i * 23 * scale, 0), Int(text.substr(i, 1)), scale, color)
	Next
End Sub

Sub _draw()
	Dim driving As Boolean
	Dim mission_offset As Integer
	Dim mission_lines As Array
	Dim title As Variant
	Dim at As Variant
	Dim _t0 As Variant
	Dim _t1 As Variant
	Dim _t2 As Variant
	Dim _t3 As Variant
	Dim _t4 As Variant
	Dim _t5 As Variant
	Dim _t6 As Variant
	Dim _t7 As Variant
	Dim _t8 As Variant
	Call EnsureInit()
	mission_offset = 0
	If city.mission_guidance_enabled() Then mission_offset = 50
	driving = city.driving And city.place = "surface" And city.inspection = 0
	draw_rect(Rect2(0, 0, 960, 64 + mission_offset), Color(0.005, 0.015, 0.025, 0.87))
	If city.place = "lift" Then
		_t0 = "DEEP TRANSIT / LIFT"
	Else
		_t0 = "DEEP STRATUM"
	End If
	If city.place = "building" Then
		_t1 = Str(city.buildings(city.building_index).label)
	Else
		_t1 = (_t0)
	End If
	If city.place = "surface" Then
		If city.yard_mode Then
			title = "BACKLIGHT YARD / SURFACE"
		Else
			title = "BACKLIGHT CITY / SURFACE"
		End If
	Else
		title = (_t1)
	End If
	_text(Vector2(22, 24), title, 18)
	If city.place = "floor" Then
		glyph_string(Vector2(240, 10), city.floor_code, 0.65)
	End If
	If city.inventory.has("regulator") Then
		_t3 = "PRESSURE OK"
	Else
		_t3 = "PRESSURE --"
	End If
	If city.inventory.has("ignition") Then
		_t4 = "IGNITION OK"
	Else
		_t4 = "IGNITION --"
	End If
	If city.inventory.has("coupler") Then
		_t5 = "COUPLER OK"
	Else
		_t5 = "COUPLER --"
	End If
	If city.campaign_mode Then
		_text(Vector2(22, 47), "JASON / ORAC ONLINE / POWER " & _t5 & " / SUIT " & Str(city.shield) & " / H SCAN", 12)
	Else
		_text(Vector2(22, 47), "SHIP: "  & (_t3)  & " / "  & (_t4)  & " / "  & (_t5)  & "    SUIT "  & Str(city.shield), 12)
	End If
	If mission_offset > 0 Then
		_text(Vector2(830, 47), "F1 BRIEFING", 12)
		mission_lines = wrap_lines("CURRENT JOB: " & city.mission_objective(), 112)
		For i = 0 To mission_lines.size() - 1
			_text(Vector2(22, 80 + i * 18), mission_lines(i), 12, AMBER)
		Next
	End If
	If Not driving Or mission_offset > 0 Then
		draw_rect(Rect2(0, 495, 960, 45), Color(0.005, 0.015, 0.025, 0.9))
		If driving Then
			_text(Vector2(20, 520), "W/S DRIVE / A/D STEER / F EXIT / V INSPECT", 14)
		Else
			_text(Vector2(20, 520), city.prompt(), 14)
		End If
	Else
		If city.trace_escape Then
			_text(Vector2(225, 86), "ASH: SOUTH / W ACCELERATE / A/D STEER / F PARK", 12)
		Else
			_text(Vector2(225, 86 + mission_offset), "F EXIT / V INSPECT", 12)
		End If
	End If
	If city.message_left > 0 And Not city.trace_escape Then
		draw_rect(Rect2(14, 72 + mission_offset, 932, 38), Color(0.005, 0.01, 0.02, 0.87))
		If mission_offset > 0 Then
			mission_lines = wrap_lines(city.message, 112)
			For i = 0 To mission_lines.size() - 1
				_text(Vector2(24, 86 + mission_offset + i * 16), mission_lines(i), 13, AMBER)
			Next
		Else
			_text(Vector2(24, 96), city.message, 13, AMBER)
		End If
	End If
	If city.mission_briefing_visible() Then
		draw_rect(Rect2(205, 166, 741, 134), Color(0.005, 0.015, 0.025, 0.94))
		_text(Vector2(221, 188), "ORAC / EXPEDITION BRIEFING / F1 CLOSE", 14, AMBER)
		mission_lines = city.mission_briefing()
		For i = 0 To mission_lines.size() - 1
			_text(Vector2(221, 212 + i * 23), mission_lines(i), 12)
		Next
	End If
	If Not driving And Not city.trace_escape And city.place <> "floor" Then
		draw_rect(Rect2(14, 126 + mission_offset, 170, 121), Color(0.005, 0.01, 0.02, 0.8))
		_text(Vector2(26, 148 + mission_offset), "DESCENT JOURNAL", 12)
		For i = 0 To (5 - 1)
			at = Vector2(27 + i * 29, 165 + mission_offset)
			draw_rect(Rect2(at - Vector2(4, 4), Vector2(25, 31)), CYAN * 0.3, False)
			If city.discovered.has(i) Then
				glyph(at, Int(city.discovered(i)), 1.0)
			End If
		Next
		If mission_offset > 0 Then
			_text(Vector2(25, 220 + mission_offset), "BUILDINGS -> GLYPHS", 10)
			_text(Vector2(25, 238 + mission_offset), "5 GLYPHS = LIFT CODE", 10)
		Else
			_text(Vector2(25, 226), "Search the five archives.", 11)
		End If
	End If
	If city.trace_escape Then
		draw_rect(Rect2(725, 120, 220, 64), Color(0.005, 0.025, 0.035, 0.8))
		_text(Vector2(744, 144), "ASH / SOUTH LANDING PAD", 12, CYAN)
		If city.escape_grace > 0 Then
			_text(Vector2(744, 168), "GRID RESTARTING - GET MOVING", 11, AMBER)
		Else
			_text(Vector2(744, 168), "TURRETS LIVE - USE COVER", 11, AMBER)
		End If
	ElseIf city.awakening Then
		draw_rect(Rect2(725, 120, 220, 82), Color(0.025, 0.005, 0.018, 0.92))
		_text(Vector2(744, 142), "PURGE / ORAC ONLINE", 12, PINK)
		glyph_string(Vector2(756, 157), PadInt(CeilInt(city.countdown), 3), 1.5, PINK)
		If FMod(city.alarm_elapsed, 1.0) < 0.3 Then
			draw_rect(Rect2(0, 0, 960, 540), Color(1, 0.03, 0.2, 0.055))
		End If
		If city.alarm_elapsed < 8 Then
			_text(Vector2(340, 330), "ORAC: RUN!", 38, PINK)
		End If
	End If
	If city.place = "floor" Then Call draw_stratum()
	If city.keypad Then
		Call draw_known_codes()
		draw_rect(Rect2(220, 140, 520, 330), Color(0.01, 0.025, 0.04, 0.98))
		_text(Vector2(247, 171), "DEEP TRANSIT / FIVE-SYMBOL ADDRESS", 17)
		glyph_string(Vector2(363, 198), city.sequence, 1.7)
		For digit = 0 To (10 - 1)
			at = Vector2(260 + (digit  Mod  5) * 94, 263 + Int(digit / 5) * 68)
			draw_rect(Rect2(at - Vector2(12, 7), Vector2(70, 55)), CYAN * 0.25, False)
			glyph(at, digit, 1.3)
			_text(at + Vector2(32, 22), Str(digit), 12, CYAN * 0.8)
		Next
		_text(Vector2(244, 420), "0-9 choose / Backspace erase / Enter descend", 14)
		_text(Vector2(244, 446), "F cancel. Journal order is left to right.", 13)
	End If
	If city.transit_left > 0 Then
		draw_rect(Rect2(250, 438, 460, 52), Color(0.005, 0.015, 0.025, 0.94))
		If city.lift_target = "surface" Then
			_t6 = "ASCENDING"
		Else
			_t6 = "DESCENDING TO STRATUM"
		End If
		_text(Vector2(270, 458), _t6, 16)
		If city.lift_target <> "surface" Then
			glyph_string(Vector2(560, 446), city.lift_target, 0.7)
		End If
	End If
	If city.failed Or (city.completed And (Not city.trace_escape Or city.launch_elapsed >= 6.0)) Then
		draw_rect(Rect2(150, 220, 660, 150), Color(0.005, 0.015, 0.025, 0.97))
		If city.completed Then
			_t7 = "THE ASH IS AWAY"
		Else
			_t7 = "ESCAPE FAILED"
		End If
		_text(Vector2(210, 258), _t7, 28, AMBER)
		If city.completed Then
			If city.departure_saved Then
				_t8 = "LEVEL 1 COMPLETE / Esc: return to title."
			ElseIf city.trace_escape Then
				_t8 = "First expedition escape complete. Esc: return to title."
			ElseIf city.campaign_mode Then
				_t8 = "First expedition complete. Esc: save or return to title."
			Else
				_t8 = "Enter: restart prototype"
			End If
		Else
			If city.trace_escape Then
				_t8 = "Enter: retry from the yard dock"
			Else
				_t8 = "Enter: retry from the FEB chamber"
			End If
		End If
		_text(Vector2(210, 295), _t8, 18)
		If city.departure_saved Then
			_text(Vector2(210, 332), "Departure saved. Continue resumes Level 1 complete.", 13)
		ElseIf city.trace_escape Then
			_text(Vector2(210, 332), "Recovered hardware retained. Campaign save unchanged.", 13)
		ElseIf city.campaign_mode And city.completed Then
			_text(Vector2(180, 332), "Flight and station chapters are not implemented in this build yet.", 13)
		ElseIf city.campaign_mode Then
			_text(Vector2(210, 332), "ORAC: Chamber checkpoint ready. Recover the coupler and run.", 13)
		Else
			_text(Vector2(210, 332), "Chapter save unchanged. This is the exploration prototype.", 13)
		End If
	End If
	If city.place = "floor" And city.deep.fade > 0.0 Then
		draw_rect(Rect2(0, 0, 960, 540), Color(0, 0, 0, ClampF(city.deep.fade, 0.0, 1.0)))
	End If
	If city.plus4_menu_open Then draw_plus4_menu()
End Sub

Sub draw_plus4_menu()
	Dim modules As Array
	Dim row_y As Single
	Dim link_status As String
	Dim governor_status As String
	Dim i As Integer
	Call EnsureInit()
	modules = Array("MODULE MAP", "POWER REGULATION", "THERMAL CONTROL", "GOVERNOR CONTROL", "EVENT LOG")
	draw_rect(Rect2(0, 0, 960, 540), Color(0.005, 0.008, 0.012, 0.78))
	draw_rect(Rect2(112, 52, 736, 436), Color(0.035, 0.043, 0.048, 0.99))
	draw_rect(Rect2(112, 52, 736, 436), Color(0.72, 0.43, 0.18), False, 1.5)
	draw_rect(Rect2(128, 68, 704, 46), Color(0.075, 0.082, 0.082))
	_text(Vector2(144, 88), "M.J.H. / WRIST LINK", 17, AMBER)
	_text(Vector2(144, 104), "COMMANDER +4    /    1541 SERVICE PORT    /    TRANSLATION ONLINE", 10, Color(0.67, 0.68, 0.63))
	If city.can_edit_feb_governor() Then
		link_status = "LINK: FEB UNIT 07"
	Else
		link_status = "LINK: LOCAL / NO FEB"
	End If
	_text(Vector2(677, 91), link_status, 11, CYAN)
	draw_rect(Rect2(136, 128, 248, 306), Color(0.018, 0.025, 0.028))
	_text(Vector2(151, 151), "SYSTEM BUS", 11, Color(0.72, 0.43, 0.18))
	For i = 0 To modules.size() - 1
		row_y = 166 + i * 44
		If city.plus4_menu_selection = i Then
			draw_rect(Rect2(145, row_y - 19, 229, 34), Color(0.20, 0.12, 0.055))
			draw_rect(Rect2(145, row_y - 19, 3, 34), AMBER)
			_text(Vector2(157, row_y), "> " & modules(i), 12, Color(0.94, 0.78, 0.48))
		Else
			_text(Vector2(157, row_y), modules(i), 12, Color(0.62, 0.66, 0.63))
		End If
	Next
	draw_line(Vector2(402, 128), Vector2(402, 434), Color(0.30, 0.26, 0.20), 1.0)
	If city.plus4_menu_page = 0 Then
		_text(Vector2(427, 158), "MODULE MAP / SERVICE BUS", 15, AMBER)
		_text(Vector2(427, 195), "Select a subsystem to inspect its controller.", 12, Color(0.75, 0.77, 0.72))
		_text(Vector2(427, 231), "The Plus/4 is connected through its local", 12, Color(0.65, 0.69, 0.66))
		_text(Vector2(427, 250), "maintenance interface. Changes require a", 12, Color(0.65, 0.69, 0.66))
		_text(Vector2(427, 269), "valid device link and operator confirmation.", 12, Color(0.65, 0.69, 0.66))
	ElseIf city.plus4_menu_selection = 3 Then
		If city.stratum.get("feb_governor_bypassed", False) Then
			governor_status = "ISOLATED / LIMITS DISABLED"
		Else
			governor_status = "ACTIVE / OUTPUT RESTRICTED"
		End If
		_text(Vector2(427, 158), "GOVERNOR MODULE / FEB UNIT 07", 15, AMBER)
		_text(Vector2(427, 179), "ORAC: 1541 port detected. Connecting Plus/4 now.", 11, Color(0.80, 0.83, 0.77))
		_text(Vector2(427, 193), "SAFETY INTERLOCK: " & governor_status, 12, Color(0.88, 0.80, 0.62))
		_text(Vector2(427, 221), "1541 PORT: CONNECTED / REMOTE COMMAND: REJECTED", 11, Color(0.67, 0.69, 0.65))
		_text(Vector2(427, 249), "Orac: Local maintenance bypass required.", 12, Color(0.72, 0.75, 0.70))
		If city.can_edit_feb_governor() Then
			draw_rect(Rect2(427, 283, 326, 42), Color(0.11, 0.18, 0.17), False, 1.2)
			If city.stratum.get("feb_governor_bypassed", False) Then
				_text(Vector2(444, 309), "GOVERNOR ALREADY ISOLATED", 12, CYAN)
			Else
				_text(Vector2(444, 309), "ENTER / EDIT GOVERNOR PARAMETERS", 11, CYAN)
			End If
		Else
			_text(Vector2(427, 304), "LOCAL LINK REQUIRED: STAND BY THE FEB SOCKET", 11, AMBER)
		End If
	Else
		_text(Vector2(427, 158), modules(city.plus4_menu_selection), 15, AMBER)
		If city.plus4_menu_selection = 1 Then
			_text(Vector2(427, 195), "SHIP POWER BUS: NOMINAL", 12, Color(0.75, 0.77, 0.72))
		ElseIf city.plus4_menu_selection = 2 Then
			_text(Vector2(427, 195), "THERMAL REGULATOR: NOMINAL", 12, Color(0.75, 0.77, 0.72))
		ElseIf city.plus4_menu_selection = 4 Then
			_text(Vector2(427, 195), "No recent local service events.", 12, Color(0.75, 0.77, 0.72))
		Else
			_text(Vector2(427, 195), "Select a module from the service bus.", 12, Color(0.75, 0.77, 0.72))
		End If
		_text(Vector2(427, 230), "READ-ONLY STATUS", 10, Color(0.72, 0.43, 0.18))
	End If
	If city.plus4_menu_page = 2 Then
		draw_rect(Rect2(0, 0, 960, 540), Color(0, 0, 0, 0.58))
		draw_rect(Rect2(220, 155, 520, 230), Color(0.045, 0.035, 0.025, 1.0))
		draw_rect(Rect2(220, 155, 520, 230), AMBER, False, 1.4)
		_text(Vector2(252, 193), "CONFIRM GOVERNOR ISOLATION", 18, AMBER)
		_text(Vector2(252, 232), "WARNING: SAFETY GOVERNOR DISABLED.", 13, Color(1.0, 0.73, 0.36))
		_text(Vector2(252, 256), "The FEB may act outside its operating limits.", 12, Color(0.82, 0.80, 0.73))
		_text(Vector2(252, 301), "ENTER / CONFIRM BYPASS", 13, CYAN)
		_text(Vector2(252, 330), "BACKSPACE / RETURN TO MODULE", 11, Color(0.68, 0.69, 0.65))
	End If
	draw_rect(Rect2(128, 446, 704, 26), Color(0.075, 0.082, 0.082))
	_text(Vector2(146, 464), "UP/DOWN SELECT    ENTER OPEN / CONFIRM    BACKSPACE BACK    TAB / ESC CLOSE", 10, Color(0.78, 0.73, 0.62))
End Sub

' Orac's helmet readout: Narcean glyphs in view, re-rendered in English. The FEB contests the link once awake.
Function visor_glitch(ByVal text As String) As String
	Dim out As String
	Dim phase As Integer
	If Not city.awakening Then Return text
	phase = Int(city.alarm_elapsed * 7.0)
	out = ""
	For i = 1 To Len(text)
		If (i * 7 + phase) Mod 5 = 0 And Mid(text, i, 1) <> " " Then
			out = out & "#"
		Else
			out = out & Mid(text, i, 1)
		End If
	Next
	Return out
End Function

Function wrap_lines(ByVal text As String, ByVal width As Integer) As Array
	Dim out As Array
	Dim line_text As String
	out = Array()
	line_text = ""
	For Each word In AsArray(text.split(" "))
		If Len(line_text) > 0 And Len(line_text) + 1 + Len(word) > width Then
			out.append(line_text)
			line_text = word
		ElseIf Len(line_text) > 0 Then
			line_text = line_text & " " & word
		Else
			line_text = word
		End If
	Next
	If Len(line_text) > 0 Then out.append(line_text)
	Return out
End Function

Sub draw_bar(ByVal at As Vector2, ByVal label As String, ByVal amount As Single, ByVal color As Color)
	_text(at + Vector2(0, 11), label, 11, color)
	draw_rect(Rect2(at + Vector2(38, 2), Vector2(120, 10)), color * 0.35, False)
	draw_rect(Rect2(at + Vector2(39, 3), Vector2(118.0 * ClampF(amount, 0.0, 1.0), 8)), color * 0.85)
End Sub

Sub draw_stratum()
	Dim deep As Object
	Dim text As String
	Dim lines As Array
	Dim list As Array
	Dim at As Vector2
	Dim id As String
	Dim tint As Color
	Dim h As Single
	deep = city.deep
	' Suit telemetry.
	h = 48
	If deep.has_item(city, "jetpack") Then h = 66
	draw_rect(Rect2(14, 482 - h, 176, h), Color(0.005, 0.015, 0.025, 0.78))
	draw_bar(Vector2(24, 488 - h), "SUIT", city.shield / 100.0, CYAN)
	If city.radiation > 50 Then
		tint = PINK
	Else
		tint = AMBER
	End If
	draw_bar(Vector2(24, 506 - h), "RAD", city.radiation / 100.0, tint)
	If deep.has_item(city, "jetpack") Then draw_bar(Vector2(24, 524 - h), "JET", Num(city.stratum("jet_fuel")), Color(0.55, 1.0, 0.6))
	' Visor translation.
	text = deep.visor_text(city)
	If text <> "" And Not deep.modal_active() And Not city.keypad Then
		If text.begins_with("TRANSLATED: ") Then text = text.substr(12)
		lines = wrap_lines(visor_glitch(text), 46)
		h = 30 + lines.size() * 17
		If city.awakening Then h = h + 17
		draw_rect(Rect2(520, 480 - h, 426, h - 6), Color(0.02, 0.09, 0.12, 0.42))
		draw_rect(Rect2(520, 480 - h, 426, h - 6), CYAN * 0.45, False)
		_text(Vector2(532, 480 - h + 18), "TRANSLATED:", 11, CYAN * 0.8)
		For i = 0 To lines.size() - 1
			_text(Vector2(532, 480 - h + 36 + i * 17), lines(i), 13, CYAN)
		Next
		If city.awakening Then _text(Vector2(532, 480 - h + 36 + lines.size() * 17), "SIGNAL CONTESTED / FEB", 11, PINK)
	End If
	' Pack.
	If deep.inv_open Then
		list = deep.pack_list(city)
		draw_rect(Rect2(220, 120, 520, 360), Color(0.01, 0.025, 0.04, 0.96))
		_text(Vector2(244, 150), "PACK", 18)
		If list.size() = 0 Then _text(Vector2(244, 190), "Empty. Salvage glows amber on the scanner.", 13)
		For i = 0 To list.size() - 1
			id = list(i)
			at = Vector2(244, 182 + i * 22)
			If i = Min(deep.inv_index, list.size() - 1) Then
				draw_rect(Rect2(at - Vector2(8, 15), Vector2(486, 21)), CYAN * 0.2)
				lines = wrap_lines(deep.item_text(id), 70)
				For j = 0 To lines.size() - 1
					_text(Vector2(244, 420 + j * 16), lines(j), 12, AMBER)
				Next
			End If
			_text(at, deep.item_name(id), 14)
			If Int(city.pack(id)) > 1 Then _text(at + Vector2(400, 0), "x" & Str(Int(city.pack(id))), 13)
		Next
	End If
	If deep.hacking Then
		draw_rect(Rect2(250, 150, 460, 250), Color(0.015, 0.01, 0.035, 0.96))
		If city.campaign_mode Then
			_text(Vector2(274, 180), "COMMANDER +4 / LOCK COUPLING", 15, PINK)
		Else
			_text(Vector2(274, 180), "PSIONIC SCREWDRIVER / LOCK COUPLING", 15, PINK)
		End If
		For i = 0 To deep.hack_target.size() - 1
			at = Vector2(290 + i * 62, 214)
			If i < deep.hack_filled Then
				draw_rect(Rect2(at - Vector2(10, 8), Vector2(38, 44)), CYAN * 0.3)
				glyph(at, Int(deep.hack_target(i)), 1.1, CYAN)
			ElseIf i = deep.hack_filled Then
				draw_rect(Rect2(at - Vector2(10, 8), Vector2(38, 44)), AMBER, False)
				glyph(at, Int(deep.hack_target(i)), 1.1, AMBER)
			Else
				draw_rect(Rect2(at - Vector2(10, 8), Vector2(38, 44)), CYAN * 0.25, False)
			End If
		Next
		If deep.hack_glyph >= 0 Then glyph(Vector2(462, 288), deep.hack_glyph, 2.2, PINK)
		_text(Vector2(274, 372), "LOCK RE-KEYS IN " & Str(CeilInt(deep.hack_left)) & "s", 13, AMBER)
	End If
	' Narcean terminal: the machine's own script; Orac has no lexicon for it.
	If deep.term_open Then
		draw_rect(Rect2(250, 110, 460, 330), Color(0.02, 0.008, 0.04, 0.95))
		draw_rect(Rect2(250, 110, 460, 330), VIOLET * 0.6, False)
		draw_rect(Rect2(262, 122, 436, 24), Color(0.02, 0.09, 0.12, 0.42))
		_text(Vector2(270, 139), "TRANSLATED: [NO LEXICON MATCH]", 12, CYAN * 0.8)
		For i = 0 To deep.term_log.size() - 1
			text = deep.term_log(i)
			If text.begins_with(">") Then
				glyph_string(Vector2(690 - (text.length() - 1) * 23 * 0.6, 162 + i * 28), text.substr(1), 0.6, CYAN)
			Else
				glyph_string(Vector2(274, 162 + i * 28), text.substr(1), 0.6, VIOLET)
			End If
		Next
		draw_line(Vector2(262, 394), Vector2(698, 394), VIOLET * 0.4, 1.0)
		glyph_string(Vector2(274, 404), deep.term_input, 0.7, CYAN)
		If Int(Time.get_ticks_msec() / 400) Mod 2 = 0 Then draw_rect(Rect2(276 + deep.term_input.length() * 23 * 0.7, 404, 9, 15), CYAN * 0.7)
	End If
End Sub

Sub draw_known_codes()
	Dim codes As Array
	Dim pitch As Integer
	If city.place <> "floor" And city.place <> "lift" Then Exit Sub
	codes = city.deep.known_codes(city)
	If codes.size() = 0 Then Exit Sub
	pitch = 40
	If codes.size() >= 8 Then pitch = 26
	draw_rect(Rect2(14, 140, 200, 34 + codes.size() * pitch), Color(0.01, 0.025, 0.04, 0.94))
	_text(Vector2(26, 162), "KNOWN ADDRESSES", 12)
	For i = 0 To codes.size() - 1
		If pitch < 40 Then
			glyph_string(Vector2(28, 174 + i * pitch), codes(i), 0.42)
			_text(Vector2(96, 186 + i * pitch), city.deep.address_label(city, codes(i)), 9, CYAN * 0.85)
		Else
			glyph_string(Vector2(28, 178 + i * pitch), codes(i), 0.55)
			_text(Vector2(26, 205 + i * pitch), city.deep.address_label(city, codes(i)), 9, CYAN * 0.85)
		End If
	Next
End Sub
