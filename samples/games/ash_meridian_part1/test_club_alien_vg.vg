Option Explicit

Dim position_xz As Vector2
Dim stratum As Dictionary
Dim message As String
Dim message_left As Single
Dim opt_orac_voice As Boolean
Dim checks As Integer
Dim failures As Integer
Dim finish_frames As Integer
Dim done As Boolean

Sub notify(ByVal text As String)
	message = text
End Sub

Sub check(ByVal condition As Boolean, ByVal label As String)
	checks = checks + 1
	If condition Then
		Print "PASS: " & label
	Else
		failures = failures + 1
		Print "FAIL: " & label
	End If
End Sub

Sub _Ready()
	Dim alien As Object
	Dim faces As Array
	Dim verts As PackedVector3Array
	Dim mesh As Object
	Dim state As Dictionary
	Dim side_wisps As Integer
	Dim crown_wisps As Integer
	Dim i As Integer
	Dim forward As Vector3
	Dim direction As Vector3
	Dim target As Vector2
	Dim initial As Single
	position_xz = Vector2(-3.2, 20.8)
	stratum = New Dictionary
	opt_orac_voice = True
	alien = ClassDB.Instantiate("Node3D")
	alien.set_script(Load("res://club_alien.vg"))
	add_child(alien)
	alien.setup(Me)
	check(alien.last_error = "", "VG_resident_loads_assets_without_error")
	check(alien.has_node("HumanHologram") And alien.has_node("HumanHologramWire"), "VG_resident_builds_both_batched_faces")
	If Not alien.has_node("HumanHologramWire") Then
		alien.free()
		GetTree().quit(1)
		Exit Sub
	End If
	mesh = alien.get_node("HumanHologramWire").mesh
	verts = mesh.surface_get_arrays(0)(Mesh.ARRAY_VERTEX)
	For Each vertex In verts
		If Abs(vertex.x) > 0.85 And vertex.y > 0.0 Then side_wisps = side_wisps + 1
		If vertex.y > 1.3 Then crown_wisps = crown_wisps + 1
	Next
	check(side_wisps > 1800 And crown_wisps > 1200, "VG_hair_retains_crown_and_side_geometry")
	check(mesh.get_surface_count() = 1 And alien.face_materials.size() = 2, "VG_hologram_stays_batched")
	alien.tick(0.016)
	check(alien.index = 0 And message.contains("untranslated Narcean"), "VG_resident_greets_in_Narcean")
	check(alien.player.playing, "VG_greeting_plays_recording")
	For Each target In Array(Vector2(4, 20.8), Vector2(-9, 20.8))
		position_xz = target
		initial = alien.head_yaw
		alien.tick(0.05)
		check(Abs(alien.head_yaw - initial) < 0.65, "VG_head_turns_smoothly")
		For i = 0 To 119
			alien.tick(1.0 / 60.0)
		Next
		faces = alien.faces
		forward = -faces(0).basis.z
		direction = Vector3(target.x + 3.2, -1.0, target.y - 22.8).normalized()
		check(forward.dot(direction) > 0.99, "VG_face_tracks_player_on_either_side")
	Next
	position_xz = Vector2(-3.2, 20.8)
	alien.dialogue_section = "intro"
	alien.index = 0
	For i = 0 To 30
		alien.advance()
		If stratum.get("narcean_lexicon", False) And stratum.get("club_pad_activated", False) Then Exit For
	Next
	check(stratum.get("alien_english", False), "VG_Orac_teaches_English")
	check(stratum.get("alien_white_dwarf_seen", False), "VG_comedy_follows_English_transfer")
	check(stratum.get("narcean_lexicon", False) And stratum.get("club_pad_activated", False), "VG_dialogue_grants_lexicon_and_pad")
	opt_orac_voice = False
	alien.advance()
	check(Not alien.player.playing And message <> "", "VG_mute_retains_subtitles")
	position_xz = Vector2(0, 10)
	alien.tick(0.1)
	check(alien.subtitle_left = 0.0 And Not alien.player.playing, "VG_leaving_room_stops_speech")
	check(alien.last_error = "", "VG_encounter_has_no_missing_recordings")
	alien.free()
	Print "CLUB_ALIEN_VG_RESULT=" & Str(checks - failures) & "/" & Str(checks)
	done = True
End Sub

Sub _Process(ByVal delta As Single)
	If Not done Then Exit Sub
	finish_frames = finish_frames + 1
	If finish_frames >= 8 Then GetTree().quit(failures)
End Sub
