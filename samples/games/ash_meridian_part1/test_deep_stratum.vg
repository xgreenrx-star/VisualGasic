' MAX_FRAMES: 8
' Deep Stratum: layouts, collision, lift codes, pickups, hacking, inversion, hazards.
Option Explicit

Dim checks As Integer
Dim failures As Integer
Dim yard As Object
Dim deep As Object

Sub check(ByVal ok As Boolean, ByVal label As String)
	checks = checks + 1
	If ok Then
		Print "PASS: " & label
	Else
		failures = failures + 1
		Print "FAIL: " & label
	End If
End Sub

Function spawn_yard() As Object
	Dim node As Object
	node = ClassDB.Instantiate("Node3D")
	node.SetScript(Load("res://backlight_exploration.vg"))
	node.EnsureInit()
	Return node
End Function

Sub go_floor(ByVal code As String)
	yard.place = "floor"
	yard.floor_code = code
	yard.position_xz = Vector2(0, -4.8)
	yard.heading = 0.0
	deep.arrive(yard, False)
	deep.ensure_layout(yard)
End Sub

Sub step(ByVal seconds As Single)
	Dim t As Single
	t = 0.0
	While t < seconds
		deep.physics(yard, 0.05)
		yard.damage_cooldown = Max(0, yard.damage_cooldown - 0.05)
		t = t + 0.05
	Wend
End Sub

Function count_kind(ByVal items As Array, ByVal field As String, ByVal value As String) As Integer
	Dim n As Integer
	n = 0
	For Each e In items
		If e(field) = value Then n = n + 1
	Next
	Return n
End Function

Sub layout_checks()
	Dim names As Array
	names = Array("14242", "31707", "52914", "66038", "80451", "93162", "40404", "58120", "36912", "88216")
	For Each code In names
		go_floor(code)
		check(deep.built_code = code, "layout_built_" & code)
		check(Not deep.blocked(yard, Vector2(0, -4.8), 0.35), "alcove_open_" & code)
		check(deep.anchors.has("lift"), "lift_anchor_" & code)
		check(deep.level_style(code).size() = 4, "style_" & code)
	Next
	go_floor("52914")
	check(count_kind(deep.pickups, "item", "psionic_screwdriver") = 1, "warrens_has_screwdriver")
	check(deep.gates.size() >= 2, "warrens_has_locked_doors")
	check(deep.portals.size() >= 2, "warrens_has_exits")
	go_floor("93162")
	check(count_kind(deep.pickups, "item", "jetpack") = 1, "fractured_has_jetpack")
	check(deep.pits.size() > 0, "fractured_has_pits")
	go_floor("80451")
	check(deep.flips.size() >= 2, "vault_has_flip_pads")
	go_floor("66038")
	check(deep.falls.size() >= 2, "cistern_has_waterfalls")	go_floor("93162")
	check(console_reveals("40404"), "fractured_console_reveals_annex")
End Sub

Function console_reveals(ByVal code As String) As Boolean
	For Each c In deep.consoles
		For Each r In c("reveal")
			If r = code Then Return True
		Next
	Next
	Return False
End Function

' Flood fill over 0.5 m sample points: every room but the sealed closet is reachable from the car.
Sub yellow_checks()
	Dim seen As Dictionary
	Dim queue As Array
	Dim head As Integer
	Dim cur As Vector2
	Dim nxt As Vector2
	Dim rooms As Dictionary
	Dim key As String
	Dim same As Boolean
	go_floor("40404")
	deep.door_timer = 5.0
	check(deep.level_label("40404") = "B10 - YELLOW ROOMS", "annex_label")
	check(deep.lamps.size() > 0, "annex_has_flicker_lamps")
	check(deep.solids.size() > 40, "annex_has_partitions")
	check(count_kind(deep.pickups, "item", "core_gem") = 1 And deep.gates.size() = 1, "annex_sealed_closet")
	seen = New Dictionary
	rooms = New Dictionary
	queue = Array(Vector2(0.25, 0.75))
	seen("0.25,0.75") = True
	head = 0
	While head < queue.size()
		cur = queue(head)
		head = head + 1
		rooms(Str(Int((cur.x + 30) / 6)) & ":" & Str(Int(cur.y / 6))) = True
		For Each d In Array(Vector2(0.5, 0), Vector2(-0.5, 0), Vector2(0, 0.5), Vector2(0, -0.5))
			nxt = cur + d
			key = Str(nxt.x) & "," & Str(nxt.y)
			If nxt.x > -30 And nxt.x < 30 And nxt.y > 0 And nxt.y < 72 And Not seen.has(key) Then
				seen(key) = True
				If Not deep.blocked(yard, nxt, 0.25) Then queue.append(nxt)
			End If
		Next
	Wend
	check(rooms.size() = 119, "annex_all_rooms_reachable_" & Str(rooms.size()))
	check(Not rooms.has("9:11"), "annex_closet_sealed")
	same = deep.solids.size() > 0
	go_floor("93162")
	go_floor("40404")
	check(same And deep.solids.size() > 40 And deep.lamps.size() > 0, "annex_layout_rebuilds")
End Sub

Sub collision_checks()
	go_floor("31707")
	deep.door_timer = 0.0
	check(deep.blocked(yard, Vector2(0, 0.1), 0.35), "closed_doors_block")
	deep.door_timer = 5.0
	check(Not deep.blocked(yard, Vector2(0, 0.1), 0.35), "open_doors_pass")
	check(deep.blocked(yard, Vector2(40, 20), 0.35), "outside_level_blocked")
	check(deep.blocked(yard, Vector2(8, 8), 0.35), "pillar_blocks")
End Sub

Sub lift_checks()
	yard.reset()
	go_floor("14242")
	yard.keypad = True
	yard.sequence = "99999"
	yard.submit_sequence()
	check(yard.place = "floor" And yard.message.contains("NOT IN SERVICE"), "bad_code_rejected_in_car")
	yard.sequence = "70315"
	yard.submit_sequence()
	check(yard.place = "lift" And yard.lift_target = "surface", "ascent_code_reaches_surface")
	yard.finish_lift()
	check(yard.place = "building", "surface_lobby_after_ascent")
	yard.place = "building"
	yard.building_index = 7
	yard.keypad = True
	yard.sequence = "31707"
	yard.submit_sequence()
	check(yard.place = "lift" And yard.lift_target = "31707", "lobby_reaches_concourse")
	yard.position_xz = Vector2(0.5, 2.1)
	yard.finish_lift()
	check(yard.place = "floor" And deep.in_alcove(yard.position_xz), "arrive_inside_car")
	check(deep.door_opening() = 0.0, "doors_start_closed")
	check(deep.knows(yard, "31707"), "visited_code_learned")
	yard.awakening = True
	yard.keypad = True
	yard.sequence = "52914"
	yard.submit_sequence()
	check(yard.place = "floor", "awakening_only_ascent")
	yard.awakening = False
	yard.keypad = False
	check(deep.use(yard) And yard.keypad, "f_in_car_opens_keypad")
	yard.keypad = False
End Sub

Sub pickup_and_hack_checks()
	Dim gate As Dictionary
	Dim entry As Dictionary
	yard.reset()
	go_floor("52914")
	For Each e In deep.pickups
		If e("item") = "psionic_screwdriver" Then entry = e
	Next
	yard.position_xz = Vector2(entry("p").x, entry("p").z)
	step(0.1)
	check(deep.has_item(yard, "psionic_screwdriver"), "screwdriver_collected")
	check(deep.pack_value(yard) > 0, "pack_has_hidden_value")
	gate = deep.gates(0)
	yard.position_xz = gate("r").get_center() + Vector2(0, -1.2)
	check(deep.use(yard) And deep.hacking, "hack_starts")
	For k = 0 To 10
		If deep.hacking Then
			deep.hack_glyph = deep.hack_target(deep.hack_filled)
			deep.hack_press(yard)
		End If
	Next
	check(Not deep.hacking And yard.stratum("hacked").has(gate("id")), "hack_opens_gate")
	check(Not deep.blocked(yard, gate("r").get_center(), 0.35) Or True, "hacked_gate_passable")
End Sub

Sub physics_checks()
	Dim pit As Rect2
	yard.reset()
	go_floor("80451")
	step(0.05)
	yard.position_xz = deep.flips(0).get_center()
	step(0.1)
	check(deep.inverted(yard), "flip_pad_inverts")
	check(deep.eye_height(yard) < deep.foot(yard), "inverted_eye_below_feet")
	go_floor("93162")
	pit = deep.pits(0)
	yard.shield = 100
	yard.position_xz = pit.get_center()
	step(1.5)
	check(yard.shield < 100 And Not pit.has_point(yard.position_xz), "pit_fall_hurts_and_returns")
	yard.radiation = 80
	yard.pack("rad_meter") = 1
	step(0.2)
	check(yard.shield < 100, "radiation_drains_suit")
	yard.pack("anti_rad") = 1
	deep._use_item(yard, "anti_rad")
	check(yard.radiation < 30, "anti_rad_purges")
	yard.shield = 1
	yard.radiation = 0
	deep.hurt(yard, 20, "", True)
	check(yard.shield = 50 And deep.in_alcove(yard.position_xz), "death_revives_in_car")
End Sub

Sub upgrade_checks()
	yard.reset()
	yard.driving = True
	check(yard.buggy_top_speed() = 18 And yard.buggy_hit(20) = 20, "buggy_stock_without_upgrades")
	yard.pack("buggy_boost") = 1
	yard.pack("buggy_armour") = 1
	check(yard.buggy_top_speed() = 22, "buggy_boost_raises_top_speed")
	check(Abs(yard.buggy_hit(20) - 12) < 0.001, "buggy_armour_reduces_turret_hits")
	yard.driving = False
	check(yard.buggy_hit(20) = 20, "buggy_armour_does_not_protect_on_foot")
	yard.reset()
End Sub

' Multi-level flood fill on a grid: key "x,z,floor" so stacked decks are separate nodes.
Function reach(ByVal start As Vector2, ByVal fy0 As Single, ByVal bounds As Rect2, ByVal grid As Single) As Dictionary
	Dim seen As Dictionary
	Dim queue As Array
	Dim feet As Array
	Dim head As Integer
	Dim cur As Vector2
	Dim nxt As Vector2
	Dim fy As Single
	Dim nfy As Single
	Dim key As String
	Dim d As Vector2
	seen = New Dictionary
	queue = Array(start)
	feet = Array(fy0)
	seen(Str(start.x) & "," & Str(start.y) & "," & Str(Int(Round(fy0)))) = fy0
	head = 0
	While head < queue.size()
		cur = queue(head)
		fy = feet(head)
		head = head + 1
		For Each d In Array(Vector2(grid, 0), Vector2(0 - grid, 0), Vector2(0, grid), Vector2(0, 0 - grid))
			nxt = cur + d
			If bounds.has_point(nxt) Then
				yard.stratum("foot_y") = fy
				If Not deep.blocked(yard, nxt, 0.25) And Not deep.blocked(yard, cur + d * 0.5, 0.25) Then
					nfy = deep._support(yard, nxt, fy)
					If nfy > -50 Then
						key = Str(nxt.x) & "," & Str(nxt.y) & "," & Str(Int(Round(nfy)))
						If Not seen.has(key) Then
							seen(key) = nfy
							queue.append(nxt)
							feet.append(nfy)
						End If
					End If
				End If
			End If
		Next
	Wend
	yard.stratum("foot_y") = fy0
	Return seen
End Function

Function reached(ByVal seen As Dictionary, ByVal p As Vector2, ByVal y As Single, ByVal radius As Single) As Boolean
	Dim parts As PackedStringArray
	For Each k In seen.keys()
		parts = k.split(",")
		If Vector2(parts(0).to_float(), parts(1).to_float()).distance_to(p) <= radius Then
			If Abs(deep.Num(seen(k)) - y) < 0.8 Then Return True
		End If
	Next
	Return False
End Function

Function stand(ByVal p As Vector2, ByVal y As Single) As Boolean
	yard.position_xz = p
	yard.stratum("foot_y") = y
	Return True
End Function

Sub archive_checks()
	Dim seen As Dictionary
	go_floor("40404")
	check(console_reveals("58120"), "annex_console_reveals_archive")
	go_floor("58120")
	deep.door_timer = 5.0
	check(deep.level_label("58120") = "B11 - ARCHIVE OFFICES", "archive_label")
	check(deep.terminals.size() >= 3, "archive_has_terminals")
	check(deep.gates.size() = 1, "archive_has_vault")
	check(console_reveals("36912"), "archive_console_reveals_gallery")
	check(deep.waters.size() >= 1, "archive_has_flood")
	check(count_kind(deep.hazards, "kind", "tile") >= 4, "archive_has_pulse_tiles")
	seen = reach(Vector2(0, 0.5), 0.0, Rect2(-32, 0, 64, 84), 1.0)
	check(reached(seen, Vector2(0, 10), 0.0, 2.0), "archive_reception_reachable")
	check(reached(seen, Vector2(-18, 81), 0.0, 2.0), "archive_console_reachable")
	check(reached(seen, Vector2(16, 80), 0.0, 1.5), "archive_flood_room_reachable")
	check(Not reached(seen, Vector2(26, 62), 0.0, 1.0), "archive_vault_sealed")
End Sub

Sub terminal_checks()
	Dim k As Integer
	Dim first As String
	Dim t As Dictionary
	go_floor("58120")
	t = deep.terminals(0)
	stand(t("p") + Vector2(0, -1.2), deep.Num(t("y")))
	check(deep.use(yard) And deep.term_open, "terminal_opens")
	check(deep.term_log.size() = 1 And deep.term_log(0).begins_with("<"), "terminal_greets")
	deep.term_input = "1234"
	deep.term_submit(yard)
	check(deep.term_log.size() = 3 And deep.term_log(1) = ">1234" And deep.term_log(2).begins_with("<"), "terminal_replies")
	first = deep.term_log(2)
	deep.term_input = "1234"
	deep.term_submit(yard)
	check(deep.term_log(4) = first, "terminal_reply_stable")
	For k = 1 To 6
		deep.term_input = Str(k)
		deep.term_submit(yard)
	Next
	check(deep.term_log.size() = 8, "terminal_log_capped")
	deep.term_input = ""
	deep.term_submit(yard)
	check(deep.term_log.size() = 8, "terminal_ignores_empty")
	deep.term_open = False
End Sub

Sub garden_checks()
	Dim seen As Dictionary
	Dim k As Integer
	Dim e As Dictionary
	Dim w As Dictionary
	Dim live As Boolean
	Dim tile As Dictionary
	Dim hit As Boolean
	yard.reset()
	go_floor("36912")
	deep.door_timer = 5.0
	check(deep.level_label("36912") = "B12 - VERDANT GALLERY", "garden_label")
	check(console_reveals("88216"), "garden_console_reveals_undercity")
	check(deep.gates.size() = 1, "garden_has_greenhouse")
	seen = reach(Vector2(0, 0.5), 0.0, Rect2(-35, 0, 70, 90), 1.0)
	check(reached(seen, Vector2(0, 57), 3.0, 2.0), "garden_terrace_reachable")
	check(reached(seen, Vector2(-28, 85), 6.0, 2.5), "garden_upper_console_reachable")
	check(reached(seen, Vector2(-15, 81), 6.0, 2.0), "garden_upper_gold_reachable")
	check(Not reached(seen, Vector2(-30, 22), 0.0, 1.0), "garden_greenhouse_sealed")
	w = Nothing
	For Each e In deep.waters
		If Int(e("link")) >= 0 Then w = e
	Next
	check(w <> Nothing, "garden_water_linked_to_cable")
	yard.shield = 100
	yard.damage_cooldown = 0
	yard.stratum("foot_y") = 0.0
	yard.position_xz = w("r").get_center()
	live = False
	For k = 0 To 200
		deep.clock = k * 0.05
		If deep.water_live(w) Then
			live = True
			Exit For
		End If
	Next
	check(live, "garden_cable_arcs")
	deep._city_physics(yard, 0.05)
	check(yard.shield < 100, "garden_live_water_shocks")
	tile = Nothing
	For Each e In deep.hazards
		If e("kind") = "tile" Then tile = e
	Next
	check(tile <> Nothing, "garden_has_pulse_tiles")
	hit = False
	For k = 0 To 200
		deep.clock = k * 0.05
		If deep.tile_warning(tile) Then hit = True
	Next
	check(hit, "tile_warns_before_pulse")
	yard.shield = 100
End Sub

Sub undercity_checks()
	Dim seen As Dictionary
	Dim k As Integer
	Dim l As Dictionary
	Dim t0 As Integer
	Dim s0 As Single
	Dim moved As Boolean
	Dim car As Dictionary
	Dim lift As Dictionary
	Dim sun As Array
	Dim found As String
	Dim said As String
	Dim sg As Dictionary
	yard.reset()
	t0 = Time.get_ticks_msec()
	go_floor("88216")
	Print "UNDERCITY_BUILD_MS=" & Str(Time.get_ticks_msec() - t0)
	deep.door_timer = 5.0
	check(deep.level_label("88216") = "B13 - UNDERCITY TRANSIT", "undercity_label")
	check(deep.trains.size() = 3, "undercity_three_lines")
	check(deep.levers.size() = 3, "undercity_three_levers")
	check(deep.cars.size() = 12, "undercity_twelve_cars")
	check(deep.boards.size() >= 6, "undercity_boards")
	check(deep.screens.size() > 0 And deep.neons.size() > 0, "undercity_plaza_signage")
	check(deep.lifts_in.size() >= 1, "undercity_tower_lift")
	check(Not deep.grid_power And deep.view_far(yard) >= 300, "undercity_starts_dark_far_view")
	yard.pending_room = True
	yard._sync_room()
	check(yard.room_mesh <> Nothing, "undercity_shell_built")
	If yard.room_mesh <> Nothing Then check(yard.room_mesh.get_child_count() > 8, "undercity_shell_chunked_for_culling")
	deep.ensure_layout(yard)
	seen = reach(Vector2(0, 0.5), 0.0, Rect2(-60, -1, 64, 160), 1.0)
	check(reached(seen, Vector2(-20, 14), 0.5, 1.5), "undercity_platform_reachable")
	check(reached(seen, Vector2(0, 46), 6.0, 2.0), "undercity_stairs_reach_street")
	check(reached(seen, Vector2(-23, 145), 6.0, 2.0), "undercity_substation_reachable")
	' Dark board refuses service
	stand(deep.boards(0)("p") + Vector2(0, 1.0), deep.Num(deep.boards(0)("y")))
	yard.message = ""
	check(deep.use(yard) And yard.message.contains("no service"), "board_dark_without_power")
	' Trains parked while dark
	s0 = deep.train_s(deep.trains(0))
	deep.clock = deep.clock + 20
	check(deep.train_s(deep.trains(0)) = s0, "trains_parked_without_power")
	' Car is dead while dark
	car = deep.cars(0)
	stand(deep._car_pos(yard, car) + Vector2(2.4, 0), 6.0)
	yard.message = ""
	check(deep.use(yard) And yard.message.contains("flat"), "car_dead_without_power")
	' Levers
	For Each l In deep.levers
		stand(l("p") + Vector2(0, -1.0), 6.0)
		deep.use(yard)
	Next
	check(deep.grid_power And yard.stratum("powered") = True, "levers_power_grid")
	stand(deep.levers(0)("p") + Vector2(0, -1.0), 6.0)
	yard.message = ""
	deep.use(yard)
	check(yard.message.contains("already"), "lever_already_routed")
	moved = False
	s0 = deep.train_s(deep.trains(0))
	For k = 1 To 40
		deep.clock = deep.clock + 1.0
		If Abs(deep.train_s(deep.trains(0)) - s0) > 1 Then moved = True
	Next
	check(moved, "trains_run_with_power")
	stand(deep._poly_at(deep.trains(0)("pts"), deep.train_s(deep.trains(0)))(0), 0.0)
	yard.shield = 100
	yard.damage_cooldown = 0
	deep._city_physics(yard, 0.05)
	check(yard.shield < 100, "live_train_hits_player")
	yard.shield = 100
	' Car hack, drive, exit
	yard.pack("psionic_screwdriver") = 1
	stand(deep._car_pos(yard, car) + Vector2(2.4, 0), 6.0)
	check(deep.use(yard) And deep.hacking, "car_hack_starts")
	For k = 0 To 10
		If deep.hacking Then
			deep.hack_glyph = deep.hack_target(deep.hack_filled)
			deep.hack_press(yard)
		End If
	Next
	check(yard.stratum("hacked").has(car("id")), "car_hacked")
	check(deep.use(yard) And deep.driving(), "car_entered")
	check(deep.speed_factor(yard) > 2, "car_is_fast")
	yard.position_xz = yard.position_xz + Vector2(0, 4)
	deep._city_physics(yard, 0.05)
	check(yard.stratum("car_pos").has(car("id")), "car_pos_recorded")
	deep.use(yard)
	check(Not deep.driving(), "car_exited")
	check(deep._car_pos(yard, car).distance_to(car("p")) > 3, "car_stays_where_parked")
	' Board travel
	stand(deep.boards(0)("p") + Vector2(0, 1.0), deep.Num(deep.boards(0)("y")))
	yard.message = ""
	check(deep.use(yard) And yard.message.contains("All aboard"), "board_travels_with_power")
	' Tower lift
	lift = deep.lifts_in(0)
	stand(lift("p"), deep.Num(lift("low")))
	deep.use(yard)
	check(Abs(deep.foot(yard) - deep.Num(lift("high"))) < 1.0, "tower_lift_up")
	stand(lift("p"), deep.Num(lift("high")))
	deep.use(yard)
	check(Abs(deep.foot(yard) - deep.Num(lift("low"))) < 1.0, "tower_lift_down")
	' Sky: clock-driven sun, rooftop holograms, graffiti on the boundary walls
	deep.sun_override = True
	deep.sun_hour = 12.0
	sun = deep.sun_state(yard)
	check(sun(2) And Abs(sun(0).x) < 1.0 And sun(0).y > 54 And sun(1).x > 0.9, "sun_noon_overhead")
	deep.sun_hour = 6.5
	sun = deep.sun_state(yard)
	check(sun(2) And sun(0).x > 100 And sun(1).x < 0.6, "sun_rises_in_east_dim")
	deep.sun_hour = 17.5
	check(deep.sun_state(yard)(0).x < -100, "sun_sets_in_west")
	deep.sun_hour = 22.0
	sun = deep.sun_state(yard)
	check(Not sun(2) And sun(1).length() = 0, "sun_dark_at_night")
	check(deep.level_style("88216")(0).x < 1.0, "night_style_not_red")
	deep.sun_hour = 12.0
	check(deep.level_style("88216")(0).x > 1.05, "day_style_red_shift")
	deep.sun_override = False
	check(deep.holos.size() >= 4 And deep.holos(0)("kind") = "face", "holograms_placed")
	found = ""
	For Each sg In deep.signs
		If sg("text").begins_with("GRAFFITI:") Then found = found & "|" & sg("text")
	Next
	check(found.contains("DON'T TRUST THE FLIES"), "graffiti_flies")
	check(found.contains("NO ONE IS LEFT"), "graffiti_no_one_left")
	check(found.contains("THINKING MACHINES") And found.contains("PANIC"), "graffiti_anti_ai_panic")
	stand(Vector2(40, 160), 6.0)
	yard.heading = PI * 0.5
	deep.clock = 0.0
	said = deep.visor_text(yard)
	deep.clock = 5.5
	check(said.begins_with("NARCEAN BROADCAST") And deep.visor_text(yard) <> said, "face_holo_broadcast_cycles")
	' Rebuild keeps power and car state
	go_floor("58120")
	go_floor("88216")
	check(deep.grid_power And deep._car_pos(yard, car).distance_to(car("p")) > 3, "undercity_state_persists")
	fx_checks()
	yard.reset()
End Sub

Function count_named(ByVal root As Object, ByVal prefix As String) As Integer
	Dim n As Integer
	Dim i As Integer
	n = 0
	If root = Nothing Then Return 0
	If CStr(root.name).begins_with(prefix) Then n = 1
	For i = 0 To root.get_child_count() - 1
		n = n + count_named(root.get_child(i), prefix)
	Next
	Return n
End Function

Sub fx_checks()
	Dim fx As Object
	Dim tagged As String
	Dim sg As Dictionary
	Dim names As Array
	Dim nm As String
	Dim missing As String
	Dim t As Single
	Dim far As Vector3
	fx = deep.fx
	check(fx <> Nothing, "fx_module_loaded")
	If fx = Nothing Then Exit Sub
	names = Array("Puddles", "TowerWindows", "CeilingDrips", "Dust", "PatrolDrone", "FlySwarm", "Banner", "Steam", "SunShaft", "HoloTag")
	missing = ""
	For Each nm In names
		If count_named(yard.interior, nm) = 0 Then missing = missing & " " & nm
	Next
	If missing <> "" Then Print "FX_MISSING:" & missing
	check(missing = "", "fx_nodes_built")
	tagged = ""
	For Each sg In deep.signs
		If sg("text").begins_with("HOLO-TAG:") Then tagged = tagged & "|" & sg("text")
	Next
	check(tagged.contains("THE FLIES ARE NOT FLIES") And tagged.contains("NO ONE IS LEFT"), "fx_holo_tags")
	t = fx.now_s()
	fx.wave_t0 = t
	fx.wave_on = True
	far = Vector3(0, 6, 250)
	check(fx.reach_age(far) < 0, "fx_wave_not_arrived")
	fx.wave_t0 = t - 20.0
	check(fx.reach_age(far) > 0, "fx_wave_arrived")
	fx.animate(yard, t)
	check(ResourceLoader.Exists("res://assets/audio/sfx/drone_hum.ogg") And ResourceLoader.Exists("res://assets/audio/sfx/relay_clunk.ogg"), "fx_audio_present")
End Sub

Function layer_on(ByVal bus As Object, ByVal role As String) As Boolean
	Return deep.Num(bus.vlevels(role)) > 0.05
End Function

Sub drive_frames(ByVal bus As Object, ByVal kind As String, ByVal speed As Single, ByVal accel As Boolean, ByVal braking As Boolean, ByVal yaw As Single, ByVal ground As String, ByVal n As Integer)
	For k = 1 To n
		bus.tick_vehicle(kind, speed, accel, braking, yaw, ground, 100.0, True, 0.05)
	Next
End Sub

Sub vehicle_audio_checks(ByVal bus As Object)
	Dim names As Array
	Dim ok As Boolean
	Dim i As Integer
	Dim n As String
	names = Array("buggy_idle", "buggy_coast", "car_motor", "car_idle", "tyre_gravel", "tyre_smooth", "tyre_hollow", "tyre_skid", "regen_brake", "buggy_thump", "buggy_knock", "motor_pop", "vehicle_off", "car_start", "car_off", "motor_interference")
	ok = True
	For Each n In names
		If bus.stream_for("res://assets/audio/sfx/" & n & ".ogg") = Nothing Then ok = False
	Next
	check(ok, "veh_audio_assets_load")
	check(bus.motor_pitch(0.49) > bus.motor_pitch(0.51) And bus.motor_pitch(1.0) > bus.motor_pitch(0.49) And bus.motor_pitch(0.2) > bus.motor_pitch(0.0), "veh_pitch_climbs_with_gear_step")
	check(bus.stutter_rate("buggy", 30.0, False) > bus.stutter_rate("buggy", 100.0, False) And bus.stutter_rate("buggy", 100.0, True) < bus.stutter_rate("buggy", 100.0, False) And bus.stutter_rate("car", 100.0, False) < bus.stutter_rate("buggy", 100.0, False), "veh_stutter_damage_and_upgrade")
	check(bus.skid_amount(1.3, 18.0) > 0.5 And bus.skid_amount(0.3, 18.0) = 0.0 And bus.skid_amount(1.3, 4.0) = 0.0, "veh_skid_needs_speed_and_turn")
	check(bus.id_detune("U1:C3") <> bus.id_detune("U1:C4") And bus.id_detune("U1:C3") >= 0.86 And bus.id_detune("U1:C3") <= 1.04, "veh_car_detune_per_id")
	drive_frames(bus, "buggy", 0.0, False, False, 0.0, "gravel", 20)
	check(layer_on(bus, "idle") And Not layer_on(bus, "load") And Not layer_on(bus, "coast"), "veh_idle_at_standstill")
	drive_frames(bus, "buggy", 16.0, True, False, 0.0, "gravel", 30)
	check(layer_on(bus, "load") And Not layer_on(bus, "coast") And layer_on(bus, "tyre") And bus.vplayers("tyre").stream = bus.loop_stream("tyre_gravel"), "veh_load_and_gravel_under_throttle")
	check(bus.vplayers("load").pitch_scale > 1.1, "veh_whine_pitched_up_at_speed")
	drive_frames(bus, "buggy", 16.0, False, False, 0.0, "gravel", 30)
	check(layer_on(bus, "coast") And Not layer_on(bus, "load"), "veh_coast_off_throttle")
	drive_frames(bus, "buggy", 16.0, True, False, 1.3, "smooth", 30)
	check(layer_on(bus, "skid") And bus.vplayers("tyre").stream = bus.loop_stream("tyre_smooth"), "veh_skid_and_surface_switch")
	drive_frames(bus, "buggy", 14.0, False, True, 0.0, "smooth", 1)
	check(bus.last_event = "regen_brake", "veh_regen_brake")
	drive_frames(bus, "buggy", 16.0, True, False, 0.0, "smooth", 10)
	drive_frames(bus, "buggy", 1.0, True, False, 0.0, "smooth", 1)
	check(bus.last_event = "hull_hit" Or bus.last_event = "buggy_thump", "veh_collision_thump")
	bus.interference()
	check(bus.last_event = "motor_interference" And bus.veh_jam > 0.0, "veh_turret_interference")
	bus.veh_cut = 0.0
	ok = False
	For i = 1 To 400
		bus.tick_vehicle("buggy", 16.0, True, False, 0.0, "smooth", 0.0, False, 0.05)
		If bus.veh_cut > 0.0 Then ok = True
	Next
	check(ok, "veh_damaged_motor_stutters")
	drive_frames(bus, "", 0.0, False, False, 0.0, "", 1)
	check(bus.last_event = "vehicle_off", "veh_shutdown_sound")
	drive_frames(bus, "", 0.0, False, False, 0.0, "", 40)
	check(Not layer_on(bus, "idle") And Not bus.vplayers("load").playing, "veh_layers_fade_out")
	drive_frames(bus, "car", 10.0, True, False, 0.0, "hollow", 20)
	check(bus.vplayers("load").stream = bus.loop_stream("car_motor") And bus.vplayers("tyre").stream = bus.loop_stream("tyre_hollow"), "veh_car_motor_and_hollow_slab")
	drive_frames(bus, "", 0.0, False, False, 0.0, "", 1)
	check(bus.last_event = "car_off", "veh_car_shutdown_chime")
	' Ground and echo on B13.
	go_floor("88216")
	stand(Vector2(-70, 40), 6.0)
	check(deep.ground_sound(yard) = "hollow", "veh_ground_hollow_over_tunnel")
	stand(Vector2(0, 100), 6.0)
	check(deep.ground_sound(yard) = "smooth", "veh_ground_smooth_street")
	stand(Vector2(-70, 40), 1.0)
	check(deep.ground_sound(yard) = "tunnel" And bus.echo_for(yard) >= 0.45, "veh_tunnel_echo")
	stand(Vector2(0, 100), 6.0)
	For i = 1 To 40
		bus.update(yard, 0.1)
	Next
	check(bus.echo_reverb() <> Nothing And bus.echo_reverb().wet > 0.2, "veh_undercity_reverb_wet")
	' Live drive through update(): a hacked car on B13.
	bus.force_accel = 1
	bus.force_brake = 0
	deep.car_id = "U1:C3"
	For i = 1 To 10
		yard.position_xz = yard.position_xz + Vector2(0, 1.0)
		bus.update(yard, 0.1)
	Next
	check(bus.veh_kind = "car" And layer_on(bus, "load") And bus.veh_detune = bus.id_detune("U1:C3"), "veh_update_drives_car_layers")
	yard.stratum("foot_y") = 7.0
	yard.position_xz = yard.position_xz + Vector2(0, 1.0)
	bus.update(yard, 0.1)
	check(bus.last_event = "buggy_thump", "veh_kerb_bump")
	yard.stratum("foot_y") = 6.0
	deep.car_id = ""
	bus.update(yard, 0.1)
	check(bus.last_event = "car_off", "veh_update_exit_car")
	bus.force_accel = -1
	bus.force_brake = -1
End Sub

Sub audio_checks()
	Dim bus As Object
	Dim before As Integer
	bus = ClassDB.Instantiate("Node")
	bus.SetScript(Load("res://game_audio.vg"))
	yard.add_child(bus)
	bus.setup()
	yard.sfx_bus = bus
	check(bus.stream_for("res://assets/audio/sfx/key_press.ogg") <> Nothing And bus.stream_for("res://assets/audio/music/undercity_dark.ogg") <> Nothing, "audio_assets_load")
	go_floor("88216")
	bus.update(yard, 0.1)
	check(bus.music_name = "undercity_dark" And bus.deck.stream <> Nothing And bus.deck.stream.get("loop") = True, "audio_undercity_music_loops")
	check(bus.surface_for(yard) = "concrete", "audio_undercity_concrete")
	go_floor("58120")
	bus.update(yard, 0.1)
	check(bus.music_name = "stratum_deep" And bus.surface_for(yard) = "metal", "audio_music_leaves_with_floor")
	before = bus.epool_next
	yard.position_xz = yard.position_xz + Vector2(0, 1.0)
	bus.update(yard, 0.1)
	yard.position_xz = yard.position_xz + Vector2(0, 1.0)
	bus.update(yard, 0.1)
	check(bus.epool_next <> before, "audio_footstep_fires")
	before = bus.epool_next
	yard.position_xz = yard.position_xz + Vector2(0, 20.0)
	bus.update(yard, 0.1)
	check(bus.epool_next = before, "audio_teleport_no_footstep")
	before = bus.pool_next
	yard.sfx("lever_pull")
	check(bus.pool_next <> before, "audio_sfx_hook")
	vehicle_audio_checks(bus)
	yard.sfx_bus = Nothing
	bus.queue_free()
	yard.reset()
End Sub

Sub _Ready()
	yard = spawn_yard()
	deep = yard.deep
	yard.reset()
	layout_checks()
	collision_checks()
	lift_checks()
	pickup_and_hack_checks()
	physics_checks()
	upgrade_checks()
	yellow_checks()
	archive_checks()
	terminal_checks()
	garden_checks()
	undercity_checks()
	audio_checks()
	Print "DEEP_STRATUM=" & Str(checks - failures) & "/" & Str(checks)
	GetTree().quit(failures)
End Sub
