Option Explicit

Dim game As Object
Dim view As Object
Dim campaign As Object
Dim yard As Object
Dim frame As Integer
Dim checks As Integer
Dim failures As Integer
Dim initial As Dictionary
Dim saved As Dictionary
Dim prior_save As String
Dim legacy_save As String
Dim legacy_existed As Boolean
Dim pause_seconds As Single
Dim resume_state As Dictionary
Dim restored_game As Object

Sub check(ByVal condition As Boolean, ByVal label As String)
	checks = checks + 1
	If condition Then
		Print "PASS: " & label
	Else
		failures = failures + 1
		Print "FAIL: " & label
	End If
End Sub

Sub key(ByVal code As Integer, ByVal down As Boolean)
	Dim event As Object
	event = ClassDB.Instantiate("InputEventKey")
	event.keycode = code
	event.pressed = down
	Input.parse_input_event(event)
	Input.flush_buffered_events()
End Sub

Function state_matches(ByVal actual As Dictionary, ByVal expected As Dictionary) As Boolean
	Dim field_name As Variant
	If actual.size() <> expected.size() Then Return False
	For Each field_name In expected.keys()
		If Not actual.has(field_name) Then Return False
		If TypeName(expected(field_name)) = "Double" Or TypeName(expected(field_name)) = "Integer" Then
			If Abs(actual(field_name) - expected(field_name)) > 0.000000001 Then Return False
		ElseIf actual(field_name) <> expected(field_name) Then
			Return False
		End If
	Next
	Return True
End Function

Dim audio_music As Single

Sub _Ready()
	game = Load("res://main.tscn").instantiate()
	add_child(game)
	game.set_process(False)
	game.opt_fps = False
	game.opt_full = False
	game.opt_detail = 1
	view = game.GetNode("Presentation")
	campaign = game.campaign
	aa_checks()
	check(game.opt_music >= 0.0 And game.opt_music <= 1.0 And game.opt_sfx >= 0.0 And game.opt_sfx <= 1.0, "options_audio_levels_loaded")
	check(AudioServer.get_bus_index("Music") >= 0 And AudioServer.get_bus_index("SFX") >= 0, "options_audio_buses_created")
	audio_music = game.opt_music
	game.opt_music = 0.5
	game.ApplyAudio()
	check(Abs(AudioServer.get_bus_volume_db(AudioServer.get_bus_index("Music")) + 6.02) < 0.1, "options_music_slider_sets_bus_db")
	game.opt_music = audio_music
	game.ApplyAudio()
	check(campaign.save_path = "user://ash_meridian_campaign.cfg", "campaign_default_save_path_initialized")
	campaign.save_path = "user://ash_campaign_test_" & Str(OS.get_process_id()) & ".cfg"
	legacy_existed = FileExists("user://ash_meridian_save.txt")
	If legacy_existed Then legacy_save = ReadAllText("user://ash_meridian_save.txt")
	game.phase = 12
	game.title_i = 0
	game.opt_reduced = False
	directory = ClassDB.class_call_static("DirAccess", "open", "user://")
	If directory <> Nothing Then directory.remove("ash_meridian_opening.txt")
End Sub

Sub aa_checks()
	Dim previous As Integer
	Dim mode As Integer
	Dim names As Array
	Dim samples As Array
	Dim source As Object
	Dim result As Object
	previous = game.opt_aa
	names = Array("OFF", "MSAA 2X", "MSAA 4X", "MSAA 8X", "FXAA", "MSAA 4X + FXAA")
	samples = Array(0, 1, 2, 3, 0, 2)
	For mode = 0 To 5
		game.opt_aa = mode
		game.ApplyAntialiasing()
		check(game.AntialiasingName() = names(mode), "options_aa_label_" & Str(mode))
		check(view.viewport.msaa_3d = samples(mode) And view.fxaa_enabled = (mode >= 4), "options_aa_applied_" & Str(mode))
	Next
	source = view.viewport.get_texture()
	result = view.filter_world(source)
	check(result <> source And view.fxaa_canvas.texture = source, "options_fxaa_filters_world_texture")
	check(view.fxaa_view.disable_3d And view.fxaa_canvas.material.shader.resource_path = "res://shaders/world_fxaa.gdshader", "options_fxaa_uses_canvas_pass")
	game.opt_aa = 0
	game.ApplyAntialiasing()
	check(view.filter_world(source) = source And view.fxaa_view.render_target_update_mode = SubViewport.UPDATE_DISABLED, "options_fxaa_off_bypasses_pass")
	check(game.OptionY(11) + 26.0 < 520.0 And game.OptionY(1) - game.OptionY(0) > 32.0, "options_aa_row_and_back_fit")
	game.opt_aa = previous
	game.ApplyAntialiasing()
End Sub

Sub mission_checks()
	Dim i As Integer
	Dim lines As Array
	Dim text As String
	Dim entry_text As Variant
	Dim font As Object
	font = ThemeDB.fallback_font
	check(Not yard.mission_briefing_visible(), "campaign_briefing_hidden_at_touchdown")
	check(view.KEYS.has(KEY_F1), "campaign_f1_registered_for_input")
	key(KEY_F1, True)
	view.sample_input()
	yard.tick(0.0, view)
	key(KEY_F1, False)
	view.sample_input()
	check(yard.mission_briefing_visible(), "campaign_briefing_toggle_opens")
	lines = yard.mission_briefing()
	check(lines.size() = 4 And lines(0).contains("Jason") And lines(0).contains("card game") And lines(1).contains("assistant"), "campaign_briefing_identifies_player_and_card_game")
	check(lines(2).contains("cannot leave loaded") And lines(2).contains("below the yard") And lines(3).contains("broken amber drain marker"), "campaign_briefing_explains_mission_and_stash")
	For Each entry_text In lines
		check(font.get_string_size(entry_text, 0, -1, 12).x <= 709, "campaign_briefing_line_fits_card")
	Next
	text = campaign.objective()
	check(text.contains("Mark's computer") And text.contains("amber drain marker"), "campaign_initial_job_directs_to_stash")
	yard.message_left = 0
	check(yard.mission_briefing_visible() And campaign.objective() = text, "campaign_guidance_outlasts_notifications")
	yard.driving = True
	check(yard.mission_briefing_visible() And campaign.objective() = text, "campaign_guidance_available_in_buggy")
	yard.driving = False
	yard.pack("commander_plus4") = 1
	yard.place = "building"
	yard.building_index = 0
	yard.position_xz = Vector2(0, 14)
	yard.use_object()
	check(Not yard.deep.interface_lexicon_ready(yard) And yard.message.contains("cannot read"), "campaign_first_archive_copies_glyph_without_translation")
	check(yard.discovered(0) = yard.FEB_CODE.substr(0, 1), "campaign_translator_pickup_also_records_archive")
	yard.use_object()
	check(Not yard.pack.has("interface_translator"), "campaign_no_physical_translator_in_archive")
	yard.place = "surface"
	check(yard.mission_briefing_visible() And campaign.objective().contains("1/5"), "campaign_briefing_remains_available_after_first_archive")
	yard.toggle_briefing()
	check(Not yard.mission_briefing_visible(), "campaign_briefing_toggle_closes")
	yard.toggle_briefing()
	check(yard.mission_briefing_visible(), "campaign_briefing_can_be_reopened")
	For i = 1 To 4
		yard.discovered(i) = yard.FEB_CODE.substr(i, 1)
	Next
	check(campaign.objective().contains("rear lift panel") And campaign.objective().contains("left to right"), "campaign_full_journal_directs_to_transit")
	yard.place = "lift"
	check(campaign.objective().contains("underground records"), "campaign_lift_job_keeps_search_direction")
	yard.place = "floor"
	yard.floor_code = "31707"
	check(campaign.objective().contains("Copy address glyphs"), "campaign_intermediate_floor_job_explains_untranslated_progression")
	yard.floor_code = "88216"
	check(campaign.objective().contains("three bus levers"), "campaign_dark_city_job_explains_transfer_station")
	yard.stratum("levers")("88216:L0") = True
	check(campaign.objective().contains("three bus levers"), "campaign_partial_bus_job_stays_until_powered")
	yard.stratum("powered") = True
	check(campaign.objective().begins_with("Grid restored."), "campaign_powered_city_job_advances")
	check(campaign.objective().contains("eye marks"), "campaign_powered_city_job_directs_to_resident_intelligence")
	yard.stratum("narcean_lexicon") = True
	check(campaign.objective().contains("power coupler"), "campaign_translated_city_job_resumes_salvage")
	yard.floor_code = yard.FEB_CODE
	check(campaign.objective().contains("amber service socket"), "campaign_coupler_floor_job_names_interaction")
	yard.awakening = True
	check(campaign.objective().begins_with("Return to the Ash."), "campaign_awakened_job_directs_escape")
	yard.failed = True
	check(campaign.objective().contains("retry"), "campaign_failed_job_names_checkpoint")
	yard.failed = False
	yard.completed = True
	check(campaign.objective().contains("expedition complete"), "campaign_completed_job_retires_search")
	campaign.new_run(yard)
	lines = yard.hud.wrap_lines("CURRENT JOB: " & campaign.objective(), 112)
	check(lines.size() <= 2, "campaign_job_fits_two_line_header")
	For Each entry_text In lines
		check(font.get_string_size(entry_text, 0, -1, 12).x <= 916, "campaign_job_line_fits_header")
	Next
	yard.trace_escape = True
	check(Not yard.mission_briefing_visible(), "campaign_briefing_hidden_in_trace_escape")
	yard.trace_escape = False
End Sub

Sub persistence_checks()
	Dim invalid As Dictionary
	Dim config As Object
	Dim before As Dictionary
	Dim error_path As String
	Dim config_error As Integer
	Dim table As Dictionary
	check(game.campaign_active And game.phase = 18, "campaign_play_enters_backlight_yard")
	check(campaign.orac_online And campaign.visit_number = 1 And yard.campaign_mode, "campaign_jason_orac_first_visit")
	check(campaign.stage() = "first_salvage" And yard.message.contains("Jason") And yard.message.contains("ORAC"), "campaign_new_story_and_objective")
	check(Not yard.message.contains("ZEN") And Not yard.message.contains("OFFLINE"), "campaign_no_ai_failure_on_arrival")
	mission_checks()
	translator_checks()
	yard.pack("commander_plus4") = 1
	initial = campaign.snapshot(yard)
	check(initial.size() = 32, "campaign_snapshot_has_all_fields")
	yard.position_xz = Vector2(0, 396)
	yard.use_object()
	check(yard.place = "surface" And yard.message.contains("jammed"), "campaign_dead_north_lift_is_inspectable")
	check(campaign.snapshot(yard).size() = 32, "campaign_dead_lift_does_not_add_save_fields")
	yard.position_xz = Vector2(0, -4)
	yard.use_object()
	check(Not yard.completed And yard.message.contains("power coupler"), "campaign_launch_requirement_explained")
	game.SaveRun()
	check(game.save_msg = "CAMPAIGN SAVED" And FileExists(campaign.save_path), "campaign_atomic_save_succeeds")
	check(Not FileExists(campaign.save_path & ".tmp"), "campaign_temporary_save_committed")
	check(campaign.load_game(yard) And Not yard.mission_briefing_visible(), "campaign_load_before_first_archive_keeps_briefing_closed")
	yard.position_xz = Vector2(-41, 36)
	yard.use_object()
	yard.position_xz = Vector2(0, 14)
	yard.use_object()
	yard.position_xz = Vector2(0, 10)
	saved = campaign.snapshot(yard)
	check(campaign.save_game(), "campaign_interior_journal_save")
	yard.inventory("regulator") = True
	yard.position_xz = Vector2(0, 3)
	check(campaign.load_game(yard), "campaign_interior_load_succeeds")
	check(campaign.snapshot(yard) = saved, "campaign_all_persistent_fields_round_trip")
	check(Not yard.deep.interface_lexicon_ready(yard) And Not yard.deep.has_item(yard, "psionic_screwdriver"), "campaign_copied_glyph_save_does_not_invent_translation")
	check(Not yard.mission_briefing_visible() And campaign.objective().contains("1/5"), "campaign_loaded_archive_keeps_briefing_retired")
	check(yard.pending_room And campaign.orac_online And Not yard.inventory.has("regulator"), "campaign_restore_rebuilds_transients_without_inventing_items")
	prior_save = ReadAllText(campaign.save_path)
	before = campaign.snapshot(yard)
	config = ClassDB.Instantiate("ConfigFile")
	config_error = config.load(campaign.save_path)
	check(config_error = 0, "campaign_fixture_reads_saved_document")
	config.set_value("campaign", "version", 999)
	config.save(campaign.save_path)
	check(Not campaign.load_game(yard) And campaign.last_error.contains("version"), "campaign_rejects_future_version_explicitly")
	check(campaign.snapshot(yard) = before, "campaign_invalid_version_does_not_mutate_session")
	WriteAllText campaign.save_path, prior_save
	invalid = saved.duplicate(True)
	invalid("position_xz") = "not a position"
	check(Not campaign.validate(invalid, yard), "campaign_rejects_wrong_field_type")
	invalid = saved.duplicate(True)
	invalid("position_xz") = Vector2(900, 900)
	check(Not campaign.validate(invalid, yard), "campaign_rejects_out_of_bounds_player")
	invalid = saved.duplicate(True)
	table = invalid("inventory")
	table("coupler") = True
	check(Not campaign.validate(invalid, yard), "campaign_rejects_coupler_without_awakening")
	invalid = saved.duplicate(True)
	invalid("floor_code") = "14abc"
	check(Not campaign.validate(invalid, yard), "campaign_rejects_invalid_floor_address")
	invalid = saved.duplicate(True)
	table = invalid("discovered")
	table(0) = "9"
	check(Not campaign.validate(invalid, yard), "campaign_rejects_invalid_archive_symbol")
	invalid = saved.duplicate(True)
	invalid.erase("shield")
	check(Not campaign.validate(invalid, yard), "campaign_rejects_missing_field")
	invalid = saved.duplicate(True)
	invalid("inventory") = Array()
	check(Not campaign.validate(invalid, yard), "campaign_rejects_non_dictionary_inventory")
	invalid = saved.duplicate(True)
	invalid("collected") = 1
	check(Not campaign.validate(invalid, yard), "campaign_rejects_cell_count_without_inventory")
	yard.place = "floor"
	yard.building_index = 7
	yard.floor_code = "52914"
	yard.position_xz = Vector2(0, -4.8)
	yard.pack("gold_bar") = 2
	yard.pack("psionic_screwdriver") = 1
	yard.stratum("codes")("66038") = True
	yard.stratum("narcean_lexicon") = True
	yard.radiation = 12.5
	check(campaign.validate(campaign.snapshot(yard), yard), "campaign_accepts_deep_stratum_lift_car_position")
	check(campaign.save_game(), "campaign_save_in_deep_stratum")
	yard.pack.clear()
	yard.radiation = 0
	check(campaign.load_game(yard), "campaign_deep_stratum_load_succeeds")
	check(yard.pack("gold_bar") = 2 And yard.deep.has_item(yard, "commander_plus4") And Not yard.deep.has_item(yard, "psionic_screwdriver"), "campaign_pack_round_trip_and_old_tool_migration")
	check(yard.deep.interface_lexicon_ready(yard), "campaign_language_knowledge_persists_with_programmer")
	check(yard.stratum("codes").has("66038") And Abs(yard.radiation - 12.5) < 0.001, "campaign_stratum_progress_round_trip")
	table = New Dictionary
	table("laser_cannon") = 1
	check(Not campaign.stratum_valid(table, New Dictionary, 0, yard), "campaign_rejects_unknown_pack_item")
	table = New Dictionary
	table("gold_bar") = 0
	check(Not campaign.stratum_valid(table, New Dictionary, 0, yard), "campaign_rejects_empty_pack_count")
	invalid = campaign.snapshot(yard)
	invalid("position_xz") = Vector2(40, 10)
	check(Not campaign.validate(invalid, yard), "campaign_rejects_out_of_bounds_deep_position")
	invalid("floor_code") = "88216"
	invalid("position_xz") = Vector2(100, 200)
	check(campaign.validate(invalid, yard), "campaign_accepts_undercity_wide_position")
	table = New Dictionary
	table("levers") = New Dictionary
	table("levers")("88216:L0") = True
	table("powered") = True
	table("car_pos") = New Dictionary
	table("car_pos")("88216:C0") = Array(12.5, 40.25, 1.5)
	check(campaign.stratum_valid(New Dictionary, table, 0, yard), "campaign_accepts_undercity_grid_and_cars")
	table("car_pos")("88216:C0") = Array(500.0, 40.0, 0.0)
	check(Not campaign.stratum_valid(New Dictionary, table, 0, yard), "campaign_rejects_out_of_bounds_car")
	table("car_pos")("88216:C0") = Array(1.0, 2.0)
	check(Not campaign.stratum_valid(New Dictionary, table, 0, yard), "campaign_rejects_short_car_entry")
	table("car_pos") = New Dictionary
	table("powered") = "yes"
	check(Not campaign.stratum_valid(New Dictionary, table, 0, yard), "campaign_rejects_non_boolean_power")
	yard.pack.clear()
	yard.radiation = 0
	yard.place = "building"
	yard.building_index = 7
	yard.position_xz = Vector2(0, 21)
	yard.start_lift("14242")
	yard.transit_left = 2.5
	saved = campaign.snapshot(yard)
	check(campaign.save_game(), "campaign_save_during_lift")
	yard.finish_lift()
	check(campaign.load_game(yard) And campaign.snapshot(yard) = saved, "campaign_lift_destination_and_timer_restore")
	yard.finish_lift()
	yard.transit_left = 0
	yard.position_xz = Vector2(3.4, 47)
	yard.use_object()
	yard.countdown = 187.5
	yard.alarm_elapsed = 67.5
	saved = campaign.snapshot(yard)
	check(campaign.orac_online And campaign.stage() = "first_escape" And yard.message.contains("ORAC"), "campaign_coupler_wakes_feb_not_orac")
	check(campaign.save_game(), "campaign_save_active_escape")
	yard.countdown = 1
	check(campaign.load_game(yard) And campaign.snapshot(yard) = saved, "campaign_escape_save_does_not_reset_alarm")
	yard.tick(0.25, view)
	check(Abs(yard.countdown - 187.25) < 0.001, "campaign_alarm_counts_real_seconds")
	yard.failed = True
	yard.countdown = 0
	check(campaign.save_game() And campaign.load_game(yard) And yard.failed, "campaign_failed_escape_round_trip")
	yard.retry_escape()
	check(Not yard.awakening And Not yard.failed And Not yard.inventory.has("coupler") And yard.countdown = 255, "campaign_retry_restores_pre_pickup_checkpoint")
	yard.position_xz = Vector2(3.4, 47)
	yard.use_object()
	error_path = campaign.save_path
	campaign.save_path = "user://missing_campaign_test_" & Str(OS.get_process_id()) & "/save.cfg"
	check(Not campaign.save_game() And campaign.last_error.contains("write"), "campaign_write_failure_is_visible")
	campaign.save_path = error_path
	prior_save = ReadAllText(campaign.save_path)
	check(prior_save <> "" And Not FileExists(campaign.save_path & ".tmp"), "campaign_failed_write_preserves_committed_save")
	saved = campaign.snapshot(yard)
	game.dev_i = 14
	game.WarpDev()
	check(Not game.campaign_active And view.backlight_city <> yard, "campaign_dev_yard_has_separate_instance")
	view.backlight_city.take_coupler()
	view.backlight_city.inventory("regulator") = True
	game.SaveRun()
	check(game.save_msg.contains("DEV DEMO") And campaign.snapshot(yard) = saved, "campaign_dev_mutations_cannot_change_expedition")
	check(ReadAllText(campaign.save_path) = prior_save, "campaign_dev_save_does_not_touch_campaign_file")
	check(campaign.orac_online, "campaign_dev_travel_cannot_disable_orac")
	game.ResumeCampaign()
	check(game.campaign_active And view.backlight_city = yard And campaign.snapshot(yard) = saved, "campaign_resume_restores_same_expedition")
	yard.place = "surface"
	yard.floor_code = ""
	yard.position_xz = Vector2(0, -4)
	yard.use_object()
	check(yard.completed And Not yard.inventory.has("regulator") And campaign.stage() = "first_departure", "campaign_coupler_alone_enables_first_departure")
	saved = campaign.snapshot(yard)
	check(campaign.save_game() And campaign.load_game(yard), "campaign_departure_checkpoint_round_trip")
	check(campaign.snapshot(yard) = saved And campaign.orac_online, "campaign_departure_keeps_installed_coupler_and_orac")
	check(campaign.stage() <> "return_ambush", "campaign_first_departure_does_not_start_old_fight")
	check(FileExists("user://ash_meridian_save.txt") = legacy_existed, "campaign_does_not_create_or_delete_legacy_save")
	If legacy_existed Then check(ReadAllText("user://ash_meridian_save.txt") = legacy_save, "campaign_legacy_save_bytes_unchanged")
End Sub

Sub translator_checks()
	Dim deep As Object
	Dim entry As Dictionary
	Dim candidate As Dictionary
	Dim config As Object
	Dim legacy_state As Dictionary
	Dim gate As Dictionary
	Dim car As Dictionary
	Dim k As Integer
	deep = yard.deep
	campaign.new_run(yard)
	check(Not deep.interface_lexicon_ready(yard), "campaign_no_translator_from_source")
	check(campaign.save_game() And campaign.load_game(yard) And Not deep.has_item(yard, "interface_translator"), "campaign_empty_save_does_not_grant_translator")
	check(yard.blocked(Vector2(17.2, 30), 0.1) And yard.blocked(Vector2(20, 32.2), 0.1) And Not yard.blocked(Vector2(20, 27), 0.4) And Not yard.blocked(Vector2(20, 29), 0.4), "campaign_stash_walls_and_open_approach")
	yard.position_xz = Vector2(20, 26)
	yard.heading = 0
	yard.driving = False
	yard.move_distance(3)
	check(yard.position_xz.y > 28, "campaign_stash_reachable_on_foot")
	yard.place = "surface"
	yard.position_xz = Vector2(20, 30)
	yard.driving = True
	check(yard.prompt().contains("park"), "campaign_stash_requires_player_to_park")
	yard.use_object()
	check(Not deep.has_item(yard, "commander_plus4"), "campaign_cannot_recover_stash_from_buggy")
	yard.driving = False
	check(yard.prompt().contains("search abandoned pack"), "campaign_stash_has_interaction_prompt")
	yard.use_object()
	check(deep.has_item(yard, "commander_plus4") And Not deep.interface_lexicon_ready(yard), "campaign_stash_recovered_without_language")
	check(yard.message.contains("M.J.H.") And yard.message.contains("Narcean keys"), "campaign_stash_identifies_plate_without_translation")
	yard.use_object()
	check(yard.pack("commander_plus4") = 1, "campaign_stash_cannot_be_farmed")
	check(campaign.save_game() And campaign.load_game(yard) And yard.pack("commander_plus4") = 1, "campaign_stash_survives_save_and_load")
	yard.use_object()
	check(yard.pack("commander_plus4") = 1, "campaign_stash_remains_empty_after_load")
	yard.place = "floor"
	yard.floor_code = "52914"
	yard.position_xz = Vector2(0, -4.8)
	deep.arrive(yard, False)
	deep.ensure_layout(yard)
	check(deep.visor_text(yard) = "", "campaign_no_live_translation_without_lexicon")
	check(deep.address_label(yard, "52914") = "UNTRANSLATED ADDRESS", "campaign_journal_does_not_translate_copied_address_names")
	yard.position_xz = deep.consoles(0)("p")
	check(deep.use(yard) And Not yard.message.contains("TRANSLATED:") And yard.message.contains("copied"), "campaign_console_copies_addresses_without_translating_record")
	check(deep.knows(yard, "80451"), "campaign_untranslated_address_enters_journal")
	yard.position_xz = deep.gates(0)("r").get_center() + Vector2(0, -1.2)
	check(deep.use(yard) And Not deep.hacking And yard.message.contains("language knowledge"), "campaign_programmer_cannot_hack_without_lexicon")
	yard.floor_code = "88216"
	deep.arrive(yard, False)
	deep.ensure_layout(yard)
	yard.stratum("powered") = True
	deep.grid_power = True
	yard.stratum("foot_y") = 6.0
	yard.position_xz = deep._car_pos(yard, deep.cars(0)) + Vector2(2.4, 0)
	check(deep.use(yard) And Not deep.hacking And yard.message.contains("language knowledge"), "campaign_car_hack_requires_lexicon")
	yard.floor_code = "52914"
	deep.arrive(yard, False)
	deep.ensure_layout(yard)
	For Each candidate In deep.pickups
		If candidate("item") = "psionic_screwdriver" Then entry = candidate
	Next
	check(entry.size() = 0, "campaign_screwdriver_not_placed_in_warrens")
	yard.place = "building"
	yard.building_index = 0
	yard.position_xz = Vector2(0, 14)
	yard.use_object()
	check(Not deep.interface_lexicon_ready(yard), "campaign_archive_does_not_supply_language")
	yard.stratum("narcean_lexicon") = True
	yard.place = "floor"
	gate = deep.gates(0)
	yard.position_xz = gate("r").get_center() + Vector2(0, -1.2)
	yard.pack.erase("commander_plus4")
	yard.pack("psionic_screwdriver") = 1
	check(deep.use(yard) And Not deep.hacking And yard.message.contains("Mark's computer"), "campaign_screwdriver_cannot_replace_commander")
	yard.pack.erase("psionic_screwdriver")
	yard.pack("commander_plus4") = 1
	check(deep.prompt(yard).contains("COMMANDER +4") And deep.use(yard) And deep.hacking, "campaign_commander_hacks_after_language_transfer")
	For k = 0 To 10
		If deep.hacking Then
			deep.hack_glyph = deep.hack_target(deep.hack_filled)
			deep.hack_press(yard)
		End If
	Next
	check(Not deep.hacking And yard.stratum("hacked").has(gate("id")), "campaign_commander_opens_locked_door")
	yard.floor_code = "88216"
	deep.arrive(yard, False)
	deep.ensure_layout(yard)
	deep.grid_power = True
	yard.stratum("foot_y") = 6.0
	car = deep.cars(0)
	yard.position_xz = deep._car_pos(yard, car) + Vector2(2.4, 0)
	check(deep.prompt(yard).contains("COMMANDER +4") And deep.use(yard) And deep.hacking, "campaign_commander_starts_car_hack")
	For k = 0 To 10
		If deep.hacking Then
			deep.hack_glyph = deep.hack_target(deep.hack_filled)
			deep.hack_press(yard)
		End If
	Next
	check(Not deep.hacking And yard.stratum("hacked").has(car("id")), "campaign_commander_unlocks_car")
	yard.building_index = 7
	check(campaign.save_game() And campaign.load_game(yard) And yard.stratum("hacked").has(gate("id")) And yard.stratum("hacked").has(car("id")), "campaign_commander_hacks_survive_save")
	yard.floor_code = "52914"
	deep.arrive(yard, False)
	deep.ensure_layout(yard)
	yard.position_xz = Vector2(0, -4.8)
	check(deep.visor_text(yard) <> "", "campaign_lexicon_enables_live_translation")
	yard.awakening = True
	yard.alarm_elapsed = 0.4
	check(yard.hud.visor_glitch("NARCEAN SERVICE LABEL") <> "NARCEAN SERVICE LABEL", "campaign_security_disrupts_live_readout")
	check(yard.mission_objective().begins_with("Return to the Ash.") And yard.discovered(0) = yard.FEB_CODE.substr(0, 1), "campaign_interference_preserves_english_objective_and_recorded_clue")
	campaign.new_run(yard)
	yard.pack("psionic_screwdriver") = 1
	check(campaign.save_game(), "campaign_legacy_programmer_fixture_saved")
	check(campaign.load_game(yard) And Not deep.interface_lexicon_ready(yard) And deep.has_item(yard, "commander_plus4") And Not deep.has_item(yard, "psionic_screwdriver"), "campaign_old_tool_migrates_without_inventing_language")
	config = ClassDB.Instantiate("ConfigFile")
	config.load(campaign.save_path)
	legacy_state = config.get_value("stratum", "state")
	legacy_state.erase("narcean_lexicon")
	config.set_value("stratum", "state", legacy_state)
	config.save(campaign.save_path)
	check(campaign.load_game(yard) And deep.interface_lexicon_ready(yard) And deep.has_item(yard, "commander_plus4") And Not deep.has_item(yard, "psionic_screwdriver") And Not deep.has_item(yard, "interface_translator"), "campaign_legacy_programmer_gains_learned_lexicon_on_load")
	check(yard.message.contains("Legacy programmer lexicon restored"), "campaign_legacy_lexicon_migration_explained")
	check(campaign.save_game(), "campaign_migrated_lexicon_saves")
	check(campaign.load_game(yard) And yard.stratum.get("narcean_lexicon", False), "campaign_migrated_lexicon_load_is_idempotent")
	campaign.new_run(yard)
	yard.pack("interface_translator") = 1
	check(campaign.save_game() And campaign.load_game(yard) And deep.interface_lexicon_ready(yard) And Not yard.pack.has("interface_translator"), "campaign_legacy_translator_migrates_to_knowledge")
	campaign.new_run(yard)
End Sub

Sub _Process(ByVal delta As Single)
	Dim directory As Object
	Dim capture_directory As String
	Dim config As Object
	Dim restored_yard As Object
	frame = frame + 1
	If frame = 2 Then
		key(KEY_ENTER, True)
		game.set_process(True)
	ElseIf frame = 4 Then
		key(KEY_ENTER, False)
	ElseIf frame = 6 Then
		game.set_process(False)
		check(game.phase = 23 And game.opening_player <> Nothing, "play_starts_the_opening_cut")
		check(game.opening_text.size() = 20 And Abs(game.opening_from(0) - 2.0) < 0.01 And Abs(game.opening_to(19) - 137.243) < 0.01, "opening_subtitles_loaded")
		game.FinishOpening()
		check(game.phase = 0 And game.campaign_arrival And Not game.campaign_active, "campaign_play_opens_orac_approach")
		game.phase = 1
		game.next_ring = 28
		game.ship_z = 600.0
		game.landing_failed = False
		game.set_process(True)
	ElseIf frame = 7 Then
		game.set_process(False)
	ElseIf frame = 8 Then
		yard = campaign.city
		persistence_checks()
		game.QueueRedraw()
	ElseIf frame = 9 Then
		key(KEY_ENTER, True)
		game.set_process(True)
	ElseIf frame = 10 Then
		key(KEY_ENTER, False)
	ElseIf frame = 11 Then
		game.set_process(False)
	ElseIf frame = 12 Then
		check(yard.completed And yard.inventory.has("coupler"), "campaign_enter_does_not_restart_completed_expedition")
		check(view.backlight_city = yard And yard.world.visible, "campaign_rendered_yard_restored")
		check(yard.hud.city = yard And yard.campaign_mode, "campaign_hud_uses_campaign_instance")
		If DisplayServer.get_name() <> "headless" Then
			capture_directory = OS.get_environment("ASH_CAMPAIGN_CAPTURE")
			If Len(capture_directory) > 0 Then check(GetViewport().get_texture().get_image().save_png(capture_directory & "/campaign-departure.png") = 0, "campaign_departure_capture")
		End If
		game.StartCampaign()
		check(state_matches(campaign.snapshot(yard), initial) And view.campaign_yard = yard, "campaign_new_game_resets_all_persistent_fields")
	ElseIf frame = 14 Then
		key(KEY_H, True)
		game.set_process(True)
	ElseIf frame = 16 Then
		key(KEY_H, False)
	ElseIf frame = 18 Then
		game.set_process(False)
		check(yard.message.contains("ORAC") And yard.message.contains("depot workbenches"), "campaign_h_triggers_orac_context_scan")
		If DisplayServer.get_name() <> "headless" Then
			capture_directory = OS.get_environment("ASH_CAMPAIGN_CAPTURE")
			If Len(capture_directory) > 0 Then check(GetViewport().get_texture().get_image().save_png(capture_directory & "/campaign-yard.png") = 0, "campaign_yard_capture")
		End If
		yard.place = "floor"
		yard.building_index = 7
		yard.floor_code = "14242"
		yard.position_xz = Vector2(3.4, 47)
		yard.use_object()
		yard.countdown = 120
		pause_seconds = yard.countdown
		game.menu_on = True
		game.set_process(True)
	ElseIf frame = 22 Then
		game.set_process(False)
		check(yard.countdown = pause_seconds And campaign.orac_online, "campaign_pause_freezes_escape_without_disabling_orac")
		game.menu_on = False
		game.dev_i = 14
		game.WarpDev()
		resume_state = campaign.snapshot(yard)
		key(KEY_F10, True)
		game.set_process(True)
	ElseIf frame = 24 Then
		key(KEY_F10, False)
	ElseIf frame = 26 Then
		game.set_process(False)
		check(game.campaign_active And view.backlight_city = yard And yard.countdown > 0 And yard.countdown <= pause_seconds, "campaign_f10_resumes_after_dev_travel")
		game.SaveRun()
		check(game.save_msg = "CAMPAIGN SAVED", "campaign_pause_save_dispatch")
		saved = campaign.snapshot(yard)
		pause_seconds = yard.countdown
		yard.countdown = 2
		game.phase = 12
		game.campaign_active = False
		game.title_i = 0
		check(game.TitleCount() = 4 And game.TitleLabel(0) = "CONTINUE", "campaign_title_continue_uses_campaign_file")
	ElseIf frame = 28 Then
		key(KEY_ENTER, True)
		game.set_process(True)
	ElseIf frame = 30 Then
		key(KEY_ENTER, False)
	ElseIf frame = 32 Then
		game.set_process(False)
		check(game.campaign_active And game.phase = 18 And yard.countdown > 2 And yard.countdown <= pause_seconds And campaign.orac_online, "campaign_real_continue_restores_saved_escape")
		resume_state = campaign.snapshot(yard)
		prior_save = ReadAllText(campaign.save_path)
		config = ClassDB.Instantiate("ConfigFile")
		config.load(campaign.save_path)
		config.set_value("campaign", "version", 999)
		config.save(campaign.save_path)
		game.phase = 12
		game.campaign_active = False
		game.title_i = 0
	ElseIf frame = 34 Then
		key(KEY_ENTER, True)
		game.set_process(True)
	ElseIf frame = 36 Then
		key(KEY_ENTER, False)
	ElseIf frame = 38 Then
		game.set_process(False)
		check(game.phase = 12 And Not game.campaign_active And game.save_msg.contains("version"), "campaign_bad_continue_stays_on_title_with_error")
		check(campaign.snapshot(yard) = resume_state, "campaign_bad_continue_preserves_active_session")
		WriteAllText campaign.save_path, prior_save
		campaign.orac_online = False
		check(Not campaign.save_game() And ReadAllText(campaign.save_path) = prior_save, "campaign_invalid_metadata_cannot_overwrite_save")
		config = ClassDB.Instantiate("ConfigFile")
		config.load(campaign.save_path)
		config.set_value("campaign", "orac_online", False)
		config.save(campaign.save_path)
		check(Not campaign.load_game(yard) And campaign.last_error.contains("online"), "campaign_rejects_premature_orac_outage")
		WriteAllText campaign.save_path, prior_save
		restored_game = Load("res://main.tscn").instantiate()
		add_child(restored_game)
		restored_game.set_process(False)
		restored_game.campaign.save_path = campaign.save_path
		restored_game.LoadCampaign()
		restored_yard = restored_game.campaign.city
		check(restored_game.campaign_active And state_matches(restored_game.campaign.snapshot(restored_yard), saved), "campaign_cold_load_restores_complete_expedition")
		check(restored_game.campaign.orac_online And restored_yard <> yard, "campaign_cold_load_uses_independent_scene")
		restored_yard.audio.stop()
		yard.audio.stop()
		If view.backlight_yard <> Nothing Then
			If view.backlight_yard.audio <> Nothing Then view.backlight_yard.audio.stop()
		End If
		directory = ClassDB.class_call_static("DirAccess", "open", "user://")
		directory.remove(campaign.save_path)
	ElseIf frame = 40 Then
		restored_game.queue_free()
		restored_game = Nothing
	ElseIf frame = 42 Then
		directory = ClassDB.class_call_static("DirAccess", "open", "user://")
		If directory <> Nothing Then directory.remove("ash_meridian_opening.txt")
		Print "CAMPAIGN_RESULT=" & Str(checks - failures) & "/" & Str(checks)
		GetTree().quit(failures)
	End If
End Sub
