Option Explicit

Const SAVE_VERSION As Integer = 1
Dim save_path As String = "user://ash_meridian_campaign.cfg"
Dim last_error As String
Dim city As Object
Dim orac_online As Boolean = True
Dim visit_number As Integer = 1

Sub new_run(ByVal yard As Object)
	city = yard
	city.campaign_mode = True
	city.reset()
	orac_online = True
	visit_number = 1
	last_error = ""
	city.notify("ORAC: Welcome to Narcea, Jason. Mark's shelter is east of the road, near the broken amber drain marker. Park and search it with F.")
End Sub

Function stage() As String
	If city.completed Then Return "first_departure"
	If city.awakening Then Return "first_escape"
	Return "first_salvage"
End Function

Function objective() As String
	Return city.mission_objective()
End Function

Function snapshot(ByVal yard As Object) As Dictionary
	Dim result As Dictionary
	Dim field_names As Array
	Dim field_name As String
	Dim i As Integer
	Dim value As Variant
	result = New Dictionary
	field_names = fields()
	For i = 0 To field_names.size() - 1
		field_name = field_names(i)
		value = yard.get(field_name)
		If TypeName(value) = "Dictionary" Then value = value.duplicate(True)
		result.Add(field_name, value)
	Next
	Return result
End Function

Function fields() As Array
	Return Array("position_xz", "heading", "velocity", "driving", "inspection", "buggy_position", "buggy_heading", "collected", "wheel_angle", "steering", "place", "building_index", "surface_position", "surface_heading", "discovered", "inventory", "visited", "keypad", "sequence", "floor_code", "transit_left", "transit_total", "lift_target", "awakening", "countdown", "alarm_elapsed", "alarm_pulse", "damage_cooldown", "shield", "completed", "failed", "launch_elapsed")
End Function

Function reject(ByVal reason As String) As Boolean
	last_error = reason
	Print "CAMPAIGN: " & reason
	Return False
End Function

Function number_between(ByVal value As Variant, ByVal low As Double, ByVal high As Double) As Boolean
	If TypeName(value) <> "Integer" And TypeName(value) <> "Double" Then Return False
	Return value >= low And value <= high
End Function

Function point_valid(ByVal value As Variant, ByVal surface As Boolean, Optional ByVal deep_floor As Boolean = False, Optional ByVal floor_code As String = "") As Boolean
	If TypeName(value) <> "Vector2" Then Return False
	If surface Then Return value.x >= -118 And value.x <= 118 And value.y >= -12 And value.y <= 420
	' Deep Stratum floors include the lift car behind z = 0; only the 240 x 288 undercity exceeds 70 x 90.
	If deep_floor And floor_code = "88216" Then Return value.x >= -121 And value.x <= 121 And value.y >= -7.5 And value.y <= 290
	If deep_floor Then Return value.x >= -36 And value.x <= 36 And value.y >= -7.5 And value.y <= 91
	Return value.x >= -22 And value.x <= 22 And value.y >= 0 And value.y <= 58
End Function

Function code_valid(ByVal value As String, ByVal complete As Boolean) As Boolean
	Dim i As Integer
	If complete And Len(value) <> 5 Then Return False
	If Len(value) > 5 Then Return False
	For i = 0 To Len(value) - 1
		If InStr("0123456789", Mid(value, i + 1, 1)) = 0 Then Return False
	Next
	Return True
End Function

Function validate(ByVal data As Variant, ByVal yard As Object) As Boolean
	Dim field_names As Array
	Dim field_name As Variant
	Dim key As Variant
	Dim expected As String
	Dim has_coupler As Boolean
	Dim items As Dictionary
	Dim journal As Dictionary
	Dim visits As Dictionary
	Dim cell_count As Integer
	If TypeName(data) <> "Dictionary" Then Return reject("Save has no valid expedition state.")
	field_names = fields()
	If data.size() <> field_names.size() Then Return reject("Save fields do not match this campaign version.")
	For Each field_name In field_names
		If Not data.has(field_name) Then Return reject("Save is missing " & field_name & ".")
		expected = "Double"
		If Array("position_xz", "buggy_position", "surface_position").has(field_name) Then expected = "Vector2"
		If Array("driving", "keypad", "awakening", "completed", "failed").has(field_name) Then expected = "Boolean"
		If Array("place", "sequence", "floor_code", "lift_target").has(field_name) Then expected = "String"
		If Array("discovered", "inventory", "visited").has(field_name) Then expected = "Dictionary"
		If expected = "Double" Then
			If Not number_between(data(field_name), -1000000, 1000000) Then Return reject("Invalid number: " & field_name & ".")
		ElseIf TypeName(data(field_name)) <> expected Then
			Return reject("Invalid type: " & field_name & ".")
		End If
	Next
	If data.place <> "surface" And data.place <> "building" And data.place <> "floor" And data.place <> "lift" Then Return reject("Unknown expedition location.")
	If Not point_valid(data.position_xz, data.place = "surface", data.place = "floor" And yard.deep.is_level(data.floor_code), data.floor_code) Then Return reject("Player position is outside the expedition.")
	If Not point_valid(data.buggy_position, True) Or Not point_valid(data.surface_position, True) Then Return reject("Invalid parked vehicle or surface return position.")
	If Not number_between(data.building_index, -1, 7) Or data.building_index <> Int(data.building_index) Then Return reject("Invalid building.")
	If data.place <> "surface" And data.building_index < 0 Then Return reject("Interior has no surface destination.")
	If data.place = "floor" Or data.place = "lift" Then
		If data.building_index <> 7 Then Return reject("Underground travel must use the transit depot.")
	End If
	If data.driving And data.place <> "surface" Then Return reject("Vehicle cannot be inside an interior.")
	If Not number_between(data.inspection, 0, 2) Or data.inspection <> Int(data.inspection) Then Return reject("Invalid camera mode.")
	If Not number_between(data.velocity, -22, 22) Or Not number_between(data.shield, 0, 100) Then Return reject("Invalid vehicle speed or suit status.")
	If Not number_between(data.collected, 0, 3) Or data.collected <> Int(data.collected) Then Return reject("Invalid cell count.")
	If Not number_between(data.countdown, 0, 255) Or Not number_between(data.transit_left, 0, 4) Then Return reject("Invalid alarm or lift timer.")
	If data.transit_total <> 3 And data.transit_total <> 4 Then Return reject("Invalid lift journey.")
	If data.transit_left > data.transit_total Or (data.transit_left > 0 And data.place <> "lift") Then Return reject("Lift timer and location disagree.")
	If data.place = "lift" And data.transit_left <= 0 Then Return reject("Lift journey has no time remaining.")
	If data.place = "lift" And data.lift_target = "" Then Return reject("Lift journey has no destination.")
	If data.alarm_elapsed < 0 Or data.launch_elapsed < 0 Or data.damage_cooldown < 0 Then Return reject("Negative elapsed timer.")
	If Not code_valid(data.sequence, False) Then Return reject("Invalid keypad sequence.")
	If data.place = "floor" And Not code_valid(data.floor_code, True) Then Return reject("Invalid stratum address.")
	If data.floor_code <> "" And Not code_valid(data.floor_code, True) Then Return reject("Invalid saved stratum.")
	If data.lift_target <> "" And data.lift_target <> "surface" And Not code_valid(data.lift_target, True) Then Return reject("Invalid lift destination.")
	If data.keypad And (data.place <> "building" Or data.building_index <> 7 Or data.awakening) Then Return reject("Invalid keypad state.")
	items = data("inventory")
	journal = data("discovered")
	visits = data("visited")
	For Each key In items.keys()
		If Not Array("regulator", "ignition", "coupler", "cell_0", "cell_1", "cell_2").has(key) Then Return reject("Unknown inventory item.")
		If TypeName(items(key)) <> "Boolean" Then Return reject("Invalid inventory flag.")
		If Not items(key) Then Return reject("Inactive inventory entry.")
		If key.begins_with("cell_") Then cell_count = cell_count + 1
	Next
	If data.collected <> cell_count Then Return reject("Collected cells and inventory disagree.")
	For Each key In journal.keys()
		If Not number_between(key, 0, 4) Then Return reject("Invalid journal slot.")
		If key <> Int(key) Then Return reject("Invalid journal index.")
		If TypeName(journal(key)) <> "String" Then Return reject("Invalid journal symbol.")
		If journal(key) <> yard.FEB_CODE.substr(key, 1) Then Return reject("Journal symbol does not match its archive.")
	Next
	For Each key In visits.keys()
		If Not number_between(key, 0, 7) Then Return reject("Invalid visited depot.")
		If key <> Int(key) Or TypeName(visits(key)) <> "Boolean" Then Return reject("Invalid depot visit.")
	Next
	has_coupler = items.has("coupler")
	If data.awakening <> (has_coupler And Not data.completed) Then Return reject("Coupler and awakening state disagree.")
	If data.completed And (Not has_coupler Or data.failed Or data.place <> "surface") Then Return reject("Invalid first departure state.")
	If data.failed And Not data.awakening Then Return reject("Failure has no active escape.")
	If Not data.failed And data.awakening And (data.countdown <= 0 Or data.shield <= 0) Then Return reject("Escape has expired without a failure state.")
	If Not data.awakening And Not data.completed And (data.countdown <> 255 Or data.alarm_elapsed <> 0) Then Return reject("Dormant chamber has an active alarm.")
	Return True
End Function

' Optional [stratum] section: pack counts, Deep Stratum progress and absorbed
' radiation. Saves without it (older builds) load with an empty pack.
Function stratum_valid(ByVal pack As Variant, ByVal state As Variant, ByVal rad As Variant, ByVal yard As Object) As Boolean
	Dim key As Variant
	Dim sub_key As Variant
	If TypeName(pack) <> "Dictionary" Or TypeName(state) <> "Dictionary" Then Return reject("Invalid Deep Stratum section.")
	For Each key In pack.keys()
		If TypeName(key) <> "String" Then Return reject("Invalid pack entry.")
		If Not yard.deep.ITEMS.has(key) Then Return reject("Unknown pack item: " & key & ".")
		If TypeName(pack(key)) <> "Integer" Then Return reject("Invalid pack count.")
		If pack(key) < 1 Or pack(key) > 99 Then Return reject("Invalid pack count.")
	Next
	For Each sub_key In Array("codes", "taken", "hacked")
		If state.has(sub_key) Then
			If TypeName(state(sub_key)) <> "Dictionary" Then Return reject("Invalid Deep Stratum progress.")
		End If
	Next
	If state.has("codes") Then
		For Each key In state("codes").keys()
			If Not code_valid(key, True) Then Return reject("Invalid recovered lift code.")
		Next
	End If
	For Each sub_key In Array("levers", "car_pos")
		If state.has(sub_key) Then
			If TypeName(state(sub_key)) <> "Dictionary" Then Return reject("Invalid Deep Stratum progress.")
		End If
	Next
	If state.has("car_pos") Then
		For Each key In state("car_pos").keys()
			If TypeName(state("car_pos")(key)) <> "Array" Then Return reject("Invalid groundcar position.")
			If state("car_pos")(key).size() <> 3 Then Return reject("Invalid groundcar position.")
			If Not number_between(state("car_pos")(key)(0), -121, 121) Or Not number_between(state("car_pos")(key)(1), 0, 290) Then Return reject("Invalid groundcar position.")
		Next
	End If
	For Each key In Array("powered", "narcean_lexicon", "alien_english", "club_pad_activated", "feb_governor_bypassed")
		If state.has(key) Then
			If TypeName(state(key)) <> "Boolean" Then Return reject("Invalid Deep Stratum state: " & key & ".")
		End If
	Next
	If Not number_between(rad, 0, 1000) Then Return reject("Invalid radiation dose.")
	Return True
End Function

Function save_game() As Boolean
	Dim config As Object
	Dim directory As Object
	Dim data As Dictionary
	Dim error_code As Integer
	Dim temporary As String
	last_error = ""
	If city Is Nothing Then Return reject("There is no expedition to save.")
	If Not orac_online Or visit_number <> 1 Then Return reject("Only an online Orac on the first expedition can be saved by this build.")
	data = snapshot(city)
	If Not validate(data, city) Then Return False
	config = ClassDB.Instantiate("ConfigFile")
	config.set_value("campaign", "version", SAVE_VERSION)
	config.set_value("campaign", "stage", stage())
	config.set_value("campaign", "visit_number", visit_number)
	config.set_value("campaign", "orac_online", orac_online)
	config.set_value("campaign", "expedition", data)
	If Not stratum_valid(city.pack, city.stratum, CDbl(city.radiation), city) Then Return False
	config.set_value("stratum", "pack", city.pack.duplicate(True))
	config.set_value("stratum", "state", city.stratum.duplicate(True))
	config.set_value("stratum", "radiation", CDbl(city.radiation))
	temporary = save_path & ".tmp"
	directory = ClassDB.class_call_static("DirAccess", "open", "user://")
	If directory Is Nothing Then Return reject("Could not open the campaign save directory.")
	error_code = config.save(temporary)
	If error_code <> 0 Then
		If FileExists(temporary) Then directory.remove(temporary)
		Return reject("Could not write campaign save (error " & Str(error_code) & ").")
	End If
	error_code = directory.rename(temporary, save_path)
	If error_code <> 0 Then
		directory.remove(temporary)
		Return reject("Could not replace campaign save (error " & Str(error_code) & "). Previous save retained.")
	End If
	Return True
End Function

Function complete_first_departure(ByVal departure_yard As Object) As Boolean
	If city Is Nothing Then Return reject("There is no campaign to complete.")
	If departure_yard Is Nothing Then Return reject("The departure yard is missing.")
	If Not departure_yard.campaign_mode Or Not departure_yard.trace_escape Then Return reject("The first-departure transition requires the campaign escape yard.")
	If Not departure_yard.completed Or departure_yard.failed Or Not departure_yard.inventory.get("coupler", False) Then Return reject("The Ash has not completed a valid departure.")
	departure_yard.pack = city.pack.duplicate(True)
	departure_yard.stratum = city.stratum.duplicate(True)
	departure_yard.radiation = city.radiation
	departure_yard.discovered = city.discovered.duplicate(True)
	departure_yard.visited = city.visited.duplicate(True)
	departure_yard.inventory = New Dictionary
	departure_yard.inventory("coupler") = True
	departure_yard.awakening = False
	departure_yard.completed = True
	departure_yard.failed = False
	departure_yard.departure_saved = False
	departure_yard.deep.ensure_state(departure_yard)
	city = departure_yard
	If Not save_game() Then Return False
	departure_yard.departure_saved = True
	departure_yard.notify("ORAC: Level 1 departure saved. We are clear of the yard.")
	Return True
End Function

Function load_game(ByVal yard As Object) As Boolean
	Dim config As Object
	Dim data As Variant
	Dim field_name As Variant
	Dim saved_stage As Variant
	Dim expected_stage As String
	Dim error_code As Integer
	Dim saved_pack As Variant
	Dim saved_state As Variant
	Dim saved_rad As Variant
	Dim restored_lexicon As Boolean
	Dim restored_commander As Boolean
	last_error = ""
	config = ClassDB.Instantiate("ConfigFile")
	error_code = config.load(save_path)
	If error_code <> 0 Then Return reject("Could not read campaign save (error " & Str(error_code) & ").")
	If config.get_value("campaign", "version", 0) <> SAVE_VERSION Then Return reject("Unsupported campaign save version. File left unchanged.")
	If config.get_value("campaign", "visit_number", 0) <> 1 Then Return reject("This campaign build supports the first visit only.")
	If config.get_value("campaign", "orac_online", False) <> True Then Return reject("Orac must remain online during the first expedition.")
	data = config.get_value("campaign", "expedition", Nothing)
	If Not validate(data, yard) Then Return False
	expected_stage = "first_salvage"
	If data.awakening Then expected_stage = "first_escape"
	If data.completed Then expected_stage = "first_departure"
	saved_stage = config.get_value("campaign", "stage", "")
	If saved_stage <> expected_stage Then Return reject("Campaign stage and expedition state disagree.")
	saved_pack = config.get_value("stratum", "pack", New Dictionary)
	saved_state = config.get_value("stratum", "state", New Dictionary)
	saved_rad = config.get_value("stratum", "radiation", 0.0)
	If Not stratum_valid(saved_pack, saved_state, saved_rad, yard) Then Return False
	' Validate everything before changing the active expedition.
	city = yard
	city.campaign_mode = True
	city.reset()
	For Each field_name In fields()
		city.set(field_name, data(field_name))
	Next
	city.pack = saved_pack.duplicate(True)
	restored_lexicon = Not saved_state.has("narcean_lexicon") And city.deep.has_item(city, "psionic_screwdriver") And Not city.deep.has_item(city, "interface_translator")
	restored_commander = city.deep.has_item(city, "psionic_screwdriver") And Not city.deep.has_item(city, "commander_plus4")
	If restored_commander Then city.pack("commander_plus4") = 1
	If city.pack.has("psionic_screwdriver") Then city.pack.erase("psionic_screwdriver")
	city.stratum = saved_state.duplicate(True)
	If restored_lexicon Or city.deep.has_item(city, "interface_translator") Then city.stratum("narcean_lexicon") = True
	If city.pack.has("interface_translator") Then city.pack.erase("interface_translator")
	city.radiation = saved_rad
	city.deep.ensure_state(city)
	city.departure_saved = city.completed
	city.pending_room = True
	orac_online = True
	visit_number = 1
	If city.awakening And Not city.failed Then city.audio.play()
	If restored_lexicon Then
		city.notify("ORAC: Legacy programmer lexicon restored as learned language knowledge. Mark's computer replaces the old tool. " & objective())
	ElseIf restored_commander Then
		city.notify("ORAC: Mark's computer replaces the old hacking tool in this saved expedition. " & objective())
	Else
		city.notify("ORAC: Expedition restored, Jason. " & objective())
	End If
	Return True
End Function
