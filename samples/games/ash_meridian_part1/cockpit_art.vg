' Generated Visual Gasic port of cockpit_art.vg
Dim __ready As Boolean
Dim PINK As Variant
Dim CYAN As Variant
Dim METAL As Variant


Function Num(ByVal value As Variant) As Single
	If value = True Then
		Num = 1.0
	ElseIf value = False Then
		Num = 0.0
	Else
		Num = value
	End If
End Function

Function FPosMod(ByVal value As Single, ByVal modulus As Single) As Single
	Dim wrapped As Single
	wrapped = value - modulus * Int(value / modulus)
	If wrapped < 0 Then wrapped = wrapped + modulus
	FPosMod = wrapped
End Function

Function FMod(ByVal value As Single, ByVal modulus As Single) As Single
	FMod = value - modulus * Int(value / modulus)
End Function

Function CeilInt(ByVal value As Single) As Integer
	Dim floored As Integer
	floored = Int(value)
	If value > floored Then
		CeilInt = floored + 1
	Else
		CeilInt = floored
	End If
End Function

Function RoundInt(ByVal value As Single) As Integer
	If value >= 0 Then
		RoundInt = Int(value + 0.5)
	Else
		RoundInt = Int(value - 0.5)
	End If
End Function

Function PadInt(ByVal value As Integer, ByVal width As Integer) As String
	Dim text As String
	If value < 0 Then value = 0
	text = Str(value)
	While Len(text) < width
		text = "0" & text
	Wend
	PadInt = text
End Function

Function AngleDifference(ByVal from_angle As Single, ByVal to_angle As Single) As Single
	Dim diff As Single
	diff = FPosMod(to_angle - from_angle, 6.283185307179586)
	If diff > 3.141592653589793 Then diff = diff - 6.283185307179586
	AngleDifference = diff
End Function

Function RotateToward(ByVal from_angle As Single, ByVal to_angle As Single, ByVal amount As Single) As Single
	Dim diff As Single
	diff = AngleDifference(from_angle, to_angle)
	If diff > amount Then diff = amount
	If diff < 0 - amount Then diff = 0 - amount
	RotateToward = from_angle + diff
End Function

Function DictFlag(ByVal table As Dictionary, ByVal code As Integer) As Boolean
	If table.Has(code) Then
		DictFlag = table(code)
	Else
		DictFlag = False
	End If
End Function

Function VecLess(ByVal a As Vector3, ByVal b As Vector3) As Boolean
	If a.x <> b.x Then
		VecLess = a.x < b.x
	ElseIf a.y <> b.y Then
		VecLess = a.y < b.y
	Else
		VecLess = a.z < b.z
	End If
End Function

Function SpawnVg(ByVal path As String, ByVal type_name As String) As Object
	Dim node As Object
	Dim script As Object
	node = ClassDB.Instantiate(type_name)
	script = Load(path)
	node.SetScript(script)
	SpawnVg = node
End Function

Function PackVec2(ByVal items As Array) As PackedVector2Array
	Dim packed As PackedVector2Array
	Dim item As Variant
	For Each item In AsArray(items)
		packed.append(item)
	Next
	PackVec2 = packed
End Function

Function PackVec3(ByVal items As Array) As PackedVector3Array
	Dim packed As PackedVector3Array
	Dim item As Variant
	For Each item In AsArray(items)
		packed.append(item)
	Next
	PackVec3 = packed
End Function

Function PackColor(ByVal items As Array) As PackedColorArray
	Dim packed As PackedColorArray
	Dim item As Variant
	For Each item In AsArray(items)
		packed.append(item)
	Next
	PackColor = packed
End Function

Function PackByte(ByVal items As Array) As PackedByteArray
	Dim packed As PackedByteArray
	Dim item As Variant
	For Each item In AsArray(items)
		packed.append(item)
	Next
	PackByte = packed
End Function

Function Sign(ByVal value As Single) As Single
	If value > 0 Then
		Sign = 1
	ElseIf value < 0 Then
		Sign = -1
	Else
		Sign = 0
	End If
End Function

Function AsArray(ByVal items As Variant) As Array
	Dim out As Array
	Dim i As Integer
	Dim n As Integer
	out = Array()
	If items = Nothing Then
		AsArray = out
		Exit Function
	End If
	' vbString = 8. Digit bars iterate "bc" as characters. String subscript is not an array.
	If VarType(items) = 8 Then
		n = Len(items)
		If n > 0 Then
			For i = 1 To n
				out.append(Mid(items, i, 1))
			Next
		End If
		AsArray = out
		Exit Function
	End If
	' GDScript `for x in N` walks 0..N-1. vbLong=3, vbDouble=5, vbInteger=2, vbSingle=4.
	If VarType(items) = 2 Or VarType(items) = 3 Or VarType(items) = 4 Or VarType(items) = 5 Then
		n = Int(items)
		If n > 0 Then
			For i = 0 To n - 1
				out.append(i)
			Next
		End If
		AsArray = out
		Exit Function
	End If
	For i = 0 To items.size() - 1
		out.append(items(i))
	Next
	AsArray = out
End Function


Sub EnsureInit()
	If __ready Then Exit Sub
	__ready = True
	PINK = Color(1.0, 0.29, 0.85)
	CYAN = Color(0.2, 0.92, 1.0)
	METAL = Color(0.018, 0.009, 0.028)
End Sub

Sub path(ByVal points As Array, Optional color As Variant, Optional width As Variant = 1.2, Optional glow As Variant = True)
	Dim packed As PackedVector2Array
	If color Is Nothing Then
		color = PINK
	End If
	Call EnsureInit()
	For Each point In AsArray(points)
		packed.append(point)
	Next
	If glow Then
		draw_polyline(packed, Color(color, 0.045), width + 9.0, True)
		draw_polyline(packed, Color(color, 0.12), width + 4.0, True)
	End If
	draw_polyline(packed, color, width, True)
End Sub

Sub plate(ByVal points As Array, Optional color As Variant)
	If color Is Nothing Then
		color = PINK
	End If
	Call EnsureInit()
	draw_colored_polygon(PackVec2(points), METAL)
	path(points + Array(points(0)), color)
End Sub

Sub arc(ByVal center As Vector2, ByVal radius As Vector2, ByVal start As Single, ByVal finish As Single, Optional color As Variant, Optional width As Variant = 1.2)
	Dim points As Variant
	Dim angle As Variant
	If color Is Nothing Then
		color = PINK
	End If
	Call EnsureInit()
	points = Array()
	For i = 0 To (65 - 1)
		angle = LerpF(start, finish, i / 64.0)
		points.append(center + Vector2(Cos(angle), Sin(angle)) * radius)
	Next
	path(points, color, width)
End Sub

Sub screen(ByVal rect As Rect2)
	Call EnsureInit()
	draw_style_box(_panel_style(), rect.grow(6))
	draw_rect(rect, Color(0.005, 0.018, 0.025))
	path(Array(rect.position, rect.position + Vector2(rect.size.x, 0), rect.end, rect.position + Vector2(0, rect.size.y), rect.position), PINK)
End Sub

Function _panel_style() As StyleBoxFlat
	Dim style As Variant
	Call EnsureInit()
	style = ClassDB.Instantiate("StyleBoxFlat")
	style.bg_color = METAL
	style.border_color = Color(0.6, 0.16, 0.5)
	style.set_border_width_all(1)
	style.set_corner_radius_all(5)
	Return style
End Function

Sub _draw()
	Dim offset As Single
	Dim x As Single
	Dim y As Variant
	Dim angle As Variant
	Dim radar As Variant
	Dim _t0 As Variant
	Call EnsureInit()
	' The windscreen is deliberately clear; the reference's flight rings are not canopy geometry.
	For i = 0 To (5 - 1)
		arc(Vector2(480, 389), Vector2(468 + i * 8, 345 + i * 6), PI * 1.04, PI * 1.96, PINK, 1.0)
	Next
	For Each side In AsArray(Array(-1.0, 1.0))
		For rib = 0 To (4 - 1)
			offset = side * rib * 5
			path(Array(Vector2(480 + side * 470 + offset, -12), Vector2(480 + side * 298 + offset, 106), Vector2(480 + side * 219 + offset, 190), Vector2(480 + side * 158 + offset, 300)), PINK)
		Next
		path(Array(Vector2(480 + side * 482, 0), Vector2(480 + side * 468, 350), Vector2(480 + side * 328, 309), Vector2(480 + side * 152, 286)), PINK, 2)
		plate(Array(Vector2(480 + side * 478, 356), Vector2(480 + side * 312, 315), Vector2(480 + side * 241, 434), Vector2(480 + side * 334, 540), Vector2(480 + side * 480, 540)))
		For i = 0 To (3 - 1)
			x = 480 + side * (350 + i * 28)
			If i  Mod  2 = 0 Then
				_t0 = CYAN
			Else
				_t0 = PINK
			End If
			plate(Array(Vector2(x, 389), Vector2(x + side * 19, 383), Vector2(x + side * 19, 397), Vector2(x, 403)), _t0)
		Next
		plate(Array(Vector2(480 + side * 310, 442), Vector2(480 + side * 379, 523), Vector2(480 + side * 462, 493), Vector2(480 + side * 367, 419)))
		For row = 0 To (4 - 1)
			y = 449 + row * 15
			x = 480 + side * (357 + row * 10)
			path(Array(Vector2(x, y), Vector2(x + side * 35, y - 9)), CYAN, 1.3)
		Next
	Next
	plate(Array(Vector2(180, 435), Vector2(197, 325), Vector2(335, 301), Vector2(357, 278), Vector2(603, 278), Vector2(625, 301), Vector2(763, 325), Vector2(780, 435)))
	plate(Array(Vector2(194, 439), Vector2(207, 329), Vector2(340, 311), Vector2(362, 288), Vector2(598, 288), Vector2(620, 311), Vector2(753, 329), Vector2(766, 439)))
	screen(Rect2(371, 294, 218, 36))
	path(Array(Vector2(384, 319), Vector2(384, 302), Vector2(398, 303), Vector2(425, 320), Vector2(442, 320)), CYAN)
	For i = 0 To (5 - 1)
		path(Array(Vector2(461 + i * 19, 301), Vector2(471 + i * 19, 301)), CYAN)
	Next
	arc(Vector2(555, 314), Vector2(9, 9), 0, 6.283185307179586, CYAN)
	For i = 0 To (8 - 1)
		angle = i * 6.283185307179586 / 8
		path(Array(Vector2(555, 314) + Vector2(Cos(angle), Sin(angle)) * 12, Vector2(555, 314) + Vector2(Cos(angle), Sin(angle)) * 16), CYAN)
	Next
	screen(Rect2(219, 343, 139, 88))
	screen(Rect2(379, 343, 202, 88))
	screen(Rect2(602, 343, 139, 88))
	radar = Vector2(289, 388)
	arc(radar, Vector2(40, 40), 0, 6.283185307179586, CYAN)
	arc(radar, Vector2(19, 19), 0, 6.283185307179586, CYAN)
	path(Array(radar + Vector2(-40, 0), radar + Vector2(40, 0)), CYAN)
	path(Array(radar + Vector2(0, -40), radar + Vector2(0, 40)), CYAN)
	draw_arc(radar, 29, -PI * 0.5, 0, 24, Color(0.12, 0.5, 0.58, 0.7), 17, True)
	arc(Vector2(480, 385), Vector2(47, 34), 0, 6.283185307179586, CYAN)
	arc(Vector2(480, 385), Vector2(67, 29), 0, 6.283185307179586, CYAN)
	path(Array(Vector2(480, 349), Vector2(467, 371), Vector2(439, 405), Vector2(470, 399), Vector2(480, 424), Vector2(490, 399), Vector2(521, 405), Vector2(493, 371), Vector2(480, 349)), CYAN)
	path(Array(Vector2(480, 351), Vector2(480, 421)), CYAN)
	For i = 0 To (6 - 1)
		y = 358 + i * 12
		path(Array(Vector2(387, y), Vector2(396 + (i  Mod  2) * 8, y)), CYAN)
		path(Array(Vector2(564, y), Vector2(573, y)), CYAN)
	Next
	For i = 0 To (3 - 1)
		x = 652 + i * 25
		path(Array(Vector2(x, 351), Vector2(x + 15, 351), Vector2(x + 15, 422), Vector2(x, 422), Vector2(x, 351)), CYAN)
		For j = 0 To (3 + i * 2 - 1)
			draw_rect(Rect2(x + 3, 416 - j * 5, 9, 3), CYAN)
		Next
	Next
	For i = 0 To (4 - 1)
		path(Array(Vector2(611, 353 + i * 10), Vector2(630 - (i  Mod  2) * 8, 353 + i * 10)), CYAN)
	Next
	' Low yoke grips leave all three instruments readable.
	plate(Array(Vector2(385, 420), Vector2(402, 425), Vector2(390, 468), Vector2(406, 480), Vector2(554, 480), Vector2(570, 468), Vector2(558, 425), Vector2(575, 420), Vector2(592, 477), Vector2(576, 497), Vector2(384, 497), Vector2(368, 477)))
	For Each side In AsArray(Array(-1.0, 1.0))
		arc(Vector2(480 + side * 94, 421), Vector2(14, 7), 0, 6.283185307179586, PINK, 1.6)
		For rib = 0 To (3 - 1)
			path(Array(Vector2(480 + side * 105, 426 + rib * 4), Vector2(480 + side * 85, 431 + rib * 4)), PINK)
		Next
	Next
	plate(Array(Vector2(450, 436), Vector2(510, 436), Vector2(538, 507), Vector2(422, 507)))
	For rib = 0 To (4 - 1)
		path(Array(Vector2(449 - rib * 4, 445 + rib * 12), Vector2(511 + rib * 4, 445 + rib * 12)), PINK)
	Next
	plate(Array(Vector2(450, 511), Vector2(510, 511), Vector2(510, 540), Vector2(450, 540)))
End Sub
