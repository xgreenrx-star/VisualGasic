' Sound bus for the Backlight explorer and Black Channel: one-shot SFX pool,
' positional one-shots, attached 3D loops, vehicle/jetpack loops, footsteps and
' a two-deck music crossfade. Assets are generated by tools/audio/*.py.
' Buses: Music -> Master, SFX -> Master, Ambience -> SFX (3D loops; muted by silence()).
Const SFX_DIR = "res://assets/audio/sfx/"
Const MUSIC_DIR = "res://assets/audio/music/"
Const STRIDE = 1.7
Const MUSIC_DB = -6.0
Const SILENT_DB = -50.0
Const FADE_DB_PER_S = 18.0

Dim pool As Array
Dim pool_next As Integer
Dim cache As Dictionary
Dim deck As AudioStreamPlayer
Dim old_deck As AudioStreamPlayer
Dim motor As AudioStreamPlayer
Dim drive As AudioStreamPlayer
Dim jet As AudioStreamPlayer
Dim pool3d As Array
Dim pool3d_next As Integer
Dim drive_level As Single
Dim drive_last As Vector2
Dim drive_track As Boolean
Dim jet_level As Single
Dim listener_ok As Boolean
Dim music_name As String
Dim stride_left As Single
Dim last_pos As Vector2
Dim tracking As Boolean
Dim rng As RandomNumberGenerator
Dim ready_ok As Boolean

Sub setup()
	Dim p As AudioStreamPlayer
	Dim i As Integer
	Dim q As Object
	If ready_ok Then Exit Sub
	ensure_buses()
	cache = New Dictionary
	pool = Array()
	For i = 0 To 9
		p = ClassDB.Instantiate("AudioStreamPlayer")
		p.bus = "SFX"
		add_child(p)
		pool.append(p)
	Next
	pool3d = Array()
	For i = 0 To 5
		q = ClassDB.Instantiate("AudioStreamPlayer3D")
		q.bus = "SFX"
		q.unit_size = 8.0
		q.max_distance = 120.0
		add_child(q)
		pool3d.append(q)
	Next
	deck = ClassDB.Instantiate("AudioStreamPlayer")
	deck.bus = "Music"
	add_child(deck)
	old_deck = ClassDB.Instantiate("AudioStreamPlayer")
	old_deck.bus = "Music"
	add_child(old_deck)
	motor = ClassDB.Instantiate("AudioStreamPlayer")
	motor.bus = "SFX"
	add_child(motor)
	drive = ClassDB.Instantiate("AudioStreamPlayer")
	drive.bus = "SFX"
	add_child(drive)
	jet = ClassDB.Instantiate("AudioStreamPlayer")
	jet.bus = "SFX"
	add_child(jet)
	rng = ClassDB.Instantiate("RandomNumberGenerator")
	rng.randomize()
	music_name = ""
	stride_left = STRIDE * 0.5
	ready_ok = True
End Sub

Function bus_named(ByVal bus_name As String, ByVal send_to As String) As Integer
	Dim idx As Integer
	idx = AudioServer.get_bus_index(bus_name)
	If idx = -1 Then
		AudioServer.add_bus()
		idx = AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, bus_name)
		AudioServer.set_bus_send(idx, send_to)
	End If
	Return idx
End Function

Sub ensure_buses()
	bus_named("Music", "Master")
	bus_named("SFX", "Master")
	bus_named("Ambience", "SFX")
End Sub

Function linear_db(ByVal level As Single) As Single
	If level <= 0.001 Then Return -80.0
	Return 20.0 * Log(level) / Log(10.0)
End Function

' Options sliders: 0..1 linear levels for the Music and SFX buses.
Sub set_volumes(ByVal music_level As Single, ByVal sfx_level As Single)
	ensure_buses()
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Music"), linear_db(music_level))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("SFX"), linear_db(sfx_level))
End Sub

Function stream_for(ByVal path As String) As Object
	Dim s As Object
	If cache.has(path) Then Return cache(path)
	s = Nothing
	If FileExists(path) Then s = Load(path)
	cache(path) = s
	Return s
End Function

Sub fire(ByVal name As String, Optional ByVal vol_db As Single = 0.0, Optional ByVal pitch As Single = 1.0)
	Dim s As Object
	Dim p As AudioStreamPlayer
	If Not ready_ok Then Exit Sub
	s = stream_for(SFX_DIR & name & ".ogg")
	If s = Nothing Then Exit Sub
	p = pool(pool_next)
	pool_next = (pool_next + 1) Mod pool.size()
	p.stream = s
	p.volume_db = vol_db
	p.pitch_scale = pitch
	If is_inside_tree() Then p.play()
End Sub

Function loop_stream(ByVal snd As String) As Object
	Dim s As Object
	s = stream_for(SFX_DIR & snd & ".ogg")
	If s <> Nothing Then s.set("loop", True)
	Return s
End Function

' Positional one-shot (world position; the pool players have no Node3D parent).
Sub fire_at(ByVal snd As String, ByVal at As Vector3, Optional ByVal vol_db As Single = 0.0, Optional ByVal unit As Single = 8.0)
	Dim s As Object
	Dim q As Object
	If Not ready_ok Then Exit Sub
	s = stream_for(SFX_DIR & snd & ".ogg")
	If s = Nothing Then Exit Sub
	q = pool3d(pool3d_next)
	pool3d_next = (pool3d_next + 1) Mod pool3d.size()
	q.stream = s
	q.position = at
	q.volume_db = vol_db
	q.unit_size = unit
	q.pitch_scale = rng.randf_range(0.95, 1.05)
	If is_inside_tree() Then q.play()
End Sub

' Looping 3D emitter parented to a world node (train car, hologram, waterfall).
Function attach_loop(ByVal parent As Node, ByVal snd As String, ByVal vol_db As Single, ByVal unit As Single) As Object
	Dim s As Object
	Dim q As Object
	If Not ready_ok Then Return Nothing
	s = loop_stream(snd)
	If s = Nothing Then Return Nothing
	q = ClassDB.Instantiate("AudioStreamPlayer3D")
	q.name = "Snd_" & snd
	q.stream = s
	q.volume_db = vol_db
	q.unit_size = unit
	q.max_distance = unit * 14.0
	q.bus = "Ambience"
	q.autoplay = True
	parent.add_child(q)
	If q.is_inside_tree() Then q.play(rng.randf_range(0.0, 2.0))
	Return q
End Function

' Stops everything this explorer owns; called when it is deactivated.
Sub silence()
	If Not ready_ok Then Exit Sub
	deck.stop()
	old_deck.stop()
	music_name = ""
	motor.stop()
	drive.stop()
	jet.stop()
	drive_level = 0.0
	jet_level = 0.0
	drive_track = False
	tracking = False
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Ambience"), True)
End Sub

' Generic engine loop: level 0..1 fades the loop in/out, pitch follows load.
Sub hum(ByVal snd As String, ByVal level As Single, ByVal pitch As Single, ByVal delta As Single)
	Dim s As Object
	If Not ready_ok Then Exit Sub
	drive_level = drive_level + (level - drive_level) * Min(1.0, delta * 5.0)
	If drive_level < 0.02 And level <= 0.0 Then
		If drive.playing Then drive.stop()
		Exit Sub
	End If
	s = loop_stream(snd)
	If s = Nothing Then Exit Sub
	If drive.stream <> s Then
		drive.stream = s
		drive.stop()
	End If
	If Not drive.playing And is_inside_tree() Then drive.play()
	drive.volume_db = linear_db(drive_level) - 3.0
	drive.pitch_scale = Max(0.5, Min(2.0, pitch))
End Sub

Sub tick_jet(ByVal active As Boolean, ByVal delta As Single)
	Dim s As Object
	Dim target As Single
	If Not ready_ok Then Exit Sub
	target = 0.0
	If active Then target = 1.0
	jet_level = jet_level + (target - jet_level) * Min(1.0, delta * 8.0)
	If jet_level < 0.02 And Not active Then
		If jet.playing Then jet.stop()
		Exit Sub
	End If
	s = loop_stream("jetpack_loop")
	If s = Nothing Then Exit Sub
	If jet.stream <> s Then jet.stream = s
	If Not jet.playing And is_inside_tree() Then jet.play()
	jet.volume_db = linear_db(jet_level) - 4.0
End Sub

' Long lift-motor loop gets its own player so the doors/chime can overlap it.
Sub lift_motor(ByVal seconds As Single)
	Dim s As Object
	If Not ready_ok Then Exit Sub
	s = stream_for(SFX_DIR & "lift_motor.ogg")
	If s = Nothing Then Exit Sub
	motor.stream = s
	motor.volume_db = -4.0
	motor.pitch_scale = Max(0.75, Min(1.3, 4.2 / Max(seconds, 0.5)))
	If is_inside_tree() Then motor.play()
End Sub

Function surface_for(ByVal city As Node) As String
	If city.place = "building" Then Return "tile"
	If city.place = "floor" Then
		If city.floor_code = "88216" Then Return "concrete"
		Return "metal"
	End If
	Return "concrete"
End Function

Sub footstep(ByVal surface As String)
	fire("step_" & surface & "_" & Str(rng.randi_range(1, 4)), -9.0 + rng.randf_range(-1.5, 1.5), rng.randf_range(0.92, 1.08))
End Sub

Function music_for(ByVal city As Node) As String
	If city.completed Then Return ""
	If city.place = "lift" Then Return music_name
	If city.place = "floor" Then
		If city.floor_code = "88216" Then Return "undercity_dark"
		Return "stratum_deep"
	End If
	If city.trace_escape Or city.awakening Then Return "chase"
	Return "yard_dread"
End Function

Function city_driving(ByVal city As Node) As Boolean
	If city.place = "floor" Then
		If city.deep <> Nothing Then Return city.deep.driving()
		Return False
	End If
	Return city.driving
End Function

Sub tick_music(ByVal delta As Single)
	If Not ready_ok Then Exit Sub
	If deck.playing Then deck.volume_db = Min(MUSIC_DB, deck.volume_db + FADE_DB_PER_S * delta)
	If old_deck.playing Then
		old_deck.volume_db = old_deck.volume_db - FADE_DB_PER_S * delta
		If old_deck.volume_db <= SILENT_DB Then old_deck.stop()
	End If
End Sub

Sub set_music(ByVal track As String)
	Dim s As Object
	Dim spare As AudioStreamPlayer
	If Not ready_ok Then Exit Sub
	If track = music_name Then Exit Sub
	music_name = track
	spare = old_deck
	old_deck = deck
	deck = spare
	deck.stop()
	If track = "" Then Exit Sub
	s = stream_for(MUSIC_DIR & track & ".ogg")
	If s = Nothing Then Exit Sub
	s.set("loop", True)
	deck.stream = s
	deck.volume_db = SILENT_DB
	If is_inside_tree() Then deck.play()
End Sub

' Called once per frame from the explorer's tick.
Sub update(ByVal city As Node, ByVal delta As Single)
	Dim moved As Single
	Dim on_wheels As Boolean
	Dim speed As Single
	Dim amb As Integer
	If Not ready_ok Then Exit Sub
	If Not listener_ok And is_inside_tree() Then
		get_viewport().audio_listener_enable_3d = True
		listener_ok = True
	End If
	amb = AudioServer.get_bus_index("Ambience")
	If AudioServer.is_bus_mute(amb) Then AudioServer.set_bus_mute(amb, False)
	set_music(music_for(city))
	tick_music(delta)
	on_wheels = city_driving(city) And Not city.completed
	If on_wheels Then
		If Not drive_track Then
			drive_track = True
			drive_last = city.position_xz
		End If
		speed = city.position_xz.distance_to(drive_last) / Max(delta, 0.001)
		drive_last = city.position_xz
		If speed > 60.0 Then speed = 0.0
		hum("buggy_motor", 0.45 + 0.55 * Min(1.0, speed / 18.0), 0.6 + 0.9 * Min(1.0, speed / 20.0), delta)
	Else
		drive_track = False
		hum("buggy_motor", 0.0, 1.0, delta)
	End If
	If city.place = "floor" And city.deep <> Nothing Then
		tick_jet(city.deep.jet_active(), delta)
	Else
		tick_jet(False, delta)
	End If
	If on_wheels Or city.place = "lift" Then
		tracking = False
		Exit Sub
	End If
	If Not tracking Then
		tracking = True
		last_pos = city.position_xz
		Exit Sub
	End If
	moved = city.position_xz.distance_to(last_pos)
	last_pos = city.position_xz
	If moved > 3.0 Then Exit Sub
	stride_left = stride_left - moved
	If stride_left <= 0 Then
		stride_left = STRIDE
		footstep(surface_for(city))
	End If
End Sub
