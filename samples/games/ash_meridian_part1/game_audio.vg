' Sound bus for the Backlight explorer and Black Channel: one-shot SFX pool,
' positional one-shots, attached 3D loops, vehicle/jetpack loops, footsteps and
' a two-deck music crossfade. Assets are generated by tools/audio/*.py.
' Buses: Music -> Master, SFX -> Master, Ambience -> SFX (3D loops; muted by silence()),
' Echo -> SFX (reverb whose wet follows the location; vehicle layers and footsteps).
Const SFX_DIR = "res://assets/audio/sfx/"
Const MUSIC_DIR = "res://assets/audio/music/"
Const STRIDE = 1.7
Const MUSIC_DB = -6.0
Const SILENT_DB = -50.0
Const FADE_DB_PER_S = 18.0
Const VEH_TOP = 20.0

Dim pool As Array
Dim pool_next As Integer
Dim cache As Dictionary
Dim deck As AudioStreamPlayer
Dim old_deck As AudioStreamPlayer
Dim motor As AudioStreamPlayer
Dim drive As AudioStreamPlayer
Dim jet As AudioStreamPlayer
Dim pool3d As Array
Dim pool3d_next As Integer
Dim drive_level As Single
Dim drive_last As Vector2
Dim drive_track As Boolean
Dim jet_level As Single
Dim listener_ok As Boolean
Dim silenced As Boolean
Dim music_name As String
Dim stride_left As Single
Dim last_pos As Vector2
Dim tracking As Boolean
Dim rng As RandomNumberGenerator
Dim ready_ok As Boolean
' Vehicle mix: looping layers (idle, load, coast, tyre, skid) on the Echo bus plus one-shots.
Dim vplayers As Dictionary
Dim vlevels As Dictionary
Dim epool As Array
Dim epool_next As Integer
Dim veh_kind As String
Dim veh_detune As Single
Dim veh_speed As Single
Dim veh_smooth As Single
Dim veh_pitch As Single
Dim veh_braked As Boolean
Dim veh_cut As Single
Dim veh_jam As Single
Dim veh_heading As Single
Dim veh_last_y As Single
Dim veh_track_y As Boolean
Dim veh_clock As Single
Dim veh_echo As Single
Dim last_event As String
' Tests set these to 0/1 to stand in for the W/S keys; -1 reads the keyboard.
Dim force_accel As Integer
Dim force_brake As Integer

Function Num(ByVal value As Variant) As Single
	If value = Nothing Then
		Num = 0.0
	Else
		Num = value
	End If
End Function

Sub setup()
	Dim p As AudioStreamPlayer
	Dim i As Integer
	Dim q As Object
	If ready_ok Then Exit Sub
	ensure_buses()
	cache = New Dictionary
	pool = Array()
	For i = 0 To 9
		p = ClassDB.Instantiate("AudioStreamPlayer")
		p.bus = "SFX"
		add_child(p)
		pool.append(p)
	Next
	pool3d = Array()
	For i = 0 To 11
		q = ClassDB.Instantiate("AudioStreamPlayer3D")
		q.bus = "SFX"
		q.unit_size = 8.0
		q.max_distance = 120.0
		add_child(q)
		pool3d.append(q)
	Next
	deck = ClassDB.Instantiate("AudioStreamPlayer")
	deck.bus = "Music"
	deck.playback_type = 1
	add_child(deck)
	old_deck = ClassDB.Instantiate("AudioStreamPlayer")
	old_deck.bus = "Music"
	old_deck.playback_type = 1
	add_child(old_deck)
	motor = ClassDB.Instantiate("AudioStreamPlayer")
	motor.bus = "SFX"
	add_child(motor)
	drive = ClassDB.Instantiate("AudioStreamPlayer")
	drive.bus = "SFX"
	add_child(drive)
	jet = ClassDB.Instantiate("AudioStreamPlayer")
	jet.bus = "SFX"
	add_child(jet)
	vplayers = New Dictionary
	vlevels = New Dictionary
	For Each role In Array("idle", "load", "coast", "tyre", "skid")
		p = ClassDB.Instantiate("AudioStreamPlayer")
		p.bus = "Echo"
		add_child(p)
		vplayers(role) = p
		vlevels(role) = 0.0
	Next
	epool = Array()
	For i = 0 To 7
		p = ClassDB.Instantiate("AudioStreamPlayer")
		p.bus = "Echo"
		add_child(p)
		epool.append(p)
	Next
	veh_kind = ""
	veh_detune = 1.0
	veh_pitch = 1.0
	force_accel = -1
	force_brake = -1
	last_event = ""
	rng = ClassDB.Instantiate("RandomNumberGenerator")
	rng.randomize()
	music_name = ""
	stride_left = STRIDE * 0.5
	ready_ok = True
End Sub

Function bus_named(ByVal bus_name As String, ByVal send_to As String) As Integer
	Dim idx As Integer
	idx = AudioServer.get_bus_index(bus_name)
	If idx = -1 Then
		AudioServer.add_bus()
		idx = AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, bus_name)
		AudioServer.set_bus_send(idx, send_to)
	End If
	Return idx
End Function

Sub ensure_buses()
	bus_named("Music", "Master")
	bus_named("SFX", "Master")
	bus_named("Ambience", "SFX")
	ensure_echo()
End Sub

Sub ensure_echo()
	Dim idx As Integer
	Dim rv As Object
	idx = bus_named("Echo", "SFX")
	If AudioServer.get_bus_effect_count(idx) > 0 Then Exit Sub
	rv = ClassDB.Instantiate("AudioEffectReverb")
	rv.room_size = 0.75
	rv.damping = 0.35
	rv.predelay_msec = 20.0
	rv.spread = 0.8
	rv.wet = 0.0
	rv.dry = 1.0
	AudioServer.add_bus_effect(idx, rv, 0)
End Sub

Function echo_reverb() As Object
	Dim idx As Integer
	idx = AudioServer.get_bus_index("Echo")
	If idx = -1 Then Return Nothing
	If AudioServer.get_bus_effect_count(idx) = 0 Then Return Nothing
	Return AudioServer.get_bus_effect(idx, 0)
End Function

Function linear_db(ByVal level As Single) As Single
	If level <= 0.001 Then Return -80.0
	Return 20.0 * Log(level) / Log(10.0)
End Function

' Options sliders: 0..1 linear levels for the Music and SFX buses.
Sub set_volumes(ByVal music_level As Single, ByVal sfx_level As Single)
	ensure_buses()
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Music"), linear_db(music_level))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("SFX"), linear_db(sfx_level))
End Sub

Function stream_for(ByVal path As String) As Object
	Dim s As Object
	If cache.has(path) Then Return cache(path)
	s = Nothing
	If FileExists(path) Then s = Load(path)
	cache(path) = s
	Return s
End Function

' First idle player at or after start (round robin); steals start only when every voice is busy.
Function free_voice(ByVal list As Array, ByVal start As Integer) As Integer
	Dim n As Integer
	Dim k As Integer
	n = list.size()
	For i = 0 To n - 1
		k = (start + i) Mod n
		If Not list(k).playing Then Return k
	Next
	Return start
End Function

Sub fire(ByVal name As String, Optional ByVal vol_db As Single = 0.0, Optional ByVal pitch As Single = 1.0)
	Dim s As Object
	Dim p As AudioStreamPlayer
	If Not ready_ok Then Exit Sub
	s = stream_for(SFX_DIR & name & ".ogg")
	If s = Nothing Then Exit Sub
	pool_next = free_voice(pool, pool_next)
	p = pool(pool_next)
	pool_next = (pool_next + 1) Mod pool.size()
	p.stream = s
	p.volume_db = vol_db
	p.pitch_scale = pitch
	If is_inside_tree() Then p.play()
End Sub

Function loop_stream(ByVal snd As String) As Object
	Dim s As Object
	s = stream_for(SFX_DIR & snd & ".ogg")
	If s <> Nothing Then s.set("loop", True)
	Return s
End Function

' One-shot on the Echo bus (vehicle events, footsteps) so it picks up the room's reverb.
Sub vfire(ByVal snd As String, Optional ByVal vol_db As Single = 0.0, Optional ByVal pitch As Single = 1.0)
	Dim s As Object
	Dim p As AudioStreamPlayer
	If Not ready_ok Then Exit Sub
	last_event = snd
	s = stream_for(SFX_DIR & snd & ".ogg")
	If s = Nothing Then Exit Sub
	epool_next = free_voice(epool, epool_next)
	p = epool(epool_next)
	epool_next = (epool_next + 1) Mod epool.size()
	p.stream = s
	p.volume_db = vol_db
	p.pitch_scale = pitch
	If is_inside_tree() Then p.play()
End Sub

' Positional one-shot (world position; the pool players have no Node3D parent).
Sub fire_at(ByVal snd As String, ByVal at As Vector3, Optional ByVal vol_db As Single = 0.0, Optional ByVal unit As Single = 8.0)
	Dim s As Object
	Dim q As Object
	If Not ready_ok Then Exit Sub
	s = stream_for(SFX_DIR & snd & ".ogg")
	If s = Nothing Then Exit Sub
	pool3d_next = free_voice(pool3d, pool3d_next)
	q = pool3d(pool3d_next)
	pool3d_next = (pool3d_next + 1) Mod pool3d.size()
	q.stream = s
	q.position = at
	q.volume_db = vol_db
	q.unit_size = unit
	q.pitch_scale = rng.randf_range(0.95, 1.05)
	If is_inside_tree() Then q.play()
End Sub

' Looping 3D emitter parented to a world node (train car, hologram, waterfall).
Function attach_loop(ByVal parent As Node, ByVal snd As String, ByVal vol_db As Single, ByVal unit As Single) As Object
	Dim s As Object
	Dim q As Object
	If Not ready_ok Then Return Nothing
	s = loop_stream(snd)
	If s = Nothing Then Return Nothing
	q = ClassDB.Instantiate("AudioStreamPlayer3D")
	q.name = "Snd_" & snd
	q.stream = s
	q.volume_db = vol_db
	q.unit_size = unit
	q.max_distance = unit * 14.0
	q.playback_type = 1
	q.doppler_tracking = 0
	q.bus = "Ambience"
	q.autoplay = True
	parent.add_child(q)
	If q.is_inside_tree() Then q.play(rng.randf_range(0.0, 2.0))
	Return q
End Function

' Stops everything this explorer owns; called when it is deactivated.
Sub silence()
	If Not ready_ok Then Exit Sub
	If silenced Then Exit Sub
	silenced = True
	deck.stop()
	old_deck.stop()
	music_name = ""
	motor.stop()
	drive.stop()
	jet.stop()
	For Each role In vplayers.keys()
		vplayers(role).stop()
		vlevels(role) = 0.0
	Next
	veh_kind = ""
	veh_track_y = False
	drive_level = 0.0
	jet_level = 0.0
	drive_track = False
	tracking = False
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Ambience"), True)
End Sub

' Generic engine loop: level 0..1 fades the loop in/out, pitch follows load.
Sub hum(ByVal snd As String, ByVal level As Single, ByVal pitch As Single, ByVal delta As Single)
	Dim s As Object
	If Not ready_ok Then Exit Sub
	drive_level = drive_level + (level - drive_level) * Min(1.0, delta * 5.0)
	If drive_level < 0.02 And level <= 0.0 Then
		If drive.playing Then drive.stop()
		Exit Sub
	End If
	s = loop_stream(snd)
	If s = Nothing Then Exit Sub
	If drive.stream <> s Then
		drive.stream = s
		drive.stop()
	End If
	If Not drive.playing And is_inside_tree() Then drive.play()
	drive.volume_db = linear_db(drive_level) - 3.0
	drive.pitch_scale = Max(0.5, Min(2.0, pitch))
End Sub

Sub tick_jet(ByVal active As Boolean, ByVal delta As Single)
	Dim s As Object
	Dim target As Single
	If Not ready_ok Then Exit Sub
	target = 0.0
	If active Then target = 1.0
	jet_level = jet_level + (target - jet_level) * Min(1.0, delta * 8.0)
	If jet_level < 0.02 And Not active Then
		If jet.playing Then jet.stop()
		Exit Sub
	End If
	s = loop_stream("jetpack_loop")
	If s = Nothing Then Exit Sub
	If jet.stream <> s Then jet.stream = s
	If Not jet.playing And is_inside_tree() Then jet.play()
	jet.volume_db = linear_db(jet_level) - 4.0
End Sub

' Long lift-motor loop gets its own player so the doors/chime can overlap it.
Sub lift_motor(ByVal seconds As Single)
	Dim s As Object
	If Not ready_ok Then Exit Sub
	s = stream_for(SFX_DIR & "lift_motor.ogg")
	If s = Nothing Then Exit Sub
	motor.stream = s
	motor.volume_db = -4.0
	motor.pitch_scale = Max(0.75, Min(1.3, 4.2 / Max(seconds, 0.5)))
	If is_inside_tree() Then motor.play()
End Sub

Function surface_for(ByVal city As Node) As String
	If city.place = "building" Then Return "tile"
	If city.place = "floor" Then
		If city.floor_code = "88216" Then Return "concrete"
		Return "metal"
	End If
	Return "concrete"
End Function

Sub footstep(ByVal surface As String)
	vfire("step_" & surface & "_" & Str(rng.randi_range(1, 4)), -9.0 + rng.randf_range(-1.5, 1.5), rng.randf_range(0.92, 1.08))
End Sub

Function music_for(ByVal city As Node) As String
	If city.completed Then Return ""
	If city.place = "lift" Then Return music_name
	If city.place = "floor" Then
		If city.floor_code = "88216" Then Return "undercity_dark"
		Return "stratum_deep"
	End If
	If city.trace_escape Or city.awakening Then Return "chase"
	Return "yard_dread"
End Function

Function city_driving(ByVal city As Node) As Boolean
	If city.place = "floor" Then
		If city.deep <> Nothing Then Return city.deep.driving()
		Return False
	End If
	Return city.driving
End Function

Sub tick_music(ByVal delta As Single)
	If Not ready_ok Then Exit Sub
	If deck.playing Then deck.volume_db = Min(MUSIC_DB, deck.volume_db + FADE_DB_PER_S * delta)
	If old_deck.playing Then
		old_deck.volume_db = old_deck.volume_db - FADE_DB_PER_S * delta
		If old_deck.volume_db <= SILENT_DB Then old_deck.stop()
	End If
End Sub

Sub set_music(ByVal track As String)
	Dim s As Object
	Dim spare As AudioStreamPlayer
	If Not ready_ok Then Exit Sub
	If track = music_name Then
		If track <> "" And is_inside_tree() And Not deck.playing Then deck.play()
		Exit Sub
	End If
	s = Nothing
	If track <> "" Then
		s = stream_for(MUSIC_DIR & track & ".ogg")
		If s = Nothing Then Exit Sub
		s.set("loop", True)
	End If
	music_name = track
	spare = old_deck
	old_deck = deck
	deck = spare
	deck.stop()
	If track = "" Then Exit Sub
	deck.stream = s
	deck.volume_db = SILENT_DB
	deck.playback_type = 1
	If is_inside_tree() Then deck.play()
End Sub

' --- Vehicle layer -------------------------------------------------------------------------

' Electric drive whine: climbs with speed, with a stepped "gear change" dip at half speed.
Function motor_pitch(ByVal s As Single) As Single
	If s < 0.5 Then Return 0.7 + 1.1 * s
	Return 0.95 + 1.2 * (s - 0.5)
End Function

' Dropouts per second while under load: old motor, worse when the shield (hull) is hurt.
Function stutter_rate(ByVal kind As String, ByVal health As Single, ByVal clean As Boolean) As Single
	Dim r As Single
	r = 0.05
	If kind = "car" Then r = 0.015
	r = r + 0.3 * Max(0.0, 1.0 - health / 100.0)
	If clean Then r = r * 0.25
	Return r
End Function

' 0..1 squeal from lateral load (turn rate x speed).
Function skid_amount(ByVal yaw As Single, ByVal speed As Single) As Single
	Return Max(0.0, Min(1.0, (Abs(yaw) * speed - 12.0) / 10.0))
End Function

Function tyre_loop(ByVal ground As String) As String
	If ground = "gravel" Then Return "tyre_gravel"
	If ground = "hollow" Then Return "tyre_hollow"
	Return "tyre_smooth"
End Function

Function id_detune(ByVal id As String) As Single
	Dim h As Integer
	h = 0
	For i = 1 To Len(id)
		h = h + Asc(Mid(id, i, 1)) * i
	Next
	Return 0.86 + 0.18 * Num(h Mod 97) / 96.0
End Function

Sub set_layer(ByVal role As String, ByVal snd As String, ByVal target As Single, ByVal pitch As Single, ByVal gain_db As Single, ByVal delta As Single)
	Dim p As AudioStreamPlayer
	Dim lv As Single
	Dim s As Object
	p = vplayers(role)
	lv = Num(vlevels(role))
	lv = lv + (target - lv) * Min(1.0, delta * 6.0)
	vlevels(role) = lv
	If lv < 0.015 And target <= 0.0 Then
		If p.playing Then p.stop()
		Exit Sub
	End If
	If snd = "" Then
		p.volume_db = linear_db(lv) + gain_db
		Exit Sub
	End If
	s = loop_stream(snd)
	If s = Nothing Then Exit Sub
	If p.stream <> s Then
		p.stream = s
		p.stop()
	End If
	If Not p.playing And is_inside_tree() Then p.play(rng.randf_range(0.0, 1.0))
	p.volume_db = linear_db(lv) + gain_db
	p.pitch_scale = Max(0.3, Min(3.0, pitch))
End Sub

' Turret lock bleeding into the drive electronics.
Sub interference()
	If Not ready_ok Or veh_kind = "" Then Exit Sub
	veh_jam = 0.9
	vfire("motor_interference", -5.0, rng.randf_range(0.95, 1.05))
End Sub

' Vertical jolt (kerb, step, landing) of the given height in metres.
Sub bump(ByVal height As Single)
	If Not ready_ok Or veh_kind = "" Then Exit Sub
	vfire("buggy_thump", Min(0.0, -12.0 + height * 10.0), rng.randf_range(0.9, 1.1) * veh_detune)
End Sub

' One frame of the vehicle mix. kind is "" (on foot), "buggy" or "car".
Sub tick_vehicle(ByVal kind As String, ByVal speed As Single, ByVal accel As Boolean, ByVal braking As Boolean, ByVal yaw As Single, ByVal ground As String, ByVal health As Single, ByVal clean As Boolean, ByVal delta As Single)
	Dim s As Single
	Dim fall_rate As Single
	Dim pitch As Single
	Dim idle_t As Single
	Dim load_t As Single
	Dim coast_t As Single
	Dim tyre_t As Single
	Dim skid_t As Single
	Dim motor_snd As String
	Dim idle_snd As String
	If Not ready_ok Then Exit Sub
	If kind <> veh_kind Then
		If veh_kind = "buggy" Then vfire("vehicle_off", -4.0)
		If veh_kind = "car" Then vfire("car_off", -5.0, veh_detune)
		veh_kind = kind
		veh_speed = 0.0
		veh_smooth = 0.0
		veh_braked = True
		veh_cut = 0.0
		veh_jam = 0.0
	End If
	If kind = "" Then
		For Each role In vplayers.keys()
			set_layer(role, "", 0.0, 1.0, -4.0, delta)
		Next
		Exit Sub
	End If
	veh_clock = veh_clock + delta
	fall_rate = (veh_speed - speed) / Max(delta, 0.001)
	If accel And veh_speed > 6.0 And speed < veh_speed * 0.35 Then
		vfire("buggy_thump", -2.0, rng.randf_range(0.85, 1.0) * veh_detune)
		If kind = "buggy" Then vfire("hull_hit", -14.0, 1.3)
	ElseIf Not veh_braked And veh_speed > 4.0 And (braking Or (Not accel And fall_rate > 15.0)) Then
		vfire("regen_brake", -5.0, veh_detune)
		veh_braked = True
	End If
	If accel And speed > 2.0 And Not braking Then veh_braked = False
	veh_speed = speed
	veh_smooth = veh_smooth + (speed - veh_smooth) * Min(1.0, delta * 6.0)
	s = Min(1.0, veh_smooth / VEH_TOP)
	pitch = motor_pitch(s)
	veh_pitch = veh_pitch + Max(-3.0 * delta, Min(3.0 * delta, pitch - veh_pitch))
	pitch = veh_pitch * veh_detune
	idle_t = 0.55 * (1.0 - Min(1.0, s * 4.0)) + 0.08
	load_t = 0.0
	coast_t = 0.0
	If accel Then
		load_t = 0.4 + 0.6 * s
	ElseIf s > 0.03 Then
		coast_t = 0.25 + 0.45 * s
	End If
	If veh_cut > 0.0 Then
		veh_cut = veh_cut - delta
		load_t = load_t * 0.08
		coast_t = coast_t * 0.3
		pitch = pitch * 0.86
	ElseIf accel And s > 0.1 Then
		If rng.randf() < stutter_rate(kind, health, clean) * delta Then
			veh_cut = rng.randf_range(0.15, 0.45)
			vfire("motor_pop", -6.0, rng.randf_range(0.9, 1.1))
		End If
	End If
	If veh_jam > 0.0 Then
		veh_jam = veh_jam - delta
		pitch = pitch * (1.0 + 0.06 * Sin(veh_clock * 41.0))
		load_t = load_t * rng.randf_range(0.4, 1.0)
	End If
	tyre_t = Min(1.0, s * 1.5)
	skid_t = skid_amount(yaw, veh_smooth)
	If ground = "gravel" Then
		skid_t = skid_t * 0.6
		If s > 0.3 And rng.randf() < delta * 1.6 * s Then vfire("buggy_knock", -13.0 + rng.randf_range(-2.0, 2.0), rng.randf_range(0.8, 1.2))
	End If
	motor_snd = "buggy_motor"
	idle_snd = "buggy_idle"
	If kind = "car" Then
		motor_snd = "car_motor"
		idle_snd = "car_idle"
	End If
	set_layer("idle", idle_snd, idle_t, veh_detune, -6.0, delta)
	set_layer("load", motor_snd, load_t, pitch, -3.0, delta)
	set_layer("coast", "buggy_coast", coast_t, pitch * 0.98, -4.0, delta)
	If ground = "gravel" Then
		set_layer("tyre", "tyre_gravel", tyre_t, 0.85 + 0.4 * s, 0.0, delta)
	Else
		set_layer("tyre", tyre_loop(ground), tyre_t, 0.8 + 0.5 * s, -6.0, delta)
	End If
	set_layer("skid", "tyre_skid", skid_t, 0.9 + 0.2 * s, -6.0, delta)
End Sub

' Reverb wet for where the player is: open yard dry, cavern and tunnels wet.
Function echo_for(ByVal city As Node) As Single
	Dim g As String
	If city.place = "building" Then Return 0.12
	If city.place = "lift" Then Return 0.05
	If city.place = "floor" Then
		If city.floor_code <> "88216" Then Return 0.22
		g = ""
		If city.deep <> Nothing Then g = city.deep.ground_sound(city)
		If g = "tunnel" Then Return 0.5
		Return 0.3
	End If
	Return 0.0
End Function

Sub set_echo(ByVal target As Single, ByVal delta As Single)
	Dim rv As Object
	Dim before As Single
	before = veh_echo
	veh_echo = veh_echo + (target - veh_echo) * Min(1.0, delta * 2.0)
	If Abs(veh_echo - before) < 0.002 And Abs(veh_echo - target) > 0.002 Then Exit Sub
	rv = echo_reverb()
	If rv = Nothing Then Exit Sub
	rv.wet = veh_echo
	rv.dry = 1.0 - 0.3 * veh_echo
End Sub

Function key_down(ByVal a As Integer, ByVal b As Integer) As Boolean
	Return Input.is_physical_key_pressed(a) Or Input.is_key_pressed(a) Or Input.is_key_pressed(b)
End Function

Sub update_vehicle(ByVal city As Node, ByVal on_wheels As Boolean, ByVal speed As Single, ByVal delta As Single)
	Dim kind As String
	Dim accel As Boolean
	Dim braking As Boolean
	Dim rev_key As Boolean
	Dim yaw As Single
	Dim ground As String
	Dim clean As Boolean
	Dim y As Single
	kind = ""
	If on_wheels Then
		kind = "buggy"
		If city.place = "floor" Then kind = "car"
	End If
	If kind = "" Then
		veh_track_y = False
		tick_vehicle("", 0.0, False, False, 0.0, "", 100.0, True, delta)
		Exit Sub
	End If
	If kind <> veh_kind Then
		veh_heading = city.heading
		veh_detune = 1.0
		If kind = "car" And city.deep <> Nothing Then veh_detune = id_detune(city.deep.car_id)
		If kind = "car" Then vfire("car_start", -4.0, veh_detune)
	End If
	accel = key_down(KEY_W, KEY_UP)
	rev_key = key_down(KEY_S, KEY_DOWN)
	If force_accel >= 0 Then accel = (force_accel = 1)
	If force_brake >= 0 Then rev_key = (force_brake = 1)
	braking = False
	If kind = "buggy" Then braking = rev_key And Num(city.velocity) > 3.0
	yaw = city.heading - veh_heading
	yaw = Atan2(Sin(yaw), Cos(yaw)) / Max(delta, 0.001)
	veh_heading = city.heading
	ground = "gravel"
	clean = True
	If kind = "car" Then
		ground = "smooth"
		If city.deep <> Nothing Then
			ground = city.deep.ground_sound(city)
			y = city.deep.foot(city)
			If veh_track_y And Abs(y - veh_last_y) > 0.35 Then bump(Abs(y - veh_last_y))
			veh_last_y = y
			veh_track_y = True
		End If
	ElseIf city.deep <> Nothing Then
		clean = city.deep.has_item(city, "buggy_boost")
	Else
		clean = False
	End If
	tick_vehicle(kind, speed, accel, braking, yaw, ground, Num(city.shield), clean, delta)
End Sub

' Called once per frame from the explorer's tick.
Sub update(ByVal city As Node, ByVal delta As Single)
	Dim moved As Single
	Dim on_wheels As Boolean
	Dim speed As Single
	Dim amb As Integer
	If Not ready_ok Then Exit Sub
	silenced = False
	If Not listener_ok And is_inside_tree() Then
		get_viewport().audio_listener_enable_2d = True
		get_viewport().audio_listener_enable_3d = True
		listener_ok = True
	End If
	amb = AudioServer.get_bus_index("Ambience")
	If AudioServer.is_bus_mute(amb) Then AudioServer.set_bus_mute(amb, False)
	set_music(music_for(city))
	tick_music(delta)
	on_wheels = city_driving(city) And Not city.completed
	If on_wheels Then
		If Not drive_track Then
			drive_track = True
			drive_last = city.position_xz
		End If
		speed = city.position_xz.distance_to(drive_last) / Max(delta, 0.001)
		drive_last = city.position_xz
		If speed > 60.0 Then speed = 0.0
	Else
		drive_track = False
	End If
	update_vehicle(city, on_wheels, speed, delta)
	set_echo(echo_for(city), delta)
	If city.place = "floor" And city.deep <> Nothing Then
		tick_jet(city.deep.jet_active(), delta)
	Else
		tick_jet(False, delta)
	End If
	If on_wheels Or city.place = "lift" Then
		tracking = False
		Exit Sub
	End If
	If Not tracking Then
		tracking = True
		last_pos = city.position_xz
		Exit Sub
	End If
	moved = city.position_xz.distance_to(last_pos)
	last_pos = city.position_xz
	If moved > 3.0 Then Exit Sub
	stride_left = stride_left - moved
	If stride_left <= 0 Then
		stride_left = STRIDE
		footstep(surface_for(city))
	End If
End Sub
