Sub _solid(ByVal city As Node, ByVal r As Rect2, ByVal y0 As Single, ByVal top As Single, ByVal color As Color, Optional lit As Variant = False)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("r") = r
	entry("y0") = y0
	entry("top") = top
	solids.append(entry)
	If drawing Then city._box(Vector3(r.position.x, y0, r.position.y), Vector3(r.size.x, top - y0, r.size.y), color, lit)
End Sub

Sub _wallr(ByVal city As Node, ByVal r As Rect2, ByVal color As Color)
	_solid(city, r, 0.0, lv_h, color)
End Sub

Sub _deco(ByVal city As Node, ByVal p As Vector3, ByVal size As Vector3, ByVal color As Color, Optional lit As Variant = False)
	If drawing Then city._box(p, size, color, lit)
End Sub

Sub _line3(ByVal city As Node, ByVal a As Vector3, ByVal b As Vector3, ByVal width As Single, ByVal color As Color, Optional lit As Variant = True)
	If drawing Then city._bar(a, b, width, color, lit)
End Sub

Sub _anchor(ByVal key As String, ByVal p As Vector2, ByVal facing As Single, Optional y As Variant = 0.0)
	anchors(key) = Array(p, facing, Num(y))
End Sub

Sub _zone(ByVal r As Rect2, ByVal rad As Single, ByVal slow As Single, ByVal y1 As Single)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("r") = r
	entry("rad") = rad
	entry("slow") = slow
	entry("y1") = y1
	zones.append(entry)
End Sub

Sub _portal(ByVal r As Rect2, ByVal dest As String, ByVal key As String, ByVal gate_id As String, ByVal label As String)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("r") = r
	entry("dest") = dest
	entry("anchor") = key
	entry("gate") = gate_id
	entry("label") = label
	portals.append(entry)
End Sub

Sub _pickup(ByVal code As String, ByVal id As String, ByVal p As Vector3)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("key") = code & ":" & Str(pickups.size())
	entry("item") = id
	entry("p") = p
	entry("node") = Nothing
	pickups.append(entry)
End Sub

Sub _gate(ByVal code As String, ByVal r As Rect2, ByVal grade As Integer, ByVal y0 As Single, ByVal top As Single)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("id") = code & ":G" & Str(gates.size())
	entry("r") = r
	entry("grade") = grade
	entry("y0") = y0
	entry("top") = top
	entry("node") = Nothing
	gates.append(entry)
End Sub

Function _last_gate() As String
	Return gates(gates.size() - 1)("id")
End Function

Sub _hazard(ByVal kind As String, ByVal r As Rect2, ByVal y0 As Single, ByVal y1 As Single, ByVal period As Single, ByVal duty As Single, ByVal phase As Single, ByVal dmg As Integer)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("kind") = kind
	entry("r") = r
	entry("y0") = y0
	entry("y1") = y1
	entry("period") = period
	entry("duty") = duty
	entry("phase") = phase
	entry("dmg") = dmg
	entry("node") = Nothing
	hazards.append(entry)
End Sub

Sub _console(ByVal city As Node, ByVal p As Vector2, ByVal text As String, ByVal reveal As Array)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("p") = p
	entry("text") = text
	entry("reveal") = reveal
	consoles.append(entry)
	_solid(city, Rect2(p.x - 0.9, p.y - 0.5, 1.8, 1.0), 0.0, 1.05, city.INK)
	_deco(city, Vector3(p.x - 0.75, 1.06, p.y - 0.4), Vector3(1.5, 0.03, 0.8), city.ICE * 0.55, True)
	_deco(city, Vector3(p.x - 0.75, 1.05, p.y - 0.52), Vector3(1.5, 0.6, 0.04), city.ICE * 0.2, True)
End Sub

Sub _flip(ByVal r As Rect2)
	flips.append(r)
End Sub

Sub _weak(ByVal r As Rect2, ByVal dest As String, ByVal key As String)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("r") = r
	entry("dest") = dest
	entry("anchor") = key
	entry("node") = Nothing
	weak.append(entry)
End Sub

' Stroke glyph alphabet shared with the HUD; strokes are drawn as lit bars in 3D.
Sub glyph3(ByVal city As Node, ByVal origin As Vector3, ByVal right As Vector3, ByVal digit As Integer, ByVal scale As Single, ByVal color As Color)
	Dim patterns As Array
	Dim paths As Array
	Dim pts As Array
	Dim down As Vector3
	Dim a As Vector3
	Dim b As Vector3
	If Not drawing Then Exit Sub
	patterns = Array(15, 21, 38, 56, 41, 26, 52, 35, 29, 51)
	paths = Array(Array(Vector2(0, 0), Vector2(7, 6), Vector2(14, 0)), Array(Vector2(0, 18), Vector2(7, 12), Vector2(14, 18)), Array(Vector2(0, 2), Vector2(0, 16)), Array(Vector2(14, 2), Vector2(14, 16)), Array(Vector2(3, 9), Vector2(11, 9)), Array(Vector2(7, -3), Vector2(7, 21)))
	down = Vector3(0, -1, 0)
	For i = 0 To paths.size() - 1
		If patterns(digit) And (1 << i) Then
			pts = paths(i)
			For j = 0 To pts.size() - 2
				a = origin + right * (pts(j).x * scale) + down * (pts(j).y * scale)
				b = origin + right * (pts(j + 1).x * scale) + down * (pts(j + 1).y * scale)
				city._bar(a, b, 1.7 * scale, color, True)
			Next
		End If
	Next
End Sub

Sub glyph3_string(ByVal city As Node, ByVal origin As Vector3, ByVal right As Vector3, ByVal text As String, ByVal scale As Single, ByVal color As Color)
	For i = 0 To text.length() - 1
		glyph3(city, origin + right * (i * 23 * scale), right, Int(text.substr(i, 1)), scale, color)
	Next
End Sub

Sub draw_glyphs(ByVal city As Node, ByVal origin As Vector3, ByVal right As Vector3, ByVal text As String, ByVal scale As Single, ByVal color As Color)
	Dim was As Boolean
	Call EnsureInit()
	was = drawing
	drawing = True
	glyph3_string(city, origin, right, text, scale, color)
	drawing = was
End Sub

' A wall plaque in Narcean glyphs. The English only exists in Orac's visor translation.
Sub _sign(ByVal city As Node, ByVal p As Vector3, ByVal normal As Vector3, ByVal digits As String, ByVal translation As String)
	Dim entry As Dictionary
	Dim right As Vector3
	Dim width As Single
	Dim face As Vector3
	entry = New Dictionary
	entry("p") = p
	entry("n") = normal
	entry("text") = translation
	signs.append(entry)
	If Not drawing Then Exit Sub
	right = normal.cross(Vector3.UP)
	width = digits.length() * 23 * 0.022 + 0.3
	face = p + normal * 0.06
	If Abs(normal.z) > 0.5 Then
		city._box(Vector3(p.x - width * 0.5, p.y - 0.35, p.z - 0.04), Vector3(width, 0.7, 0.08), city.INK)
	Else
		city._box(Vector3(p.x - 0.04, p.y - 0.35, p.z - width * 0.5), Vector3(0.08, 0.7, width), city.INK)
	End If
	glyph3_string(city, face - right * (width * 0.5 - 0.15) + Vector3(0, 0.2, 0), right, digits, 0.022, city.GOLD)
End Sub

Sub _console_data(ByVal p As Vector2, ByVal text As String, ByVal reveal As Array)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("p") = p
	entry("text") = text
	entry("reveal") = reveal
	consoles.append(entry)
End Sub

Sub _frame(ByVal city As Node, ByVal code As String, ByVal w As Single, ByVal l As Single, ByVal h As Single, ByVal floor_color As Color, ByVal wall_color As Color, ByVal draw_floor As Boolean)
	Dim hw As Single
	lv_w = w
	lv_l = l
	lv_h = h
	hw = w * 0.5
	areas.append(Rect2(-hw, 0, w, l))
	areas.append(Rect2(-3, -7.2, 6, 7.5))
	If draw_floor Then _deco(city, Vector3(-hw, -0.3, 0), Vector3(w, 0.3, l), floor_color)
	_deco(city, Vector3(-hw, h, 0), Vector3(w, 0.3, l), city.INK)
	_deco(city, Vector3(-hw - 0.4, 0, 0), Vector3(0.4, h, l), wall_color)
	_deco(city, Vector3(hw, 0, 0), Vector3(0.4, h, l), wall_color)
	_deco(city, Vector3(-hw, 0, l), Vector3(w, h, 0.4), wall_color)
	_solid(city, Rect2(-hw, 0, hw - 2, 0.3), 0.0, h, wall_color)
	_solid(city, Rect2(2, 0, hw - 2, 0.3), 0.0, h, wall_color)
	_deco(city, Vector3(-2, 4.55, 0), Vector3(4, h - 4.55, 0.3), wall_color)
	For z = 6 To Int(l) - 2 Step 10
		_deco(city, Vector3(-3, h - 0.06, z), Vector3(6, 0.05, 0.4), city.ICE * 0.6, True)
	Next
	_alcove(city, code)
End Sub

' The lift car is the alcove behind the front wall: the doors open onto the floor beyond.
Sub _alcove(ByVal city As Node, ByVal code As String)
	Dim depth As Integer
	Dim right As Vector3
	_deco(city, Vector3(-3.2, -0.2, -7.4), Vector3(6.4, 0.2, 7.4), city.SHELL * 0.8)
	_deco(city, Vector3(-3.2, 5.2, -7.4), Vector3(6.4, 0.2, 7.4), city.INK)
	_deco(city, Vector3(-3.2, 0, -7.4), Vector3(0.2, 5.2, 7.4), city.SHELL)
	_deco(city, Vector3(3.0, 0, -7.4), Vector3(0.2, 5.2, 7.4), city.SHELL)
	_deco(city, Vector3(-3.2, 0, -7.4), Vector3(6.4, 5.2, 0.2), city.SHELL * 0.9)
	_deco(city, Vector3(-3.0, 4.55, -0.12), Vector3(6.0, 0.65, 0.12), city.SHELL)
	_deco(city, Vector3(-3.0, 0, -0.12), Vector3(0.9, 4.55, 0.12), city.SHELL)
	_deco(city, Vector3(2.1, 0, -0.12), Vector3(0.9, 4.55, 0.12), city.SHELL)
	_deco(city, Vector3(-1.4, 5.15, -5.5), Vector3(2.8, 0.04, 3.6), city.ICE * 0.55, True)
	For Each x In Array(-2.95, 2.9)
		_line3(city, Vector3(x, 1.0, -6.8), Vector3(x, 1.0, -0.6), 0.05, city.GOLD * 0.8)
	Next
	_deco(city, Vector3(2.86, 0.95, -3.3), Vector3(0.12, 1.35, 0.75), city.INK)
	For k = 0 To 5
		_deco(city, Vector3(2.83, 1.1 + (k Mod 3) * 0.36, -3.18 + Int(k / 3) * 0.36), Vector3(0.04, 0.18, 0.18), city.GOLD * 0.9, True)
	Next
	_deco(city, Vector3(2.83, 2.05, -3.18), Vector3(0.04, 0.12, 0.54), city.ICE * 0.8, True)
	_deco(city, Vector3(-1.55, 4.6, -0.16), Vector3(3.1, 0.52, 0.04), city.INK)
	right = Vector3(1, 0, 0)
	If LEVELS.has(code) Then
		depth = LEVELS(code)(1)
		glyph3_string(city, Vector3(-1.4, 5.0, -0.18), right, PadInt(depth, 2), 0.016, city.GOLD)
		glyph3_string(city, Vector3(-0.4, 5.0, -0.18), right, code, 0.016, city.ICE)
	End If
	_sign_data(Vector3(0, 4.85, -0.2), Vector3(0, 0, -1), "LIFT CAR / " & level_label(code))
	_anchor("lift", Vector2(0, -4.8), 0.0)
End Sub

Sub _sign_data(ByVal p As Vector3, ByVal normal As Vector3, ByVal translation As String)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("p") = p
	entry("n") = normal
	entry("text") = translation
	signs.append(entry)
End Sub

Sub _stairwell(ByVal city As Node, ByVal r As Rect2, ByVal descending As Boolean)
	Dim x0 As Single
	Dim z0 As Single
	Dim y As Single
	x0 = r.position.x
	z0 = r.position.y
	_deco(city, Vector3(x0, 0.0, z0), Vector3(r.size.x, 0.02, r.size.y), Color(0.004, 0.006, 0.01))
	For k = 0 To 5
		If descending Then
			y = 0.03 - k * 0.0
		Else
			y = 0.03
		End If
		_line3(city, Vector3(x0 + 0.2, y + (k * 0.0), z0 + 0.4 + k * 0.75), Vector3(x0 + r.size.x - 0.2, y, z0 + 0.4 + k * 0.75), 0.04, city.GOLD * (1.0 - k * 0.13))
	Next
	For Each x In Array(x0, x0 + r.size.x)
		_line3(city, Vector3(x, 1.0, z0), Vector3(x, 1.0, z0 + r.size.y), 0.05, city.ICE * 0.7)
		_deco(city, Vector3(x - 0.04, 0, z0), Vector3(0.08, 1.0, 0.08), city.SHELL)
	Next
	If Not descending Then
		_deco(city, Vector3(x0, 0, z0 + r.size.y - 0.3), Vector3(r.size.x, 3.4, 0.3), city.SHELL * 0.8)
		_deco(city, Vector3(x0 + 0.3, 0.05, z0 + r.size.y - 0.32), Vector3(r.size.x - 0.6, 3.0, 0.02), Color(0.004, 0.006, 0.01))
	End If
End Sub

Sub _layout(ByVal city As Node, ByVal code As String)
	_reset_layout()
	seed_rng = ClassDB.Instantiate("RandomNumberGenerator")
	seed_rng.seed = Int(code)
	If code = "14242" Then
		_layout_feb(city)
	ElseIf code = "31707" Then
		_layout_concourse(city)
	ElseIf code = "52914" Then
		_layout_warrens(city)
	ElseIf code = "66038" Then
		_layout_cistern(city)
	ElseIf code = "80451" Then
		_layout_vault(city)
	ElseIf code = "93162" Then
		_layout_fractured(city)
	ElseIf code = "40404" Then
		_layout_yellow(city)
	ElseIf code = "58120" Then
		_layout_archive(city)
	ElseIf code = "36912" Then
		_layout_garden(city)
	ElseIf code = "88216" Then
		_layout_undercity(city)
	Else
		_frame(city, code, 44, 56, 6, city.SHELL * 0.6, city.SHELL, True)
	End If
	_index_solids()
End Sub

' Solids bucketed into 8 m cells so collision stays cheap on the big floors.
Sub _index_solids()
	Dim r As Rect2
	Dim key As Integer
	Dim cell As Array
	grid = New Dictionary
	For Each s In AsArray(solids)
		r = s("r").grow(0.8)
		For cx = Int((r.position.x + 1000) / 8) To Int((r.end.x + 1000) / 8)
			For cz = Int((r.position.y + 1000) / 8) To Int((r.end.y + 1000) / 8)
				key = cx * 4096 + cz
				If Not grid.has(key) Then grid(key) = Array()
				cell = grid(key)
				cell.append(s)
			Next
		Next
	Next
End Sub

Function _near(ByVal p As Vector2) As Array
	Dim key As Integer
	key = Int((p.x + 1000) / 8) * 4096 + Int((p.y + 1000) / 8)
	If grid.has(key) Then Return grid(key)
	Return Array()
End Function

Sub ensure_layout(ByVal city As Node)
	Call EnsureInit()
	ensure_state(city)
	If city.place <> "floor" Then Exit Sub
	If built_code = city.floor_code Then Exit Sub
	drawing = False
	_layout(city, city.floor_code)
	built_code = city.floor_code
End Sub

' Static geometry is emitted into the controller's pending mesh; the builder finishes it.
Sub build_level(ByVal city As Node)
	Call EnsureInit()
	ensure_state(city)
	drawing = True
	_layout(city, city.floor_code)
	drawing = False
	built_code = city.floor_code
End Sub

' The original military chamber keeps its builder; Deep Stratum adds the car, stair and records.
Sub _layout_feb(ByVal city As Node)
	lv_w = 44
	lv_l = 56
	lv_h = 6
	areas.append(Rect2(-22, 0, 44, 56))
	areas.append(Rect2(-3, -7.2, 6, 7.5))
	_alcove(city, "14242")
	_deco(city, Vector3(-2, 4.55, 0), Vector3(4, 1.45, 0.3), city.SHELL)
	_stairwell(city, Rect2(-21.5, 50, 4, 5), True)
	_portal(Rect2(-21.3, 50.4, 3.6, 4.4), "31707", "stair", "", "STAIR DOWN")
	_anchor("stair", Vector2(-19, 48.2), PI)
	_console_data(Vector2(0, 26.6), "TRANSLATED: GARRISON TRANSIT INDEX / SURFACE ASCENT 70315 / MAINTENANCE CONCOURSE 31707", Array("70315", "31707"))
	_sign(city, Vector3(-19.5, 2.6, 55.55), Vector3(0, 0, -1), "05", "STAIR - MAINTENANCE CONCOURSE")
	_sign(city, Vector3(0, 2.8, 0.36), Vector3(0, 0, 1), "04", "MILITARY CHAMBER / ISOLATION CROWN")
End Sub

Sub _layout_concourse(ByVal city As Node)
	Dim amber As Color
	amber = Color(1.0, 0.55, 0.12)
	_frame(city, "31707", 60, 80, 8, city.SHELL * 0.55, city.SHELL, True)
	For Each x In Array(-8.0, 8.0)
		For z = 8 To 68 Step 12
			_solid(city, Rect2(x - 0.5, z - 0.5, 1, 1), 0.0, 8.0, city.SHELL * 0.8)
			_deco(city, Vector3(x - 0.52, 3.0, z - 0.52), Vector3(1.04, 0.12, 1.04), amber * 0.7, True)
		Next
	Next
	has_derelict = True
	derelict = Rect2(9, 16, 6, 8)
	_deco(city, Vector3(9, 0, 16), Vector3(6, 0.25, 8), city.INK)
	_console_data(Vector2(12, 20), "ORAC: A Trace Cycle, Jason. Cold for centuries; the drive lattice is fused. Someone parked it here and never came back. Ours is still docked in the Backlight Yard.", Array())
	_pickup("31707", "rad_meter", Vector3(-14, 0, 30))
	_deco(city, Vector3(-14.5, 0, 29.5), Vector3(1, 0.5, 1), city.INK)
	_zone(Rect2(16, 50, 10, 10), 2.0, 1.0, 99.0)
	For k = 0 To 3
		_line3(city, Vector3(16 + k * 0.0, 0.03, 50 + k * 3.3), Vector3(26, 0.03, 50 + k * 3.3), 0.06, amber * 0.8)
	Next
	For Each p In Array(Vector2(18, 53), Vector2(22, 57), Vector2(24, 52))
		_solid(city, Rect2(p.x - 0.5, p.y - 0.5, 1, 1), 0.0, 1.3, Color(0.3, 0.25, 0.05))
		_deco(city, Vector3(p.x - 0.52, 0.9, p.y - 0.52), Vector3(1.04, 0.08, 1.04), Color(0.4, 1.0, 0.2), True)
	Next
	_sign(city, Vector3(15.9, 2.4, 55), Vector3(-1, 0, 0), "717", "COOLANT LEAK - ISOLATED")
	_wallr(city, Rect2(18, 62, 0.4, 4), city.SHELL)
	_wallr(city, Rect2(18, 69, 0.4, 5), city.SHELL)
	_wallr(city, Rect2(18, 62, 12, 0.4), city.SHELL)
	_wallr(city, Rect2(18, 74, 12, 0.4), city.SHELL)
	_deco(city, Vector3(18, 3.2, 66), Vector3(0.4, 4.8, 3), city.SHELL)
	_gate("31707", Rect2(18, 66, 0.4, 3), 1, 0.0, 3.2)
	_sign(city, Vector3(17.75, 3.7, 67.5), Vector3(-1, 0, 0), "331", "STORES - SEALED")
	_pickup("31707", "gold_bar", Vector3(24, 0.8, 70))
	_solid(city, Rect2(23.4, 69.4, 1.2, 1.2), 0.0, 0.8, city.INK)
	_pickup("31707", "med_gel", Vector3(26, 0.8, 64))
	_solid(city, Rect2(25.4, 63.4, 1.2, 1.2), 0.0, 0.8, city.INK)
	_weak(Rect2(-6, 44, 4, 4), "52914", "weak")
	_stairwell(city, Rect2(-29, 22, 5, 5), True)
	_portal(Rect2(-28.8, 22.4, 4.4, 4.2), "52914", "escalator", "", "ESCALATOR DOWN")
	_anchor("escalator", Vector2(-21, 24.5), PI * 0.5)
	_sign(city, Vector3(-29.75, 2.6, 24.5), Vector3(1, 0, 0), "06", "DOWN - SERVICE WARRENS")
	_solid(city, Rect2(22, 30, 7, 10), 4.2, 4.5, city.SHELL * 0.7)
	For Each p In Array(Vector2(22, 30), Vector2(28.7, 30), Vector2(22, 39.7), Vector2(28.7, 39.7))
		_solid(city, Rect2(p.x, p.y, 0.3, 0.3), 0.0, 4.2, city.SHELL)
	Next
	_line3(city, Vector3(22, 5.5, 30), Vector3(22, 5.5, 40), 0.05, amber)
	_line3(city, Vector3(22, 5.5, 30), Vector3(29, 5.5, 30), 0.05, amber)
	For k = 0 To 8
		_solid(city, Rect2(23, 40 + k * 0.8, 5, 0.8), 0.0, 4.05 - k * 0.45, city.SHELL * (0.6 + (k Mod 2) * 0.1))
		_line3(city, Vector3(23, 4.07 - k * 0.45, 40 + k * 0.8), Vector3(28, 4.07 - k * 0.45, 40 + k * 0.8), 0.03, amber * 0.8)
	Next
	_pickup("31707", "star_chart", Vector3(26, 4.5, 34))
	_console(city, Vector2(0, 60), "TRANSLATED: CONCOURSE TRANSIT INDEX / SERVICE WARRENS 52914 / CISTERN 66038", Array("52914", "66038"))
	_stairwell(city, Rect2(-29, 74, 4, 5), False)
	_portal(Rect2(-28.8, 74.4, 3.6, 4.2), "14242", "stair", "", "STAIR UP")
	_anchor("stair", Vector2(-27, 71.5), PI)
	_sign(city, Vector3(-27, 3.8, 79.55), Vector3(0, 0, -1), "04", "UP - MILITARY CHAMBER")
	_sign(city, Vector3(0, 3.2, 0.36), Vector3(0, 0, 1), "05", "MAINTENANCE CONCOURSE")
End Sub

Function _cell_x(ByVal c As Integer) As Single
	Return -27.0 + c * 6.0
End Function

Function _cell_z(ByVal r As Integer) As Single
	Return r * 6.0
End Function

' Bit 1 east (+x), 2 west (-x), 4 south (+z), 8 north (-z).
Function _openings(ByVal open_e As Array, ByVal open_s As Array, ByVal c As Integer, ByVal r As Integer) As Integer
	Dim bits As Integer
	bits = 0
	If c < 8 Then
		If open_e(r * 9 + c) Then bits = bits + 1
	End If
	If c > 0 Then
		If open_e(r * 9 + c - 1) Then bits = bits + 2
	End If
	If r < 10 Then
		If open_s(r * 9 + c) Then bits = bits + 4
	End If
	If r > 0 Then
		If open_s((r - 1) * 9 + c) Then bits = bits + 8
	End If
	Return bits
End Function

Function _bit_count(ByVal bits As Integer) As Integer
	Dim n As Integer
	n = 0
	For k = 0 To 3
		If bits And (1 << k) Then n = n + 1
	Next
	Return n
End Function

Function _dir_of(ByVal bits As Integer) As Vector2
	If bits And 1 Then Return Vector2(1, 0)
	If bits And 2 Then Return Vector2(-1, 0)
	If bits And 4 Then Return Vector2(0, 1)
	Return Vector2(0, -1)
End Function

Sub _layout_warrens(ByVal city As Node)
	Dim open_e As Array
	Dim open_s As Array
	Dim seen As Array
	Dim trail As Array
	Dim options As Array
	Dim cur As Integer
	Dim c As Integer
	Dim r As Integer
	Dim nxt As Integer
	Dim dist As Array
	Dim queue As Array
	Dim head As Integer
	Dim bits As Integer
	Dim dead As Array
	Dim best As Integer
	Dim held_cell As Integer
	Dim center As Vector2
	Dim dir As Vector2
	Dim x0 As Single
	Dim z0 As Single
	Dim moss As Color
	Dim gate_r As Rect2
	Dim kinds As Array
	Dim placed As Integer
	Dim id As String
	moss = Color(0.25, 0.9, 0.3)
	_frame(city, "52914", 54, 66, 5.4, city.SHELL * 0.45, city.SHELL * 0.75, True)
	open_e = Array()
	open_s = Array()
	seen = Array()
	For k = 0 To 98
		open_e.append(False)
		open_s.append(False)
		seen.append(False)
	Next
	trail = Array(4)
	seen(4) = True
	While trail.size() > 0
		cur = trail(trail.size() - 1)
		c = cur Mod 9
		r = Int(cur / 9)
		options = Array()
		If c < 8 Then
			If Not seen(cur + 1) Then options.append(cur + 1)
		End If
		If c > 0 Then
			If Not seen(cur - 1) Then options.append(cur - 1)
		End If
		If r < 10 Then
			If Not seen(cur + 9) Then options.append(cur + 9)
		End If
		If r > 0 Then
			If Not seen(cur - 9) Then options.append(cur - 9)
		End If
		If options.size() = 0 Then
			trail.remove_at(trail.size() - 1)
		Else
			nxt = options(seed_rng.randi_range(0, options.size() - 1))
			If nxt = cur + 1 Then open_e(cur) = True
			If nxt = cur - 1 Then open_e(nxt) = True
			If nxt = cur + 9 Then open_s(cur) = True
			If nxt = cur - 9 Then open_s(nxt) = True
			seen(nxt) = True
			trail.append(nxt)
		End If
	Wend
	For r = 0 To 10
		For c = 0 To 8
			x0 = _cell_x(c)
			z0 = _cell_z(r)
			If c < 8 Then
				If Not open_e(r * 9 + c) Then _wallr(city, Rect2(x0 + 5.8, z0 - 0.2, 0.4, 6.4), city.SHELL * 0.75)
			End If
			If r < 10 Then
				If Not open_s(r * 9 + c) Then _wallr(city, Rect2(x0 - 0.2, z0 + 5.8, 6.4, 0.4), city.SHELL * 0.75)
			End If
			If seed_rng.randf() < 0.35 Then
				For k = 0 To 2
					_line3(city, Vector3(x0 + 1 + seed_rng.randf() * 4, 5.4, z0 + 1 + seed_rng.randf() * 4), Vector3(x0 + 1 + seed_rng.randf() * 4, 3.6 + seed_rng.randf() * 1.2, z0 + 1 + seed_rng.randf() * 4), 0.05, moss * (0.4 + seed_rng.randf() * 0.4))
				Next
			End If
		Next
	Next
	dist = Array()
	For k = 0 To 98
		dist.append(-1)
	Next
	dist(4) = 0
	queue = Array(4)
	head = 0
	While head < queue.size()
		cur = queue(head)
		head = head + 1
		c = cur Mod 9
		r = Int(cur / 9)
		bits = _openings(open_e, open_s, c, r)
		For Each pair In Array(Array(1, 1), Array(2, -1), Array(4, 9), Array(8, -9))
			If bits And pair(0) Then
				nxt = cur + pair(1)
				If dist(nxt) < 0 Then
					dist(nxt) = dist(cur) + 1
					queue.append(nxt)
				End If
			End If
		Next
	Wend
	dead = Array()
	For k = 0 To 98
		If k <> 4 And k <> 56 Then
			If _bit_count(_openings(open_e, open_s, k Mod 9, Int(k / 9))) = 1 Then dead.append(k)
		End If
	Next
	For a = 0 To dead.size() - 2
		best = a
		For b = a + 1 To dead.size() - 1
			If dist(dead(b)) > dist(dead(best)) Then best = b
		Next
		held_cell = dead(a)
		dead(a) = dead(best)
		dead(best) = held_cell
	Next
	For rank = 0 To dead.size() - 1
		cur = dead(rank)
		c = cur Mod 9
		r = Int(cur / 9)
		x0 = _cell_x(c)
		z0 = _cell_z(r)
		center = Vector2(x0 + 3, z0 + 3)
		dir = _dir_of(_openings(open_e, open_s, c, r))
		If dir.x > 0 Then
			gate_r = Rect2(x0 + 5.8, z0, 0.4, 6)
		ElseIf dir.x < 0 Then
			gate_r = Rect2(x0 - 0.2, z0, 0.4, 6)
		ElseIf dir.y > 0 Then
			gate_r = Rect2(x0, z0 + 5.8, 6, 0.4)
		Else
			gate_r = Rect2(x0, z0 - 0.2, 6, 0.4)
		End If
		If rank = 0 Then
			_pickup("52914", "psionic_screwdriver", Vector3(center.x - dir.x * 1.5, 0.8, center.y - dir.y * 1.5))
			_solid(city, Rect2(center.x - dir.x * 1.5 - 0.6, center.y - dir.y * 1.5 - 0.6, 1.2, 1.2), 0.0, 0.8, city.INK)
			_sign(city, Vector3(center.x - dir.x * 2.75, 2.4, center.y - dir.y * 2.75), Vector3(dir.x, 0, dir.y), "88", "TOOL LOCKER - TECHNICIAN USE")
		ElseIf rank = 1 Then
			_stairwell_cell(city, center, dir)
			_portal(Rect2(center.x - dir.x * 1.6 - 1.4, center.y - dir.y * 1.6 - 1.4, 2.8, 2.8), "31707", "escalator", "", "ESCALATOR UP")
			_anchor("escalator", center + dir * 1.6, Atan2(dir.x, dir.y))
			_sign(city, Vector3(center.x - dir.x * 2.75, 3.4, center.y - dir.y * 2.75), Vector3(dir.x, 0, dir.y), "05", "UP - MAINTENANCE CONCOURSE")
		ElseIf rank = 2 Then
			_console(city, center - dir * 1.4, "TRANSLATED: WARRENS DISPATCH / INVERTED VAULT 80451 / GRAVITY INVERSION IN USE", Array("80451"))
		ElseIf rank = 3 Then
			_gate("52914", gate_r, 1, 0.0, 5.4)
			_pickup("52914", "buggy_armour", Vector3(center.x, 0.0, center.y))
		ElseIf rank = 4 Then
			_gate("52914", gate_r, 2, 0.0, 5.4)
			id = _last_gate()
			_lift_pad(city, center - dir * 1.4)
			_portal(Rect2(center.x - dir.x * 1.4 - 1.2, center.y - dir.y * 1.4 - 1.2, 2.4, 2.4), "66038", "lift2", id, "SERVICE LIFT")
			_anchor("lift2", center + dir * 1.2, Atan2(dir.x, dir.y))
			_sign(city, Vector3(center.x - dir.x * 2.75, 3.4, center.y - dir.y * 2.75), Vector3(dir.x, 0, dir.y), "07", "SERVICE LIFT - CISTERN")
		ElseIf rank < 9 Then
			If rank Mod 2 = 1 Then
				_pickup("52914", "med_gel", Vector3(center.x, 0.0, center.y))
			Else
				_pickup("52914", "anti_rad", Vector3(center.x, 0.0, center.y))
			End If
		End If
	Next
	_anchor("weak", Vector2(_cell_x(2) + 3, _cell_z(6) + 3), 0.0)
	kinds = Array("laser_low", "pulse", "crusher", "vent")
	placed = 0
	For k = 0 To 98
		c = k Mod 9
		r = Int(k / 9)
		bits = _openings(open_e, open_s, c, r)
		If r >= 2 And k <> 56 And placed < 10 And (k * 7 + 3) Mod 4 = 0 Then
			x0 = _cell_x(c)
			z0 = _cell_z(r)
			If bits = 3 Then
				_corridor_hazard(kinds(placed Mod 4), True, x0, z0, placed)
				placed = placed + 1
			ElseIf bits = 12 Then
				_corridor_hazard(kinds(placed Mod 4), False, x0, z0, placed)
				placed = placed + 1
			End If
		End If
	Next
	_sign(city, Vector3(0, 3.0, 0.36), Vector3(0, 0, 1), "06", "SERVICE WARRENS - MIND THE MACHINERY")
End Sub

Sub _corridor_hazard(ByVal kind As String, ByVal along_x As Boolean, ByVal x0 As Single, ByVal z0 As Single, ByVal index As Integer)
	Dim r As Rect2
	Dim span As Single
	If kind = "crusher" Or kind = "vent" Then
		span = 2.0
	Else
		span = 0.3
	End If
	If along_x Then
		r = Rect2(x0 + 3 - span * 0.5, z0 + 0.2, span, 5.6)
	Else
		r = Rect2(x0 + 0.2, z0 + 3 - span * 0.5, 5.6, span)
	End If
	If kind = "laser_low" Then
		_hazard(kind, r, 0.15, 0.6, 1.0, 1.0, 0.0, 12)
	ElseIf kind = "pulse" Then
		_hazard(kind, r, 0.0, 3.0, 2.4, 0.45, index * 0.37, 18)
	ElseIf kind = "crusher" Then
		_hazard(kind, r, 0.0, 5.4, 3.2, 0.3, index * 0.53, 30)
	Else
		_hazard(kind, r, 0.0, 2.6, 2.8, 0.4, index * 0.29, 10)
	End If
End Sub

Sub _stairwell_cell(ByVal city As Node, ByVal center As Vector2, ByVal dir As Vector2)
	Dim back As Vector2
	back = center - dir * 1.6
	_deco(city, Vector3(back.x - 1.4, 0.0, back.y - 1.4), Vector3(2.8, 0.02, 2.8), Color(0.004, 0.006, 0.01))
	For k = 0 To 3
		_line3(city, Vector3(back.x - 1.2, 0.03, back.y - 1.2 + k * 0.8), Vector3(back.x + 1.2, 0.03, back.y - 1.2 + k * 0.8), 0.04, city.GOLD * (1.0 - k * 0.15))
	Next
End Sub

Sub _lift_pad(ByVal city As Node, ByVal p As Vector2)
	_deco(city, Vector3(p.x - 1.2, 0.0, p.y - 1.2), Vector3(2.4, 0.05, 2.4), city.SHELL * 0.7)
	_line3(city, Vector3(p.x - 1.1, 0.07, p.y - 1.1), Vector3(p.x + 1.1, 0.07, p.y - 1.1), 0.05, city.ICE)
	_line3(city, Vector3(p.x - 1.1, 0.07, p.y + 1.1), Vector3(p.x + 1.1, 0.07, p.y + 1.1), 0.05, city.ICE)
	_line3(city, Vector3(p.x - 1.1, 0.07, p.y - 1.1), Vector3(p.x - 1.1, 0.07, p.y + 1.1), 0.05, city.ICE)
	_line3(city, Vector3(p.x + 1.1, 0.07, p.y - 1.1), Vector3(p.x + 1.1, 0.07, p.y + 1.1), 0.05, city.ICE)
	For Each q In Array(Vector2(-1.1, -1.1), Vector2(1.1, -1.1), Vector2(-1.1, 1.1), Vector2(1.1, 1.1))
		_line3(city, Vector3(p.x + q.x, 0, p.y + q.y), Vector3(p.x + q.x, 4.0, p.y + q.y), 0.06, city.ICE * 0.6)
	Next
End Sub

Sub _fall(ByVal city As Node, ByVal x0 As Single, ByVal x1 As Single, ByVal z As Single, ByVal top As Single, ByVal speed As Single, ByVal color As Color)
	Dim entry As Dictionary
	entry = New Dictionary
	entry("x0") = x0
	entry("x1") = x1
	entry("z") = z
	entry("top") = top
	entry("speed") = speed
	entry("color") = color
	entry("node") = Nothing
	falls.append(entry)
End Sub

Sub _plant(ByVal city As Node, ByVal p As Vector2, ByVal y As Single, ByVal size As Single)
	Dim leaf As Color
	Dim angle As Single
	leaf = Color(0.2, 0.85, 0.35)
	_deco(city, Vector3(p.x - 0.2, y, p.y - 0.2), Vector3(0.4, 0.35, 0.4), city.INK)
	For k = 0 To 5
		angle = k * 1.047 + p.x
		_line3(city, Vector3(p.x, y + 0.3, p.y), Vector3(p.x + Cos(angle) * size, y + 0.3 + size * (0.8 + (k Mod 2) * 0.5), p.y + Sin(angle) * size), 0.05, leaf * (0.5 + (k Mod 3) * 0.2))
	Next
End Sub

Sub _pad(ByVal city As Node, ByVal r As Rect2, ByVal y As Single)
	Dim c As Vector2
	c = r.get_center()
	_deco(city, Vector3(r.position.x, y, r.position.y), Vector3(r.size.x, 0.06, r.size.y), city.INK)
	For k = 0 To 2
		_line3(city, Vector3(c.x - r.size.x * (0.45 - k * 0.12), y + 0.08, c.y), Vector3(c.x + r.size.x * (0.45 - k * 0.12), y + 0.08, c.y), 0.05, Color(0.7, 0.3, 1.0))
		_line3(city, Vector3(c.x, y + 0.08, c.y - r.size.y * (0.45 - k * 0.12)), Vector3(c.x, y + 0.08, c.y + r.size.y * (0.45 - k * 0.12)), 0.05, Color(0.7, 0.3, 1.0))
	Next
End Sub

Sub _layout_cistern(ByVal city As Node)
	Dim water As Color
	water = Color(0.1, 0.6, 0.65)
	_frame(city, "66038", 56, 70, 14, city.SHELL * 0.5, city.SHELL * 0.7, True)
	_zone(Rect2(-10, 25, 20, 20), 6.0, 0.45, 0.3)
	_deco(city, Vector3(-10, 0.02, 25), Vector3(20, 0.03, 20), water * 0.35, True)
	For Each pair In Array(Array(Vector3(-10, 0.1, 25), Vector3(10, 0.1, 25)), Array(Vector3(-10, 0.1, 45), Vector3(10, 0.1, 45)), Array(Vector3(-10, 0.1, 25), Vector3(-10, 0.1, 45)), Array(Vector3(10, 0.1, 25), Vector3(10, 0.1, 45)))
		_line3(city, pair(0), pair(1), 0.08, water)
	Next
	_deco(city, Vector3(-6.5, 12.5, 25), Vector3(5, 1.5, 0.8), city.SHELL)
	_fall(city, -6.0, -2.0, 25.5, 12.5, 6.0, water)
	_fall(city, 4.0, 5.5, 44.6, 14.0, 5.0, water)
	For Each p In Array(Vector2(-12, 24), Vector2(12, 27), Vector2(12, 43), Vector2(-12, 40), Vector2(-14, 32), Vector2(14, 35), Vector2(-4, 47), Vector2(6, 48))
		_plant(city, p, 0.0, 0.9)
	Next
	_solid(city, Rect2(-9, 44, 2, 2), 0.0, 0.8, city.SHELL * 0.7)
	_solid(city, Rect2(-12.5, 47.5, 2, 2), 0.0, 1.6, city.SHELL * 0.7)
	_solid(city, Rect2(-28, 50, 18, 20), 0.0, 2.4, city.SHELL * 0.6)
	_line3(city, Vector3(-10, 2.45, 50), Vector3(-10, 2.45, 70), 0.05, city.GOLD * 0.7)
	_line3(city, Vector3(-28, 2.45, 50), Vector3(-10, 2.45, 50), 0.05, city.GOLD * 0.7)
	For Each p In Array(Vector2(-14, 53), Vector2(-12, 67), Vector2(-17, 60))
		_plant(city, p, 2.4, 1.1)
	Next
	_solid(city, Rect2(-20, 58, 0.4, 4), 2.4, 6.4, city.SHELL)
	_solid(city, Rect2(-20, 65, 0.4, 5), 2.4, 6.4, city.SHELL)
	_solid(city, Rect2(-28, 58, 8, 0.4), 2.4, 6.4, city.SHELL)
	_deco(city, Vector3(-28, 6.4, 58), Vector3(8.4, 0.2, 12), city.INK)
	_gate("66038", Rect2(-20, 62, 0.4, 3), 2, 2.4, 5.6)
	_deco(city, Vector3(-20, 5.6, 62), Vector3(0.4, 0.8, 3), city.SHELL)
	_sign(city, Vector3(-19.75, 6.0, 63.5), Vector3(1, 0, 0), "331", "ARCHIVE - SEALED")
	_pickup("66038", "ship_scanner", Vector3(-25, 2.4, 66))
	_pickup("66038", "narcean_relic", Vector3(-25, 2.4, 61))
	_pad(city, Rect2(-23.5, 6.5, 3, 3), 0.0)
	_portal(Rect2(-23.3, 6.7, 2.6, 2.6), "66038", "island", "", "TRANSIT PAD")
	_anchor("shore", Vector2(-22, 11.5), 0.0)
	_sign(city, Vector3(-27.75, 2.6, 8), Vector3(1, 0, 0), "16", "TRANSIT PAD - ISLAND")
	_solid(city, Rect2(16, 46, 12, 0.4), 0.0, 3.0, city.SHELL * 0.8)
	_solid(city, Rect2(16, 46, 0.4, 12), 0.0, 3.0, city.SHELL * 0.8)
	_solid(city, Rect2(16, 57.6, 12, 0.4), 0.0, 3.0, city.SHELL * 0.8)
	_pad(city, Rect2(20.5, 47.5, 3, 3), 0.0)
	_portal(Rect2(20.7, 47.7, 2.6, 2.6), "66038", "shore", "", "TRANSIT PAD")
	_anchor("island", Vector2(22, 52), PI)
	_console(city, Vector2(24, 55.5), "TRANSLATED: RESERVOIR CONTROL / FRACTURED DEEP 93162 / ACCESS RESTRICTED", Array("93162"))
