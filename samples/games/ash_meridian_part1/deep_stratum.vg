Function Num(ByVal value As Variant) As Single
	If value = True Then
		Num = 1.0
	ElseIf value = False Then
		Num = 0.0
	Else
		Num = value
	End If
End Function

Function FPosMod(ByVal value As Single, ByVal modulus As Single) As Single
	Dim wrapped As Single
	wrapped = value - modulus * Int(value / modulus)
	If wrapped < 0 Then wrapped = wrapped + modulus
	FPosMod = wrapped
End Function

Function FMod(ByVal value As Single, ByVal modulus As Single) As Single
	FMod = value - modulus * Int(value / modulus)
End Function

Function CeilInt(ByVal value As Single) As Integer
	Dim floored As Integer
	floored = Int(value)
	If value > floored Then
		CeilInt = floored + 1
	Else
		CeilInt = floored
	End If
End Function

Function RoundInt(ByVal value As Single) As Integer
	If value >= 0 Then
		RoundInt = Int(value + 0.5)
	Else
		RoundInt = Int(value - 0.5)
	End If
End Function

Function PadInt(ByVal value As Integer, ByVal width As Integer) As String
	Dim text As String
	If value < 0 Then value = 0
	text = Str(value)
	While Len(text) < width
		text = "0" & text
	Wend
	PadInt = text
End Function

Function AngleDifference(ByVal from_angle As Single, ByVal to_angle As Single) As Single
	Dim diff As Single
	diff = FPosMod(to_angle - from_angle, 6.283185307179586)
	If diff > 3.141592653589793 Then diff = diff - 6.283185307179586
	AngleDifference = diff
End Function

Function RotateToward(ByVal from_angle As Single, ByVal to_angle As Single, ByVal amount As Single) As Single
	Dim diff As Single
	diff = AngleDifference(from_angle, to_angle)
	If diff > amount Then diff = amount
	If diff < 0 - amount Then diff = 0 - amount
	RotateToward = from_angle + diff
End Function

Function DictFlag(ByVal table As Dictionary, ByVal code As Integer) As Boolean
	If table.Has(code) Then
		DictFlag = table(code)
	Else
		DictFlag = False
	End If
End Function

Function VecLess(ByVal a As Vector3, ByVal b As Vector3) As Boolean
	If a.x <> b.x Then
		VecLess = a.x < b.x
	ElseIf a.y <> b.y Then
		VecLess = a.y < b.y
	Else
		VecLess = a.z < b.z
	End If
End Function

Function SpawnVg(ByVal path As String, ByVal type_name As String) As Object
	Dim node As Object
	Dim script As Object
	node = ClassDB.Instantiate(type_name)
	script = Load(path)
	node.SetScript(script)
	SpawnVg = node
End Function

Function PackVec2(ByVal items As Array) As PackedVector2Array
	PackVec2 = PackedVector2Array(items)
End Function

Function PackVec3(ByVal items As Array) As PackedVector3Array
	PackVec3 = PackedVector3Array(items)
End Function

Function PackColor(ByVal items As Array) As PackedColorArray
	PackColor = PackedColorArray(items)
End Function

Function PackByte(ByVal items As Array) As PackedByteArray
	PackByte = PackedByteArray(items)
End Function

Function Sign(ByVal value As Single) As Single
	If value > 0 Then
		Sign = 1
	ElseIf value < 0 Then
		Sign = -1
	Else
		Sign = 0
	End If
End Function

Function AsArray(ByVal items As Variant) As Array
	Dim out As Array
	Dim i As Integer
	Dim n As Integer
	out = Array()
	If items = Nothing Then
		AsArray = out
		Exit Function
	End If
	' vbString = 8. Digit bars iterate "bc" as characters. String subscript is not an array.
	If VarType(items) = 8 Then
		n = Len(items)
		If n > 0 Then
			For i = 1 To n
				out.append(Mid(items, i, 1))
			Next
		End If
		AsArray = out
		Exit Function
	End If
	' GDScript `for x in N` walks 0..N-1. vbLong=3, vbDouble=5, vbInteger=2, vbSingle=4.
	If VarType(items) = 2 Or VarType(items) = 3 Or VarType(items) = 4 Or VarType(items) = 5 Then
		n = Int(items)
		If n > 0 Then
			For i = 0 To n - 1
				out.append(i)
			Next
		End If
		AsArray = out
		Exit Function
	End If
	For i = 0 To items.size() - 1
		out.append(items(i))
	Next
	AsArray = out
End Function


Sub EnsureInit()
	If __ready Then Exit Sub
	__ready = True
	ASCENT = "70315"
	ITEMS = New Dictionary
	ITEMS("psionic_screwdriver") = Array("PSIONIC SCREWDRIVER", 400, "Orac's name for a Narcean lock-coupling kit. F at a sealed door to hack it.")
	ITEMS("rad_meter") = Array("RAD METER", 120, "Suit dosimeter. Shows radiation and lets Orac warn you.")
	ITEMS("jetpack") = Array("JETPACK", 2500, "Hold Space in the air to thrust. Recharges on the ground.")
	ITEMS("med_gel") = Array("MED GEL", 60, "Enter: seal the suit and restore 40 integrity.")
	ITEMS("anti_rad") = Array("ANTI-RAD", 80, "Enter: purge 60 units of absorbed radiation.")
	ITEMS("gold_bar") = Array("GOLD BAR", 1000, "Narcean bullion. Heavy, inert and very portable.")
	ITEMS("core_gem") = Array("CORE GEM", 1800, "A lattice crystal that still hums with stored light.")
	ITEMS("narcean_relic") = Array("NARCEAN RELIC", 1400, "A ceremonial interface plate. Orac cannot read all of it.")
	ITEMS("star_chart") = Array("STAR CHART", 900, "Etched navigation plate. Some routes are not in our records.")
	ITEMS("buggy_armour") = Array("BUGGY ARMOUR", 700, "Ablative plating. Turret hits on the buggy are reduced.")
	ITEMS("buggy_boost") = Array("BUGGY BOOST", 650, "Injector kit. Raises the buggy's top speed.")
	ITEMS("ship_scanner") = Array("SHIP SCANNER", 1200, "Long-range scanner module for the Ash.")
	ITEMS("ship_shield") = Array("SHIP SHIELD", 1600, "Deflector emitter for the Ash.")
	LEVELS = New Dictionary
	LEVELS("14242") = Array("B04 - MILITARY CHAMBER", 4)
	LEVELS("31707") = Array("B05 - MAINTENANCE CONCOURSE", 5)
	LEVELS("52914") = Array("B06 - SERVICE WARRENS", 6)
	LEVELS("66038") = Array("B07 - CISTERN", 7)
	LEVELS("80451") = Array("B08 - INVERTED VAULT", 8)
	LEVELS("93162") = Array("B09 - FRACTURED DEEP", 9)
	LEVELS("40404") = Array("B10 - YELLOW ROOMS", 10)
	LEVELS("58120") = Array("B11 - ARCHIVE OFFICES", 11)
	LEVELS("36912") = Array("B12 - VERDANT GALLERY", 12)
	LEVELS("88216") = Array("B13 - UNDERCITY TRANSIT", 13)
	ORDER = Array("14242", "31707", "52914", "66038", "80451", "93162", "40404", "58120", "36912", "88216")
	term_open = False
	term_id = ""
	term_input = ""
	term_log = Array()
	car_id = ""
	grid_power = False
	ad_shader = Nothing
	built_code = ""
	drawing = False
	hum_stream = Nothing
	anchors = New Dictionary
	areas = Array()
	solids = Array()
	pits = Array()
	zones = Array()
	portals = Array()
	pickups = Array()
	gates = Array()
	hazards = Array()
	consoles = Array()
	signs = Array()
	flips = Array()
	weak = Array()
	falls = Array()
	hack_target = Array()
	portal_armed = True
	flip_armed = True
	door_timer = 10.0
	grounded = True
End Sub

Function is_level(ByVal code As String) As Boolean
	Call EnsureInit()
	Return LEVELS.has(code)
End Function

Function is_deep(ByVal code As String) As Boolean
	Call EnsureInit()
	Return LEVELS.has(code) And code <> "14242"
End Function

Function level_label(ByVal code As String) As String
	Call EnsureInit()
	If code = ASCENT Then Return "B00 - TRANSIT DEPOT / SURFACE"
	If LEVELS.has(code) Then Return LEVELS(code)(0)
	Return "ADDRESS NOT IN SERVICE"
End Function

Function item_name(ByVal id As String) As String
	Call EnsureInit()
	If ITEMS.has(id) Then Return ITEMS(id)(0)
	Return id
End Function

Function item_text(ByVal id As String) As String
	Call EnsureInit()
	If ITEMS.has(id) Then Return ITEMS(id)(2)
	Return ""
End Function

' Resale appraisal is deliberately hidden from the player until the station chapter.
Function pack_value(ByVal city As Node) As Integer
	Dim total As Integer
	Call EnsureInit()
	total = 0
	For Each id In AsArray(city.pack.keys())
		If ITEMS.has(id) Then total = total + Int(ITEMS(id)(1)) * Int(city.pack(id))
	Next
	Return total
End Function

Function has_item(ByVal city As Node, ByVal id As String) As Boolean
	If Not city.pack.has(id) Then Return False
	Return Int(city.pack(id)) > 0
End Function

Sub ensure_state(ByVal city As Node)
	Dim st As Dictionary
	Call EnsureInit()
	If city.pack Is Nothing Then city.pack = New Dictionary
	If city.stratum Is Nothing Then city.stratum = New Dictionary
	st = city.stratum
	If Not st.has("codes") Then st("codes") = New Dictionary
	If Not st.has("taken") Then st("taken") = New Dictionary
	If Not st.has("hacked") Then st("hacked") = New Dictionary
	If Not st.has("collapsed") Then st("collapsed") = False
	If Not st.has("inverted") Then st("inverted") = False
	If Not st.has("rad_warned") Then st("rad_warned") = 0
	If Not st.has("jet_fuel") Then st("jet_fuel") = 1.0
	If Not st.has("foot_y") Then st("foot_y") = 0.0
	If Not st.has("powered") Then st("powered") = False
	If Not st.has("levers") Then st("levers") = New Dictionary
	grid_power = st("powered") = True
End Sub

Sub reset_state(ByVal city As Node)
	Call EnsureInit()
	city.pack = New Dictionary
	city.stratum = New Dictionary
	city.radiation = 0.0
	ensure_state(city)
	built_code = ""
	hacking = False
	inv_open = False
	recall_open = False
	vel_y = 0.0
	fade = 0.0
End Sub

Sub learn(ByVal city As Node, ByVal code As String)
	Call EnsureInit()
	ensure_state(city)
	city.stratum("codes")(code) = True
End Sub

Function knows(ByVal city As Node, ByVal code As String) As Boolean
	Call EnsureInit()
	ensure_state(city)
	Return city.stratum("codes").has(code)
End Function

Function known_codes(ByVal city As Node) As Array
	Dim out As Array
	Call EnsureInit()
	ensure_state(city)
	out = Array()
	If knows(city, ASCENT) Then out.append(ASCENT)
	For Each code In AsArray(ORDER)
		If knows(city, code) Then out.append(code)
	Next
	Return out
End Function

Function foot(ByVal city As Node) As Single
	Return Num(city.stratum("foot_y"))
End Function

Function inverted(ByVal city As Node) As Boolean
	If city.stratum Is Nothing Then Return False
	If Not city.stratum.has("inverted") Then Return False
	Return city.stratum("inverted") = True
End Function

Function eye_height(ByVal city As Node) As Single
	If inverted(city) Then Return foot(city) - 1.8
	If car_id <> "" Then Return foot(city) + 1.3
	Return foot(city) + 1.8
End Function

Function in_alcove(ByVal p As Vector2) As Boolean
	Return p.x > -3.2 And p.x < 3.2 And p.y < 0.0 And p.y > -7.4
End Function

