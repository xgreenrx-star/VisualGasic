		_plant(city, p, 2.4, 1.1)
	Next
	_solid(city, Rect2(-20, 58, 0.4, 4), 2.4, 6.4, city.SHELL)
	_solid(city, Rect2(-20, 65, 0.4, 5), 2.4, 6.4, city.SHELL)
	_solid(city, Rect2(-28, 58, 8, 0.4), 2.4, 6.4, city.SHELL)
	_deco(city, Vector3(-28, 6.4, 58), Vector3(8.4, 0.2, 12), city.INK)
	_gate("66038", Rect2(-20, 62, 0.4, 3), 2, 2.4, 5.6)
	_deco(city, Vector3(-20, 5.6, 62), Vector3(0.4, 0.8, 3), city.SHELL)
	_sign(city, Vector3(-19.75, 6.0, 63.5), Vector3(1, 0, 0), "331", "ARCHIVE - SEALED")
	_pickup("66038", "ship_scanner", Vector3(-25, 2.4, 66))
	_pickup("66038", "narcean_relic", Vector3(-25, 2.4, 61))
	_pad(city, Rect2(-23.5, 6.5, 3, 3), 0.0)
	_portal(Rect2(-23.3, 6.7, 2.6, 2.6), "66038", "island", "", "TRANSIT PAD")
	_anchor("shore", Vector2(-22, 11.5), 0.0)
	_sign(city, Vector3(-27.75, 2.6, 8), Vector3(1, 0, 0), "16", "TRANSIT PAD - ISLAND")
	_solid(city, Rect2(16, 46, 12, 0.4), 0.0, 3.0, city.SHELL * 0.8)
	_solid(city, Rect2(16, 46, 0.4, 12), 0.0, 3.0, city.SHELL * 0.8)
	_solid(city, Rect2(16, 57.6, 12, 0.4), 0.0, 3.0, city.SHELL * 0.8)
	_pad(city, Rect2(20.5, 47.5, 3, 3), 0.0)
	_portal(Rect2(20.7, 47.7, 2.6, 2.6), "66038", "shore", "", "TRANSIT PAD")
	_anchor("island", Vector2(22, 52), PI)
	_console(city, Vector2(24, 55.5), "TRANSLATED: RESERVOIR CONTROL / FRACTURED DEEP 93162 / ACCESS RESTRICTED", Array("93162"))
	_solid(city, Rect2(20, 10, 8, 8), 0.0, 7.0, city.SHELL * 0.65)
	_line3(city, Vector3(20, 7.05, 10), Vector3(20, 7.05, 18), 0.05, city.ICE)
	_line3(city, Vector3(20, 7.05, 18), Vector3(28, 7.05, 18), 0.05, city.ICE)
	_pickup("66038", "core_gem", Vector3(24, 7.0, 14))
	_lift_pad(city, Vector2(-26, 29.5))
	_portal(Rect2(-27.5, 28, 3, 3), "52914", "lift2", "", "SERVICE LIFT")
	_anchor("lift2", Vector2(-23, 29.5), PI * 0.5)
	_sign(city, Vector3(-27.75, 4.6, 29.5), Vector3(1, 0, 0), "06", "SERVICE LIFT - WARRENS")
	_sign(city, Vector3(0, 3.0, 0.36), Vector3(0, 0, 1), "07", "CISTERN - COOLANT RESERVOIR")
End Sub

Sub _layout_vault(ByVal city As Node)
	Dim violet As Color
	violet = Color(0.65, 0.3, 1.0)
	_frame(city, "80451", 48, 60, 7, city.SHELL * 0.5, city.SHELL * 0.7, True)
	For Each z In Array(10.0, 30.0)
		_solid(city, Rect2(-24, z, 48, 0.6), 0.0, 4.2, city.SHELL * 0.75)
		_line3(city, Vector3(-24, 4.2, z), Vector3(24, 4.2, z), 0.05, violet)
	Next
	For Each z In Array(20.0, 40.0)
		_solid(city, Rect2(-24, z, 48, 0.6), 2.8, 7.0, city.SHELL * 0.75)
		_line3(city, Vector3(-24, 2.8, z), Vector3(24, 2.8, z), 0.05, violet)
	Next
	For Each z In Array(4.0, 14.0, 24.0, 34.0)
		_flip(Rect2(-24, z, 48, 3))
		_deco(city, Vector3(-24, 0.01, z), Vector3(48, 0.03, 3), violet * 0.35, True)
		_deco(city, Vector3(-24, 6.96, z), Vector3(48, 0.03, 3), violet * 0.35, True)
	Next
	_hazard("sentry", Rect2(-24, 12, 48, 0.3), 0.0, 7.0, 2.6, 0.4, 0.0, 18)
	_hazard("sentry", Rect2(-24, 44, 48, 0.3), 0.0, 7.0, 2.2, 0.45, 1.1, 18)
	_pickup("80451", "med_gel", Vector3(10, 7.0, 12))
	_wallr(city, Rect2(-24, 48, 22, 0.4), city.SHELL)
	_wallr(city, Rect2(2, 48, 22, 0.4), city.SHELL)
	_deco(city, Vector3(-2, 4.2, 48), Vector3(4, 2.8, 0.4), city.SHELL)
	_gate("80451", Rect2(-2, 48, 4, 0.4), 3, 0.0, 4.2)
	_sign(city, Vector3(0, 5.0, 47.75), Vector3(0, 0, -1), "808", "VAULT - COMMAND SEAL")
	_pickup("80451", "ship_shield", Vector3(-8, 0.0, 54))
	_pickup("80451", "buggy_boost", Vector3(8, 0.0, 54))
	_fall(city, -23.5, -21.5, 22.0, 7.0, -4.0, violet)
	_fall(city, 21.5, 23.5, 26.0, 7.0, -4.0, violet)
	_sign(city, Vector3(0, 3.0, 0.36), Vector3(0, 0, 1), "08", "INVERTED VAULT - FIELD ACTIVE")
	_sign(city, Vector3(-23.75, 1.8, 5.5), Vector3(1, 0, 0), "41", "FIELD INVERSION AHEAD")
End Sub

Sub _layout_fractured(ByVal city As Node)
	Dim red As Color
	Dim floor_c As Color
	Dim p As Vector2
	Dim top As Single
	red = Color(1.0, 0.25, 0.12)
	floor_c = city.SHELL * 0.45
	_frame(city, "93162", 60, 70, 10, floor_c, city.SHELL * 0.6, False)
	_deco(city, Vector3(-30, -0.3, 0), Vector3(60, 0.3, 20), floor_c)
	_deco(city, Vector3(-2, -0.3, 20), Vector3(4, 0.3, 4), floor_c)
	_deco(city, Vector3(-30, -0.3, 24), Vector3(60, 0.3, 22), floor_c)
	_deco(city, Vector3(10, -0.3, 46), Vector3(3, 0.3, 4), floor_c)
	_deco(city, Vector3(-30, -0.3, 50), Vector3(60, 0.3, 20), floor_c)
	For Each r In Array(Rect2(-30, 20, 28, 4), Rect2(2, 20, 28, 4), Rect2(-30, 46, 40, 4), Rect2(13, 46, 17, 4))
		pits.append(r)
		_line3(city, Vector3(r.position.x, 0.02, r.position.y), Vector3(r.end.x, 0.02, r.position.y), 0.05, red)
		_line3(city, Vector3(r.position.x, 0.02, r.end.y), Vector3(r.end.x, 0.02, r.end.y), 0.05, red)
		_deco(city, Vector3(r.position.x, -12, r.position.y), Vector3(r.size.x, 0.2, r.size.y), Color(0.05, 0.005, 0.0), True)
	Next
	_zone(Rect2(-30, 30, 60, 15), 8.0, 1.0, 99.0)
	For k = 0 To 6
		_line3(city, Vector3(-30, 9.9, 30 + k * 2.4), Vector3(30, 9.9, 30 + k * 2.4), 0.06, Color(0.5, 1.0, 0.2) * 0.6)
	Next
	_hazard("sparks", Rect2(-2, 21, 4, 2), 0.0, 3.0, 1.8, 0.3, 0.0, 12)
	_hazard("sparks", Rect2(10, 47, 3, 2), 0.0, 3.0, 2.0, 0.3, 0.7, 12)
	For k = 0 To 9
		p = Vector2(-26 + seed_rng.randf() * 52, 4 + seed_rng.randf() * 64)
		If (p.y < 18 Or (p.y > 26 And p.y < 44) Or p.y > 52) And (p.x < 14 Or p.y < 54) Then
			top = 0.5 + seed_rng.randf() * 1.5
			_solid(city, Rect2(p.x - 0.8, p.y - 0.8, 1.6, 1.6), 0.0, top, city.SHELL * 0.55)
		End If
	Next
	_pickup("93162", "anti_rad", Vector3(-20, 0.0, 12))
	_pickup("93162", "anti_rad", Vector3(20, 0.0, 40))
	_pickup("93162", "gold_bar", Vector3(-24, 0.0, 60))
	_wallr(city, Rect2(18, 56, 0.4, 5), city.SHELL)
	_wallr(city, Rect2(18, 64, 0.4, 6), city.SHELL)
	_wallr(city, Rect2(18, 56, 12, 0.4), city.SHELL)
	_deco(city, Vector3(18, 3.4, 61), Vector3(0.4, 6.6, 3), city.SHELL)
	_gate("93162", Rect2(18, 61, 0.4, 3), 3, 0.0, 3.4)
	_sign(city, Vector3(17.75, 4.0, 62.5), Vector3(-1, 0, 0), "909", "FLIGHT EQUIPMENT - COMMAND ONLY")
	_pickup("93162", "jetpack", Vector3(25, 0.0, 66))
	_sign(city, Vector3(0, 3.0, 0.36), Vector3(0, 0, 1), "09", "FRACTURED DEEP - STRUCTURAL FAILURE")
	_sign(city, Vector3(-29.75, 3.0, 28), Vector3(1, 0, 0), "717", "RADIATION - BREACHED CORE")
End Sub

' --- Dynamic props: each is its own node so it can hide, bob, slide or flicker. ---

Function _attach(ByVal city As Node, ByVal label As String, ByVal at As Vector3) As MeshInstance3D
	Dim node As MeshInstance3D
	node = city._finish(label)
	node.reparent(city.interior)
	node.position = at
	Return node
End Function

Function _item_color(ByVal city As Node, ByVal id As String) As Color
	If id = "med_gel" Then Return Color(0.3, 1.0, 0.45)
	If id = "anti_rad" Then Return Color(0.85, 1.0, 0.2)
	If id = "gold_bar" Then Return city.GOLD
	If id = "core_gem" Or id = "narcean_relic" Then Return Color(0.75, 0.35, 1.0)
	If id = "psionic_screwdriver" Or id = "jetpack" Then Return Color(1.0, 0.3, 0.75)
	Return city.ICE
End Function

Sub _draw_item(ByVal city As Node, ByVal id As String)
	Dim c As Color
	c = _item_color(city, id)
	If id = "psionic_screwdriver" Then
		city._cylinder(Vector3(0, 0, 0), 0.07, 0.55, city.SHELL, 0)
		city._cylinder(Vector3(0.34, 0, 0), 0.03, 0.22, c, 0, True)
		city._cylinder(Vector3(-0.32, 0, 0), 0.1, 0.12, c * 0.7, 0, True)
	ElseIf id = "jetpack" Then
		For Each x In Array(-0.2, 0.2)
			city._cylinder(Vector3(x, 0, 0), 0.15, 0.7, city.SHELL)
			city._cylinder(Vector3(x, -0.4, 0), 0.1, 0.12, c, 1, True)
		Next
		city._box(Vector3(-0.3, -0.25, 0.15), Vector3(0.6, 0.55, 0.12), city.INK)
	ElseIf id = "gold_bar" Then
		city._box(Vector3(-0.3, -0.08, -0.12), Vector3(0.6, 0.16, 0.24), c, True)
	ElseIf id = "core_gem" Or id = "narcean_relic" Then
		city._bar(Vector3(0, -0.3, 0), Vector3(0, 0.3, 0), 0.18, c, True)
		city._bar(Vector3(-0.25, 0, 0), Vector3(0.25, 0, 0), 0.12, c * 0.8, True)
	Else
		city._box(Vector3(-0.22, -0.18, -0.22), Vector3(0.44, 0.36, 0.44), city.SHELL)
		city._box(Vector3(-0.23, -0.05, -0.23), Vector3(0.46, 0.1, 0.46), c, True)
	End If
End Sub

Sub build_dynamic(ByVal city As Node)
	Dim st As Dictionary
	Dim h As Single
	Dim r As Rect2
	Dim kind As String
	Dim node As MeshInstance3D
	Dim scene As Object
	Dim y As Single
	Dim at As Vector3
	Call EnsureInit()
	ensure_layout(city)
	st = city.stratum
	For Each entry In AsArray(pickups)
		_draw_item(city, entry("item"))
		at = entry("p")
		If at.y >= lv_h - 0.05 Then
			at = at + Vector3(0, -0.9, 0)
		Else
			at = at + Vector3(0, 0.9, 0)
		End If
		entry("node") = _attach(city, "Pickup", at)
		entry("node").visible = Not st("taken").has(entry("key"))
	Next
	For Each entry In AsArray(gates)
		r = entry("r")
		h = Num(entry("top")) - Num(entry("y0"))
		city._box(Vector3(0, 0, 0), Vector3(r.size.x, h, r.size.y), city.SHELL * 0.6)
		For k = 1 To Int(entry("grade"))
			y = h * (0.25 + k * 0.15)
			If r.size.x > r.size.y Then
				city._box(Vector3(0.1, y, -0.03), Vector3(r.size.x - 0.2, 0.06, r.size.y + 0.06), Color(1.0, 0.3, 0.75), True)
			Else
				city._box(Vector3(-0.03, y, 0.1), Vector3(r.size.x + 0.06, 0.06, r.size.y - 0.2), Color(1.0, 0.3, 0.75), True)
			End If
		Next
		entry("node") = _attach(city, "SealedDoor", Vector3(r.position.x, entry("y0"), r.position.y))
		entry("node").visible = Not st("hacked").has(entry("id"))
	Next
	For Each entry In AsArray(hazards)
		r = entry("r")
		kind = entry("kind")
		h = Num(entry("y1")) - Num(entry("y0"))
		If kind = "laser_low" Then
			For Each y In Array(0.2, 0.45)
				If r.size.x < r.size.y Then
					city._bar(Vector3(r.size.x * 0.5, y, 0), Vector3(r.size.x * 0.5, y, r.size.y), 0.04, Color(1.0, 0.1, 0.1), True)
				Else
					city._bar(Vector3(0, y, r.size.y * 0.5), Vector3(r.size.x, y, r.size.y * 0.5), 0.04, Color(1.0, 0.1, 0.1), True)
				End If
			Next
		ElseIf kind = "crusher" Then
			city._box(Vector3(0, 0, 0), Vector3(r.size.x, 0.7, r.size.y), city.SHELL * 0.8)
			city._box(Vector3(0.05, -0.02, 0.05), Vector3(r.size.x - 0.1, 0.04, r.size.y - 0.1), Color(1.0, 0.45, 0.05), True)
		ElseIf kind = "vent" Then
			For k = 0 To 5
				city._bar(Vector3(0.3 + (k Mod 3) * (r.size.x - 0.6) * 0.5, 0, 0.3 + Int(k / 3) * (r.size.y - 0.6)), Vector3(0.3 + (k Mod 3) * (r.size.x - 0.6) * 0.5, h, 0.3 + Int(k / 3) * (r.size.y - 0.6)), 0.08, Color(0.5, 1.0, 0.3) * 0.7, True)
			Next
		ElseIf kind = "sparks" Then
			For k = 0 To 7
				city._bar(Vector3(r.size.x * 0.5, h * 0.8, r.size.y * 0.5), Vector3(r.size.x * (0.1 + 0.11 * k), h * (0.1 + (k Mod 3) * 0.2), r.size.y * ((k * 37) Mod 10) * 0.1), 0.03, Color(1.0, 0.85, 0.4), True)
			Next
		Else
			city._box(Vector3(0, 0, 0), Vector3(r.size.x, h, r.size.y), Color(0.7, 0.2, 1.0) * 0.45, True)
		End If
		entry("node") = _attach(city, "Hazard", Vector3(r.position.x, entry("y0"), r.position.y))
	Next
	For Each entry In AsArray(falls)
		h = Num(entry("top"))
		For x = 0 To 5
			For y = 0 To Int(h)
				city._bar(Vector3(Num(entry("x0")) + (Num(entry("x1")) - Num(entry("x0"))) * x / 5.0, y + (x Mod 2) * 0.4, 0), Vector3(Num(entry("x0")) + (Num(entry("x1")) - Num(entry("x0"))) * x / 5.0, y + 0.55 + (x Mod 2) * 0.4, 0), 0.06, entry("color") * (0.5 + (x Mod 3) * 0.2), True)
			Next
		Next
		entry("node") = _attach(city, "Waterfall", Vector3(0, 0, entry("z")))
	Next
	For Each entry In AsArray(weak)
		r = entry("r")
		city._box(Vector3(0, -0.02, 0), Vector3(r.size.x, 0.05, r.size.y), city.SHELL * 0.4)
		city._bar(Vector3(0.2, 0.04, 0.4), Vector3(r.size.x * 0.6, 0.04, r.size.y * 0.5), 0.03, Color(1.0, 0.5, 0.1) * 0.6, True)
		city._bar(Vector3(r.size.x * 0.6, 0.04, r.size.y * 0.5), Vector3(r.size.x - 0.3, 0.04, r.size.y - 0.4), 0.03, Color(1.0, 0.5, 0.1) * 0.6, True)
		entry("node") = _attach(city, "WeakFloor", Vector3(r.position.x, 0, r.position.y))
		entry("node").visible = st("collapsed") <> True
	Next
	If has_derelict Then
		scene = Load("res://assets/trace_vault/scenes/trace_cycle.tscn")
		If scene <> Nothing Then
			node = scene.instantiate()
			node.name = "DerelictTraceCycle"
			city.interior.add_child(node)
			node.position = Vector3(derelict.get_center().x, 0.25, derelict.get_center().y)
			node.rotation.y = 0.35
		End If
	End If
End Sub

Function hazard_on(ByVal entry As Dictionary) As Boolean
	Return FMod(clock + Num(entry("phase")), Num(entry("period"))) < Num(entry("duty")) * Num(entry("period"))
End Function

Sub animate(ByVal city As Node, ByVal t As Single)
	Dim node As Object
	Dim kind As String
	Dim u As Single
	Dim at As Vector3
	If city.place <> "floor" Then Exit Sub
	ensure_layout(city)
	For Each entry In AsArray(pickups)
		node = entry("node")
		If node <> Nothing Then
			If node.visible Then
				at = entry("p")
				If at.y >= lv_h - 0.05 Then
					node.position.y = at.y - 0.9 - Sin(t * 2.0) * 0.1
				Else
					node.position.y = at.y + 0.9 + Sin(t * 2.0) * 0.1
				End If
				node.rotation.y = t * 1.2
			End If
		End If
	Next
	For Each entry In AsArray(hazards)
		node = entry("node")
		If node <> Nothing Then
			kind = entry("kind")
			If kind = "crusher" Then
				u = FMod(clock + Num(entry("phase")), Num(entry("period"))) / Num(entry("period"))
				If hazard_on(entry) Then
					node.position.y = 0.0
				ElseIf u > 0.85 Then
					node.position.y = (1.0 - u) / 0.15 * (lv_h - 0.7)
				Else
					node.position.y = lv_h - 0.7
				End If
			ElseIf kind = "laser_low" Then
				node.visible = True
			Else
				node.visible = hazard_on(entry)
			End If
		End If
	Next
	For Each entry In AsArray(falls)
		node = entry("node")
		If node <> Nothing Then node.position.y = FPosMod(0.0 - t * Num(entry("speed")), 1.0) - 1.0
	Next
End Sub

' --- Runtime ---

Function door_opening() As Single
	Dim u As Single
	u = (door_timer - 0.5) / 0.8
	If u < 0.0 Then Return 0.0
	If u > 1.0 Then Return 1.0
	Return u
End Function

Function _inside(ByVal p As Vector2) As Boolean
	For Each a In AsArray(areas)
		If a.has_point(p) Then Return True
	Next
	Return False
End Function

Function _span_blocks(ByVal city As Node, ByVal y0 As Single, ByVal top As Single) As Boolean
	Dim fy As Single
	fy = foot(city)
	If inverted(city) Then Return y0 < fy - 0.55 And top > fy - 1.7
	Return top > fy + 0.55 And y0 < fy + 1.7
End Function

Function blocked(ByVal city As Node, ByVal point As Vector2, ByVal radius As Single) As Boolean
	Dim st As Dictionary
	Call EnsureInit()
	ensure_layout(city)
	st = city.stratum
	For Each c In Array(Vector2(-1, -1), Vector2(1, -1), Vector2(-1, 1), Vector2(1, 1))
		If Not _inside(point + c * radius) Then Return True
	Next
	If door_opening() < 0.6 And Abs(point.x) < 2.2 And point.y > -0.4 And point.y < 0.7 Then Return True
	For Each s In AsArray(solids)
		If s("r").grow(radius).has_point(point) Then
			If _span_blocks(city, Num(s("y0")), Num(s("top"))) Then Return True
		End If
	Next
	For Each g In AsArray(gates)
		If Not st("hacked").has(g("id")) Then
			If g("r").grow(radius).has_point(point) Then
				If _span_blocks(city, Num(g("y0")), Num(g("top"))) Then Return True
			End If
		End If
	Next
	For Each rect In AsArray(city.interior_solids)
		If rect.grow(radius).has_point(point) Then Return True
	Next
	If has_derelict Then
		If derelict.grow(radius).has_point(point) And foot(city) < 1.0 Then Return True
	End If
	Return False
End Function

Function _support(ByVal city As Node, ByVal p As Vector2, ByVal fy As Single) As Single
	Dim best As Single
	best = 0.0
	For Each r In AsArray(pits)
		If r.has_point(p) Then best = -100.0
	Next
	For Each s In AsArray(solids)
		If s("r").grow(0.2).has_point(p) Then
			If Num(s("top")) <= fy + 0.56 And Num(s("top")) > best Then best = Num(s("top"))
		End If
	Next
	Return best
End Function

Function _overhead(ByVal p As Vector2, ByVal fy As Single) As Single
	Dim low As Single
	low = lv_h
	For Each s In AsArray(solids)
		If s("r").has_point(p) Then
			If Num(s("y0")) > fy + 1.0 And Num(s("y0")) < low Then low = Num(s("y0"))
		End If
	Next
	Return low
End Function

Function speed_factor(ByVal city As Node) As Single
	Dim f As Single
	f = 1.0
	If city.place <> "floor" Then Return 1.0
	ensure_layout(city)
	For Each z In AsArray(zones)
		If z("r").has_point(city.position_xz) And foot(city) <= Num(z("y1")) Then f = Min(f, Num(z("slow")))
	Next
	Return f
End Function

Sub hurt(ByVal city As Node, ByVal amount As Single, ByVal text As String, ByVal force As Boolean)
	If city.damage_cooldown > 0 And Not force Then Exit Sub
	city.shield = Max(0, city.shield - amount)
	city.damage_cooldown = 1.0
	fade = Max(fade, 0.35)
	If text <> "" Then city.notify(text)
	If city.shield <= 0 Then
		If city.awakening Then
			city.failed = True
			If city.audio <> Nothing Then city.audio.stop()
			city.notify("SUIT BREACHED. Enter retries the chamber checkpoint.")
		Else
			revive(city)
		End If
	End If
End Sub

Sub revive(ByVal city As Node)
	city.shield = 50
	city.radiation = 0.0
	city.stratum("inverted") = False
	city.stratum("foot_y") = 0.0
	city.stratum("rad_warned") = 0
	vel_y = 0.0
	grounded = True
	hacking = False
	city.position_xz = Vector2(0, -4.8)
	city.heading = 0.0
	door_timer = 0.0
	fade = 1.0
	city.notify("ORAC: Suit integrity restored to half from reserve, Jason. I pulled you back to the lift car. Please be more careful.")
End Sub

' Called when the car stops on a floor, and after any in-level relocation.
Sub arrive(ByVal city As Node, ByVal from_cabin As Boolean)
	Call EnsureInit()
	ensure_state(city)
	city.stratum("inverted") = False
	city.stratum("foot_y") = 0.0
	vel_y = 0.0
	grounded = True
	portal_armed = False
	flip_armed = False
	hacking = False
	door_timer = 0.0
	safe_point = Vector2(0, -4.8)
	learn(city, city.floor_code)
	If Not from_cabin Then city.position_xz = Vector2(0, -4.8)
	If city.position_xz.y > -0.8 Then city.position_xz.y = -0.8
End Sub

Sub travel(ByVal city As Node, ByVal dest As String, ByVal key As String)
	Dim a As Array
	Dim same As Boolean
	same = dest = city.floor_code
	If Not same Then
		city.floor_code = dest
		city.pending_room = True
		learn(city, dest)
		ensure_layout(city)
	End If
	city.stratum("inverted") = False
	city.stratum("foot_y") = 0.0
	vel_y = 0.0
	grounded = True
	portal_armed = False
	flip_armed = False
	door_timer = 10.0
	fade = 1.0
	If anchors.has(key) Then
		a = anchors(key)
		city.position_xz = a(0)
		city.heading = a(1)
	Else
		city.position_xz = Vector2(0, -4.8)
		city.heading = 0.0
	End If
	safe_point = city.position_xz
	If Not same Then city.notify("ORAC: " & level_label(dest) & ".")
End Sub

Sub _collect(ByVal city As Node, ByVal entry As Dictionary)
	Dim id As String
	id = entry("item")
	city.stratum("taken")(entry("key")) = True
	If city.pack.has(id) Then
		city.pack(id) = Int(city.pack(id)) + 1
	Else
		city.pack(id) = 1
	End If
	If entry("node") <> Nothing Then entry("node").visible = False
	If id = "psionic_screwdriver" Then
		city.notify("ORAC: A psionic screwdriver! Well, a Narcean lock-coupling kit. F at a sealed door and I will feed you the glyphs.")
	ElseIf id = "jetpack" Then
		city.notify("ORAC: A personal flight rig. Jump, then hold Space to thrust. It recharges while you stand.")
	ElseIf id = "rad_meter" Then
		city.notify("ORAC: Dosimeter linked to your suit. I can warn you about radiation now.")
	Else
		city.notify("RECOVERED: " & item_name(id) & " - " & item_text(id) & " (I: pack)")
	End If
End Sub

Sub physics(ByVal city As Node, ByVal delta As Single)
	Dim st As Dictionary
	Dim p As Vector2
	Dim fy As Single
	Dim ny As Single
	Dim support As Single
	Dim space As Boolean
	Dim fuel As Single
	Dim head As Single
	Dim in_zone As Boolean
	Dim lo As Single
	Dim hi As Single
	Dim warn As Integer
	Dim on_portal As Boolean
	Dim on_flip As Boolean
	Dim on_weak As Boolean
	Dim item_p As Vector3
	Call EnsureInit()
	ensure_layout(city)
	st = city.stratum
	clock = clock + delta
	door_timer = door_timer + delta
	fade = Max(0.0, fade - delta * 0.9)
	p = city.position_xz
	fy = foot(city)
	space = Input.is_key_pressed(KEY_SPACE) Or Input.is_physical_key_pressed(KEY_SPACE)
	fuel = Num(st("jet_fuel"))
	jetting = False
	If inverted(city) Then
		fy = lv_h
		grounded = True
		vel_y = 0.0
	Else
		support = _support(city, p, fy)
		If grounded Then
			If support < fy - 0.56 Then
				grounded = False
			Else
				fy = support
			End If
			If grounded And space And Not jump_held Then
				vel_y = 5.2
				grounded = False
			End If
		End If
		If Not grounded Then
			vel_y = vel_y - 10.0 * delta
			If space And has_item(city, "jetpack") And fuel > 0 And (jump_held Or vel_y < 2.0) Then
				jetting = True
				vel_y = Min(4.0, vel_y + 17.0 * delta)
				fuel = Max(0.0, fuel - 0.22 * delta)
			End If
			ny = fy + vel_y * delta
			head = _overhead(p, fy)
			If ny + 1.8 > head Then
				ny = head - 1.8
				vel_y = Min(vel_y, 0.0)
			End If
			If vel_y <= 0 And ny <= support Then
				ny = support
				vel_y = 0.0
				grounded = True
			End If
			fy = ny
		End If
		If grounded Then fuel = Min(1.0, fuel + 0.15 * delta)
	End If
	jump_held = space
	st("jet_fuel") = fuel
	st("foot_y") = fy
	If fy < -2.5 Then
		city.position_xz = safe_point
		st("foot_y") = 0.0
		vel_y = 0.0
		grounded = True
		hurt(city, 45, "ORAC: You fell, Jason. Suit took the impact. I marked the edge.", True)
		Exit Sub
	End If
	If grounded And fy > -0.1 And Not inverted(city) Then safe_point = p
	in_zone = False
	For Each z In AsArray(zones)
		If z("r").has_point(p) And fy <= Num(z("y1")) And Num(z("rad")) > 0 Then
			city.radiation = city.radiation + Num(z("rad")) * delta
			in_zone = True
		End If
	Next
	If Not in_zone Then city.radiation = Max(0.0, city.radiation - 0.4 * delta)
	If city.radiation > 40 Then
		city.shield = Max(0, city.shield - (city.radiation - 40) * 0.08 * delta)
		If city.shield <= 0 Then hurt(city, 1, "", True)
	End If
	warn = Int(st("rad_warned"))
	If has_item(city, "rad_meter") Then
		If city.radiation >= 25 * (warn + 1) And warn < 3 Then
			st("rad_warned") = warn + 1
			city.notify("ORAC: Radiation " & Str(Int(city.radiation)) & " and climbing. Get clear, or use anti-rad from the pack (I).")
		ElseIf city.radiation < 15 Then
			st("rad_warned") = 0
		End If
	End If
	If inverted(city) Then
		lo = fy - 1.8
		hi = fy
	Else
		lo = fy
		hi = fy + 1.8
	End If
	For Each h In AsArray(hazards)
		If hazard_on(h) And h("r").grow(0.35).has_point(p) And lo < Num(h("y1")) And hi > Num(h("y0")) Then
			hurt(city, Num(h("dmg")), _hazard_text(h("kind")), False)
		End If
	Next
	For Each entry In AsArray(pickups)
		If Not st("taken").has(entry("key")) Then
			item_p = entry("p")
			If p.distance_to(Vector2(item_p.x, item_p.z)) < 1.4 And Abs(item_p.y - fy) < 1.5 Then _collect(city, entry)
		End If
	Next
	on_portal = False
	For Each entry In AsArray(portals)
		If entry("r").has_point(p) And Abs(fy) < 0.6 Then
			on_portal = True
			If portal_armed Then
				portal_armed = False
				If city.awakening Then
					city.notify("ORAC: No detours! The lift car, Jason - ascent code " & ASCENT & ".")
				Else
					travel(city, entry("dest"), entry("anchor"))
					Exit Sub
				End If
			End If
		End If
	Next
	If Not on_portal Then portal_armed = True
	on_flip = False
	For Each r In AsArray(flips)
		If r.has_point(p) Then
			on_flip = True
			If flip_armed Then
				flip_armed = False
				st("inverted") = Not inverted(city)
				If inverted(city) Then
					st("foot_y") = lv_h
				Else
					st("foot_y") = 0.0
				End If
				fade = 0.6
				city.notify("ORAC: Field inversion! Down is up. Controls are mirrored for you.")
			End If
		End If
	Next
	If Not on_flip Then flip_armed = True
	on_weak = False
	For Each entry In AsArray(weak)
		If entry("r").has_point(p) And fy < 0.1 And Not inverted(city) Then
			on_weak = True
			weak_timer = weak_timer + delta
			If weak_timer >= 0.6 Or st("collapsed") = True Then
				st("collapsed") = True
				weak_timer = 0.0
				travel(city, entry("dest"), entry("anchor"))
				hurt(city, 10, "ORAC: The floor gave way! You dropped a level - Service Warrens. Are you hurt?", True)
				Exit Sub
			End If
		End If
	Next
	If Not on_weak Then weak_timer = 0.0
End Sub

Function _hazard_text(ByVal kind As String) As String
	If kind = "laser_low" Then Return "ORAC: Trip laser! Jump them - Space."
	If kind = "pulse" Then Return "ORAC: Pulse barrier. Watch the rhythm and cross when it drops."
	If kind = "crusher" Then Return "ORAC: Press plate! It telegraphs before it falls."
	If kind = "vent" Then Return "ORAC: Steam vent. Time your run."
	If kind = "sparks" Then Return "ORAC: Live conduit arcing across the bridge!"
	Return "ORAC: Automated sentry sweep! Cross between pulses."
End Function

Function _near_gate(ByVal city As Node) As Dictionary
	Dim best As Dictionary
	Dim d As Single
	Dim bd As Single
	bd = 2.4
	best = Nothing
	For Each g In AsArray(gates)
		If Not city.stratum("hacked").has(g("id")) Then
			d = city.position_xz.distance_to(g("r").get_center())
			If d < bd Then
				bd = d
				best = g
			End If
		End If
	Next
	Return best
End Function

Function _near_console(ByVal city As Node) As Dictionary
	For Each c In AsArray(consoles)
		If city.position_xz.distance_to(c("p")) < 2.4 Then Return c
	Next
	Return Nothing
End Function

' F on a deep floor. Returns True when Deep Stratum handled the interaction.
Function use(ByVal city As Node) As Boolean
	Dim g As Dictionary
	Dim c As Dictionary
	Dim fresh As String
	Call EnsureInit()
	ensure_layout(city)
	If in_alcove(city.position_xz) Then
		city.keypad = True
		city.sequence = ""
		If city.awakening Then city.notify("ORAC: Ascent code " & ASCENT & ". Enter it, Jason!")
		Return True
	End If
	c = _near_console(city)
	If c <> Nothing Then
		fresh = ""
		For Each code In AsArray(c("reveal"))
			If Not knows(city, code) Then fresh = fresh & " " & code
			learn(city, code)
		Next
		If fresh <> "" Then
			city.notify(c("text") & "  [ADDRESS LOGGED:" & fresh & "]")
		Else
			city.notify(c("text"))
		End If
		Return True
	End If
	g = _near_gate(city)
	If g <> Nothing Then
		If has_item(city, "psionic_screwdriver") Then
			_start_hack(g)
		Else
			city.notify("ORAC: A sealed Narcean door, grade " & Str(g("grade")) & ". A technician's coupling kit would open it. The maintenance levels should have one.")
		End If
		Return True
	End If
	Return False
End Function

Sub _start_hack(ByVal g As Dictionary)
	Dim rng As Object
	rng = ClassDB.Instantiate("RandomNumberGenerator")
	rng.randomize()
	hacking = True
	hack_gate = g("id")
	hack_target = Array()
	For k = 1 To Int(g("grade")) + 2
		hack_target.append(rng.randi_range(0, 9))
	Next
	hack_filled = 0
	hack_left = 15.0 + 8.0 * Int(g("grade"))
	hack_glyph = rng.randi_range(0, 9)
	hack_clock = 0.0
End Sub

Function modal_active() As Boolean
	Return hacking Or inv_open
End Function

Function pack_list(ByVal city As Node) As Array
	Dim out As Array
	out = Array()
	If city.pack Is Nothing Then Return out
	For Each id In AsArray(ITEMS.keys())
		If has_item(city, id) Then out.append(id)
	Next
	Return out
End Function

Sub _use_item(ByVal city As Node, ByVal id As String)
	If id = "med_gel" Then
		city.shield = Min(100, city.shield + 40)
		city.pack(id) = Int(city.pack(id)) - 1
		city.notify("Med gel applied. Suit integrity " & Str(Int(city.shield)) & ".")
	ElseIf id = "anti_rad" Then
		city.radiation = Max(0.0, city.radiation - 60)
		city.pack(id) = Int(city.pack(id)) - 1
		city.notify("Anti-rad injected. Radiation " & Str(Int(city.radiation)) & ".")
	Else
		city.notify(item_name(id) & ": " & item_text(id))
	End If
End Sub

' Hack and pack overlays own the keyboard while open. Returns True when input was consumed.
Function modal_input(ByVal city As Node, ByVal view As Node, ByVal delta As Single) As Boolean
	Dim list As Array
	Dim rng As Object
	Call EnsureInit()
	ensure_state(city)
	If hacking Then
		hack_left = hack_left - delta
		hack_clock = hack_clock + delta
		If hack_clock >= 0.45 Then
			hack_clock = 0.0
			rng = ClassDB.Instantiate("RandomNumberGenerator")
			rng.randomize()
			If rng.randf() < 0.3 Then
				hack_glyph = hack_target(hack_filled)
			Else
				hack_glyph = rng.randi_range(0, 9)
			End If
		End If
		If view.menu_tap(KEY_BACKSPACE) Then
			hacking = False
			city.notify("ORAC: Coupling released. The door stays sealed.")
			Return True
		End If
		If view.menu_tap(KEY_F) Or view.menu_tap(KEY_SPACE) Or view.menu_tap(KEY_ENTER) Then hack_press(city)
		If hacking And hack_left <= 0 Then
			hacking = False
			city.notify("ORAC: The lock re-keyed itself. Try again.")
		End If
		Return True
	End If
	If view.menu_tap(KEY_I) Then
		inv_open = Not inv_open
		inv_index = 0
		Return True
	End If
	If inv_open Then
		list = pack_list(city)
		If view.menu_tap(KEY_W) Or view.menu_tap(KEY_UP) Then inv_index = Max(0, inv_index - 1)
		If view.menu_tap(KEY_S) Or view.menu_tap(KEY_DOWN) Then inv_index = Min(Max(0, list.size() - 1), inv_index + 1)
		If view.menu_tap(KEY_ENTER) And list.size() > 0 Then _use_item(city, list(Min(inv_index, list.size() - 1)))
		If view.menu_tap(KEY_BACKSPACE) Then inv_open = False
		Return True
	End If
	Return False
End Function

Sub hack_press(ByVal city As Node)
	If Not hacking Then Exit Sub
	If hack_glyph = hack_target(hack_filled) Then
		hack_filled = hack_filled + 1
		hack_glyph = -1
		If hack_filled >= hack_target.size() Then
			hacking = False
			city.stratum("hacked")(hack_gate) = True
			For Each g In AsArray(gates)
				If g("id") = hack_gate And g("node") <> Nothing Then g("node").visible = False
			Next
			city.notify("ORAC: Coupling accepted. The door is open.")
		End If
	Else
		hurt(city, 8, "ORAC: Wrong glyph - the lock bit back. Match the glowing slot.", True)
	End If
End Sub

Function prompt(ByVal city As Node) As String
	Dim g As Dictionary
	Call EnsureInit()
	ensure_layout(city)
	If hacking Then Return "HACK: F/SPACE WHEN THE CYCLING GLYPH MATCHES THE LIT SLOT / BACKSPACE ABORT"
	If inv_open Then Return "PACK: W/S SELECT / ENTER USE / I CLOSE"
	If in_alcove(city.position_xz) Then Return "LIFT CAR / F: KEYPAD / I: PACK"
	If _near_console(city) <> Nothing Then Return "F: READ CONSOLE"
	g = _near_gate(city)
	If g <> Nothing Then
		If has_item(city, "psionic_screwdriver") Then Return "SEALED DOOR / F: PSIONIC SCREWDRIVER"
		Return "SEALED DOOR / NEED A COUPLING KIT"
	End If
	If has_item(city, "jetpack") Then Return "W/S MOVE  A/D TURN  SPACE JUMP / HOLD: JET  F USE  I PACK  H SCAN"
	Return "W/S MOVE  A/D TURN  Q/E STRAFE  SPACE JUMP  F USE  I PACK  H SCAN"
End Function

Function scan(ByVal city As Node) As String
	Dim n As Integer
	Dim seal As Integer
	Call EnsureInit()
	ensure_layout(city)
	n = 0
	For Each entry In AsArray(pickups)
		If Not city.stratum("taken").has(entry("key")) Then n = n + 1
	Next
	seal = 0
	For Each g In AsArray(gates)
		If Not city.stratum("hacked").has(g("id")) Then seal = seal + 1
	Next
	If city.awakening Then Return "ORAC: Back to the lift car and key " & ASCENT & ". Now!"
	Return "ORAC: " & level_label(city.floor_code) & ". " & Str(n) & " salvage signatures, " & Str(seal) & " sealed doors. Lift car ascent code " & ASCENT & "."
End Function

' Orac's visor translation of whatever Narcean text the helmet is looking at.
Function visor_text(ByVal city As Node) As String
	Dim p3 As Vector3
	Dim to_sign As Vector2
	Dim fwd As Vector2
	Dim best As Single
	Dim text As String
	Call EnsureInit()
	If city.place <> "floor" Then Return ""
	ensure_layout(city)
	If in_alcove(city.position_xz) Then
		Return "LIFT CAR " & PadInt(Int(LEVELS(city.floor_code)(1)), 2) & " / " & level_label(city.floor_code)
	End If
	fwd = Vector2(Sin(city.heading), Cos(city.heading))
	best = 6.0
	text = ""
	For Each s In AsArray(signs)
		p3 = s("p")
		to_sign = Vector2(p3.x, p3.z) - city.position_xz
		If to_sign.length() < best And to_sign.normalized().dot(fwd) > 0.75 Then
			best = to_sign.length()
			text = s("text")
		End If
	Next
	Return text
End Function

' Interior tint, light spill, fog colour and density per stratum.
Function level_style(ByVal code As String) As Array
	If code = "31707" Then Return Array(Vector3(1.15, 0.95, 0.75), Vector3(0.08, 0.045, 0.01), Color(0.06, 0.035, 0.01), 0.018)
	If code = "52914" Then Return Array(Vector3(0.7, 1.05, 0.75), Vector3(0.01, 0.07, 0.02), Color(0.01, 0.04, 0.015), 0.05)
	If code = "66038" Then Return Array(Vector3(0.75, 1.0, 1.05), Vector3(0.01, 0.07, 0.07), Color(0.01, 0.05, 0.06), 0.02)
	If code = "80451" Then Return Array(Vector3(0.95, 0.75, 1.15), Vector3(0.05, 0.02, 0.09), Color(0.03, 0.01, 0.06), 0.03)
	If code = "93162" Then Return Array(Vector3(1.15, 0.7, 0.65), Vector3(0.09, 0.015, 0.01), Color(0.07, 0.01, 0.01), 0.035)
	Return Array(Vector3(1, 1, 1), Vector3(0.008, 0.05, 0.075), Color(0.01, 0.02, 0.05), 0.01)
End Function
