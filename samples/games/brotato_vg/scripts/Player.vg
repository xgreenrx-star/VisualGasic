' Player — movement + auto-target weapons
Import "VfxHelpers.vg"
Extends CharacterBody2D

Const BULLET_SCENE_PATH As String = "res://scenes/Bullet.tscn"
Const ARENA_MIN_X As Single = 8.0
Const ARENA_MAX_X As Single = 1272.0
Const ARENA_MIN_Y As Single = -242.0
Const ARENA_MAX_Y As Single = 1022.0
Const HALF_X As Single = 18.0
Const HALF_Y As Single = 18.0

Dim weaponCooldowns As Variant
Dim isDead As Boolean
Dim sprite As Object
Dim charTint As Color
Dim hurtFlashTimer As Single
Dim origScale As Object
Dim hurtScaleTimer As Single
Dim _bulletScene As Object

Const HURT_FLASH_TIME As Single = 0.14
Const HURT_SCALE_PUNCH As Single = 1.15

Sub _Ready()
	sprite = GetNode("Sprite")
	charTint = Color.White
	If Not sprite Is Nothing Then origScale = sprite.scale
	Call SyncStats()
	Dim cam As Object
	cam = GetNode("Camera2D")
	If Not cam Is Nothing Then
		cam.enabled = True
		cam.make_current()
	End If
End Sub

Sub SetCharacterTint(t As Color)
	charTint = t
	If Not sprite Is Nothing Then origScale = sprite.scale
	If hurtFlashTimer <= 0 And Not sprite Is Nothing Then sprite.modulate = t
End Sub

Sub SyncStats()
	isDead = False
	weaponCooldowns = Array()
	Dim i As Integer
	For i = 0 To UBound(GameManager.player_weapons)
		weaponCooldowns.append(0.0)
	Next i
End Sub

Sub _PhysicsProcess(delta As Single)
	If GameManager.game_state <> "fight" Or isDead Then
		Me.Velocity = Vector2(0, 0)
		Exit Sub
	End If
	If UBound(weaponCooldowns) <> UBound(GameManager.player_weapons) Then
		Call SyncStats()
	End If
	Call HandleMovement
	Call HandleShooting(delta)
	Call ClampToArena()
	Call UpdateHurtFlash(delta)
End Sub

Sub UpdateHurtFlash(delta As Single)
	If hurtFlashTimer > 0 Then
		hurtFlashTimer = hurtFlashTimer - delta
		If hurtFlashTimer <= 0 And Not sprite Is Nothing Then sprite.modulate = charTint
	End If
	If hurtScaleTimer > 0 And Not sprite Is Nothing Then
		hurtScaleTimer = hurtScaleTimer - delta
		Dim t As Single
		t = hurtScaleTimer / HURT_FLASH_TIME
		If t < 0 Then t = 0
		sprite.scale = origScale * (1.0 + (HURT_SCALE_PUNCH - 1.0) * t)
		If hurtScaleTimer <= 0 Then sprite.scale = origScale
	End If
End Sub

Sub HandleMovement()
	Dim dirX As Single
	Dim dirY As Single
	dirX = Input.GetAxis("move_left", "move_right")
	dirY = Input.GetAxis("move_up", "move_down")
	Dim dir As Object
	dir = Vector2(dirX, dirY)
	If dir.length() > 0 Then dir = dir.normalized()
	Me.Velocity = dir * GameManager.player_stats("speed")
	MoveAndSlide()
End Sub

Sub ClampToArena()
	Dim pos As Object
	pos = Me.global_position
	Dim x As Single
	Dim y As Single
	x = Clamp(pos.x, ARENA_MIN_X + HALF_X, ARENA_MAX_X - HALF_X)
	y = Clamp(pos.y, ARENA_MIN_Y + HALF_Y, ARENA_MAX_Y - HALF_Y)
	Me.global_position = Vector2(x, y)
End Sub

Sub HandleShooting(delta As Single)
	Dim i As Integer
	For i = 0 To UBound(GameManager.player_weapons)
		weaponCooldowns(i) = weaponCooldowns(i) - delta
		If weaponCooldowns(i) > 0 Then GoTo NextWeapon
		Dim weapon As Object
		Set weapon = GameManager.player_weapons(i)
		Dim eff As Object
		Set eff = GameManager.GetWeaponEffectiveStats(weapon)
		If eff Is Nothing Then
			weaponCooldowns(i) = 0.5
			GoTo NextWeapon
		End If
		Dim target As Object
		Set target = FindNearestEnemyWithin(eff("range"))
		If target Is Nothing Then
			weaponCooldowns(i) = 0.1
			GoTo NextWeapon
		End If
		Call FireWeapon(weapon, eff, target)
		weaponCooldowns(i) = eff("cooldown")
NextWeapon:
	Next i
End Sub

Function FindNearestEnemyWithin(r As Single) As Object
	Dim enemies As Variant
	enemies = GetTree().get_nodes_in_group("enemies")
	Dim best As Object
	Set best = Nothing
	Dim bestDist As Single
	bestDist = r
	Dim i As Integer
	For i = 0 To UBound(enemies)
		Dim node As Object
		Set node = enemies(i)
		If node Is Nothing Then GoTo NextE
		Dim d As Single
		d = Me.global_position.distance_to(node.global_position)
		If d < bestDist Then
			bestDist = d
			Set best = node
		End If
NextE:
	Next i
	Set FindNearestEnemyWithin = best
End Function

Sub FireWeapon(weapon As Object, eff As Object, target As Object)
	Dim baseDir As Object
	baseDir = (target.global_position - Me.global_position).normalized()
	Dim count As Integer
	count = Int(eff("bullet_count"))
	Dim spread As Single
	spread = Deg2Rad(eff("spread_deg"))
	If count <= 1 Then
		Dim jitter As Single
		jitter = (Rnd() - 0.5) * spread
		Call SpawnBullet(baseDir.rotated(jitter), eff)
	Else
		Dim j As Integer
		For j = 0 To count - 1
			Dim t As Single
			t = j / (count - 1) - 0.5
			Call SpawnBullet(baseDir.rotated(t * spread), eff)
		Next j
	End If
	Dim parent As Object
	Set parent = GetParent()
	If Not parent Is Nothing Then Call SpawnMuzzleFlash(parent, Me.global_position, baseDir, eff("color"))
	AudioBus.Play(CStr(eff("def_id")) & "_fire")
	Dim pat As String
	pat = CStr(eff("pattern"))
	Dim shake As Single
	shake = 2.5
	Select Case pat
		Case "sniper": shake = 7.0
		Case "shotgun": shake = 9.0
		Case "smg": shake = 1.2
	End Select
	GameManager.EmitRequestShake shake
End Sub

Sub SpawnBullet(dir As Object, eff As Object)
	If _bulletScene Is Nothing Then Set _bulletScene = GameManager.CachedScene(BULLET_SCENE_PATH)
	Dim bullet As Object
	Set bullet = _bulletScene.instantiate()
	GetParent().add_child(bullet)
	bullet.global_position = Me.global_position
	Dim p As Object
	Set p = New Dictionary
	p("dir") = dir
	p("damage") = eff("damage")
	p("pierce") = eff("pierce")
	p("speed") = eff("bullet_speed")
	p("lifetime") = eff("bullet_lifetime")
	p("pattern") = eff("pattern")
	p("color") = eff("color")
	bullet.SetupExtended(p)
End Sub

Sub TakeDamage(amount As Single)
	If isDead Or GameManager.game_state <> "fight" Then Exit Sub
	If Rnd() < GameManager.player_stats("dodge") Then Exit Sub
	Dim armor As Integer
	armor = Int(GameManager.player_stats("armor"))
	Dim actual As Single
	actual = Max(amount - armor, 1.0)
	GameManager.player_stats("hp") = GameManager.player_stats("hp") - actual
	GameManager.EmitRequestShake 7.0
	AudioBus.Play("player_hurt")
	If Not sprite Is Nothing Then
		sprite.modulate = Color(1.0, 0.25, 0.25)
		hurtFlashTimer = HURT_FLASH_TIME
		hurtScaleTimer = HURT_FLASH_TIME
		sprite.scale = origScale * HURT_SCALE_PUNCH
	End If
	If GameManager.player_stats("hp") <= 0 Then
		GameManager.player_stats("hp") = 0
		isDead = True
		GameManager.EmitPlayerDied()
	End If
End Sub

Sub Heal(amount As Single)
	Dim hp As Single
	hp = GameManager.player_stats("hp") + amount
	If hp > GameManager.player_stats("max_hp") Then hp = GameManager.player_stats("max_hp")
	GameManager.player_stats("hp") = hp
End Sub
