' WaveManager — spawns enemies and bosses
Extends Node

Event wave_ended()

Const BOSS_WAVES As String = "5,10,15,20"
Const ARENA_MIN_X As Single = -10.0
Const ARENA_MAX_X As Single = 1290.0
Const ARENA_MIN_Y As Single = -260.0
Const ARENA_MAX_Y As Single = 1040.0
Const VIEW_HALF_X As Single = 640.0
Const VIEW_HALF_Y As Single = 360.0
Const SPAWN_MARGIN As Single = 80.0

Dim spawnTimer As Object
Dim waveTimer As Object
Dim arenaRect As Object
Dim bossSpawned As Boolean
Dim enemyTypes As Variant
Dim enemyScene As Object
Dim warnScene As Object

Sub _Ready()
	spawnTimer = GetNode("SpawnTimer")
	waveTimer = GetNode("WaveTimer")
	Connect GameManager, "boss_killed", "OnBossKilled"
	Set enemyScene = GameManager.CachedScene("res://scenes/Enemy.tscn")
	Set warnScene = GameManager.CachedScene("res://scenes/SpawnWarning.tscn")
	Call InitEnemyTypes
End Sub

Sub InitEnemyTypes()
	enemyTypes = Array()
	Call AddEnemyType(18, 5, 65, 8, 3, 2, "fast")
	Call AddEnemyType(10, 2, 115, 5, 2, 1, "light")
	Call AddEnemyType(45, 9, 38, 14, 5, 4, "tank")
	Call AddEnemyType(110, 22, 44, 18, 14, 10, "elite")
End Sub

Sub AddEnemyType(baseHp As Integer, hpPerWave As Integer, spd As Integer, dmg As Integer, xp As Integer, mat As Integer, tex As String)
	Dim t As Object
	Set t = New Dictionary
	t("base_hp") = baseHp
	t("hp_per_wave") = hpPerWave
	t("speed") = spd
	t("damage") = dmg
	t("xp") = xp
	t("mat") = mat
	t("tex") = tex
	enemyTypes.append(t)
End Sub

Sub StartWave(rect As Object)
	arenaRect = rect
	bossSpawned = False
	spawnTimer.wait_time = GameManager.GetSpawnInterval()
	spawnTimer.start()
	waveTimer.wait_time = GameManager.GetWaveDuration()
	waveTimer.start()
	If IsBossWave(GameManager.wave) Then
		Dim delay As Single
		If GameManager.wave = 20 Then delay = 0.5 Else delay = GameManager.GetWaveDuration() * 0.5
		Dim timer As Object
		timer = GetTree().create_timer(delay)
		Connect timer, "timeout", "TrySpawnBoss"
	End If
End Sub

Sub StopWave()
	spawnTimer.stop()
	waveTimer.stop()
End Sub

Function IsBossWave(w As Integer) As Boolean
	IsBossWave = (w = 5 Or w = 10 Or w = 15 Or w = 20)
End Function

Sub _on_spawn_timer_timeout()
	Dim count As Integer
	count = 1 + Int(GameManager.wave / 6)
	Dim i As Integer
	For i = 0 To count - 1
		Call PrepareSpawn()
	Next i
End Sub

Sub _on_wave_timer_timeout()
	If IsBossWave(GameManager.wave) Then
		waveTimer.start()
		Exit Sub
	End If
	Call StopWave()
	RaiseEvent wave_ended()
End Sub

Sub PrepareSpawn()
	Dim pos As Object
	pos = RandomOffscreenPos()
	Dim warning As Object
	Set warning = warnScene.instantiate()
	GetParent().GetNode("GameObjects").add_child(warning)
	warning.global_position = pos
	Dim avail As Variant
	If GameManager.wave >= 5 Then
		avail = enemyTypes
	Else
		avail = Array(enemyTypes(0), enemyTypes(1), enemyTypes(2))
	End If
	Dim t As Object
	Set t = avail(Int(Rnd() * (UBound(avail) + 1)))
	Connect warning, "finished", "SpawnAfterWarning", pos, t
End Sub

Sub SpawnAfterWarning(pos As Object, t As Object)
	If GameManager.game_state <> "fight" Then Exit Sub
	Dim enemy As Object
	Set enemy = enemyScene.instantiate()
	GetParent().GetNode("GameObjects").add_child(enemy)
	Dim hp As Single
	hp = t("base_hp") + t("hp_per_wave") * GameManager.wave
	enemy.Setup(hp, t("speed") + GameManager.wave * 2.0, t("damage"), t("xp"), t("mat"))
	Dim sprite As Object
	sprite = enemy.GetNode("Sprite")
	If Not sprite Is Nothing Then
		sprite.texture = TexFor(CStr(t("tex")))
		sprite.modulate = Color(1, 1, 1)
		enemy.origColor = sprite.modulate
	End If
	enemy.global_position = pos
End Sub

Sub TrySpawnBoss()
	If bossSpawned Or GameManager.game_state <> "fight" Then Exit Sub
	bossSpawned = True
	Dim def As Object
	Set def = FindBossDef(GameManager.wave)
	If def Is Nothing Then Exit Sub
	Dim pos As Object
	pos = RandomOffscreenPos()
	Dim warning As Object
	Set warning = warnScene.instantiate()
	warning.SetBig()
	GetParent().GetNode("GameObjects").add_child(warning)
	warning.global_position = pos
	Connect warning, "finished", "SpawnBossAfterWarning", pos, def
End Sub

Sub SpawnBossAfterWarning(pos As Object, def As Object)
	If GameManager.game_state <> "fight" Then Exit Sub
	Dim enemy As Object
	Set enemy = enemyScene.instantiate()
	GetParent().GetNode("GameObjects").add_child(enemy)
	Dim baseT As Object
	Set baseT = enemyTypes(0)
	Dim hp As Single
	hp = baseT("base_hp") * def("hp_mult") + GameManager.wave * 40.0
	enemy.SetupBoss(hp, def("speed"), baseT("damage") * def("dmg_mult"), def("xp"), def("mat"), CStr(def("ability")))
	Dim sprite As Object
	sprite = enemy.GetNode("Sprite")
	If Not sprite Is Nothing Then
		sprite.texture = TexFor(CStr(def("tex")))
		sprite.modulate = def("color")
		enemy.origColor = sprite.modulate
	End If
	enemy.global_position = pos
End Sub

Function FindBossDef(w As Integer) As Object
	If w = 5 Then
		Set FindBossDef = BossDef("dash", 20.0, 1.6, 70.0, 40, 25, Color(1.0, 0.4, 0.4), "boss_dash")
	ElseIf w = 10 Then
		Set FindBossDef = BossDef("shoot", 35.0, 1.7, 50.0, 60, 35, Color(0.6, 0.4, 1.0), "boss_shoot")
	ElseIf w = 15 Then
		Set FindBossDef = BossDef("summon", 55.0, 1.9, 55.0, 90, 50, Color(1.0, 0.6, 0.2), "boss_summon")
	ElseIf w = 20 Then
		Set FindBossDef = BossDef("dash", 100.0, 2.4, 95.0, 150, 80, Color(0.95, 0.1, 0.1), "boss_final")
	Else
		Set FindBossDef = Nothing
	End If
End Function

Function BossDef(ability As String, hpMult As Single, dmgMult As Single, spd As Single, xp As Integer, mat As Integer, col As Color, tex As String) As Object
	Dim d As Object
	Set d = New Dictionary
	d("ability") = ability
	d("hp_mult") = hpMult
	d("dmg_mult") = dmgMult
	d("speed") = spd
	d("xp") = xp
	d("mat") = mat
	d("color") = col
	d("tex") = tex
	Set BossDef = d
End Function

Sub OnBossKilled(ability As String)
	If GameManager.game_state <> "fight" Then Exit Sub
	If GameManager.wave = 20 Then
		Call StopWave()
		GameManager.EmitGameWon()
	ElseIf IsBossWave(GameManager.wave) Then
		Call StopWave()
		RaiseEvent wave_ended()
	End If
End Sub

Function TexFor(name As String) As Object
	Select Case name
		Case "fast": Set TexFor = GameManager.CachedTex("res://assets/sprites/enemy_fast.png")
		Case "light": Set TexFor = GameManager.CachedTex("res://assets/sprites/enemy_light.png")
		Case "tank": Set TexFor = GameManager.CachedTex("res://assets/sprites/enemy_tank.png")
		Case "elite": Set TexFor = GameManager.CachedTex("res://assets/sprites/enemy_elite.png")
		Case "boss_dash": Set TexFor = GameManager.CachedTex("res://assets/sprites/boss_dash.png")
		Case "boss_shoot": Set TexFor = GameManager.CachedTex("res://assets/sprites/boss_shoot.png")
		Case "boss_summon": Set TexFor = GameManager.CachedTex("res://assets/sprites/boss_summon.png")
		Case "boss_final": Set TexFor = GameManager.CachedTex("res://assets/sprites/boss_final.png")
		Case Else: Set TexFor = GameManager.CachedTex("res://assets/sprites/enemy_fast.png")
	End Select
End Function

Function RandomOffscreenPos() As Object
	Dim playerPos As Object
	playerPos = Vector2(640, 390)
	Dim players As Variant
	players = GetTree().get_nodes_in_group("player")
	If UBound(players) >= 0 Then
		Dim p As Object
		Set p = players(0)
		If Not p Is Nothing Then playerPos = p.global_position
	End If
	Dim camLeft As Single
	Dim camRight As Single
	Dim camTop As Single
	Dim camBottom As Single
	camLeft = playerPos.x - VIEW_HALF_X - SPAWN_MARGIN
	camRight = playerPos.x + VIEW_HALF_X + SPAWN_MARGIN
	camTop = playerPos.y - VIEW_HALF_Y - SPAWN_MARGIN
	camBottom = playerPos.y + VIEW_HALF_Y + SPAWN_MARGIN
	Dim ax1 As Single: ax1 = ARENA_MIN_X + 30
	Dim ax2 As Single: ax2 = ARENA_MAX_X - 30
	Dim ay1 As Single: ay1 = ARENA_MIN_Y + 30
	Dim ay2 As Single: ay2 = ARENA_MAX_Y - 30
	Dim side As Integer
	side = Int(Rnd() * 4)
	Dim x As Single
	Dim y As Single
	Select Case side
		Case 0: x = RndRange(Max(ax1, camLeft - SPAWN_MARGIN * 2), Min(ax2, camLeft)): y = RndRange(ay1, ay2)
		Case 1: x = RndRange(Max(ax1, camRight), Min(ax2, camRight + SPAWN_MARGIN * 2)): y = RndRange(ay1, ay2)
		Case 2: x = RndRange(ax1, ax2): y = RndRange(Max(ay1, camTop - SPAWN_MARGIN * 2), Min(ay2, camTop))
		Case Else: x = RndRange(ax1, ax2): y = RndRange(Max(ay1, camBottom), Min(ay2, camBottom + SPAWN_MARGIN * 2))
	End Select
	RandomOffscreenPos = Vector2(Clamp(x, ax1, ax2), Clamp(y, ay1, ay2))
End Function

Function RndRange(a As Single, b As Single) As Single
	If b < a Then RndRange = a Else RndRange = a + Rnd() * (b - a)
End Function
