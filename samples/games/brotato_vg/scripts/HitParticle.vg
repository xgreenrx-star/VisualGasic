' Short-lived hit particles (ColorRect children)
Extends Node2D

Dim lifetime As Single
Dim maxLifetime As Single
Dim velocities As Variant

Sub _Ready()
	lifetime = 0.55
	maxLifetime = 0.55
	velocities = Array()
	Dim count As Integer
	count = Me.get_child_count()
	Dim i As Integer
	For i = 0 To count - 1
		Dim dir As Object
		dir = Vector2(Rnd() * 2 - 1, Rnd() * 2 - 1)
		If dir.length() < 0.1 Then dir = Vector2(1, 0)
		velocities.append(dir.normalized() * (90.0 + Rnd() * 110.0))
	Next i
End Sub

Sub SetColor(c As Color)
	Dim i As Integer
	For i = 0 To Me.get_child_count() - 1
		Dim rect As Object
		Set rect = Me.get_child(i)
		If Not rect Is Nothing Then
			rect.color = c
		End If
	Next i
End Sub

Sub _Process(delta As Single)
	lifetime = lifetime - delta
	If lifetime <= 0 Then
		Me.queue_free()
		Exit Sub
	End If
	Dim alpha As Single
	alpha = lifetime / maxLifetime
	If alpha < 0 Then alpha = 0
	Dim i As Integer
	For i = 0 To Me.get_child_count() - 1
		If i > UBound(velocities) Then Exit For
		Dim c As Object
		Set c = Me.get_child(i)
		If c Is Nothing Then GoTo NextChild
		Dim pos As Object
		pos = c.position
		c.position = pos + velocities(i) * delta
		Dim col As Color
		col = c.color
		col.a = alpha
		c.color = col
NextChild:
	Next i
End Sub
