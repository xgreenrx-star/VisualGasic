; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="GRAVEN (VG6 slice)"
config/description="Mass-gravity cave explorer — flagship Visual Gasic demo"
run/main_scene="res://ai_projects/graven_slice/main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

VGDebugHandler="*uid://bba4n02t2dx1g"

[display]

window/size/viewport_width=1280
window/size/viewport_height=704
window/stretch/mode="viewport"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_gasic/plugin.cfg")

