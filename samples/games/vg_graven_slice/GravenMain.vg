' GRAVEN — Room 1 scaffold (mass gravity + thrust)
' See BLUEPRINT.md and NARCEA_PROMPTS.md for full slice plan.

Option Explicit

Const GAME_W As Single = 1280
Const GAME_H As Single = 704
Const TILE As Single = 32
Const COLS As Integer = 40
Const ROWS As Integer = 22

Const THRUST As Single = 420
Const VMAX As Single = 280
Const DRAG As Single = 0.92
Const G_SCALE As Single = 120000
Const G_MIN_DIST As Single = 48
Const G_MAX As Single = 600
Const POD_R As Single = 12

Dim podX As Single
Dim podY As Single
Dim podVX As Single
Dim podVY As Single
Dim podAngle As Single
Dim gravAX As Single
Dim gravAY As Single
Dim roomId As Integer
Dim massCount As Integer
Dim massX(3) As Single
Dim massY(3) As Single
Dim massS(3) As Single
Dim needRedraw As Boolean
Dim statusText As String

Sub _Ready()
	roomId = 1
	statusText = "Room 1 — east exit stub (Room 2 via Narcea Prompt 2)"
	Call LoadRoomMasses()
	Call ResetPodSpawn()
	needRedraw = True
	Print "GRAVEN slice — W/Up thrust, Q/E rotate 90"
End Sub

Sub LoadRoomMasses()
	massCount = 0
	If roomId = 1 Then
		massCount = 1
		massX(0) = 640
		massY(0) = 780
		massS(0) = 1.0
	End If
End Sub

Sub ResetPodSpawn()
	If roomId = 1 Then
		podX = 272
		podY = 560
	Else
		podX = 64
		podY = 560
	End If
	podVX = 0
	podVY = 0
	podAngle = 0
End Sub

Function IsSolidTile(tx As Integer, ty As Integer) As Boolean
	If tx < 0 Or tx >= COLS Or ty < 0 Or ty >= ROWS Then
		IsSolidTile = True
		Exit Function
	End If
	If roomId <> 1 Then
		IsSolidTile = False
		Exit Function
	End If
	If ty = 0 Then
		IsSolidTile = True
		Exit Function
	End If
	If ty >= 18 Then
		IsSolidTile = True
		Exit Function
	End If
	If tx = 0 Or tx = COLS - 1 Then
		IsSolidTile = True
		Exit Function
	End If
	IsSolidTile = False
End Function

Function CircleRectOverlap(cx As Single, cy As Single, cr As Single, rx As Single, ry As Single, rw As Single, rh As Single) As Boolean
	Dim nx As Single
	Dim ny As Single
	nx = cx
	If nx < rx Then nx = rx
	If nx > rx + rw Then nx = rx + rw
	ny = cy
	If ny < ry Then ny = ry
	If ny > ry + rh Then ny = ry + rh
	Dim dx As Single
	Dim dy As Single
	dx = cx - nx
	dy = cy - ny
	CircleRectOverlap = (dx * dx + dy * dy) <= (cr * cr)
End Function

Function PodHitsSolid() As Boolean
	Dim tx0 As Integer
	Dim ty0 As Integer
	Dim tx1 As Integer
	Dim ty1 As Integer
	Dim tx As Integer
	Dim ty As Integer
	tx0 = Int((podX - POD_R) / TILE)
	If tx0 < 0 Then tx0 = 0
	ty0 = Int((podY - POD_R) / TILE)
	If ty0 < 0 Then ty0 = 0
	tx1 = Int((podX + POD_R) / TILE)
	If tx1 >= COLS Then tx1 = COLS - 1
	ty1 = Int((podY + POD_R) / TILE)
	If ty1 >= ROWS Then ty1 = ROWS - 1
	For ty = ty0 To ty1
		For tx = tx0 To tx1
			If IsSolidTile(tx, ty) Then
				If CircleRectOverlap(podX, podY, POD_R, tx * TILE, ty * TILE, TILE, TILE) Then
					PodHitsSolid = True
					Exit Function
				End If
			End If
		Next tx
	Next ty
	PodHitsSolid = False
End Function

Sub ResolvePodCollision()
	Dim tries As Integer
	Dim ox As Single
	Dim oy As Single
	tries = 0
	Do While PodHitsSolid() And tries < 8
		ox = podX
		oy = podY
		podX = podX - podVX * 0.016
		podY = podY - podVY * 0.016
		podVX = podVX * -0.25
		podVY = podVY * -0.25
		If Abs(podX - ox) < 0.01 And Abs(podY - oy) < 0.01 Then
			podY = podY - 2
		End If
		tries = tries + 1
		needRedraw = True
	Loop
End Sub

Sub GravityAccel(px As Single, py As Single)
	Dim i As Integer
	Dim dx As Single
	Dim dy As Single
	Dim distSq As Single
	Dim dist As Single
	Dim pull As Single
	gravAX = 0
	gravAY = 0
	For i = 0 To massCount - 1
		dx = massX(i) - px
		dy = massY(i) - py
		distSq = dx * dx + dy * dy
		If distSq < G_MIN_DIST * G_MIN_DIST Then distSq = G_MIN_DIST * G_MIN_DIST
		dist = Sqr(distSq)
		pull = G_SCALE * massS(i) / distSq
		If pull > G_MAX Then pull = G_MAX
		gravAX = gravAX + (dx / dist) * pull
		gravAY = gravAY + (dy / dist) * pull
	Next i
End Sub

Sub _Process(delta As Single)
	Dim oldX As Single
	Dim oldY As Single
	Dim ax As Single
	Dim ay As Single
	Dim thrusting As Boolean
	Dim spd As Single
	Dim rad As Single

	If Input.IsActionJustPressed("rotate_ccw") Then
		podAngle = podAngle - 90
		needRedraw = True
	End If
	If Input.IsActionJustPressed("rotate_cw") Then
		podAngle = podAngle + 90
		needRedraw = True
	End If

	thrusting = Input.IsActionPressed("thrust")
	Call GravityAccel(podX, podY)
	ax = gravAX
	ay = gravAY
	If thrusting Then
		rad = Deg2Rad(podAngle)
		ax = ax + Cos(rad) * THRUST
		ay = ay + Sin(rad) * THRUST
	End If

	oldX = podX
	oldY = podY
	podVX = podVX + ax * delta
	podVY = podVY + ay * delta
	spd = Sqr(podVX * podVX + podVY * podVY)
	If spd > VMAX Then
		podVX = podVX * (VMAX / spd)
		podVY = podVY * (VMAX / spd)
	End If
	podVX = podVX * DRAG
	podVY = podVY * DRAG
	podX = podX + podVX * delta
	podY = podY + podVY * delta

	Call ResolvePodCollision()

	If roomId = 1 Then
		If podX > 1216 And podY > 520 And podY < 640 Then
			statusText = "Exit reached — Room 2 not built yet (Narcea Prompt 2)"
		End If
	End If

	If Abs(podX - oldX) > 0.05 Or Abs(podY - oldY) > 0.05 Or thrusting Then
		needRedraw = True
	End If
	If needRedraw Then
		QueueRedraw()
		needRedraw = False
	End If
End Sub

Sub _Draw()
	Dim tx As Integer
	Dim ty As Integer
	Dim rad As Single
	Dim nx As Single
	Dim ny As Single
	Dim nlen As Single
	Dim i As Integer

	DrawRect 0, 0, GAME_W, GAME_H, Color(0.039, 0.055, 0.078, 1.0)
	For ty = 0 To ROWS - 1
		For tx = 0 To COLS - 1
			If IsSolidTile(tx, ty) Then
				DrawRect tx * TILE, ty * TILE, TILE, TILE, Color(0.102, 0.145, 0.188, 1.0)
			End If
		Next tx
	Next ty

	For i = 0 To massCount - 1
		DrawCircle massX(i), massY(i), 6, Color(0.24, 0.8, 1.0, 0.35)
	Next i

	rad = Deg2Rad(podAngle)
	nx = podX + Cos(rad) * 18
	ny = podY + Sin(rad) * 18
	DrawLine podX, podY, nx, ny, Color(0.24, 0.8, 1.0, 1.0)
	DrawCircle podX, podY, POD_R, Color(0.18, 0.28, 0.36, 1.0)
	DrawCircle podX, podY, POD_R - 4, Color(0.24, 0.8, 1.0, 1.0)

	nlen = Sqr(gravAX * gravAX + gravAY * gravAY)
	If nlen > 0.01 Then
		DrawLine podX, podY, podX + gravAX / nlen * 28, podY + gravAY / nlen * 28, Color(1.0, 0.69, 0.125, 0.9)
	End If

	DrawString statusText, 16, GAME_H - 24, Color(0.91, 0.96, 1, 0.75), 16
End Sub
