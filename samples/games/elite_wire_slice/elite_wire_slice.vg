	Call canvas_hud.DrawVectorTextCentered(Vector2(cx, 224.0), "Q E  ROLL", ink, 1.35, 1.3, 2.0, "")
	Call canvas_hud.DrawVectorTextCentered(Vector2(cx, 256.0), "SPACE  LASER", ink, 1.2, 1.2, 1.8, "")
	Call canvas_hud.DrawVectorTextCentered(Vector2(cx, 288.0), "M  MISSILE", ink, 1.2, 1.2, 1.8, "")
	Call canvas_hud.DrawVectorTextCentered(Vector2(cx, 320.0), "J  HYPERSPACE   4 CREDITS", ink, 1.2, 1.2, 1.8, "")
