' Elite Wire Slice — Visual Gasic demo (C64 / Archimedes Elite *inspired*, not a port).
'
' REVIEWERS: This sample is intentionally INCOMPLETE. It is a solid starting point for
' wireframe flight + DrawRawWireMesh + a minimal trade loop, not a shippable game.
' Known issues include drawing artifacts on some OpenGL compatibility paths (line
' batching, solid segment quads, starfield), placeholder cockpit art, simplified
' economy/docking vs real Elite, and no galactic chart / fuel / equipment.
'
' Future improvements (see README): filled polygons or shaded vector faces on meshes
' for depth; better planet/station solids; scanner stalks; engine-side line batch
' fixes; bitmap-style cockpit panels without copying copyrighted Archimedes/C64 art.
'
' Layout: front view uses ViewCY / DashY — world projects above the console strip.
' Controls: W/S thrust, arrows yaw/pitch, Q/E roll (match Coriolis spin to dock).
Option Explicit

Import "res://scripts/EliteMeshes.vg"
Import "res://scripts/Sfx.vg"

Const ScreenW As Single = 960.0
Const ScreenH As Single = 540.0
Const ViewCY As Single = 200.0
Const DashY As Single = 424.0
Const RockCount As Integer = 6
Const CargoMax As Integer = 20
Const GoodCount As Integer = 8
Const StarCount As Integer = 72
Const ProjScale As Single = 420.0
Const PI As Single = 3.14159265
Const WIN_MODE_WINDOWED As Integer = 0
Const WIN_MODE_FULLSCREEN As Integer = 3
Const WIN_MODE_EXCLUSIVE As Integer = 4
' ViewCY = crosshair / projection center in the front window. DashY = cockpit top edge.

' Render targets (stacked in GameView) and UI font for cockpit labels.
Dim canvas_stars As Object
Dim canvas_world As Object
Dim canvas_hud As Object
Dim post_node As Object
Dim hud_font As Object

Dim star_x(StarCount - 1) As Single
Dim star_y(StarCount - 1) As Single
Dim star_z(StarCount - 1) As Single
Dim star_c(StarCount - 1) As Color

' Player ship state (world space; +Z is forward when yaw/pitch/roll = 0).
Dim sim_time As Single
Dim px As Single
Dim py As Single
Dim pz As Single
Dim yaw As Single
Dim pitch As Single
Dim roll As Single
Dim speed As Single
Dim hit_flash As Single

Dim rock_x(RockCount - 1) As Single
Dim rock_y(RockCount - 1) As Single
Dim rock_z(RockCount - 1) As Single
Dim rock_spin(RockCount - 1) As Single
Dim rock_phase(RockCount - 1) As Single
Dim rock_size(RockCount - 1) As Single
Dim rock_hits(RockCount - 1) As Integer
Dim view_x(RockCount - 1) As Single
Dim view_y(RockCount - 1) As Single
Dim view_z(RockCount - 1) As Single
Dim ord(RockCount - 1) As Integer

' Vitals, hyperspace timer, station, cargo / market scratch.
Dim energy As Single
Dim shield As Single
Dim jump_left As Single
Dim jump_arm As Single
Dim system_id As Integer
Dim StationX As Single
Dim StationY As Single
Dim StationZ As Single
Dim hold(GoodCount - 1) As Integer
Dim mkt_qty(GoodCount - 1) As Integer
Dim trade_i As Integer
Dim dock_hint As String
Dim laser_left As Single
Dim laser_cool As Single
Dim target_i As Integer
Dim laser_x1 As Single
Dim laser_y1 As Single
Dim docked As Boolean
Dim credits As Integer
Dim st_spin As Single
Dim st_vx As Single
Dim st_vy As Single
Dim st_vz As Single
Dim en_alive As Boolean
Dim en_x As Single
Dim en_y As Single
Dim en_z As Single
Dim en_vx As Single
Dim en_vy As Single
Dim en_vz As Single
Dim en_hits As Integer
Dim en_respawn As Single
Dim en_hit_cool As Single
' Heavy fighter (second hostile tier, spawns later than pirate).
Dim hv_alive As Boolean
Dim hv_x As Single
Dim hv_y As Single
Dim hv_z As Single
Dim hv_vx As Single
Dim hv_vy As Single
Dim hv_vz As Single
Dim hv_hits As Integer
Dim hv_respawn As Single
Dim hv_hit_cool As Single
Dim ms_on As Boolean
Dim ms_x As Single
Dim ms_y As Single
Dim ms_z As Single
Dim ms_vx As Single
Dim ms_vy As Single
Dim ms_vz As Single
Dim ms_life As Single
Dim ms_cool As Single
Dim on_title As Boolean
Dim on_help As Boolean
Dim on_options As Boolean
' Overlay modes pause flight updates but still draw.
Dim help_arm As Single
Dim opt_fullscreen As Boolean
Dim opt_invert As Boolean
Dim opt_sel As Integer
Dim scan_x As Single
Dim scan_y As Single
Dim mouse_l_was As Boolean
Dim mouse_r_was As Boolean
Dim mouse_l_edge As Boolean
Dim mouse_r_edge As Boolean
Dim mouse_l_held As Boolean
Dim boom_t As Single
Dim boom_x As Single
Dim boom_y As Single

' --- Bootstrap: SubViewports, options, save, initial field ---

Sub _Ready()
	Print("Elite Wire Slice — title")
	Call InitEliteMeshes()

	Set canvas_stars = CreateNode("VGVectorCanvas2D")
	Set canvas_world = CreateNode("VGVectorCanvas2D")
	Set canvas_hud = CreateNode("VGVectorCanvas2D")
	Dim game_view As Object
	Set game_view = GetNode("GameView")
	game_view.AddChild(canvas_stars)
	game_view.AddChild(canvas_world)
	game_view.AddChild(canvas_hud)
	canvas_world.SetBatchMode(True)
	Set hud_font = GetThemeDefaultFont()
	Set post_node = GetNode("Display")
	post_node.set("texture", game_view.get_texture())

	px = 0.0
	py = 0.0
	pz = 0.0
	yaw = 0.0
	pitch = 0.0
	roll = 0.0
	speed = 6.0
	hit_flash = 0.0
	energy = 100.0
	shield = 100.0
	jump_left = 0.0
	jump_arm = 0.0
	system_id = 0
	StationX = 0.0
	StationY = 0.0
	StationZ = 52.0
	laser_left = 0.0
	laser_cool = 0.0
	target_i = - 1
	docked = False
	credits = 100
	trade_i = 0
	dock_hint = ""
	st_spin = 0.0
	sim_time = 0.0
	on_title = True
	on_help = False
	on_options = False
	help_arm = 0.0
	opt_sel = 0
	opt_invert = True
	Call _LoadOptions()
	Call _ApplyDisplayMode()
	Call call_deferred("_ApplyDisplayMode")
	Call _LoadGame()
	Call _InitStars()
	Call _InitRocks()
	Call _ArmHostiles()
	Call _StockMarket()
	Call SfxTitle()
	Set_Process(True)
End Sub

Sub _InitStars()
	Randomize()
	Dim i As Integer
	For i = 0 To StarCount - 1
		Dim az As Single
		Dim el As Single
		az = Rnd() * PI * 2.0
		el = (Rnd() - 0.5) * PI
		Dim shell As Single
		shell = 70.0 + Rnd() * 40.0
		star_x(i) = Cos(el) * Sin(az) * shell
		star_y(i) = Sin(el) * shell
		star_z(i) = Cos(el) * Cos(az) * shell
		Dim b As Integer
		b = 150 + Int(Rnd() * 105)
		star_c(i) = Color8(b, b, b + 15)
	Next
End Sub

Sub _InitRocks()
	Dim i As Integer
	For i = 0 To RockCount - 1
		rock_spin(i) = 0.4 + Rnd() * 1.4
		If Rnd() < 0.5 Then rock_spin(i) = - rock_spin(i)
		rock_phase(i) = Rnd() * PI * 2.0
		rock_size(i) = 0.7 + Rnd() * 0.9
		Call _RespawnRock(i, 42.0 + Rnd() * 36.0)
	Next
End Sub

Sub _RespawnRock(ByVal i As Integer, ByVal ahead As Single)
	rock_x(i) = px + (Rnd() - 0.5) * 22.0
	rock_y(i) = py + (Rnd() - 0.5) * 12.0
	rock_z(i) = pz + ahead
	rock_hits(i) = 0
	Dim sdx As Single
	Dim sdy As Single
	Dim sdz As Single
	sdx = rock_x(i) - StationX
	sdy = rock_y(i) - StationY
	sdz = rock_z(i) - StationZ
	If sdx * sdx + sdy * sdy + sdz * sdz < 140.0 Then
		rock_z(i) = rock_z(i) - 26.0
	End If
End Sub

' --- Input edges for mouse fire / options (flight uses GetMouseX/Y in _PollFlight) ---

Sub _ReadMouse()
	Dim down As Boolean
	down = Input.IsMouseButtonPressed(1)
	mouse_l_edge = down And Not mouse_l_was
	mouse_l_was = down
	mouse_l_held = down
	down = Input.IsMouseButtonPressed(2)
	mouse_r_edge = down And Not mouse_r_was
	mouse_r_was = down
End Sub

' --- Main loop: title / help / options overlays, then flight sim + full redraw each frame ---

Sub _Process(ByVal delta As Single)
	Call _ReadMouse()
	sim_time = sim_time + delta
	st_spin = st_spin + delta * 0.22
	If help_arm > 0.0 Then help_arm = help_arm - delta
	If on_options Then
		If help_arm <= 0.0 Then Call _PollOptions()
		Call _DrawOptions()
		Exit Sub
	End If
	If on_help Then
		If help_arm <= 0.0 Then
			If IsKeyJustPressed(KEY_SPACE) Or IsKeyJustPressed(KEY_ENTER) Or IsKeyJustPressed(KEY_KP_ENTER) Or IsKeyJustPressed(KEY_H) Or IsKeyJustPressed(KEY_ESCAPE) Then
				on_help = False
				help_arm = 0.3
				Exit Sub
			End If
		End If
		Call _DrawHelp()
		Exit Sub
	End If
	If on_title Then
		If help_arm <= 0.0 And IsKeyJustPressed(KEY_O) Then
			on_options = True
			opt_sel = 0
			help_arm = 0.3
			Call _DrawOptions()
			Exit Sub
		End If
		If help_arm <= 0.0 And IsKeyJustPressed(KEY_H) Then
			on_help = True
			help_arm = 0.3
			Call _DrawHelp()
			Exit Sub
		End If
		If IsKeyJustPressed(KEY_SPACE) Or IsKeyJustPressed(KEY_ENTER) Or IsKeyJustPressed(KEY_KP_ENTER) Or mouse_l_edge Then
			on_title = False
			yaw = 0.0
			pitch = 0.0
			roll = 0.0
			Call SfxConfirm()
			Call _DrawFrame()
			Exit Sub
		End If
		Call _DrawTitle()
		Exit Sub
	End If
	If help_arm <= 0.0 And jump_left <= 0.0 And IsKeyJustPressed(KEY_O) Then
		on_options = True
		opt_sel = 0
		help_arm = 0.3
		Call _DrawOptions()
		Exit Sub
	End If
	If help_arm <= 0.0 And jump_left <= 0.0 And IsKeyJustPressed(KEY_H) Then
		on_help = True
		help_arm = 0.3
		Call _DrawHelp()
		Exit Sub
	End If
	If jump_arm > 0.0 Then jump_arm = jump_arm - delta
	Call _PollFlight(delta)
	If jump_left > 0.0 Then
		jump_left = jump_left - delta
		If jump_left <= 0.0 Then Call _Arrive()
		Call _DrawFrame()
		Exit Sub
	End If
	Call _UpdateStation()
	If Not docked Then
		Call _UpdatePirate(delta)
		Call _UpdateHeavy(delta)
		Call _UpdateMissile(delta)
		Call _UpdateRocks()
		Call _Mine()
		If ms_cool > 0.0 Then ms_cool = ms_cool - delta
		If laser_left > 0.0 Then laser_left = laser_left - delta
		If laser_cool > 0.0 Then laser_cool = laser_cool - delta
		If boom_t > 0.0 Then boom_t = boom_t - delta
		energy = energy + 10.0 * delta
		If energy > 100.0 Then energy = 100.0
		shield = shield + 8.0 * delta
		If shield > 100.0 Then shield = 100.0
	End If
	Call _DrawFrame()
End Sub

Sub _SyncPost()
End Sub

' --- Flight: keyboard + mouse (small dead zone in front window only). opt_invert = C64 stick. ---

Sub _PollFlight(ByVal delta As Single)
	If docked Then
		Call _PollDock()
		Exit Sub
	End If
	If jump_left <= 0.0 And jump_arm <= 0.0 And speed < 9.0 And credits >= 4 Then
		If Input.IsKeyPressed(KEY_J) Then
			credits = credits - 4
			jump_left = 1.7
			jump_arm = 0.5
			Call SfxJump()
			Exit Sub
		End If
	End If
	Dim turn As Single
	turn = 1.15 * delta
	If Input.IsKeyPressed(KEY_LEFT) Then yaw = yaw - turn
	If Input.IsKeyPressed(KEY_RIGHT) Then yaw = yaw + turn
	Dim psign As Single
	psign = 1.0
	If Not opt_invert Then psign = - 1.0
	If Input.IsKeyPressed(KEY_UP) Then pitch = pitch + turn * psign
	If Input.IsKeyPressed(KEY_DOWN) Then pitch = pitch - turn * psign
	If Input.IsKeyPressed(KEY_Q) Then roll = roll - turn * 1.4
	If Input.IsKeyPressed(KEY_E) Then roll = roll + turn * 1.4
	Do While roll > PI
		roll = roll - PI * 2.0
	Loop
	Do While roll < - PI
		roll = roll + PI * 2.0
	Loop

	Dim mx As Single
	Dim my As Single
	mx = GetMouseX()
	my = GetMouseY()
	If mx >= 0.0 And mx <= ScreenW And my >= 0.0 And my < DashY Then
		Dim dx As Single
		Dim dy As Single
		Dim dead As Single
		dead = 8.0
		dx = mx - ScreenW * 0.5
		dy = my - ViewCY
		If dx > dead Then
			yaw = yaw + (dx - dead) / 220.0 * 1.35 * delta
		ElseIf dx < - dead Then
			yaw = yaw + (dx + dead) / 220.0 * 1.35 * delta
		End If
		If dy > dead Then
			pitch = pitch - (dy - dead) / 180.0 * 1.35 * delta * psign
		ElseIf dy < - dead Then
			pitch = pitch - (dy + dead) / 180.0 * 1.35 * delta * psign
		End If
	End If

	If pitch > 1.2 Then pitch = 1.2
	If pitch < - 1.2 Then pitch = - 1.2

	If Input.IsKeyPressed(KEY_W) Then
		speed = speed + 14.0 * delta
	ElseIf Input.IsKeyPressed(KEY_S) Then
		speed = speed - 18.0 * delta
	Else
		speed = speed - 2.5 * delta
	End If
	If speed < 0.0 Then speed = 0.0
	If speed > 28.0 Then speed = 28.0

	Dim fx As Single
	Dim fy As Single
	Dim fz As Single
	fx = Sin(yaw)
	fy = - Cos(yaw) * Sin(pitch)
	fz = Cos(yaw) * Cos(pitch)
	px = px + fx * speed * delta
	py = py + fy * speed * delta
	pz = pz + fz * speed * delta
	If hit_flash > 0.0 Then hit_flash = hit_flash - delta
	Call SfxTick(delta, Input.IsKeyPressed(KEY_W), speed)
	If ms_cool <= 0.0 And Not ms_on And energy >= 6.0 Then
		If Input.IsKeyPressed(KEY_M) Or mouse_r_edge Then Call _LaunchMissile()
	End If
End Sub

' Inverse of the canvas Y-then-X-then-Z rotation, so world deltas land in view space.
' --- Camera: Y-then-X-then-Z rotation; view +Z is ahead (matches EliteMeshes) ---

Sub WorldToView(ByVal dx As Single, ByVal dy As Single, ByVal dz As Single, ByRef vx As Single, ByRef vy As Single, ByRef vz As Single)
	Dim cr As Single
	Dim sr As Single
	cr = Cos(- roll)
	sr = Sin(- roll)
	Dim x1 As Single
	Dim y1 As Single
	x1 = dx * cr - dy * sr
	y1 = dx * sr + dy * cr
	Dim cp As Single
	Dim sp As Single
	cp = Cos(- pitch)
	sp = Sin(- pitch)
	Dim y2 As Single
	Dim z2 As Single
	y2 = y1 * cp - dz * sp
	z2 = y1 * sp + dz * cp
	Dim cy As Single
	Dim sy As Single
	cy = Cos(- yaw)
	sy = Sin(- yaw)
	vx = x1 * cy + z2 * sy
	vy = y2
	vz = - x1 * sy + z2 * cy
End Sub

' --- Hyperspace: arm with fuel cells, jump to next system (hand-placed list) ---

Sub _Launch()
	docked = False
	px = StationX
	py = StationY
	pz = StationZ - 16.0
	yaw = 0.0
	pitch = 0.0
	roll = 0.0
	speed = 6.0
	energy = 100.0
	shield = 100.0
	Call SfxLaunch()
End Sub

Sub _ApplySystem()
	If system_id < 0 Then system_id = 0
	If system_id > 7 Then system_id = 0
	If system_id = 1 Then
		StationX = 22.0
		StationY = - 6.0
		StationZ = 46.0
	ElseIf system_id = 2 Then
		StationX = - 16.0
		StationY = 9.0
		StationZ = 58.0
	ElseIf system_id = 3 Then
		StationX = 10.0
		StationY = 4.0
		StationZ = 38.0
	ElseIf system_id = 4 Then
		StationX = - 24.0
		StationY = - 4.0
		StationZ = 50.0
	ElseIf system_id = 5 Then
		StationX = 8.0
		StationY = 14.0
		StationZ = 42.0
	ElseIf system_id = 6 Then
		StationX = 30.0
		StationY = 2.0
		StationZ = 64.0
	ElseIf system_id = 7 Then
		StationX = - 8.0
		StationY = - 12.0
		StationZ = 36.0
	Else
		StationX = 0.0
		StationY = 0.0
		StationZ = 52.0
	End If
	Call _StockMarket()
End Sub

' --- Persistence: v2 save = credits, system, 8 hold slots. Options = fullscreen + invert pitch ---

Sub _SaveGame()
	Dim body As String
	Dim i As Integer
	body = "v2" & Chr(10) & Str(credits) & Chr(10) & Str(system_id)
	For i = 0 To GoodCount - 1
		body = body & Chr(10) & Str(hold(i))
	Next
	WriteAllText "user://elite_wire_slice.txt", body
End Sub

Sub _LoadGame()
	If Not FileExists("user://elite_wire_slice.txt") Then Exit Sub
	Dim lines As Array
	lines = ReadLines("user://elite_wire_slice.txt")
	If UBound(lines) < 2 Then Exit Sub
	Dim i As Integer
	If Trim(lines(0)) = "v2" Then
		If UBound(lines) < 2 + GoodCount Then Exit Sub
		credits = Val(lines(1))
		system_id = Val(lines(2))
		For i = 0 To GoodCount - 1
			hold(i) = Val(lines(3 + i))
		Next
	Else
		credits = Val(lines(0))
		system_id = Val(lines(1))
		hold(2) = Val(lines(2))
	End If
	Call _ApplySystem()
End Sub

Sub _LoadOptions()
	opt_fullscreen = False
	opt_invert = True
	If Not FileExists("user://elite_wire_slice_options.txt") Then Exit Sub
	Dim lines As Array
	lines = ReadLines("user://elite_wire_slice_options.txt")
	If UBound(lines) < 0 Then Exit Sub
	Dim line As String
	line = Trim(lines(0))
	If line = "1" Or line = "fullscreen=1" Or line = "true" Then opt_fullscreen = True
	If UBound(lines) >= 1 Then
		line = Trim(lines(1))
		If line = "0" Then opt_invert = False
	End If
End Sub

Sub _SaveOptions()
	Dim flag As String
	Dim inv As String
	If opt_fullscreen Then
		flag = "1"
	Else
		flag = "0"
	End If
	If opt_invert Then
		inv = "1"
	Else
		inv = "0"
	End If
	WriteAllText "user://elite_wire_slice_options.txt", flag & Chr(10) & inv
End Sub

Sub _ApplyDisplayMode()
	If DisplayServer.get_name() = "headless" Then Exit Sub
	If opt_fullscreen Then
		Screen.FullScreen True
	Else
		Screen.FullScreen False
	End If
	Dim vp As Object
	Set vp = Me.GetViewport()
	If vp = Null Then Exit Sub
	Dim win As Object
	Set win = vp.GetWindow()
	If win = Null Then Exit Sub
	If opt_fullscreen Then
		win.mode = WIN_MODE_FULLSCREEN
		If win.mode <> WIN_MODE_FULLSCREEN Then win.mode = WIN_MODE_EXCLUSIVE
	Else
		win.mode = WIN_MODE_WINDOWED
	End If
End Sub

Sub _Arrive()
	system_id = system_id + 1
	If system_id > 7 Then system_id = 0
	px = 0.0
	py = 0.0
	pz = 0.0
	yaw = 0.0
	pitch = 0.0
	roll = 0.0
	speed = 5.0
	Call _ApplySystem()
	Call _InitRocks()
	Call _ArmHostiles()
	Call _SaveGame()
End Sub

' --- Trade (C64-style hold): simplified 8 goods; not the full 17-good price table ---

Sub _StockMarket()
	Dim i As Integer
	For i = 0 To GoodCount - 1
		mkt_qty(i) = 6 + (system_id * 3 + i * 5) Mod 10
	Next
End Sub

Function _GoodName(ByVal i As Integer) As String
	If i = 0 Then
		_GoodName = "FOOD"
	ElseIf i = 1 Then
		_GoodName = "TEXTILES"
	ElseIf i = 2 Then
		_GoodName = "MINERALS"
	ElseIf i = 3 Then
		_GoodName = "ALLOYS"
	ElseIf i = 4 Then
		_GoodName = "COMPUTERS"
	ElseIf i = 5 Then
		_GoodName = "LUXURIES"
	ElseIf i = 6 Then
		_GoodName = "GOLD"
	Else
		_GoodName = "GEMS"
	End If
End Function

Function _GoodPrice(ByVal i As Integer) As Integer
	Dim base As Integer
	base = 8
	If i = 1 Then base = 16
	If i = 2 Then base = 18
	If i = 3 Then base = 28
	If i = 4 Then base = 52
	If i = 5 Then base = 42
	If i = 6 Then base = 70
	If i = 7 Then base = 90
	Dim wobble As Integer
	wobble = (system_id * 5 + i * 7) Mod 17 - 8
	_GoodPrice = base + wobble
	If _GoodPrice < 4 Then _GoodPrice = 4
End Function

Function _HoldUsed() As Integer
	Dim n As Integer
	Dim i As Integer
	n = 0
	For i = 0 To GoodCount - 1
		n = n + hold(i)
	Next
	_HoldUsed = n
End Function

' Docking gate: player roll within tolerance of station spin (see _UpdateStation).

Function _RollMatches() As Boolean
	Dim d As Single
	d = roll - st_spin
	Do While d > PI
		d = d - PI * 2.0
	Loop
	Do While d < - PI
		d = d + PI * 2.0
	Loop
	If d < 0.0 Then d = - d
	If d > PI * 0.5 Then d = PI - d
	_RollMatches = d < 0.4
End Function

' --- Hostiles: timers in sim_time; long gaps so early flight stays calm ---

Sub _ArmHostiles()
	en_alive = False
	en_respawn = 24.0
	hv_alive = False
	hv_respawn = 42.0
End Sub

Sub _PollDock()
	If IsKeyJustPressed(KEY_UP) Then trade_i = trade_i - 1
	If IsKeyJustPressed(KEY_DOWN) Then trade_i = trade_i + 1
	If trade_i < 0 Then trade_i = GoodCount - 1
	If trade_i > GoodCount - 1 Then trade_i = 0
	If IsKeyJustPressed(KEY_B) Then Call _BuyGood()
	If IsKeyJustPressed(KEY_S) Then Call _SellGood()
	If IsKeyJustPressed(KEY_L) Then Call _Launch()
End Sub

Sub _BuyGood()
	Dim p As Integer
	p = _GoodPrice(trade_i)
	If credits < p Then Exit Sub
	If _HoldUsed() >= CargoMax Then Exit Sub
	If mkt_qty(trade_i) <= 0 Then Exit Sub
	credits = credits - p
	mkt_qty(trade_i) = mkt_qty(trade_i) - 1
	hold(trade_i) = hold(trade_i) + 1
	Call SfxConfirm()
	Call _SaveGame()
End Sub

Sub _SellGood()
	If hold(trade_i) <= 0 Then Exit Sub
	Dim p As Integer
	p = _GoodPrice(trade_i)
	hold(trade_i) = hold(trade_i) - 1
	mkt_qty(trade_i) = mkt_qty(trade_i) + 1
	credits = credits + p
	Call SfxChip()
	Call _SaveGame()
End Sub

Sub _ScoopMinerals()
	If _HoldUsed() >= CargoMax Then Exit Sub
	hold(2) = hold(2) + 1
End Sub

' --- Docking: slow approach, slot aligned, roll matched to st_spin (Coriolis). No auto-sell. ---

Sub _UpdateStation()
	Call WorldToView(StationX - px, StationY - py, StationZ - pz, st_vx, st_vy, st_vz)
	If docked Then Exit Sub
	dock_hint = ""
	If st_vz < 2.0 Or st_vz > 16.0 Then Exit Sub
	If st_vx * st_vx + st_vy * st_vy > 36.0 Then Exit Sub
	If st_vx * st_vx + st_vy * st_vy > 9.0 Then
		dock_hint = "LINE UP ON THE SLOT"
		Exit Sub
	End If
	If speed > 4.2 Then
		dock_hint = "TOO FAST"
		Exit Sub
	End If
	If Not _RollMatches() Then
		dock_hint = "MATCH ROLL  Q AND E"
		Exit Sub
	End If
	docked = True
	speed = 0.0
	trade_i = 0
	energy = 100.0
	shield = 100.0
	dock_hint = ""
	Call SfxDock()
	Call _SaveGame()
End Sub

' --- Overlays: title, help, options (O) — block _PollFlight while visible ---

Sub _DrawTitle()
	Call _SyncPost()
	canvas_stars.Clear()
	canvas_world.Clear()
	canvas_hud.Clear()
	yaw = Sin(sim_time * 0.35) * 0.35
	pitch = Sin(sim_time * 0.22) * 0.12
	Call _DrawStars()

	Dim cx As Single
	Dim cy As Single
	cx = ScreenW * 0.5
	cy = ScreenH * 0.46
	Dim ship_col As Color
	ship_col = Color8(230, 245, 255)
	Call DrawTraderShip(canvas_world, sim_time * 0.55, sim_time * 0.35, Sin(sim_time * 0.8) * 0.4, cx, cy, ProjScale * 0.85, ship_col, 0.0, 0.15, 4.2)

	Dim orbit As Single
	orbit = sim_time * 0.7
	Dim rock_col As Color
	rock_col = Color8(255, 196, 120)
	Call DrawRock(canvas_world, orbit, orbit * 1.3, 0.4, cx, cy, ProjScale * 0.45, rock_col, Cos(orbit) * 5.5, Sin(orbit * 2.0) * 1.2, 7.5 + Sin(orbit) * 1.5)
	Call DrawRock(canvas_world, - orbit, orbit * 0.6, 1.1, cx, cy, ProjScale * 0.28, rock_col, - Cos(orbit) * 4.0, 0.8, 9.0)
	Call canvas_hud.DrawCircle(Vector2(cx, cy + 20.0), 108.0 + Sin(sim_time * 1.6) * 6.0, Color(0.35, 0.65, 0.9, 1.0), False, Color(0.0, 0.0, 0.0, 0.0))

	Dim brand As Color
	brand = Color(0.45, 0.82, 1.0, 1.0)
	Call canvas_hud.DrawVectorTextFlip("NARCEAN TECHNOLOGIES", 78.0, 78.0, sim_time, brand, 1.55, 1.7, 36.0, 1.15, 0.42, "")
	Call canvas_hud.DrawVectorTextCentered(Vector2(cx, 148.0), "ELITE WIRE", Color(1.0, 0.92, 0.72, 1.0), 2.6, 2.2, 3.2, "")
	Call canvas_hud.DrawVectorTextCentered(Vector2(cx, 196.0), "MADE IN VISUAL GASIC (BASIC)", Color(0.55, 0.78, 0.95, 0.95), 1.05, 1.15, 1.6, "")

	Dim blink As Single
	blink = Sin(sim_time * 3.2)
	Call canvas_hud.DrawVectorTextCentered(Vector2(cx, ScreenH - 96.0), "H HELP    O OPTIONS", Color(0.55, 0.75, 0.9, 0.9), 1.15, 1.15, 1.8, "")
	If blink > 0.0 Then
		Call canvas_hud.DrawVectorTextCentered(Vector2(cx, ScreenH - 58.0), "PRESS SPACE", Color(0.75, 0.95, 1.0, 0.9), 1.35, 1.3, 2.0, "")
	End If
End Sub

