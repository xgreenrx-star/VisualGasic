' Defender Clone - Side-scrolling Space Shooter
' Made with VisualGasic

Option Explicit

' Game objects
Dim Player As Object
Dim ScoreLabel As Object
Dim LivesLabel As Object
Dim GameOverLabel As Object

' Player state
Dim PlayerX As Single
Dim PlayerY As Single
Dim PlayerVelX As Single
Dim PlayerVelY As Single
Dim PlayerLives As Integer
Dim PlayerSpeed As Single

' Game state
Dim Score As Integer
Dim GameOver As Boolean
Dim CameraX As Single
Dim WorldWidth As Single

' Arrays for game objects
Dim Enemies(20) As Object
Dim Bullets(50) As Object
Dim EnemyBullets(50) As Object
Dim Stars(100) As Object

' Timers
Dim SpawnTimer As Single
Dim ShootCooldown As Single

Sub _Ready()
	' Initialize player
	Player = GetNode("Player")
	Player.position = Vector2(200, 300)
	Player.color = Color(0.2, 0.8, 0.2)
	Player.size = Vector2(40, 20)
	
	' Initialize UI
	ScoreLabel = GetNode("UI/ScoreLabel")
	LivesLabel = GetNode("UI/LivesLabel")
	GameOverLabel = GetNode("UI/GameOverLabel")
	GameOverLabel.visible = False
	
	' Game setup
	PlayerX = 200
	PlayerY = 300
	PlayerVelX = 0
	PlayerVelY = 0
	PlayerSpeed = 300
	PlayerLives = 30
	Score = 0
	GameOver = False
	CameraX = 0
	WorldWidth = 4000
	SpawnTimer = 0
	ShootCooldown = 0
	
	' Create starfield background
	Dim i As Integer
	For i = 0 To 99
		Stars(i) = GetNode("Stars").get_child(i)
		Stars(i).position = Vector2(Rnd() * WorldWidth, Rnd() * 600)
		Stars(i).color = Color(1, 1, 1, 0.5 + Rnd() * 0.5)
		Stars(i).size = Vector2(2, 2)
	Next i
	
	Print "Defender Ready! Use Arrow Keys to move, Space to shoot"
	Set_Process(True)
End Sub

Sub _Process(delta As Single)
	If GameOver Then
		If Input.IsActionJustPressed("ui_accept") Then
			' Restart game
			GetTree().reload_current_scene()
		End If
		Exit Sub
	End If
	
	' Update timers
	SpawnTimer = SpawnTimer + delta
	If ShootCooldown > 0 Then
		ShootCooldown = ShootCooldown - delta
	End If
	
	' Player input
	PlayerVelX = 0
	PlayerVelY = 0
	
	If Input.IsActionPressed("ui_right") Then
		PlayerVelX = PlayerSpeed
	End If
	If Input.IsActionPressed("ui_left") Then
		PlayerVelX = -PlayerSpeed
	End If
	If Input.IsActionPressed("ui_down") Then
		PlayerVelY = PlayerSpeed
	End If
	If Input.IsActionPressed("ui_up") Then
		PlayerVelY = -PlayerSpeed
	End If
	
	' Shoot
	If Input.IsActionPressed("ui_accept") And ShootCooldown <= 0 Then
		Call SpawnBullet(PlayerX + 40, PlayerY)
		ShootCooldown = 0.15
	End If
	
	' Update player position
	PlayerX = PlayerX + PlayerVelX * delta
	PlayerY = PlayerY + PlayerVelY * delta
	
	' Clamp player to screen
	If PlayerY < 0 Then PlayerY = 0
	If PlayerY > 580 Then PlayerY = 580
	If PlayerX < CameraX Then PlayerX = CameraX
	If PlayerX > CameraX + 1004 Then PlayerX = CameraX + 1004
	
	Player.position = Vector2(PlayerX, PlayerY)
	
	' Update camera to follow player
	CameraX = PlayerX - 300
	If CameraX < 0 Then CameraX = 0
	If CameraX > WorldWidth - 1024 Then CameraX = WorldWidth - 1024
	
	Dim cam As Object
	cam = GetNode("Camera2D")
	cam.position = Vector2(CameraX + 512, 300)
	
	' Parallax stars
	Dim i As Integer
	For i = 0 To 99
		If Not Stars(i) Is Nothing Then
			Dim starPos As Object
			starPos = Stars(i).position
			' Wrap stars
			If starPos.x < CameraX - 100 Then
				Stars(i).position = Vector2(starPos.x + WorldWidth + 200, starPos.y)
			ElseIf starPos.x > CameraX + 1124 Then
				Stars(i).position = Vector2(starPos.x - WorldWidth - 200, starPos.y)
			End If
		End If
	Next i
	
	' Spawn enemies
	If SpawnTimer > 2.0 Then
		Call SpawnEnemy()
		SpawnTimer = 0
	End If
	
	' Update enemies
	For i = 0 To 19
		If Not Enemies(i) Is Nothing Then
			Dim ePos As Object
			ePos = Enemies(i).position
			Dim ex As Single
			Dim ey As Single
			ex = ePos.x
			ey = ePos.y
			
			' Simple AI - move toward player
			If ex < PlayerX Then
				ex = ex + 100 * delta
			Else
				ex = ex - 100 * delta
			End If
			
			If ey < PlayerY Then
				ey = ey + 50 * delta
			Else
				ey = ey - 50 * delta
			End If
			
			Enemies(i).position = Vector2(ex, ey)
			
			' Enemy shoots occasionally
			If Rnd() < 0.01 Then
				Call SpawnEnemyBullet(ex, ey)
			End If
			
			' Check collision with player
			Dim dist As Single
			dist = Sqr((ex - PlayerX) * (ex - PlayerX) + (ey - PlayerY) * (ey - PlayerY))
			If dist < 30 Then
				Call HitPlayer()
				Call DestroyEnemy(i)
			End If
			
			' Remove if off screen
			If ex < CameraX - 200 Or ex > CameraX + 1224 Then
				Call DestroyEnemy(i)
			End If
		End If
	Next i
	
	' Update bullets
	For i = 0 To 49
		If Not Bullets(i) Is Nothing Then
			Dim bPos As Object
			bPos = Bullets(i).position
			Dim bx As Single
			bx = bPos.x + 600 * delta
			Bullets(i).position = Vector2(bx, bPos.y)
			
			' Check collision with enemies
			Dim j As Integer
			For j = 0 To 19
				If Not Enemies(j) Is Nothing Then
					Dim ePos2 As Object
					ePos2 = Enemies(j).position
					Dim dist2 As Single
					dist2 = Sqr((bx - ePos2.x) * (bx - ePos2.x) + (bPos.y - ePos2.y) * (bPos.y - ePos2.y))
					If dist2 < 20 Then
						Call DestroyEnemy(j)
						Call DestroyBullet(i)
						Score = Score + 100
						Exit For
					End If
				End If
			Next j
			
			' Remove if off screen
			If bx > CameraX + 1224 Then
				Call DestroyBullet(i)
			End If
		End If
	Next i
	
	' Update enemy bullets
	For i = 0 To 49
		If Not EnemyBullets(i) Is Nothing Then
			Dim ebPos As Object
			ebPos = EnemyBullets(i).position
			Dim ebx As Single
			ebx = ebPos.x - 400 * delta
			EnemyBullets(i).position = Vector2(ebx, ebPos.y)
			
			' Check collision with player
			Dim pdist As Single
			pdist = Sqr((ebx - PlayerX) * (ebx - PlayerX) + (ebPos.y - PlayerY) * (ebPos.y - PlayerY))
			If pdist < 25 Then
				Call HitPlayer()
				Call DestroyEnemyBullet(i)
			End If
			
			' Remove if off screen
			If ebx < CameraX - 100 Then
				Call DestroyEnemyBullet(i)
			End If
		End If
	Next i
	
	' Update UI
	ScoreLabel.text = "Score: " & CStr(Score)
	LivesLabel.text = "Lives: " & CStr(PlayerLives)
End Sub

Sub SpawnEnemy()
	Dim i As Integer
	For i = 0 To 19
		If Enemies(i) Is Nothing Then
			Enemies(i) = GetNode("Enemies").get_child(i)
			Enemies(i).visible = True
			' Spawn ahead of camera
			Enemies(i).position = Vector2(CameraX + 1024 + Rnd() * 200, Rnd() * 500 + 50)
			Enemies(i).color = Color(1, 0.2, 0.2)
			Enemies(i).size = Vector2(30, 30)
			Exit Sub
		End If
	Next i
End Sub

Sub DestroyEnemy(index As Integer)
	If Not Enemies(index) Is Nothing Then
		Enemies(index).visible = False
		Enemies(index) = Nothing
	End If
End Sub

Sub SpawnBullet(x As Single, y As Single)
	Dim i As Integer
	For i = 0 To 49
		If Bullets(i) Is Nothing Then
			Bullets(i) = GetNode("Bullets").get_child(i)
			Bullets(i).visible = True
			Bullets(i).position = Vector2(x, y)
			Bullets(i).color = Color(1, 1, 0)
			Bullets(i).size = Vector2(10, 4)
			Exit Sub
		End If
	Next i
End Sub

Sub DestroyBullet(index As Integer)
	If Not Bullets(index) Is Nothing Then
		Bullets(index).visible = False
		Bullets(index) = Nothing
	End If
End Sub

Sub SpawnEnemyBullet(x As Single, y As Single)
	Dim i As Integer
	For i = 0 To 49
		If EnemyBullets(i) Is Nothing Then
			EnemyBullets(i) = GetNode("EnemyBullets").get_child(i)
			EnemyBullets(i).visible = True
			EnemyBullets(i).position = Vector2(x, y)
			EnemyBullets(i).color = Color(1, 0.5, 0)
			EnemyBullets(i).size = Vector2(8, 4)
			Exit Sub
		End If
	Next i
End Sub

Sub DestroyEnemyBullet(index As Integer)
	If Not EnemyBullets(index) Is Nothing Then
		EnemyBullets(index).visible = False
		EnemyBullets(index) = Nothing
	End If
End Sub

Sub HitPlayer()
	PlayerLives = PlayerLives - 1
	If PlayerLives <= 0 Then
		GameOver = True
		GameOverLabel.visible = True
		GameOverLabel.text = "GAME OVER - Score: " & CStr(Score) & vbNewLine & "Press SPACE to restart"
	End If
End Sub
