' =============================================================================
' GameManager.vg — autoload singleton (global game state)
' =============================================================================
' Registered in project.godot [autoload]. Every script reads/writes here:
'   player_stats, player_weapons, wave, game_state, scene caches, etc.
'
' Pattern for your own games: one autoload Dictionary for stats + Event/RaiseEvent
' for decoupled UI (Main.vg Connect GameManager, "player_died", …).
' Shop UI is GDScript (Shop.gd) but calls snake_case mirrors of these subs.
' =============================================================================
Extends Node

' --- Events (Connect from Main.vg or other listeners) ---
Event wave_changed(wave_number As Integer)
Event player_died()
Event game_won()
Event boss_killed(ability As String)
Event request_shake(amount As Single)

Public TOTAL_WAVES As Integer
Public MAX_WEAPON_SLOTS As Integer
Public WEAPONS_IN_SHOP As Integer
Public MAX_TIER As Integer
Public COMBINE_REQUIRED As Integer

Public wave As Integer
Public game_state As String
Public selected_character As String

Public player_stats As Object
Public body_upgrades As Object
Public owned_items As Variant
Public player_weapons As Variant
Public combat_live_enemies As Variant
Public combat_frame As Integer
Public combat_mob_count As Integer
Public kenney_tex_cache As Object
Public kenney_mat_cache As Object
Public vfx_scene_cache As Object
Public scene_cache As Object

Public WEAPON_DEFS As Variant
Public CHARACTER_DEFS As Variant
Public CHARACTER_COUNT As Integer
Public CharIds As Variant
Public CharNames As Variant
Public CharDescs As Variant
Public CharTints As Variant
Public CharStartWeapons As Variant
Public BODY_UPGRADES As Variant
Public SHOP_ITEMS As Variant
Public TIER_DAMAGE_MULT As Variant
Public TIER_COOLDOWN_MULT As Variant
Public TIER_COST_MULT As Variant
Public TIER_SELL_REFUND As Single
Public TIER_COLORS As Variant
Public TIER_NAMES As Variant

Const KENNEY_TEX_DIR As String = "res://assets/models/kenney_blocky/textures/"

' --- Boot: constants, empty collections, init data tables ---
Sub _Ready()
	Me.process_mode = 3
	TOTAL_WAVES = 20
	MAX_WEAPON_SLOTS = 6
	WEAPONS_IN_SHOP = 4
	MAX_TIER = 4
	COMBINE_REQUIRED = 2
	TIER_SELL_REFUND = 0.5
	wave = 1
	game_state = "title"
	selected_character = "balanced"
	Set body_upgrades = New Dictionary
	owned_items = Array()
	player_weapons = Array()
	combat_live_enemies = Array()
	combat_frame = 0
	combat_mob_count = 0
	Set kenney_tex_cache = New Dictionary
	Set kenney_mat_cache = New Dictionary
	Set vfx_scene_cache = Nothing
	Set scene_cache = New Dictionary
	TIER_DAMAGE_MULT = Array(1.0, 1.5, 2.2, 3.2)
	TIER_COOLDOWN_MULT = Array(1.0, 0.9, 0.8, 0.7)
	TIER_COST_MULT = Array(1.0, 2.0, 3.5, 6.0)
	TIER_COLORS = Array(Color(0.75, 0.75, 0.75), Color(0.4, 0.8, 0.4), Color(0.4, 0.6, 1.0), Color(0.85, 0.5, 1.0))
	TIER_NAMES = Array("I", "II", "III", "IV")
	Call InitWeaponDefs
	Call InitCharacterDefs
	Call InitBodyUpgrades
	Call InitShopItems
	Call ResetPlayerStats
End Sub

' Fresh stat block — keys used across Player, Enemy, HUD, Shop.
Sub ResetPlayerStats()
	Set player_stats = New Dictionary
	player_stats("max_hp") = 100
	player_stats("hp") = 100
	player_stats("armor") = 0
	player_stats("speed") = 200.0
	player_stats("damage") = 0
	player_stats("attack_speed") = 0.0
	player_stats("range") = 0.0
	player_stats("pierce") = 0
	player_stats("damage_pct") = 0.0
	player_stats("attack_speed_pct") = 0.0
	player_stats("range_pct") = 0.0
	player_stats("pierce_bonus") = 0
	player_stats("lifesteal") = 0.0
	player_stats("dodge") = 0.0
	player_stats("materials_pct") = 0.0
	player_stats("level") = 1
	player_stats("xp") = 0
	player_stats("xp_next") = 30
	player_stats("materials") = 0
	player_stats("total_kills") = 0
	player_stats("total_damage") = 0.0
End Sub

' New run after character pick — applies character mods + starting weapon.
Sub Reset()
	wave = 1
	Set body_upgrades = New Dictionary
	owned_items = Array()
	player_weapons = Array()
	Call ResetPlayerStats
	Dim ci As Integer
	ci = FindCharacterIndex(selected_character)
	Call ApplyCharacterModsAt(ci)
	player_stats("hp") = player_stats("max_hp")
	Call AddWeapon(CharStartWeapons(ci), 1)
End Sub

Sub EmitPlayerDied()
	RaiseEvent player_died()
End Sub

Sub EmitGameWon()
	RaiseEvent game_won()
End Sub

Sub EmitBossKilled(ability As String)
	RaiseEvent boss_killed(ability)
End Sub

Sub EmitRequestShake(amount As Single)
	RaiseEvent request_shake(amount)
End Sub

Sub EmitWaveChanged(n As Integer)
	RaiseEvent wave_changed(n)
End Sub

' --- Wave tuning (WaveManager3D reads these) ---
Function GetWaveDuration() As Single
	GetWaveDuration = Min(20.0 + wave * 3.0, 60.0)
End Function

Function GetSpawnInterval() As Single
	GetSpawnInterval = Max(0.45, 1.2 - wave * 0.035)
End Function

' Level-up loop — mutates player_stats in place; plays level_up sfx.
Sub AddXp(amount As Integer)
	player_stats("xp") = Int(player_stats("xp")) + amount
	Do While player_stats("xp") >= player_stats("xp_next")
		If Int(player_stats("xp_next")) < 1 Then Exit Do
		player_stats("xp") = Int(player_stats("xp")) - Int(player_stats("xp_next"))
		player_stats("level") = Int(player_stats("level")) + 1
		player_stats("xp_next") = Int(Int(player_stats("xp_next")) * 1.4)
		player_stats("max_hp") = Int(player_stats("max_hp")) + 5
		Dim hp As Single
		hp = player_stats("hp") + 10.0
		If hp > player_stats("max_hp") Then hp = player_stats("max_hp")
		player_stats("hp") = hp
		AudioBus.Play("level_up")
	Loop
End Sub

' --- Characters (title screen grid in Main.vg) ---
Function GetCharacterDef(charId As String) As Object
	Dim d As Object
	Set d = New Dictionary
	Dim i As Integer
	i = FindCharacterIndex(charId)
	d("id") = CharIds(i)
	d("name") = CharNames(i)
	d("desc") = CharDescs(i)
	d("tint") = CharTints(i)
	d("start_weapon") = CharStartWeapons(i)
	Set GetCharacterDef = d
End Function

Function GetSelectedCharacter() As Object
	Set GetSelectedCharacter = GetCharacterDef(selected_character)
End Function

Function CharacterIdAt(i As Integer) As String
	CharacterIdAt = CharIds(i)
End Function

Function CharacterNameAt(i As Integer) As String
	CharacterNameAt = CharNames(i)
End Function

Function CharacterDescAt(i As Integer) As String
	CharacterDescAt = CharDescs(i)
End Function

Function CharacterTintAt(i As Integer) As Color
	CharacterTintAt = CharTints(i)
End Function

Function CharacterStartWeaponAt(i As Integer) As String
	CharacterStartWeaponAt = CharStartWeapons(i)
End Function

' Index 0 = balanced (no extra mods). Others tweak stat dictionary at run start.
Sub ApplyCharacterModsAt(i As Integer)
	Select Case i
		Case 1
			player_stats("max_hp") = Int(player_stats("max_hp")) + 40
			player_stats("armor") = Int(player_stats("armor")) + 4
			player_stats("speed") = player_stats("speed") - 25.0
		Case 2
			player_stats("attack_speed_pct") = player_stats("attack_speed_pct") + 0.25
			player_stats("damage_pct") = player_stats("damage_pct") + 0.10
			player_stats("max_hp") = Int(player_stats("max_hp")) - 20
		Case 3
			player_stats("range_pct") = player_stats("range_pct") + 0.40
			player_stats("damage_pct") = player_stats("damage_pct") + 0.30
			player_stats("attack_speed_pct") = player_stats("attack_speed_pct") - 0.25
		Case 4
			player_stats("lifesteal") = player_stats("lifesteal") + 0.12
			player_stats("max_hp") = Int(player_stats("max_hp")) - 10
		Case 5
			player_stats("speed") = player_stats("speed") + 60.0
			player_stats("dodge") = player_stats("dodge") + 0.08
			player_stats("max_hp") = Int(player_stats("max_hp")) - 20
		Case 6
			player_stats("damage_pct") = player_stats("damage_pct") + 0.30
			player_stats("attack_speed_pct") = player_stats("attack_speed_pct") + 0.10
			player_stats("armor") = Int(player_stats("armor")) - 3
		Case 7
			player_stats("materials_pct") = player_stats("materials_pct") + 0.50
			player_stats("damage_pct") = player_stats("damage_pct") - 0.10
	End Select
End Sub

Function FindCharacterIndex(charId As String) As Integer
	Dim i As Integer
	For i = 0 To CHARACTER_COUNT - 1
		If CharIds(i) = charId Then
			FindCharacterIndex = i
			Exit Function
		End If
	Next i
	FindCharacterIndex = 0
End Function

' --- Shop: body upgrades & passive items (ApplyStatMods is shared) ---
Function GetBodyUpgradeLevel(statId As String) As Integer
	If body_upgrades(statId) Is Nothing Then
		GetBodyUpgradeLevel = 0
	Else
		GetBodyUpgradeLevel = Int(body_upgrades(statId))
	End If
End Function

Sub ApplyStatMods(mods As Object)
	If mods Is Nothing Then Exit Sub
	Dim keys As Variant
	keys = mods.keys()
	Dim i As Integer
	For i = 0 To UBound(keys)
		Dim key As String
		key = CStr(keys(i))
		Select Case key
			Case "max_hp": player_stats("max_hp") = Int(player_stats("max_hp")) + Int(mods(key))
			Case "armor": player_stats("armor") = Int(player_stats("armor")) + Int(mods(key))
			Case "speed": player_stats("speed") = player_stats("speed") + mods(key)
			Case "damage_pct": player_stats("damage_pct") = player_stats("damage_pct") + mods(key)
			Case "attack_speed_pct": player_stats("attack_speed_pct") = player_stats("attack_speed_pct") + mods(key)
			Case "range_pct": player_stats("range_pct") = player_stats("range_pct") + mods(key)
			Case "pierce_bonus": player_stats("pierce_bonus") = Int(player_stats("pierce_bonus")) + Int(mods(key))
			Case "lifesteal": player_stats("lifesteal") = player_stats("lifesteal") + mods(key)
			Case "dodge"
				Dim d As Single
				d = player_stats("dodge") + mods(key)
				If d > 0.8 Then d = 0.8
				player_stats("dodge") = d
			Case "materials_pct": player_stats("materials_pct") = player_stats("materials_pct") + mods(key)
		End Select
	Next i
End Sub

Sub ApplyBodyUpgrade(upg As Object)
	Dim sid As String
	sid = CStr(upg("id"))
	body_upgrades(sid) = GetBodyUpgradeLevel(sid) + 1
	Select Case sid
		Case "max_hp"
			player_stats("max_hp") = Int(player_stats("max_hp")) + 20
			player_stats("hp") = player_stats("hp") + 20.0
		Case "armor": player_stats("armor") = Int(player_stats("armor")) + 2
		Case "speed": player_stats("speed") = player_stats("speed") + 20.0
		Case "damage": player_stats("damage_pct") = player_stats("damage_pct") + 0.08
		Case "attack_speed": player_stats("attack_speed_pct") = player_stats("attack_speed_pct") + 0.10
		Case "range": player_stats("range_pct") = player_stats("range_pct") + 0.15
		Case "pierce": player_stats("pierce_bonus") = Int(player_stats("pierce_bonus")) + 1
		Case "lifesteal": player_stats("lifesteal") = player_stats("lifesteal") + 0.04
		Case "dodge"
			Dim d As Single
			d = player_stats("dodge") + 0.05
			If d > 0.8 Then d = 0.8
			player_stats("dodge") = d
	End Select
End Sub

Sub ApplyShopItem(item As Object)
	owned_items.append(item)
	Dim stats As Object
	Set stats = item("stats")
	If Not stats Is Nothing Then
		If Not stats("hp_heal") Is Nothing Then
			Dim hp As Single
			hp = player_stats("hp") + stats("hp_heal")
			If hp > player_stats("max_hp") Then hp = player_stats("max_hp")
			player_stats("hp") = hp
		End If
		Call ApplyStatMods(stats)
	End If
End Sub

' --- Weapons: inventory, tiers, combine, effective stats for shooting ---
Function GetWeaponDef(defId As String) As Object
	Dim i As Integer
	For i = 0 To UBound(WEAPON_DEFS)
		If CStr(WEAPON_DEFS(i)("id")) = defId Then
			Set GetWeaponDef = WEAPON_DEFS(i)
			Exit Function
		End If
	Next i
	Set GetWeaponDef = Nothing
End Function

Function AddWeapon(defId As String, tier As Integer) As Boolean
	If UBound(player_weapons) >= MAX_WEAPON_SLOTS - 1 Then
		AddWeapon = False
		Exit Function
	End If
	If GetWeaponDef(defId) Is Nothing Then
		AddWeapon = False
		Exit Function
	End If
	Dim w As Object
	Set w = New Dictionary
	w("def_id") = defId
	w("tier") = Clamp(tier, 1, MAX_TIER)
	player_weapons.append(w)
	AddWeapon = True
End Function

Function RemoveWeapon(slotIndex As Integer) As Object
	If slotIndex < 0 Or slotIndex > UBound(player_weapons) Then
		Set RemoveWeapon = Nothing
		Exit Function
	End If
	Dim w As Object
	Set w = player_weapons(slotIndex)
	player_weapons = RemoveAt(player_weapons, slotIndex)
	Set RemoveWeapon = w
End Function

Function CanCombine(defId As String, tier As Integer) As Boolean
	If tier >= MAX_TIER Then
		CanCombine = False
		Exit Function
	End If
	Dim count As Integer
	count = 0
	Dim i As Integer
	For i = 0 To UBound(player_weapons)
		If CStr(player_weapons(i)("def_id")) = defId And Int(player_weapons(i)("tier")) = tier Then
			count = count + 1
			If count >= COMBINE_REQUIRED Then
				CanCombine = True
				Exit Function
			End If
		End If
	Next i
	CanCombine = False
End Function

Function CombineWeapons(defId As String, tier As Integer) As Boolean
	If Not CanCombine(defId, tier) Then
		CombineWeapons = False
		Exit Function
	End If
	Dim removed As Integer
	removed = 0
	Dim i As Integer
	i = 0
	Do While i <= UBound(player_weapons) And removed < COMBINE_REQUIRED
		If CStr(player_weapons(i)("def_id")) = defId And Int(player_weapons(i)("tier")) = tier Then
			player_weapons = RemoveAt(player_weapons, i)
			removed = removed + 1
		Else
			i = i + 1
		End If
	Loop
	Dim w As Object
	Set w = New Dictionary
	w("def_id") = defId
	w("tier") = tier + 1
	player_weapons.append(w)
	CombineWeapons = True
End Function

Function GetWeaponSellPrice(weapon As Object) As Integer
	Dim def As Object
	Set def = GetWeaponDef(CStr(weapon("def_id")))
	If def Is Nothing Then
		GetWeaponSellPrice = 0
		Exit Function
	End If
	Dim t As Integer
	t = Clamp(Int(weapon("tier")), 1, MAX_TIER)
	GetWeaponSellPrice = Int(def("base_cost") * TIER_COST_MULT(t - 1) * TIER_SELL_REFUND + 0.5)
End Function

Function GetWeaponBuyPrice(defId As String, tier As Integer) As Integer
	Dim def As Object
	Set def = GetWeaponDef(defId)
	If def Is Nothing Then
		GetWeaponBuyPrice = 0
		Exit Function
	End If
	Dim t As Integer
	t = Clamp(tier, 1, MAX_TIER)
	GetWeaponBuyPrice = Int(def("base_cost") * TIER_COST_MULT(t - 1) + 0.5)
End Function

' Merges weapon def + tier multipliers + player_stats bonuses → Player3D.FireWeapon.
Function GetWeaponEffectiveStats(weapon As Object) As Object
	Dim def As Object
	Set def = GetWeaponDef(CStr(weapon("def_id")))
	If def Is Nothing Then
		Set GetWeaponEffectiveStats = Nothing
		Exit Function
	End If
	Dim tier As Integer
	tier = Clamp(Int(weapon("tier")), 1, MAX_TIER)
	Dim eff As Object
	Set eff = New Dictionary
	eff("def_id") = def("id")
	eff("pattern") = def("pattern")
	eff("damage") = def("base_damage") * TIER_DAMAGE_MULT(tier - 1) * (1.0 + player_stats("damage_pct"))
	eff("cooldown") = def("base_cooldown") * TIER_COOLDOWN_MULT(tier - 1) / (1.0 + player_stats("attack_speed_pct"))
	eff("range") = def("base_range") * (1.0 + player_stats("range_pct"))
	eff("pierce") = Int(def("base_pierce")) + Int(player_stats("pierce_bonus"))
	eff("bullet_count") = def("bullet_count")
	eff("spread_deg") = def("spread_deg")
	eff("bullet_speed") = def("bullet_speed")
	eff("bullet_lifetime") = def("bullet_lifetime")
	eff("color") = def("color")
	eff("tier") = tier
	Set GetWeaponEffectiveStats = eff
End Function

Function RollShopWeapons(count As Integer) As Variant
	Dim offers As Variant
	offers = Array()
	Dim i As Integer
	For i = 0 To count - 1
		Dim def As Object
		Set def = WEAPON_DEFS(Int(Rnd() * (UBound(WEAPON_DEFS) + 1)))
		Dim tier As Integer
		tier = RollTierForWave(wave)
		Dim offer As Object
		Set offer = New Dictionary
		offer("def_id") = def("id")
		offer("tier") = tier
		offer("cost") = GetWeaponBuyPrice(CStr(def("id")), tier)
		offers.append(offer)
	Next i
	RollShopWeapons = offers
End Function

Function RollTierForWave(w As Integer) As Integer
	Dim r As Single
	r = Rnd()
	If w >= 15 And r < 0.05 Then RollTierForWave = 4: Exit Function
	If w >= 10 And r < 0.20 Then RollTierForWave = 3: Exit Function
	If w >= 5 And r < 0.35 Then RollTierForWave = 2: Exit Function
	RollTierForWave = 1
End Function

' --- Static data tables (called once from _Ready) ---
Sub InitWeaponDefs()
	WEAPON_DEFS = Array()
	Call AddWeaponDef("pistol", "Pistol", "single", 14.0, 0.83, 240.0, 1, 1, 0.0, 560.0, 1.6, 30, Color(1.0, 0.9, 0.3), "res://assets/icons/weapon_pistol.png")
	Call AddWeaponDef("shotgun", "Shotgun", "shotgun", 8.0, 1.4, 200.0, 1, 5, 30.0, 500.0, 0.6, 55, Color(1.0, 0.55, 0.2), "res://assets/icons/weapon_shotgun.png")
	Call AddWeaponDef("sniper", "Sniper", "sniper", 55.0, 2.2, 700.0, 4, 1, 0.0, 1100.0, 1.4, 70, Color(0.4, 0.9, 1.0), "res://assets/icons/weapon_sniper.png")
	Call AddWeaponDef("smg", "SMG", "smg", 5.0, 0.20, 220.0, 1, 1, 10.0, 620.0, 0.8, 55, Color(0.95, 0.95, 0.4), "res://assets/icons/weapon_smg.png")
	Call AddWeaponDef("flamer", "Flamer", "smg", 4.0, 0.10, 160.0, 3, 1, 20.0, 380.0, 0.4, 60, Color(1.0, 0.4, 0.1), "res://assets/icons/weapon_flamer.png")
	Call AddWeaponDef("minigun", "Minigun", "smg", 6.0, 0.14, 260.0, 1, 1, 6.0, 700.0, 0.8, 65, Color(0.8, 0.8, 0.85), "res://assets/icons/weapon_minigun.png")
End Sub

Sub AddWeaponDef(id As String, nm As String, pat As String, dmg As Single, cd As Single, rng As Single, pierce As Integer, bullets As Integer, spread As Single, spd As Single, life As Single, cost As Integer, col As Color, iconPath As String)
	Dim d As Object
	Set d = New Dictionary
	d("id") = id
	d("name") = nm
	d("pattern") = pat
	d("base_damage") = dmg
	d("base_cooldown") = cd
	d("base_range") = rng
	d("base_pierce") = pierce
	d("bullet_count") = bullets
	d("spread_deg") = spread
	d("bullet_speed") = spd
	d("bullet_lifetime") = life
	d("base_cost") = cost
	d("color") = col
	d("icon") = iconPath
	WEAPON_DEFS.append(d)
End Sub

Sub InitCharacterDefs()
	CHARACTER_DEFS = Array()
	CharIds = Array()
	CharNames = Array()
	CharDescs = Array()
	CharTints = Array()
	CharStartWeapons = Array()
	Call AddChar("balanced", "Balanced", "Classic potato.", Color(1, 1, 1), "pistol")
	Call AddChar("tank", "Tank", "Slow but tough.", Color(0.55, 0.65, 0.85), "pistol")
	Call AddChar("gunner", "Gunner", "Glass cannon.", Color(1.0, 0.9, 0.35), "smg")
	Call AddChar("marksman", "Marksman", "Long range.", Color(0.45, 0.9, 1.0), "sniper")
	Call AddChar("leech", "Leech", "Life steal.", Color(0.9, 0.35, 0.45), "pistol")
	Call AddChar("speedy", "Speedy", "Fast and fragile.", Color(0.5, 1.0, 0.6), "pistol")
	Call AddChar("berserk", "Berserk", "High damage.", Color(1.0, 0.5, 0.3), "shotgun")
	Call AddChar("lucky", "Lucky", "More materials.", Color(0.75, 0.55, 1.0), "pistol")
	CHARACTER_COUNT = UBound(CharIds) + 1
End Sub

Sub AddChar(id As String, nm As String, desc As String, tint As Color, startW As String)
	CharIds.append(id)
	CharNames.append(nm)
	CharDescs.append(desc)
	CharTints.append(tint)
	CharStartWeapons.append(startW)
	Dim c As Object
	Set c = New Dictionary
	c("id") = id
	c("name") = nm
	CHARACTER_DEFS.append(c)
End Sub

Sub InitBodyUpgrades()
	BODY_UPGRADES = Array()
	Call AddBodyUpg("max_hp", "Max HP", "+20 max HP", 20, 10)
	Call AddBodyUpg("armor", "Armor", "+2 armor", 25, 10)
	Call AddBodyUpg("speed", "Speed", "+20 speed", 15, 10)
	Call AddBodyUpg("damage", "Damage", "+8% damage", 20, 15)
	Call AddBodyUpg("attack_speed", "Attack Speed", "+10% attack speed", 25, 10)
	Call AddBodyUpg("range", "Range", "+15% range", 15, 10)
	Call AddBodyUpg("pierce", "Pierce", "+1 pierce", 30, 5)
	Call AddBodyUpg("lifesteal", "Lifesteal", "+4% lifesteal", 35, 5)
	Call AddBodyUpg("dodge", "Dodge", "+5% dodge", 30, 4)
End Sub

Sub AddBodyUpg(id As String, nm As String, desc As String, cost As Integer, maxLvl As Integer)
	Dim u As Object
	Set u = New Dictionary
	u("id") = id
	u("name") = nm
	u("desc") = desc
	u("cost") = cost
	u("max_level") = maxLvl
	BODY_UPGRADES.append(u)
End Sub

Sub InitShopItems()
	SHOP_ITEMS = Array()
	Call AddShopItem("boots", "Boots", "+50 speed", 30, 1, "speed", 50.0)
	Call AddShopItem("gloves", "Gloves", "+8% damage", 30, 1, "damage_pct", 0.08)
	Call AddShopItem("medkit", "Medkit", "+40 max HP", 35, 1, "max_hp", 40)
	Call AddShopItem("vampire", "Vampire", "+8% lifesteal", 45, 2, "lifesteal", 0.08)
	Call AddShopItem("shield", "Shield", "+5 armor", 40, 2, "armor", 5)
End Sub

Sub AddShopItem(id As String, nm As String, desc As String, cost As Integer, rarity As Integer, statKey As String, statVal As Single)
	Dim it As Object
	Set it = New Dictionary
	it("id") = id
	it("type") = "accessory"
	it("name") = nm
	it("desc") = desc
	it("cost") = cost
	it("rarity") = rarity
	Dim stats As Object
	Set stats = New Dictionary
	stats(statKey) = statVal
	Set it("stats") = stats
	SHOP_ITEMS.append(it)
End Sub

' --- Asset caches (avoid Load() stutter during combat spawns) ---
Sub EnsureKenneyCaches()
	If kenney_tex_cache Is Nothing Then Set kenney_tex_cache = New Dictionary
	If kenney_mat_cache Is Nothing Then Set kenney_mat_cache = New Dictionary
End Sub

Function KenneySkinLetter(skinId As String) As String
	Dim prefix As String
	prefix = "character-"
	If Len(skinId) > Len(prefix) Then
		If Left(skinId, Len(prefix)) = prefix Then
			KenneySkinLetter = Mid(skinId, Len(prefix) + 1)
			Exit Function
		End If
	End If
	KenneySkinLetter = skinId
End Function

Function LoadKenneyTex(skinId As String) As Object
	Call EnsureKenneyCaches()
	Dim key As String
	key = KenneySkinLetter(skinId)
	If kenney_tex_cache(key) Is Nothing Then
		Dim path As String
		path = KENNEY_TEX_DIR & "texture-" & key & ".png"
		If ResourceLoader.exists(path) Then
			kenney_tex_cache(key) = Load(path)
		End If
	End If
	Set LoadKenneyTex = kenney_tex_cache(key)
End Function

Function CachedScene(path As String) As Object
	If scene_cache(path) Is Nothing Then
		scene_cache(path) = Load(path)
	End If
	Set CachedScene = scene_cache(path)
End Function

' Call from Main.start_game before first wave — warms PackedScenes.
Sub PreloadCombatScenes()
	Call CachedScene("res://scenes/Enemy3D.tscn")
	Call CachedScene("res://scenes/SpawnWarning3D.tscn")
	Call CachedScene("res://scenes/Bullet3D.tscn")
	Call CachedScene("res://scenes/FloatText3D.tscn")
	Call CachedScene("res://scenes/Drop3D.tscn")
	Call CachedScene("res://scenes/HitParticle3D.tscn")
	Call CachedScene("res://scenes/EnemyBullet3D.tscn")
End Sub

Sub PreloadKenneySkins()
	Dim letters As Variant
	letters = Array("a", "b", "c", "d", "e", "f", "g", "h", "i", "j")
	Dim i As Integer
	For i = 0 To UBound(letters)
		Call GetKenneyMaterial("character-" & CStr(letters(i)))
	Next i
End Sub

Function GetKenneyMaterial(skinId As String) As Object
	Call EnsureKenneyCaches()
	Dim key As String
	key = KenneySkinLetter(skinId)
	If kenney_mat_cache(key) Is Nothing Then
		Dim tex As Object
		Set tex = LoadKenneyTex(skinId)
		If tex Is Nothing Then Exit Function
		Dim mat As Object
		Set mat = ClassDB.Instantiate("StandardMaterial3D")
		If mat Is Nothing Then Exit Function
		mat.albedo_texture = tex
		mat.albedo_color = Color(1, 1, 1, 1)
		kenney_mat_cache(key) = mat
	End If
	Set GetKenneyMaterial = kenney_mat_cache(key)
End Function
