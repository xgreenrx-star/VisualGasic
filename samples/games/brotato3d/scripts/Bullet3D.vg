' =============================================================================
' Bullet3D.vg — player projectile (manual hit test, no Area3D physics)
' =============================================================================
' Attached to scenes/Bullet3D.tscn. Player spawns these and calls SetupExtended
' with a Dictionary of stats from GameManager.GetWeaponEffectiveStats().
'
' Why manual hits instead of Godot collision?
'   • Hundreds of bullets + dozens of enemies — Area3D signals get expensive
'   • Top-down XZ overlap is a simple distance check (see DistXZ in CombatCache3D)
'   • Pierce weapons need a "already hit this enemy" list
'
' Group: "bullets" — player caps count via liveBulletCount in Player3D.vg
' =============================================================================
Import "CombatCache3D.vg"
Extends Node3D

' Radius on the XZ plane — tuned for enemy half-width + bullet mesh size.
Const HIT_RADIUS As Single = 1.05

Dim bulletVelocity As Object
Dim damage As Single
Dim pierce As Integer
Dim hits As Integer
Dim lifetime As Single
Dim hitEnemies As Variant
Dim bulletColor As Color
Dim hitCheckTimer As Single

Sub _Ready()
	hitEnemies = Array()
	hitCheckTimer = 0.0
	Me.AddToGroup("bullets")
End Sub

' Called immediately after instantiate(). p keys: dir, damage, pierce, speed,
' lifetime, color — all set by Player3D.FireWeapon / SpawnBullet.
Sub SetupExtended(p As Object)
	damage = p("damage")
	pierce = Max(1, Int(p("pierce")))
	lifetime = p("lifetime")
	If lifetime <= 0 Then lifetime = 1.8
	Dim dir As Object
	dir = p("dir")
	If dir Is Nothing Then dir = Vector3(1, 0, 0)
	Dim spd As Single
	spd = p("speed")
	If spd <= 0 Then spd = 26.0
	bulletVelocity = Vector3(dir.x, 0.0, dir.z).normalized() * spd
	Dim col As Color
	col = p("color")
	If col Is Nothing Then col = Color(1.0, 0.9, 0.3)
	bulletColor = col
	Dim mesh As Object
	mesh = GetNode("MeshInstance3D")
	If Not mesh Is Nothing Then
		mesh.cast_shadow = 0
		mesh.modulate = col
	End If
End Sub

Sub _Process(delta As Single)
	Dim pos As Object
	pos = Me.global_position
	Me.global_position = pos + bulletVelocity * delta
	lifetime = lifetime - delta
	If lifetime <= 0 Then
		Me.queue_free()
		Exit Sub
	End If
	' Throttle hit tests — every 40ms is enough at bullet speeds.
	hitCheckTimer = hitCheckTimer - delta
	If hitCheckTimer <= 0 Then
		hitCheckTimer = 0.04
		Call CheckHits()
	End If
End Sub

Function ArrayContains(arr As Variant, val As Object) As Boolean
	Dim i As Integer
	For i = 0 To UBound(arr)
		If arr(i) Is val Then
			ArrayContains = True
			Exit Function
		End If
	Next i
	ArrayContains = False
End Function

Sub CheckHits()
	Dim enemies As Variant
	enemies = GetTree().get_nodes_in_group("enemies")
	Dim i As Integer
	Dim n As Integer
	n = UBound(enemies)
	If n < 0 Then Exit Sub
	For i = 0 To n
		Dim body As Object
		Set body = enemies(i)
		If body Is Nothing Then GoTo NextE
		If ArrayContains(hitEnemies, body) Then GoTo NextE
		If DistXZ(Me, body) < HIT_RADIUS Then
			hitEnemies.append(body)
			Call ApplyHit(body)
			If hits >= pierce Then
				Me.queue_free()
				Exit Sub
			End If
		End If
NextE:
	Next i
End Sub

Sub ApplyHit(body As Object)
	If body Is Nothing Then Exit Sub
	body.TakeHit(damage)
	GameManager.player_stats("total_damage") = GameManager.player_stats("total_damage") + damage
	hits = hits + 1
End Sub
