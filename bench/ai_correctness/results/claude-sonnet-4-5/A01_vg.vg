Module Module1
    Sub Main()
        Dim arr() As Integer = {3, 1, 4, 1, 5, 9, 2, 6}
        Dim sum As Integer = 0
        Dim i As Integer
        
        For i = 0 To arr.Length - 1
            sum = sum + arr(i)
        Next
        
        Dim average As Double = sum / arr.Length
        
        System.Console.WriteLine("Sum: " & sum)
        System.Console.WriteLine("Average: " & average)
    End Sub
End Module