Option Explicit

Sub Main()
    Print "=== Testing IsNot Operator ==="
    TestIsNotOperator
    Print ""
    Print "All tests completed!"
End Sub

Sub TestIsNotOperator()
    Dim obj1 As Object
    Dim obj2 As Object
    Dim obj3 As Object
    Set obj3 = obj1
    
    ' IsNot with two Nils - should be False (same reference)
    If obj1 IsNot obj2 Then
        Print "FAIL: Two Nil objects should NOT be IsNot"
    Else
        Print "PASS: Two Nil objects IsNot = False (they are same)"
    End If
    
    ' IsNot with same non-Nil
    If obj1 IsNot obj3 Then
        Print "FAIL: Same object should NOT be IsNot"
    Else
        Print "PASS: Same object IsNot = False"
    End If
    
    ' IsNot Nothing with Nil
    If obj1 IsNot Nothing Then
        Print "FAIL: Nil should be IsNot Nothing = False"
    Else
        Print "PASS: Nil IsNot Nothing = False"
    End If
    
    ' Use a literal comparison
    Dim x As Integer
    Dim y As Integer
    x = 5
    y = 10
    If x = y Then
        Print "FAIL: 5 should not equal 10"
    Else
        Print "PASS: 5 <> 10 (using regular comparison)"
    End If
    
    ' IsNot with different objects via literal values
    Dim dict1 As Object
    Dim dict2 As Object
    ' Both Nil - IsNot should be False
    If dict1 IsNot dict2 Then
        Print "FAIL: Both Nil should not be IsNot"
    Else
        Print "PASS: Both Nil IsNot = False"
    End If
End Sub

Main
