' VisualGasic drawing benchmark — attach to Node2D; orchestrator calls ConfigureBench then QueueRedraw.

Dim _workload As String
Dim _count As Long
Dim _elapsed_us As Long
Dim _checksum As Long
Dim _ready As Boolean
Dim _spriteTexture As Variant

Const GRID_COLS As Long = 50
Const CELL As Long = 8
Const SPRITE_SIZE As Long = 8
Const CIRCLE_RADIUS As Double = 3.0

Sub ConfigureBench(ByVal workload As String, ByVal count As Long)
    _workload = workload
    _count = count
    _ready = False
    _elapsed_us = 0
    _checksum = 0
End Sub

Function IsBenchReady() As Boolean
    IsBenchReady = _ready
End Function

Function GetBenchResult() As Dictionary
    Dim d As Dictionary
    Set d = New Dictionary
    d("elapsed_us") = _elapsed_us
    d("checksum") = _checksum
    Set GetBenchResult = d
End Function

Sub _Ready()
    Dim img As Variant
    Set img = CreateImage(SPRITE_SIZE, SPRITE_SIZE, Color(0.2, 0.4, 0.9, 1.0))
    Set _spriteTexture = CreateTexture(img)
End Sub

Sub _Draw()
    If _workload = "" Then
        Exit Sub
    End If

    Dim t0 As Long
    t0 = Time.get_ticks_usec()

    Select Case _workload
    Case "FilledRects"
        _checksum = BenchFilledRects(_count)
    Case "OutlineRects"
        _checksum = BenchOutlineRects(_count)
    Case "Lines"
        _checksum = BenchLines(_count)
    Case "Circles"
        _checksum = BenchCircles(_count)
    Case "Sprites"
        _checksum = BenchSprites(_count)
    Case "Polylines"
        _checksum = BenchPolylines(_count)
    Case "Mixed"
        _checksum = BenchMixed(_count)
    Case Else
        _checksum = 0
    End Select

    _elapsed_us = Time.get_ticks_usec() - t0
    _ready = True
    _workload = ""
End Sub

Private Function GridX(ByVal index As Long) As Double
    GridX = CDbl(index Mod GRID_COLS) * CDbl(CELL)
End Function

Private Function GridY(ByVal index As Long) As Double
    GridY = CDbl(index \ GRID_COLS) * CDbl(CELL)
End Function

Private Function BenchFilledRects(ByVal count As Long) As Long
    Dim i As Long
    Dim cs As Long
    Dim x As Double
    Dim y As Double

    For i = 0 To count - 1 Step 1
        x = GridX(i)
        y = GridY(i)
        DrawRect x, y, CDbl(CELL), CDbl(CELL), Color(0.2, 0.4, 0.9, 1.0), True
        cs = cs + CLng(x) + CLng(y) + CELL
    Next i

    BenchFilledRects = cs
End Function

Private Function BenchOutlineRects(ByVal count As Long) As Long
    Dim i As Long
    Dim cs As Long
    Dim x As Double
    Dim y As Double

    For i = 0 To count - 1 Step 1
        x = GridX(i)
        y = GridY(i)
        DrawRect x, y, CDbl(CELL), CDbl(CELL), Color(0.9, 0.5, 0.1, 1.0), False
        cs = cs + CLng(x) + CLng(y) + CELL
    Next i

    BenchOutlineRects = cs
End Function

Private Function BenchLines(ByVal count As Long) As Long
    Dim i As Long
    Dim cs As Long
    Dim x As Double
    Dim y As Double

    For i = 0 To count - 1 Step 1
        x = GridX(i)
        y = GridY(i)
        DrawLine x, y, x + CDbl(CELL), y + CDbl(CELL) * 0.5, Color(0.1, 0.8, 0.3, 1.0), 1.0
        cs = cs + CLng(x) + CLng(y) + CELL
    Next i

    BenchLines = cs
End Function

Private Function BenchCircles(ByVal count As Long) As Long
    Dim i As Long
    Dim cs As Long
    Dim x As Double
    Dim y As Double
    Dim half As Double

    half = CDbl(CELL) * 0.5
    For i = 0 To count - 1 Step 1
        x = GridX(i)
        y = GridY(i)
        DrawCircle x + half, y + half, CIRCLE_RADIUS, Color(0.8, 0.2, 0.6, 1.0)
        cs = cs + CLng(x) + CLng(y) + CLng(CIRCLE_RADIUS)
    Next i

    BenchCircles = cs
End Function

Private Function BenchSprites(ByVal count As Long) As Long
    Dim i As Long
    Dim cs As Long
    Dim x As Double
    Dim y As Double

    For i = 0 To count - 1 Step 1
        x = GridX(i)
        y = GridY(i)
        DrawTextureRect _spriteTexture, x, y, CDbl(SPRITE_SIZE), CDbl(SPRITE_SIZE), False
        cs = cs + CLng(x) + CLng(y) + SPRITE_SIZE
    Next i

    BenchSprites = cs
End Function

Private Function BenchPolylines(ByVal count As Long) As Long
    Dim i As Long
    Dim cs As Long
    Dim x As Double
    Dim y As Double
    Dim pts(0) As Variant

    For i = 0 To count - 1 Step 1
        x = GridX(i)
        y = GridY(i)
        ReDim pts(4)
        pts(0) = Vector2(x, y)
        pts(1) = Vector2(x + CDbl(CELL), y)
        pts(2) = Vector2(x + CDbl(CELL), y + CDbl(CELL))
        pts(3) = Vector2(x, y + CDbl(CELL))
        pts(4) = Vector2(x, y)
        DrawPolyline pts, Color(0.1, 0.8, 0.3, 1.0), 1.0
        cs = cs + CLng(x) + CLng(y) + CELL
    Next i

    BenchPolylines = cs
End Function

Private Function BenchMixed(ByVal count As Long) As Long
    Dim cs As Long
    cs = BenchFilledRects(count)
    cs = cs + BenchLines(count)
    cs = cs + BenchCircles(count \ 2)
    cs = cs + BenchSprites(count \ 2)
    BenchMixed = cs
End Function
