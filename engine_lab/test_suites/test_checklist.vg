' VisualGasic Comprehensive Test Script
' Tests features from VG_TEST_CHECKLIST.md

Sub Main()
    Print "=========================================="
    Print "VisualGasic Checklist Test Suite"
    Print "=========================================="
    
    TestSingleLineIf
    TestSelectCaseMultiple
    TestGoTo
    TestCallKeyword
    TestStringFunctions
    TestMathFunctions
    TestConversionFunctions
    TestTypeChecking
    
    Print "=========================================="
    Print "Test Suite Complete"
    Print "=========================================="
End Sub

Sub TestSingleLineIf()
    Print ""
    Print "--- Single-line If ---"
    Dim x As Integer
    x = 5
    If x > 0 Then Print "[PASS] Single-line If (positive)"
    If x < 0 Then Print "[FAIL] Single-line If (should not print)"
End Sub

Sub TestSelectCaseMultiple()
    Print ""
    Print "--- Select Case with Multiple Values ---"
    Dim n As Integer
    n = 3
    
    Select Case n
        Case 1, 3, 5
            Print "[PASS] Select Case multiple values (1, 3, 5)"
        Case 2, 4, 6
            Print "[FAIL] Should not match 2, 4, 6"
        Case Else
            Print "[FAIL] Should not reach Case Else"
    End Select
End Sub

Sub TestGoTo()
    Print ""
    Print "--- GoTo ---"
    Dim i As Integer
    i = 0
    
StartLoop:
    i = i + 1
    If i < 3 Then GoTo StartLoop
    
    Print "GoTo loop result: i=" & i
    If i = 3 Then
        Print "[PASS] GoTo"
    Else
        Print "[FAIL] GoTo"
    End If
End Sub

Sub TestCallKeyword()
    Print ""
    Print "--- Call Keyword ---"
    Call HelperSub("Call keyword test")
End Sub

Sub HelperSub(msg As String)
    Print "[PASS] " & msg
End Sub

Sub TestStringFunctions()
    Print ""
    Print "--- String Functions ---"
    
    Dim s As String
    s = "Hello World"
    Print "Mid(s, 7) = " & Mid(s, 7)
    
    Dim replaced As String
    replaced = Replace("hello world", "world", "VG")
    Print "Replace test: " & replaced
    
    Print "Space(5) = [" & Space(5) & "]"
    Print "String(3, X) = " & String(3, "X")
    
    Print "StrReverse(Hello) = " & StrReverse("Hello")
    
    Print "InStrRev(hello hello, ello) = " & InStrRev("hello hello", "ello")
End Sub

Sub TestMathFunctions()
    Print ""
    Print "--- Math Functions ---"
    
    Print "Fix(3.7) = " & Fix(3.7)
    Print "Fix(-3.7) = " & Fix(-3.7)
    
    Print "Exp(1) = " & Exp(1)
    Print "Log(2.718) = " & Log(2.718)
    
    Print "Atn(1) = " & Atn(1)
End Sub

Sub TestConversionFunctions()
    Print ""
    Print "--- Conversion Functions ---"
    
    Print "CLng(3.7) = " & CLng(3.7)
    Print "CDbl(3.14) = " & CDbl("3.14")
    Print "CSng(3.14159) = " & CSng(3.14159)
    
    Print "Oct(8) = " & Oct(8)
    Print "Oct(16) = " & Oct(16)
End Sub

Sub TestTypeChecking()
    Print ""
    Print "--- Type Checking Functions ---"
    
    Print "IsNumeric(42) = " & IsNumeric(42)
    Print "IsNumeric(hello) = " & IsNumeric("hello")
    Print "IsNumeric(123) = " & IsNumeric("123")
    
    Dim n As Integer
    n = 42
    Print "TypeName(n) = " & TypeName(n)
    Print "VarType(n) = " & VarType(n)
End Sub
