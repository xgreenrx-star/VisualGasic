' test_syntax_errors.vg - Test syntax error detection
' This file intentionally has NO errors - it tests proper parsing
Option Explicit

Sub TestProperCode()
    Dim x As Integer
    x = 10
    If x > 5 Then
        Print "x is greater than 5"
    End If
    Print "Proper code ran: x=" & x
End Sub

Sub Main()
    TestProperCode
    Print "SYNTAX_PROPER=true"
End Sub
