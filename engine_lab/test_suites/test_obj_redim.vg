' Test Object declaration and ReDim Preserve
Option Explicit

Sub Main()
    Print "=== Test 1: Object Declaration ==="
    Dim obj As Object
    Print "obj declared As Object: " & TypeName(obj)
    
    ' In VB6, Object starts as Nothing (null)
    ' We can assign any value to it
    Set obj = Nothing
    Print "After Set Nothing: " & TypeName(obj)
    
    Print ""
    Print "=== Test 2: ReDim Preserve 1D ==="
    Dim arr() As Integer
    ReDim arr(3)
    arr(0) = 10
    arr(1) = 20
    arr(2) = 30
    arr(3) = 40
    Print "Before: arr(0)=" & arr(0) & ", arr(1)=" & arr(1) & ", arr(2)=" & arr(2) & ", arr(3)=" & arr(3)
    
    ReDim Preserve arr(5)
    Print "After Preserve(5): arr(0)=" & arr(0) & ", arr(1)=" & arr(1) & ", arr(2)=" & arr(2) & ", arr(3)=" & arr(3)
    arr(4) = 50
    arr(5) = 60
    Print "New elements: arr(4)=" & arr(4) & ", arr(5)=" & arr(5)
    
    Print ""
    Print "=== Test 3: ReDim Preserve 2D (last dimension) ==="
    Dim grid(2, 2) As Integer
    grid(0, 0) = 1
    grid(0, 1) = 2
    grid(0, 2) = 3
    grid(1, 0) = 4
    grid(1, 1) = 5
    grid(1, 2) = 6
    grid(2, 0) = 7
    grid(2, 1) = 8
    grid(2, 2) = 9
    Print "Before: grid(0,0)=" & grid(0, 0) & ", grid(1,1)=" & grid(1, 1) & ", grid(2,2)=" & grid(2, 2)
    
    ' In VB6, only the last dimension can be changed with Preserve
    ReDim Preserve grid(2, 4)
    Print "After Preserve(2,4): grid(0,0)=" & grid(0, 0) & ", grid(1,1)=" & grid(1, 1) & ", grid(2,2)=" & grid(2, 2)
    
    ' Test using UBound to check dimensions
    Print "UBound(grid, 1) = " & UBound(grid, 1)
    Print "UBound(grid, 2) = " & UBound(grid, 2)
    
    grid(0, 3) = 10
    grid(0, 4) = 11
    Print "New elements: grid(0,3)=" & grid(0, 3) & ", grid(0,4)=" & grid(0, 4)
    
    Print ""
    Print "=== Test 4: ReDim Preserve 3D (last dimension) ==="
    Dim cube(1, 1, 1) As Integer
    cube(0, 0, 0) = 100
    cube(0, 0, 1) = 101
    cube(0, 1, 0) = 110
    cube(0, 1, 1) = 111
    cube(1, 0, 0) = 200
    cube(1, 1, 1) = 222
    Print "Before: cube(0,0,0)=" & cube(0, 0, 0) & ", cube(1,1,1)=" & cube(1, 1, 1)
    
    ReDim Preserve cube(1, 1, 3)
    Print "After Preserve(1,1,3): cube(0,0,0)=" & cube(0, 0, 0) & ", cube(1,1,1)=" & cube(1, 1, 1)
    cube(0, 0, 2) = 102
    cube(0, 0, 3) = 103
    Print "New elements: cube(0,0,2)=" & cube(0, 0, 2) & ", cube(0,0,3)=" & cube(0, 0, 3)
    
    Print ""
    Print "=== All tests completed ==="
End Sub
