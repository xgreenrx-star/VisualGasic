Sub Main()
    Dim r As Double
    r = Fib(5)
    Print "Fib(5)=" & r
    r = Fib(10)
    Print "Fib(10)=" & r
    r = Fib(20)
    Print "Fib(20)=" & r
End Sub

Function Fib(n As Double) As Double
    If n <= 1 Then
        Fib = n
    Else
        Fib = Fib(n - 1) + Fib(n - 2)
    End If
End Function
