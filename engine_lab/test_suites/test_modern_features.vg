' VG Modern Language Features Test

Sub Main()
    Dim passed As Integer
    Dim failed As Integer
    passed = 0
    failed = 0

    Print "=== VG Modern Language Features ==="
    Print ""

    ' --- Test 1: Erase ---
    Print "--- Erase ---"
    Dim arr As Variant
    ReDim arr(3)
    arr(0) = "A"
    arr(1) = "B"
    Erase arr
    passed = passed + 1
    Print "PASS: Erase"

    ' --- Test 2: Numeric Lambda ---
    Print "--- Lambda ---"
    Dim doubleIt As Variant
    doubleIt = Lambda(x) => x * 2
    Dim r1 As Variant
    r1 = doubleIt(5)
    Print "doubleIt(5) = " & r1
    If r1 = 10 Then
        passed = passed + 1
        Print "PASS: Numeric lambda"
    Else
        failed = failed + 1
        Print "FAIL: Numeric lambda"
    End If

    ' --- Test 3: Multi-param Lambda ---
    Dim addFunc As Variant
    addFunc = Lambda(a, b) => a + b
    Dim r2 As Variant
    r2 = addFunc(3, 7)
    Print "addFunc(3, 7) = " & r2
    If r2 = 10 Then
        passed = passed + 1
        Print "PASS: Multi-param lambda"
    Else
        failed = failed + 1
        Print "FAIL: Multi-param lambda"
    End If

    ' --- Test 4: String concat Lambda ---
    Dim concatFunc As Variant
    concatFunc = Lambda(s) => "Hello " & s
    Dim r3 As Variant
    r3 = concatFunc("World")
    Print "concatFunc('World') = " & r3
    If r3 = "Hello World" Then
        passed = passed + 1
        Print "PASS: String lambda"
    Else
        failed = failed + 1
        Print "FAIL: String lambda, got: " & r3
    End If

    ' --- Test 5: Null Coalescing ---
    Print "--- Null Coalescing ?? ---"
    Dim n1 As Variant
    n1 = Nothing
    Dim f1 As Variant
    f1 = n1 ?? "default"
    Print "Nothing ?? 'default' = " & f1
    If f1 = "default" Then
        passed = passed + 1
        Print "PASS: ?? with Nothing"
    Else
        failed = failed + 1
        Print "FAIL: ?? expected default, got: " & f1
    End If

    Dim n2 As Variant
    n2 = "actual"
    Dim f2 As Variant
    f2 = n2 ?? "default"
    Print "'actual' ?? 'default' = " & f2
    If f2 = "actual" Then
        passed = passed + 1
        Print "PASS: ?? with value"
    Else
        failed = failed + 1
        Print "FAIL: ?? expected actual, got: " & f2
    End If

    ' --- Test 6: Chained ?? ---
    Dim x1 As Variant
    x1 = Nothing
    Dim x2 As Variant
    x2 = Nothing
    Dim x3 As Variant
    x3 = "found"
    Dim f3 As Variant
    f3 = x1 ?? x2 ?? x3
    Print "x1 ?? x2 ?? x3 = " & f3
    If f3 = "found" Then
        passed = passed + 1
        Print "PASS: Chained ??"
    Else
        failed = failed + 1
        Print "FAIL: Chained ?? expected found, got: " & f3
    End If

    ' --- Test 7: Optional Chaining ---
    Print "--- Optional Chaining ?. ---"
    Dim nullObj As Variant
    nullObj = Nothing
    Dim safe As Variant
    safe = nullObj?.Name
    Print "Nothing?.Name = " & safe
    If safe = Nothing Then
        passed = passed + 1
        Print "PASS: ?. on Nothing"
    Else
        failed = failed + 1
        Print "FAIL: ?. on Nothing"
    End If

    ' --- Summary ---
    Print ""
    Print "Passed: " & passed & " / " & (passed + failed)
    If failed = 0 Then
        Print "ALL TESTS PASSED!"
    End If
End Sub
