' test_math_utils.vg — Utility module for multi-module testing
' This module exports mathematical utility functions

Public Const PI_VALUE As Double = 3.14159265

Public Function Add(a As Double, b As Double) As Double
    Add = a + b
End Function

Public Function Multiply(a As Double, b As Double) As Double
    Multiply = a * b
End Function

Public Function CircleArea(radius As Double) As Double
    CircleArea = PI_VALUE * radius * radius
End Function

Public Sub PrintBanner()
    Debug.Print "=== MathUtils Module Loaded ==="
End Sub
