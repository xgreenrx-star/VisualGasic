' VisualGasic Comprehensive Test Suite
' Tests core language features, built-in functions, and operators

Dim passed As Integer
Dim failed As Integer
Dim total As Integer

Sub Main()
    passed = 0
    failed = 0
    total = 0
    
    Print "=========================================="
    Print "VisualGasic Test Suite v2.2.3"
    Print "=========================================="
    Print ""
    
    TestVariables
    TestOperators
    TestControlFlow
    TestStringFunctions
    TestMathFunctions
    TestConversionFunctions
    TestArrayFunctions
    TestProcedures
    
    Print ""
    Print "=========================================="
    Print "RESULTS: " & passed & " passed, " & failed & " failed, " & total & " total"
    Print "=========================================="
End Sub

Sub Assert(condition As Boolean, testName As String)
    total = total + 1
    If condition Then
        passed = passed + 1
        Print "[PASS] " & testName
    Else
        failed = failed + 1
        Print "[FAIL] " & testName
    End If
End Sub

Sub TestVariables()
    Print ""
    Print "--- 1.1 Variables and Data Types ---"
    
    Dim i As Integer
    i = 42
    Assert i = 42, "Dim x As Integer"
    
    Dim s As String
    s = "Hello"
    Assert s = "Hello", "Dim s As String"
    
    Dim d As Double
    d = 3.14159
    Assert d > 3.14 And d < 3.15, "Dim d As Double"
    
    Dim b As Boolean
    b = True
    Assert b = True, "Dim b As Boolean"
    
    Dim v As Variant
    v = 123
    Assert v = 123, "Dim v As Variant (numeric)"
    v = "text"
    Assert v = "text", "Dim v As Variant (string)"
    
    x = 99
    Assert x = 99, "Implicit variable declaration"
    
    Dim arr(5) As Integer
    arr(0) = 10
    arr(1) = 20
    arr(5) = 60
    Assert arr(0) = 10, "Array declaration Dim arr(5)"
    Assert arr(5) = 60, "Array access arr(5)"
End Sub

Sub TestOperators()
    Print ""
    Print "--- 1.2 Operators ---"
    
    Assert 5 + 3 = 8, "Addition: 5 + 3 = 8"
    Assert 10 - 4 = 6, "Subtraction: 10 - 4 = 6"
    Assert 6 * 7 = 42, "Multiplication: 6 * 7 = 42"
    Assert 20 / 4 = 5, "Division: 20 / 4 = 5"
    Assert 17 \ 5 = 3, "Integer division: 17 \ 5 = 3"
    Assert 17 Mod 5 = 2, "Modulo: 17 Mod 5 = 2"
    Assert 2 ^ 3 = 8, "Exponent: 2 ^ 3 = 8"
    Assert "Hello" & " " & "World" = "Hello World", "String concatenation &"
    Assert 5 = 5, "Comparison: 5 = 5"
    Assert 5 <> 6, "Comparison: 5 <> 6"
    Assert 3 < 5, "Comparison: 3 < 5"
    Assert 7 > 4, "Comparison: 7 > 4"
    Assert 5 <= 5, "Comparison: 5 <= 5"
    Assert 6 >= 5, "Comparison: 6 >= 5"
    Assert True And True, "Logical: True And True"
    Assert True Or False, "Logical: True Or False"
    Assert Not False, "Logical: Not False"
End Sub

Sub TestControlFlow()
    Print ""
    Print "--- 1.3 Control Flow ---"
    
    Dim result As Integer
    Dim i As Integer
    
    result = 0
    If True Then
        result = 1
    End If
    Assert result = 1, "If...Then...End If"
    
    result = 0
    If False Then
        result = 1
    Else
        result = 2
    End If
    Assert result = 2, "If...Then...Else...End If"
    
    result = TestElseIf(2)
    Assert result = 20, "If...ElseIf...Else (case 2)"
    
    result = TestSelectCase(2)
    Assert result = 20, "Select Case (case 2)"
    result = TestSelectCase(99)
    Assert result = -1, "Select Case (Case Else)"
    
    result = TestSelectRange(5)
    Assert result = 1, "Select Case with range 1 To 10"
    
    result = 0
    For i = 1 To 5
        result = result + i
    Next i
    Assert result = 15, "For...Next (1+2+3+4+5=15)"
    
    result = 0
    For i = 0 To 10 Step 2
        result = result + 1
    Next i
    Assert result = 6, "For...Next with Step 2"
    
    result = 0
    For i = 5 To 1 Step -1
        result = result + i
    Next i
    Assert result = 15, "For...Next with negative Step"
    
    result = 0
    i = 1
    Do While i <= 3
        result = result + i
        i = i + 1
    Loop
    Assert result = 6, "Do While...Loop"
    
    result = 0
    i = 1
    Do Until i > 3
        result = result + i
        i = i + 1
    Loop
    Assert result = 6, "Do Until...Loop"
    
    result = 0
    i = 1
    While i <= 3
        result = result + i
        i = i + 1
    Wend
    Assert result = 6, "While...Wend"
    
    result = 0
    For i = 1 To 100
        result = result + 1
        If i = 5 Then Exit For
    Next i
    Assert result = 5, "Exit For"
End Sub

Function TestElseIf(n As Integer) As Integer
    If n = 1 Then
        TestElseIf = 10
    ElseIf n = 2 Then
        TestElseIf = 20
    ElseIf n = 3 Then
        TestElseIf = 30
    Else
        TestElseIf = 99
    End If
End Function

Function TestSelectCase(n As Integer) As Integer
    Select Case n
        Case 1
            TestSelectCase = 10
        Case 2
            TestSelectCase = 20
        Case 3
            TestSelectCase = 30
        Case Else
            TestSelectCase = -1
    End Select
End Function

Function TestSelectRange(n As Integer) As Integer
    Select Case n
        Case 1 To 10
            TestSelectRange = 1
        Case 11 To 100
            TestSelectRange = 2
        Case Else
            TestSelectRange = 0
    End Select
End Function

Sub TestStringFunctions()
    Print ""
    Print "--- 2.1 String Functions ---"
    
    Dim s As String
    s = "Hello World"
    
    Assert Len(s) = 11, "Len('Hello World') = 11"
    Assert Left(s, 5) = "Hello", "Left('Hello World', 5)"
    Assert Right(s, 5) = "World", "Right('Hello World', 5)"
    Assert Mid(s, 7, 5) = "World", "Mid('Hello World', 7, 5)"
    Assert InStr(s, "World") = 7, "InStr('Hello World', 'World') = 7"
    Assert Trim("  test  ") = "test", "Trim('  test  ')"
    Assert UCase("hello") = "HELLO", "UCase('hello')"
    Assert LCase("HELLO") = "hello", "LCase('HELLO')"
    Assert Asc("A") = 65, "Asc('A') = 65"
    Assert Chr(65) = "A", "Chr(65) = 'A'"
    Assert Val("123") = 123, "Val('123') = 123"
End Sub

Sub TestMathFunctions()
    Print ""
    Print "--- 2.2 Math Functions ---"
    
    Assert Abs(-5) = 5, "Abs(-5) = 5"
    Assert Abs(5) = 5, "Abs(5) = 5"
    Assert Int(3.7) = 3, "Int(3.7) = 3"
    Assert Sgn(-5) = -1, "Sgn(-5) = -1"
    Assert Sgn(0) = 0, "Sgn(0) = 0"
    Assert Sgn(5) = 1, "Sgn(5) = 1"
    Assert Sqr(16) = 4, "Sqr(16) = 4"
    Assert Sqr(25) = 5, "Sqr(25) = 5"
    Assert Sin(0) = 0, "Sin(0) = 0"
    Assert Cos(0) = 1, "Cos(0) = 1"
    Assert Round(3.5) = 4, "Round(3.5) = 4"
    Assert Round(3.4) = 3, "Round(3.4) = 3"
    
    Dim r As Double
    r = Rnd()
    Assert r >= 0 And r < 1, "Rnd() returns 0 <= x < 1"
End Sub

Sub TestConversionFunctions()
    Print ""
    Print "--- 2.3 Conversion Functions ---"
    
    Assert CInt(3.7) = 4, "CInt(3.7) = 4"
    Assert CInt("42") = 42, "CInt('42') = 42"
    Assert CBool(1) = True, "CBool(1) = True"
    Assert CBool(0) = False, "CBool(0) = False"
    Assert CStr(123) = "123", "CStr(123) = '123'"
    Assert Hex(255) = "FF", "Hex(255) = 'FF'"
End Sub

Sub TestArrayFunctions()
    Print ""
    Print "--- 2.4 Array Functions ---"
    
    Dim arr(10) As Integer
    arr(0) = 100
    arr(10) = 1000
    
    Assert LBound(arr) = 0, "LBound(arr) = 0"
    Assert UBound(arr) = 10, "UBound(arr) = 10"
    Assert IsArray(arr) = True, "IsArray(arr) = True"
End Sub

Sub TestProcedures()
    Print ""
    Print "--- 1.4 Procedures ---"
    
    Assert AddNumbers(3, 4) = 7, "Function: AddNumbers(3, 4) = 7"
    Assert Factorial(5) = 120, "Recursive: Factorial(5) = 120"
    
    Dim x As Integer
    x = 10
    DoubleByRef x
    Assert x = 20, "ByRef parameter: x doubled to 20"
End Sub

Function AddNumbers(a As Integer, b As Integer) As Integer
    AddNumbers = a + b
End Function

Function Factorial(n As Integer) As Integer
    If n <= 1 Then
        Factorial = 1
    Else
        Factorial = n * Factorial(n - 1)
    End If
End Function

Sub DoubleByRef(ByRef n As Integer)
    n = n * 2
End Sub
