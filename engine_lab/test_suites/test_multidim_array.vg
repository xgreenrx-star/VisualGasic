' Test multi-dimensional array support
Sub Main()
    Print "=== Multi-dimensional Array Tests ==="
    Print ""
    
    ' Test 1: 2D array
    Print "Test 1: 2D Array (3x3)"
    Dim grid(3, 3) As Integer
    grid(0, 0) = 1
    grid(0, 1) = 2
    grid(0, 2) = 3
    grid(1, 0) = 4
    grid(1, 1) = 5
    grid(1, 2) = 6
    grid(2, 0) = 7
    grid(2, 1) = 8
    grid(2, 2) = 9
    
    Print "  grid(0,0)=" & CStr(grid(0, 0)) & " (expected 1)"
    Print "  grid(1,1)=" & CStr(grid(1, 1)) & " (expected 5)"
    Print "  grid(2,2)=" & CStr(grid(2, 2)) & " (expected 9)"
    Print ""
    
    ' Test 2: 3D array
    Print "Test 2: 3D Array (2x2x2)"
    Dim cube(2, 2, 2) As Integer
    cube(0, 0, 0) = 100
    cube(0, 0, 1) = 101
    cube(0, 1, 0) = 110
    cube(1, 1, 1) = 222
    
    Print "  cube(0,0,0)=" & CStr(cube(0, 0, 0)) & " (expected 100)"
    Print "  cube(0,0,1)=" & CStr(cube(0, 0, 1)) & " (expected 101)"
    Print "  cube(0,1,0)=" & CStr(cube(0, 1, 0)) & " (expected 110)"
    Print "  cube(1,1,1)=" & CStr(cube(1, 1, 1)) & " (expected 222)"
    Print ""
    
    ' Test 3: Loop through 2D array
    Print "Test 3: Loop through 2D array"
    Dim total As Integer
    total = 0
    For i = 0 To 2
        For j = 0 To 2
            total = total + grid(i, j)
        Next j
    Next i
    Print "  Sum of all elements: " & CStr(total) & " (expected 45)"
    Print ""
    
    ' Test 4: Update existing values
    Print "Test 4: Update existing values"
    grid(1, 1) = 99
    Print "  grid(1,1) after update=" & CStr(grid(1, 1)) & " (expected 99)"
    Print ""
    
    Print "=== All tests completed ==="
End Sub
