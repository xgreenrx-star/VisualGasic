Attribute VB_Name = "fuzz_inst_60"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AudioEffectDistortion = AudioEffectDistortion.new()
    If obj <> Null Then
        Print "PASS:inst_AudioEffectDistortion"
    Else
        Print "FAIL:inst_AudioEffectDistortion returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AudioEffectDistortion err=" & str(Err.Number)
    End If
End Sub


