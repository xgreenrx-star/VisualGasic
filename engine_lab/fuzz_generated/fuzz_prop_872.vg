Attribute VB_Name = "fuzz_prop_872"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ColorPicker = ColorPicker.new()
    If obj = Null Then
        Print "SKIP:prop_ColorPicker_color_mode (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.color_mode
    Print "PASS:prop_ColorPicker_color_mode"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_ColorPicker_color_mode err=" & str(Err.Number)
    End If
End Sub


