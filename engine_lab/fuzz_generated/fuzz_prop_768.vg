Attribute VB_Name = "fuzz_prop_768"


Sub RunTest0()
    On Error Resume Next
    Dim obj As TextEdit = TextEdit.new()
    If obj = Null Then
        Print "SKIP:prop_TextEdit_emoji_menu_enabled (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.emoji_menu_enabled
    Print "PASS:prop_TextEdit_emoji_menu_enabled"
    obj.emoji_menu_enabled = True
    Dim val2 As Variant = obj.emoji_menu_enabled
    Print "PASS:propset_TextEdit_emoji_menu_enabled"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_TextEdit_emoji_menu_enabled err=" & str(Err.Number)
    End If
End Sub


