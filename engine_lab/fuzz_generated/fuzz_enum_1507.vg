Attribute VB_Name = "fuzz_enum_1507"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_SELECT_SINGLE As Integer = Tree.SELECT_SINGLE
    If v_SELECT_SINGLE = 0 Then pass_count = pass_count + 1
    Dim v_SELECT_ROW As Integer = Tree.SELECT_ROW
    If v_SELECT_ROW = 1 Then pass_count = pass_count + 1
    Dim v_SELECT_MULTI As Integer = Tree.SELECT_MULTI
    If v_SELECT_MULTI = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_Tree_SelectMode"
    Else
        Print "FAIL:enum_Tree_SelectMode count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Tree_SelectMode err=" & str(Err.Number)
    End If
End Sub


