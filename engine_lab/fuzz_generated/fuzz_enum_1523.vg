Sub RunTest4()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_COMPRESSION_DEFAULT As Integer = ZIPPacker.COMPRESSION_DEFAULT
    If v_COMPRESSION_DEFAULT = -1 Then pass_count = pass_count + 1
    Dim v_COMPRESSION_NONE As Integer = ZIPPacker.COMPRESSION_NONE
    If v_COMPRESSION_NONE = 0 Then pass_count = pass_count + 1
    Dim v_COMPRESSION_FAST As Integer = ZIPPacker.COMPRESSION_FAST
    If v_COMPRESSION_FAST = 1 Then pass_count = pass_count + 1
    Dim v_COMPRESSION_BEST As Integer = ZIPPacker.COMPRESSION_BEST
    If v_COMPRESSION_BEST = 9 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_ZIPPacker_CompressionLevel"
    Else
        Print "FAIL:enum_ZIPPacker_CompressionLevel count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_ZIPPacker_CompressionLevel err=" & str(Err.Number)
    End If
End Sub

Sub RunTest()
    RunTest0()
    RunTest1()
    RunTest2()
    RunTest3()
    RunTest4()
End Sub
