Attribute VB_Name = "fuzz_enum_1523"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_XR_VRS_TEXTURE_FORMAT_UNIFIED As Integer = XRInterface.XR_VRS_TEXTURE_FORMAT_UNIFIED
    If v_XR_VRS_TEXTURE_FORMAT_UNIFIED = 0 Then pass_count = pass_count + 1
    Dim v_XR_VRS_TEXTURE_FORMAT_FRAGMENT_SHADING_RATE As Integer = XRInterface.XR_VRS_TEXTURE_FORMAT_FRAGMENT_SHADING_RATE
    If v_XR_VRS_TEXTURE_FORMAT_FRAGMENT_SHADING_RATE = 1 Then pass_count = pass_count + 1
    Dim v_XR_VRS_TEXTURE_FORMAT_FRAGMENT_DENSITY_MAP As Integer = XRInterface.XR_VRS_TEXTURE_FORMAT_FRAGMENT_DENSITY_MAP
    If v_XR_VRS_TEXTURE_FORMAT_FRAGMENT_DENSITY_MAP = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_XRInterface_VRSTextureFormat"
    Else
        Print "FAIL:enum_XRInterface_VRSTextureFormat count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_XRInterface_VRSTextureFormat err=" & str(Err.Number)
    End If
End Sub


