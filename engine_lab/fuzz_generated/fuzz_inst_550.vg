Attribute VB_Name = "fuzz_inst_550"


Sub RunTest0()
    On Error Resume Next
    Dim obj As TabBar = TabBar.new()
    If obj <> Null Then
        Print "PASS:inst_TabBar"
        obj.free()
    Else
        Print "FAIL:inst_TabBar returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_TabBar err=" & str(Err.Number)
    End If
End Sub


