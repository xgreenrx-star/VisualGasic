Attribute VB_Name = "fuzz_inst_30"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AnimationNodeBlendTree = AnimationNodeBlendTree.new()
    If obj <> Null Then
        Print "PASS:inst_AnimationNodeBlendTree"
    Else
        Print "FAIL:inst_AnimationNodeBlendTree returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AnimationNodeBlendTree err=" & str(Err.Number)
    End If
End Sub


