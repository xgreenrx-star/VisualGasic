Attribute VB_Name = "fuzz_enum_1503"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_HINTING_NONE As Integer = TextServer.HINTING_NONE
    If v_HINTING_NONE = 0 Then pass_count = pass_count + 1
    Dim v_HINTING_LIGHT As Integer = TextServer.HINTING_LIGHT
    If v_HINTING_LIGHT = 1 Then pass_count = pass_count + 1
    Dim v_HINTING_NORMAL As Integer = TextServer.HINTING_NORMAL
    If v_HINTING_NORMAL = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_TextServer_Hinting"
    Else
        Print "FAIL:enum_TextServer_Hinting count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_TextServer_Hinting err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_SUBPIXEL_POSITIONING_DISABLED As Integer = TextServer.SUBPIXEL_POSITIONING_DISABLED
    If v_SUBPIXEL_POSITIONING_DISABLED = 0 Then pass_count = pass_count + 1
    Dim v_SUBPIXEL_POSITIONING_AUTO As Integer = TextServer.SUBPIXEL_POSITIONING_AUTO
    If v_SUBPIXEL_POSITIONING_AUTO = 1 Then pass_count = pass_count + 1
    Dim v_SUBPIXEL_POSITIONING_ONE_HALF As Integer = TextServer.SUBPIXEL_POSITIONING_ONE_HALF
    If v_SUBPIXEL_POSITIONING_ONE_HALF = 2 Then pass_count = pass_count + 1
    Dim v_SUBPIXEL_POSITIONING_ONE_QUARTER As Integer = TextServer.SUBPIXEL_POSITIONING_ONE_QUARTER
    If v_SUBPIXEL_POSITIONING_ONE_QUARTER = 3 Then pass_count = pass_count + 1
    Dim v_SUBPIXEL_POSITIONING_ONE_HALF_MAX_SIZE As Integer = TextServer.SUBPIXEL_POSITIONING_ONE_HALF_MAX_SIZE
    If v_SUBPIXEL_POSITIONING_ONE_HALF_MAX_SIZE = 20 Then pass_count = pass_count + 1
    Dim v_SUBPIXEL_POSITIONING_ONE_QUARTER_MAX_SIZE As Integer = TextServer.SUBPIXEL_POSITIONING_ONE_QUARTER_MAX_SIZE
    If v_SUBPIXEL_POSITIONING_ONE_QUARTER_MAX_SIZE = 16 Then pass_count = pass_count + 1
    If pass_count = 6 Then
        Print "PASS:enum_TextServer_SubpixelPositioning"
    Else
        Print "FAIL:enum_TextServer_SubpixelPositioning count=" & str(pass_count) & "/6"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_TextServer_SubpixelPositioning err=" & str(Err.Number)
    End If
End Sub


