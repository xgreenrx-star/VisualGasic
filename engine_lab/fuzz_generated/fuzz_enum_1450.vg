Attribute VB_Name = "fuzz_enum_1450"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_MIX_MODE_BLEND As Integer = AnimationNodeOneShot.MIX_MODE_BLEND
    If v_MIX_MODE_BLEND = 0 Then pass_count = pass_count + 1
    Dim v_MIX_MODE_ADD As Integer = AnimationNodeOneShot.MIX_MODE_ADD
    If v_MIX_MODE_ADD = 1 Then pass_count = pass_count + 1
    If pass_count = 2 Then
        Print "PASS:enum_AnimationNodeOneShot_MixMode"
    Else
        Print "FAIL:enum_AnimationNodeOneShot_MixMode count=" & str(pass_count) & "/2"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_AnimationNodeOneShot_MixMode err=" & str(Err.Number)
    End If
End Sub


