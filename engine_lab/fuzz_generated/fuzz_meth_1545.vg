Sub RunTest0()
    On Error Resume Next
    Dim obj As CodeEdit = CodeEdit.new()
    If obj = Null Then
        Print "SKIP:meth_CodeEdit (null)"
        Exit Sub
    End If
    Dim r_get_indent_size As Variant = obj.get_indent_size()
    Print "PASS:meth_CodeEdit_get_indent_size"
    Dim r_is_indent_using_spaces As Variant = obj.is_indent_using_spaces()
    Print "PASS:meth_CodeEdit_is_indent_using_spaces"
    Dim r_is_auto_indent_enabled As Variant = obj.is_auto_indent_enabled()
    Print "PASS:meth_CodeEdit_is_auto_indent_enabled"
    Dim r_get_auto_indent_prefixes As Variant = obj.get_auto_indent_prefixes()
    Print "PASS:meth_CodeEdit_get_auto_indent_prefixes"
    Dim r_is_auto_brace_completion_enabled As Variant = obj.is_auto_brace_completion_enabled()
    Print "PASS:meth_CodeEdit_is_auto_brace_completion_enabled"
    Dim r_is_highlight_matching_braces_enabled As Variant = obj.is_highlight_matching_braces_enabled()
    Print "PASS:meth_CodeEdit_is_highlight_matching_braces_enabled"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_CodeEdit err=" & str(Err.Number)
    End If
End Sub


