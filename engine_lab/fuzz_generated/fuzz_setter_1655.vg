Attribute VB_Name = "fuzz_setter_1655"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AnimatableBody2D = AnimatableBody2D.new()
    If obj = Null Then
        Print "SKIP:setter_AnimatableBody2D (null)"
        Exit Sub
    End If
    obj.set_sync_to_physics(True)
    Print "PASS:setter_AnimatableBody2D_set_sync_to_physics"
    obj.set_constant_angular_velocity(1.0)
    Print "PASS:setter_AnimatableBody2D_set_constant_angular_velocity"
    obj.set_collision_layer(0)
    Print "PASS:setter_AnimatableBody2D_set_collision_layer"
    obj.set_collision_mask(0)
    Print "PASS:setter_AnimatableBody2D_set_collision_mask"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:setter_AnimatableBody2D err=" & str(Err.Number)
    End If
End Sub


