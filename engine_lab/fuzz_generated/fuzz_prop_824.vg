Attribute VB_Name = "fuzz_prop_824"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CheckButton = CheckButton.new()
    If obj = Null Then
        Print "SKIP:prop_CheckButton_text (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.text
    Print "PASS:prop_CheckButton_text"
    obj.text = "test_string"
    Dim val2 As Variant = obj.text
    Print "PASS:propset_CheckButton_text"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_CheckButton_text err=" & str(Err.Number)
    End If
End Sub


