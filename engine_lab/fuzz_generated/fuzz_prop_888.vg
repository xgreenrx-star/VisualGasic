Attribute VB_Name = "fuzz_prop_888"


Sub RunTest0()
    On Error Resume Next
    Dim obj As Tree = Tree.new()
    If obj = Null Then
        Print "SKIP:prop_Tree_allow_search (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.allow_search
    Print "PASS:prop_Tree_allow_search"
    obj.allow_search = True
    Dim val2 As Variant = obj.allow_search
    Print "PASS:propset_Tree_allow_search"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_Tree_allow_search err=" & str(Err.Number)
    End If
End Sub


