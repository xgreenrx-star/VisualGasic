Attribute VB_Name = "fuzz_enum_1496"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_MODIFIER_CALLBACK_MODE_PROCESS_PHYSICS As Integer = Skeleton3D.MODIFIER_CALLBACK_MODE_PROCESS_PHYSICS
    If v_MODIFIER_CALLBACK_MODE_PROCESS_PHYSICS = 0 Then pass_count = pass_count + 1
    Dim v_MODIFIER_CALLBACK_MODE_PROCESS_IDLE As Integer = Skeleton3D.MODIFIER_CALLBACK_MODE_PROCESS_IDLE
    If v_MODIFIER_CALLBACK_MODE_PROCESS_IDLE = 1 Then pass_count = pass_count + 1
    Dim v_MODIFIER_CALLBACK_MODE_PROCESS_MANUAL As Integer = Skeleton3D.MODIFIER_CALLBACK_MODE_PROCESS_MANUAL
    If v_MODIFIER_CALLBACK_MODE_PROCESS_MANUAL = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_Skeleton3D_ModifierCallbackModeProcess"
    Else
        Print "FAIL:enum_Skeleton3D_ModifierCallbackModeProcess count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Skeleton3D_ModifierCallbackModeProcess err=" & str(Err.Number)
    End If
End Sub


