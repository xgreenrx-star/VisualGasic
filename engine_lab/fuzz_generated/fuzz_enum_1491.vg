Attribute VB_Name = "fuzz_enum_1491"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_JOINT_TYPE_NONE As Integer = PhysicalBone3D.JOINT_TYPE_NONE
    If v_JOINT_TYPE_NONE = 0 Then pass_count = pass_count + 1
    Dim v_JOINT_TYPE_PIN As Integer = PhysicalBone3D.JOINT_TYPE_PIN
    If v_JOINT_TYPE_PIN = 1 Then pass_count = pass_count + 1
    Dim v_JOINT_TYPE_CONE As Integer = PhysicalBone3D.JOINT_TYPE_CONE
    If v_JOINT_TYPE_CONE = 2 Then pass_count = pass_count + 1
    Dim v_JOINT_TYPE_HINGE As Integer = PhysicalBone3D.JOINT_TYPE_HINGE
    If v_JOINT_TYPE_HINGE = 3 Then pass_count = pass_count + 1
    Dim v_JOINT_TYPE_SLIDER As Integer = PhysicalBone3D.JOINT_TYPE_SLIDER
    If v_JOINT_TYPE_SLIDER = 4 Then pass_count = pass_count + 1
    Dim v_JOINT_TYPE_6DOF As Integer = PhysicalBone3D.JOINT_TYPE_6DOF
    If v_JOINT_TYPE_6DOF = 5 Then pass_count = pass_count + 1
    If pass_count = 6 Then
        Print "PASS:enum_PhysicalBone3D_JointType"
    Else
        Print "FAIL:enum_PhysicalBone3D_JointType count=" & str(pass_count) & "/6"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_PhysicalBone3D_JointType err=" & str(Err.Number)
    End If
End Sub


