Attribute VB_Name = "fuzz_inst_370"


Sub RunTest0()
    On Error Resume Next
    Dim obj As OpenXRInteractionProfile = OpenXRInteractionProfile.new()
    If obj <> Null Then
        Print "PASS:inst_OpenXRInteractionProfile"
    Else
        Print "FAIL:inst_OpenXRInteractionProfile returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_OpenXRInteractionProfile err=" & str(Err.Number)
    End If
End Sub


