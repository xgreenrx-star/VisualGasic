Attribute VB_Name = "fuzz_inst_160"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CompressedTexture2D = CompressedTexture2D.new()
    If obj <> Null Then
        Print "PASS:inst_CompressedTexture2D"
    Else
        Print "FAIL:inst_CompressedTexture2D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_CompressedTexture2D err=" & str(Err.Number)
    End If
End Sub


