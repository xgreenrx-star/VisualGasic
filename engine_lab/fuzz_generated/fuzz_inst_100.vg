Attribute VB_Name = "fuzz_inst_100"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AudioStreamSynchronized = AudioStreamSynchronized.new()
    If obj <> Null Then
        Print "PASS:inst_AudioStreamSynchronized"
    Else
        Print "FAIL:inst_AudioStreamSynchronized returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AudioStreamSynchronized err=" & str(Err.Number)
    End If
End Sub


