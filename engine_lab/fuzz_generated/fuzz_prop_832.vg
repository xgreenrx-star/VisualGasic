Attribute VB_Name = "fuzz_prop_832"


Sub RunTest0()
    On Error Resume Next
    Dim obj As Environment = Environment.new()
    If obj = Null Then
        Print "SKIP:prop_Environment_background_intensity (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.background_intensity
    Print "PASS:prop_Environment_background_intensity"
    If Err.Number <> 0 Then
        Print "ERROR:prop_Environment_background_intensity err=" & str(Err.Number)
    End If
End Sub


