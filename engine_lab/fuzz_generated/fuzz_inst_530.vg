Attribute VB_Name = "fuzz_inst_530"


Sub RunTest0()
    On Error Resume Next
    Dim obj As StandardMaterial3D = StandardMaterial3D.new()
    If obj <> Null Then
        Print "PASS:inst_StandardMaterial3D"
    Else
        Print "FAIL:inst_StandardMaterial3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_StandardMaterial3D err=" & str(Err.Number)
    End If
End Sub


