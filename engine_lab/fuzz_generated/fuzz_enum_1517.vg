Attribute VB_Name = "fuzz_enum_1517"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FILTER_DEFAULT As Integer = VisualShaderNodeTextureParameter.FILTER_DEFAULT
    If v_FILTER_DEFAULT = 0 Then pass_count = pass_count + 1
    Dim v_FILTER_NEAREST As Integer = VisualShaderNodeTextureParameter.FILTER_NEAREST
    If v_FILTER_NEAREST = 1 Then pass_count = pass_count + 1
    Dim v_FILTER_LINEAR As Integer = VisualShaderNodeTextureParameter.FILTER_LINEAR
    If v_FILTER_LINEAR = 2 Then pass_count = pass_count + 1
    Dim v_FILTER_NEAREST_MIPMAP As Integer = VisualShaderNodeTextureParameter.FILTER_NEAREST_MIPMAP
    If v_FILTER_NEAREST_MIPMAP = 3 Then pass_count = pass_count + 1
    Dim v_FILTER_LINEAR_MIPMAP As Integer = VisualShaderNodeTextureParameter.FILTER_LINEAR_MIPMAP
    If v_FILTER_LINEAR_MIPMAP = 4 Then pass_count = pass_count + 1
    Dim v_FILTER_NEAREST_MIPMAP_ANISOTROPIC As Integer = VisualShaderNodeTextureParameter.FILTER_NEAREST_MIPMAP_ANISOTROPIC
    If v_FILTER_NEAREST_MIPMAP_ANISOTROPIC = 5 Then pass_count = pass_count + 1
    Dim v_FILTER_LINEAR_MIPMAP_ANISOTROPIC As Integer = VisualShaderNodeTextureParameter.FILTER_LINEAR_MIPMAP_ANISOTROPIC
    If v_FILTER_LINEAR_MIPMAP_ANISOTROPIC = 6 Then pass_count = pass_count + 1
    Dim v_FILTER_MAX As Integer = VisualShaderNodeTextureParameter.FILTER_MAX
    If v_FILTER_MAX = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_VisualShaderNodeTextureParameter_TextureFilter"
    Else
        Print "FAIL:enum_VisualShaderNodeTextureParameter_TextureFilter count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_VisualShaderNodeTextureParameter_TextureFilter err=" & str(Err.Number)
    End If
End Sub


