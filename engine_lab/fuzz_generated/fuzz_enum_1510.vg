Attribute VB_Name = "fuzz_enum_1510"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_VRS_DISABLED As Integer = Viewport.VRS_DISABLED
    If v_VRS_DISABLED = 0 Then pass_count = pass_count + 1
    Dim v_VRS_TEXTURE As Integer = Viewport.VRS_TEXTURE
    If v_VRS_TEXTURE = 1 Then pass_count = pass_count + 1
    Dim v_VRS_XR As Integer = Viewport.VRS_XR
    If v_VRS_XR = 2 Then pass_count = pass_count + 1
    Dim v_VRS_MAX As Integer = Viewport.VRS_MAX
    If v_VRS_MAX = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_Viewport_VRSMode"
    Else
        Print "FAIL:enum_Viewport_VRSMode count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Viewport_VRSMode err=" & str(Err.Number)
    End If
End Sub


