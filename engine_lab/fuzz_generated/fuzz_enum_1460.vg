Attribute VB_Name = "fuzz_enum_1460"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_EMISSION_SHAPE_POINT As Integer = CPUParticles3D.EMISSION_SHAPE_POINT
    If v_EMISSION_SHAPE_POINT = 0 Then pass_count = pass_count + 1
    Dim v_EMISSION_SHAPE_SPHERE As Integer = CPUParticles3D.EMISSION_SHAPE_SPHERE
    If v_EMISSION_SHAPE_SPHERE = 1 Then pass_count = pass_count + 1
    Dim v_EMISSION_SHAPE_SPHERE_SURFACE As Integer = CPUParticles3D.EMISSION_SHAPE_SPHERE_SURFACE
    If v_EMISSION_SHAPE_SPHERE_SURFACE = 2 Then pass_count = pass_count + 1
    Dim v_EMISSION_SHAPE_BOX As Integer = CPUParticles3D.EMISSION_SHAPE_BOX
    If v_EMISSION_SHAPE_BOX = 3 Then pass_count = pass_count + 1
    Dim v_EMISSION_SHAPE_POINTS As Integer = CPUParticles3D.EMISSION_SHAPE_POINTS
    If v_EMISSION_SHAPE_POINTS = 4 Then pass_count = pass_count + 1
    Dim v_EMISSION_SHAPE_DIRECTED_POINTS As Integer = CPUParticles3D.EMISSION_SHAPE_DIRECTED_POINTS
    If v_EMISSION_SHAPE_DIRECTED_POINTS = 5 Then pass_count = pass_count + 1
    Dim v_EMISSION_SHAPE_RING As Integer = CPUParticles3D.EMISSION_SHAPE_RING
    If v_EMISSION_SHAPE_RING = 6 Then pass_count = pass_count + 1
    Dim v_EMISSION_SHAPE_MAX As Integer = CPUParticles3D.EMISSION_SHAPE_MAX
    If v_EMISSION_SHAPE_MAX = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_CPUParticles3D_EmissionShape"
    Else
        Print "FAIL:enum_CPUParticles3D_EmissionShape count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_CPUParticles3D_EmissionShape err=" & str(Err.Number)
    End If
End Sub


