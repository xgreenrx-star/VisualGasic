Attribute VB_Name = "fuzz_inst_170"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ConvexPolygonShape3D = ConvexPolygonShape3D.new()
    If obj <> Null Then
        Print "PASS:inst_ConvexPolygonShape3D"
    Else
        Print "FAIL:inst_ConvexPolygonShape3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_ConvexPolygonShape3D err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
    On Error Resume Next
    Dim obj As CopyTransformModifier3D = CopyTransformModifier3D.new()
    If obj <> Null Then
        Print "PASS:inst_CopyTransformModifier3D"
        obj.free()
    Else
        Print "FAIL:inst_CopyTransformModifier3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_CopyTransformModifier3D err=" & str(Err.Number)
    End If
End Sub


