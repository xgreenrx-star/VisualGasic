Attribute VB_Name = "fuzz_enum_1455"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_ACTION_MODE_BUTTON_PRESS As Integer = BaseButton.ACTION_MODE_BUTTON_PRESS
    If v_ACTION_MODE_BUTTON_PRESS = 0 Then pass_count = pass_count + 1
    Dim v_ACTION_MODE_BUTTON_RELEASE As Integer = BaseButton.ACTION_MODE_BUTTON_RELEASE
    If v_ACTION_MODE_BUTTON_RELEASE = 1 Then pass_count = pass_count + 1
    If pass_count = 2 Then
        Print "PASS:enum_BaseButton_ActionMode"
    Else
        Print "FAIL:enum_BaseButton_ActionMode count=" & str(pass_count) & "/2"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_BaseButton_ActionMode err=" & str(Err.Number)
    End If
End Sub


