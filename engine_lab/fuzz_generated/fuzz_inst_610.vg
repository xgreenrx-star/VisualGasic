Attribute VB_Name = "fuzz_inst_610"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualInstance3D = VisualInstance3D.new()
    If obj <> Null Then
        Print "PASS:inst_VisualInstance3D"
        obj.free()
    Else
        Print "FAIL:inst_VisualInstance3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualInstance3D err=" & str(Err.Number)
    End If
End Sub


