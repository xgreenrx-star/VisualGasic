Attribute VB_Name = "fuzz_prop_904"


Sub RunTest0()
    On Error Resume Next
    Dim obj As TabContainer = TabContainer.new()
    If obj = Null Then
        Print "SKIP:prop_TabContainer_tab_alignment (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.tab_alignment
    Print "PASS:prop_TabContainer_tab_alignment"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_TabContainer_tab_alignment err=" & str(Err.Number)
    End If
End Sub


