Attribute VB_Name = "fuzz_enum_1489"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_PERF_SETTINGS_NOTIF_LEVEL_NORMAL As Integer = OpenXRInterface.PERF_SETTINGS_NOTIF_LEVEL_NORMAL
    If v_PERF_SETTINGS_NOTIF_LEVEL_NORMAL = 0 Then pass_count = pass_count + 1
    Dim v_PERF_SETTINGS_NOTIF_LEVEL_WARNING As Integer = OpenXRInterface.PERF_SETTINGS_NOTIF_LEVEL_WARNING
    If v_PERF_SETTINGS_NOTIF_LEVEL_WARNING = 1 Then pass_count = pass_count + 1
    Dim v_PERF_SETTINGS_NOTIF_LEVEL_IMPAIRED As Integer = OpenXRInterface.PERF_SETTINGS_NOTIF_LEVEL_IMPAIRED
    If v_PERF_SETTINGS_NOTIF_LEVEL_IMPAIRED = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_OpenXRInterface_PerfSettingsNotificationLevel"
    Else
        Print "FAIL:enum_OpenXRInterface_PerfSettingsNotificationLevel count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_OpenXRInterface_PerfSettingsNotificationLevel err=" & str(Err.Number)
    End If
End Sub


