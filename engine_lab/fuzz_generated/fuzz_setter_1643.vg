Attribute VB_Name = "fuzz_setter_1643"


Sub RunTest0()
    On Error Resume Next
    Dim obj As GPUParticles2D = GPUParticles2D.new()
    If obj = Null Then
        Print "SKIP:setter_GPUParticles2D (null)"
        Exit Sub
    End If
    obj.set_emitting(True)
    Print "PASS:setter_GPUParticles2D_set_emitting"
    obj.set_lifetime(1.0)
    Print "PASS:setter_GPUParticles2D_set_lifetime"
    obj.set_one_shot(True)
    Print "PASS:setter_GPUParticles2D_set_one_shot"
    obj.set_pre_process_time(1.0)
    Print "PASS:setter_GPUParticles2D_set_pre_process_time"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:setter_GPUParticles2D err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
