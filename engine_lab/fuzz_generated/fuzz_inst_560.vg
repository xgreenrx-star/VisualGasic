Attribute VB_Name = "fuzz_inst_560"


Sub RunTest0()
    On Error Resume Next
    Dim obj As Texture2D = Texture2D.new()
    If obj <> Null Then
        Print "PASS:inst_Texture2D"
    Else
        Print "FAIL:inst_Texture2D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_Texture2D err=" & str(Err.Number)
    End If
End Sub


