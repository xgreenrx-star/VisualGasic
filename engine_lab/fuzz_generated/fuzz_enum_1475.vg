Attribute VB_Name = "fuzz_enum_1475"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_METHOD_GET As Integer = HTTPClient.METHOD_GET
    If v_METHOD_GET = 0 Then pass_count = pass_count + 1
    Dim v_METHOD_HEAD As Integer = HTTPClient.METHOD_HEAD
    If v_METHOD_HEAD = 1 Then pass_count = pass_count + 1
    Dim v_METHOD_POST As Integer = HTTPClient.METHOD_POST
    If v_METHOD_POST = 2 Then pass_count = pass_count + 1
    Dim v_METHOD_PUT As Integer = HTTPClient.METHOD_PUT
    If v_METHOD_PUT = 3 Then pass_count = pass_count + 1
    Dim v_METHOD_DELETE As Integer = HTTPClient.METHOD_DELETE
    If v_METHOD_DELETE = 4 Then pass_count = pass_count + 1
    Dim v_METHOD_OPTIONS As Integer = HTTPClient.METHOD_OPTIONS
    If v_METHOD_OPTIONS = 5 Then pass_count = pass_count + 1
    Dim v_METHOD_TRACE As Integer = HTTPClient.METHOD_TRACE
    If v_METHOD_TRACE = 6 Then pass_count = pass_count + 1
    Dim v_METHOD_CONNECT As Integer = HTTPClient.METHOD_CONNECT
    If v_METHOD_CONNECT = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_HTTPClient_Method"
    Else
        Print "FAIL:enum_HTTPClient_Method count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_HTTPClient_Method err=" & str(Err.Number)
    End If
End Sub


