Attribute VB_Name = "fuzz_enum_1511"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_VARYING_TYPE_FLOAT As Integer = VisualShader.VARYING_TYPE_FLOAT
    If v_VARYING_TYPE_FLOAT = 0 Then pass_count = pass_count + 1
    Dim v_VARYING_TYPE_INT As Integer = VisualShader.VARYING_TYPE_INT
    If v_VARYING_TYPE_INT = 1 Then pass_count = pass_count + 1
    Dim v_VARYING_TYPE_UINT As Integer = VisualShader.VARYING_TYPE_UINT
    If v_VARYING_TYPE_UINT = 2 Then pass_count = pass_count + 1
    Dim v_VARYING_TYPE_VECTOR_2D As Integer = VisualShader.VARYING_TYPE_VECTOR_2D
    If v_VARYING_TYPE_VECTOR_2D = 3 Then pass_count = pass_count + 1
    Dim v_VARYING_TYPE_VECTOR_3D As Integer = VisualShader.VARYING_TYPE_VECTOR_3D
    If v_VARYING_TYPE_VECTOR_3D = 4 Then pass_count = pass_count + 1
    Dim v_VARYING_TYPE_VECTOR_4D As Integer = VisualShader.VARYING_TYPE_VECTOR_4D
    If v_VARYING_TYPE_VECTOR_4D = 5 Then pass_count = pass_count + 1
    Dim v_VARYING_TYPE_BOOLEAN As Integer = VisualShader.VARYING_TYPE_BOOLEAN
    If v_VARYING_TYPE_BOOLEAN = 6 Then pass_count = pass_count + 1
    Dim v_VARYING_TYPE_TRANSFORM As Integer = VisualShader.VARYING_TYPE_TRANSFORM
    If v_VARYING_TYPE_TRANSFORM = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_VisualShader_VaryingType"
    Else
        Print "FAIL:enum_VisualShader_VaryingType count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_VisualShader_VaryingType err=" & str(Err.Number)
    End If
End Sub


