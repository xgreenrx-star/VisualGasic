Attribute VB_Name = "fuzz_inst_150"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CollisionShape2D = CollisionShape2D.new()
    If obj <> Null Then
        Print "PASS:inst_CollisionShape2D"
        obj.free()
    Else
        Print "FAIL:inst_CollisionShape2D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_CollisionShape2D err=" & str(Err.Number)
    End If
End Sub


