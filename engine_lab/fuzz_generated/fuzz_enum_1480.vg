Attribute VB_Name = "fuzz_enum_1480"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_LINE_CAP_NONE As Integer = Line2D.LINE_CAP_NONE
    If v_LINE_CAP_NONE = 0 Then pass_count = pass_count + 1
    Dim v_LINE_CAP_BOX As Integer = Line2D.LINE_CAP_BOX
    If v_LINE_CAP_BOX = 1 Then pass_count = pass_count + 1
    Dim v_LINE_CAP_ROUND As Integer = Line2D.LINE_CAP_ROUND
    If v_LINE_CAP_ROUND = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_Line2D_LineCapMode"
    Else
        Print "FAIL:enum_Line2D_LineCapMode count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Line2D_LineCapMode err=" & str(Err.Number)
    End If
End Sub


