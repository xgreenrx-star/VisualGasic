Attribute VB_Name = "fuzz_enum_1474"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_GRADIENT_INTERPOLATE_LINEAR As Integer = Gradient.GRADIENT_INTERPOLATE_LINEAR
    If v_GRADIENT_INTERPOLATE_LINEAR = 0 Then pass_count = pass_count + 1
    Dim v_GRADIENT_INTERPOLATE_CONSTANT As Integer = Gradient.GRADIENT_INTERPOLATE_CONSTANT
    If v_GRADIENT_INTERPOLATE_CONSTANT = 1 Then pass_count = pass_count + 1
    Dim v_GRADIENT_INTERPOLATE_CUBIC As Integer = Gradient.GRADIENT_INTERPOLATE_CUBIC
    If v_GRADIENT_INTERPOLATE_CUBIC = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_Gradient_InterpolationMode"
    Else
        Print "FAIL:enum_Gradient_InterpolationMode count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Gradient_InterpolationMode err=" & str(Err.Number)
    End If
End Sub


