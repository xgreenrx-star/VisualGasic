Sub RunTest5()
    On Error Resume Next
    Dim obj As CSGPolygon3D = CSGPolygon3D.new()
    If obj = Null Then
        Print "SKIP:setter_CSGPolygon3D (null)"
        Exit Sub
    End If
    obj.set_depth(1.0)
    Print "PASS:setter_CSGPolygon3D_set_depth"
    obj.set_spin_degrees(1.0)
    Print "PASS:setter_CSGPolygon3D_set_spin_degrees"
    obj.set_spin_sides(0)
    Print "PASS:setter_CSGPolygon3D_set_spin_sides"
    obj.set_path_interval(1.0)
    Print "PASS:setter_CSGPolygon3D_set_path_interval"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:setter_CSGPolygon3D err=" & str(Err.Number)
    End If
End Sub

Sub RunTest()
    RunTest0()
    RunTest1()
    RunTest2()
    RunTest3()
    RunTest4()
    RunTest5()
End Sub
