Attribute VB_Name = "fuzz_setter_1637"


Sub RunTest0()
    On Error Resume Next
    Dim obj As GraphEdit = GraphEdit.new()
    If obj = Null Then
        Print "SKIP:setter_GraphEdit (null)"
        Exit Sub
    End If
    obj.add_valid_right_disconnect_type(0)
    Print "PASS:setter_GraphEdit_add_valid_right_disconnect_type"
    obj.remove_valid_right_disconnect_type(0)
    Print "PASS:setter_GraphEdit_remove_valid_right_disconnect_type"
    obj.add_valid_left_disconnect_type(0)
    Print "PASS:setter_GraphEdit_add_valid_left_disconnect_type"
    obj.remove_valid_left_disconnect_type(0)
    Print "PASS:setter_GraphEdit_remove_valid_left_disconnect_type"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:setter_GraphEdit err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
    On Error Resume Next
    Dim obj As GPUParticles3D = GPUParticles3D.new()
    If obj = Null Then
        Print "SKIP:setter_GPUParticles3D (null)"
        Exit Sub
    End If
    obj.set_emitting(True)
    Print "PASS:setter_GPUParticles3D_set_emitting"
    obj.set_lifetime(1.0)
    Print "PASS:setter_GPUParticles3D_set_lifetime"
    obj.set_one_shot(True)
    Print "PASS:setter_GPUParticles3D_set_one_shot"
    obj.set_pre_process_time(1.0)
    Print "PASS:setter_GPUParticles3D_set_pre_process_time"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:setter_GPUParticles3D err=" & str(Err.Number)
    End If
End Sub


