Attribute VB_Name = "fuzz_enum_1465"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_TANGENT_FREE As Integer = Curve.TANGENT_FREE
    If v_TANGENT_FREE = 0 Then pass_count = pass_count + 1
    Dim v_TANGENT_LINEAR As Integer = Curve.TANGENT_LINEAR
    If v_TANGENT_LINEAR = 1 Then pass_count = pass_count + 1
    Dim v_TANGENT_MODE_COUNT As Integer = Curve.TANGENT_MODE_COUNT
    If v_TANGENT_MODE_COUNT = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_Curve_TangentMode"
    Else
        Print "FAIL:enum_Curve_TangentMode count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Curve_TangentMode err=" & str(Err.Number)
    End If
End Sub


