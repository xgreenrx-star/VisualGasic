Attribute VB_Name = "fuzz_enum_1519"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_SUBDIV_64 As Integer = VoxelGI.SUBDIV_64
    If v_SUBDIV_64 = 0 Then pass_count = pass_count + 1
    Dim v_SUBDIV_128 As Integer = VoxelGI.SUBDIV_128
    If v_SUBDIV_128 = 1 Then pass_count = pass_count + 1
    Dim v_SUBDIV_256 As Integer = VoxelGI.SUBDIV_256
    If v_SUBDIV_256 = 2 Then pass_count = pass_count + 1
    Dim v_SUBDIV_512 As Integer = VoxelGI.SUBDIV_512
    If v_SUBDIV_512 = 3 Then pass_count = pass_count + 1
    Dim v_SUBDIV_MAX As Integer = VoxelGI.SUBDIV_MAX
    If v_SUBDIV_MAX = 4 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_VoxelGI_Subdiv"
    Else
        Print "FAIL:enum_VoxelGI_Subdiv count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_VoxelGI_Subdiv err=" & str(Err.Number)
    End If
End Sub


