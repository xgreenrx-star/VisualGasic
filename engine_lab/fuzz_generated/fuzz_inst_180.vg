Attribute VB_Name = "fuzz_inst_180"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CurveXYZTexture = CurveXYZTexture.new()
    If obj <> Null Then
        Print "PASS:inst_CurveXYZTexture"
    Else
        Print "FAIL:inst_CurveXYZTexture returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_CurveXYZTexture err=" & str(Err.Number)
    End If
End Sub


