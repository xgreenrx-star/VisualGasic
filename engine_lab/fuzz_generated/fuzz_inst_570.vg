Attribute VB_Name = "fuzz_inst_570"


Sub RunTest0()
    On Error Resume Next
    Dim obj As TextureProgressBar = TextureProgressBar.new()
    If obj <> Null Then
        Print "PASS:inst_TextureProgressBar"
        obj.free()
    Else
        Print "FAIL:inst_TextureProgressBar returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_TextureProgressBar err=" & str(Err.Number)
    End If
End Sub


