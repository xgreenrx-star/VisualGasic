Attribute VB_Name = "fuzz_enum_1471"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_COMPONENT_TYPE_NONE As Integer = GLTFAccessor.COMPONENT_TYPE_NONE
    If v_COMPONENT_TYPE_NONE = 0 Then pass_count = pass_count + 1
    Dim v_COMPONENT_TYPE_SIGNED_BYTE As Integer = GLTFAccessor.COMPONENT_TYPE_SIGNED_BYTE
    If v_COMPONENT_TYPE_SIGNED_BYTE = 5120 Then pass_count = pass_count + 1
    Dim v_COMPONENT_TYPE_UNSIGNED_BYTE As Integer = GLTFAccessor.COMPONENT_TYPE_UNSIGNED_BYTE
    If v_COMPONENT_TYPE_UNSIGNED_BYTE = 5121 Then pass_count = pass_count + 1
    Dim v_COMPONENT_TYPE_SIGNED_SHORT As Integer = GLTFAccessor.COMPONENT_TYPE_SIGNED_SHORT
    If v_COMPONENT_TYPE_SIGNED_SHORT = 5122 Then pass_count = pass_count + 1
    Dim v_COMPONENT_TYPE_UNSIGNED_SHORT As Integer = GLTFAccessor.COMPONENT_TYPE_UNSIGNED_SHORT
    If v_COMPONENT_TYPE_UNSIGNED_SHORT = 5123 Then pass_count = pass_count + 1
    Dim v_COMPONENT_TYPE_SIGNED_INT As Integer = GLTFAccessor.COMPONENT_TYPE_SIGNED_INT
    If v_COMPONENT_TYPE_SIGNED_INT = 5124 Then pass_count = pass_count + 1
    Dim v_COMPONENT_TYPE_UNSIGNED_INT As Integer = GLTFAccessor.COMPONENT_TYPE_UNSIGNED_INT
    If v_COMPONENT_TYPE_UNSIGNED_INT = 5125 Then pass_count = pass_count + 1
    Dim v_COMPONENT_TYPE_SINGLE_FLOAT As Integer = GLTFAccessor.COMPONENT_TYPE_SINGLE_FLOAT
    If v_COMPONENT_TYPE_SINGLE_FLOAT = 5126 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_GLTFAccessor_GLTFComponentType"
    Else
        Print "FAIL:enum_GLTFAccessor_GLTFComponentType count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_GLTFAccessor_GLTFComponentType err=" & str(Err.Number)
    End If
End Sub


