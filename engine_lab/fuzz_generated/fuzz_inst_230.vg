Attribute VB_Name = "fuzz_inst_230"


Sub RunTest0()
    On Error Resume Next
    Dim obj As GPUParticlesAttractorBox3D = GPUParticlesAttractorBox3D.new()
    If obj <> Null Then
        Print "PASS:inst_GPUParticlesAttractorBox3D"
        obj.free()
    Else
        Print "FAIL:inst_GPUParticlesAttractorBox3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_GPUParticlesAttractorBox3D err=" & str(Err.Number)
    End If
End Sub


