Attribute VB_Name = "fuzz_prop_920"


Sub RunTest0()
    On Error Resume Next
    Dim obj As HSplitContainer = HSplitContainer.new()
    If obj = Null Then
        Print "SKIP:prop_HSplitContainer_collapsed (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.collapsed
    Print "PASS:prop_HSplitContainer_collapsed"
    obj.collapsed = True
    Dim val2 As Variant = obj.collapsed
    Print "PASS:propset_HSplitContainer_collapsed"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_HSplitContainer_collapsed err=" & str(Err.Number)
    End If
End Sub


