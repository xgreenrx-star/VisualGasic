Attribute VB_Name = "fuzz_meth_1587"


Sub RunTest0()
    On Error Resume Next
    Dim obj As TextureRect = TextureRect.new()
    If obj = Null Then
        Print "SKIP:meth_TextureRect (null)"
        Exit Sub
    End If
    Dim r_get_texture As Variant = obj.get_texture()
    Print "PASS:meth_TextureRect_get_texture"
    Dim r_get_expand_mode As Variant = obj.get_expand_mode()
    Print "PASS:meth_TextureRect_get_expand_mode"
    Dim r_is_flipped_h As Variant = obj.is_flipped_h()
    Print "PASS:meth_TextureRect_is_flipped_h"
    Dim r_is_flipped_v As Variant = obj.is_flipped_v()
    Print "PASS:meth_TextureRect_is_flipped_v"
    Dim r_get_stretch_mode As Variant = obj.get_stretch_mode()
    Print "PASS:meth_TextureRect_get_stretch_mode"
    Dim r_get_combined_minimum_size As Variant = obj.get_combined_minimum_size()
    Print "PASS:meth_TextureRect_get_combined_minimum_size"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_TextureRect err=" & str(Err.Number)
    End If
End Sub


