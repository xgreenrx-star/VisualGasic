Attribute VB_Name = "fuzz_inst_10"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AESContext = AESContext.new()
    If obj <> Null Then
        Print "PASS:inst_AESContext"
    Else
        Print "FAIL:inst_AESContext returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AESContext err=" & str(Err.Number)
    End If
End Sub


