Attribute VB_Name = "fuzz_enum_1449"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_ANIMATION_CALLBACK_MODE_DISCRETE_DOMINANT As Integer = AnimationMixer.ANIMATION_CALLBACK_MODE_DISCRETE_DOMINANT
    If v_ANIMATION_CALLBACK_MODE_DISCRETE_DOMINANT = 0 Then pass_count = pass_count + 1
    Dim v_ANIMATION_CALLBACK_MODE_DISCRETE_RECESSIVE As Integer = AnimationMixer.ANIMATION_CALLBACK_MODE_DISCRETE_RECESSIVE
    If v_ANIMATION_CALLBACK_MODE_DISCRETE_RECESSIVE = 1 Then pass_count = pass_count + 1
    Dim v_ANIMATION_CALLBACK_MODE_DISCRETE_FORCE_CONTINUOUS As Integer = AnimationMixer.ANIMATION_CALLBACK_MODE_DISCRETE_FORCE_CONTINUOUS
    If v_ANIMATION_CALLBACK_MODE_DISCRETE_FORCE_CONTINUOUS = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_AnimationMixer_AnimationCallbackModeDiscrete"
    Else
        Print "FAIL:enum_AnimationMixer_AnimationCallbackModeDiscrete count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_AnimationMixer_AnimationCallbackModeDiscrete err=" & str(Err.Number)
    End If
End Sub


