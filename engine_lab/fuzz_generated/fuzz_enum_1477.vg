Attribute VB_Name = "fuzz_enum_1477"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_COMPRESS_SOURCE_GENERIC As Integer = Image.COMPRESS_SOURCE_GENERIC
    If v_COMPRESS_SOURCE_GENERIC = 0 Then pass_count = pass_count + 1
    Dim v_COMPRESS_SOURCE_SRGB As Integer = Image.COMPRESS_SOURCE_SRGB
    If v_COMPRESS_SOURCE_SRGB = 1 Then pass_count = pass_count + 1
    Dim v_COMPRESS_SOURCE_NORMAL As Integer = Image.COMPRESS_SOURCE_NORMAL
    If v_COMPRESS_SOURCE_NORMAL = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_Image_CompressSource"
    Else
        Print "FAIL:enum_Image_CompressSource count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Image_CompressSource err=" & str(Err.Number)
    End If
End Sub


