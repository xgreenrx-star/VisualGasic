Attribute VB_Name = "fuzz_inst_70"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AudioEffectLimiter = AudioEffectLimiter.new()
    If obj <> Null Then
        Print "PASS:inst_AudioEffectLimiter"
    Else
        Print "FAIL:inst_AudioEffectLimiter returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AudioEffectLimiter err=" & str(Err.Number)
    End If
End Sub


