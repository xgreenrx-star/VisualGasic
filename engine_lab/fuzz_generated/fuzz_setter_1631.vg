Attribute VB_Name = "fuzz_setter_1631"


Sub RunTest0()
    On Error Resume Next
    Dim obj As RigidBody2D = RigidBody2D.new()
    If obj = Null Then
        Print "SKIP:setter_RigidBody2D (null)"
        Exit Sub
    End If
    obj.set_mass(1.0)
    Print "PASS:setter_RigidBody2D_set_mass"
    obj.set_inertia(1.0)
    Print "PASS:setter_RigidBody2D_set_inertia"
    obj.set_gravity_scale(1.0)
    Print "PASS:setter_RigidBody2D_set_gravity_scale"
    obj.set_linear_damp(1.0)
    Print "PASS:setter_RigidBody2D_set_linear_damp"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:setter_RigidBody2D err=" & str(Err.Number)
    End If
End Sub


