End Sub


Sub RunTest5()
    On Error Resume Next
    Dim obj As CPUParticles3D = CPUParticles3D.new()
    If obj = Null Then
        Print "SKIP:setter_CPUParticles3D (null)"
        Exit Sub
    End If
    obj.set_emitting(True)
    Print "PASS:setter_CPUParticles3D_set_emitting"
    obj.set_lifetime(1.0)
    Print "PASS:setter_CPUParticles3D_set_lifetime"
    obj.set_one_shot(True)
    Print "PASS:setter_CPUParticles3D_set_one_shot"
    obj.set_pre_process_time(1.0)
    Print "PASS:setter_CPUParticles3D_set_pre_process_time"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:setter_CPUParticles3D err=" & str(Err.Number)
    End If
End Sub

Sub RunTest()
    RunTest0()
    RunTest1()
    RunTest2()
    RunTest3()
    RunTest4()
    RunTest5()
End Sub
