Sub RunTest3()
    On Error Resume Next
    Dim obj As CharacterBody2D = CharacterBody2D.new()
    If obj = Null Then
        Print "SKIP:setter_CharacterBody2D (null)"
        Exit Sub
    End If
    obj.set_safe_margin(1.0)
    Print "PASS:setter_CharacterBody2D_set_safe_margin"
    obj.set_floor_stop_on_slope_enabled(True)
    Print "PASS:setter_CharacterBody2D_set_floor_stop_on_slope_enabled"
    obj.set_floor_constant_speed_enabled(True)
    Print "PASS:setter_CharacterBody2D_set_floor_constant_speed_enabled"
    obj.set_floor_block_on_wall_enabled(True)
    Print "PASS:setter_CharacterBody2D_set_floor_block_on_wall_enabled"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:setter_CharacterBody2D err=" & str(Err.Number)
    End If
End Sub


Sub RunTest4()
