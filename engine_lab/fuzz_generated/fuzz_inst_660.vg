Attribute VB_Name = "fuzz_inst_660"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeParticleRingEmitter = VisualShaderNodeParticleRingEmitter.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeParticleRingEmitter"
    Else
        Print "FAIL:inst_VisualShaderNodeParticleRingEmitter returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeParticleRingEmitter err=" & str(Err.Number)
    End If
End Sub


