Attribute VB_Name = "fuzz_enum_1498"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FLAG_TRANSPARENT As Integer = SpriteBase3D.FLAG_TRANSPARENT
    If v_FLAG_TRANSPARENT = 0 Then pass_count = pass_count + 1
    Dim v_FLAG_SHADED As Integer = SpriteBase3D.FLAG_SHADED
    If v_FLAG_SHADED = 1 Then pass_count = pass_count + 1
    Dim v_FLAG_DOUBLE_SIDED As Integer = SpriteBase3D.FLAG_DOUBLE_SIDED
    If v_FLAG_DOUBLE_SIDED = 2 Then pass_count = pass_count + 1
    Dim v_FLAG_DISABLE_DEPTH_TEST As Integer = SpriteBase3D.FLAG_DISABLE_DEPTH_TEST
    If v_FLAG_DISABLE_DEPTH_TEST = 3 Then pass_count = pass_count + 1
    Dim v_FLAG_FIXED_SIZE As Integer = SpriteBase3D.FLAG_FIXED_SIZE
    If v_FLAG_FIXED_SIZE = 4 Then pass_count = pass_count + 1
    Dim v_FLAG_MAX As Integer = SpriteBase3D.FLAG_MAX
    If v_FLAG_MAX = 5 Then pass_count = pass_count + 1
    If pass_count = 6 Then
        Print "PASS:enum_SpriteBase3D_DrawFlags"
    Else
        Print "FAIL:enum_SpriteBase3D_DrawFlags count=" & str(pass_count) & "/6"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_SpriteBase3D_DrawFlags err=" & str(Err.Number)
    End If
End Sub


