Attribute VB_Name = "fuzz_inst_280"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ItemList = ItemList.new()
    If obj <> Null Then
        Print "PASS:inst_ItemList"
        obj.free()
    Else
        Print "FAIL:inst_ItemList returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_ItemList err=" & str(Err.Number)
    End If
End Sub


