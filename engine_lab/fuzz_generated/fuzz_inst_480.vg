Attribute VB_Name = "fuzz_inst_480"


Sub RunTest0()
    On Error Resume Next
    Dim obj As SceneReplicationConfig = SceneReplicationConfig.new()
    If obj <> Null Then
        Print "PASS:inst_SceneReplicationConfig"
    Else
        Print "FAIL:inst_SceneReplicationConfig returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_SceneReplicationConfig err=" & str(Err.Number)
    End If
End Sub


