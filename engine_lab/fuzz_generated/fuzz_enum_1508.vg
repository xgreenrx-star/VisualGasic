Attribute VB_Name = "fuzz_enum_1508"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_SHADOW_ATLAS_QUADRANT_SUBDIV_DISABLED As Integer = Viewport.SHADOW_ATLAS_QUADRANT_SUBDIV_DISABLED
    If v_SHADOW_ATLAS_QUADRANT_SUBDIV_DISABLED = 0 Then pass_count = pass_count + 1
    Dim v_SHADOW_ATLAS_QUADRANT_SUBDIV_1 As Integer = Viewport.SHADOW_ATLAS_QUADRANT_SUBDIV_1
    If v_SHADOW_ATLAS_QUADRANT_SUBDIV_1 = 1 Then pass_count = pass_count + 1
    Dim v_SHADOW_ATLAS_QUADRANT_SUBDIV_4 As Integer = Viewport.SHADOW_ATLAS_QUADRANT_SUBDIV_4
    If v_SHADOW_ATLAS_QUADRANT_SUBDIV_4 = 2 Then pass_count = pass_count + 1
    Dim v_SHADOW_ATLAS_QUADRANT_SUBDIV_16 As Integer = Viewport.SHADOW_ATLAS_QUADRANT_SUBDIV_16
    If v_SHADOW_ATLAS_QUADRANT_SUBDIV_16 = 3 Then pass_count = pass_count + 1
    Dim v_SHADOW_ATLAS_QUADRANT_SUBDIV_64 As Integer = Viewport.SHADOW_ATLAS_QUADRANT_SUBDIV_64
    If v_SHADOW_ATLAS_QUADRANT_SUBDIV_64 = 4 Then pass_count = pass_count + 1
    Dim v_SHADOW_ATLAS_QUADRANT_SUBDIV_256 As Integer = Viewport.SHADOW_ATLAS_QUADRANT_SUBDIV_256
    If v_SHADOW_ATLAS_QUADRANT_SUBDIV_256 = 5 Then pass_count = pass_count + 1
    Dim v_SHADOW_ATLAS_QUADRANT_SUBDIV_1024 As Integer = Viewport.SHADOW_ATLAS_QUADRANT_SUBDIV_1024
    If v_SHADOW_ATLAS_QUADRANT_SUBDIV_1024 = 6 Then pass_count = pass_count + 1
    Dim v_SHADOW_ATLAS_QUADRANT_SUBDIV_MAX As Integer = Viewport.SHADOW_ATLAS_QUADRANT_SUBDIV_MAX
    If v_SHADOW_ATLAS_QUADRANT_SUBDIV_MAX = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_Viewport_PositionalShadowAtlasQuadrantSubdiv"
    Else
        Print "FAIL:enum_Viewport_PositionalShadowAtlasQuadrantSubdiv count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_Viewport_PositionalShadowAtlasQuadrantSubdiv err=" & str(Err.Number)
    End If
End Sub


