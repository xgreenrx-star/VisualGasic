Attribute VB_Name = "fuzz_prop_912"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VScrollBar = VScrollBar.new()
    If obj = Null Then
        Print "SKIP:prop_VScrollBar_step (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.step
    Print "PASS:prop_VScrollBar_step"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_VScrollBar_step err=" & str(Err.Number)
    End If
End Sub


