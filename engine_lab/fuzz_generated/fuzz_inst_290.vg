Attribute VB_Name = "fuzz_inst_290"


Sub RunTest0()
    On Error Resume Next
    Dim obj As LabelSettings = LabelSettings.new()
    If obj <> Null Then
        Print "PASS:inst_LabelSettings"
    Else
        Print "FAIL:inst_LabelSettings returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_LabelSettings err=" & str(Err.Number)
    End If
End Sub


