Attribute VB_Name = "fuzz_meth_1593"


Sub RunTest0()
    On Error Resume Next
    Dim obj As HBoxContainer = HBoxContainer.new()
    If obj = Null Then
        Print "SKIP:meth_HBoxContainer (null)"
        Exit Sub
    End If
    Dim r_get_alignment As Variant = obj.get_alignment()
    Print "PASS:meth_HBoxContainer_get_alignment"
    Dim r_is_vertical As Variant = obj.is_vertical()
    Print "PASS:meth_HBoxContainer_is_vertical"
    Dim r_get_combined_minimum_size As Variant = obj.get_combined_minimum_size()
    Print "PASS:meth_HBoxContainer_get_combined_minimum_size"
    Dim r_get_begin As Variant = obj.get_begin()
    Print "PASS:meth_HBoxContainer_get_begin"
    Dim r_get_end As Variant = obj.get_end()
    Print "PASS:meth_HBoxContainer_get_end"
    Dim r_get_position As Variant = obj.get_position()
    Print "PASS:meth_HBoxContainer_get_position"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_HBoxContainer err=" & str(Err.Number)
    End If
End Sub


