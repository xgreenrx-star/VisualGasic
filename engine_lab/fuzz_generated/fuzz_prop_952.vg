Attribute VB_Name = "fuzz_prop_952"


Sub RunTest0()
    On Error Resume Next
    Dim obj As FoldableContainer = FoldableContainer.new()
    If obj = Null Then
        Print "SKIP:prop_FoldableContainer_title_position (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.title_position
    Print "PASS:prop_FoldableContainer_title_position"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_FoldableContainer_title_position err=" & str(Err.Number)
    End If
End Sub


