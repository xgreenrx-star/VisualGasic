Attribute VB_Name = "fuzz_inst_650"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeOuterProduct = VisualShaderNodeOuterProduct.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeOuterProduct"
    Else
        Print "FAIL:inst_VisualShaderNodeOuterProduct returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeOuterProduct err=" & str(Err.Number)
    End If
End Sub


