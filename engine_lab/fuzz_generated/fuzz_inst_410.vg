Attribute VB_Name = "fuzz_inst_410"


Sub RunTest0()
    On Error Resume Next
    Dim obj As PhysicsServer2DManager = PhysicsServer2DManager.new()
    If obj <> Null Then
        Print "PASS:inst_PhysicsServer2DManager"
    Else
        Print "FAIL:inst_PhysicsServer2DManager returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_PhysicsServer2DManager err=" & str(Err.Number)
    End If
End Sub


