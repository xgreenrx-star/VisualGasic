Attribute VB_Name = "fuzz_inst_350"


Sub RunTest0()
    On Error Resume Next
    Dim obj As OggPacketSequence = OggPacketSequence.new()
    If obj <> Null Then
        Print "PASS:inst_OggPacketSequence"
    Else
        Print "FAIL:inst_OggPacketSequence returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_OggPacketSequence err=" & str(Err.Number)
    End If
End Sub


