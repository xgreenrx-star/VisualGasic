Sub RunTest2()
    On Error Resume Next
    Dim obj As ProgressBar = ProgressBar.new()
    If obj <> Null Then
        Print "PASS:inst_ProgressBar"
        obj.free()
    Else
        Print "FAIL:inst_ProgressBar returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_ProgressBar err=" & str(Err.Number)
    End If
End Sub


