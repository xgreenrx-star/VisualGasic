Attribute VB_Name = "fuzz_inst_430"


Sub RunTest0()
    On Error Resume Next
    Dim obj As PrismMesh = PrismMesh.new()
    If obj <> Null Then
        Print "PASS:inst_PrismMesh"
    Else
        Print "FAIL:inst_PrismMesh returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_PrismMesh err=" & str(Err.Number)
    End If
End Sub


