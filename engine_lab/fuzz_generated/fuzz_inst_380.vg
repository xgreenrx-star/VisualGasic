Attribute VB_Name = "fuzz_inst_380"


Sub RunTest0()
    On Error Resume Next
    Dim obj As PackedDataContainer = PackedDataContainer.new()
    If obj <> Null Then
        Print "PASS:inst_PackedDataContainer"
    Else
        Print "FAIL:inst_PackedDataContainer returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_PackedDataContainer err=" & str(Err.Number)
    End If
End Sub


