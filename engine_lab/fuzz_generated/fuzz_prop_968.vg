Attribute VB_Name = "fuzz_prop_968"


Sub RunTest0()
    On Error Resume Next
    Dim obj As MenuBar = MenuBar.new()
    If obj = Null Then
        Print "SKIP:prop_MenuBar_language (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.language
    Print "PASS:prop_MenuBar_language"
    obj.language = "test_string"
    Dim val2 As Variant = obj.language
    Print "PASS:propset_MenuBar_language"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_MenuBar_language err=" & str(Err.Number)
    End If
End Sub


