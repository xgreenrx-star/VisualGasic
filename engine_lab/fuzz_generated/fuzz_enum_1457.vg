Attribute VB_Name = "fuzz_enum_1457"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FLAG_DISABLE_DEPTH_TEST As Integer = BaseMaterial3D.FLAG_DISABLE_DEPTH_TEST
    If v_FLAG_DISABLE_DEPTH_TEST = 0 Then pass_count = pass_count + 1
    Dim v_FLAG_ALBEDO_FROM_VERTEX_COLOR As Integer = BaseMaterial3D.FLAG_ALBEDO_FROM_VERTEX_COLOR
    If v_FLAG_ALBEDO_FROM_VERTEX_COLOR = 1 Then pass_count = pass_count + 1
    Dim v_FLAG_SRGB_VERTEX_COLOR As Integer = BaseMaterial3D.FLAG_SRGB_VERTEX_COLOR
    If v_FLAG_SRGB_VERTEX_COLOR = 2 Then pass_count = pass_count + 1
    Dim v_FLAG_USE_POINT_SIZE As Integer = BaseMaterial3D.FLAG_USE_POINT_SIZE
    If v_FLAG_USE_POINT_SIZE = 3 Then pass_count = pass_count + 1
    Dim v_FLAG_FIXED_SIZE As Integer = BaseMaterial3D.FLAG_FIXED_SIZE
    If v_FLAG_FIXED_SIZE = 4 Then pass_count = pass_count + 1
    Dim v_FLAG_BILLBOARD_KEEP_SCALE As Integer = BaseMaterial3D.FLAG_BILLBOARD_KEEP_SCALE
    If v_FLAG_BILLBOARD_KEEP_SCALE = 5 Then pass_count = pass_count + 1
    Dim v_FLAG_UV1_USE_TRIPLANAR As Integer = BaseMaterial3D.FLAG_UV1_USE_TRIPLANAR
    If v_FLAG_UV1_USE_TRIPLANAR = 6 Then pass_count = pass_count + 1
    Dim v_FLAG_UV2_USE_TRIPLANAR As Integer = BaseMaterial3D.FLAG_UV2_USE_TRIPLANAR
    If v_FLAG_UV2_USE_TRIPLANAR = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_BaseMaterial3D_Flags"
    Else
        Print "FAIL:enum_BaseMaterial3D_Flags count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_BaseMaterial3D_Flags err=" & str(Err.Number)
    End If
End Sub


