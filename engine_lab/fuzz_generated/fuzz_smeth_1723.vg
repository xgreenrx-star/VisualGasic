Attribute VB_Name = "fuzz_smeth_1723"


Sub RunTest0()
    On Error Resume Next
    Dim r_get_frames_per_second As Variant = Engine.get_frames_per_second()
    Print "PASS:smeth_Engine_get_frames_per_second"
    Dim r_get_physics_ticks_per_second As Variant = Engine.get_physics_ticks_per_second()
    Print "PASS:smeth_Engine_get_physics_ticks_per_second"
    Dim r_is_editor_hint As Variant = Engine.is_editor_hint()
    Print "PASS:smeth_Engine_is_editor_hint"
    Dim r_get_physics_interpolation_fraction As Variant = Engine.get_physics_interpolation_fraction()
    Print "PASS:smeth_Engine_get_physics_interpolation_fraction"
    If Err.Number <> 0 Then
        Print "ERROR:smeth_Engine err=" & str(Err.Number)
    End If
End Sub


