Attribute VB_Name = "fuzz_prop_928"


Sub RunTest0()
    On Error Resume Next
    Dim obj As Range = Range.new()
    If obj = Null Then
        Print "SKIP:prop_Range_value (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.value
    Print "PASS:prop_Range_value"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_Range_value err=" & str(Err.Number)
    End If
End Sub


