Attribute VB_Name = "fuzz_inst_120"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CSGMesh3D = CSGMesh3D.new()
    If obj <> Null Then
        Print "PASS:inst_CSGMesh3D"
        obj.free()
    Else
        Print "FAIL:inst_CSGMesh3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_CSGMesh3D err=" & str(Err.Number)
    End If
End Sub


