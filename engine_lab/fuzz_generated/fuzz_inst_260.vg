Attribute VB_Name = "fuzz_inst_260"


Sub RunTest0()
    On Error Resume Next
    Dim obj As HingeJoint3D = HingeJoint3D.new()
    If obj <> Null Then
        Print "PASS:inst_HingeJoint3D"
        obj.free()
    Else
        Print "FAIL:inst_HingeJoint3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_HingeJoint3D err=" & str(Err.Number)
    End If
End Sub


