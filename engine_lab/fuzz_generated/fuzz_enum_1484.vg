Attribute VB_Name = "fuzz_enum_1484"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_PATH_METADATA_INCLUDE_NONE As Integer = NavigationPathQueryParameters2D.PATH_METADATA_INCLUDE_NONE
    If v_PATH_METADATA_INCLUDE_NONE = 0 Then pass_count = pass_count + 1
    Dim v_PATH_METADATA_INCLUDE_TYPES As Integer = NavigationPathQueryParameters2D.PATH_METADATA_INCLUDE_TYPES
    If v_PATH_METADATA_INCLUDE_TYPES = 1 Then pass_count = pass_count + 1
    Dim v_PATH_METADATA_INCLUDE_RIDS As Integer = NavigationPathQueryParameters2D.PATH_METADATA_INCLUDE_RIDS
    If v_PATH_METADATA_INCLUDE_RIDS = 2 Then pass_count = pass_count + 1
    Dim v_PATH_METADATA_INCLUDE_OWNERS As Integer = NavigationPathQueryParameters2D.PATH_METADATA_INCLUDE_OWNERS
    If v_PATH_METADATA_INCLUDE_OWNERS = 4 Then pass_count = pass_count + 1
    Dim v_PATH_METADATA_INCLUDE_ALL As Integer = NavigationPathQueryParameters2D.PATH_METADATA_INCLUDE_ALL
    If v_PATH_METADATA_INCLUDE_ALL = 7 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_NavigationPathQueryParameters2D_PathMetadataFlags"
    Else
        Print "FAIL:enum_NavigationPathQueryParameters2D_PathMetadataFlags count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_NavigationPathQueryParameters2D_PathMetadataFlags err=" & str(Err.Number)
    End If
End Sub


