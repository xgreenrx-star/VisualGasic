Attribute VB_Name = "fuzz_enum_1451"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_ANIMATION_PROCESS_PHYSICS As Integer = AnimationTree.ANIMATION_PROCESS_PHYSICS
    If v_ANIMATION_PROCESS_PHYSICS = 0 Then pass_count = pass_count + 1
    Dim v_ANIMATION_PROCESS_IDLE As Integer = AnimationTree.ANIMATION_PROCESS_IDLE
    If v_ANIMATION_PROCESS_IDLE = 1 Then pass_count = pass_count + 1
    Dim v_ANIMATION_PROCESS_MANUAL As Integer = AnimationTree.ANIMATION_PROCESS_MANUAL
    If v_ANIMATION_PROCESS_MANUAL = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_AnimationTree_AnimationProcessCallback"
    Else
        Print "FAIL:enum_AnimationTree_AnimationProcessCallback count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_AnimationTree_AnimationProcessCallback err=" & str(Err.Number)
    End If
End Sub


