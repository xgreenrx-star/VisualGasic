Attribute VB_Name = "fuzz_inst_270"


Sub RunTest0()
    On Error Resume Next
    Dim obj As InputEventJoypadMotion = InputEventJoypadMotion.new()
    If obj <> Null Then
        Print "PASS:inst_InputEventJoypadMotion"
    Else
        Print "FAIL:inst_InputEventJoypadMotion returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_InputEventJoypadMotion err=" & str(Err.Number)
    End If
End Sub


