Attribute VB_Name = "fuzz_inst_730"


Sub RunTest0()
    On Error Resume Next
    Dim obj As XRBodyTracker = XRBodyTracker.new()
    If obj <> Null Then
        Print "PASS:inst_XRBodyTracker"
    Else
        Print "FAIL:inst_XRBodyTracker returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_XRBodyTracker err=" & str(Err.Number)
    End If
End Sub


