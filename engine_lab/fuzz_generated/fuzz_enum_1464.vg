Attribute VB_Name = "fuzz_enum_1464"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_SHAPE_HSV_RECTANGLE As Integer = ColorPicker.SHAPE_HSV_RECTANGLE
    If v_SHAPE_HSV_RECTANGLE = 0 Then pass_count = pass_count + 1
    Dim v_SHAPE_HSV_WHEEL As Integer = ColorPicker.SHAPE_HSV_WHEEL
    If v_SHAPE_HSV_WHEEL = 1 Then pass_count = pass_count + 1
    Dim v_SHAPE_VHS_CIRCLE As Integer = ColorPicker.SHAPE_VHS_CIRCLE
    If v_SHAPE_VHS_CIRCLE = 2 Then pass_count = pass_count + 1
    Dim v_SHAPE_OKHSL_CIRCLE As Integer = ColorPicker.SHAPE_OKHSL_CIRCLE
    If v_SHAPE_OKHSL_CIRCLE = 3 Then pass_count = pass_count + 1
    Dim v_SHAPE_NONE As Integer = ColorPicker.SHAPE_NONE
    If v_SHAPE_NONE = 4 Then pass_count = pass_count + 1
    Dim v_SHAPE_OK_HS_RECTANGLE As Integer = ColorPicker.SHAPE_OK_HS_RECTANGLE
    If v_SHAPE_OK_HS_RECTANGLE = 5 Then pass_count = pass_count + 1
    Dim v_SHAPE_OK_HL_RECTANGLE As Integer = ColorPicker.SHAPE_OK_HL_RECTANGLE
    If v_SHAPE_OK_HL_RECTANGLE = 6 Then pass_count = pass_count + 1
    If pass_count = 7 Then
        Print "PASS:enum_ColorPicker_PickerShapeType"
    Else
        Print "FAIL:enum_ColorPicker_PickerShapeType count=" & str(pass_count) & "/7"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_ColorPicker_PickerShapeType err=" & str(Err.Number)
    End If
End Sub


