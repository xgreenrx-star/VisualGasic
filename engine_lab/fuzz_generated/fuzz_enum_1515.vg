Attribute VB_Name = "fuzz_enum_1515"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_MODE_LINEAR As Integer = VisualShaderNodeParticleAccelerator.MODE_LINEAR
    If v_MODE_LINEAR = 0 Then pass_count = pass_count + 1
    Dim v_MODE_RADIAL As Integer = VisualShaderNodeParticleAccelerator.MODE_RADIAL
    If v_MODE_RADIAL = 1 Then pass_count = pass_count + 1
    Dim v_MODE_TANGENTIAL As Integer = VisualShaderNodeParticleAccelerator.MODE_TANGENTIAL
    If v_MODE_TANGENTIAL = 2 Then pass_count = pass_count + 1
    Dim v_MODE_MAX As Integer = VisualShaderNodeParticleAccelerator.MODE_MAX
    If v_MODE_MAX = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_VisualShaderNodeParticleAccelerator_Mode"
    Else
        Print "FAIL:enum_VisualShaderNodeParticleAccelerator_Mode count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_VisualShaderNodeParticleAccelerator_Mode err=" & str(Err.Number)
    End If
End Sub


