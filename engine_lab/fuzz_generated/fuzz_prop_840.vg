Attribute VB_Name = "fuzz_prop_840"


Sub RunTest0()
    On Error Resume Next
    Dim obj As TextureButton = TextureButton.new()
    If obj = Null Then
        Print "SKIP:prop_TextureButton_texture_pressed (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.texture_pressed
    Print "PASS:prop_TextureButton_texture_pressed"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_TextureButton_texture_pressed err=" & str(Err.Number)
    End If
End Sub


