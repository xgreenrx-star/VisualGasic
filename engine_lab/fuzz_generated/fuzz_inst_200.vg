Attribute VB_Name = "fuzz_inst_200"


Sub RunTest0()
    On Error Resume Next
    Dim obj As FlowContainer = FlowContainer.new()
    If obj <> Null Then
        Print "PASS:inst_FlowContainer"
        obj.free()
    Else
        Print "FAIL:inst_FlowContainer returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_FlowContainer err=" & str(Err.Number)
    End If
End Sub


