Attribute VB_Name = "fuzz_inst_736"


Sub RunTest0()
    On Error Resume Next
    Dim obj As XROrigin3D = XROrigin3D.new()
    If obj <> Null Then
        Print "PASS:inst_XROrigin3D"
        obj.free()
    Else
        Print "FAIL:inst_XROrigin3D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_XROrigin3D err=" & str(Err.Number)
    End If
End Sub


