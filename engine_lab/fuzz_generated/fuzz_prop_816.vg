Attribute VB_Name = "fuzz_prop_816"


Sub RunTest0()
    On Error Resume Next
    Dim obj As Button = Button.new()
    If obj = Null Then
        Print "SKIP:prop_Button_flat (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.flat
    Print "PASS:prop_Button_flat"
    obj.flat = True
    Dim val2 As Variant = obj.flat
    Print "PASS:propset_Button_flat"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_Button_flat err=" & str(Err.Number)
    End If
End Sub


