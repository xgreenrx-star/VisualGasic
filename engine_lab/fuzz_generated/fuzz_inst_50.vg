Attribute VB_Name = "fuzz_inst_50"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AtlasTexture = AtlasTexture.new()
    If obj <> Null Then
        Print "PASS:inst_AtlasTexture"
    Else
        Print "FAIL:inst_AtlasTexture returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AtlasTexture err=" & str(Err.Number)
    End If
End Sub


