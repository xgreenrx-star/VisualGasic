Attribute VB_Name = "fuzz_enum_1488"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_HAND_LEFT As Integer = OpenXRInterface.HAND_LEFT
    If v_HAND_LEFT = 0 Then pass_count = pass_count + 1
    Dim v_HAND_RIGHT As Integer = OpenXRInterface.HAND_RIGHT
    If v_HAND_RIGHT = 1 Then pass_count = pass_count + 1
    Dim v_HAND_MAX As Integer = OpenXRInterface.HAND_MAX
    If v_HAND_MAX = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_OpenXRInterface_Hand"
    Else
        Print "FAIL:enum_OpenXRInterface_Hand count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_OpenXRInterface_Hand err=" & str(Err.Number)
    End If
End Sub


