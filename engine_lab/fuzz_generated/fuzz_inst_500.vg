Attribute VB_Name = "fuzz_inst_500"


Sub RunTest0()
    On Error Resume Next
    Dim obj As SkeletonModification2DCCDIK = SkeletonModification2DCCDIK.new()
    If obj <> Null Then
        Print "PASS:inst_SkeletonModification2DCCDIK"
    Else
        Print "FAIL:inst_SkeletonModification2DCCDIK returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_SkeletonModification2DCCDIK err=" & str(Err.Number)
    End If
End Sub


