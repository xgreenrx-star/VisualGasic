Attribute VB_Name = "fuzz_enum_1483"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_VISIBILITY_PROCESS_IDLE As Integer = MultiplayerSynchronizer.VISIBILITY_PROCESS_IDLE
    If v_VISIBILITY_PROCESS_IDLE = 0 Then pass_count = pass_count + 1
    Dim v_VISIBILITY_PROCESS_PHYSICS As Integer = MultiplayerSynchronizer.VISIBILITY_PROCESS_PHYSICS
    If v_VISIBILITY_PROCESS_PHYSICS = 1 Then pass_count = pass_count + 1
    Dim v_VISIBILITY_PROCESS_NONE As Integer = MultiplayerSynchronizer.VISIBILITY_PROCESS_NONE
    If v_VISIBILITY_PROCESS_NONE = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_MultiplayerSynchronizer_VisibilityUpdateMode"
    Else
        Print "FAIL:enum_MultiplayerSynchronizer_VisibilityUpdateMode count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_MultiplayerSynchronizer_VisibilityUpdateMode err=" & str(Err.Number)
    End If
End Sub


