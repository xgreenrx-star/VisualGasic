Attribute VB_Name = "fuzz_meth_1581"


Sub RunTest0()
    On Error Resume Next
    Dim obj As MenuBar = MenuBar.new()
    If obj = Null Then
        Print "SKIP:meth_MenuBar (null)"
        Exit Sub
    End If
    Dim r_is_switch_on_hover As Variant = obj.is_switch_on_hover()
    Print "PASS:meth_MenuBar_is_switch_on_hover"
    Dim r_is_prefer_global_menu As Variant = obj.is_prefer_global_menu()
    Print "PASS:meth_MenuBar_is_prefer_global_menu"
    Dim r_is_native_menu As Variant = obj.is_native_menu()
    Print "PASS:meth_MenuBar_is_native_menu"
    Dim r_get_menu_count As Variant = obj.get_menu_count()
    Print "PASS:meth_MenuBar_get_menu_count"
    Dim r_get_text_direction As Variant = obj.get_text_direction()
    Print "PASS:meth_MenuBar_get_text_direction"
    Dim r_get_language As Variant = obj.get_language()
    Print "PASS:meth_MenuBar_get_language"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_MenuBar err=" & str(Err.Number)
    End If
End Sub


