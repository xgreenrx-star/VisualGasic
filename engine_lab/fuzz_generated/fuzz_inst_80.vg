Attribute VB_Name = "fuzz_inst_80"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AudioEffectStereoEnhance = AudioEffectStereoEnhance.new()
    If obj <> Null Then
        Print "PASS:inst_AudioEffectStereoEnhance"
    Else
        Print "FAIL:inst_AudioEffectStereoEnhance returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AudioEffectStereoEnhance err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
    On Error Resume Next
    Dim obj As AudioListener2D = AudioListener2D.new()
    If obj <> Null Then
        Print "PASS:inst_AudioListener2D"
        obj.free()
    Else
        Print "FAIL:inst_AudioListener2D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_AudioListener2D err=" & str(Err.Number)
    End If
End Sub


