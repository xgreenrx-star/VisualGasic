Attribute VB_Name = "fuzz_inst_470"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ResourceFormatSaver = ResourceFormatSaver.new()
    If obj <> Null Then
        Print "PASS:inst_ResourceFormatSaver"
    Else
        Print "FAIL:inst_ResourceFormatSaver returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_ResourceFormatSaver err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
    On Error Resume Next
    Dim obj As ResourcePreloader = ResourcePreloader.new()
    If obj <> Null Then
        Print "PASS:inst_ResourcePreloader"
        obj.free()
    Else
        Print "FAIL:inst_ResourcePreloader returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_ResourcePreloader err=" & str(Err.Number)
    End If
End Sub


