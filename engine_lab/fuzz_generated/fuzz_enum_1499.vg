Attribute VB_Name = "fuzz_enum_1499"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_UPDATE_DISABLED As Integer = SubViewport.UPDATE_DISABLED
    If v_UPDATE_DISABLED = 0 Then pass_count = pass_count + 1
    Dim v_UPDATE_ONCE As Integer = SubViewport.UPDATE_ONCE
    If v_UPDATE_ONCE = 1 Then pass_count = pass_count + 1
    Dim v_UPDATE_WHEN_VISIBLE As Integer = SubViewport.UPDATE_WHEN_VISIBLE
    If v_UPDATE_WHEN_VISIBLE = 2 Then pass_count = pass_count + 1
    Dim v_UPDATE_WHEN_PARENT_VISIBLE As Integer = SubViewport.UPDATE_WHEN_PARENT_VISIBLE
    If v_UPDATE_WHEN_PARENT_VISIBLE = 3 Then pass_count = pass_count + 1
    Dim v_UPDATE_ALWAYS As Integer = SubViewport.UPDATE_ALWAYS
    If v_UPDATE_ALWAYS = 4 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_SubViewport_UpdateMode"
    Else
        Print "FAIL:enum_SubViewport_UpdateMode count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_SubViewport_UpdateMode err=" & str(Err.Number)
    End If
End Sub


