Attribute VB_Name = "fuzz_prop_744"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CodeEdit = CodeEdit.new()
    If obj = Null Then
        Print "SKIP:prop_CodeEdit_symbol_lookup_on_click (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.symbol_lookup_on_click
    Print "PASS:prop_CodeEdit_symbol_lookup_on_click"
    obj.symbol_lookup_on_click = True
    Dim val2 As Variant = obj.symbol_lookup_on_click
    Print "PASS:propset_CodeEdit_symbol_lookup_on_click"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_CodeEdit_symbol_lookup_on_click err=" & str(Err.Number)
    End If
End Sub


