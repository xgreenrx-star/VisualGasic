Attribute VB_Name = "fuzz_enum_1490"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_PARTICLE_FLAG_ALIGN_Y_TO_VELOCITY As Integer = ParticleProcessMaterial.PARTICLE_FLAG_ALIGN_Y_TO_VELOCITY
    If v_PARTICLE_FLAG_ALIGN_Y_TO_VELOCITY = 0 Then pass_count = pass_count + 1
    Dim v_PARTICLE_FLAG_ROTATE_Y As Integer = ParticleProcessMaterial.PARTICLE_FLAG_ROTATE_Y
    If v_PARTICLE_FLAG_ROTATE_Y = 1 Then pass_count = pass_count + 1
    Dim v_PARTICLE_FLAG_DISABLE_Z As Integer = ParticleProcessMaterial.PARTICLE_FLAG_DISABLE_Z
    If v_PARTICLE_FLAG_DISABLE_Z = 2 Then pass_count = pass_count + 1
    Dim v_PARTICLE_FLAG_DAMPING_AS_FRICTION As Integer = ParticleProcessMaterial.PARTICLE_FLAG_DAMPING_AS_FRICTION
    If v_PARTICLE_FLAG_DAMPING_AS_FRICTION = 3 Then pass_count = pass_count + 1
    Dim v_PARTICLE_FLAG_MAX As Integer = ParticleProcessMaterial.PARTICLE_FLAG_MAX
    If v_PARTICLE_FLAG_MAX = 4 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_ParticleProcessMaterial_ParticleFlags"
    Else
        Print "FAIL:enum_ParticleProcessMaterial_ParticleFlags count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_ParticleProcessMaterial_ParticleFlags err=" & str(Err.Number)
    End If
End Sub


