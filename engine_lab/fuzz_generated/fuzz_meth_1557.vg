Attribute VB_Name = "fuzz_meth_1557"


Sub RunTest0()
    On Error Resume Next
    Dim obj As TextureButton = TextureButton.new()
    If obj = Null Then
        Print "SKIP:meth_TextureButton (null)"
        Exit Sub
    End If
    Dim r_is_flipped_h As Variant = obj.is_flipped_h()
    Print "PASS:meth_TextureButton_is_flipped_h"
    Dim r_is_flipped_v As Variant = obj.is_flipped_v()
    Print "PASS:meth_TextureButton_is_flipped_v"
    Dim r_get_texture_normal As Variant = obj.get_texture_normal()
    Print "PASS:meth_TextureButton_get_texture_normal"
    Dim r_get_texture_pressed As Variant = obj.get_texture_pressed()
    Print "PASS:meth_TextureButton_get_texture_pressed"
    Dim r_get_texture_hover As Variant = obj.get_texture_hover()
    Print "PASS:meth_TextureButton_get_texture_hover"
    Dim r_get_texture_disabled As Variant = obj.get_texture_disabled()
    Print "PASS:meth_TextureButton_get_texture_disabled"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_TextureButton err=" & str(Err.Number)
    End If
End Sub


