Attribute VB_Name = "fuzz_enum_1495"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_SCRIPT_NAME_CASING_AUTO As Integer = ScriptLanguage.SCRIPT_NAME_CASING_AUTO
    If v_SCRIPT_NAME_CASING_AUTO = 0 Then pass_count = pass_count + 1
    Dim v_SCRIPT_NAME_CASING_PASCAL_CASE As Integer = ScriptLanguage.SCRIPT_NAME_CASING_PASCAL_CASE
    If v_SCRIPT_NAME_CASING_PASCAL_CASE = 1 Then pass_count = pass_count + 1
    Dim v_SCRIPT_NAME_CASING_SNAKE_CASE As Integer = ScriptLanguage.SCRIPT_NAME_CASING_SNAKE_CASE
    If v_SCRIPT_NAME_CASING_SNAKE_CASE = 2 Then pass_count = pass_count + 1
    Dim v_SCRIPT_NAME_CASING_KEBAB_CASE As Integer = ScriptLanguage.SCRIPT_NAME_CASING_KEBAB_CASE
    If v_SCRIPT_NAME_CASING_KEBAB_CASE = 3 Then pass_count = pass_count + 1
    Dim v_SCRIPT_NAME_CASING_CAMEL_CASE As Integer = ScriptLanguage.SCRIPT_NAME_CASING_CAMEL_CASE
    If v_SCRIPT_NAME_CASING_CAMEL_CASE = 4 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_ScriptLanguage_ScriptNameCasing"
    Else
        Print "FAIL:enum_ScriptLanguage_ScriptNameCasing count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_ScriptLanguage_ScriptNameCasing err=" & str(Err.Number)
    End If
End Sub


