Attribute VB_Name = "fuzz_inst_700"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeVec3Constant = VisualShaderNodeVec3Constant.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeVec3Constant"
    Else
        Print "FAIL:inst_VisualShaderNodeVec3Constant returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeVec3Constant err=" & str(Err.Number)
    End If
End Sub


