Attribute VB_Name = "fuzz_inst_670"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeScreenUVToSDF = VisualShaderNodeScreenUVToSDF.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeScreenUVToSDF"
    Else
        Print "FAIL:inst_VisualShaderNodeScreenUVToSDF returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeScreenUVToSDF err=" & str(Err.Number)
    End If
End Sub


