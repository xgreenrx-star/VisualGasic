Attribute VB_Name = "fuzz_meth_1563"


Sub RunTest0()
    On Error Resume Next
    Dim obj As TabBar = TabBar.new()
    If obj = Null Then
        Print "SKIP:meth_TabBar (null)"
        Exit Sub
    End If
    Dim r_get_tab_count As Variant = obj.get_tab_count()
    Print "PASS:meth_TabBar_get_tab_count"
    Dim r_get_current_tab As Variant = obj.get_current_tab()
    Print "PASS:meth_TabBar_get_current_tab"
    Dim r_get_previous_tab As Variant = obj.get_previous_tab()
    Print "PASS:meth_TabBar_get_previous_tab"
    Dim r_select_previous_available As Variant = obj.select_previous_available()
    Print "PASS:meth_TabBar_select_previous_available"
    Dim r_select_next_available As Variant = obj.select_next_available()
    Print "PASS:meth_TabBar_select_next_available"
    Dim r_get_tab_alignment As Variant = obj.get_tab_alignment()
    Print "PASS:meth_TabBar_get_tab_alignment"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:meth_TabBar err=" & str(Err.Number)
    End If
End Sub


