Attribute VB_Name = "fuzz_enum_1456"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_FEATURE_EMISSION As Integer = BaseMaterial3D.FEATURE_EMISSION
    If v_FEATURE_EMISSION = 0 Then pass_count = pass_count + 1
    Dim v_FEATURE_NORMAL_MAPPING As Integer = BaseMaterial3D.FEATURE_NORMAL_MAPPING
    If v_FEATURE_NORMAL_MAPPING = 1 Then pass_count = pass_count + 1
    Dim v_FEATURE_RIM As Integer = BaseMaterial3D.FEATURE_RIM
    If v_FEATURE_RIM = 2 Then pass_count = pass_count + 1
    Dim v_FEATURE_CLEARCOAT As Integer = BaseMaterial3D.FEATURE_CLEARCOAT
    If v_FEATURE_CLEARCOAT = 3 Then pass_count = pass_count + 1
    Dim v_FEATURE_ANISOTROPY As Integer = BaseMaterial3D.FEATURE_ANISOTROPY
    If v_FEATURE_ANISOTROPY = 4 Then pass_count = pass_count + 1
    Dim v_FEATURE_AMBIENT_OCCLUSION As Integer = BaseMaterial3D.FEATURE_AMBIENT_OCCLUSION
    If v_FEATURE_AMBIENT_OCCLUSION = 5 Then pass_count = pass_count + 1
    Dim v_FEATURE_HEIGHT_MAPPING As Integer = BaseMaterial3D.FEATURE_HEIGHT_MAPPING
    If v_FEATURE_HEIGHT_MAPPING = 6 Then pass_count = pass_count + 1
    Dim v_FEATURE_SUBSURFACE_SCATTERING As Integer = BaseMaterial3D.FEATURE_SUBSURFACE_SCATTERING
    If v_FEATURE_SUBSURFACE_SCATTERING = 7 Then pass_count = pass_count + 1
    If pass_count = 8 Then
        Print "PASS:enum_BaseMaterial3D_Feature"
    Else
        Print "FAIL:enum_BaseMaterial3D_Feature count=" & str(pass_count) & "/8"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_BaseMaterial3D_Feature err=" & str(Err.Number)
    End If
End Sub


