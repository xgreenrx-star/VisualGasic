    Dim v_BREAK_ADAPTIVE As Integer = TextServer.BREAK_ADAPTIVE
    If v_BREAK_ADAPTIVE = 8 Then pass_count = pass_count + 1
    Dim v_BREAK_TRIM_EDGE_SPACES As Integer = TextServer.BREAK_TRIM_EDGE_SPACES
    If v_BREAK_TRIM_EDGE_SPACES = 16 Then pass_count = pass_count + 1
    Dim v_BREAK_TRIM_INDENT As Integer = TextServer.BREAK_TRIM_INDENT
