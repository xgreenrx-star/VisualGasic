Attribute VB_Name = "fuzz_enum_1502"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_AUTOWRAP_OFF As Integer = TextServer.AUTOWRAP_OFF
    If v_AUTOWRAP_OFF = 0 Then pass_count = pass_count + 1
    Dim v_AUTOWRAP_ARBITRARY As Integer = TextServer.AUTOWRAP_ARBITRARY
    If v_AUTOWRAP_ARBITRARY = 1 Then pass_count = pass_count + 1
    Dim v_AUTOWRAP_WORD As Integer = TextServer.AUTOWRAP_WORD
    If v_AUTOWRAP_WORD = 2 Then pass_count = pass_count + 1
    Dim v_AUTOWRAP_WORD_SMART As Integer = TextServer.AUTOWRAP_WORD_SMART
    If v_AUTOWRAP_WORD_SMART = 3 Then pass_count = pass_count + 1
    If pass_count = 4 Then
        Print "PASS:enum_TextServer_AutowrapMode"
    Else
        Print "FAIL:enum_TextServer_AutowrapMode count=" & str(pass_count) & "/4"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_TextServer_AutowrapMode err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
    On Error Resume Next
