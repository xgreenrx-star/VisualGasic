Attribute VB_Name = "fuzz_inst_440"


Sub RunTest0()
    On Error Resume Next
    Dim obj As RDPipelineMultisampleState = RDPipelineMultisampleState.new()
    If obj <> Null Then
        Print "PASS:inst_RDPipelineMultisampleState"
    Else
        Print "FAIL:inst_RDPipelineMultisampleState returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_RDPipelineMultisampleState err=" & str(Err.Number)
    End If
End Sub


