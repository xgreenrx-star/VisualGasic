Attribute VB_Name = "fuzz_inst_130"


Sub RunTest0()
    On Error Resume Next
    Dim obj As CameraTexture = CameraTexture.new()
    If obj <> Null Then
        Print "PASS:inst_CameraTexture"
    Else
        Print "FAIL:inst_CameraTexture returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_CameraTexture err=" & str(Err.Number)
    End If
End Sub


