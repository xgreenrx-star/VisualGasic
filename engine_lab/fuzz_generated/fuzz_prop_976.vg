Attribute VB_Name = "fuzz_prop_976"


Sub RunTest0()
    On Error Resume Next
    Dim obj As AspectRatioContainer = AspectRatioContainer.new()
    If obj = Null Then
        Print "SKIP:prop_AspectRatioContainer_alignment_horizontal (null)"
        Exit Sub
    End If
    Dim val As Variant = obj.alignment_horizontal
    Print "PASS:prop_AspectRatioContainer_alignment_horizontal"

    obj.free()
    If Err.Number <> 0 Then
        Print "ERROR:prop_AspectRatioContainer_alignment_horizontal err=" & str(Err.Number)
    End If
End Sub


