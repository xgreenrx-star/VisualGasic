Attribute VB_Name = "fuzz_inst_250"


Sub RunTest0()
    On Error Resume Next
    Dim obj As HFlowContainer = HFlowContainer.new()
    If obj <> Null Then
        Print "PASS:inst_HFlowContainer"
        obj.free()
    Else
        Print "FAIL:inst_HFlowContainer returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_HFlowContainer err=" & str(Err.Number)
    End If
End Sub


