Attribute VB_Name = "fuzz_enum_1486"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_OPENXR_ALPHA_BLEND_MODE_SUPPORT_NONE As Integer = OpenXRAPIExtension.OPENXR_ALPHA_BLEND_MODE_SUPPORT_NONE
    If v_OPENXR_ALPHA_BLEND_MODE_SUPPORT_NONE = 0 Then pass_count = pass_count + 1
    Dim v_OPENXR_ALPHA_BLEND_MODE_SUPPORT_REAL As Integer = OpenXRAPIExtension.OPENXR_ALPHA_BLEND_MODE_SUPPORT_REAL
    If v_OPENXR_ALPHA_BLEND_MODE_SUPPORT_REAL = 1 Then pass_count = pass_count + 1
    Dim v_OPENXR_ALPHA_BLEND_MODE_SUPPORT_EMULATING As Integer = OpenXRAPIExtension.OPENXR_ALPHA_BLEND_MODE_SUPPORT_EMULATING
    If v_OPENXR_ALPHA_BLEND_MODE_SUPPORT_EMULATING = 2 Then pass_count = pass_count + 1
    If pass_count = 3 Then
        Print "PASS:enum_OpenXRAPIExtension_OpenXRAlphaBlendModeSupport"
    Else
        Print "FAIL:enum_OpenXRAPIExtension_OpenXRAlphaBlendModeSupport count=" & str(pass_count) & "/3"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_OpenXRAPIExtension_OpenXRAlphaBlendModeSupport err=" & str(Err.Number)
    End If
End Sub


