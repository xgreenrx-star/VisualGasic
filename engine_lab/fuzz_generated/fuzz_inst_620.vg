Attribute VB_Name = "fuzz_inst_620"


Sub RunTest0()
    On Error Resume Next
    Dim obj As VisualShaderNodeComment = VisualShaderNodeComment.new()
    If obj <> Null Then
        Print "PASS:inst_VisualShaderNodeComment"
    Else
        Print "FAIL:inst_VisualShaderNodeComment returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_VisualShaderNodeComment err=" & str(Err.Number)
    End If
End Sub


