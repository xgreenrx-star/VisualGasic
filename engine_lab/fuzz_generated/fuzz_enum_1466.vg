Attribute VB_Name = "fuzz_enum_1466"


Sub RunTest0()
    On Error Resume Next
    Dim pass_count As Integer = 0
    Dim v_EVENT_ERROR As Integer = ENetConnection.EVENT_ERROR
    If v_EVENT_ERROR = -1 Then pass_count = pass_count + 1
    Dim v_EVENT_NONE As Integer = ENetConnection.EVENT_NONE
    If v_EVENT_NONE = 0 Then pass_count = pass_count + 1
    Dim v_EVENT_CONNECT As Integer = ENetConnection.EVENT_CONNECT
    If v_EVENT_CONNECT = 1 Then pass_count = pass_count + 1
    Dim v_EVENT_DISCONNECT As Integer = ENetConnection.EVENT_DISCONNECT
    If v_EVENT_DISCONNECT = 2 Then pass_count = pass_count + 1
    Dim v_EVENT_RECEIVE As Integer = ENetConnection.EVENT_RECEIVE
    If v_EVENT_RECEIVE = 3 Then pass_count = pass_count + 1
    If pass_count = 5 Then
        Print "PASS:enum_ENetConnection_EventType"
    Else
        Print "FAIL:enum_ENetConnection_EventType count=" & str(pass_count) & "/5"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:enum_ENetConnection_EventType err=" & str(Err.Number)
    End If
End Sub


