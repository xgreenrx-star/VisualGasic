Attribute VB_Name = "fuzz_inst_340"


Sub RunTest0()
    On Error Resume Next
    Dim obj As NavigationPolygon = NavigationPolygon.new()
    If obj <> Null Then
        Print "PASS:inst_NavigationPolygon"
    Else
        Print "FAIL:inst_NavigationPolygon returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_NavigationPolygon err=" & str(Err.Number)
    End If
End Sub


Sub RunTest1()
    On Error Resume Next
    Dim obj As NavigationRegion2D = NavigationRegion2D.new()
    If obj <> Null Then
        Print "PASS:inst_NavigationRegion2D"
        obj.free()
    Else
        Print "FAIL:inst_NavigationRegion2D returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_NavigationRegion2D err=" & str(Err.Number)
    End If
End Sub


