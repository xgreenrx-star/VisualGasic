Attribute VB_Name = "fuzz_inst_190"


Sub RunTest0()
    On Error Resume Next
    Dim obj As ENetMultiplayerPeer = ENetMultiplayerPeer.new()
    If obj <> Null Then
        Print "PASS:inst_ENetMultiplayerPeer"
    Else
        Print "FAIL:inst_ENetMultiplayerPeer returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_ENetMultiplayerPeer err=" & str(Err.Number)
    End If
End Sub


