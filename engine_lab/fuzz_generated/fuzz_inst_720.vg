Attribute VB_Name = "fuzz_inst_720"


Sub RunTest0()
    On Error Resume Next
    Dim obj As WebSocketPeer = WebSocketPeer.new()
    If obj <> Null Then
        Print "PASS:inst_WebSocketPeer"
    Else
        Print "FAIL:inst_WebSocketPeer returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_WebSocketPeer err=" & str(Err.Number)
    End If
End Sub


