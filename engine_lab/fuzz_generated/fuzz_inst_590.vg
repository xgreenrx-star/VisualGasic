Attribute VB_Name = "fuzz_inst_590"


Sub RunTest0()
    On Error Resume Next
    Dim obj As UPNPDevice = UPNPDevice.new()
    If obj <> Null Then
        Print "PASS:inst_UPNPDevice"
    Else
        Print "FAIL:inst_UPNPDevice returned null"
    End If
    If Err.Number <> 0 Then
        Print "ERROR:inst_UPNPDevice err=" & str(Err.Number)
    End If
End Sub


