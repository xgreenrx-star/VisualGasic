    // Step 1: Lock and pin the Godot data array pointer to prevent the engine from moving it
    uint8_t* raw_pointer = godot_buffer.ptrw();
    int64_t buffer_size = godot_buffer.size();

    // Step 2: Create a light wrapper view pointing directly to Godot's memory address
    // PyBUF_WRITE allows Python libraries (like NumPy) to modify this array directly in-place
    PyObject* py_memory_view = PyMemoryView_FromMemory(
        reinterpret_cast<char*>(raw_pointer), 
        buffer_size, 
        PyBUF_WRITE
    );

    if (!py_memory_view) {
        return Variant(false); // Failed to establish memory link
    }

    // Step 3: Pass the raw buffer view straight into your target Python script/library
    PyObject* py_args = PyTuple_Pack(1, py_memory_view);
    PyObject* py_result = PyObject_CallObject(python_function, py_args);

    // Step 4: Cleanup handles. The underlying Godot array memory remains completely safe.
    Py_DECREF(py_args);
    Py_DECREF(py_memory_view);
    if (py_result) Py_DECREF(py_result);

    return Variant(true);
}
