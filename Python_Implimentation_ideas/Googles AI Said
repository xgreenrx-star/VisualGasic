Part 2: High-Compatibility Path (The Object Wrap Framework)To call Python methods using VisualGasic's object syntax, your agent needs to build a dynamic C++ wrapper. This wrapper maps Godot’s Variant class to Python’s native PyObject* system.The C++ Handler StrategyYour agent must create a custom class inherited from Godot's base types (like RefCounted or a custom VisualGasic Variant handler). This class manages the life cycle of a underlying Python object.Reference Counting: The C++ destructor must call Py_DECREF() to prevent massive memory leaks.Argument Marshaling: Before a method call execution, Godot arrays or individual arguments must be unboxed, converted via PyLong_FromLong or PyUnicode_FromString, and packed into a PyTuple.Core Implementation TemplateProvide this exact template to your agent so it knows how to handle the initialization and function routing:cpp#include <godot_cpp/core/class_db.hpp>
#include <godot_cpp/variant/variant.hpp>
#include <Python.h>

using namespace godot;

class PyObjectWrapper : public RefCounted {
    GDCLASS(PyObjectWrapper, RefCounted);

private:
    PyObject* py_instance;

protected:
    static void _bind_methods() {
        ClassDB::bind_method(D_METHOD("call_method", "method_name", "args"), &PyObjectWrapper::call_method);
    }

public:
    PyObjectWrapper() : py_instance(nullptr) {}
    
    ~PyObjectWrapper() {
        if (py_instance) {
            Py_DECREF(py_instance); // Crucial: Frees Python memory when Godot drops the reference
        }
    }

    void set_instance(PyObject* inst) {
        if (py_instance) Py_DECREF(py_instance);
        py_instance = inst;
        if (py_instance) Py_INCREF(py_instance);
    }

    Variant call_method(String method_name, Array args) {
        if (!py_instance) return Variant();

        // Convert Godot String to standard C-string
        CharString ascii_method = method_name.ascii();
        PyObject* py_method = PyObject_GetAttrString(py_instance, ascii_method.get_data());
        
        if (!py_method || !PyCallable_Check(py_method)) {
            Py_XDECREF(py_method);
            return Variant(); // Method not found or not callable
        }

        // Convert Godot Array arguments to a Python Tuple
        int arg_count = args.size();
        PyObject* py_args = PyTuple_New(arg_count);
        
        for (int i = 0; i < arg_count; ++i) {
            Variant v = args[i];
            PyObject* py_val = nullptr;
            
            // Simple Type Marshaling Example
            if (v.get_type() == Variant::INT) {
                py_val = PyLong_FromLong(v.operator int64_t());
            } else if (v.get_type() == Variant::STRING) {
                py_val = PyUnicode_FromString(v.operator String().ascii().get_data());
            } else {
                py_val = Py_None;
                Py_INCREF(Py_None);
            }
            PyTuple_SetItem(py_args, i, py_val); // Steals the reference
        }

        // Execute the native Python function
        PyObject* py_result = PyObject_CallObject(py_method, py_args);
        Py_DECREF(py_args);
        Py_DECREF(py_method);

        // Convert the returned Python value back into a native Godot Variant
        Variant return_variant;
        if (py_result) {
            if (PyLong_Check(py_result)) {
                return_variant = (int64_t)PyLong_AsLong(py_result);
            } else if (PyUnicode_Check(py_result)) {
                return_variant = String(PyUnicode_AsUTF8(py_result));
            }
            Py_DECREF(py_result);
        }
        
        return return_variant;
    }
};
