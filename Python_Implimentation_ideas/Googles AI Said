using namespace godot;

class PyBridgeDiagnostics {
public:
    // Safely intercepts Python exceptions and routes them to the Godot Console
    static bool check_and_print_python_errors() {
        if (!PyErr_Occurred()) {
            return false; // No errors detected, execution was safe
        }

        PyObject *type = nullptr, *value = nullptr, *traceback = nullptr;
        PyErr_Fetch(&type, &value, &traceback);
        PyErr_NormalizeException(&type, &value, &traceback);

        String error_message = "[VisualGasic Python Error]: ";

        if (value) {
            PyObject* py_str = PyObject_Str(value);
            if (py_str) {
                error_message += String(PyUnicode_AsUTF8(py_str));
                Py_DECREF(py_str);
            }
        } else {
            error_message += "An unknown error occurred inside the Python runtime.";
        }

        // If a traceback is available, extract the exact file and line failure
        if (traceback) {
            PyObject* traceback_module = PyImport_ImportModule("traceback");
            if (traceback_module) {
                PyObject* format_exception = PyObject_GetAttrString(traceback_module, "format_exception");
                if (format_exception && PyCallable_Check(format_exception)) {
                    PyObject* py_list = PyObject_CallFunctionObjArgs(format_exception, type, value, traceback, nullptr);
                    if (py_list && PyList_Check(py_list)) {
                        Py_ssize_t size = PyList_Size(py_list);
                        error_message += "\n--- Traceback ---";
                        for (Py_ssize_t i = 0; i < size; ++i) {
                            PyObject* item = PyList_GetItem(py_list, i);
                            error_message += "\n" + String(PyUnicode_AsUTF8(item)).strip_edges();
                        }
                    }
                    Py_XDECREF(py_list);
                }
                Py_XDECREF(format_exception);
                Py_DECREF(traceback_module);
            }
        }

        // Send the formatted error straight to Godot's built-in debugger panel
        UtilityFunctions::printerr(error_message);

        // Clean up references to prevent memory leaks
        Py_XDECREF(type);
        Py_XDECREF(value);
        Py_XDECREF(traceback);

        return true; // Error was caught and processed
    }
};
