Option Explicit
Inherits Node

Dim g As Single
Dim gs As String
Dim gb As Boolean
Dim d As Dictionary
Dim gacc As Single
Dim gi As Integer
Dim gk As Integer

Sub _Ready()
	g = 1.5
	gs = "talk"
	d = New Dictionary
	d("k") = 2.5
End Sub

Function empty_fn() As Single
	Return 0
End Function

Function t_global(ByVal n As Integer) As Single
	Dim i As Integer
	Dim s As Single = 0
	For i = 1 To n
		s = s + g
	Next
	Return s
End Function

' A store into an Integer module variable: the compiler rounds the value
' with CLng unless it can prove an Integer.
Function t_gint(ByVal n As Integer) As Integer
	Dim i As Integer
	gi = 0
	For i = 1 To n
		gi = gi + 1
	Next
	Return gi
End Function

' Same Integer module store as t_gint, inside a branch, a different name,
' and a step other than 1. The coercion and the store still happen.
Function t_gint_if(ByVal n As Integer) As Integer
	Dim i As Integer
	gk = 0
	For i = 1 To n
		If i > 0 Then gk = gk + 2
	Next
	Return gk
End Function

Function t_local(ByVal n As Integer) As Single
	Dim i As Integer
	Dim s As Single = 0
	Dim h As Single = 1.5
	For i = 1 To n
		s = s + h
	Next
	Return s
End Function

Function t_getx(ByVal n As Integer) As Single
	Dim i As Integer
	Dim s As Single = 0
	Dim p As Variant = Vector2(3, 4)
	For i = 1 To n
		s = s + p.x
	Next
	Return s
End Function

Function t_getx_typed(ByVal n As Integer) As Single
	Dim i As Integer
	Dim s As Single = 0
	Dim p As Vector2 = Vector2(3, 4)
	For i = 1 To n
		s = s + p.x
	Next
	Return s
End Function

Function t_sety(ByVal n As Integer) As Single
	Dim i As Integer
	Dim p As Variant = Vector2(3, 4)
	For i = 1 To n
		p.y = p.y + 1
	Next
	Return p.y
End Function

Function t_dict(ByVal n As Integer) As Single
	Dim i As Integer
	Dim s As Single = 0
	For i = 1 To n
		s = s + d("k")
	Next
	Return s
End Function

Function t_streq(ByVal n As Integer) As Integer
	Dim i As Integer
	Dim c As Integer = 0
	For i = 1 To n
		If gs = "talk" And Not gb Then c = c + 1
	Next
	Return c
End Function

Function t_call(ByVal n As Integer) As Single
	Dim i As Integer
	Dim s As Single = 0
	For i = 1 To n
		s = s + empty_fn()
	Next
	Return s
End Function

' Call shapes beyond t_call: arguments with an Integer to Single conversion,
' a callee that writes a module variable, and a callee the JIT cannot compile
' (it reads a String), which stays an interpreted call.
Function blend3(ByVal a As Single, ByVal b As Single, ByVal t As Single) As Single
	Return a + (b - a) * t
End Function

Function t_call_args(ByVal n As Integer) As Single
	Dim i As Integer
	Dim s As Single = 0
	For i = 1 To n
		s = blend3(s, i, 0.25)
	Next
	Return s
End Function

' ByRef, the default for a parameter: the callee updates two of the caller's
' Single locals on every iteration (a rotation, so the result stays near 1).
Sub polar_step(ByRef x As Single, ByRef y As Single, ByVal k As Single)
	Dim t As Single = x
	x = x * 0.8 - y * k
	y = y * 0.8 + t * k
End Sub

Function t_call_byref(ByVal n As Integer) As Single
	Dim i As Integer
	Dim px As Single = 1
	Dim py As Single = 0
	For i = 1 To n
		polar_step px, py, 0.6
	Next
	Return px + py
End Function

Sub add_acc(ByVal v As Single)
	gacc = gacc + v
End Sub

Function t_call_global(ByVal n As Integer) As Single
	Dim i As Integer
	gacc = 0
	For i = 1 To n
		add_acc 0.5
	Next
	Return gacc
End Function

Function tag_len(ByVal i As Integer) As Integer
	Return Len(gs) + i
End Function

Function t_call_host(ByVal n As Integer) As Integer
	Dim i As Integer
	Dim c As Integer = 0
	For i = 1 To n
		c = c + tag_len(i)
	Next
	Return c
End Function

Function t_vec(ByVal n As Integer) As Variant
	Dim i As Integer
	Dim v As Variant = Vector2(0, 0)
	For i = 1 To n
		v = v + Vector2(1, 2) * 0.5
	Next
	Return v
End Function

Function t_sin(ByVal n As Integer) As Single
	Dim i As Integer
	Dim s As Single = 0
	For i = 1 To n
		s = s + Sin(i * 0.01) * 0.5
	Next
	Return s
End Function

' Plain statements of another shape than t_local: Integer control flow
' (If / ElseIf, compares, And / Or / Not, Mod, \) with an untyped local, and
' Double arithmetic on untyped locals. No calls, no module state.
Function t_branch(ByVal n As Integer) As Integer
	Dim i As Integer
	Dim c As Integer = 0
	Dim k As Variant
	For i = 1 To n
		k = i Mod 7
		If k = 0 Or k = 3 Then
			c = c + 2
		ElseIf k > 4 And Not (i Mod 2 = 0) Then
			c = c - 1
		Else
			c = c + (i \ 4) Mod 3
		End If
	Next
	Return c
End Function

Function t_poly(ByVal n As Integer) As Variant
	Dim i As Integer
	Dim x As Variant
	Dim acc As Variant = 0.0
	For i = 1 To n
		x = i * 0.001
		acc = acc + ((x * 0.5 - 1.25) * x + 3) * x
	Next
	Return acc
End Function
