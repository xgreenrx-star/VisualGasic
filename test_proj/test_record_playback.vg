Attribute VB_Name = "TestRecordPlayback"

' Test the EXACT recording/playback flow from Piano

Dim noteNames(5) As String
Dim noteCount As Integer

Dim recordedNotes(500) As Integer
Dim recordedTimes(500) As Single
Dim recordLength As Integer
Dim isRecording As Boolean
Dim isPlaying As Boolean
Dim isPlayingDemo As Boolean
Dim playbackTime As Single
Dim playbackIndex As Integer
Dim recordStartTime As Single
Dim playCount As Integer
Dim phase As Integer
Dim frameCount As Integer

Sub _Ready()
    noteCount = 3
    noteNames(0) = "C4"
    noteNames(1) = "D4"
    noteNames(2) = "E4"
    isRecording = False
    isPlaying = False
    playCount = 0
    phase = 0
    frameCount = 0
    
    ' Phase 0: Start recording
    ToggleRecording
End Sub

Sub PlayNote(noteIndex As Integer)
    If noteIndex < 0 Or noteIndex >= noteCount Then Exit Sub
    playCount = playCount + 1
    Print "  PlayNote: " & noteNames(noteIndex) & " (idx=" & Str(noteIndex) & " play#" & Str(playCount) & ")"
    
    If isRecording Then
        recordedNotes(recordLength) = noteIndex
        recordedTimes(recordLength) = Timer() - recordStartTime
        Print "    Recorded: idx=" & Str(noteIndex) & " time=" & Str(recordedTimes(recordLength))
        recordLength = recordLength + 1
    End If
End Sub

Sub ToggleRecording()
    If isRecording Then
        isRecording = False
        Print "[ToggleRecording] Stopped. " & Str(recordLength) & " notes"
    Else
        isRecording = True
        recordLength = 0
        recordStartTime = Timer()
        Print "[ToggleRecording] Started. startTime=" & Str(recordStartTime)
    End If
End Sub

Sub StartPlayback(useDemo As Boolean)
    isPlaying = True
    isPlayingDemo = useDemo
    playbackTime = 0
    playbackIndex = 0
    Print "[StartPlayback] isPlaying=true demo=" & Str(useDemo)
End Sub

Sub UpdatePlayback(delta As Single)
    If Not isPlaying Then Exit Sub
    
    playbackTime = playbackTime + delta
    
    Do While playbackIndex < recordLength
        If playbackTime >= recordedTimes(playbackIndex) Then
            Print "  [Playback] t=" & Str(playbackTime) & " >= " & Str(recordedTimes(playbackIndex)) & " -> note " & Str(recordedNotes(playbackIndex))
            PlayNote recordedNotes(playbackIndex)
            playbackIndex = playbackIndex + 1
        Else
            Exit Do
        End If
    Loop
    If playbackIndex >= recordLength Then
        isPlaying = False
        Print "[Playback] Finished! playCount=" & Str(playCount)
    End If
End Sub

Sub _Process(delta As Single)
    frameCount = frameCount + 1
    
    ' Phase 0: Record 3 notes on frames 5, 35, 65
    If phase = 0 Then
        If frameCount = 5 Then
            Print "[Frame 5] Recording note 0..."
            PlayNote 0
        End If
        If frameCount = 35 Then
            Print "[Frame 35] Recording note 1..."
            PlayNote 1
        End If
        If frameCount = 65 Then
            Print "[Frame 65] Recording note 2..."
            PlayNote 2
        End If
        If frameCount = 70 Then
            ToggleRecording
            Print "[Frame 70] Recorded " & Str(recordLength) & " notes:"
            Dim i As Integer
            For i = 0 To recordLength - 1
                Print "  note[" & Str(i) & "] = idx:" & Str(recordedNotes(i)) & " time:" & Str(recordedTimes(i))
            Next i
            phase = 1
            playCount = 0
        End If
    End If
    
    ' Phase 1: Wait a frame then start playback
    If phase = 1 And frameCount = 72 Then
        StartPlayback False
        phase = 2
    End If
    
    ' Phase 2: Playback
    If phase = 2 Then
        UpdatePlayback delta
        
        If Not isPlaying Then
            Print "PASS: Recording playback completed successfully"
            phase = 3
        End If
        If frameCount > 250 Then
            Print "FAIL: Playback stuck! pIdx=" & Str(playbackIndex) & " pTime=" & Str(playbackTime) & " recLen=" & Str(recordLength)
            If recordLength > 0 Then
                Print "  First recorded time: " & Str(recordedTimes(0))
                Print "  Last recorded time: " & Str(recordedTimes(recordLength - 1))
            End If
            phase = 3
        End If
    End If
End Sub
