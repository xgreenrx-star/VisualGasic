' Test: Error Handling
' Tests On Error Resume Next, On Error GoTo, Try/Catch, Err object
Attribute VB_Name = "TestErrorHandling"

Dim testResult As String

Sub _Ready()
	' --- On Error Resume Next ---
	On Error Resume Next
	Dim x As Integer = 1 / 0  ' Should not crash
	Print "PASS: on_error_resume_next"
	On Error GoTo 0  ' Reset error handling
	
	' --- Err object after error ---
	On Error Resume Next
	Dim y As Integer = 1 / 0
	If Err.Number <> 0 Then
		Print "PASS: err_number"
	Else
		Print "FAIL: err_number: Err.Number is 0"
	End If
	Err.Clear
	On Error GoTo 0
	
	' --- Err.Clear ---
	On Error Resume Next
	Dim z As Integer = 1 / 0
	Err.Clear
	If Err.Number = 0 Then
		Print "PASS: err_clear"
	Else
		Print "FAIL: err_clear: Err.Number = " & Str(Err.Number)
	End If
	On Error GoTo 0
	
	' --- Try/Catch ---
	testResult = ""
	TestTryCatch
	If testResult = "caught" Then
		Print "PASS: try_catch"
	Else
		Print "FAIL: try_catch: got " & testResult
	End If
	
	' --- Try with no error ---
	testResult = ""
	TestTryNoError
	If testResult = "ok" Then
		Print "PASS: try_no_error"
	Else
		Print "FAIL: try_no_error: got " & testResult
	End If
	
	Print "TEST_COMPLETE"
End Sub

Sub TestTryCatch()
	Try
		Dim x As Integer = 1 / 0
		testResult = "no_error"
	Catch ex
		testResult = "caught"
	End Try
End Sub

Sub TestTryNoError()
	Try
		Dim x As Integer = 42
		testResult = "ok"
	Catch ex
		testResult = "error"
	End Try
End Sub
