' Test: Error Handling
' Tests On Error Resume Next, Err.Raise, Err.Clear
' NOTE: Try/Catch + Err.Raise doesn't trigger catch in bytecode VM
' Division by zero also doesn't raise VG runtime errors
Attribute VB_Name = "TestErrorHandling"

Sub _Ready()
	' --- On Error Resume Next with Err.Raise ---
	On Error Resume Next
	Err.Raise 11, "DivTest", "Division by zero"
	Print "PASS: on_error_resume_next"
	
	' --- Err.Number should be set ---
	If Err.Number <> 0 Then
		Print "PASS: err_number"
	Else
		Print "FAIL: err_number: Err.Number is 0"
	End If
	
	' --- Err.Clear ---
	Err.Clear
	If Err.Number = 0 Then
		Print "PASS: err_clear"
	Else
		Print "FAIL: err_clear: Err.Number = " & CStr(Err.Number)
	End If
	On Error GoTo 0
	
	' --- On Error Resume Next allows continued execution ---
	On Error Resume Next
	Err.Raise 99, "Test", "Should be caught"
	Dim afterError As Boolean
	afterError = True
	If afterError Then
		Print "PASS: on_error_continues"
	Else
		Print "FAIL: on_error_continues"
	End If
	On Error GoTo 0
End Sub
