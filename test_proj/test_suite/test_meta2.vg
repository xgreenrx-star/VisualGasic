' MAX_FRAMES: 10
Attribute VB_Name = "TestMeta2"
Dim alreadyRan As Boolean
Sub _Ready()
    If alreadyRan = True Then Exit Sub
    alreadyRan = True
    Dim btn As Object
    Set btn = CreateNode("Button")
    btn.name = "btnM2"
    AddChild btn
    ' Tag and TabStop (existing properties)
    btn.Tag = "hello"
    Assert btn.Tag = "hello", "tag_roundtrip"
    Print "PASS: tag_roundtrip"
    btn.TabStop = True
    Assert btn.TabStop = True, "tabstop_true"
    Print "PASS: tabstop_true"
    ' BackStyle write/read
    btn.BackStyle = 1
    Dim bs
    bs = btn.BackStyle
    Assert bs = 1, "backstyle_1"
    Print "PASS: backstyle_1"
    btn.BackStyle = 0
    Assert btn.BackStyle = 0, "backstyle_0"
    Print "PASS: backstyle_0"
    Print "DONE"
End Sub
