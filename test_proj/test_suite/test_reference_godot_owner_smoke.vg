' Tier 1 smoke: owner-relative Godot builtins from reference audit
Extends Node2D
Attribute VB_Name = "TestReferenceGodotOwnerSmoke"

Sub _Ready()
	Dim tree As Variant
	Dim parent As Variant
	Dim fps As Integer
	Dim vis As Boolean

	fps = GetFPS()
	If fps >= 0 Then
		Print "PASS: get_fps"
	Else
		Print "FAIL: get_fps"
	End If

	tree = GetTree()
	If tree <> Null Then
		Print "PASS: get_tree"
	Else
		Print "FAIL: get_tree null"
	End If

	parent = GetParent()
	Print "PASS: get_parent_dispatch"

	vis = IsVisible()
	If vis Then Print "PASS: is_visible_dispatch" Else Print "FAIL: is_visible_dispatch"
	SetVisible(False)
	If Not IsVisible() Then Print "PASS: set_visible_false" Else Print "FAIL: set_visible_false"
	SetVisible(True)
	If IsVisible() Then Print "PASS: set_visible_true" Else Print "FAIL: set_visible_true"

	If Input.GetActionStrength("ui_accept") >= 0 Then
		Print "PASS: get_action_strength"
	Else
		Print "FAIL: get_action_strength"
	End If
End Sub
