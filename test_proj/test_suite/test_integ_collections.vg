' Test: Integration — Collections + Strings
' Tests Dictionary with string operations, For Each, frequency counting
Attribute VB_Name = "TestIntegCollStrings"

Sub _Ready()
    ' --- Build dictionary manually ---
    Dim scores As New Dictionary
    scores.Add "Alice", 95
    scores.Add "Bob", 87
    scores.Add "Charlie", 92

    If scores.Count() = 3 Then
        Print "PASS: integ_coll_dict_count"
    Else
        Print "FAIL: integ_coll_dict_count: expected 3, got " & CStr(scores.Count())
    End If

    If scores("Alice") = 95 Then
        Print "PASS: integ_coll_lookup_alice"
    Else
        Print "FAIL: integ_coll_lookup_alice"
    End If

    If scores("Bob") = 87 Then
        Print "PASS: integ_coll_lookup_bob"
    Else
        Print "FAIL: integ_coll_lookup_bob"
    End If

    ' --- Exists check ---
    If scores.Exists("Charlie") And Not scores.Exists("Diana") Then
        Print "PASS: integ_coll_exists"
    Else
        Print "FAIL: integ_coll_exists"
    End If

    ' --- Update value ---
    scores("Alice") = 100
    If scores("Alice") = 100 Then
        Print "PASS: integ_coll_update"
    Else
        Print "FAIL: integ_coll_update"
    End If

    ' --- For Each over array ---
    Dim names As Variant = Array("Alice", "Bob", "Charlie", "Diana", "Eve")
    Dim found As Boolean
    found = False
    Dim item As Variant
    For Each item In names
        If InStr(item, "li") > 0 Then
            found = True
            Exit For
        End If
    Next item

    If found Then
        Print "PASS: integ_coll_str_search"
    Else
        Print "FAIL: integ_coll_str_search"
    End If

    ' --- Frequency count with UCase ---
    Dim freq As New Dictionary
    Dim words As Variant = Array("The", "THE", "the", "tHe", "quick", "QUICK", "fox")
    For Each item In words
        Dim w As String
        w = UCase(item)
        If freq.Exists(w) Then
            freq(w) = freq(w) + 1
        Else
            freq.Add w, 1
        End If
    Next item

    If freq("THE") = 4 Then
        Print "PASS: integ_coll_freq_the"
    Else
        Print "FAIL: integ_coll_freq_the: expected 4, got " & CStr(freq("THE"))
    End If

    If freq("QUICK") = 2 Then
        Print "PASS: integ_coll_freq_quick"
    Else
        Print "FAIL: integ_coll_freq_quick"
    End If

    If freq("FOX") = 1 Then
        Print "PASS: integ_coll_freq_fox"
    Else
        Print "FAIL: integ_coll_freq_fox"
    End If

    ' --- Replace within array elements ---
    Dim items As Variant = Array("item_001", "item_002", "item_003")
    Dim i As Integer
    For i = 0 To 2
        items(i) = Replace(items(i), "item_", "ID:")
    Next i

    If items(0) = "ID:001" And items(2) = "ID:003" Then
        Print "PASS: integ_coll_replace_array"
    Else
        Print "FAIL: integ_coll_replace_array"
    End If
End Sub
