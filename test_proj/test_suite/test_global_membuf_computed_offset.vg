' Test: v6.2 Global MemoryBuffer fast path — computed-offset expression correctness
' This isolated repro proves OP_SET_GLOBAL_BUF8/OP_GET_GLOBAL_BUF8 handle a computed
' offset expression (mirrors Mem_Read's addr - base pattern) correctly.
Attribute VB_Name = "TestGlobalMemBufComputedOffset"

Public gBuf As Variant

Sub _Ready()
    Set gBuf = New MemoryBuffer(64)

    Dim addr As Integer
    addr = 30
    gBuf(addr - 10) = 55
    Dim result As Integer
    result = gBuf(20)
    If result = 55 Then
        Print "PASS: gbuf_computed_offset"
    Else
        Print "FAIL: gbuf_computed_offset: got " & CStr(result)
    End If

    gBuf.Free
End Sub

