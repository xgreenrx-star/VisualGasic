' Test: Python bridge preserves integer args in JSON encode path
' Requires PyBridgeFacade + python_worker (skipped gracefully if unavailable)
Attribute VB_Name = "TestPyRangeInt"

Sub _Ready()
    Dim bridge As Object
    Set bridge = New PyBridgeFacade
    If Not bridge.InitializeBridge() Then
        Print "SKIP: test_py_range_int (bridge unavailable)"
        Exit Sub
    End If

    Dim builtins
    builtins = bridge.PyImport("builtins")
    If IsEmpty(builtins) Then
        Print "SKIP: test_py_range_int (builtins import failed)"
        bridge.shutdown()
        Exit Sub
    End If

    Dim rangeList
    rangeList = bridge.PyCall(builtins, "range", Array(0, 5))
    If IsEmpty(rangeList) Then
        Print "FAIL: test_py_range_int: range call failed"
        bridge.shutdown()
        Exit Sub
    End If

    If TypeName(rangeList) <> "Array" Then
        Print "FAIL: test_py_range_int: expected Array got " & TypeName(rangeList) & "=" & CStr(rangeList)
        bridge.shutdown()
        Exit Sub
    End If

    If rangeList.size() <> 5 Then
        Print "FAIL: test_py_range_int: expected 5 elements got " & CStr(rangeList.size())
        bridge.shutdown()
        Exit Sub
    End If

    Dim idx As Long
    For idx = 0 To rangeList.size() - 1
        Dim elem
        elem = rangeList(idx)
        Dim tn As String
        tn = TypeName(elem)
        If tn <> "Integer" And tn <> "Long" And tn <> "Int" Then
            Print "FAIL: test_py_range_int: element " & CStr(idx) & " type=" & tn
            bridge.shutdown()
            Exit Sub
        End If
        If CDbl(elem) <> idx Then
            Print "FAIL: test_py_range_int: element " & CStr(idx) & " value=" & CStr(elem)
            bridge.shutdown()
            Exit Sub
        End If
    Next idx

    bridge.shutdown()
    Print "PASS: test_py_range_int"
End Sub
