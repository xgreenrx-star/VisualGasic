' M8 — Declare Function parsing + libc strlen (Linux desktop smoke).

Option Explicit

Declare Function vg_strlen Lib "libc.so.6" Alias "strlen" (ByVal s As String) As Long

Sub _Ready()
    Dim n As Long
    n = vg_strlen("hello")
    If n = 5 Then
        Print "PASS: declare_ffi_strlen"
    Else
        Print "FAIL: declare_ffi_strlen got " & CStr(n)
    End If
End Sub
