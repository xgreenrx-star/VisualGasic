' Return Len(module value) + argument without a frame on later calls.
' tag_len is the t_call_host shape. add_left swaps the operands. bag_len
' uses a Dictionary. wide branches, so it still enters the Function.
Option Explicit
Inherits Node

Dim gs As String
Dim bag As Dictionary

Sub Check(ByVal ok As Boolean, ByVal label As String)
	If ok Then
		Print "PASS: " & label
	Else
		Print "FAIL: " & label
	End If
End Sub

Function tag_len(ByVal i As Integer) As Integer
	Return Len(gs) + i
End Function

Function add_left(ByVal i As Integer) As Integer
	Return i + Len(gs)
End Function

Function bag_len(ByVal i As Integer) As Integer
	Return Len(bag) + i
End Function

Function wide(ByVal i As Integer) As Integer
	If i > 0 Then
		Return Len(gs) + 1
	End If
	Return Len(gs)
End Function

Sub _Ready()
	gs = "talk"
	Dim n As Integer
	Dim total As Integer = 0
	Dim expect As Integer = 0
	For n = 1 To 8
		total = total + tag_len(n)
		expect = expect + (4 + n)
	Next
	Check total = expect, "string length loop"

	Check add_left(3) = 7, "argument on the left"
	gs = "xy"
	Check add_left(1) = 3, "length follows the string"
	Check tag_len(1) = 3, "tag length follows the string"

	bag = New Dictionary
	bag("a") = 1
	bag("b") = 2
	Dim bsum As Integer = 0
	For n = 1 To 5
		bsum = bsum + bag_len(n)
	Next
	Check bsum = 25, "dictionary length loop"
	bag("c") = 3
	Check bag_len(0) = 3, "dictionary length follows the keys"

	gs = "ab"
	Check wide(2) = 3, "branch takes the then"
	Check wide(0) = 2, "branch takes the else"
End Sub
