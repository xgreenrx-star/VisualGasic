' Regression: Await on PyAsyncTask (PyCallAsync) yields until complete.
Attribute VB_Name = "TestPyAwait"

Sub _Ready()
    Dim bridge As Object
    Set bridge = New PyBridgeFacade

    If Not bridge.InitializeBridge() Then
        Print "FAIL: test_py_await init: " & bridge.GetStatus()
        Exit Sub
    End If

    Dim mathMod As Variant
    mathMod = bridge.PyImport("math")
    If IsEmpty(mathMod) Then
        Print "FAIL: test_py_await math import"
        bridge.shutdown()
        Exit Sub
    End If

    Dim pyJob As Variant
    pyJob = bridge.PyCallAsync(mathMod, "sqrt", Array(256.0))

    Await pyJob

    If pyJob.IsFailed Then
        Print "FAIL: test_py_await failed: " & pyJob.Error
        bridge.shutdown()
        Exit Sub
    End If

    Dim resultVal As Double
    resultVal = Val(CStr(pyJob.Result))
    If resultVal < 15.99 Or resultVal > 16.01 Then
        Print "FAIL: test_py_await expected 16, got " & CStr(pyJob.Result)
        bridge.shutdown()
        Exit Sub
    End If

    bridge.shutdown()
    Print "PASS: test_py_await"
End Sub
