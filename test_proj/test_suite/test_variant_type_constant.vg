' Vector2.UP and the other builtin-type constants are not ClassDB integer enums.

Sub note(ByVal ok As Boolean, ByVal label As String)
	If ok Then
		Print "PASS: " & label
	Else
		Print "FAIL: " & label
	End If
End Sub

Sub _Ready()
	Dim up As Vector2
	Dim v3 As Vector3
	Dim basis As Basis
	Dim flat As Transform2D
	up = Vector2.UP
	Call note(up.y = -1, "vector2_up")
	up = Vector2.DOWN
	Call note(up.y = 1, "vector2_down")
	up = Vector2.LEFT
	Call note(up.x = -1, "vector2_left")
	up = Vector2.RIGHT
	Call note(up.x = 1, "vector2_right")
	up = Vector2.ZERO
	Call note(up.x = 0 And up.y = 0, "vector2_zero")
	up = Vector2.ONE
	Call note(up.x = 1 And up.y = 1, "vector2_one")
	Call note(Vector2.AXIS_X = 0 And Vector2.AXIS_Y = 1, "vector2_axis")
	v3 = Vector3.UP
	Call note(v3.y = 1, "vector3_up")
	v3 = Vector3.FORWARD
	Call note(v3.z = -1, "vector3_forward")
	Call note(Vector3.AXIS_Z = 2, "vector3_axis_z")
	basis = Basis.IDENTITY
	Call note(basis.x.x = 1 And basis.y.y = 1 And basis.z.z = 1, "basis_identity")
	flat = Transform2D.IDENTITY
	Call note(flat.origin.x = 0 And flat.origin.y = 0, "transform2d_identity")
	v3 = Vector3.MODEL_TOP
	Call note(v3.y = 1, "vector3_model_top")
	v3 = Vector3.MODEL_FRONT
	Call note(v3.z = 1, "vector3_model_front")
	v3 = Vector3.MODEL_LEFT
	Call note(v3.x = 1, "vector3_model_left")
	Dim lo As Vector2i
	lo = Vector2i.MIN
	Call note(lo.x < 0 And lo.y < 0, "vector2i_min")
	lo = Vector2i.MAX
	Call note(lo.x > 0 And lo.y > 0, "vector2i_max")
	Dim lo3 As Vector3i
	lo3 = Vector3i.MIN
	Call note(lo3.z < 0, "vector3i_min")
	Dim lo4 As Vector4i
	lo4 = Vector4i.MAX
	Call note(lo4.w > 0, "vector4i_max")
	Dim ident As Projection
	Dim zero As Projection
	ident = Projection.IDENTITY
	zero = Projection.ZERO
	Call note(ident.x.x = 1 And zero.x.x = 0, "projection_identity_zero")
	ident = Projection()
	Call note(ident.x.x = 1, "projection_ctor")
	Call note(Projection.PLANE_NEAR = 0 And Projection.PLANE_BOTTOM = 5, "projection_planes")
	Dim q As Quaternion
	q = Quaternion.IDENTITY
	Call note(q.w = 1, "quaternion_identity")
	Dim xy As Plane
	xy = Plane.PLANE_XY
	Call note(xy.normal.z = 1, "plane_xy")
	Dim painted As Color
	painted = Color.html("#ff0000")
	Call note(painted.r > 0.9 And painted.g < 0.1, "color_html")
	Call note(Key.KEY_ESCAPE = 4194305, "key_escape")
	Call note(HorizontalAlignment.HORIZONTAL_ALIGNMENT_CENTER = 1, "halign_center")
	Call note(MouseButton.MOUSE_BUTTON_LEFT = 1, "mouse_left")
End Sub
