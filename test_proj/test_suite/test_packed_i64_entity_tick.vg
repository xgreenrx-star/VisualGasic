Option Explicit

' Native packed-I64 scan opcodes (EntityThink / FrameSlice / BatchNearest).
' Expected checksums are the same math as demo/bench.vg inner loops.

Sub _Ready()
	Dim hp(0) As Long
	Dim state(0) As Long
	Dim tag(0) As Long
	Dim px(0) As Long
	Dim py(0) As Long
	Dim i As Long
	Dim n As Long
	Dim sum As Long
	Dim h As Long
	Dim st As Long
	Dim tx As Long
	Dim ty As Long
	Dim best As Long
	Dim d As Long
	Dim bestIdx As Long

	n = 8
	ReDim hp(n - 1)
	ReDim state(n - 1)
	For i = 0 To n - 1 Step 1
		hp(i) = 100 + (i Mod 7)
		state(i) = i Mod 4
	Next i
	sum = 0
	For i = 0 To n - 1 Step 1
		If state(i) = 0 Then
			hp(i) = hp(i) - 1
		ElseIf state(i) = 1 Then
			hp(i) = hp(i) + 2
		Else
			state(i) = (state(i) + 1) Mod 4
		End If
		sum = sum + hp(i) + state(i)
	Next i
	If sum = 831 And hp(0) = 99 And hp(1) = 103 And state(2) = 3 And state(7) = 0 Then
		Print "PASS: packed i64 entity think"
	Else
		Print "FAIL: packed i64 entity think sum=" & CStr(sum) & " hp0=" & CStr(hp(0)) & " hp1=" & CStr(hp(1)) & " st2=" & CStr(state(2)) & " st7=" & CStr(state(7))
	End If

	ReDim hp(n - 1)
	ReDim state(n - 1)
	ReDim tag(n - 1)
	For i = 0 To n - 1 Step 1
		hp(i) = 100 + (i Mod 7)
		state(i) = i Mod 4
		tag(i) = 0
	Next i
	sum = 0
	For i = 0 To n - 1 Step 1
		h = hp(i)
		st = state(i)
		If st = 0 Then
			h = h - 1
		ElseIf st = 1 Then
			h = h + 2
		Else
			st = (st + 1) Mod 4
		End If
		hp(i) = h
		state(i) = st
		tag(i) = h + st
		sum = sum + tag(i)
	Next i
	If sum = 831 And tag(0) = 99 Then
		Print "PASS: packed i64 frame slice"
	Else
		Print "FAIL: packed i64 frame slice sum=" & CStr(sum) & " tag0=" & CStr(tag(0))
	End If

	n = 4
	ReDim px(n - 1)
	ReDim py(n - 1)
	For i = 0 To n - 1 Step 1
		px(i) = (i Mod 16) * 10
		py(i) = (i Mod 13) * 8
	Next i
	tx = 80
	ty = 52
	bestIdx = -1
	best = 2147483647
	For i = 0 To n - 1 Step 1
		d = (px(i) - tx) * (px(i) - tx) + (py(i) - ty) * (py(i) - ty)
		If d < best Then
			best = d
			bestIdx = i
		End If
	Next i
	If bestIdx = 3 And best = 3284 Then
		Print "PASS: packed i64 nearest"
	Else
		Print "FAIL: packed i64 nearest bestIdx=" & CStr(bestIdx) & " best=" & CStr(best)
	End If
End Sub
