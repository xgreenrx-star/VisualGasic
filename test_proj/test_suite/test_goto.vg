' Test: GoTo and Labels
' Tests GoTo, labels, forward jumps
' NOTE: On Error GoTo + Err.Raise may not trigger handler in VM
Attribute VB_Name = "TestGoto"

Dim testResult As String

Sub _Ready()
	' --- Forward GoTo ---
	testResult = ""
	TestForwardGoto
	If testResult = "jumped" Then
		Print "PASS: goto_forward"
	Else
		Print "FAIL: goto_forward: got " & testResult
	End If
	
	' --- GoTo skips code ---
	testResult = ""
	TestGotoSkip
	If testResult = "after" Then
		Print "PASS: goto_skip"
	Else
		Print "FAIL: goto_skip: got " & testResult
	End If
	
	' --- GoTo as conditional branch ---
	testResult = ""
	TestConditionalGoto
	If testResult = "took_branch" Then
		Print "PASS: goto_conditional"
	Else
		Print "FAIL: goto_conditional: got " & testResult
	End If
End Sub

Sub TestForwardGoto()
	GoTo target
	testResult = "skipped"
	Exit Sub
target:
	testResult = "jumped"
End Sub

Sub TestGotoSkip()
	GoTo skipPoint
	testResult = "before"
skipPoint:
	testResult = "after"
End Sub

Sub TestConditionalGoto()
	Dim x As Integer = 10
	If x > 5 Then GoTo TakeBranch
	testResult = "no_branch"
	Exit Sub
TakeBranch:
	testResult = "took_branch"
End Sub
