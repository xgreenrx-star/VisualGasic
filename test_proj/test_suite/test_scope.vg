' Test: Global Variables and Scope
' Tests global vs local scope
' NOTE: Variable shadowing (Dim globalVar inside function) writes to
' the global instead of creating a local. Workaround: use different name.
Attribute VB_Name = "TestScope"

Dim globalVar As Integer
Dim sharedVar As String

Sub _Ready()
	' --- Global variable assignment ---
	globalVar = 42
	If globalVar = 42 Then
		Print "PASS: global_assign"
	Else
		Print "FAIL: global_assign"
	End If
	
	' --- Global modified by sub ---
	SetGlobal 100
	If globalVar = 100 Then
		Print "PASS: global_modified_by_sub"
	Else
		Print "FAIL: global_modified_by_sub: got " & CStr(globalVar)
	End If
	
	' --- Local variable scope ---
	TestLocalScope
	If globalVar = 100 Then
		Print "PASS: local_scope"
	Else
		Print "FAIL: local_scope: globalVar = " & CStr(globalVar)
	End If
	
	' --- Global string modified by function ---
	sharedVar = "original"
	AppendToShared " appended"
	If sharedVar = "original appended" Then
		Print "PASS: global_string_modified"
	Else
		Print "FAIL: global_string_modified: got " & sharedVar
	End If
	
	' --- Function with local variable (use different name to avoid shadowing bug) ---
	globalVar = 999
	Dim shadowResult As Integer = GetLocalValue()
	If shadowResult = 77 And globalVar = 999 Then
		Print "PASS: function_local_var"
	Else
		Print "FAIL: function_local_var: result=" & CStr(shadowResult) & " global=" & CStr(globalVar)
	End If
	
	' --- Nested sub calls all see same global ---
	globalVar = 0
	IncrementGlobal
	IncrementGlobal
	IncrementGlobal
	If globalVar = 3 Then
		Print "PASS: global_multiple_calls"
	Else
		Print "FAIL: global_multiple_calls: got " & CStr(globalVar)
	End If
End Sub

Sub SetGlobal(val As Integer)
	globalVar = val
End Sub

Sub TestLocalScope()
	Dim x As Integer = 55
End Sub

Sub AppendToShared(suffix As String)
	sharedVar = sharedVar & suffix
End Sub

Function GetLocalValue() As Integer
	Dim localVal As Integer = 77
	Return localVal
End Function

Sub IncrementGlobal()
	globalVar = globalVar + 1
End Sub
