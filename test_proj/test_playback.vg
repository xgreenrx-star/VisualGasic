Attribute VB_Name = "TestPlayback"

Dim noteNames(20) As String
Dim noteFreqs(20) As Single
Dim activeNotes(20) As Boolean
Dim noteCount As Integer
Dim isPlaying As Boolean
Dim isPlayingDemo As Boolean
Dim playbackTime As Single
Dim playbackIndex As Integer
Dim demoSongNotes(30) As Integer
Dim demoSongTimes(30) As Single
Dim demoSongLength As Integer
Dim frameCount As Integer

Sub _Ready()
    noteCount = 5
    noteNames(0) = "C4"
    noteNames(1) = "D4"
    noteNames(2) = "E4"
    noteNames(3) = "F4"
    noteNames(4) = "G4"
    noteFreqs(0) = 261.63
    noteFreqs(1) = 293.66
    noteFreqs(2) = 329.63
    noteFreqs(3) = 349.23
    noteFreqs(4) = 392.00
    
    ' Load a mini demo song
    demoSongNotes(0) = 2
    demoSongTimes(0) = 0.0
    demoSongNotes(1) = 1
    demoSongTimes(1) = 0.1
    demoSongNotes(2) = 0
    demoSongTimes(2) = 0.2
    demoSongNotes(3) = 1
    demoSongTimes(3) = 0.3
    demoSongNotes(4) = 2
    demoSongTimes(4) = 0.4
    demoSongLength = 5
    
    frameCount = 0
    
    ' Start playback immediately
    isPlaying = True
    isPlayingDemo = True
    playbackTime = 0
    playbackIndex = 0
    Print "Starting demo playback test..."
    Print "_Ready: isPlaying=" & Str(isPlaying) & " isPlayingDemo=" & Str(isPlayingDemo)
End Sub

Sub _Process(delta As Single)
    frameCount = frameCount + 1
    UpdatePlayback delta
    
    If frameCount <= 60 Then
        Print "Frame " & Str(frameCount) & ": playing=" & Str(isPlaying) & " idx=" & Str(playbackIndex) & " time=" & Str(playbackTime)
    End If
    
    If frameCount >= 60 Then
        Print "DONE - played " & Str(playbackIndex) & " of " & Str(demoSongLength) & " notes"
    End If
End Sub

Sub UpdatePlayback(delta As Single)
    Print "  UpdatePlayback called: isPlaying=" & Str(isPlaying) & " delta=" & Str(delta)
    If Not isPlaying Then Exit Sub
    
    playbackTime = playbackTime + delta
    Print "  playbackTime=" & Str(playbackTime) & " idx=" & Str(playbackIndex) & " len=" & Str(demoSongLength)
    
    If isPlayingDemo Then
        Do While playbackIndex < demoSongLength
            If playbackTime >= demoSongTimes(playbackIndex) Then
                PlayNote demoSongNotes(playbackIndex)
                playbackIndex = playbackIndex + 1
            Else
                Exit Do
            End If
        Loop
        If playbackIndex >= demoSongLength Then
            isPlaying = False
            Print "Demo finished!"
        End If
    End If
End Sub

Sub PlayNote(noteIndex As Integer)
    Print "  -> PlayNote: " & noteNames(noteIndex) & " (" & Str(noteFreqs(noteIndex)) & " Hz)"
    activeNotes(noteIndex) = True
End Sub
