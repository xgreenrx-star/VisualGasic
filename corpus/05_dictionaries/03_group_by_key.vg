' Group an array of records by a key.
' The result is a dictionary of dictionaries, keyed by city then member index.
' Fixed input records are read once from a labeled Data table.

Sub Main()
    ' groups: city → Dictionary(index → name) for ordered insertion
    Dim groups As New Dictionary
    Dim counts As New Dictionary

    Dim recordIndex As Integer
    Dim city As String
    Dim person As String
    Restore People
    For recordIndex = 1 To 6
        Read city, person

        If Not groups.Exists(city) Then
            groups.Add(city, New Dictionary)
            counts.Add(city, 0)
        End If
        Dim idx As Integer = counts(city)
        groups(city).Add(CStr(idx), person)
        counts(city) = idx + 1
    Next recordIndex

    ' Print each group in insertion order: London, Paris, Tokyo
    Dim c As String
    For Each c In groups.Keys
        Dim members As Dictionary = groups(c)
        Dim line As String = ""
        Dim j As Integer
        For j = 0 To counts(c) - 1
            If j > 0 Then line = line & ", "
            line = line & members(CStr(j))
        Next j
        Print c & ": " & line
    Next c
End Sub

People:
Data "London", "Alice", "Paris", "Bob", "London", "Carol"
Data "Tokyo", "Dave", "Paris", "Eve", "London", "Frank"

' Expected output:
' London: Alice, Carol, Frank
' Paris: Bob, Eve
' Tokyo: Dave
