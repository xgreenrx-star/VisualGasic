' Memoising a slow function with a Dictionary cache.
' Standard pattern: check the cache; if hit, return; otherwise compute,
' store, return. Here we cache the Fibonacci function so the recursive
' definition runs in linear time instead of exponential.

Dim memo As New Dictionary

Function Fib(ByVal n As Integer) As Long
    If n < 2 Then
        Fib = n
        Exit Function
    End If

    Dim key As String = CStr(n)
    If memo.Exists(key) Then
        Fib = memo(key)
        Exit Function
    End If

    Dim result As Long = Fib(n - 1) + Fib(n - 2)
    memo.Add(key, result)
    Fib = result
End Function

Sub Main()
    Dim i As Integer
    For i = 0 To 15
        Print "Fib(" & CStr(i) & ") = " & CStr(Fib(i))
    Next i

    Print "Cache holds " & CStr(memo.Count()) & " entries"
End Sub

' Expected output:
' Fib(0) = 0
' Fib(1) = 1
' Fib(2) = 1
' Fib(3) = 2
' Fib(4) = 3
' Fib(5) = 5
' Fib(6) = 8
' Fib(7) = 13
' Fib(8) = 21
' Fib(9) = 34
' Fib(10) = 55
' Fib(11) = 89
' Fib(12) = 144
' Fib(13) = 233
' Fib(14) = 377
' Fib(15) = 610
' Cache holds 14 entries
