' Compute the sum and average of a numeric array.
' A floating-point accumulator preserves fractional input values;
' / performs floating-point division, whereas \ is integer division.

' Array parameters use Variant; elements are read into typed locals.
Function ArraySum(values As Variant) As Single
    Dim total As Single = 0.0
    Dim v As Single
    For Each v In values
        total = total + v
    Next v
    ArraySum = total
End Function

Function ArrayAverage(values As Variant) As Single
    Dim n As Integer = UBound(values) - LBound(values) + 1
    If n = 0 Then
        Raise 5, "Cannot average an empty array"
    Else
        ArrayAverage = ArraySum(values) / CSng(n)
    End If
End Function

Sub Main()
    Dim scores(4) As Single
    scores(0) = 72.0
    scores(1) = 85.5
    scores(2) = 91.0
    scores(3) = 68.5
    scores(4) = 78.0

    Print "Sum:     " & CStr(ArraySum(scores))
    Print "Average: " & CStr(ArrayAverage(scores))
End Sub

' Expected output:
' Sum:     395
' Average: 79
