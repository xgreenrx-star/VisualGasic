' Arrays in VisualGasic are 0-indexed by default.
' Dim arr(N) As T allocates indices 0..N (so N+1 elements total).
' UBound returns the highest valid index; LBound returns the lowest (0).

Sub Main()
    ' Five-element array of integers
    Dim primes(4) As Integer
    primes(0) = 2
    primes(1) = 3
    primes(2) = 5
    primes(3) = 7
    primes(4) = 11

    Print "Length: " & CStr(UBound(primes) - LBound(primes) + 1)
    Print "First:  " & CStr(primes(0))
    Print "Last:   " & CStr(primes(UBound(primes)))

    ' Iterate with For Each (read-only)
    Dim p As Integer
    For Each p In primes
        Print "  prime: " & CStr(p)
    Next p

    ' Iterate with index (lets you mutate)
    Dim i As Integer
    For i = 0 To UBound(primes)
        primes(i) = primes(i) * 10
    Next i
    Print "After * 10: " & CStr(primes(0)) & "," & CStr(primes(4))
End Sub

' Expected output:
' Length: 5
' First:  2
' Last:   11
'   prime: 2
'   prime: 3
'   prime: 5
'   prime: 7
'   prime: 11
' After * 10: 20,110
