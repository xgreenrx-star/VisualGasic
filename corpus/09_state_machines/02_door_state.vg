' A door state machine driven by external events.
' States: CLOSED, OPENING, OPEN, CLOSING.
' Events: "open", "close", "tick".
' This pattern shows up everywhere -- elevators, garage doors, vending
' machines. Select Case keeps transitions grouped by the current state.

Function Step(state As String, event As String) As String
    Select Case state
        Case "CLOSED"
            If event = "open" Then
                Step = "OPENING"
            Else
                Step = state
            End If

        Case "OPENING"
            If event = "tick" Then
                Step = "OPEN"
            Else
                Step = state
            End If

        Case "OPEN"
            If event = "close" Then
                Step = "CLOSING"
            Else
                Step = state
            End If

        Case "CLOSING"
            If event = "tick" Then
                Step = "CLOSED"
            Else
                Step = state
            End If

        Case Else
            Raise 5, "Unknown door state: " & state
    End Select
End Function

Sub Main()
    Dim state As String = "CLOSED"

    Print "Initial: " & state

    Dim e As String
    Dim eventIndex As Integer
    Restore DoorEvents
    For eventIndex = 1 To 6
        Read e
        Dim newState As String = Step(state, e)
        Print "  " & state & " --(" & e & ")--> " & newState
        state = newState
    Next eventIndex
End Sub

DoorEvents:
Data "open", "tick", "close", "tick", "open", "tick"

' Expected output:
' Initial: CLOSED
'   CLOSED --(open)--> OPENING
'   OPENING --(tick)--> OPEN
'   OPEN --(close)--> CLOSING
'   CLOSING --(tick)--> CLOSED
'   CLOSED --(open)--> OPENING
'   OPENING --(tick)--> OPEN
