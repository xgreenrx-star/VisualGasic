' Join() with integer and numeric arrays.
' A labeled Data table becomes a general array with DataToArray.
' Join accepts general arrays and string arrays, not packed numeric arrays.

Sub Main()
    Dim scores As Variant = DataToArray("Scores")
    Print Join(scores, ", ")

    ' Joined with a different delimiter
    Print Join(scores, " | ")

    ' String array round-trips through Join/Split.
    Dim words(2) As String
    words(0) = "red"
    words(1) = "green"
    words(2) = "blue"
    Dim joined As String = Join(words, "-")
    Print joined
    Dim parts() As String = Split(joined, "-")
    Print Join(parts, ", ")
End Sub

Scores:
Data 64, 25, 12, 0, -7

' Expected output:
' 64, 25, 12, 0, -7
' 64 | 25 | 12 | 0 | -7
' red-green-blue
' red, green, blue
