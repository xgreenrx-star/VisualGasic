' The Fibonacci sequence by iteration.
' Two accumulators, swap each step. O(n) time, O(1) space.
' Use Long (not Integer) so the result doesn't overflow at n=47.

Function Fibonacci(n As Integer) As Long
    If n < 2 Then
        Fibonacci = n
        Exit Function
    End If

    Dim a As Long = 0
    Dim b As Long = 1
    Dim i As Integer
    For i = 2 To n
        Dim next As Long = a + b
        a = b
        b = next
    Next i
    Fibonacci = b
End Function

Sub Main()
    Dim n As Integer
    For n = 0 To 20
        Print "Fibonacci(" & CStr(n) & ") = " & CStr(Fibonacci(n))
    Next n
End Sub

