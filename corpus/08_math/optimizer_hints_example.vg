Attribute VB_Name = "OptimizerHintsExample"

' Optimizer Hints Example
' =======================
' Demonstrates how to use '@accumulator, '@loop_counter, and '@pure
' directives to help the VG bytecode optimizer recognize patterns
' for faster code generation.
'
' Run via: node.call("Main")

' --- Example 1: Accumulator Pattern ---
' The '@accumulator hint tells the optimizer that 'total' is only
' modified by addition inside the loop. This enables sum-reduction
' optimizations (e.g., unrolling, vectorization in future versions).

Function SumArray(arr() As Long) As Long
    Dim total As Long = 0
    Dim i As Long
    '@accumulator total
    '@loop_counter i
    For i = 0 To UBound(arr)
        total = total + arr(i)
    Next i
    SumArray = total
End Function

' --- Example 2: Loop Counter Pattern ---
' When the optimizer knows 'i' is a simple 0→N counter, it can
' elide bounds checks and apply strength reduction.

Function CountEvens(arr() As Long) As Long
    Dim count As Long = 0
    Dim i As Long
    '@loop_counter i
    '@accumulator count
    For i = 0 To UBound(arr)
        If arr(i) Mod 2 = 0 Then
            count = count + 1
        End If
    Next i
    CountEvens = count
End Function

' --- Example 3: Pure Function Hint ---
' Marking a function as '@pure tells the optimizer it has no side
' effects and always returns the same result for the same inputs.
' This allows the optimizer to hoist the call out of loops or
' fold constant arguments at compile time.

'@pure
Function Square(x As Long) As Long
    Square = x * x
End Function

Function SumOfSquares(n As Long) As Long
    Dim total As Long = 0
    Dim i As Long
    '@accumulator total
    '@loop_counter i
    For i = 1 To n
        total = total + Square(i)
    Next i
    SumOfSquares = total
End Function

' --- Example 4: MemoryBuffer with Optimizer Hints ---
' Combining Buffer Type with optimizer hints for maximum performance.
' This pattern is common in emulator inner loops.

Function BufferChecksum(size As Long) As Long
    Dim buf As New MemoryBuffer(size)
    Dim i As Long
    Dim checksum As Long = 0

    ' Fill buffer with a pattern
    '@loop_counter i
    For i = 0 To size - 1
        buf(i) = (i * 7 + 13) And &HFF
    Next i

    ' Compute checksum
    '@loop_counter i
    '@accumulator checksum
    For i = 0 To size - 1
        checksum = checksum + buf(i)
    Next i

    BufferChecksum = checksum
End Function

' --- Main: Run all examples and verify results ---

Sub Main()
    ' Test 1: SumArray
    Dim arr(9) As Long
    Dim i As Long
    For i = 0 To 9
        arr(i) = i + 1   ' 1, 2, 3, ..., 10
    Next i
    Dim sum As Long = SumArray(arr)
    Print "SumArray(1..10) = " & sum
    Assert sum = 55, "SumArray should be 55"

    ' Test 2: CountEvens
    Dim evens As Long = CountEvens(arr)
    Print "CountEvens(1..10) = " & evens
    Assert evens = 5, "CountEvens should be 5"

    ' Test 3: SumOfSquares
    Dim sqSum As Long = SumOfSquares(5)
    Print "SumOfSquares(5) = " & sqSum
    Assert sqSum = 55, "SumOfSquares(5) should be 55 (1+4+9+16+25)"

    ' Test 4: BufferChecksum
    Dim cksum As Long = BufferChecksum(256)
    Print "BufferChecksum(256) = " & cksum
    Assert cksum > 0, "BufferChecksum should be > 0"

    Print ""
    Print "All optimizer hints examples passed!"
End Sub
