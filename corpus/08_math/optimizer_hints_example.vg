Attribute VB_Name = "OptimizerHintsExample"

' Optimizer-friendly loops (the filename is retained for existing links).
' Simple accumulators and counted loops make intent easy to inspect.
' Comment annotations are not recognized optimizer directives; these
' examples make no guarantee about a particular optimization or speedup.
' The corpus runner invokes Main; no GDScript caller is needed.

' A reduction keeps the accumulator separate from its loop counter.
Function SumArray(arr As Variant) As Long
    Dim total As Long = 0
    Dim i As Long
    For i = 0 To UBound(arr)
        total = total + arr(i)
    Next i
    SumArray = total
End Function

' Count matches while preserving the source array.
Function CountEvens(arr As Variant) As Long
    Dim count As Long = 0
    Dim i As Long
    For i = 0 To UBound(arr)
        If arr(i) Mod 2 = 0 Then
            count = count + 1
        End If
    Next i
    CountEvens = count
End Function

' Square has no side effects; no annotation is needed for correctness.
Function Square(x As Long) As Long
    Square = x * x
End Function

Function SumOfSquares(n As Long) As Long
    Dim total As Long = 0
    Dim i As Long
    For i = 1 To n
        total = total + Square(i)
    Next i
    SumOfSquares = total
End Function

' MemoryBuffer stores bytes, making its storage intent explicit.
Function BufferChecksum(size As Long) As Long
    Dim buf As New MemoryBuffer(size)
    Dim i As Long
    Dim checksum As Long = 0

    ' Fill buffer with a pattern
    For i = 0 To size - 1
        buf(i) = (i * 7 + 13) And &HFF
    Next i

    ' Compute checksum
    For i = 0 To size - 1
        checksum = checksum + buf(i)
    Next i

    BufferChecksum = checksum
End Function

' --- Main: Run all examples and verify results ---

Sub Main()
    ' Test 1: SumArray
    Dim arr(9) As Long
    Dim i As Long
    For i = 0 To 9
        arr(i) = i + 1   ' 1, 2, 3, ..., 10
    Next i
    Dim sum As Long = SumArray(arr)
    Print "SumArray(1..10) = " & sum
    Assert sum = 55, "SumArray should be 55"

    ' Test 2: CountEvens
    Dim evens As Long = CountEvens(arr)
    Print "CountEvens(1..10) = " & evens
    Assert evens = 5, "CountEvens should be 5"

    ' Test 3: SumOfSquares
    Dim sqSum As Long = SumOfSquares(5)
    Print "SumOfSquares(5) = " & sqSum
    Assert sqSum = 55, "SumOfSquares(5) should be 55 (1+4+9+16+25)"

    ' Test 4: BufferChecksum
    Dim cksum As Long = BufferChecksum(256)
    Print "BufferChecksum(256) = " & cksum
    Assert cksum = 32640, "BufferChecksum should sum every byte value once"

    Print ""
    Print "All optimizer-friendly loop examples passed!"
End Sub

' Expected output:
' SumArray(1..10) = 55
' CountEvens(1..10) = 5
' SumOfSquares(5) = 55
' BufferChecksum(256) = 32640
'
' All optimizer-friendly loop examples passed!
