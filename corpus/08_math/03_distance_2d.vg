' 2D Euclidean distance between two points.
' Sqr is square root in VisualGasic (the historical name from BASIC).
' For game code, prefer DistanceSquared when comparing distances --
' it skips the costly Sqr and the relative ordering is the same.

Function Distance(x1 As Single, y1 As Single, x2 As Single, y2 As Single) As Single
    Dim dx As Single = x2 - x1
    Dim dy As Single = y2 - y1
    Distance = Sqr(dx * dx + dy * dy)
End Function

Function DistanceSquared(x1 As Single, y1 As Single, x2 As Single, y2 As Single) As Single
    Dim dx As Single = x2 - x1
    Dim dy As Single = y2 - y1
    DistanceSquared = dx * dx + dy * dy
End Function

Sub Main()
    Print "Distance (0,0)->(3,4) = " & CStr(Distance(0, 0, 3, 4))
    Print "Distance (1,1)->(4,5) = " & CStr(Distance(1, 1, 4, 5))
    Print "DistanceSquared (0,0)->(3,4) = " & CStr(DistanceSquared(0, 0, 3, 4))

    ' Game-style: is the player within 10 units of the enemy?
    Dim playerX As Single = 5.0
    Dim playerY As Single = 5.0
    Dim enemyX As Single = 12.0
    Dim enemyY As Single = 8.0

    Dim radius As Single = 10.0
    If DistanceSquared(playerX, playerY, enemyX, enemyY) <= radius * radius Then
        Print "Enemy in range"
    Else
        Print "Enemy out of range"
    End If
End Sub

' Expected output:
' Distance (0,0)->(3,4) = 5
' Distance (1,1)->(4,5) = 5
' DistanceSquared (0,0)->(3,4) = 25
' Enemy in range
