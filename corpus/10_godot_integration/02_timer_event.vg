' Godot integration: a Timer that ticks once per second.
' The same naming convention that wires button clicks also wires
' Timer.timeout uses the VB-style handler Sub Timer1_Timer().
' Requires Timer1 and a Label named lblTime below a Control form.
' Audit mode: timer

Dim secondsElapsed As Integer

Sub Form_Load()
    secondsElapsed = 0
    Timer1.Interval = 1000    ' VG uses milliseconds, not Godot's seconds.
    Timer1.OneShot = False
    Timer1.Start()
    lblTime.Text = "0 seconds"
End Sub

Sub Timer1_Timer()
    secondsElapsed = secondsElapsed + 1
    lblTime.Text = CStr(secondsElapsed) & " seconds"

    ' Stop after 10 seconds for demo purposes
    If secondsElapsed >= 10 Then
        Timer1.Stop()
        lblTime.Text = "Done."
        Print "Timer finished after " & CStr(secondsElapsed) & " ticks"
    End If
End Sub

' The audit emits ten timeout signals and verifies that the timer stops.
' Expected output:
' Timer finished after 10 ticks
