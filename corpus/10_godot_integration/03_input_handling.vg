' Godot integration: keyboard input.
' Form_KeyDown receives a KeyCode and a Shift flag.
' Use VG's vbKey constants; numeric VB6 keycodes do not match Godot.
' Shift is a modifier bitmask: Shift=1, Ctrl=2, Alt=4.
' Requires a focusable Control named Form and a Label named lblPlayer.
' Audit mode: keyboard

Dim playerX As Single
Dim playerY As Single

Sub Form_Load()
    playerX = 100.0
    playerY = 100.0
    UpdatePlayerLabel()
End Sub

Sub UpdatePlayerLabel()
    lblPlayer.Text = "Player: (" & CStr(playerX) & ", " & CStr(playerY) & ")"
    Print lblPlayer.Text
End Sub

Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)
    Dim moveStep As Single = 10.0
    If (Shift And 1) <> 0 Then moveStep = 50.0

    Select Case KeyCode
        Case vbKeyLeft
            playerX = playerX - moveStep
        Case vbKeyRight
            playerX = playerX + moveStep
        Case vbKeyUp
            playerY = playerY - moveStep
        Case vbKeyDown
            playerY = playerY + moveStep
        Case vbKeyEscape
            playerX = 100.0
            playerY = 100.0
            Print "Reset to start"
        Case Else
            ' Ignore other keys
    End Select

    UpdatePlayerLabel()
End Sub

' The audit sends Left, Shift+Right, Ctrl+Up, Down, then Escape.
' Expected output:
' Player: (100, 100)
' Player: (90, 100)
' Player: (140, 100)
' Player: (140, 90)
' Player: (140, 100)
' Reset to start
' Player: (100, 100)
