' Godot integration: emitting a custom signal from a class.
' RaiseEvent fires a signal declared with the Event keyword.
' This example shows the publisher side; the subscriber receives
' the event via the naming convention sub inside the same module.

' --- Publisher: a "Score" panel that emits HighScoreReached ---
Class ScorePanel
    Public score As Integer

    Event HighScoreReached(newScore As Integer)

    Sub Class_Initialize()
        score = 0
    End Sub

    Sub AddPoints(points As Integer)
        score = score + points
        Print "Score is now " & CStr(score)
        If score >= 100 Then
            RaiseEvent HighScoreReached(score)
        End If
    End Sub
End Class

Sub Main()
    Dim panel As Variant = New ScorePanel

    panel.AddPoints(30)
    panel.AddPoints(40)
    panel.AddPoints(50)    ' This crosses 100 and fires the event
End Sub

' Expected output:
' Score is now 30
' Score is now 70
' Score is now 120
