' Godot integration: emitting and receiving a custom signal.
' RaiseEvent fires a signal declared with the Event keyword.
' Other forms can subscribe to it the same way they subscribe to
' built-in events: by naming convention.

' --- Publisher: a "Score" panel that emits HighScoreReached ---
Class ScorePanel
    Public score As Integer

    Event HighScoreReached(newScore As Integer)

    Sub Class_Initialize()
        score = 0
    End Sub

    Sub AddPoints(points As Integer)
        score = score + points
        Print "Score is now " & CStr(score)
        If score >= 100 Then
            RaiseEvent HighScoreReached(score)
        End If
    End Sub
End Class

' --- Subscriber: receives the signal by naming convention ---
' If we had a ScorePanel control on a form named scorePanel1, then:
'   Sub scorePanel1_HighScoreReached(newScore As Integer)
' would auto-connect. Here we wire it manually for the demo.

Sub OnHighScoreReached(newScore As Integer)
    Print "*** HIGH SCORE! " & CStr(newScore) & " points ***"
End Sub

Sub Main()
    Dim panel As Variant = New ScorePanel
    AddHandler panel.HighScoreReached, AddressOf OnHighScoreReached

    panel.AddPoints(30)
    panel.AddPoints(40)
    panel.AddPoints(50)    ' This crosses 100 and fires the event
End Sub

' Expected output:
' Score is now 30
' Score is now 70
' Score is now 120
' *** HIGH SCORE! 120 points ***
