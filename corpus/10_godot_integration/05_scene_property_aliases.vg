' Godot integration: VisualGasic exposes Godot Node properties under
' both their original snake_case names AND VB-style PascalCase aliases,
' so an auditor reading a VG program never has to mentally translate.
'
' Both of the following lines do the same thing:
'   sprite1.position = Vector2(100, 200)
'   sprite1.Position = Vector2(100, 200)
'
' Same for: visible/Visible, modulate/Modulate, rotation/Rotation,
' scale/Scale, name/Name, and so on.
' Requires Sprite2D sprite1, Label lblPlayer, and Buttons btnMove,
' btnHide and btnTint below a Control form.
' Audit mode: properties

Sub Form_Load()
    ' All four assignments use VB-style aliases
    sprite1.Visible = True
    sprite1.Position = Vector2(50.0, 50.0)
    sprite1.Rotation = 0.0
    sprite1.Modulate = Color(1.0, 1.0, 1.0, 1.0)

    lblPlayer.Text = "Player ready"
    Print lblPlayer.Text
End Sub

Sub btnMove_Click()
    ' Read the current position, then set a new one
    Dim p As Variant = sprite1.Position
    p.x = p.x + 10.0
    sprite1.Position = p
    lblPlayer.Text = "Moved to x=" & CStr(p.x)
    Print lblPlayer.Text
End Sub

Sub btnHide_Click()
    sprite1.Visible = Not sprite1.Visible
    Print "Visible: " & CStr(sprite1.Visible)
End Sub

Sub btnTint_Click()
    ' Pick a random colour
    Dim r As Single = Rnd()
    Dim g As Single = Rnd()
    Dim b As Single = Rnd()
    sprite1.Modulate = Color(r, g, b, 1.0)
    Print "Tint applied"
End Sub

' The audit presses Move, Hide and Tint and checks the resulting properties.
' Expected output:
' Player ready
' Moved to x=60
' Visible: false
' Tint applied
