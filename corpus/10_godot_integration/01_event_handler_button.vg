' Godot integration: a button click event handler.
' VisualGasic auto-wires events by naming convention:
'   Sub <controlName>_<eventName>(args...)
' So Sub btnSave_Click() is automatically connected to the
' "pressed" signal of a Button control named btnSave on the form.
'
' Requires a Control form with Button children btnSave and btnReset,
' and a Label named lblStatus. The audit builds that host and emits pressed.
' Audit mode: buttons

Dim clickCount As Integer

Sub Form_Load()
    Print "Form loaded"
    clickCount = 0
    btnSave.Text = "Save"
    btnReset.Text = "Reset"
    lblStatus.Text = "Ready"
End Sub

Sub btnSave_Click()
    clickCount = clickCount + 1
    lblStatus.Text = "Saved! (clicks: " & CStr(clickCount) & ")"
    Print "Save clicked. Total: " & CStr(clickCount)
End Sub

Sub btnReset_Click()
    clickCount = 0
    lblStatus.Text = "Ready"
    Print "Reset"
End Sub

' Expected output:
' Form loaded
' Save clicked. Total: 1
' Save clicked. Total: 2
' Reset
