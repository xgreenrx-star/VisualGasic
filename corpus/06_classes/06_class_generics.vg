' Generic/Parameterized Classes in VisualGasic
' A type parameter describes a reusable class shape without code duplication.
' Custom generic members are not all runtime-checked; use Collection(Of T)
' when you need a built-in collection that rejects mismatched element types.
' Syntax: Class MyClass(Of T) where T is the type parameter.
' This example shows a simple Container that holds one value of any type.

' A generic container that can hold any single value.
Class Container(Of T)
    Private _value As T
    Private _isEmpty As Boolean
    
    Sub Class_Initialize()
        _isEmpty = True
    End Sub
    
    Sub StoreValue(val As T)
        _value = val
        _isEmpty = False
    End Sub
    
    Function ReadValue() As T
        If _isEmpty Then
            Raise 5, "Container is empty"
        End If
        Return _value
    End Function
    
    Function HasValue() As Boolean
        Return Not _isEmpty
    End Function
    
    Sub Clear()
        _isEmpty = True
    End Sub
End Class

Sub Main()
    ' Create a container for integers
    Dim intContainer As New Container(Of Integer)
    intContainer.StoreValue(42)
    Print "Integer container: " & CStr(intContainer.ReadValue())
    
    ' Create a container for strings
    Dim strContainer As New Container(Of String)
    strContainer.StoreValue("Hello, Generics!")
    Print "String container: " & strContainer.ReadValue()
    
    ' Check if container has value before accessing
    Dim emptyContainer As New Container(Of Single)
    If emptyContainer.HasValue() Then
        Print "This should not print"
    Else
        Print "Empty container correctly reports no value"
    End If
    
    ' Clear and verify
    intContainer.Clear()
    If Not intContainer.HasValue() Then
        Print "Container cleared successfully"
    End If
End Sub

' Expected output:
' Integer container: 42
' String container: Hello, Generics!
' Empty container correctly reports no value
' Container cleared successfully
