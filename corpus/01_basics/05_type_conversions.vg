' Type conversion functions in VisualGasic.
' CStr, CInt, CSng and CBool convert values to the requested type.
' Validate numeric text with IsNumeric before conversion; do not assume
' invalid text raises an exception. Format controls displayed precision.

Sub Main()
    Dim n As Integer = CInt("42")
    Dim f As Single = CSng("3.14")
    Dim s As String = CStr(99)
    Dim b As Boolean = CBool("True")

    Print "CInt(""42"")   = " & CStr(n)
    Print "CSng(""3.14"") = " & Format(f, "0.00")
    Print "CStr(99)     = " & s
    Print "CBool(""True"") = " & CStr(b)

    ' Invalid user input is reported explicitly, not silently converted.
    Dim inputText As String = "not a number"
    Dim parsed As Integer = 0
    If IsNumeric(inputText) Then
        parsed = CInt(inputText)
    Else
        Print "Invalid integer: " & inputText & "; using 0"
    End If
    Print "Bad parse fell back to: " & CStr(parsed)
End Sub

' Expected output:
' CInt("42")   = 42
' CSng("3.14") = 3.14
' CStr(99)     = 99
' CBool("True") = true
' Invalid integer: not a number; using 0
' Bad parse fell back to: 0
