' Request text with InputBox, a native dialog rather than console input.
' A default fills the dialog; it does not make execution non-interactive.
' The audit exercises greeting logic without opening the modal dialog.
' Audit mode: input

Sub GreetUser(userName As String)
    If Trim(userName) = "" Then
        userName = "stranger"
    End If
    Print "Hello, " & userName & "!"
End Sub

Sub Main()
    Dim userName As String = InputBox("What is your name?", "Greeting", "World")

    GreetUser(userName)
End Sub

' Expected output:
' Hello, World!
' Hello, stranger!
