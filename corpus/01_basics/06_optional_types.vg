' Nullable values in VisualGasic use Variant to hold a value or Nothing.
' Optional(T) annotations are not accepted by the current parser.
' Check for Nothing before extracting a value, or supply an explicit default.

' Variant procedure boundaries carry either String or Nothing.
Function LookupUserName(id As Integer) As Variant
    Select Case id
        Case 1
            LookupUserName = "Alice"
        Case 2
            LookupUserName = "Bob"
        Case Else
            LookupUserName = Nothing
    End Select
End Function

' Helper function to provide a default value if optional is Nothing
Function GetOrDefault(opt As Variant, defaultVal As String) As String
    If opt Is Nothing Then
        Return defaultVal
    Else
        Return opt
    End If
End Function

Sub Main()
    ' Example 1: Optional that contains a value
    Dim foundUser As Variant = LookupUserName(1)
    If foundUser IsNot Nothing Then
        Print "Found user: " & foundUser
    End If
    
    ' Example 2: Optional that is Nothing
    Dim missingUser As Variant = LookupUserName(99)
    If missingUser Is Nothing Then
        Print "User 99 not found (is Nothing)"
    End If
    
    ' Example 3: Use a helper function to handle Nothing gracefully
    Dim safeName As String = GetOrDefault(LookupUserName(2), "Guest")
    Print "User name (with default): " & safeName
    
    ' Example 4: Chain multiple optionals with null-coalescing pattern
    Dim result1 As String = GetOrDefault(LookupUserName(1), "(Unknown)")
    Dim result2 As String = GetOrDefault(LookupUserName(99), "(Unknown)")
    Print "Result 1: " & result1
    Print "Result 2: " & result2
End Sub

' Expected output:
' Found user: Alice
' User 99 not found (is Nothing)
' User name (with default): Bob
' Result 1: Alice
' Result 2: (Unknown)
