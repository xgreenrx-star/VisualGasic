' Count the number of lines in a text file.
' For very large files, prefer this loop-and-count form over reading
' the whole file into memory and splitting on newlines.

Function CountLines(path As String) As Integer
    Dim fso As Variant = CreateObject("Scripting.FileSystemObject")
    If Not fso.FileExists(path) Then
        CountLines = -1
        Exit Function
    End If

    Dim inp As Variant = fso.OpenTextFile(path, 1)
    Dim count As Integer = 0
    Do While Not inp.AtEndOfStream
        inp.ReadLine()
        count = count + 1
    Loop
    inp.Close()
    CountLines = count
End Function

Sub Main()
    ' Set up a known-size file
    Dim fso As Variant = CreateObject("Scripting.FileSystemObject")
    Dim out As Variant = fso.CreateTextFile("count_demo.txt", True)
    Dim i As Integer
    For i = 1 To 42
        out.WriteLine("Line " & CStr(i))
    Next i
    out.Close()

    Print "count_demo.txt has " & CStr(CountLines("count_demo.txt")) & " lines"

    ' Missing file returns -1
    Print "missing.txt has " & CStr(CountLines("missing.txt")) & " lines"
End Sub

' Expected output:
' count_demo.txt has 42 lines
' missing.txt has -1 lines
