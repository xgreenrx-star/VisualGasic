' Count the number of lines in a text file.
' For very large files, prefer this loop-and-count form over reading
' the whole file into memory and splitting on newlines.

Function CountLines(path As String) As Integer
    Open path For Input As #1
    Dim count As Integer = 0
    Dim ln As String
    Do While Not EOF(1)
        Line Input #1, ln
        count = count + 1
    Loop
    Close #1
    CountLines = count
End Function

Sub Main()
    ' Set up a known-size file
    Open "user://count_demo.txt" For Output As #1
    Dim i As Integer
    For i = 1 To 42
        Print #1, "Line " & CStr(i)
    Next i
    Close #1

    Print "count_demo.txt has " & CStr(CountLines("user://count_demo.txt")) & " lines"
End Sub

' Expected output:
' count_demo.txt has 42 lines
