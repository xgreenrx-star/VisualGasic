' Read a CSV file and print a typed row count summary.
' This example trusts the input is well-formed (no quoted commas).
' The first line is treated as a header; subsequent lines are records.

Sub Main()
    Dim path As String = "user://people.csv"

    ' Write a small CSV first so the example is self-contained
    Open path For Output As #1
    Print #1, "name,age,city"
    Print #1, "Alice,30,London"
    Print #1, "Bob,25,Paris"
    Print #1, "Carol,42,Tokyo"
    Close #1

    ' Read it back
    Open path For Input As #2
    Dim header As String
    Line Input #2, header
    Print "Columns: " & header

    Dim totalAge As Integer = 0
    Dim rowCount As Integer = 0
    Dim row As String
    Do While Not EOF(2)
        Line Input #2, row
        ' A trailing newline may yield an empty final read; it is not a record.
        If row <> "" Then
            Dim fields() As String = Split(row, ",")
            If UBound(fields) <> 2 Then
                Close #2
                Raise 5, "Expected three CSV fields: " & row
            End If
            Dim nm As String = fields(0)
            Dim age As Integer = CInt(fields(1))
            Dim city As String = fields(2)
            Print "  " & nm & ", " & CStr(age) & ", " & city
            totalAge = totalAge + age
            rowCount = rowCount + 1
        End If
    Loop
    Close #2

    If rowCount = 0 Then
        Raise 5, "CSV contains no data rows"
    End If
    Print "Average age: " & CStr(totalAge / rowCount)
End Sub

' Expected output:
' Columns: name,age,city
'   Alice, 30, London
'   Bob, 25, Paris
'   Carol, 42, Tokyo
' Average age: 32.3333333333333
