' Write a text file using VisualGasic's built-in file I/O.
' Open path For Output overwrites any existing file.
' Print #n writes a line; Close #n flushes and closes the stream.

Sub Main()
    Dim path As String = "user://hello.txt"

    Open path For Output As #1
    Print #1, "Hello from VisualGasic"
    Print #1, "Line 2"
    Print #1, "Line 3"
    Close #1

    Print "Wrote " & path
End Sub

' Expected output:
' Wrote user://hello.txt
