' Append to a log file using Open For Append.
' If the file does not exist, Open For Append creates it.
' This is a one-liner, idempotent log helper.

Sub LogMessage(message As String)
    Open "user://app.log" For Append As #1
    Print #1, message
    Close #1
End Sub

Sub Main()
    LogMessage("Application started")
    LogMessage("Loading config...")
    LogMessage("User logged in: alice")
    LogMessage("Application stopped")

    Print "Wrote 4 entries to app.log"
End Sub

' Expected output:
' Wrote 4 entries to app.log
