' Read a text file line by line using VisualGasic's built-in file I/O.
' Open path For Input opens for reading.
' Line Input #n reads one line; EOF(n) returns True at end of file.
' This example assumes 01_write_text_file.vg was run first.

Sub Main()
    Dim path As String = "user://hello.txt"

    ' Write a known file so this example is self-contained
    Open path For Output As #1
    Print #1, "Hello from VisualGasic"
    Print #1, "Line 2"
    Print #1, "Line 3"
    Close #1

    ' Now read it back
    Open path For Input As #2
    Dim lineNumber As Integer = 0
    Dim ln As String
    Do While Not EOF(2)
        lineNumber = lineNumber + 1
        Line Input #2, ln
        Print CStr(lineNumber) & ": " & ln
    Loop
    Close #2
End Sub

' Expected output:
' 1: Hello from VisualGasic
' 2: Line 2
' 3: Line 3
